import numpy as np
import sys
import time
import npbench_lib as kernel_module
from C import GC_gcollect() -> None
from C import GC_get_total_bytes() -> int
from C import GC_get_heap_size() -> int
from C import GC_get_free_bytes() -> int
directory = sys.argv[1]
samples = int(sys.argv[2])
original_theta_1 = np.load(directory + '/input-theta_1.npy', dtype=np.float64, ndim=1)
theta_1 = np.empty_like(original_theta_1)
np.copyto(theta_1, original_theta_1)
original_phi_1 = np.load(directory + '/input-phi_1.npy', dtype=np.float64, ndim=1)
phi_1 = np.empty_like(original_phi_1)
np.copyto(phi_1, original_phi_1)
original_theta_2 = np.load(directory + '/input-theta_2.npy', dtype=np.float64, ndim=1)
theta_2 = np.empty_like(original_theta_2)
np.copyto(theta_2, original_theta_2)
original_phi_2 = np.load(directory + '/input-phi_2.npy', dtype=np.float64, ndim=1)
phi_2 = np.empty_like(original_phi_2)
np.copyto(phi_2, original_phi_2)
with open('/proc/self/smaps_rollup') as memory_status:
    for record in memory_status:
        if record.startswith('AnonHugePages:'):
            print('BENCH_HUGEPAGES_KIB', int(record.split()[1]))

def emit(value, filename):
    if value is None:
        return
    elif isinstance(value, tuple):
        index = 0
        for item in value:
            emit(item, filename + '_' + str(index))
            index += 1
    else:
        np.save(filename, np.asarray(value))

@noinline
def sample(theta_1, phi_1, theta_2, phi_2):
    started = time.perf_counter()
    result = kernel_module.arc_distance(theta_1, phi_1, theta_2, phi_2)
    elapsed = time.perf_counter() - started
    emit(result, directory + '/output-return')
    return elapsed

if samples == 0:
    GC_gcollect()
    allocated_before = GC_get_total_bytes()
    heap_before = GC_get_heap_size()
    address_theta_1 = int(theta_1.data)
    address_phi_1 = int(phi_1.data)
    address_theta_2 = int(theta_2.data)
    address_phi_2 = int(phi_2.data)
    for iteration in range(32):
        np.copyto(theta_1, original_theta_1)
        assert int(theta_1.data) == address_theta_1
        np.copyto(phi_1, original_phi_1)
        assert int(phi_1.data) == address_phi_1
        np.copyto(theta_2, original_theta_2)
        assert int(theta_2.data) == address_theta_2
        np.copyto(phi_2, original_phi_2)
        assert int(phi_2.data) == address_phi_2
    allocated = GC_get_total_bytes() - allocated_before
    heap_growth = GC_get_heap_size() - heap_before
    print('BENCH_MEMORY', allocated, heap_growth)
    assert allocated < 65536
    assert heap_growth == 0
else:
    for iteration in range(samples + 1):
        GC_gcollect()
        if iteration > 0:
            print('BENCH_GC', GC_get_heap_size(), GC_get_heap_size() - GC_get_free_bytes())
        np.copyto(theta_1, original_theta_1)
        np.copyto(phi_1, original_phi_1)
        np.copyto(theta_2, original_theta_2)
        np.copyto(phi_2, original_phi_2)
        elapsed = sample(theta_1, phi_1, theta_2, phi_2)
        if iteration > 0:
            print('BENCH_TIME', elapsed)
    GC_gcollect()
    print('BENCH_GC', GC_get_heap_size(), GC_get_heap_size() - GC_get_free_bytes())
