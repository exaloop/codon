import numpy as np
import sys
import time
import npbench_lib as kernel_module
from C import GC_gcollect() -> None
from C import GC_get_total_bytes() -> int
from C import GC_get_heap_size() -> int
from C import GC_get_free_bytes() -> int
directory = sys.argv[1]
samples = int(sys.argv[2])
original_in_field = np.load(directory + '/input-in_field.npy', dtype=np.float64, ndim=3)
in_field = np.empty_like(original_in_field)
np.copyto(in_field, original_in_field)
original_out_field = np.load(directory + '/input-out_field.npy', dtype=np.float64, ndim=3)
out_field = np.empty_like(original_out_field)
np.copyto(out_field, original_out_field)
original_coeff = np.load(directory + '/input-coeff.npy', dtype=np.float64, ndim=3)
coeff = np.empty_like(original_coeff)
np.copyto(coeff, original_coeff)
with open('/proc/self/smaps_rollup') as memory_status:
    for record in memory_status:
        if record.startswith('AnonHugePages:'):
            print('BENCH_HUGEPAGES_KIB', int(record.split()[1]))

def emit(value, filename):
    if value is None:
        return
    elif isinstance(value, tuple):
        index = 0
        for item in value:
            emit(item, filename + '_' + str(index))
            index += 1
    else:
        np.save(filename, np.asarray(value))

@noinline
def sample(in_field, out_field, coeff):
    started = time.perf_counter()
    result = kernel_module.hdiff(in_field, out_field, coeff)
    elapsed = time.perf_counter() - started
    emit(out_field, directory + '/output-out_field')
    return elapsed

if samples == 0:
    GC_gcollect()
    allocated_before = GC_get_total_bytes()
    heap_before = GC_get_heap_size()
    address_in_field = int(in_field.data)
    address_out_field = int(out_field.data)
    address_coeff = int(coeff.data)
    for iteration in range(32):
        np.copyto(in_field, original_in_field)
        assert int(in_field.data) == address_in_field
        np.copyto(out_field, original_out_field)
        assert int(out_field.data) == address_out_field
        np.copyto(coeff, original_coeff)
        assert int(coeff.data) == address_coeff
    allocated = GC_get_total_bytes() - allocated_before
    heap_growth = GC_get_heap_size() - heap_before
    print('BENCH_MEMORY', allocated, heap_growth)
    assert allocated < 65536
    assert heap_growth == 0
else:
    for iteration in range(samples + 1):
        GC_gcollect()
        if iteration > 0:
            print('BENCH_GC', GC_get_heap_size(), GC_get_heap_size() - GC_get_free_bytes())
        np.copyto(in_field, original_in_field)
        np.copyto(out_field, original_out_field)
        np.copyto(coeff, original_coeff)
        elapsed = sample(in_field, out_field, coeff)
        if iteration > 0:
            print('BENCH_TIME', elapsed)
    GC_gcollect()
    print('BENCH_GC', GC_get_heap_size(), GC_get_heap_size() - GC_get_free_bytes())
