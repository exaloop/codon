__CODON_RET__: Literal[bool] = True

import numpy as np

def trmm(alpha: float, A: np.ndarray[float,2], B: np.ndarray[float,2]):

    for i in range(B.shape[0]):
        for j in range(B.shape[1]):
            B[i, j] += np.dot(A[i + 1:, i], B[i + 1:, j])
    B *= alpha
