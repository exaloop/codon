__CODON_RET__: Literal[bool] = True

import numpy as np

def mvt(x1: np.ndarray[float, 1], x2: np.ndarray[float, 1], y_1: np.ndarray[float,1], y_2: np.ndarray[float,1], A: np.ndarray[float, 2]):
    x1 += A @ y_1
    x2 += y_2 @ A
