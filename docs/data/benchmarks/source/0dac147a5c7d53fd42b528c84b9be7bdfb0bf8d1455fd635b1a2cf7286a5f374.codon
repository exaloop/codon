__CODON_RET__: Literal[bool] = True

import numpy as np

def k2mm(alpha: float, beta: float, A: np.ndarray[float,2], B: np.ndarray[float,2], C: np.ndarray[float,2], D: np.ndarray[float,2]):

    D[:] = alpha * A @ B @ C + beta * D
