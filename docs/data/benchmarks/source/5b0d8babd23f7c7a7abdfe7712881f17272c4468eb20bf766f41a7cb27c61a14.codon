__CODON_RET__: Literal[bool] = True

import numpy as np

def gesummv(alpha: float, beta: float, A: np.ndarray[float,2], B: np.ndarray[float,2], x: np.ndarray[float,1]):

    res = alpha * A @ x + beta * B @ x
    if __CODON_RET__: return res
