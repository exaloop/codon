__CODON_RET__: Literal[bool] = True

import numpy as np

def crc16(data: np.ndarray[np.uint8, 1]):
    '''
    CRC-16-CCITT Algorithm
    '''
    poly=0x8408
    crc = 0xFFFF
    for b in data:
        cur_byte = 0xFF & int(b)
        for _ in range(0, 8):
            if (crc & 0x0001) ^ (cur_byte & 0x0001):
                crc = (crc >> 1) ^ poly
            else:
                crc >>= 1
            cur_byte >>= 1
    crc = (~crc & 0xFFFF)
    crc = (crc << 8) | ((crc >> 8) & 0xFF)

    res = crc & 0xFFFF
    if __CODON_RET__: return res
