__CODON_RET__: Literal[bool] = True

import numpy as np

def compute(array_1: np.ndarray[int,2], array_2: np.ndarray[int,2], a: int, b: int, c: int):
    res = np.clip(array_1, 2, 10) * a + array_2 * b + c
    if __CODON_RET__: return res
