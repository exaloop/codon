__CODON_RET__: Literal[bool] = True

import numpy as np

def syrk(alpha: float, beta: float, C: np.ndarray[float, 2], A: np.ndarray[float, 2]):

    for i in range(A.shape[0]):
        C[i, :i + 1] *= beta
        for k in range(A.shape[1]):
            C[i, :i + 1] += alpha * A[i, k] * A[:i + 1, k]
