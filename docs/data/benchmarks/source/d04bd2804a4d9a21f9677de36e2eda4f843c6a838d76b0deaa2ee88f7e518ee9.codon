import numpy as np
import sys
import time
import npbench_lib as kernel_module
from C import GC_gcollect() -> None
from C import GC_get_total_bytes() -> int
from C import GC_get_heap_size() -> int
from C import GC_get_free_bytes() -> int
directory = sys.argv[1]
samples = int(sys.argv[2])
TMAX = 150
original_ex = np.load(directory + '/input-ex.npy', dtype=np.float64, ndim=2)
ex = np.empty_like(original_ex)
np.copyto(ex, original_ex)
original_ey = np.load(directory + '/input-ey.npy', dtype=np.float64, ndim=2)
ey = np.empty_like(original_ey)
np.copyto(ey, original_ey)
original_hz = np.load(directory + '/input-hz.npy', dtype=np.float64, ndim=2)
hz = np.empty_like(original_hz)
np.copyto(hz, original_hz)
original__fict_ = np.load(directory + '/input-_fict_.npy', dtype=np.float64, ndim=1)
_fict_ = np.empty_like(original__fict_)
np.copyto(_fict_, original__fict_)

def emit(value, filename):
    if value is None:
        return
    elif isinstance(value, tuple):
        index = 0
        for item in value:
            emit(item, filename + '_' + str(index))
            index += 1
    else:
        np.save(filename, np.asarray(value))

@noinline
def sample(TMAX, ex, ey, hz, _fict_):
    started = time.perf_counter()
    result = kernel_module.fdtd_2d(TMAX, ex, ey, hz, _fict_)
    elapsed = time.perf_counter() - started
    emit(ex, directory + '/output-ex')
    emit(ey, directory + '/output-ey')
    emit(hz, directory + '/output-hz')
    return elapsed

if samples == 0:
    GC_gcollect()
    allocated_before = GC_get_total_bytes()
    heap_before = GC_get_heap_size()
    address_ex = int(ex.data)
    address_ey = int(ey.data)
    address_hz = int(hz.data)
    address__fict_ = int(_fict_.data)
    for iteration in range(32):
        np.copyto(ex, original_ex)
        assert int(ex.data) == address_ex
        np.copyto(ey, original_ey)
        assert int(ey.data) == address_ey
        np.copyto(hz, original_hz)
        assert int(hz.data) == address_hz
        np.copyto(_fict_, original__fict_)
        assert int(_fict_.data) == address__fict_
    allocated = GC_get_total_bytes() - allocated_before
    heap_growth = GC_get_heap_size() - heap_before
    print('BENCH_MEMORY', allocated, heap_growth)
    assert allocated < 65536
    assert heap_growth == 0
else:
    for iteration in range(samples + 1):
        GC_gcollect()
        if iteration > 0:
            print('BENCH_GC', GC_get_heap_size(), GC_get_heap_size() - GC_get_free_bytes())
        np.copyto(ex, original_ex)
        np.copyto(ey, original_ey)
        np.copyto(hz, original_hz)
        np.copyto(_fict_, original__fict_)
        elapsed = sample(TMAX, ex, ey, hz, _fict_)
        if iteration > 0:
            print('BENCH_TIME', elapsed)
    GC_gcollect()
    print('BENCH_GC', GC_get_heap_size(), GC_get_heap_size() - GC_get_free_bytes())
