__CODON_RET__: Literal[bool] = True

import numpy as np

def go_fast(a: np.ndarray[float,2]):
    trace = 0.0
    for i in range(a.shape[0]):
        trace += np.tanh(a[i, i])
    res = a + trace
    if __CODON_RET__: return res
