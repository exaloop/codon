import numpy as np
import sys
import time
import npbench_lib as kernel_module
from C import GC_gcollect() -> None
from C import GC_get_total_bytes() -> int
from C import GC_get_heap_size() -> int
from C import GC_get_free_bytes() -> int
directory = sys.argv[1]
samples = int(sys.argv[2])
original_input = np.load(directory + '/input-input.npy', dtype=np.float32, ndim=4)
input = np.empty_like(original_input)
np.copyto(input, original_input)
original_conv1 = np.load(directory + '/input-conv1.npy', dtype=np.float32, ndim=4)
conv1 = np.empty_like(original_conv1)
np.copyto(conv1, original_conv1)
original_conv2 = np.load(directory + '/input-conv2.npy', dtype=np.float32, ndim=4)
conv2 = np.empty_like(original_conv2)
np.copyto(conv2, original_conv2)
original_conv3 = np.load(directory + '/input-conv3.npy', dtype=np.float32, ndim=4)
conv3 = np.empty_like(original_conv3)
np.copyto(conv3, original_conv3)
with open('/proc/self/smaps_rollup') as memory_status:
    for record in memory_status:
        if record.startswith('AnonHugePages:'):
            print('BENCH_HUGEPAGES_KIB', int(record.split()[1]))

def emit(value, filename):
    if value is None:
        return
    elif isinstance(value, tuple):
        index = 0
        for item in value:
            emit(item, filename + '_' + str(index))
            index += 1
    else:
        np.save(filename, np.asarray(value))

@noinline
def sample(input, conv1, conv2, conv3):
    started = time.perf_counter()
    result = kernel_module.resnet(input, conv1, conv2, conv3)
    elapsed = time.perf_counter() - started
    emit(result, directory + '/output-return')
    return elapsed

if samples == 0:
    GC_gcollect()
    allocated_before = GC_get_total_bytes()
    heap_before = GC_get_heap_size()
    address_input = int(input.data)
    address_conv1 = int(conv1.data)
    address_conv2 = int(conv2.data)
    address_conv3 = int(conv3.data)
    for iteration in range(32):
        np.copyto(input, original_input)
        assert int(input.data) == address_input
        np.copyto(conv1, original_conv1)
        assert int(conv1.data) == address_conv1
        np.copyto(conv2, original_conv2)
        assert int(conv2.data) == address_conv2
        np.copyto(conv3, original_conv3)
        assert int(conv3.data) == address_conv3
    allocated = GC_get_total_bytes() - allocated_before
    heap_growth = GC_get_heap_size() - heap_before
    print('BENCH_MEMORY', allocated, heap_growth)
    assert allocated < 65536
    assert heap_growth == 0
else:
    for iteration in range(samples + 1):
        GC_gcollect()
        if iteration > 0:
            print('BENCH_GC', GC_get_heap_size(), GC_get_heap_size() - GC_get_free_bytes())
        np.copyto(input, original_input)
        np.copyto(conv1, original_conv1)
        np.copyto(conv2, original_conv2)
        np.copyto(conv3, original_conv3)
        elapsed = sample(input, conv1, conv2, conv3)
        if iteration > 0:
            print('BENCH_TIME', elapsed)
    GC_gcollect()
    print('BENCH_GC', GC_get_heap_size(), GC_get_heap_size() - GC_get_free_bytes())
