import numpy as np
import sys
import time
import npbench_lib as kernel_module
from C import GC_gcollect() -> None
from C import GC_get_total_bytes() -> int
from C import GC_get_heap_size() -> int
from C import GC_get_free_bytes() -> int
directory = sys.argv[1]
samples = int(sys.argv[2])
original_utens_stage = np.load(directory + '/input-utens_stage.npy', dtype=np.float64, ndim=3)
utens_stage = np.empty_like(original_utens_stage)
np.copyto(utens_stage, original_utens_stage)
original_u_stage = np.load(directory + '/input-u_stage.npy', dtype=np.float64, ndim=3)
u_stage = np.empty_like(original_u_stage)
np.copyto(u_stage, original_u_stage)
original_wcon = np.load(directory + '/input-wcon.npy', dtype=np.float64, ndim=3)
wcon = np.empty_like(original_wcon)
np.copyto(wcon, original_wcon)
original_u_pos = np.load(directory + '/input-u_pos.npy', dtype=np.float64, ndim=3)
u_pos = np.empty_like(original_u_pos)
np.copyto(u_pos, original_u_pos)
original_utens = np.load(directory + '/input-utens.npy', dtype=np.float64, ndim=3)
utens = np.empty_like(original_utens)
np.copyto(utens, original_utens)
dtr_stage = 0.15

def emit(value, filename):
    if value is None:
        return
    elif isinstance(value, tuple):
        index = 0
        for item in value:
            emit(item, filename + '_' + str(index))
            index += 1
    else:
        np.save(filename, np.asarray(value))

@noinline
def sample(utens_stage, u_stage, wcon, u_pos, utens, dtr_stage):
    started = time.perf_counter()
    result = kernel_module.vadv(utens_stage, u_stage, wcon, u_pos, utens, dtr_stage)
    elapsed = time.perf_counter() - started
    emit(utens_stage, directory + '/output-utens_stage')
    return elapsed

if samples == 0:
    GC_gcollect()
    allocated_before = GC_get_total_bytes()
    heap_before = GC_get_heap_size()
    address_utens_stage = int(utens_stage.data)
    address_u_stage = int(u_stage.data)
    address_wcon = int(wcon.data)
    address_u_pos = int(u_pos.data)
    address_utens = int(utens.data)
    for iteration in range(32):
        np.copyto(utens_stage, original_utens_stage)
        assert int(utens_stage.data) == address_utens_stage
        np.copyto(u_stage, original_u_stage)
        assert int(u_stage.data) == address_u_stage
        np.copyto(wcon, original_wcon)
        assert int(wcon.data) == address_wcon
        np.copyto(u_pos, original_u_pos)
        assert int(u_pos.data) == address_u_pos
        np.copyto(utens, original_utens)
        assert int(utens.data) == address_utens
    allocated = GC_get_total_bytes() - allocated_before
    heap_growth = GC_get_heap_size() - heap_before
    print('BENCH_MEMORY', allocated, heap_growth)
    assert allocated < 65536
    assert heap_growth == 0
else:
    for iteration in range(samples + 1):
        GC_gcollect()
        if iteration > 0:
            print('BENCH_GC', GC_get_heap_size(), GC_get_heap_size() - GC_get_free_bytes())
        np.copyto(utens_stage, original_utens_stage)
        np.copyto(u_stage, original_u_stage)
        np.copyto(wcon, original_wcon)
        np.copyto(u_pos, original_u_pos)
        np.copyto(utens, original_utens)
        elapsed = sample(utens_stage, u_stage, wcon, u_pos, utens, dtr_stage)
        if iteration > 0:
            print('BENCH_TIME', elapsed)
    GC_gcollect()
    print('BENCH_GC', GC_get_heap_size(), GC_get_heap_size() - GC_get_free_bytes())
