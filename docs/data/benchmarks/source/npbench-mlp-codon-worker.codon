import numpy as np
import sys
import time
import npbench_lib as kernel_module
from C import GC_gcollect() -> None
from C import GC_get_total_bytes() -> int
from C import GC_get_heap_size() -> int
from C import GC_get_free_bytes() -> int
directory = sys.argv[1]
samples = int(sys.argv[2])
original_input = np.load(directory + '/input-input.npy', dtype=np.float32, ndim=2)
input = np.empty_like(original_input)
np.copyto(input, original_input)
original_w1 = np.load(directory + '/input-w1.npy', dtype=np.float32, ndim=2)
w1 = np.empty_like(original_w1)
np.copyto(w1, original_w1)
original_b1 = np.load(directory + '/input-b1.npy', dtype=np.float32, ndim=1)
b1 = np.empty_like(original_b1)
np.copyto(b1, original_b1)
original_w2 = np.load(directory + '/input-w2.npy', dtype=np.float32, ndim=2)
w2 = np.empty_like(original_w2)
np.copyto(w2, original_w2)
original_b2 = np.load(directory + '/input-b2.npy', dtype=np.float32, ndim=1)
b2 = np.empty_like(original_b2)
np.copyto(b2, original_b2)
original_w3 = np.load(directory + '/input-w3.npy', dtype=np.float32, ndim=2)
w3 = np.empty_like(original_w3)
np.copyto(w3, original_w3)
original_b3 = np.load(directory + '/input-b3.npy', dtype=np.float32, ndim=1)
b3 = np.empty_like(original_b3)
np.copyto(b3, original_b3)

def emit(value, filename):
    if value is None:
        return
    elif isinstance(value, tuple):
        index = 0
        for item in value:
            emit(item, filename + '_' + str(index))
            index += 1
    else:
        np.save(filename, np.asarray(value))

@noinline
def sample(input, w1, b1, w2, b2, w3, b3):
    started = time.perf_counter()
    result = kernel_module.mlp(input, w1, b1, w2, b2, w3, b3)
    elapsed = time.perf_counter() - started
    emit(result, directory + '/output-return')
    return elapsed

if samples == 0:
    GC_gcollect()
    allocated_before = GC_get_total_bytes()
    heap_before = GC_get_heap_size()
    address_input = int(input.data)
    address_w1 = int(w1.data)
    address_b1 = int(b1.data)
    address_w2 = int(w2.data)
    address_b2 = int(b2.data)
    address_w3 = int(w3.data)
    address_b3 = int(b3.data)
    for iteration in range(32):
        np.copyto(input, original_input)
        assert int(input.data) == address_input
        np.copyto(w1, original_w1)
        assert int(w1.data) == address_w1
        np.copyto(b1, original_b1)
        assert int(b1.data) == address_b1
        np.copyto(w2, original_w2)
        assert int(w2.data) == address_w2
        np.copyto(b2, original_b2)
        assert int(b2.data) == address_b2
        np.copyto(w3, original_w3)
        assert int(w3.data) == address_w3
        np.copyto(b3, original_b3)
        assert int(b3.data) == address_b3
    allocated = GC_get_total_bytes() - allocated_before
    heap_growth = GC_get_heap_size() - heap_before
    print('BENCH_MEMORY', allocated, heap_growth)
    assert allocated < 65536
    assert heap_growth == 0
else:
    for iteration in range(samples + 1):
        GC_gcollect()
        if iteration > 0:
            print('BENCH_GC', GC_get_heap_size(), GC_get_heap_size() - GC_get_free_bytes())
        np.copyto(input, original_input)
        np.copyto(w1, original_w1)
        np.copyto(b1, original_b1)
        np.copyto(w2, original_w2)
        np.copyto(b2, original_b2)
        np.copyto(w3, original_w3)
        np.copyto(b3, original_b3)
        elapsed = sample(input, w1, b1, w2, b2, w3, b3)
        if iteration > 0:
            print('BENCH_TIME', elapsed)
    GC_gcollect()
    print('BENCH_GC', GC_get_heap_size(), GC_get_heap_size() - GC_get_free_bytes())
