__CODON_RET__: Literal[bool] = True

import numpy as np

def softmax(x: np.ndarray[float32, 4]):
    tmp_max = np.max(x, axis=-1, keepdims=True)
    tmp_out = np.exp(x - tmp_max)
    tmp_sum = np.sum(tmp_out, axis=-1, keepdims=True)
    res = tmp_out / tmp_sum
    if __CODON_RET__: return res
