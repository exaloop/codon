from internal.gc import realloc, free

def _file_bytes(data: Ptr[u8], length: int) -> bytes:
    from internal.str import _CodecByteBuffer

    result = _CodecByteBuffer(length)
    bytes.memcpy(result.data, data, length)
    result.length = length
    return result.finish()

def _file_read(fp: cobj, size: int) -> bytes:
    buffer = Ptr[u8](size)
    length = _C.fread(buffer, 1, size, fp)
    return _file_bytes(buffer, length)

def _file_read_all(fp: cobj) -> bytes:
    chunk_size = 4096
    chunks: List[bytes] = []
    while True:
        chunk = _file_read(fp, chunk_size)
        chunks.append(chunk)
        if len(chunk) < chunk_size:
            break
    if _C.ferror(fp):
        raise IOError("file I/O error: error in read")
    return bytes.cat(chunks)

def _file_collect(chunks: Generator[str]) -> str:
    result = _strbuf()
    for chunk in chunks:
        result.append(chunk)
    return result.__str__()

@overload
def _file_collect(chunks: Generator[bytes]) -> bytes:
    parts: List[bytes] = []
    for chunk in chunks:
        parts.append(chunk.__ptrcopy__())
    return bytes.cat(parts)

class File[T]:
    sz: int
    buf: Ptr[u8]
    fp: cobj

    def __init__(self, fp: cobj):
        self.fp = fp
        self._reset()

    def __init__(self, path: str, mode: str):
        self.fp = _C.fopen(path.c_str(), mode.c_str())
        if not self.fp:
            raise IOError(f"file {path} could not be opened")
        self._reset()

    def __init__(self, fd: int, mode: str):
        self.fp = _C.fdopen(fd, mode.c_str())
        if not self.fp:
            raise IOError(f"file descriptor {fd} could not be opened")
        self._reset()

    def _errcheck(self, msg: str):
        err = int(_C.ferror(self.fp))
        if err:
            raise IOError(f"file I/O error: {msg}")

    def __enter__(self):
        pass

    def __exit__(self):
        self.close()

    def __iter__(self) -> Generator[T]:
        for a in self._iter():
            if T is bytes:
                yield a.__ptrcopy__()
            else:
                yield a

    def readlines(self) -> List[T]:
        return [l for l in self]

    def write(self, s: T):
        self._ensure_open()
        if T is bytes:
            _C.fwrite(s._ptr, 1, len(s), self.fp)
        else:
            data = s.encode()
            _C.fwrite(data._ptr, 1, len(data), self.fp)
        self._errcheck("error in write")

    def __file_write_gen__(self, g: Generator[T], T: type):
        for s in g:
            self.write(s)

    def read(self) -> T:
        return self.read(-1)

    def read(self, sz: int) -> T:
        self._ensure_open()
        if T is bytes:
            if sz < 0:
                return _file_read_all(self.fp)
            result = _file_read(self.fp, sz)
            self._errcheck("error in read")
            return result
        if sz < 0:
            return _file_read_all(self.fp).decode()
        result = _file_read(self.fp, sz).decode()
        self._errcheck("error in read")
        return result

    def tell(self) -> int:
        self._ensure_open()
        ret = _C.ftell(self.fp)
        self._errcheck("error in tell")
        return ret

    def seek(self, offset: int, whence: int):
        self._ensure_open()
        _C.fseek(self.fp, offset, i32(whence))
        self._errcheck("error in seek")

    def flush(self):
        self._ensure_open()
        _C.fflush(self.fp)

    def close(self):
        if self.fp:
            _C.fclose(self.fp)
            self.fp = cobj()
        if self.buf:
            _C.free(self.buf)
            self._reset()

    def _ensure_open(self):
        if not self.fp:
            raise IOError("I/O operation on closed file")

    def _reset(self):
        self.buf = Ptr[u8]()
        self.sz = 0

    def _iter(self) -> Generator[T]:
        self._ensure_open()
        while True:
            rd = _C.getline(
                Ptr[Ptr[u8]](self.__raw__() + 8), Ptr[int](self.__raw__()), self.fp
            )
            if rd != -1:
                data = bytes(self.buf, rd)
                if T is bytes:
                    yield data
                else:
                    yield data.decode()
            else:
                break

    def _iter_trim_newline(self) -> Generator[T]:
        self._ensure_open()
        while True:
            rd = _C.getline(
                Ptr[Ptr[u8]](self.__raw__() + 8), Ptr[int](self.__raw__()), self.fp
            )
            if rd != -1:
                if self.buf[rd - 1] == u8(10):
                    rd -= 1
                data = bytes(self.buf, rd)
                if T is bytes:
                    yield data
                else:
                    yield data.decode()
            else:
                break

def _gz_errcheck(stream: cobj):
    errnum = i32(0)
    msg = _C.gzerror(stream, __ptr__(errnum))
    if msg and msg[0]:
        raise IOError(f"zlib error: {bytes.from_ptr(msg).decode()}")

class gzFile[T]:
    sz: int
    buf: Ptr[u8]
    fp: cobj

    def __init__(self, fp: cobj):
        self.fp = fp
        self._reset()

    def __init__(self, path: str, mode: str):
        self.fp = _C.gzopen(path.c_str(), mode.c_str())
        if not self.fp:
            raise IOError(f"file {path} could not be opened")
        self._reset()

    def _getline(self) -> int:
        if not self.buf:
            self.sz = 128
            self.buf = Ptr[u8](self.sz)

        offset = 0
        while True:
            if not _C.gzgets(self.fp, self.buf + offset, i32(self.sz - offset)):
                _gz_errcheck(self.fp)
                if offset == 0:
                    return -1
                break

            offset += len(bytes.from_ptr(self.buf + offset))

            if self.buf[offset - 1] == u8(10):  # '\n'
                break

            oldsz = self.sz
            self.sz *= 2
            self.buf = realloc(self.buf, self.sz, oldsz)

        return offset

    def __iter__(self) -> Generator[T]:
        for a in self._iter():
            if T is bytes:
                yield a.__ptrcopy__()
            else:
                yield a

    def __enter__(self):
        pass

    def __exit__(self):
        self.close()

    def close(self):
        if self.fp:
            _C.gzclose(self.fp)
            self.fp = cobj()
        if self.buf:
            free(self.buf)
            self._reset()

    def readlines(self) -> List[T]:
        return [l for l in self]

    def write(self, s: T):
        self._ensure_open()
        if T is bytes:
            _C.gzwrite(self.fp, s._ptr, u32(len(s)))
        else:
            data = s.encode()
            _C.gzwrite(self.fp, data._ptr, u32(len(data)))
        _gz_errcheck(self.fp)

    def __file_write_gen__(self, g: Generator[T], T: type):
        for s in g:
            self.write(s)

    def read(self) -> T:
        return self.read(-1)

    def read(self, sz: int) -> T:
        self._ensure_open()
        if sz < 0:
            if T is bytes:
                chunk_size = 4096
                chunks: List[bytes] = []
                while True:
                    buffer = Ptr[u8](chunk_size)
                    length = int(_C.gzread(self.fp, buffer, u32(chunk_size)))
                    _gz_errcheck(self.fp)
                    chunks.append(_file_bytes(buffer, length))
                    if length < chunk_size:
                        break
                return bytes.cat(chunks)
            return _file_collect(self._iter())
        buf = Ptr[u8](sz)
        ret = _C.gzread(self.fp, buf, u32(sz))
        _gz_errcheck(self.fp)
        if T is bytes:
            return _file_bytes(buf, int(ret))
        return _file_bytes(buf, int(ret)).decode()

    def tell(self) -> int:
        self._ensure_open()
        ret = _C.gztell(self.fp)
        _gz_errcheck(self.fp)
        return ret

    def seek(self, offset: int, whence: int):
        self._ensure_open()
        _C.gzseek(self.fp, offset, i32(whence))
        _gz_errcheck(self.fp)

    def flush(self):
        Z_FINISH = 4
        self._ensure_open()
        _C.gzflush(self.fp, i32(Z_FINISH))
        _gz_errcheck(self.fp)

    def _iter(self) -> Generator[T]:
        self._ensure_open()
        while True:
            rd = self._getline()
            if rd != -1:
                data = bytes(self.buf, rd)
                if T is bytes:
                    yield data
                else:
                    yield data.decode()
            else:
                break

    def _iter_trim_newline(self) -> Generator[T]:
        self._ensure_open()
        while True:
            rd = self._getline()
            if rd != -1:
                if self.buf[rd - 1] == u8(10):
                    rd -= 1
                data = bytes(self.buf, rd)
                if T is bytes:
                    yield data
                else:
                    yield data.decode()
            else:
                break

    def _ensure_open(self):
        if not self.fp:
            raise IOError("I/O operation on closed file")

    def _reset(self):
        self.buf = cobj()
        self.sz = 0

def _bz_errcheck(stream: cobj):
    errnum = i32(0)
    msg = _C.BZ2_bzerror(stream, __ptr__(errnum))
    if errnum < i32(0):
        raise IOError(f"bzip2 error: {bytes.from_ptr(msg).decode()}")

class bzFile[T]:
    sz: int
    buf: Ptr[u8]
    fp: cobj

    def __init__(self, fp: cobj):
        self.fp = fp
        self._reset()

    def __init__(self, path: str, mode: str):
        self.fp = _C.BZ2_bzopen(path.c_str(), mode.c_str())
        if not self.fp:
            raise IOError(f"file {path} could not be opened")
        self._reset()

    def _getline(self) -> int:
        if not self.buf:
            self.sz = 128
            self.buf = Ptr[u8](self.sz)

        offset = 0
        while True:
            m = self._gets(self.buf + offset, self.sz - offset)
            if m == 0:
                if offset == 0:
                    return -1
                break
            elif m < 0:
                _bz_errcheck(self.fp)
                if offset == 0:
                    return -1
                break

            offset += m

            if self.buf[offset - 1] == u8(10):  # '\n'
                break

            oldsz = self.sz
            self.sz *= 2
            self.buf = realloc(self.buf, self.sz, oldsz)

        return offset

    def __iter__(self) -> Generator[T]:
        for a in self._iter():
            if T is bytes:
                yield a.__ptrcopy__()
            else:
                yield a

    def __enter__(self):
        pass

    def __exit__(self):
        self.close()

    def close(self):
        if self.fp:
            _C.BZ2_bzclose(self.fp)
            self.fp = cobj()
        if self.buf:
            free(self.buf)
            self._reset()

    def readlines(self) -> List[T]:
        return [l for l in self]

    def write(self, s: T):
        self._ensure_open()
        if T is bytes:
            _C.BZ2_bzwrite(self.fp, s._ptr, i32(len(s)))
        else:
            data = s.encode()
            _C.BZ2_bzwrite(self.fp, data._ptr, i32(len(data)))
        _bz_errcheck(self.fp)

    def __file_write_gen__(self, g: Generator[T], T: type):
        for s in g:
            self.write(s)

    def read(self) -> T:
        return self.read(-1)

    def read(self, sz: int) -> T:
        self._ensure_open()
        if sz < 0:
            if T is bytes:
                chunk_size = 4096
                chunks: List[bytes] = []
                while True:
                    buffer = Ptr[u8](chunk_size)
                    length = int(_C.BZ2_bzread(self.fp, buffer, i32(chunk_size)))
                    _bz_errcheck(self.fp)
                    chunks.append(_file_bytes(buffer, length))
                    if length < chunk_size:
                        break
                return bytes.cat(chunks)
            return _file_collect(self._iter())
        buf = Ptr[u8](sz)
        ret = _C.BZ2_bzread(self.fp, buf, i32(sz))
        _bz_errcheck(self.fp)
        if T is bytes:
            return _file_bytes(buf, int(ret))
        return _file_bytes(buf, int(ret)).decode()

    def flush(self):
        self._ensure_open()
        _C.BZ2_bzflush(self.fp)
        _bz_errcheck(self.fp)

    def _iter(self) -> Generator[T]:
        self._ensure_open()
        while True:
            rd = self._getline()
            if rd != -1:
                data = bytes(self.buf, rd)
                if T is bytes:
                    yield data
                else:
                    yield data.decode()
            else:
                break

    def _iter_trim_newline(self) -> Generator[T]:
        self._ensure_open()
        while True:
            rd = self._getline()
            if rd != -1:
                if self.buf[rd - 1] == u8(10):
                    rd -= 1
                data = bytes(self.buf, rd)
                if T is bytes:
                    yield data
                else:
                    yield data.decode()
            else:
                break

    def _ensure_open(self):
        if not self.fp:
            raise IOError("I/O operation on closed file")

    def _reset(self):
        self.buf = cobj()
        self.sz = 0

    def _gets(self, buf: cobj, sz: int):
        if sz <= 0:
            return 0

        fp = self.fp
        b = u8(0)
        i = 0

        while i < sz - 1:
            status = _C.BZ2_bzread(fp, __ptr__(b), i32(1))
            if status == i32(0):
                break
            elif status < i32(0):
                return -1

            buf[i] = b
            i += 1
            if b == u8(10):
                break

        return i

def _literal_contains(needle: Literal[str], haystack: Literal[str]) -> Literal[bool]:
    import internal.static as static

    if static.len(needle) > static.len(haystack):
        return False
    elif haystack[0:static.len(needle)] == needle:
        return True
    else:
        return _literal_contains(needle, haystack[1:])

def open(path: str, mode: str = "r") -> File[str]:
    return File[str](path, mode)

@overload
def open(path: str, mode: Literal[str]):
    if _literal_contains("b", mode):
        return File[bytes](path, mode)
    else:
        return File[str](path, mode)

def gzopen(path: str, mode: str = "r") -> gzFile[str]:
    return gzFile[str](path, mode)

@overload
def gzopen(path: str, mode: Literal[str]):
    if _literal_contains("b", mode):
        return gzFile[bytes](path, mode)
    else:
        return gzFile[str](path, mode)

def bzopen(path: str, mode: str = "r") -> bzFile[str]:
    return bzFile[str](path, mode)

@overload
def bzopen(path: str, mode: Literal[str]):
    if _literal_contains("b", mode):
        return bzFile[bytes](path, mode)
    else:
        return bzFile[str](path, mode)

def is_binary(path: str) -> bool:
    # https://stackoverflow.com/questions/898669/how-can-i-detect-if-a-file-is-binary-non-text-in-python/7392391#7392391
    # Can get both false positive and false negatives, but still is a
    # clever approach that works for the large majority of files
    textchars = {7, 8, 9, 10, 12, 13, 27} | set(iter(range(0x20, 0x100))) - {0x7F}
    with open(path, "rb") as f:
        header = f.read(1024)
        return any(c not in textchars for c in header)
