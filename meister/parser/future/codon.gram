# PEG grammar for Python
# Generate: python -m pegen codon/parser/codon.gram -o codon/parser/parser.py

@class CodonParser

@header"""
import itertools

from ..bridge import *
from .pegen import *
"""

@trailer"""
"""


# STARTING RULES
# ==============

start[ast.Module]: file

file[ast.Module]: a=[statements] ENDMARKER { ast.Module(body=a) }
interactive[ast.Interactive]: a=statement_newline { ast.Interactive(body=a) }
fstring[ast.Expr]: star_expressions

# GENERAL STATEMENTS
# ==================

statements[List[ast.BaseStatement]]: a=statement+ { list(itertools.chain.from_iterable(a)) }

statement[List[ast.BaseStatement]]: a=compound_stmt { [a] } | a=simple_stmts { a }

statement_newline[List[ast.BaseStatement]]:
    | a=compound_stmt NEWLINE { [a] }
    | simple_stmts
    | NEWLINE { [ast.Pass(LOCATIONS)] }
    | ENDMARKER { None }

simple_stmts[List[ast.BaseStatement]]:
    | a=simple_stmt !';' NEWLINE { [a] } # Not needed, there for speedup
    | a=';'.simple_stmt+ [';'] NEWLINE { a }

# NOTE: assignment MUST precede expression, else parsing a simple assignment
# will throw a SyntaxError.
simple_stmt[ast.BaseStatement] (memo):
    | assignment
    | &"print" print_stmt
    | e=star_expressions { ast.Expr(value=e, LOCATIONS) }
    | &'return' return_stmt
    | &('import' | 'from') import_stmt
    | &'raise' raise_stmt
    | 'pass' { ast.Pass(LOCATIONS) }
    | &'del' del_stmt
    | &'yield' yield_stmt
    | &'assert' assert_stmt
    | 'break' { ast.Break(LOCATIONS) }
    | 'continue' { ast.Continue(LOCATIONS) }
    | &'global' global_stmt
    | &'nonlocal' nonlocal_stmt

compound_stmt[ast.BaseStatement]:
    | &('def' | '@' | 'async') function_def
    | &'if' if_stmt
    | &('class' | '@') class_def
    | &('with' | 'async') with_stmt
    | &('for' | '@' | 'async') for_stmt
    | &'try' try_stmt
    | &'while' while_stmt
    | match_stmt
    | custom_stmt

# SIMPLE STATEMENTS
# =================

# NOTE: annotated_rhs may start with 'yield'; yield_expr must start with 'yield'
assignment[ast.BaseStatement]:
    | a=NAME ':' b=expression c=['=' d=annotated_rhs { d }] {
        ast.AnnAssign(
            target=ast.Name(id=a.string, ctx=Store,
                            lineno=a.start[0], col_offset=a.start[1], end_lineno=a.end[0], end_col_offset=a.end[1]),
            annotation=b, value=c, simple=1, LOCATIONS
        )
    }
    | a=('(' b=single_target ')' { b } | single_subscript_attribute_target) ':' b=expression c=['=' d=annotated_rhs { d }] {
        ast.AnnAssign(target=a, annotation=b, value=c, simple=0, LOCATIONS)
    }
    | a=(z=star_targets '=' { z })+ b=(yield_expr | star_expressions) !'=' {
         ast.Assign(targets=a, value=b, LOCATIONS)
    }
    | a=single_target b=augassign ~ c=(yield_expr | star_expressions) {
        ast.AugAssign(target=a, op=b, value=c, LOCATIONS)
    }
    | invalid_assignment

annotated_rhs[ast.BaseExpression]: yield_expr | star_expressions

augassign[int]:
    | '+=' { ast.BinaryOperator.Add }
    | '-=' { ast.BinaryOperator.Sub }
    | '*=' { ast.BinaryOperator.Mult }
    | '@=' { ast.BinaryOperator.MatMult }
    | '/=' { ast.BinaryOperator.Div }
    | '%=' { ast.BinaryOperator.Mod }
    | '&=' { ast.BinaryOperator.BitAnd }
    | '|=' { ast.BinaryOperator.BitOr }
    | '^=' { ast.BinaryOperator.BitXor }
    | '<<=' { ast.BinaryOperator.LShift }
    | '>>=' { ast.BinaryOperator.RShift }
    | '**=' { ast.BinaryOperator.Pow }
    | '//=' { ast.BinaryOperator.FloorDiv }

return_stmt[ast.Return]:
    | 'return' a=[star_expressions] { ast.Return(value=a, LOCATIONS) }

raise_stmt[ast.Raise]:
    | 'raise' a=expression b=['from' z=expression { z }] { ast.Raise(exc=a, cause=b, LOCATIONS) }
    | 'raise' { ast.Raise(exc=None, cause=None, LOCATIONS) }

global_stmt[ast.Global]: 'global' a=','.NAME+ {
    ast.Global(names=[n.string for n in a], LOCATIONS)
}

nonlocal_stmt[ast.Nonlocal]: 'nonlocal' a=','.NAME+ {
    ast.Nonlocal(names=[n.string for n in a], LOCATIONS)
}

print_stmt[ast.Expr]: p="print" a=','.expression+ b=[','] {
    ast.Expr(
        ast.Call(
            func=ast.Name(p.string, lineno=p.start[0], col_offset=p.start[1], end_lineno=p.end[0], end_col_offset=p.end[1]),
            args=a,
            keywords=[ast.Keyword("end", ast.Str("", LOCATIONS))] if b else [],
            LOCATIONS
        ),
        LOCATIONS
    )
}

del_stmt[ast.Delete]:
    | 'del' a=del_targets &(';' | NEWLINE) { ast.Delete(targets=a, LOCATIONS) }
    | invalid_del_stmt

yield_stmt[ast.Expr]: y=yield_expr { ast.Expr(value=y, LOCATIONS) }

assert_stmt[ast.Assert]: 'assert' a=expression b=[',' z=expression { z }] {
    ast.Assert(test=a, msg=b, LOCATIONS)
}

import_stmt[ast.BaseStatement] (memo):
    | invalid_import
    | import_name
    | import_from

# Import statements
# -----------------

import_name[ast.Import]: 'import' a=dotted_as_names { ast.Import(names=a, LOCATIONS) }

# note below: the ('.' | '...') is necessary because '...' is tokenized as ELLIPSIS
import_from[ast.ImportFrom]:
    | 'from' a=('.' | '...')* b=dotted_name 'import' c=import_from_targets {
        ast.ImportFrom(module=b, names=c, level=self.extract_import_level(a), LOCATIONS)
    }
    | 'from' a=('.' | '...')+ 'import' b=import_from_targets {
        ast.ImportFrom(names=b, level=self.extract_import_level(a), LOCATIONS)
    }
import_from_targets[List[ast.alias]]:
    | '(' a=import_from_as_names [','] ')' { a }
    | import_from_as_names !','
    | '*' { [ast.alias(name="*", asname=None, LOCATIONS)] }
    | invalid_import_from_targets
import_from_as_names[List[ast.alias]]:
    | a=','.import_from_as_name+ { a }
import_from_as_name[ast.alias]:
    | a=NAME '(' c=import_params* ')' '->' d=import_param b=['as' z=NAME { z.string }] {
        ast.Alias(name=a.string, asname=b, params=c, ret=d, LOCATIONS)
    }
    | a=NAME '(' c=import_params* ')' b=['as' z=NAME { z.string }] {
        ast.Alias(name=a.string, asname=b, params=c, LOCATIONS)
    }
    | a=NAME ':' d=import_param b=['as' z=NAME { z.string }] {
        ast.Alias(name=a.string, asname=b, ret=d, LOCATIONS)
    }
    | a=NAME b=['as' z=NAME { z.string }] {
        ast.alias(name=a.string, asname=b, LOCATIONS)
    }
import_params[ast.BaseExpression]:
    | a=import_param ',' { a }
    | a=import_param &')' { a }
import_param[ast.BaseExpression]: e=expression { e }

dotted_as_names[List[ast.alias]]:
    | a=','.dotted_as_name+ { a }
dotted_as_name[ast.alias]:
    | a=dotted_name b=['as' z=NAME { z.string }] { ast.alias(name=a, asname=b, LOCATIONS) }
dotted_name[str]:
    | a=dotted_name '.' b=NAME { a + "." + b.string }
    | a=NAME { a.string }

# COMPOUND STATEMENTS
# ===================

# Common elements
# ---------------

block[List[ast.BaseStatement]] (memo):
    | NEWLINE INDENT a=statements DEDENT { a }
    | simple_stmts
    | invalid_block

decorators[List[ast.BaseExpression]]: decorator+
decorator[ast.BaseExpression]:
    | a=('@' f=dec_maybe_call NEWLINE { f }) { a }
    | a=('@' f=named_expression NEWLINE { f }) { a }
dec_maybe_call[ast.BaseExpression]:
    | dn=dec_primary '(' z=[arguments] ')' {
        ast.Call(func=dn, args=z[0] if z else [], keywords=z[1] if z else [], LOCATIONS)
    }
    | dec_primary
dec_primary[ast.BaseExpression]:
    | a=dec_primary '.' b=NAME { ast.Attribute(value=a, attr=b.string, ctx=Load, LOCATIONS) }
    | a=NAME { ast.Name(id=a.string, ctx=Load, LOCATIONS) }

# Class definitions
# -----------------

class_def[ast.ClassDef]:
    | a=decorators b=class_def_raw { self.set_decorators(b, a) }
    | class_def_raw

class_def_raw[ast.ClassDef]:
    | invalid_class_def_raw
    | 'class' a=NAME t=[type_params] b=['(' z=[arguments] ')' { z }] &&':' c=block {
        ast.ClassDef(
            a.string,
            bases=b[0] if b else [],
            keywords=b[1] if b else [],
            body=c,
            type_params=t,
            LOCATIONS,
        )
    }

# Function definitions
# --------------------

function_def[ast.FunctionDef]:
    | (dp=decorator_not_llvm*) '@' "llvm" NEWLINE (da=decorator*) f=function_def_llvm {
        self.set_decorators(f, (dp or []) + (da or []))
    }
    | d=decorators f=function_def_raw { self.set_decorators(f, d) }
    | f=function_def_raw { f }

function_def_raw[ast.FunctionDef]:
    | invalid_def_raw
    | 'def' n=NAME t=[type_params] &&'(' params=[params] ')' a=['->' z=expression { z }] &&':' b=block {
        ast.FunctionDef(
            name=n.string,
            args=params or self.make_arguments(),
            returns=a,
            body=b,
            type_params=t,
            LOCATIONS,
        )
    }
    | 'async' 'def' n=NAME t=[type_params] &&'(' params=[params] ')' a=['->' z=expression { z }] &&':' b=block {
        ast.AsyncFunctionDef(
            name=n.string,
            args=params or self.make_arguments(),
            returns=a,
            body=b,
            type_params=t,
            LOCATIONS,
        )
    }

decorator_not_llvm[ast.BaseExpression]:
    | !('@' "llvm") d=decorator { d }
function_def_llvm[ast.FunctionDef]:
    | invalid_def_raw
    | 'def' n=NAME t=[type_params] &&'(' params=[params] ')' a=['->' z=expression { z }] &&':' b=llvm_block {
        ast.LLVMFunctionDef(
            name=n.string, args=params or self.make_arguments(), returns=a,
            body=[ast.Expr(ast.Str(b, prefix="llvm"))],
            type_params=t, LOCATIONS
        )
    }
llvm_block[str]: NEWLINE INDENT a=llvm_line+ DEDENT { ''.join(a) }
llvm_line[str]: ANY_BUT_NEWLINE* n=NEWLINE { n.line }

# Function parameters
# -------------------

params[ast.arguments]:
    | invalid_parameters
    | parameters

parameters[ast.arguments]:
    | a=slash_no_default b=param_no_default* c=param_with_default* d=[star_etc] {
        self.make_arguments(pos_only=a, param_no_default=b, param_default=c, after_star=d)
    }
    | a=slash_with_default b=param_with_default* c=[star_etc] {
        self.make_arguments(pos_only_with_default=a, param_default=b, after_star=c)
    }
    | a=param_no_default+ b=param_with_default* c=[star_etc] {
        self.make_arguments(param_no_default=a, param_default=b, after_star=c)
    }
    | a=param_with_default+ b=[star_etc] { self.make_arguments(param_default=a, after_star=b) }
    | a=star_etc { self.make_arguments(after_star=a) }

# Some duplication here because we can't write (',' | &')'),
# which is because we don't support empty alternatives (yet).
#

slash_no_default[List[Tuple[ast.arg, ast.BaseExpression | None]]]:
    | a=param_no_default+ '/' ',' { [(p, None) for p in a] }
    | a=param_no_default+ '/' &')' { [(p, None) for p in a] }
slash_with_default[List[Tuple[ast.arg, ast.BaseExpression | None]]]:
    | a=param_no_default* b=param_with_default+ '/' ',' { ([(p, None) for p in a] if a else []) + b }
    | a=param_no_default* b=param_with_default+ '/' &')' { ([(p, None) for p in a] if a else []) + b }

star_etc[Tuple[ast.arg | None,
               List[Tuple[ast.arg, ast.BaseExpression | None]],
               ast.arg | None,
               List[Tuple[ast.arg, ast.BaseExpression | None]]]]:
    | invalid_star_etc
    | '*' a=param_no_default b=param_maybe_default* c=[kwds] t=codon_type_param* {
        (cast(Optional[ast.Arg], a), b, c, Codon.unwrap(t))
    }
    | '*' a=param_no_default_star_annotation b=param_maybe_default* c=[kwds] t=codon_type_param* {
        (cast(Optional[ast.Arg], a), Codon.unwrap(b), c, Codon.unwrap(t))
    }
    | '*' ',' b=param_maybe_default+ c=[kwds] t=codon_type_param* {
        (None, b, c, Codon.unwrap(t))
    }
    | a=kwds t=codon_type_param* {
        (None, [], cast(Optional[ast.Arg], a), Codon.unwrap(t))
    }
    | t=codon_type_param* {
        (None, [], None, Codon.unwrap(t))
    }

kwds[ast.arg]:
    | invalid_kwds
    | '**' a=param_no_default { a }

# One parameter.  This *includes* a following comma and type comment.
#
# There are three styles:
# - No default
# - With default
# - Maybe with default
#
# There are two alternative forms of each, to deal with type comments:
# - Ends in a comma followed by an optional type comment
# - No comma, optional type comment, must be followed by close paren
# The latter form is for a final parameter without trailing comma.
#

param_no_default[ast.arg]:
    | a=param ',' { a }
    | a=param &')' { a }
param_no_default_star_annotation[ast.arg]:
    | a=param_star_annotation ',' { a }
    | a=param_star_annotation &')' { a }
param_with_default[Tuple[ast.arg, ast.BaseExpression | None]]:
    | a=param c=default ',' { (a, cast(Optional[ast.BaseExpression], c)) }
    | a=param c=default &')' { (a, cast(Optional[ast.BaseExpression], c)) }
param_maybe_default[Tuple[ast.arg, ast.BaseExpression | None]]:
    | a=param c=default? ',' { (a, c) }
    | a=param c=default? &')' { (a, c) }
codon_type_param[Tuple[ast.arg, ast.BaseExpression | None]]:
    | a=NAME ':' b=type_annotation c=default? ',' { (ast.arg(arg=a.string, annotation=b, LOCATIONS), c) }
    | a=NAME ':' b=type_annotation c=default? &')' { (ast.arg(arg=a.string, annotation=b, LOCATIONS), c) }
type_annotation[ast.BaseExpression]:
    | a="Literal" '[' b=("int" | "str" | "bool") ']' {
        ast.Subscript(
            value=ast.Name(a.string, lineno=a.start[0], col_offset=a.start[1], end_lineno=a.end[0], end_col_offset=a.end[1]),
            slice=ast.Name(b.string, lineno=b.start[0], col_offset=b.start[1], end_lineno=b.end[0], end_col_offset=b.end[1]),
            ctx=Load, LOCATIONS
        )
    }
    | a="type" { ast.Name(id=a.string, ctx=Load, LOCATIONS) }
param[ast.arg]: a=NAME b=annotation? { ast.arg(arg=a.string, annotation=b, LOCATIONS) }
param_star_annotation[ast.arg]: a=NAME b=star_annotation { ast.arg(arg=a.string, annotations=b, LOCATIONS) }
annotation[ast.BaseExpression]: ':' a=expression { a }
star_annotation[ast.BaseExpression]: ':' a=star_expression { a }
default[ast.BaseExpression]: '=' a=expression { a } | invalid_default

# If statement
# ------------

if_stmt[ast.If]:
    | invalid_if_stmt
    | 'if' a=named_expression ':' b=block c=elif_stmt { ast.If(test=a, body=b, orelse=c, LOCATIONS) }
    | 'if' a=named_expression ':' b=block c=[else_block] { ast.If(test=a, body=b, orelse=c, LOCATIONS) }
elif_stmt[List[ast.If]]:
    | invalid_elif_stmt
    | 'elif' a=named_expression ':' b=block c=elif_stmt { [ast.If(test=a, body=b, orelse=c, LOCATIONS)] }
    | 'elif' a=named_expression ':' b=block c=[else_block] { [ast.If(test=a, body=b, orelse=c, LOCATIONS)] }
else_block[List[ast.BaseStatement]]:
    | invalid_else_stmt
    | 'else' &&':' b=block { b }

# While statement
# ---------------

while_stmt[ast.While]:
    | invalid_while_stmt
    | 'while' a=named_expression ':' b=block c=[else_block] { ast.While(test=a, body=b, orelse=c, LOCATIONS) }

# For statement
# -------------

for_stmt[ast.For]:
    | a=decorators b=for_stmt_raw { self.set_decorators(b, a) }
    | for_stmt_raw

for_stmt_raw[ast.For]:
    | invalid_for_stmt
    | 'for' t=star_targets 'in' ~ ex=star_expressions &&':' b=block el=[else_block] {
        ast.For(target=t, iter=ex, body=b, orelse=el, LOCATIONS)
    }
    | 'async' 'for' t=star_targets 'in' ~ ex=star_expressions ':' b=block el=[else_block] {
        ast.AsyncFor(target=t, iter=ex, body=b, orelse=el, LOCATIONS)
    }
    | invalid_for_target

# With statement
# --------------

with_stmt[ast.With]:
    | invalid_with_stmt_indent
    | 'with' '(' a=','.with_item+ ','? ')' ':' b=block { ast.With(items=a, body=b, LOCATIONS) }
    | 'with' a=','.with_item+ ':' b=block { ast.With(items=a, body=b, LOCATIONS) }
    | 'async' 'with' '(' a=','.with_item+ ','? ')' ':' b=block { ast.AsyncWith(items=a, body=b, LOCATIONS) }
    | 'async' 'with' a=','.with_item+ ':' b=block { ast.AsyncWith(items=a, body=b, LOCATIONS) }
    | invalid_with_stmt

with_item[ast.withitem]:
    | e=expression 'as' t=star_target &(',' | ')' | ':') { ast.withitem(context_expr=e, optional_vars=t) }
    | invalid_with_item
    | e=expression { ast.withitem(context_expr=e, optional_vars=None) }

# Try statement
# -------------

try_stmt[ast.Try]:
    | invalid_try_stmt
    | 'try' &&':' b=block f=finally_block {
        ast.Try(body=b, finalbody=f, LOCATIONS)
    }
    | 'try' &&':' b=block ex=except_block+ el=[else_block] f=[finally_block] {
        ast.Try(body=b, handlers=ex, orelse=el, finalbody=f, LOCATIONS)
    }

# Except statement
# ----------------

except_block[ast.ExceptHandler]:
    | invalid_except_stmt_indent
    | 'except' e=expression t=['as' z=NAME { z.string }] ':' b=block {
        ast.ExceptHandler(type=e, name=t, body=b, LOCATIONS)
    }
    | 'except' ':' b=block { ast.ExceptHandler(type=None, name=None, body=b, LOCATIONS) }
    | invalid_except_stmt
except_star_block[ast.ExceptHandler]:
    | invalid_except_star_stmt_indent
    | 'except' '*' e=expression t=['as' z=NAME { z.string }] ':' b=block {
        ast.ExceptHandler(type=e, name=t, body=b, LOCATIONS)
    }
    | invalid_except_stmt
finally_block[List[ast.BaseStatement]]:
    | invalid_finally_stmt
    | 'finally' &&':' a=block { a }

# Match statement
# ---------------

match_stmt[ast.Match]:
    | "match" subject=subject_expr ':' NEWLINE INDENT cases=case_block+ DEDENT {
        ast.Match(subject=subject, cases=cases, LOCATIONS)
    }
    | invalid_match_stmt

subject_expr[ast.BaseExpression]:
    | value=star_named_expression ',' values=star_named_expressions? {
        ast.TupleEx(elts=[value] + (values or []), ctx=Load, LOCATIONS)
    }
    | e=named_expression { e }

case_block[ast.match_case]:
    | invalid_case_block
    | "case" pattern=patterns guard=guard? ':' body=block { ast.match_case(pattern=pattern, guard=guard, body=body) }

guard[ast.BaseExpression]: 'if' g=named_expression { g }

patterns[ast.MatchPattern]:
    | patterns=open_sequence_pattern { ast.MatchSequence(patterns=patterns, LOCATIONS) }
    | pattern

pattern[ast.MatchPattern]:
    | as_pattern
    | or_pattern

as_pattern[ast.MatchAs]:
    | pattern=or_pattern 'as' target=pattern_capture_target { ast.MatchAs(pattern=pattern, name=target, LOCATIONS) }
    | invalid_as_pattern

or_pattern[ast.MatchPattern]:
    | patterns='|'.closed_pattern+ { ast.MatchOr(patterns=patterns, LOCATIONS) if len(patterns) > 1 else patterns[0] }

closed_pattern[ast.MatchPattern] (memo):
    | literal_pattern
    | capture_pattern
    | wildcard_pattern
    | value_pattern
    | group_pattern
    | sequence_pattern
    | mapping_pattern
    | class_pattern

# Literal patterns are used for equality and identity constraints
literal_pattern[ast.MatchPattern]:
    | value=signed_number !('+' | '-') { ast.MatchValue(value=value, LOCATIONS) }
    | value=complex_number { ast.MatchValue(value=value, LOCATIONS) }
    | value=strings { ast.MatchValue(value=value, LOCATIONS) }
    | 'None' { ast.MatchSingleton(value=None, LOCATIONS) }
    | 'True' { ast.MatchSingleton(value=True, LOCATIONS) }
    | 'False' { ast.MatchSingleton(value=False, LOCATIONS) }

# Literal expressions are used to restrict permitted mapping pattern keys
literal_expr[ast.BaseExpression]:
    | signed_number !('+' | '-')
    | complex_number
    | strings
    | 'None' { ast.NoneValue(LOCATIONS) }
    | 'True' { ast.Bool(value=True, LOCATIONS) }
    | 'False' { ast.Bool(value=False, LOCATIONS) }

complex_number[ast.BinOp]:
    | real=signed_real_number '+' imag=imaginary_number {
        ast.BinOp(left=real, op=ast.BinaryOperator.Add, right=imag, LOCATIONS)
    }
    | real=signed_real_number '-' imag=imaginary_number  {
        ast.BinOp(left=real, op=ast.BinaryOperator.Sub, right=imag, LOCATIONS)
    }

signed_number[ast.BaseExpression]:
    | a=any_number { a }
    | '-' a=any_number { ast.UnaryOp(op=ast.UnaryOperator.USub, operand=a, LOCATIONS) }

signed_real_number[ast.BaseExpression]:
    | real_number
    | '-' real=real_number { ast.UnaryOp(op=ast.UnaryOperator.USub, operand=real, LOCATIONS) }

real_number[ast.Num]:
    | real=any_number { self.ensure_real(real) }

imaginary_number[ast.Num]:
    | imag=any_number { self.ensure_imaginary(imag) }

any_number[ast.Num]:
    | n=NUMBER s=NUMBER_SUFFIX? { ast.Num(value=n.string, suffix=s.string if s else "", LOCATIONS) }

capture_pattern[ast.MatchAs]:
    | target=pattern_capture_target { ast.MatchAs(pattern=None, name=target, LOCATIONS) }

pattern_capture_target[str]:
    | !"_" name=NAME !('.' | '(' | '=') { name.string }

wildcard_pattern[ast.MatchAs]:
    | "_" { ast.MatchAs(pattern=None, target=None, LOCATIONS) }

value_pattern[ast.MatchValue]:
    | attr=attr !('.' | '(' | '=') { ast.MatchValue(value=attr, LOCATIONS) }

attr[ast.Attribute]:
    | value=name_or_attr '.' a=NAME { ast.Attribute(value=value, attr=a.string, ctx=Load, LOCATIONS) }

name_or_attr[ast.BaseExpression]:
    | attr
    | name=NAME { ast.Name(id=name.string, ctx=Load, LOCATIONS) }

group_pattern[ast.MatchPattern]:
    | '(' pattern=pattern ')' { pattern }

sequence_pattern[ast.MatchSequence]:
    | '[' patterns=maybe_sequence_pattern? ']' { ast.MatchSequence(patterns=patterns or [], LOCATIONS) }
    | '(' patterns=open_sequence_pattern? ')' { ast.MatchSequence(patterns=patterns or [], LOCATIONS) }

open_sequence_pattern[List[ast.MatchPattern]]:
    | pattern=maybe_star_pattern ',' patterns=maybe_sequence_pattern? { [pattern] + (patterns or []) }

maybe_sequence_pattern[List[ast.MatchPattern]]:
    | patterns=','.maybe_star_pattern+ ','? { patterns }

maybe_star_pattern[ast.MatchPattern]:
    | star_pattern
    | pattern

star_pattern[ast.MatchStar] (memo):
    | '*' target=pattern_capture_target { ast.MatchStar(name=target, LOCATIONS) }
    | '*' wildcard_pattern { ast.MatchStar(target=None, LOCATIONS) }

mapping_pattern[ast.MatchMapping]:
    | '{' '}' { ast.MatchMapping(rest=None, LOCATIONS) }
    | '{' rest=double_star_pattern ','? '}' { ast.MatchMapping(rest=rest, LOCATIONS) }
    | '{' items=items_pattern ',' rest=double_star_pattern ','? '}' {
        ast.MatchMapping(keys=[k for k,_ in items], patterns=[p for _, p in items], rest=rest, LOCATIONS)
    }
    | '{' items=items_pattern ','? '}' {
        ast.MatchMapping(keys=[k for k,_ in items], patterns=[p for _, p in items], rest=None, LOCATIONS)
    }

items_pattern[List[Tuple[ast.BaseExpression, ast.MatchPattern]]]:
    | ','.key_value_pattern+

key_value_pattern[Tuple[ast.BaseExpression, ast.MatchPattern]]:
    | key=(literal_expr | attr) ':' pattern=pattern { (key, pattern) }

double_star_pattern[str]:
    | '**' target=pattern_capture_target { target }

class_pattern[ast.MatchClass]:
    | cls=name_or_attr '(' ')' { ast.MatchClass(cls=cls, LOCATIONS) }
    | cls=name_or_attr '(' patterns=positional_patterns ','? ')' {
        ast.MatchClass(cls=cls, patterns=patterns, LOCATIONS)
    }
    | cls=name_or_attr '(' keywords=keyword_patterns ','? ')' {
        ast.MatchClass(cls=cls, kwd_attrs=[k for k, _ in keywords], kwd_patterns=[p for _, p in keywords], LOCATIONS)
    }
    | cls=name_or_attr '(' patterns=positional_patterns ',' keywords=keyword_patterns ','? ')' {
        ast.MatchClass(
            cls=cls, patterns=patterns,
            kwd_attrs=[k for k, _ in keywords], kwd_patterns=[p for _, p in keywords],
            LOCATIONS,
        )
    }
    | invalid_class_pattern

positional_patterns[List[ast.MatchPattern]]:
    | args=','.pattern+ { args }

keyword_patterns[List[Tuple[str, ast.MatchPattern]]]:
    | ','.keyword_pattern+

keyword_pattern[Tuple[str, ast.MatchPattern]]:
    | arg=NAME '=' value=pattern { (arg.string, value) }


# Custom statements
# -----------------

custom_stmt[ast.Custom]:
    | !"_" a=SOFT_KEYWORD e=expression ':' b=block { ast.Custom(a.string, e, b) }
    | !"_" a=SOFT_KEYWORD ':' b=block { ast.Custom(a.string, None, b) }


# Type parameter declaration
# --------------------------

type_params[List[ast.TypeVar]]: '[' t=type_param_seq  ']' { t }
type_param_seq[List[ast.TypeVar]]: a=','.type_param+ [','] { a }
type_param[ast.TypeVar] (memo):
    | a=NAME b=[type_param_bound] { ast.TypeVar(name=a.string, bound=b, LOCATIONS) }
type_param_bound[ast.BaseExpression]: ":" e=expression { e }


# EXPRESSIONS
# -----------

expressions[ast.BaseExpression]:
    | a=expression b=(',' c=expression { c })+ [','] { ast.TupleEx(elts=[a] + b, ctx=Load, LOCATIONS) }
    | a=expression ',' { ast.TupleEx(elts=[a], ctx=Load, LOCATIONS) }
    | expression

expression[ast.BaseExpression] (memo):
    | invalid_expression
    | invalid_legacy_expression
    | a=disjunction 'if' b=disjunction 'else' c=expression { ast.IfExp(body=a, test=b, orelse=c, LOCATIONS) }
    | pipe
    | lambdef

yield_expr[ast.BaseExpression]:
    | 'yield' 'from' a=expression { ast.YieldFrom(value=a, LOCATIONS) }
    | 'yield' a=[star_expressions] { ast.Yield(value=a, LOCATIONS) }

star_expressions[ast.BaseExpression]:
    | a=star_expression b=(',' c=star_expression { c })+ [','] {
        ast.TupleEx(elts=[a] + b, ctx=Load, LOCATIONS)
    }
    | a=star_expression ',' { ast.TupleEx(elts=[a], ctx=Load, LOCATIONS) }
    | star_expression

star_expression[ast.BaseExpression] (memo):
    | '*' a=bitwise_or { ast.Starred(value=a, ctx=Load, LOCATIONS) }
    | expression

star_named_expressions[List[ast.BaseExpression]]: a=','.star_named_expression+ [','] { a }

star_named_expression[ast.BaseExpression]:
    | '*' a=bitwise_or { ast.Starred(value=a, ctx=Load, LOCATIONS) }
    | named_expression

assignment_expression[ast.BaseExpression]:
    | a=NAME ':=' ~ b=expression {
        ast.NamedExpr(
            target=ast.Name(id=a.string, ctx=Store,
                            lineno=a.start[0], col_offset=a.start[1], end_lineno=a.end[0], end_col_offset=a.end[1]),
            value=b, LOCATIONS
        )
    }

named_expression[ast.BaseExpression]:
    | assignment_expression
    | invalid_named_expression
    | a=expression !':=' { a }

pipe[ast.BaseExpression] (memo):
    | a=disjunction b=(p=pipe_operator d=disjunction { (p, d) })+ { ast.PipeOp(a, b, LOCATIONS) }
    | disjunction

pipe_operator[int]:
    | '||>' { ast.PipeOperator.Parallel }
    | '|>' { ast.PipeOperator.Pipe }

disjunction[ast.BaseExpression] (memo):
    | a=conjunction b=('or' c=conjunction { c })+ { ast.BoolOp(op=ast.BoolOperator.Or, values=[a] + b, LOCATIONS) }
    | conjunction

conjunction[ast.BaseExpression] (memo):
    | a=inversion b=('and' c=inversion { c })+ { ast.BoolOp(op=ast.BoolOperator.And, values=[a] + b, LOCATIONS) }
    | inversion

inversion[ast.BaseExpression] (memo):
    | 'not' a=inversion { ast.UnaryOp(op=ast.UnaryOperator.Not, operand=a, LOCATIONS) }
    | comparison

# Comparisons operators
# ---------------------

comparison[ast.BaseExpression]:
    | a=bitwise_or b=compare_op_bitwise_or_pair+ {
        ast.Compare(left=a, ops=self.get_comparison_ops(b), comparators=self.get_comparators(b), LOCATIONS)
    }
    | bitwise_or

# Make a tuple of operator and comparator
compare_op_bitwise_or_pair[Tuple[int, ast.BaseExpression]]:
    | eq_bitwise_or
    | noteq_bitwise_or
    | lte_bitwise_or
    | lt_bitwise_or
    | gte_bitwise_or
    | gt_bitwise_or
    | notin_bitwise_or
    | in_bitwise_or
    | isnot_bitwise_or
    | is_bitwise_or

eq_bitwise_or[Tuple[int, ast.BaseExpression]]: '==' a=bitwise_or { (ast.CompareOperator.Eq, a) }
noteq_bitwise_or[Tuple[int, ast.BaseExpression]]: '!=' a=bitwise_or { (ast.CompareOperator.NotEq, a) }
lte_bitwise_or[Tuple[int, ast.BaseExpression]]: '<=' a=bitwise_or { (ast.CompareOperator.LtE, a) }
lt_bitwise_or[Tuple[int, ast.BaseExpression]]: '<' a=bitwise_or { (ast.CompareOperator.Lt, a) }
gte_bitwise_or[Tuple[int, ast.BaseExpression]]: '>=' a=bitwise_or { (ast.CompareOperator.GtE, a) }
gt_bitwise_or[Tuple[int, ast.BaseExpression]]: '>' a=bitwise_or { (ast.CompareOperator.Gt, a) }
notin_bitwise_or[Tuple[int, ast.BaseExpression]]: 'not' 'in' a=bitwise_or { (ast.CompareOperator.NotIn, a) }
in_bitwise_or[Tuple[int, ast.BaseExpression]]: 'in' a=bitwise_or { (ast.CompareOperator.In, a) }
isnot_bitwise_or[Tuple[int, ast.BaseExpression]]: 'is' 'not' a=bitwise_or { (ast.CompareOperator.IsNot, a) }
is_bitwise_or[Tuple[int, ast.BaseExpression]]: 'is' a=bitwise_or { (ast.CompareOperator.Is, a) }

# Logical operators
# -----------------

bitwise_or[ast.BaseExpression]:
    | a=bitwise_or '|' b=bitwise_xor { ast.BinOp(left=a, op=ast.BinaryOperator.BitOr, right=b, LOCATIONS) }
    | bitwise_xor

bitwise_xor[ast.BaseExpression]:
    | a=bitwise_xor '^' b=bitwise_and { ast.BinOp(left=a, op=ast.BinaryOperator.BitXor, right=b, LOCATIONS) }
    | bitwise_and

bitwise_and[ast.BaseExpression]:
    | a=bitwise_and '&' b=shift_expr { ast.BinOp(left=a, op=ast.BinaryOperator.BitAnd, right=b, LOCATIONS) }
    | shift_expr

shift_expr[ast.BaseExpression]:
    | a=shift_expr '<<' b=sum { ast.BinOp(left=a, op=ast.BinaryOperator.LShift, right=b, LOCATIONS) }
    | a=shift_expr '>>' b=sum { ast.BinOp(left=a, op=ast.BinaryOperator.RShift, right=b, LOCATIONS) }
    | sum

# Arithmetic operators
# --------------------

sum[ast.BaseExpression]:
    | a=sum '+' b=term { ast.BinOp(left=a, op=ast.BinaryOperator.Add, right=b, LOCATIONS) }
    | a=sum '-' b=term { ast.BinOp(left=a, op=ast.BinaryOperator.Sub, right=b, LOCATIONS) }
    | term

term[ast.BaseExpression]:
    | a=term '*' b=factor { ast.BinOp(left=a, op=ast.BinaryOperator.Mult, right=b, LOCATIONS) }
    | a=term '/' b=factor { ast.BinOp(left=a, op=ast.BinaryOperator.Div, right=b, LOCATIONS) }
    | a=term '//' b=factor { ast.BinOp(left=a, op=ast.BinaryOperator.FloorDiv, right=b, LOCATIONS) }
    | a=term '%' b=factor { ast.BinOp(left=a, op=ast.BinaryOperator.Mod, right=b, LOCATIONS) }
    | a=term '@' b=factor { ast.BinOp(left=a, op=ast.BinaryOperator.MatMult, right=b, LOCATIONS) }
    | factor

factor[ast.BaseExpression] (memo):
    | '+' a=factor { ast.UnaryOp(op=ast.UnaryOperator.UAdd, operand=a, LOCATIONS) }
    | '-' a=factor { ast.UnaryOp(op=ast.UnaryOperator.USub, operand=a, LOCATIONS) }
    | '~' a=factor { ast.UnaryOp(op=ast.UnaryOperator.Invert, operand=a, LOCATIONS) }
    | power

power[ast.BaseExpression]:
    | a=await_primary '**' b=factor { ast.BinOp(left=a, op=ast.BinaryOperator.Pow, right=b, LOCATIONS) }
    | await_primary

# Primary elements
# ----------------

# Primary elements are things like "obj.something.something", "obj[something]", "obj(something)", "obj" ...

await_primary[ast.BaseExpression] (memo):
    | 'await' a=primary { ast.Await(a, LOCATIONS) }
    | primary

primary[ast.BaseExpression]:
    | a=primary '.' b=NAME { ast.Attribute(value=a, attr=b.string, ctx=Load, LOCATIONS) }
    | a=primary b=genexp { ast.Call(func=a, args=[b], LOCATIONS) }
    | a=primary '(' b=[arguments_with_partial] '...' ')' {
        ast.PartialCall(func=a, args=b[0] if b else [], keywords=b[1] if b else [], LOCATIONS)
    }
    | a=primary '(' b=[arguments] ')' {
        ast.Call(func=a, args=b[0] if b else [], keywords=b[1] if b else [], LOCATIONS)
    }
    | a=primary '[' b=slices ']' { ast.Subscript(value=a, slice=b, ctx=Load, LOCATIONS) }
    | atom

slices[ast.BaseExpression]:
    | a=slice !',' { a }
    | a=','.(slice | starred_expression)+ [','] { ast.TupleEx(elts=a, ctx=Load, LOCATIONS) }

slice[ast.BaseExpression]:
    | a=[expression] ':' b=[expression] c=[':' d=[expression] { d }] { ast.Slice(lower=a, upper=b, step=c, LOCATIONS) }
    | a=named_expression { a }

atom[ast.BaseExpression]:
    | a=NAME { ast.Name(id=a.string, ctx=Load, LOCATIONS) }
    | 'True' { ast.Bool(value=True, LOCATIONS) }
    | 'False' { ast.Bool(value=False, LOCATIONS) }
    | 'None' { ast.NoneValue(LOCATIONS) }
    | &(STRING|FSTRING_START|STRING_PREFIX) strings
    | any_number
    | &'(' (tuple | group | genexp)
    | &'[' (list | listcomp)
    | &'{' (dict | set | dictcomp | setcomp)
    | '...' { ast.Ellipsis(LOCATIONS) }

group[ast.BaseExpression]:
    | '(' a=(yield_expr | named_expression) ')' { a }
    | invalid_group


# Lambda functions
# ----------------

lambdef[ast.Lambda]:
    | 'lambda' a=[lambda_params] ':' b=expression { ast.Lambda(args=a or self.make_arguments(), body=b, LOCATIONS) }

lambda_params:
    | invalid_lambda_parameters
    | lambda_parameters

# lambda_parameters etc. duplicates parameters but without annotations
# or type comments, and if there's no comma after a parameter, we expect
# a colon, not a close parenthesis.  (For more, see parameters above.)
#
lambda_parameters[ast.arguments]:
    | a=lambda_slash_no_default b=lambda_param_no_default* c=lambda_param_with_default* d=[lambda_star_etc] {
        self.make_arguments(pos_only=a, param_no_default=b, param_default=c, after_star=d)
    }
    | a=lambda_slash_with_default b=lambda_param_with_default* c=[lambda_star_etc] {
        self.make_arguments(pos_only_with_default=a, param_default=b, after_star=c)
    }
    | a=lambda_param_no_default+ b=lambda_param_with_default* c=[lambda_star_etc] {
        self.make_arguments(param_no_default=a, param_default=b, after_star=c)
    }
    | a=lambda_param_with_default+ b=[lambda_star_etc] { self.make_arguments(param_default=a, after_star=b) }
    | a=lambda_star_etc { self.make_arguments(after_star=a) }

lambda_slash_no_default[List[Tuple[ast.arg, ast.BaseExpression | None]]]:
    | a=lambda_param_no_default+ '/' ',' { [(p, None) for p in a] }
    | a=lambda_param_no_default+ '/' &':' { [(p, None) for p in a] }

lambda_slash_with_default[List[Tuple[ast.arg, ast.BaseExpression | None]]]:
    | a=lambda_param_no_default* b=lambda_param_with_default+ '/' ',' {
        ([(p, None) for p in a] if a else []) + b
    }
    | a=lambda_param_no_default* b=lambda_param_with_default+ '/' &':' {
        ([(p, None) for p in a] if a else []) + b
    }

lambda_star_etc[Tuple[ast.arg | None,
                      List[Tuple[ast.arg, ast.BaseExpression | None]],
                      ast.arg | None,
                      List[Tuple[ast.arg, ast.BaseExpression | None]]]]:
    | invalid_lambda_star_etc
    | '*' a=lambda_param_no_default b=lambda_param_maybe_default* c=[lambda_kwds] { (cast(Optional[ast.arg], a), b, c, []) }
    | '*' ',' b=lambda_param_maybe_default+ c=[lambda_kwds] { (None, b, c, []) }
    | a=lambda_kwds { (None, [], cast(Optional[ast.arg], a), []) }

lambda_kwds[ast.arg]:
    | invalid_lambda_kwds
    | '**' a=lambda_param_no_default { a }

lambda_param_no_default[ast.arg]:
    | a=lambda_param ',' { a }
    | a=lambda_param &':' { a }

lambda_param_with_default[Tuple[ast.arg, ast.BaseExpression | None]]:
    | a=lambda_param c=default ',' { (a, cast(Optional[ast.BaseExpression], c)) }
    | a=lambda_param c=default &':' { (a, cast(Optional[ast.BaseExpression], c)) }
lambda_param_maybe_default[Tuple[ast.arg, ast.BaseExpression | None]]:
    | a=lambda_param c=default? ',' { (a, c) }
    | a=lambda_param c=default? &':' { (a, c) }
lambda_param[ast.arg]: a=NAME { ast.arg(arg=a.string, annotation=None, LOCATIONS) }

# LITERALS
# ========

fstring_mid[ast.BaseExpression]:
    | fstring_replacement_field
    | t=FSTRING_MIDDLE { ast.Str(value=t.string, LOCATIONS) }
fstring_replacement_field[ast.FormattedValue]:
    | '{' a=(yield_expr | star_expressions) debug_expr="="? conversion=[fstring_conversion] format=[fstring_full_format_spec] '}' {
        ast.FormattedValue(
            value=a,
            conversion=(conversion or ("r" if debug_expr else "")),
            format_spec=format,
            LOCATIONS
        )
    }
    | invalid_replacement_field
fstring_conversion[str]:
    | conv_token="!" conv=NAME { self.check_fstring_conversion(conv_token, conv) }
fstring_full_format_spec[str]:
    | ':' spec=fstring_format_spec* { ''.join(spec) }
fstring[ast.JoinedStr]:
    | a=FSTRING_START b=fstring_mid* c=FSTRING_END { ast.JoinedStr(values=b, LOCATIONS) }

fstring_format_spec[str]:
    | a=[fstring_options] b=[fstring_width_and_precision] c=[fstring_type] {
        (a or "") + (b or "") + (c.string if c else "")
    }
fstring_options[str]:
    | a=[fstring_options_head] b=['+' | '-'] c=["z"] d=["#"] e=["0"] {
        (a or "") + (b.string if b else "") + (c.string if c else "") + (d.string if d else "") + (e.string if e else "")
    }
fstring_options_head[str]: n=[ANY_BUT_NEWLINE] o=('<' | '>' | '=' | '^') { (n.string if n else "") + o.string }
fstring_width_and_precision[str]:
    | a=[n=[NUMBER] g=[fstring_grouping] {(n.string if n else "") + (g or "")}] b=[fstring_precision_with_grouping] {
        (a or "") + (b or "")
    }
fstring_precision_with_grouping[str]:
    | a='.' b=[NUMBER] c=[fstring_grouping] { a.string + (b.string if b else "") + (c or "")}
    | a='.' b=fstring_grouping { a.string + b }
fstring_grouping[str]: a=',' { a.string } | a="_" { a.string }
fstring_type: "b" | "c" | "d" | "e" | "E" | "f" | "F" | "g" | "G" | "n" | "o" | "s" | "x" | "X" | '%'

strings[ast.BaseExpression] (memo): a=(any_string)+ { self.generate_ast_for_string(a) }

any_string[ast.BaseExpression]:
    | f=fstring { f }
    | p=STRING_PREFIX? s=STRING { self.fix_string(s, p.string if p else "") }

list[ast.BaseExpression]:
    | '[' a=[star_named_expressions] ']' { ast.ListEx(elts=a, ctx=Load, LOCATIONS) }

tuple[ast.BaseExpression]:
    | '(' a=[y=star_named_expression ',' z=[star_named_expressions] { [y] + (z or []) } ] ')' {
        ast.TupleEx(elts=a, ctx=Load, LOCATIONS)
    }

set[ast.BaseExpression]: '{' a=star_named_expressions '}' { ast.SetEx(elts=a, LOCATIONS) }

# Dicts
# -----

dict[ast.BaseExpression]:
    | '{' a=[double_starred_kvpairs] '}' {
        ast.DictEx(keys=[kv[0] for kv in (a or [])], values=[kv[1] for kv in (a or [])], LOCATIONS)
    }
    | '{' invalid_double_starred_kvpairs '}'

double_starred_kvpairs[List[Tuple[ast.BaseExpression | None, ast.BaseExpression]]]:
    | a=','.double_starred_kvpair+ [','] { a }

double_starred_kvpair[Tuple[ast.BaseExpression | None, ast.BaseExpression]]:
    | '**' a=bitwise_or { (None, a) }
    | kvpair

kvpair[Tuple[ast.BaseExpression | None, ast.BaseExpression]]:
    | a=expression ':' b=expression { (cast(Optional[ast.BaseExpression], a), b) }

# Comprehensions & Generators
# ---------------------------

for_if_clauses[List[ast.comprehension]]:
    | a=for_if_clause+ { a }

for_if_clause[ast.comprehension]:
    | 'async' 'for' a=star_targets 'in' ~ b=disjunction c=('if' z=disjunction { z })* {
        ast.comprehension(target=a, iter=b, ifs=c, is_async=1)
    }
    | 'for' a=star_targets 'in' ~ b=disjunction c=('if' z=disjunction { z })* {
       ast.comprehension(target=a, iter=b, ifs=c, is_async=0)
    }
    | invalid_for_target

listcomp[ast.ListComp]:
    | '[' a=named_expression b=for_if_clauses ']' { ast.ListComp(elt=a, generators=b, LOCATIONS) }
    | invalid_comprehension

setcomp[ast.SetComp]:
    | '{' a=named_expression b=for_if_clauses '}' { ast.SetComp(elt=a, generators=b, LOCATIONS) }
    | invalid_comprehension

genexp[ast.GeneratorExp]:
    | '(' a=( assignment_expression | expression !':=') b=for_if_clauses ')' {
        ast.GeneratorExp(elt=a, generators=b, LOCATIONS)
     }
    | invalid_comprehension

dictcomp[ast.DictComp]:
    | '{' a=kvpair b=for_if_clauses '}' { ast.DictComp(key=a[0], value=a[1], generators=b, LOCATIONS) }
    | invalid_dict_comprehension

# FUNCTION CALL ARGUMENTS
# =======================

arguments_with_partial[Tuple[List[ast.BaseExpression], List[ast.keyword]]] (memo):
    | a=args ',' &'...' { a }
    | invalid_arguments

arguments[Tuple[List[ast.BaseExpression], List[ast.keyword]]] (memo):
    | a=args [','] &')' { a }
    | invalid_arguments

args[Tuple[List[ast.BaseExpression], List[ast.keyword]]]:
    | a=','.(starred_expression | ( assignment_expression | expression !':=') !'=')+ b=[',' k=kwargs {k}] {
        (a + ([cast(ast.BaseExpression, e) for e in b if isinstance(e, ast.Starred)] if b else []),
         ([cast(ast.keyword, e) for e in b if not isinstance(e, ast.Starred)] if b else []))
    }
    | a=kwargs {
        ([cast(ast.BaseExpression, e) for e in a if isinstance(e, ast.Starred)],
         [cast(ast.keyword, e) for e in a if not isinstance(e, ast.Starred)]) }

kwargs[List[ast.AST]]:
    | a=','.kwarg_or_starred+ ',' b=','.kwarg_or_double_starred+ { a + b }
    | ','.kwarg_or_starred+
    | ','.kwarg_or_double_starred+

starred_expression[ast.BaseExpression]:
    | invalid_starred_expression
    | '*' a=expression { ast.Starred(value=a, ctx=Load, LOCATIONS) }
    | invalid_star

kwarg_or_starred[ast.AST]:
    | invalid_kwarg
    | a=NAME '=' b=expression { ast.keyword(arg=a.string, value=b, LOCATIONS) }
    | a=starred_expression { a }

kwarg_or_double_starred[ast.AST]:
    | invalid_kwarg
    | a=NAME '=' b=expression { ast.keyword(arg=a.string, value=b, LOCATIONS) }   # XXX Unreachable
    | '**' a=expression { ast.keyword(arg=None, value=a, LOCATIONS) }

# ASSIGNMENT TARGETS
# ==================

# Generic targets
# ---------------

# NOTE: star_targets may contain *bitwise_or, targets may not.
star_targets[ast.BaseExpression]:
    | a=star_target !',' { a }
    | a=star_target b=(',' c=star_target { c })* [','] { ast.TupleEx(elts=[a] + b, ctx=Store, LOCATIONS) }

star_targets_list_seq[List[ast.BaseExpression]]: a=','.star_target+ [','] { a }

star_targets_tuple_seq[List[ast.BaseExpression]]:
    | a=star_target b=(',' c=star_target { c })+ [','] { [a] + b }
    | a=star_target ',' { [a] }

star_target[ast.BaseExpression] (memo):
    | '*' a=(!'*' star_target) { ast.Starred(value=self.set_expr_context(a, Store), ctx=Store, LOCATIONS) }
    | target_with_star_atom

target_with_star_atom[ast.BaseExpression] (memo):
    | a=t_primary '.' b=NAME !t_lookahead { ast.Attribute(value=a, attr=b.string, ctx=Store, LOCATIONS) }
    | a=t_primary '[' b=slices ']' !t_lookahead { ast.Subscript(value=a, slice=b, ctx=Store, LOCATIONS) }
    | star_atom

star_atom[ast.BaseExpression]:
    | a=NAME { ast.Name(id=a.string, ctx=Store, LOCATIONS) }
    | '(' a=target_with_star_atom ')' { self.set_expr_context(a, Store) }
    | '(' a=[star_targets_tuple_seq] ')' { ast.TupleEx(elts=a, ctx=Store, LOCATIONS) }
    | '[' a=[star_targets_list_seq] ']' {  ast.ListEx(elts=a, ctx=Store, LOCATIONS) }

single_target[ast.BaseExpression]:
    | single_subscript_attribute_target
    | a=NAME { ast.Name(id=a.string, ctx=Store, LOCATIONS) }
    | '(' a=single_target ')' { a }

single_subscript_attribute_target[ast.BaseExpression]:
    | a=t_primary '.' b=NAME !t_lookahead { ast.Attribute(value=a, attr=b.string, ctx=Store, LOCATIONS) }
    | a=t_primary '[' b=slices ']' !t_lookahead { ast.Subscript(value=a, slice=b, ctx=Store, LOCATIONS) }


t_primary[ast.BaseExpression]:
    | a=t_primary '.' b=NAME &t_lookahead { ast.Attribute(value=a, attr=b.string, ctx=Load, LOCATIONS) }
    | a=t_primary '[' b=slices ']' &t_lookahead { ast.Subscript(value=a, slice=b, ctx=Load, LOCATIONS) }
    | a=t_primary b=genexp &t_lookahead { ast.Call(func=a, args=[b], LOCATIONS) }
    | a=t_primary '(' b=[arguments_with_partial] '...' ')' &t_lookahead {
        ast.PartialCall(func=a, args=b[0] if b else [], keywords=b[1] if b else [], LOCATIONS)
    }
    | a=t_primary '(' b=[arguments] ')' &t_lookahead {
        ast.Call(func=a, args=b[0] if b else [], keywords=b[1] if b else [], LOCATIONS)
    }
    | a=atom &t_lookahead { a }

t_lookahead: '(' | '[' | '.'

# Targets for del statements
# --------------------------

del_targets[List[ast.BaseExpression]]: a=','.del_target+ [','] { a }

del_target[ast.BaseExpression] (memo):
    | a=t_primary '.' b=NAME !t_lookahead { ast.Attribute(value=a, attr=b.string, ctx=Del, LOCATIONS) }
    | a=t_primary '[' b=slices ']' !t_lookahead { ast.Subscript(value=a, slice=b, ctx=Del, LOCATIONS) }
    | del_t_atom

del_t_atom[ast.BaseExpression]:
    | a=NAME { ast.Name(id=a.string, ctx=Del, LOCATIONS) }
    | '(' a=del_target ')' { self.set_expr_context(a, Del) }
    | '(' a=[del_targets] ')' { ast.TupleEx(elts=a, ctx=Del, LOCATIONS) }
    | '[' a=[del_targets] ']' { ast.ListEx(elts=a, ctx=Del, LOCATIONS) }

# ========================= END OF THE GRAMMAR ===========================



# ========================= START OF INVALID RULES =======================

# From here on, there are rules for invalid syntax with specialised error messages
# N.B. (rule { True }) returns "True" to ensure that the non-compatible types in the rule can be matched
# in single expression without raising Codon type errors.
invalid_arguments[None]:
    | ( (','.(starred_expression | ( assignment_expression | expression !':=') !'=')+ ',' kwargs { True })
        | kwargs ) a=',' ','.(starred_expression !'=')+ {
        self.raise_syntax_error_starting_from(
            "iterable argument unpacking follows keyword argument unpacking",
            a,
        )
    }
    | a=expression b=for_if_clauses ',' [args { True } | expression for_if_clauses { True }] {
        self.raise_syntax_error_known_range(
            "Generator expression must be parenthesized",
            a,
            (b[-1].ifs[-1] if b[-1].ifs else b[-1].iter)
        )
    }
    | a=NAME b='=' expression for_if_clauses {
        self.raise_syntax_error_known_range(
            "invalid syntax. Maybe you meant '==' or ':=' instead of '='?", a, b
        )
    }
    | (ar=args ',' { ar })? a=NAME b='=' &(',' | ')') {
        self.raise_syntax_error_known_range("expected argument value expression", a, b)
    }
    | a=args b=for_if_clauses {
        self.raise_syntax_error_known_range(
            "Generator expression must be parenthesized",
            a[0][-1],
            (b[-1].ifs[-1] if b[-1].ifs else b[-1].iter),
        )
        if len(a[0]) > 1
        else None
    }
    | args ',' a=expression b=for_if_clauses {
        self.raise_syntax_error_known_range(
            "Generator expression must be parenthesized",
            a,
            (b[-1].ifs[-1] if b[-1].ifs else b[-1].iter),
        )
    }
    | a=args ',' args {
        self.raise_syntax_error(
            "positional argument follows keyword argument unpacking"
            if a[1][-1].arg is None else
            "positional argument follows keyword argument",
        )
    }
invalid_kwarg[None]:
    | a=('True'|'False'|'None') b='=' {
        self.raise_syntax_error_known_range(f"cannot assign to {a.string}", a, b)
    }
    | a=NAME b='=' expression for_if_clauses {
        self.raise_syntax_error_known_range(
            "invalid syntax. Maybe you meant '==' or ':=' instead of '='?", a, b
        )
    }
    | !(NAME '=') a=expression b='=' {
        self.raise_syntax_error_known_range(
            "expression cannot contain assignment, perhaps you meant \"==\"?", a, b,
        )
    }
    | a='**' expression '=' b=expression {
        self.raise_syntax_error_known_range(
            "cannot assign to keyword argument unpacking", a, b
        )
    }

# IMPORTANT: Note that the "_without_invalid" suffix causes the rule to
# not call invalid rules under it
expression_without_invalid[ast.BaseExpression]:
    | a=disjunction 'if' b=disjunction 'else' c=expression { ast.IfExp(body=b, test=a, orelse=c, LOCATIONS) }
    | pipe
    | lambdef
invalid_legacy_expression[None]:
    | a=NAME !'(' b=star_expressions {
        self.raise_syntax_error_known_range(
            f"Missing parentheses in call to '{a.string}' . Did you mean {a.string}(...)?", a, b,
        ) if a.string in ("exec", "print") else
        None
    }
invalid_expression[None]:
    # !(NAME STRING) is not matched so we don't show this error with some invalid string prefixes like: kf"dsfsdf"
    # Soft keywords need to also be ignored because they can be parsed as NAME NAME
    | !(n=NAME STRING { n } | SOFT_KEYWORD) a=pipe b=expression_without_invalid {
        self.raise_syntax_error_known_range("invalid syntax. Perhaps you forgot a comma?", a, b)
        if not isinstance(a, ast.Name) or cast(ast.Name, a).id not in ("print", "exec")
        else None
    }
    | a=disjunction 'if' b=disjunction !('else'|':') {
        self.raise_syntax_error_known_range("expected 'else' after 'if' expression", a, b)
    }
    | a='lambda' [lambda_params] b=':' &(FSTRING_MIDDLE { True } | fstring_replacement_field { True })  {
        self.raise_syntax_error_known_range(
            "f-string: lambda expressions are not allowed without parentheses", a, b
        )
    }
invalid_named_expression[None] (memo):
    | a=expression ':=' expression {
        self.raise_syntax_error_known_location(
            f"cannot use assignment expressions with {self.get_expr_name(a)}", a
        )
    }
    # Use in_raw_rule
    | a=NAME '=' b=bitwise_or !('='|':=') {
        None
        if self.in_recursive_rule else
        self.raise_syntax_error_known_range(
            "invalid syntax. Maybe you meant '==' or ':=' instead of '='?", a, b
        )
    }
    | !((list|tuple|genexp) { True }|('True'|'None'|'False') { True }) a=bitwise_or b='=' bitwise_or !('='|':=') {
        None
        if self.in_recursive_rule else
        self.raise_syntax_error_known_location(
            f"cannot assign to {self.get_expr_name(a)} here. Maybe you meant '==' instead of '='?", a
        )
    }

invalid_assignment[None]:
    | a=invalid_ann_assign_target ':' expression {
        self.raise_syntax_error_known_location(
            f"only single target (not {self.get_expr_name(a)}) can be annotated", a
        )
    }
    | a=star_named_expression ',' star_named_expressions* ':' expression {
        self.raise_syntax_error_known_location("only single target (not tuple) can be annotated", a) }
    | a=expression ':' expression {
        self.raise_syntax_error_known_location("illegal target for annotation", a) }
    | (star_targets '=' { True })* a=star_expressions '=' {
        self.raise_syntax_error_invalid_target(Target.STAR_TARGETS, a)
    }
    | (star_targets '=' { True })* a=yield_expr '=' {
        self.raise_syntax_error_known_location("assignment to yield expression not possible", a)
    }
    | a=star_expressions augassign (yield_expr | star_expressions) {
        self.raise_syntax_error_known_location(
            f"'{self.get_expr_name(a)}' is an illegal expression for augmented assignment", a
        )
    }
invalid_ann_assign_target[ast.BaseExpression]:
    | a=list { a }
    | a=tuple { a }
    | '(' a=invalid_ann_assign_target ')' { a }
invalid_del_stmt[None]:
    | 'del' a=star_expressions {
        self.raise_syntax_error_invalid_target(Target.DEL_TARGETS, a)
    }
invalid_block[None]:
    | NEWLINE !INDENT { self.raise_indentation_error("expected an indented block") }
invalid_comprehension[None]:
    | ('[' | '(' | '{') a=starred_expression for_if_clauses {
        self.raise_syntax_error_known_location("iterable unpacking cannot be used in comprehension", a)
    }
    | ('[' | '{') a=star_named_expression ',' b=star_named_expressions for_if_clauses {
        self.raise_syntax_error_known_range(
            "did you forget parentheses around the comprehension target?", a, b[-1]
        )
    }
    | ('[' | '{') a=star_named_expression b=',' for_if_clauses {
        self.raise_syntax_error_known_range(
            "did you forget parentheses around the comprehension target?", a, b
        )
    }
invalid_dict_comprehension[None]:
    | '{' a='**' bitwise_or for_if_clauses '}' {
        self.raise_syntax_error_known_location("dict unpacking cannot be used in dict comprehension", a)
    }
invalid_parameters[None]:
    | a="/" ',' {
        self.raise_syntax_error_known_location("at least one argument must precede /", a)
    }
    | (slash_no_default | slash_with_default) param_maybe_default* a='/' {
        self.raise_syntax_error_known_location("/ may appear only once", a)
    }
    | slash_no_default? param_no_default* invalid_parameters_helper a=param_no_default {
        self.raise_syntax_error_known_location(
            "parameter without a default follows parameter with a default", a
        )
    }
    | param_no_default* a='(' param_no_default+ ','? b=')' {
        self.raise_syntax_error_known_range(
            "Function parameters cannot be parenthesized", a, b
        )
    }
    | (slash_no_default | slash_with_default)? param_maybe_default* '*' (',' { True } | param_no_default { True }) param_maybe_default* a='/' {
        self.raise_syntax_error_known_location("/ must be ahead of *", a)
    }
    | param_maybe_default+ '/' a='*' {
        self.raise_syntax_error_known_location("expected comma between / and *", a)
    }
invalid_default[None]:
    | a='=' &(')'|',') {
        self.raise_syntax_error_known_location("expected default value expression", a)
    }
invalid_star_etc[None]:
    | a='*' (')' | (c=',' (')' | '**') { c })) {
        self.raise_syntax_error_known_location("named arguments must follow bare *", a)
    }
    | '*' param a='=' {
        self.raise_syntax_error_known_location("var-positional argument cannot have default value", a)
    }
    | '*' (param_no_default { True } | ',' { True }) param_maybe_default* a='*' (param_no_default { True } | ',' { True }) {
        self.raise_syntax_error_known_location("* argument may appear only once", a)
    }
invalid_star[None]:
    | '*' { self.raise_syntax_error("Invalid star expression") }
invalid_kwds[None]:
    | '**' param a='=' {
        self.raise_syntax_error_known_location("var-keyword argument cannot have default value", a)
    }
    | '**' param ',' a=param {
        self.raise_syntax_error_known_location("arguments cannot follow var-keyword argument", a)
    }
    | '**' param ',' a=('*'|'**'|'/') {
        self.raise_syntax_error_known_location("arguments cannot follow var-keyword argument", a)
    }
invalid_parameters_helper: # This is only there to avoid type errors
    | a=slash_with_default
    | a=param_with_default+ { a }
invalid_lambda_parameters[None]:
    | a="/" ',' {
        self.raise_syntax_error_known_location("at least one argument must precede /", a)
    }
    | (lambda_slash_no_default | lambda_slash_with_default) lambda_param_maybe_default* a='/' {
        self.raise_syntax_error_known_location("/ may appear only once", a)
    }
    | lambda_slash_no_default? lambda_param_no_default* invalid_lambda_parameters_helper a=lambda_param_no_default {
        self.raise_syntax_error_known_location("parameter without a default follows parameter with a default", a)
    }
    | lambda_param_no_default* a='(' ','.lambda_param+ ','? b=')' {
        self.raise_syntax_error_known_range("Lambda expression parameters cannot be parenthesized", a, b)
    }
    | (lambda_slash_no_default | lambda_slash_with_default)? lambda_param_maybe_default* '*' (',' { True } | lambda_param_no_default { True }) lambda_param_maybe_default* a='/' {
        self.raise_syntax_error_known_location("/ must be ahead of *", a)
    }
    | lambda_param_maybe_default+ '/' a='*' {
        self.raise_syntax_error_known_location("expected comma between / and *", a)
    }
invalid_lambda_parameters_helper:
    | a=lambda_slash_with_default
    | a=lambda_param_with_default+ { a }
invalid_lambda_star_etc[None]:
    | '*' (':' | p=',' (':' | '**') { p }) {
        self.raise_syntax_error("named arguments must follow bare *")
    }
    | '*' lambda_param a='=' {
        self.raise_syntax_error_known_location("var-positional argument cannot have default value", a)
    }
    | '*' (lambda_param_no_default { True } | ',' { True }) lambda_param_maybe_default* a='*' (lambda_param_no_default { True } | ',' { True }) {
        self.raise_syntax_error_known_location("* argument may appear only once", a)
    }
invalid_lambda_kwds[None]:
    | '**' lambda_param a='=' {
        self.raise_syntax_error_known_location("var-keyword argument cannot have default value", a)
    }
    | '**' lambda_param ',' a=lambda_param {
        self.raise_syntax_error_known_location("arguments cannot follow var-keyword argument", a)
    }
    | '**' lambda_param ',' a=('*'|'**'|'/') {
        self.raise_syntax_error_known_location("arguments cannot follow var-keyword argument", a)
    }
invalid_with_item[None]:
    | expression 'as' a=expression &(',' | ')' | ':') {
        self.raise_syntax_error_invalid_target(Target.STAR_TARGETS, a)
    }

invalid_for_target[None]:
    | 'async'? 'for' a=star_expressions {
        self.raise_syntax_error_invalid_target(Target.FOR_TARGETS, a)
    }

invalid_group[None]:
    | '(' a=starred_expression ')' {
        self.raise_syntax_error_known_location("cannot use starred expression here", a)
    }
    | '(' a='**' expression ')' {
        self.raise_syntax_error_known_location("cannot use double starred expression here", a)
    }
invalid_import[None]:
    | a='import' ','.dotted_name+ 'from' dotted_name {
        self.raise_syntax_error_starting_from(
            "Did you mean to use 'from ... import ...' instead?", a
        )
    }
invalid_import_from_targets[None]:
    | import_from_as_names ',' NEWLINE {
        self.raise_syntax_error("trailing comma not allowed without surrounding parentheses")
    }

invalid_with_stmt[None]:
    | ['async'] 'with' ','.(expression ['as' s=star_target { s }])+ &&':' { UNREACHABLE }
    | ['async'] 'with' '(' ','.(expressions ['as' s=star_target { s }])+ ','? ')' &&':' { UNREACHABLE }
invalid_with_stmt_indent[None]:
    | ['async'] a='with' ','.(expression ['as' s=star_target { s }])+ ':' NEWLINE !INDENT {
        self.raise_indentation_error(
            f"expected an indented block after 'with' statement on line {a.start[0]}"
        )
    }
    | ['async'] a='with' '(' ','.(expressions ['as' s=star_target { s }])+ ','? ')' ':' NEWLINE !INDENT {
        self.raise_indentation_error(
            f"expected an indented block after 'with' statement on line {a.start[0]}"
        )
    }

invalid_try_stmt[None]:
    | a='try' ':' NEWLINE !INDENT {
        self.raise_indentation_error(
            f"expected an indented block after 'try' statement on line {a.start[0]}",
        )
    }
    | 'try' ':' block !('except' | 'finally') {
        self.raise_syntax_error("expected 'except' or 'finally' block")
    }
    | 'try' ':' block* except_block+ a='except' b='*' expression ['as' NAME { True }] ':' {
        self.raise_syntax_error_known_range(
            "cannot have both 'except' and 'except*' on the same 'try'", a, b
        )
    }
    | 'try' &&':' b=block ex=except_star_block+ el=[else_block] f=[finally_block] {
        self.raise_syntax_error_known_location(
            "except* not yet supported", a
        )
    }
    | 'try' ':' block* except_star_block+ a='except' [e=expression ['as' NAME { True }] { e }] ':' {
        self.raise_syntax_error_known_location(
            "cannot have both 'except' and 'except*' on the same 'try'", a
        )
    }
invalid_except_stmt[None]:
    | 'except' '*'? a=expression ',' expressions ['as' NAME { True }] ':' {
        self.raise_syntax_error_starting_from("multiple exception types must be parenthesized", a)
    }
    | a='except' '*'? expression ['as' NAME { True }] NEWLINE { self.raise_syntax_error("expected ':'") }
    | a='except' '*'? NEWLINE { self.raise_syntax_error("expected ':'") }
    | a='except' '*' (NEWLINE | ':') {
        self.raise_syntax_error("expected one or more exception types")
    }
invalid_finally_stmt[None]:
    | a='finally' ':' NEWLINE !INDENT {
        self.raise_indentation_error(
            f"expected an indented block after 'finally' statement on line {a.start[0]}"
        )
    }
invalid_except_stmt_indent[None]:
    | a='except' expression ['as' NAME { True }] ':' NEWLINE !INDENT {
        self.raise_indentation_error(
            f"expected an indented block after 'except' statement on line {a.start[0]}"
        )
    }
    | a='except' ':' NEWLINE !INDENT {
        self.raise_indentation_error(
            f"expected an indented block after 'except' statement on line {a.start[0]}"
        )
    }
invalid_except_star_stmt_indent[None]:
    | a='except' '*' expression ['as' NAME { True }] ':' NEWLINE !INDENT {
        self.raise_indentation_error(
            f"expected an indented block after 'except*' statement on line {a.start[0]}"
        )
    }
invalid_match_stmt[None]:
    | "match" subject_expr !':' { self.raise_syntax_error("expected ':'") }
    | a="match" subject=subject_expr ':' NEWLINE !INDENT {
        self.raise_indentation_error(
            f"expected an indented block after 'match' statement on line {a.start[0]}"
        )
    }
invalid_case_block[None]:
    | "case" patterns guard? !':' { self.raise_syntax_error("expected ':'") }
    | a="case" patterns guard? ':' NEWLINE !INDENT {
        self.raise_indentation_error(
            f"expected an indented block after 'case' statement on line {a.start[0]}"
        )
    }
invalid_as_pattern[None]:
    | or_pattern 'as' a="_" {
        self.raise_syntax_error_known_location("cannot use '_' as a target", a)
    }
    | or_pattern 'as' !NAME a=expression {
        self.raise_syntax_error_known_location("invalid pattern target", a)
    }
invalid_class_pattern[None]:
    | name_or_attr '(' a=invalid_class_argument_pattern  {
        self.raise_syntax_error_known_range(
            "positional patterns follow keyword patterns", a[0], a[-1]
        )
    }
invalid_class_argument_pattern[list]:
    | [positional_patterns ',' { True }] keyword_patterns ',' a=positional_patterns { a }
invalid_if_stmt[None]:
    | 'if' named_expression NEWLINE { self.raise_syntax_error("expected ':'") }
    | a='if' a=named_expression ':' NEWLINE !INDENT {
        self.raise_indentation_error(
            f"expected an indented block after 'if' statement on line {a.start[0]}"
        )
    }
invalid_elif_stmt[None]:
    | 'elif' named_expression NEWLINE { self.raise_syntax_error("expected ':'") }
    | a='elif' named_expression ':' NEWLINE !INDENT {
        self.raise_indentation_error(
            f"expected an indented block after 'elif' statement on line {a.start[0]}"
        )
    }
invalid_else_stmt[None]:
    | a='else' ':' NEWLINE !INDENT {
        self.raise_indentation_error(
            f"expected an indented block after 'else' statement on line {a.start[0]}"
        )
    }
invalid_while_stmt[None]:
    | 'while' named_expression NEWLINE { self.raise_syntax_error("expected ':'") }
    | a='while' named_expression ':' NEWLINE !INDENT {
        self.raise_indentation_error(
            f"expected an indented block after 'while' statement on line {a.start[0]}"
        )
    }
invalid_for_stmt[None]:
    | [ASYNC] 'for' star_targets 'in' star_expressions NEWLINE { self.raise_syntax_error("expected ':'") }
    | ['async'] a='for' star_targets 'in' star_expressions ':' NEWLINE !INDENT {
        self.raise_indentation_error(
            f"expected an indented block after 'for' statement on line {a.start[0]}"
        )
    }
invalid_def_raw[None]:
    | ['async'] a='def' NAME  [type_params] '(' [params] ')' ['->' expression { True }] ':' NEWLINE !INDENT {
        self.raise_indentation_error(
            f"expected an indented block after function definition on line {a.start[0]}"
        )
    }
invalid_class_def_raw[None]:
    | 'class' NAME [type_params] ['(' [arguments] ')' { True }] NEWLINE { self.raise_syntax_error("expected ':'") }
    | a='class' NAME  [type_params] ['(' [arguments] ')' { True }] ':' NEWLINE !INDENT {
        self.raise_indentation_error(
            f"expected an indented block after class definition on line {a.start[0]}"
        )
    }

invalid_double_starred_kvpairs[None]:
    | ','.double_starred_kvpair+ ',' invalid_kvpair
    | expression ':' a='*' bitwise_or {
        self.raise_syntax_error_starting_from("cannot use a starred expression in a dictionary value", a)
    }
    | expression a=':' &('}'|',') {
        self.raise_syntax_error_known_location("expression expected after dictionary key and ':'", a)
    }
invalid_kvpair[None]:
    | a=expression !(':') {
        self.raise_raw_syntax_error(
            "':' expected after dictionary key",
            (a.lineno, a.col_offset),
            (a.end_lineno, a.end_col_offset)
        )
    }
    | expression ':' a='*' bitwise_or {
        self.raise_syntax_error_starting_from("cannot use a starred expression in a dictionary value", a)
    }
    | expression a=':' &('}'|',') {
        self.raise_syntax_error_known_location(
            "expression expected after dictionary key and ':'", a
        )
    }
    | expression a=':' {
        self.raise_syntax_error_known_location("expression expected after dictionary key and ':'", a)
    }
invalid_starred_expression[None]:
    | a='*' expression '=' b=expression {
        self.raise_syntax_error_known_range(
            "cannot assign to iterable argument unpacking", a, b
        )
    }
invalid_replacement_field[None]:
    | '{' a='=' { self.raise_syntax_error_known_location("f-string: valid expression required before '='", a) }
    | '{' a='!' { self.raise_syntax_error_known_location("f-string: valid expression required before '!'", a) }
    | '{' a=':' { self.raise_syntax_error_known_location("f-string: valid expression required before ':'", a) }
    | '{' a='}' { self.raise_syntax_error_known_location("f-string: valid expression required before '}'", a) }
    | '{' !(yield_expr | star_expressions) {
        self.raise_syntax_error_on_next_token(
            "f-string: expecting a valid expression after '{'"
        )
    }
    | '{' (yield_expr | star_expressions) !('=' | '!' | ':' | '}') {
        self.raise_syntax_error_on_next_token("f-string: expecting '=', or '!', or ':', or '}'")
    }
    | '{' (yield_expr | star_expressions) '=' !('!' | ':' | '}') {
       self.raise_syntax_error_on_next_token("f-string: expecting '!', or ':', or '}'")
    }
    | '{' (yield_expr | star_expressions) '='? invalid_conversion_character
    | '{' (yield_expr | star_expressions) '='? ['!' NAME] !(':' | '}') {
        self.raise_syntax_error_on_next_token("f-string: expecting ':' or '}'")
    }
    | '{' (yield_expr | star_expressions) '='? ['!' NAME] ':' fstring_format_spec* !'}' {
        self.raise_syntax_error_on_next_token("f-string: expecting '}', or format specs")
    }
    | '{' (yield_expr | star_expressions) '='? ['!' NAME] !'}' {
        self.raise_syntax_error_on_next_token("f-string: expecting '}'")
    }

invalid_conversion_character[None]:
    | '!' &(':' | '}') { self.raise_syntax_error_on_next_token("f-string: missing conversion character") }
    | '!' !NAME { self.raise_syntax_error_on_next_token("f-string: invalid conversion character") }
