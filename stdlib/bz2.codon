from internal.file import bzFile, bzopen

BZ2File = bzFile

def open(
    path: str,
    mode: str = "rb",
    encoding: Optional[str] = None,
    errors: Optional[str] = None,
    newline: Optional[str] = None,
) -> bzFile[bytes]:
    return bzopen(path, mode, encoding, errors, newline)

@overload
def open(
    path: str,
    mode: Literal[str],
    encoding: Optional[str] = None,
    errors: Optional[str] = None,
    newline: Optional[str] = None,
):
    return bzopen(path, mode, encoding, errors, newline)
