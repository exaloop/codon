from internal.file import gzFile, gzopen

def open(
    path: str,
    mode: str = "r",
    encoding: str = "utf-8",
    errors: str = "strict",
    newline: Optional[str] = None,
) -> gzFile[str]:
    return gzFile[str](path, mode, encoding, errors, newline)

@overload
def open(
    path: str,
    mode: Literal[str],
    encoding: str = "utf-8",
    errors: str = "strict",
    newline: Optional[str] = None,
):
    return gzopen(path, mode, encoding, errors, newline)
