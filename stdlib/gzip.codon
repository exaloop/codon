from internal.file import gzFile, gzopen

GzipFile = gzFile

def open(
    path: str,
    mode: str = "rb",
    encoding: Optional[str] = None,
    errors: Optional[str] = None,
    newline: Optional[str] = None,
) -> gzFile[bytes]:
    return gzopen(path, mode, encoding, errors, newline)

@overload
def open(
    path: str,
    mode: Literal[str],
    encoding: Optional[str] = None,
    errors: Optional[str] = None,
    newline: Optional[str] = None,
):
    return gzopen(path, mode, encoding, errors, newline)
