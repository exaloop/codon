import internal.gc as gc

_MAX: Literal[int] = 0x7FFFFFFFFFFFFFFF


def _bytes_hex_value(value: u8) -> int:
    if u8(0x30) <= value <= u8(0x39):
        return int(value) - 0x30
    if u8(0x41) <= value <= u8(0x46):
        return int(value) - 0x41 + 10
    if u8(0x61) <= value <= u8(0x66):
        return int(value) - 0x61 + 10
    return -1


def _bytes_fromhex_whitespace(value: u8) -> bool:
    return (
        value == u8(0x09)
        or value == u8(0x0A)
        or value == u8(0x0B)
        or value == u8(0x0C)
        or value == u8(0x0D)
        or value == u8(0x20)
    )

@extend
class bytes:
    # Magic methods

    def __hash__(self) -> int:
        h = 0
        p, n = self._ptr, self._len
        i = 0
        while i < n:
            h = 31 * h + int(p[i])
            i += 1
        return h

    def __lt__(self, other: bytes) -> bool:
        return self._cmp(other) < 0

    def __le__(self, other: bytes) -> bool:
        return self._cmp(other) <= 0

    def __gt__(self, other: bytes) -> bool:
        return self._cmp(other) > 0

    def __ge__(self, other: bytes) -> bool:
        return self._cmp(other) >= 0

    def __repr__(self) -> str:
        q = 0x27
        single_quotes = 0
        found_double = False
        size = 3  # b and two quotes
        for c in self:
            if c == 0x27:
                single_quotes += 1
            elif c == 0x22:
                found_double = True

            if (
                c == 0x09
                or c == 0x0A
                or c == 0x0D
                or c == 0x5C
                or c == q
            ):
                size += 2
            elif 0x20 <= c <= 0x7E:
                size += 1
            else:
                size += 4

        if single_quotes > 0 and not found_double:
            q = 0x22
            size -= single_quotes

        p = Ptr[u8](size)
        n = 0
        p[n] = u8(0x62)  # b
        n += 1
        p[n] = u8(q)
        n += 1
        for c in self:
            if c == 0x09:
                p[n], p[n + 1] = u8(0x5C), u8(0x74)
                n += 2
            elif c == 0x0A:
                p[n], p[n + 1] = u8(0x5C), u8(0x6E)
                n += 2
            elif c == 0x0D:
                p[n], p[n + 1] = u8(0x5C), u8(0x72)
                n += 2
            elif c == 0x5C or c == q:
                p[n], p[n + 1] = u8(0x5C), u8(c)
                n += 2
            elif 0x20 <= c <= 0x7E:
                p[n] = u8(c)
                n += 1
            else:
                p[n], p[n + 1] = u8(0x5C), u8(0x78)
                p[n + 2] = u8(0x30 + c.cdiv(16) if c.cdiv(16) < 10 else 0x61 + c.cdiv(16) - 10)
                p[n + 3] = u8(0x30 + c.cmod(16) if c.cmod(16) < 10 else 0x61 + c.cmod(16) - 10)
                n += 4
        p[n] = u8(q)
        return str(bytes(p, n + 1), "ascii")

    def __getitem__(self, idx: int) -> int:
        if idx < 0:
            idx += len(self)
        if not (0 <= idx < len(self)):
            raise IndexError("index out of range")
        return int(self._ptr[idx])

    def __getitem__(self, s: Slice) -> bytes:
        if s.start is None and s.stop is None and s.step is None:
            return self.__copy__()
        elif s.step is None:
            start, stop, step, length = s.adjust_indices(len(self))
            return bytes(self._ptr + start, length)
        else:
            start, stop, step, length = s.adjust_indices(len(self))
            return self._make_from_range(start, stop, step, length)

    def _make_from_range(self, start: int, stop: int, step: int, length: int) -> bytes:
        p = Ptr[u8](length)
        j = 0
        for i in range(start, stop, step):
            p[j] = self._ptr[i]
            j += 1
        return bytes(p, length)

    def __iter__(self) -> Generator[int]:
        i = 0
        n = len(self)
        while i < n:
            yield int(self._ptr[i])
            i += 1

    def __reversed__(self) -> Generator[int]:
        i = len(self) - 1
        while i >= 0:
            yield int(self._ptr[i])
            i -= 1

    def __mul__(self, x: int) -> bytes:
        if x <= 0:
            return bytes()
        total = x * self._len
        p = Ptr[u8](total)
        n = 0
        for _ in range(x):
            bytes.memcpy(p + n, self._ptr, self._len)
            n += self._len
        return bytes(p, total)

    def __rmul__(self, x: int) -> bytes:
        return self * x

    def _cmp(self, other: bytes) -> int:
        n = min(self._len, other._len)
        i = 0
        while i < n:
            c1 = self._ptr[i]
            c2 = other._ptr[i]
            if c1 != c2:
                return int(c1) - int(c2)
            i += 1
        return self._len - other._len

import algorithms.strings as algorithms

@extend
class bytes:
    def __contains__(self, pattern: bytes) -> bool:
        return self.find(pattern) >= 0

    # Helper methods

    def _isdigit(a: u8) -> bool:
        return _C.isdigit(i32(int(a))) != i32(0)

    def _isspace(a: u8) -> bool:
        return _C.isspace(i32(int(a))) != i32(0)

    def _isupper(a: u8) -> bool:
        return _C.isupper(i32(int(a))) != i32(0)

    def _islower(a: u8) -> bool:
        return _C.islower(i32(int(a))) != i32(0)

    def _isalpha(a: u8) -> bool:
        return _C.isalpha(i32(int(a))) != i32(0)

    def _isalnum(a: u8) -> bool:
        return _C.isalnum(i32(int(a))) != i32(0)

    def _toupper(a: u8) -> u8:
        return u8(int(_C.toupper(i32(int(a)))))

    def _tolower(a: u8) -> u8:
        return u8(int(_C.tolower(i32(int(a)))))

    def _slice(self, i: int, j: int) -> bytes:
        return bytes(self._ptr + i, j - i)

    def _at(self, i: int) -> int:
        return int(self._ptr[i])

    @staticmethod
    def _fromhex(value: bytes) -> bytes:
        p = Ptr[u8](len(value).cdiv(2))
        i = 0
        n = 0
        while i < len(value):
            while i < len(value) and _bytes_fromhex_whitespace(value._ptr[i]):
                i += 1
            if i == len(value):
                break

            high = _bytes_hex_value(value._ptr[i])
            if high < 0:
                raise ValueError(
                    f"non-hexadecimal number found in fromhex() arg at position {i}"
                )
            i += 1
            if i == len(value):
                raise ValueError(
                    "fromhex() arg must contain an even number of hexadecimal digits"
                )

            low = _bytes_hex_value(value._ptr[i])
            if low < 0:
                raise ValueError(
                    f"non-hexadecimal number found in fromhex() arg at position {i}"
                )
            p[n] = u8((high << 4) | low)
            n += 1
            i += 1
        return bytes(p, n)

    @staticmethod
    def fromhex(value) -> bytes:
        return bytes._fromhex(bytes(value))

    @staticmethod
    def fromhex(value: str) -> bytes:
        for i in range(len(value)):
            if ord(value[i]) > 0x7F:
                raise ValueError(
                    f"non-hexadecimal number found in fromhex() arg at position {i}"
                )
        return bytes._fromhex(bytes(value, "ascii"))

    @staticmethod
    def fromhex(value: bytes) -> bytes:
        return bytes._fromhex(value)

    def _hex(self, separator: int, bytes_per_sep: int) -> str:
        group = abs(bytes_per_sep)
        separator_count = 0
        if group > 0 and len(self) > 1:
            separator_count = (len(self) - 1).cdiv(group)

        p = Ptr[u8](2 * len(self) + separator_count)
        j = 0
        for i in range(len(self)):
            if i > 0 and group > 0:
                separate = (
                    bytes_per_sep > 0 and (len(self) - i).cmod(group) == 0
                ) or (
                    bytes_per_sep < 0 and i.cmod(group) == 0
                )
                if separate:
                    p[j] = u8(separator)
                    j += 1

            value = int(self._ptr[i])
            high = value >> 4
            low = value & 0x0F
            p[j] = u8(0x30 + high if high < 10 else 0x61 + high - 10)
            p[j + 1] = u8(0x30 + low if low < 10 else 0x61 + low - 10)
            j += 2
        return str(bytes(p, j), "ascii")

    def hex(self) -> str:
        return self._hex(0, 0)

    def hex(self, sep: str, bytes_per_sep: int = 1) -> str:
        if len(sep) != 1:
            raise ValueError("sep must be length 1")
        separator = ord(sep)
        if separator > 0x7F:
            raise ValueError("sep must be ASCII")
        return self._hex(separator, bytes_per_sep)

    def hex(self, sep: bytes, bytes_per_sep: int = 1) -> str:
        if len(sep) != 1:
            raise ValueError("sep must be length 1")
        if sep[0] > 0x7F:
            raise ValueError("sep must be ASCII")
        return self._hex(sep[0], bytes_per_sep)

    @staticmethod
    def maketrans(source, replacement) -> bytes:
        source: bytes = bytes(source)
        replacement: bytes = bytes(replacement)
        if len(source) != len(replacement):
            raise ValueError("maketrans arguments must have same length")

        p = Ptr[u8](256)
        for i in range(256):
            p[i] = u8(i)
        for i in range(len(source)):
            p[int(source._ptr[i])] = replacement._ptr[i]
        return bytes(p, 256)

    def join(self, l: Generator[bytes]) -> bytes:
        capacity = 16
        data = Ptr[u8](capacity)
        length = 0
        first = True

        for value in l:
            separator_length = 0 if first else len(self)
            required = length + separator_length + len(value)

            if required > capacity:
                old_capacity = capacity
                while capacity < required:
                    capacity *= 2
                data = gc.realloc(data, capacity, old_capacity)

            if not first:
                bytes.memcpy(data + length, self._ptr, separator_length)
                length += separator_length
            else:
                first = False

            bytes.memcpy(data + length, value._ptr, len(value))
            length += len(value)

        return bytes(data, length)

    def join(self, l: List[bytes]) -> bytes:
        if len(l) == 0:
            return bytes()
        if len(l) == 1:
            return l[0]
        if len(self) == 0:
            return bytes.cat(l)

        # compute length
        n = 0
        i = 0
        while i < len(l):
            n += len(l[i])
            if i < len(l) - 1:
                n += len(self)
            i += 1

        # copy to new buffer
        p = Ptr[u8](n)
        r = 0
        i = 0
        while i < len(l):
            bytes.memcpy(p + r, l[i]._ptr, len(l[i]))
            r += len(l[i])
            if i < len(l) - 1:
                bytes.memcpy(p + r, self._ptr, len(self))
                r += len(self)
            i += 1

        return bytes(p, n)

    def isdigit(self) -> bool:
        if len(self) == 0:
            return False

        for i in range(len(self)):
            if not bytes._isdigit(self._ptr[i]):
                return False
        return True

    def islower(self) -> bool:
        cased = False

        # For empty strings
        if len(self) == 0:
            return False

        # For single character strings
        if len(self) == 1:
            return bytes._islower(self._ptr[0])

        for i in range(len(self)):
            if bytes._isupper(self._ptr[i]):
                return False
            elif not cased and bytes._islower(self._ptr[i]):
                cased = True
        return cased

    def isupper(self) -> bool:
        cased = False

        # For empty strings
        if len(self) == 0:
            return False

        # For single character strings
        if len(self) == 1:
            return bytes._isupper(self._ptr[0])

        for i in range(len(self)):
            if bytes._islower(self._ptr[i]):
                return False
            elif not cased and bytes._isupper(self._ptr[i]):
                cased = True
        return cased

    def isalnum(self) -> bool:
        if len(self) == 0:
            return False

        for i in range(len(self)):
            if not bytes._isalnum(self._ptr[i]):
                return False
        return True

    def isalpha(self) -> bool:
        if len(self) == 0:
            return False

        for i in range(len(self)):
            if not bytes._isalpha(self._ptr[i]):
                return False
        return True

    def isspace(self) -> bool:
        if len(self) == 0:
            return False

        for i in range(len(self)):
            if not bytes._isspace(self._ptr[i]):
                return False
        return True

    def istitle(self) -> bool:

        # For empty strings
        if len(self) == 0:
            return False

        # For single character strings
        if len(self) == 1:
            return bytes._isupper(self._ptr[0])

        cased = False
        prev_is_cased = False
        for i in range(len(self)):
            if bytes._isupper(self._ptr[i]):
                if prev_is_cased:
                    return False
                prev_is_cased = True
                cased = True
            elif bytes._islower(self._ptr[i]):
                if not prev_is_cased:
                    return False
                prev_is_cased = True
                cased = True
            else:
                prev_is_cased = False
        return cased

    def capitalize(self) -> bytes:
        n = len(self)
        if n > 0:
            p = Ptr[u8](n)
            p[0] = bytes._toupper(self._ptr[0])
            for i in range(1, n):
                p[i] = bytes._tolower(self._ptr[i])
            return bytes(p, n)
        return bytes()

    def isdecimal(self) -> bool:
        if len(self) == 0:
            return False

        for i in range(len(self)):
            # test ascii values 48-57 == 0-9
            if not (48 <= int(self._ptr[i]) <= 57):
                return False
        return True

    def lower(self) -> bytes:
        # Empty string
        n = len(self)
        if n == 0:
            return bytes()
        p = Ptr[u8](n)
        for i in range(n):
            p[i] = bytes._tolower(self._ptr[i])
        return bytes(p, n)

    def upper(self) -> bytes:
        # Empty string
        n = len(self)
        if n == 0:
            return bytes()
        p = Ptr[u8](n)
        for i in range(n):
            p[i] = bytes._toupper(self._ptr[i])
        return bytes(p, n)

    def isascii(self) -> bool:
        for i in range(len(self)):
            if int(self._ptr[i]) >= 128:
                return False
        return True

    def casefold(self) -> bytes:
        return self.lower()

    def swapcase(self) -> bytes:
        # Empty string
        n = len(self)
        if n == 0:
            return bytes()
        p = Ptr[u8](n)
        for i in range(n):
            if bytes._islower(self._ptr[i]):
                p[i] = bytes._toupper(self._ptr[i])
            elif bytes._isupper(self._ptr[i]):
                p[i] = bytes._tolower(self._ptr[i])
            else:
                p[i] = self._ptr[i]
        return bytes(p, n)

    def title(self) -> bytes:
        prev_is_cased = False

        n = len(self)
        if n == 0:
            return bytes()

        p = Ptr[u8](n)
        for i in range(n):
            if bytes._islower(self._ptr[i]):
                # lowercase to uppercase
                if not prev_is_cased:
                    p[i] = bytes._toupper(self._ptr[i])
                else:
                    p[i] = self._ptr[i]
                prev_is_cased = True
            elif bytes._isupper(self._ptr[i]):
                # uppercase to lowercase
                if prev_is_cased:
                    p[i] = bytes._tolower(self._ptr[i])
                else:
                    p[i] = self._ptr[i]
                prev_is_cased = True
            else:
                p[i] = self._ptr[i]
                prev_is_cased = False
        return bytes(p, n)

    def isnumeric(self) -> bool:
        return self.isdecimal()

    def _build(*args):
        total = 0
        for t in args:
            if isinstance(t, bytes):
                total += len(t)
            else:
                total += len(t[0]) * t[1]
        p = Ptr[u8](total)
        i = 0

        for t in args:
            if isinstance(t, bytes):
                bytes.memcpy(p + i, t._ptr, t._len)
                i += t._len
            else:
                s, n = t
                for _ in range(n):
                    bytes.memcpy(p + i, s._ptr, s._len)
                    i += s._len

        return bytes(p, total)

    def ljust(self, width: int, fillchar: bytes = b" ") -> bytes:
        if len(fillchar) != 1:
            raise ValueError("The fill character must be exactly one character long")
        if width <= len(self):
            return self
        return bytes._build(self, (fillchar, width - len(self)))

    def rjust(self, width: int, fillchar: bytes = b" ") -> bytes:
        if len(fillchar) != 1:
            raise ValueError("The fill character must be exactly one character long")
        if width <= len(self):
            return self
        return bytes._build((fillchar, width - len(self)), self)

    def center(self, width: int, fillchar: bytes = b" ") -> bytes:
        if len(fillchar) != 1:
            raise ValueError("The fill character must be exactly one character long")
        if width <= len(self):
            return self

        pad = width - len(self)
        left_pad = pad.cdiv(2)
        right_pad = width - len(self) - left_pad
        return bytes._build((fillchar, left_pad), self, (fillchar, right_pad))

    def zfill(self, width: int) -> bytes:
        if len(self) >= width:
            return self

        plus = u8(43)   # +
        minus = u8(45)  # -
        zero = u8(48)   # 0

        zf = self.rjust(width, b'0')
        fill = width - len(self)
        p = zf._ptr

        if len(self) > 0 and (p[fill] == plus or p[fill] == minus):
            p[0] = p[fill]
            p[fill] = zero

        return zf

    def count(self, sub: bytes, start: int = 0, end: Optional[int] = None) -> int:
        end: int = end if end is not None else len(self)
        start, end = self._correct_indices(start, end)
        if end - start < len(sub):
            return 0
        return algorithms.count(self._slice(start, end), sub)

    def find(self, sub: bytes, start: int = 0, end: Optional[int] = None) -> int:
        end: int = end if end is not None else len(self)
        start, end = self._correct_indices(start, end)
        if end - start < len(sub):
            return -1
        pos = algorithms.find(self._slice(start, end), sub)
        return pos if pos < 0 else pos + start

    def rfind(self, sub: bytes, start: int = 0, end: Optional[int] = None) -> int:
        end: int = end if end is not None else len(self)
        start, end = self._correct_indices(start, end)
        if end - start < len(sub):
            return -1
        pos = algorithms.rfind(self._slice(start, end), sub)
        return pos if pos < 0 else pos + start

    def isidentifier(self) -> bool:
        # empty string
        if len(self) == 0:
            return False

        # is not a letter or _
        first = self._at(0)
        if not bytes._isalpha(u8(first)):
            if first != 0x5F:
                return False

        if bytes._isalpha(u8(first)) or first == 0x5F:
            for i in range(1, len(self)):
                ith = self._at(i)
                if not bytes._isalpha(u8(ith)):
                    if not (0x30 <= ith <= 0x39):
                        if ith != 0x5F:
                            return False

        return True

    def isprintable(self) -> bool:
        for i in range(len(self)):
            if not (31 < int(self._ptr[i]) < 128):
                return False
        return True

    def _has_char(self, chars: bytes) -> bool:
        s = self._at(0)
        for c in chars:
            if s == c:
                return True
        return False

    def lstrip(self, chars: Optional[bytes] = None) -> bytes:
        i = 0
        if chars is None:
            while i < len(self) and bytes._isspace(self._ptr[i]):
                i += 1
        else:
            while i < len(self) and bytes(self._ptr + i, 1)._has_char(chars):
                i += 1
        return self._slice(i, len(self))

    def rstrip(self, chars: Optional[bytes] = None) -> bytes:
        i = len(self) - 1
        if chars is None:
            while i >= 0 and bytes._isspace(self._ptr[i]):
                i -= 1
        else:
            while i >= 0 and bytes(self._ptr + i, 1)._has_char(chars):
                i -= 1
        return self._slice(0, i + 1)

    def strip(self, chars: Optional[bytes] = None) -> bytes:
        return self.lstrip(chars).rstrip(chars)

    def partition(self, sep: bytes) -> Tuple[bytes, bytes, bytes]:
        if not sep:
            raise ValueError("empty separator")
        pos = algorithms.find(self, sep)
        if pos < 0:
            return self, bytes(), bytes()
        return self._slice(0, pos), sep, self._slice(pos + len(sep), len(self))

    def rpartition(self, sep: bytes) -> Tuple[bytes, bytes, bytes]: # XXX
        if not sep:
            raise ValueError("empty separator")
        pos = algorithms.rfind(self, sep)
        if pos < 0:
            return bytes(), bytes(), self
        return self._slice(0, pos), sep, self._slice(pos + len(sep), len(self))

    def split(self, sep: Optional[bytes] = None, maxsplit: int = -1) -> List[bytes]:
        if sep is None:
            return self._split_whitespace(
                maxsplit if maxsplit >= 0 else _MAX
            )
        sep: bytes = sep

        if len(sep) == 0:
            raise ValueError("empty separator")

        # special case for length-1 pattern
        if len(sep) == 1:
            return self._split_char(sep._ptr[0], maxsplit if maxsplit >= 0 else _MAX)

        MAX_PREALLOC = 12
        maxsplit = maxsplit if maxsplit >= 0 else _MAX
        prealloc_size = MAX_PREALLOC if maxsplit >= MAX_PREALLOC else maxsplit + 1
        v = List[bytes](capacity=prealloc_size)
        i = 0
        j = 0
        n = len(self)

        while maxsplit > 0:
            maxsplit -= 1
            pos = algorithms.find(self._slice(i, n), sep)
            if pos < 0:
                break
            j = i + pos
            v.append(self._slice(i, j))
            i = j + len(sep)

        v.append(self._slice(i, n))
        return v

    def rsplit(self, sep: Optional[bytes] = None, maxsplit: int = -1) -> List[bytes]:
        if sep is None:
            return self._rsplit_whitespace(
                maxsplit if maxsplit >= 0 else _MAX
            )
        sep: bytes = sep

        if len(sep) == 0:
            raise ValueError("empty separator")

        # special case for length-1 pattern
        if len(sep) == 1:
            return self._rsplit_char(sep._ptr[0], maxsplit if maxsplit >= 0 else _MAX)

        MAX_PREALLOC = 12
        maxsplit = maxsplit if maxsplit >= 0 else _MAX
        prealloc_size = MAX_PREALLOC if maxsplit >= MAX_PREALLOC else maxsplit + 1
        v = List[bytes](capacity=prealloc_size)
        i = 0
        j = len(self)
        n = j

        while maxsplit > 0:
            maxsplit -= 1
            pos = algorithms.rfind(self._slice(0, j), sep)
            if pos < 0:
                break
            v.append(self._slice(pos + len(sep), j))
            j = pos

        v.append(self._slice(0, j))
        v.reverse()
        return v

    def splitlines(self, keepends: bool = False) -> List[bytes]:
        v = []
        i = 0
        j = 0
        n = len(self)

        break_r = u8(13)  # \r
        break_n = u8(10)  # \n

        while i < n:
            while i < n and not (self._ptr[i] == break_r or self._ptr[i] == break_n):
                i += 1

            eol = i
            if i < n:
                if self._ptr[i] == break_r and i + 1 < n and self._ptr[i + 1] == break_n:
                    i += 2
                else:
                    i += 1
                if keepends:
                    eol = i

            if j == 0 and eol == n:
                v.append(self)
                break

            v.append(self._slice(j, eol))
            j = i

        return v

    def startswith(
        self, prefix: bytes, start: int = 0, end: Optional[int] = None
    ) -> bool:
        end: int = end if end is not None else len(self)
        if end < 0:
            end += len(self)
        elif start < 0:
            start += len(self)

        # length prefix is longer than range of string being compared to
        if start + len(prefix) > len(self):
            return False

        # length of prefix is longer than range of string[start:end]
        if end - start < len(prefix):
            return False

        # prefix is an empty string
        if not prefix:
            return True

        return prefix == self._slice(start, start + len(prefix))

    def endswith(self, suffix: bytes, start: int = 0, end: Optional[int] = None) -> bool:
        end: int = end if end is not None else len(self)
        if end < 0:
            end += len(self)
        elif start < 0:
            start += len(self)
        if end > len(self):
            end = len(self)

        # length prefix is longer than range of string being compared to
        if end - start < len(suffix) or start > len(self):
            return False

        if end - len(suffix) > start:
            start = end - len(suffix)

        # length of prefix is longer than range of string[start:end]
        if end - start < len(suffix):
            return False

        # prefix is an empty string
        if not suffix:
            return True

        return suffix == self._slice(start, start + len(suffix))

    def removeprefix(self, prefix) -> bytes:
        prefix: bytes = bytes(prefix)
        if self.startswith(prefix):
            return self._slice(len(prefix), len(self))
        return self

    def removesuffix(self, suffix) -> bytes:
        suffix: bytes = bytes(suffix)
        if self.endswith(suffix):
            return self._slice(0, len(self) - len(suffix))
        return self

    def index(self, sub: bytes, start: int = 0, end: Optional[int] = None) -> int:
        i = self.find(sub, start, end)
        if i == -1:
            raise ValueError("substring not found")
        else:
            return i

    def rindex(self, sub: bytes, start: int = 0, end: Optional[int] = None) -> int:
        i = self.rfind(sub, start, end)
        if i == -1:
            raise ValueError("substring not found")
        else:
            return i

    def replace(self, old: bytes, new: bytes, maxcount: int = -1) -> bytes:
        return self._replace(old, new, maxcount)

    def expandtabs(self, tabsize: int = 8) -> bytes:
        i = 0
        j = 0
        p = self._ptr
        e = p + len(self)

        break_r = u8(13)  # \r
        break_n = u8(10)  # \n
        tab = u8(9)       # \t
        space = u8(32)    # ' '

        def overflow():
            raise OverflowError("result too long")

        while p < e:
            if p[0] == tab:
                if tabsize > 0:
                    incr = tabsize - j.cmod(tabsize)
                    if j > _MAX - incr:
                        overflow()
                    j += incr
            else:
                if j > _MAX - 1:
                    overflow()
                j += 1
                if p[0] == break_n or p[0] == break_r:
                    if i > _MAX - j:
                        overflow()
                    i += j
                    j = 0
            p += 1

        if i > _MAX - j:
            overflow()

        u_len = i + j
        u = Ptr[u8](u_len)
        j = 0
        q = u
        p = self._ptr

        while p < e:
            if p[0] == tab:
                if tabsize > 0:
                    i = tabsize - j.cmod(tabsize)
                    j += i
                    while True:
                        k = i
                        i -= 1
                        if k == 0:
                            break
                        q[0] = space
                        q += 1
            else:
                j += 1
                q[0] = p[0]
                q += 1
                if p[0] == break_n or p[0] == break_r:
                    j = 0
            p += 1

        return bytes(u, u_len)

    def translate(self, map) -> bytes:
        if hasattr(map, "__bytes__"):
            return self.translate(bytes(map))

        n = len(self)
        m = 0

        for i in range(n):
            key = int(self._ptr[i])
            if key in map:
                val = map[key]
                if val is not None:
                    m += len(val)
            else:
                m += 1

        p = Ptr[u8](m)
        q = p

        for i in range(n):
            key = int(self._ptr[i])
            if key in map:
                val = map[key]
                if val is not None:
                    bytes.memcpy(q, val._ptr, len(val))
                    q += len(val)
            else:
                q[0] = self._ptr[i]
                q += 1

        return bytes(p, m)

    def translate(self, table: bytes, delete: bytes = b"") -> bytes:
        if len(table) != 256:
            raise ValueError("translation table must be 256 characters long")

        deleted = Ptr[u8](256)
        bytes.memset(deleted, u8(0), 256)
        for value in delete:
            deleted[value] = u8(1)

        p = Ptr[u8](len(self))
        n = 0
        for i in range(len(self)):
            value = int(self._ptr[i])
            if deleted[value] == u8(0):
                p[n] = table._ptr[value]
                n += 1
        return bytes(p, n)


    # Internal helpers

    def _correct_indices(self, start: int, end: int) -> Tuple[int, int]:
        n = len(self)

        if end > n:
            end = n
        elif end < 0:
            end += n
            if end < 0:
                end = 0

        if start < 0:
            start += n
            if start < 0:
                start = 0

        return (start, end)

    def _split_whitespace(self, maxcount: int) -> List[bytes]:
        PREALLOC_MAX = 12
        l = List[bytes](PREALLOC_MAX if maxcount >= PREALLOC_MAX else maxcount + 1)

        str_len = len(self)
        i = 0
        j = 0
        while maxcount > 0:
            maxcount -= 1
            while i < str_len and bytes._isspace(self._ptr[i]):
                i += 1
            if i == str_len:
                break
            j = i
            i += 1
            while i < str_len and not bytes._isspace(self._ptr[i]):
                i += 1
            l.append(self._slice(j, i))

        if i < str_len:
            while i < str_len and bytes._isspace(self._ptr[i]):
                i += 1
            if i != str_len:
                l.append(self._slice(i, str_len))

        return l

    def _rsplit_whitespace(self, maxcount: int) -> List[bytes]:
        PREALLOC_MAX = 12
        l = List[bytes](PREALLOC_MAX if maxcount >= PREALLOC_MAX else maxcount + 1)

        str_len = len(self)
        i = str_len - 1
        j = str_len - 1
        while maxcount > 0:
            maxcount -= 1
            while i >= 0 and bytes._isspace(self._ptr[i]):
                i -= 1
            if i < 0:
                break
            j = i
            i -= 1
            while i >= 0 and not bytes._isspace(self._ptr[i]):
                i -= 1
            l.append(self._slice(i + 1, j + 1))

        if i >= 0:
            while i >= 0 and bytes._isspace(self._ptr[i]):
                i -= 1
            if i >= 0:
                l.append(self._slice(0, i + 1))

        l.reverse()
        return l

    def _split_char(self, char: u8, maxcount: int) -> List[bytes]:
        PREALLOC_MAX = 12
        l = List[bytes](PREALLOC_MAX if maxcount >= PREALLOC_MAX else maxcount + 1)

        str_len = len(self)
        i = 0
        j = 0

        while i < str_len and maxcount > 0:
            if self._ptr[i] == char:
                l.append(self._slice(j, i))
                j = i + 1
                maxcount -= 1
            i += 1

        l.append(self._slice(j, str_len))
        return l

    def _rsplit_char(self, char: u8, maxcount: int) -> List[bytes]:
        PREALLOC_MAX = 12
        l = List[bytes](PREALLOC_MAX if maxcount >= PREALLOC_MAX else maxcount + 1)

        str_len = len(self)
        i = str_len - 1
        j = str_len - 1

        while i >= 0 and maxcount > 0:
            if self._ptr[i] == char:
                l.append(self._slice(i + 1, j + 1))
                j = i - 1
                maxcount -= 1
            i -= 1

        l.append(self._slice(0, j + 1))
        l.reverse()
        return l

    def _findchar(self, c: u8):
        return _C.memchr(self._ptr, i32(int(c)), len(self))

    def _countchar(self, c: u8, maxcount: int):
        count = 0
        start = self._ptr
        end = start + len(self)

        while True:
            start = bytes(start, end - start)._findchar(c)
            if not start:
                break
            count += 1
            if count >= maxcount:
                break
            start += 1
        return count

    def _replace_interleave(self, to: bytes, maxcount: int):
        self_s = self._ptr
        self_len = len(self)
        to_len = len(to)
        to_s = to._ptr
        count = 0
        i = 0

        if maxcount <= self_len:
            count = maxcount
        else:
            count = self_len + 1

        # assert count > 0
        if to_len > (_MAX - self_len).cdiv(count):
            raise OverflowError("replace bytes is too long")

        result_len = count * to_len + self_len
        result_s = Ptr[u8](result_len)
        result_s0 = result_s

        if to_len > 1:
            bytes.memcpy(result_s, to_s, to_len)
            result_s += to_len
            count -= 1

            while i < count:
                result_s[0] = self_s[0]
                result_s += 1
                self_s += 1
                bytes.memcpy(result_s, to_s, to_len)
                result_s += to_len
                i += 1
        else:
            result_s[0] = to_s[0]
            result_s += to_len
            count -= 1

            while i < count:
                result_s[0] = self_s[0]
                result_s += 1
                self_s += 1
                result_s[0] = to_s[0]
                result_s += to_len
                i += 1

        bytes.memcpy(result_s, self_s, self_len - i)
        return bytes(result_s0, result_len)

    def _replace_delete_single_character(self, from_c: u8, maxcount: int):
        self_len = len(self)
        self_s = self._ptr

        count = self._countchar(from_c, maxcount)
        if count == 0:
            return self

        result_len = self_len - count
        # assert result_len >= 0
        result_s = Ptr[u8](result_len)
        result_s0 = result_s

        start = self_s
        end = self_s + self_len
        while count > 0:
            count -= 1
            nxt = bytes(start, end - start)._findchar(from_c)
            if not nxt:
                break
            bytes.memcpy(result_s, start, nxt - start)
            result_s += nxt - start
            start = nxt + 1

        bytes.memcpy(result_s, start, end - start)
        return bytes(result_s0, result_len)

    def _replace_delete_substring(self, from_s: bytes, maxcount: int):
        self_len = len(self)
        self_s = self._ptr
        from_len = len(from_s)

        count = algorithms.count_with_max(self, from_s, maxcount)
        if count == 0:
            return self

        result_len = self_len - (count * from_len)
        # assert result_len >= 0
        result_s = Ptr[u8](result_len)
        result_s0 = result_s

        start = self_s
        end = self_s + self_len
        while count > 0:
            count -= 1
            offset = algorithms.find(bytes(start, end - start), from_s)
            if offset == -1:
                break
            nxt = start + offset
            bytes.memcpy(result_s, start, nxt - start)
            result_s += nxt - start
            start = nxt + from_len

        bytes.memcpy(result_s, start, end - start)
        return bytes(result_s0, result_len)

    def _replace_single_character_in_place(self, from_c: u8, to_c: u8, maxcount: int):
        self_s = self._ptr
        self_len = len(self)

        nxt = self._findchar(from_c)
        if not nxt:
            return self

        result_s = Ptr[u8](self_len)
        bytes.memcpy(result_s, self_s, self_len)

        start = result_s + (nxt - self_s)
        start[0] = to_c
        start += 1
        end = result_s + self_len
        maxcount -= 1

        while maxcount > 0:
            maxcount -= 1
            nxt = bytes(start, end - start)._findchar(from_c)
            if not nxt:
                break
            nxt[0] = to_c
            start = nxt + 1

        return bytes(result_s, self_len)

    def _replace_substring_in_place(self, from_s: bytes, to: bytes, maxcount: int):
        self_s = self._ptr
        self_len = len(self)
        from_len = len(from_s)
        to_s = to._ptr

        offset = algorithms.find(self, from_s)
        if offset == -1:
            return self

        result_s = Ptr[u8](self_len)
        bytes.memcpy(result_s, self_s, self_len)

        start = result_s + offset
        bytes.memcpy(start, to_s, from_len)
        start += from_len
        end = result_s + self_len
        maxcount -= 1

        while maxcount > 0:
            maxcount -= 1
            offset = algorithms.find(bytes(start, end - start), from_s)
            if offset == -1:
                break
            bytes.memcpy(start + offset, to_s, from_len)
            start += offset + from_len

        return bytes(result_s, self_len)

    def _replace_single_character(self, from_c: u8, to_s: bytes, maxcount: int):
        self_s = self._ptr
        self_len = len(self)
        to_len = len(to_s)

        count = self._countchar(from_c, maxcount)
        if count == 0:
            return self

        # assert count > 0
        if to_len - 1 > (_MAX - self_len).cdiv(count):
            raise OverflowError("replace bytes is too long")

        result_len = self_len + count * (to_len - 1)
        result_s = Ptr[u8](result_len)
        result_s0 = result_s

        start = self_s
        end = self_s + self_len
        while count > 0:
            count -= 1
            nxt = bytes(start, end - start)._findchar(from_c)
            if not nxt:
                break

            if nxt == start:
                bytes.memcpy(result_s, to_s._ptr, to_len)
                result_s += to_len
                start += 1
            else:
                bytes.memcpy(result_s, start, nxt - start)
                result_s += (nxt - start)
                bytes.memcpy(result_s, to_s._ptr, to_len)
                result_s += to_len
                start = nxt + 1

        bytes.memcpy(result_s, start, end - start)
        return bytes(result_s0, result_len)

    def _replace_substring(self, from_s: bytes, to_s: bytes, maxcount: int):
        self_s = self._ptr
        self_len = len(self)
        from_len = len(from_s)
        to_len = len(to_s)

        count = algorithms.count_with_max(self, from_s, maxcount)
        if count == 0:
            return self

        # assert count > 0
        if to_len - from_len > (_MAX - self_len).cdiv(count):
            raise OverflowError("replace bytes is too long")

        result_len = self_len + count * (to_len - from_len)
        result_s = Ptr[u8](result_len)
        result_s0 = result_s

        start = self_s
        end = self_s + self_len
        while count > 0:
            count -= 1
            offset = algorithms.find(bytes(start, end - start), from_s)
            if offset == -1:
                break

            nxt = start + offset
            if nxt == start:
                bytes.memcpy(result_s, to_s._ptr, to_len)
                result_s += to_len
                start += from_len
            else:
                bytes.memcpy(result_s, start, nxt - start)
                result_s += (nxt - start)
                bytes.memcpy(result_s, to_s._ptr, to_len)
                result_s += to_len
                start = nxt + from_len

        bytes.memcpy(result_s, start, end - start)
        return bytes(result_s0, result_len)

    def _replace(self, from_s: bytes, to_s: bytes, maxcount: int):
        self_len = len(self)
        from_len = len(from_s)
        to_len = len(to_s)

        if self_len < from_len:
            return self

        if maxcount < 0:
            maxcount = _MAX
        elif maxcount == 0:
            return self

        if from_len == 0:
            if to_len == 0:
                return self
            return self._replace_interleave(to_s, maxcount)

        if to_len == 0:
            if from_len == 1:
                return self._replace_delete_single_character(from_s._ptr[0], maxcount)
            return self._replace_delete_substring(from_s, maxcount)

        if from_len == to_len:
            if from_len == 1:
                return self._replace_single_character_in_place(from_s._ptr[0], to_s._ptr[0], maxcount)
            return self._replace_substring_in_place(from_s, to_s, maxcount)

        if from_len == 1:
            return self._replace_single_character(from_s._ptr[0], to_s, maxcount)
        else:
            return self._replace_substring(from_s, to_s, maxcount)
