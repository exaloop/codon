        while True:
            buffer.reserve(length + _FILE_READ_ALL_CHUNK_SIZE)
            count = int(_C.gzread(
                self._state._fp,
                buffer._ptr + length,
                u32(_FILE_READ_ALL_CHUNK_SIZE),
            ))
            _gz_errcheck(self._state._fp)
