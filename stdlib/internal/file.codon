    def _read_all_raw(self, buffer: _FileBuffer) -> int:
        length = 0
        if self._state._pending >= 0:
            buffer.reserve(1)
            buffer._ptr[0] = u8(self._state._pending)
            self._state._pending = -1
            length = 1
        buffered = self._state._read_length - self._state._read_offset
        buffer.reserve(length + buffered)
