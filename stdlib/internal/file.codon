from internal.gc import realloc, free
from internal.str import _UnicodeCodecBuffer, _make_meta, _unicode_decode_ptr, _unicode_encode_code, _encoding_code, _error_code, _ENCODING_UTF8, _ENCODING_UTF16, _ENCODING_UTF16_LE, _ENCODING_UTF16_BE, _ENCODING_UTF32, _ENCODING_UTF32_LE, _ENCODING_UTF32_BE

_FILE_READ_BUFFER_SIZE: Literal[int] = 8192

def _file_utf8_sequence_length(first: int) -> int:
    if first < 0x80:
        return 1
    if first >= 0xC2 and first <= 0xDF:
        return 2
    if first >= 0xE0 and first <= 0xEF:
        return 3
    if first >= 0xF0 and first <= 0xF4:
        return 4
    return 1

def _file_encoding_kind(encoding: str) -> int:
    return _encoding_code(encoding)

def _file_text_sequence_length(first: int, encoding_kind: int) -> int:
    if encoding_kind == _ENCODING_UTF16 or encoding_kind == _ENCODING_UTF16_LE or encoding_kind == _ENCODING_UTF16_BE:
        return 2
    if encoding_kind == _ENCODING_UTF32 or encoding_kind == _ENCODING_UTF32_LE or encoding_kind == _ENCODING_UTF32_BE:
        return 4
    if encoding_kind == _ENCODING_UTF8:
        return _file_utf8_sequence_length(first)
    return 1

def _file_utf16_surrogate_pair(data: Ptr[u8], offset: int, encoding_kind: int) -> bool:
    if encoding_kind != _ENCODING_UTF16_LE and encoding_kind != _ENCODING_UTF16_BE:
        return False
    if encoding_kind == _ENCODING_UTF16_LE:
        unit = int(data[offset]) | (int(data[offset + 1]) << 8)
    else:
        unit = (int(data[offset]) << 8) | int(data[offset + 1])
    return 0xD800 <= unit and unit <= 0xDBFF

def _file_bom_encoding(data: Ptr[u8], length: int, encoding: int) -> Tuple[int, int]:
    if encoding == _ENCODING_UTF16 and length >= 2:
        if data[0] == u8(0xFF) and data[1] == u8(0xFE):
            return (_ENCODING_UTF16_LE, 2)
        if data[0] == u8(0xFE) and data[1] == u8(0xFF):
            return (_ENCODING_UTF16_BE, 2)
    if encoding == _ENCODING_UTF32 and length >= 4:
        if data[0] == u8(0xFF) and data[1] == u8(0xFE) and data[2] == u8(0) and data[3] == u8(0):
            return (_ENCODING_UTF32_LE, 4)
        if data[0] == u8(0) and data[1] == u8(0) and data[2] == u8(0xFE) and data[3] == u8(0xFF):
            return (_ENCODING_UTF32_BE, 4)
    return (encoding, 0)

def _file_encoding_has_bom(encoding: int) -> bool:
    return encoding == _ENCODING_UTF16 or encoding == _ENCODING_UTF32

def _file_encoding_is_multibyte(encoding_kind: int) -> bool:
    return encoding_kind == _ENCODING_UTF16 or encoding_kind == _ENCODING_UTF16_LE or encoding_kind == _ENCODING_UTF16_BE or encoding_kind == _ENCODING_UTF32 or encoding_kind == _ENCODING_UTF32_LE or encoding_kind == _ENCODING_UTF32_BE

def _file_validate_newline(newline: Optional[str]):
    if (
        newline is not None
        and newline != ""
        and newline != "\n"
        and newline != "\r"
        and newline != "\r\n"
    ):
        raise ValueError("illegal newline value")

def _file_translate_read_newlines_inplace(value: str, newline: Optional[str]) -> str:
    if newline is not None:
        return value

    source = 0
    output = 0
    while source < len(value):
        codepoint = value._load_codepoint(source)
        if codepoint == 0x0D:
            value._store_codepoint(output, 0x0A)
            source += 1
            if source < len(value) and value._load_codepoint(source) == 0x0A:
                source += 1
        else:
            if output != source:
                value._store_codepoint(output, codepoint)
            source += 1
        output += 1
    if output == len(value):
        return value
    return str(value._ptr, _make_meta(output, value._kind()))

def _file_translate_line_ending_inplace(value: str, newline: Optional[str]) -> str:
    if newline is not None or len(value) == 0:
        return value

    last = len(value) - 1
    if value._load_codepoint(last) == 0x0D:
        value._store_codepoint(last, 0x0A)
        return value
    if last > 0 and value._load_codepoint(last - 1) == 0x0D and value._load_codepoint(last) == 0x0A:
        value._store_codepoint(last - 1, 0x0A)
        return str(value._ptr, _make_meta(last, value._kind()))
    return value

def _file_translate_write_newlines(value: str, newline: Optional[str]) -> str:
    if newline == "\r" or newline == "\r\n":
        return value.replace("\n", newline)
    return value

class _FileState:
    _fp: cobj
    _buf: Ptr[u8]
    _read_buf: Ptr[u8]
    _size: int
    _read_offset: int
    _read_length: int
    _newline: Optional[str]
    _encoding_kind: int
    _error_code: int
    _pending: int
    _path: str
    _mode: str
    _position: int
    _text_pending: str
    _bom_checked: bool
    _skip_initial_lf: bool
    _raw_line_read: bool

    def __init__(
        self,
        fp: cobj,
        encoding: str = "utf-8",
        errors: str = "strict",
        newline: Optional[str] = None,
        path: str = "",
        mode: str = "",
    ):
        self._fp = fp
        self._buf = Ptr[u8]()
        self._read_buf = Ptr[u8]()
        self._size = 0
        self._read_offset = 0
        self._read_length = 0
        self._newline = newline
        self._encoding_kind = _file_encoding_kind(encoding)
        self._error_code = _error_code(errors)
        self._pending = -1
        self._path = path
        self._mode = mode
        self._position = 0
        self._text_pending = str()
        self._bom_checked = not _file_encoding_has_bom(self._encoding_kind)
        self._skip_initial_lf = False
        self._raw_line_read = False

    def _reset_buffer(self):
        self._buf = Ptr[u8]()
        self._size = 0
        self._read_offset = 0
        self._read_length = 0
        self._pending = -1
        self._skip_initial_lf = False
        self._raw_line_read = False
        self._text_pending = str()

def _file_buffer_reserve(state: _FileState, required: int):
    if required <= state._size:
        return

    capacity = state._size if state._size > 0 else 1
    while capacity < required:
        capacity *= 2

    state._buf = realloc(state._buf, capacity, state._size)
    state._size = capacity

def _file_buffer_bytes(state: _FileState, length: int) -> bytes:
    result = Ptr[u8](length)
    bytes.memcpy(result, state._buf, length)
    return bytes(result, length)

def _file_decode_buffer(
    state: _FileState,
    length: int,
    offset: int,
) -> str:
    return _unicode_decode_ptr(
        state._buf + offset, length - offset, state._encoding_kind, state._error_code
    )

def _file_read_all_append(state: _FileState, length: int) -> int:
    start = _C.ftell(state._fp)
    if start >= 0 and _C.fseek(state._fp, 0, i32(2)) == 0:
        end = _C.ftell(state._fp)
        if end >= start and _C.fseek(state._fp, start, i32(0)) == 0:
            _file_buffer_reserve(state, length + end - start)
            length += _C.fread(state._buf + length, 1, end - start, state._fp)
            if _C.ferror(state._fp):
                raise IOError("file I/O error: error in read")
            return length

    chunk_size = 4096
    while True:
        _file_buffer_reserve(state, length + chunk_size)
        count = _C.fread(state._buf + length, 1, chunk_size, state._fp)
        length += count
        if count < chunk_size:
            break
    if _C.ferror(state._fp):
        raise IOError("file I/O error: error in read")
    return length

def _file_read_byte(state: _FileState) -> int:
    if state._pending >= 0:
        byte = state._pending
        state._pending = -1
        return byte
    if state._read_offset == state._read_length:
        if not state._read_buf:
            state._read_buf = Ptr[u8](_FILE_READ_BUFFER_SIZE)
        state._read_offset = 0
        state._read_length = _C.fread(
            state._read_buf, 1, _FILE_READ_BUFFER_SIZE, state._fp
        )
    if state._read_length == 0:
        return -1
    byte = state._read_buf[state._read_offset]
    state._read_offset += 1
    return int(byte)

def _file_readline_universal(state: _FileState) -> int:
    length = 0
    while True:
        byte = _file_read_byte(state)
        if byte < 0:
            break
        _file_buffer_reserve(state, length + 1)
        state._buf[length] = u8(byte)
        length += 1
        if byte == 0x0A:
            break
        if byte == 0x0D:
            following = _file_read_byte(state)
            if following == 0x0A:
                _file_buffer_reserve(state, length + 1)
                state._buf[length] = u8(following)
                length += 1
            elif following >= 0:
                state._pending = following
            break
    if _C.ferror(state._fp):
        raise IOError("file I/O error: error in read")
    return length

def _file_take_read_buffer(state: _FileState, output: Ptr[u8], length: int) -> int:
    available = state._read_length - state._read_offset
    if available <= 0 or length <= 0:
        return 0
    count = min(available, length)
    bytes.memcpy(output, state._read_buf + state._read_offset, count)
    state._read_offset += count
    return count

def _file_discard_read_buffer(state: _FileState):
    state._read_offset = 0
    state._read_length = 0

def _file_read_all_buffered(state: _FileState) -> int:
    length = 0
    if state._pending >= 0:
        _file_buffer_reserve(state, 1)
        state._buf[0] = u8(_file_read_byte(state))
        length = 1
    buffered = state._read_length - state._read_offset
    _file_buffer_reserve(state, length + buffered)
    bytes.memcpy(state._buf + length, state._read_buf + state._read_offset, buffered)
    length += buffered
    _file_discard_read_buffer(state)
    return _file_read_all_append(state, length)

@tuple
class File[T]:
    _state: _FileState

    def __new__(fp: cobj):
        return File[T](_FileState(fp))

    def __new__(
        path: str,
        mode: str,
        encoding: str = "utf-8",
        errors: str = "strict",
        newline: Optional[str] = None,
    ):
        fp = _C.fopen(path.c_str(), mode.c_str())
        if not fp:
            raise IOError(f"file {path} could not be opened")
        _file_validate_newline(newline)
        return File[T](_FileState(fp, encoding, errors, newline, path, mode))

    def __new__(fd: int, mode: str):
        fp = _C.fdopen(fd, mode.c_str())
        if not fp:
            raise IOError(f"file descriptor {fd} could not be opened")
        return File[T](_FileState(fp, path="", mode=mode))

    def _errcheck(self, msg: str):
        err = int(_C.ferror(self._state._fp))
        if err:
            raise IOError(f"file I/O error: {msg}")

    def __enter__(self):
        pass

    def __exit__(self):
        self.close()

    def __iter__(self) -> Generator[T]:
        self._ensure_open()
        while True:
            line = self.readline()
            if len(line) == 0:
                break
            yield line

    def readlines(self) -> List[T]:
        return [l for l in self]

    def readline(self) -> T:
        self._ensure_open()
        if T is str and _file_encoding_is_multibyte(self._state._encoding_kind):
            line = _UnicodeCodecBuffer(128)
            self._state._raw_line_read = True
            while True:
                character = self._read_text_character()
                if len(character) == 0:
                    break
                if self._state._skip_initial_lf:
                    self._state._skip_initial_lf = False
                    if character == "\n":
                        continue
                line.append(character._load_codepoint(0))
                if character == "\n" and (self._state._newline is None or self._state._newline == "" or self._state._newline == "\n"):
                    break
                if character == "\r" and self._state._newline is None:
                    self._state._skip_initial_lf = True
                    break
                if character == "\r" and (self._state._newline is None or self._state._newline == "" or self._state._newline == "\r" or self._state._newline == "\r\n"):
                    following = self._read_text_character()
                    if self._state._newline == "\r\n" and following == "\n":
                        line.append(following._load_codepoint(0))
                    elif self._state._newline == "" and following == "\n":
                        line.append(following._load_codepoint(0))
                    elif len(following) > 0:
                        self._state._text_pending = following
                    if self._state._newline == "\r\n" and following != "\n":
                        continue
                    break
            self._state._raw_line_read = False
            return _file_translate_line_ending_inplace(line.finish(), self._state._newline)
        if T is str and self._state._newline is None:
            length = _file_readline_universal(self._state)
            return _file_translate_line_ending_inplace(
                _file_decode_buffer(
                    self._state, length, 0
                ), self._state._newline
            )
        length = _file_readline_universal(self._state)
        if T is bytes:
            return _file_buffer_bytes(self._state, length)
        return _file_decode_buffer(
            self._state, length, 0
        )

    def write(self, s: T) -> int:
        self._ensure_open()
        if T is bytes:
            _C.fwrite(s._ptr, 1, len(s), self._state._fp)
        else:
            data = _unicode_encode_code(
                _file_translate_write_newlines(s, self._state._newline),
                self._state._encoding_kind,
                self._state._error_code,
            )
            _C.fwrite(data._ptr, 1, len(data), self._state._fp)
        self._errcheck("error in write")
        return len(s)

    def __file_write_gen__(self, g: Generator[T], T: type):
        for s in g:
            self.write(s)

    def read(self) -> T:
        return self.read(-1)

    def read(self, sz: int) -> T:
        self._ensure_open()
        if T is bytes:
            if sz < 0:
                return _file_buffer_bytes(
                    self._state, _file_read_all_buffered(self._state)
                )
            _file_buffer_reserve(self._state, sz)
            length = 0
            if sz > 0 and self._state._pending >= 0:
                self._state._buf[length] = u8(_file_read_byte(self._state))
                length += 1
            length += _file_take_read_buffer(
                self._state, self._state._buf + length, sz - length
            )
            length += _C.fread(
                self._state._buf + length, 1, sz - length, self._state._fp
            )
            self._errcheck("error in read")
            return _file_buffer_bytes(self._state, length)
        if sz < 0:
            prefix = self._state._text_pending
            self._state._text_pending = str()
            length = _file_read_all_buffered(self._state)
            value = _file_translate_read_newlines_inplace(
                _file_decode_buffer(
                    self._state, length, 0
                ), self._state._newline
            )
            return prefix + value if len(prefix) > 0 else value
        _file_buffer_reserve(self._state, sz)
        length = 0
        bom_length = 0
        for _ in range(sz):
            _file_buffer_reserve(self._state, length + 1)
            byte = _file_read_byte(self._state)
            if byte < 0:
                break
            self._state._buf[length] = u8(byte)
            width = _file_text_sequence_length(
                int(self._state._buf[length]), self._state._encoding_kind
            )
            if not self._state._bom_checked:
                width *= 2
            length += 1
            if width > 1:
                _file_buffer_reserve(self._state, length + width - 1)
                for _ in range(width - 1):
                    byte = _file_read_byte(self._state)
                    if byte < 0:
                        break
                    self._state._buf[length] = u8(byte)
                    length += 1
            if not self._state._bom_checked:
                self._state._encoding_kind, bom_length = _file_bom_encoding(
                    self._state._buf, length, self._state._encoding_kind
                )
                self._state._bom_checked = True
            if width == 2 and _file_utf16_surrogate_pair(
                self._state._buf, length - 2, self._state._encoding_kind
            ):
                _file_buffer_reserve(self._state, length + 2)
                for _ in range(2):
                    byte = _file_read_byte(self._state)
                    if byte < 0:
                        break
                    self._state._buf[length] = u8(byte)
                    length += 1
        self._errcheck("error in read")
        value = _file_decode_buffer(
            self._state, length, bom_length
        )
        if self._state._newline is None and not _file_encoding_is_multibyte(self._state._encoding_kind) and value.endswith("\r"):
            following = _file_read_byte(self._state)
            if following >= 0 and following != 0x0A:
                self._state._pending = following
        if _file_encoding_is_multibyte(self._state._encoding_kind):
            if self._state._raw_line_read:
                return value
            if self._state._newline is None:
                if self._state._skip_initial_lf:
                    self._state._skip_initial_lf = False
                    if value == "\n":
                        return self.read(sz)
                    if value.startswith("\n"):
                        value = value[1:]
                if value.endswith("\r"):
                    self._state._skip_initial_lf = True
                return _file_translate_read_newlines_inplace(value, self._state._newline)
            return value
        return _file_translate_read_newlines_inplace(value, self._state._newline)

    def tell(self) -> int:
        self._ensure_open()
        ret = _C.ftell(self._state._fp)
        self._errcheck("error in tell")
        return ret - self._state._read_length + self._state._read_offset - (
            1 if self._state._pending >= 0 else 0
        )

    def seekable(self) -> bool:
        self._ensure_open()
        return _C.ftell(self._state._fp) >= 0

    def seek(self, offset: int, whence: int):
        self._ensure_open()
        if whence == 1:
            unread = self._state._read_length - self._state._read_offset
            if self._state._pending >= 0:
                unread += 1
            if unread > 0:
                _C.fseek(self._state._fp, -unread, i32(1))
        _C.fseek(self._state._fp, offset, i32(whence))
        self._errcheck("error in seek")
        _file_discard_read_buffer(self._state)
        self._state._pending = -1
        self._state._text_pending = str()
        self._state._skip_initial_lf = False
        self._state._raw_line_read = False

    def flush(self):
        self._ensure_open()
        if _C.fflush(self._state._fp) != 0:
            raise IOError("file I/O error: error in flush")

    def close(self):
        if self._state._fp:
            _C.fclose(self._state._fp)
            self._state._fp = cobj()
        if self._state._buf:
            free(self._state._buf)
        if self._state._read_buf:
            free(self._state._read_buf)
            self._state._read_buf = Ptr[u8]()
        self._state._reset_buffer()

    def _ensure_open(self):
        if not self._state._fp:
            raise IOError("I/O operation on closed file")

    def _read_text_character(self) -> str:
        if len(self._state._text_pending) > 0:
            character = self._state._text_pending
            self._state._text_pending = str()
            return character
        return self.read(1)

    def _iter_trim_newline(self) -> Generator[T]:
        self._ensure_open()
        while True:
            line = self.readline()
            if len(line) == 0:
                break
            if T is bytes:
                if line[len(line) - 1] == u8(10):
                    yield line[:-1]
                else:
                    yield line
            else:
                if line.endswith("\n"):
                    yield line[:-1]
                else:
                    yield line

def _gz_errcheck(stream: cobj):
    errnum = i32(0)
    msg = _C.gzerror(stream, __ptr__(errnum))
    if msg and msg[0]:
        raise IOError(f"zlib error: {str.from_ptr(msg)}")

@tuple
class gzFile[T]:
    _state: _FileState

    def __new__(fp: cobj):
        return gzFile[T](_FileState(fp))

    def __new__(
        path: str,
        mode: str,
        encoding: str = "utf-8",
        errors: str = "strict",
        newline: Optional[str] = None,
    ):
        fp = _C.gzopen(path.c_str(), mode.c_str())
        if not fp:
            raise IOError(f"file {path} could not be opened")
        _file_validate_newline(newline)
        return gzFile[T](_FileState(fp, encoding, errors, newline, path, mode))

    def _getline(self) -> int:
        if not self._state._buf:
            self._state._size = 128
            self._state._buf = Ptr[u8](self._state._size)

        offset = 0
        while True:
            if offset == self._state._size:
                oldsz = self._state._size
                self._state._size *= 2
                self._state._buf = realloc(self._state._buf, self._state._size, oldsz)

            byte = self._read_byte()
            if byte < 0:
                if offset == 0:
                    return -1
                break

            self._state._buf[offset] = u8(byte)
            offset += 1
            if byte == 0x0A:
                break
            if T is str and self._state._newline is None and byte == 0x0D:
                following = self._read_byte()
                if following == 0x0A:
                    if offset == self._state._size:
                        oldsz = self._state._size
                        self._state._size *= 2
                        self._state._buf = realloc(self._state._buf, self._state._size, oldsz)
                    self._state._buf[offset] = u8(following)
                    offset += 1
                elif following >= 0:
                    self._state._pending = following
                break

        return offset

    def __iter__(self) -> Generator[T]:
        self._ensure_open()
        while True:
            line = self.readline()
            if len(line) == 0:
                break
            yield line

    def __enter__(self):
        pass

    def __exit__(self):
        self.close()

    def close(self):
        if self._state._fp:
            _C.gzclose(self._state._fp)
            self._state._fp = cobj()
        if self._state._buf:
            free(self._state._buf)
        if self._state._read_buf:
            free(self._state._read_buf)
            self._state._read_buf = Ptr[u8]()
        self._state._reset_buffer()

    def readlines(self) -> List[T]:
        return [l for l in self]

    def readline(self) -> T:
        self._ensure_open()
        if T is str and _file_encoding_is_multibyte(self._state._encoding_kind):
            self._state._raw_line_read = True
            line = _UnicodeCodecBuffer(128)
            while True:
                character = self._read_text_character()
                if len(character) == 0:
                    break
                if self._state._skip_initial_lf:
                    self._state._skip_initial_lf = False
                    if character == "\n":
                        continue
                line.append(character._load_codepoint(0))
                if character == "\n" and (self._state._newline is None or self._state._newline == "" or self._state._newline == "\n"):
                    break
                if character == "\r" and self._state._newline is None:
                    self._state._skip_initial_lf = True
                    break
                if character == "\r" and (self._state._newline is None or self._state._newline == "" or self._state._newline == "\r" or self._state._newline == "\r\n"):
                    following = self._read_text_character()
                    if self._state._newline == "\r\n" and following == "\n":
                        line.append(following._load_codepoint(0))
                    elif self._state._newline == "" and following == "\n":
                        line.append(following._load_codepoint(0))
                    elif len(following) > 0:
                        self._state._text_pending = following
                    if self._state._newline == "\r\n" and following != "\n":
                        continue
                    break
            self._state._raw_line_read = False
            return _file_translate_line_ending_inplace(line.finish(), self._state._newline)
        length = self._getline()
        if length == -1:
            if T is bytes:
                return bytes()
            return str()
        if T is bytes:
            return _file_buffer_bytes(self._state, length)
        return _file_translate_line_ending_inplace(
            _file_decode_buffer(
                self._state, length, 0
            ), self._state._newline
        )

    def write(self, s: T) -> int:
        self._ensure_open()
        if T is bytes:
            _C.gzwrite(self._state._fp, s._ptr, u32(len(s)))
        else:
            data = _unicode_encode_code(
                _file_translate_write_newlines(s, self._state._newline),
                self._state._encoding_kind,
                self._state._error_code,
            )
            _C.gzwrite(self._state._fp, data._ptr, u32(len(data)))
        _gz_errcheck(self._state._fp)
        return len(s)

    def __file_write_gen__(self, g: Generator[T], T: type):
        for s in g:
            self.write(s)

    def read(self) -> T:
        return self.read(-1)

    def read(self, sz: int) -> T:
        self._ensure_open()
        if sz < 0:
            chunk_size = 4096
            length = 0
            prefix = self._state._text_pending
            self._state._text_pending = str()
            if self._state._pending >= 0:
                _file_buffer_reserve(self._state, 1)
                self._state._buf[0] = u8(self._read_byte())
                length = 1
            buffered = self._state._read_length - self._state._read_offset
            _file_buffer_reserve(self._state, length + buffered)
            bytes.memcpy(
                self._state._buf + length,
                self._state._read_buf + self._state._read_offset,
                buffered,
            )
            length += buffered
            _file_discard_read_buffer(self._state)
            while True:
                _file_buffer_reserve(self._state, length + chunk_size)
                count = int(_C.gzread(
                    self._state._fp, self._state._buf + length, u32(chunk_size)
                ))
                _gz_errcheck(self._state._fp)
                length += count
                if count < chunk_size:
                    break
            if T is bytes:
                return _file_buffer_bytes(self._state, length)
            else:
                value = _file_translate_read_newlines_inplace(
                    _file_decode_buffer(
                        self._state, length, 0
                    ), self._state._newline
                )
                return prefix + value if len(prefix) > 0 else value
        if T is bytes:
            _file_buffer_reserve(self._state, sz)
            length = _file_take_read_buffer(self._state, self._state._buf, sz)
            ret = _C.gzread(
                self._state._fp, self._state._buf + length, u32(sz - length)
            )
            _gz_errcheck(self._state._fp)
            length += int(ret)
            return _file_buffer_bytes(self._state, length)
        else:
            _file_buffer_reserve(self._state, sz)
            length = 0
            bom_length = 0
            for _ in range(sz):
                _file_buffer_reserve(self._state, length + 1)
                byte = self._read_byte()
                if byte < 0:
                    break
                self._state._buf[length] = u8(byte)
                width = _file_text_sequence_length(
                    int(self._state._buf[length]), self._state._encoding_kind
                )
                if not self._state._bom_checked:
                    width *= 2
                length += 1
                if width > 1:
                    _file_buffer_reserve(self._state, length + width - 1)
                    for _ in range(width - 1):
                        byte = self._read_byte()
                        if byte < 0:
                            break
                        self._state._buf[length] = u8(byte)
                        length += 1
                if not self._state._bom_checked:
                    self._state._encoding_kind, bom_length = _file_bom_encoding(
                        self._state._buf, length, self._state._encoding_kind
                    )
                    self._state._bom_checked = True
                if width == 2 and _file_utf16_surrogate_pair(
                    self._state._buf, length - 2, self._state._encoding_kind
                ):
                    _file_buffer_reserve(self._state, length + 2)
                    for _ in range(2):
                        byte = self._read_byte()
                        if byte < 0:
                            break
                        self._state._buf[length] = u8(byte)
                        length += 1
            value = _file_decode_buffer(
                self._state, length, bom_length
            )
            if self._state._newline is None and not _file_encoding_is_multibyte(self._state._encoding_kind) and value.endswith("\r"):
                following = self._read_byte()
                if following >= 0 and following != 0x0A:
                    self._state._pending = following
            if _file_encoding_is_multibyte(self._state._encoding_kind):
                if self._state._raw_line_read:
                    return value
                if self._state._newline is None:
                    if self._state._skip_initial_lf:
                        self._state._skip_initial_lf = False
                        if value == "\n":
                            return self.read(sz)
                        if value.startswith("\n"):
                            value = value[1:]
                    if value.endswith("\r"):
                        self._state._skip_initial_lf = True
                    return _file_translate_read_newlines_inplace(value, self._state._newline)
                return value
            return _file_translate_read_newlines_inplace(value, self._state._newline)

    def tell(self) -> int:
        self._ensure_open()
        ret = _C.gztell(self._state._fp)
        _gz_errcheck(self._state._fp)
        return ret

    def seek(self, offset: int, whence: int):
        self._ensure_open()
        unread = self._state._read_length - self._state._read_offset
        if unread > 0:
            _C.gzseek(self._state._fp, -unread, i32(1))
            _gz_errcheck(self._state._fp)
        _C.gzseek(self._state._fp, offset, i32(whence))
        _gz_errcheck(self._state._fp)
        _file_discard_read_buffer(self._state)
        self._state._pending = -1
        self._state._text_pending = str()
        self._state._skip_initial_lf = False
        self._state._raw_line_read = False

    def flush(self):
        Z_FINISH = 4
        self._ensure_open()
        _C.gzflush(self._state._fp, i32(Z_FINISH))
        _gz_errcheck(self._state._fp)

    def _iter_trim_newline(self) -> Generator[T]:
        self._ensure_open()
        while True:
            rd = self._getline()
            if rd != -1:
                if self._state._buf[rd - 1] == u8(10):
                    rd -= 1
                if T is bytes:
                    yield _file_buffer_bytes(self._state, rd)
                else:
                    yield _file_translate_line_ending_inplace(
                        _file_decode_buffer(
                            self._state, rd, 0
                        ), self._state._newline
                    )
            else:
                break

    def _ensure_open(self):
        if not self._state._fp:
            raise IOError("I/O operation on closed file")

    def _read_text_character(self) -> str:
        if len(self._state._text_pending) > 0:
            character = self._state._text_pending
            self._state._text_pending = str()
            return character
        return self.read(1)

    def _read_byte(self) -> int:
        if self._state._pending >= 0:
            byte = self._state._pending
            self._state._pending = -1
            return byte
        if self._state._read_offset == self._state._read_length:
            if not self._state._read_buf:
                self._state._read_buf = Ptr[u8](_FILE_READ_BUFFER_SIZE)
            self._state._read_offset = 0
            self._state._read_length = int(
                _C.gzread(self._state._fp, self._state._read_buf, u32(_FILE_READ_BUFFER_SIZE))
            )
            _gz_errcheck(self._state._fp)
        if self._state._read_length == 0:
            return -1
        byte = self._state._read_buf[self._state._read_offset]
        self._state._read_offset += 1
        return int(byte)

def _bz_errcheck(stream: cobj):
    errnum = i32(0)
    msg = _C.BZ2_bzerror(stream, __ptr__(errnum))
    if errnum < i32(0):
        raise IOError(f"bzip2 error: {str.from_ptr(msg)}")

@tuple
class bzFile[T]:
    _state: _FileState

    def __new__(fp: cobj):
        return bzFile[T](_FileState(fp))

    def __new__(
        path: str,
        mode: str,
        encoding: str = "utf-8",
        errors: str = "strict",
        newline: Optional[str] = None,
    ):
        fp = _C.BZ2_bzopen(path.c_str(), mode.c_str())
        if not fp:
            raise IOError(f"file {path} could not be opened")
        _file_validate_newline(newline)
        return bzFile[T](_FileState(fp, encoding, errors, newline, path, mode))

    def _getline(self) -> int:
        if not self._state._buf:
            self._state._size = 128
            self._state._buf = Ptr[u8](self._state._size)

        offset = 0
        while True:
            if offset == self._state._size:
                oldsz = self._state._size
                self._state._size *= 2
                self._state._buf = realloc(self._state._buf, self._state._size, oldsz)

            byte = self._read_byte()
            if byte < 0:
                if offset == 0:
                    return -1
                break
            self._state._buf[offset] = u8(byte)
            offset += 1
            if byte == 0x0A:
                break
            if T is str and self._state._newline is None and byte == 0x0D:
                following = self._read_byte()
                if following == 0x0A:
                    if offset == self._state._size:
                        oldsz = self._state._size
                        self._state._size *= 2
                        self._state._buf = realloc(self._state._buf, self._state._size, oldsz)
                    self._state._buf[offset] = u8(following)
                    offset += 1
                elif following >= 0:
                    self._state._pending = following
                    self._state._position -= 1
                break

        return offset

    def __iter__(self) -> Generator[T]:
        self._ensure_open()
        while True:
            line = self.readline()
            if len(line) == 0:
                break
            yield line

    def __enter__(self):
        pass

    def __exit__(self):
        self.close()

    def close(self):
        if self._state._fp:
            _C.BZ2_bzclose(self._state._fp)
            self._state._fp = cobj()
        if self._state._buf:
            free(self._state._buf)
        if self._state._read_buf:
            free(self._state._read_buf)
            self._state._read_buf = Ptr[u8]()
        self._state._reset_buffer()

    def readlines(self) -> List[T]:
        return [l for l in self]

    def readline(self) -> T:
        self._ensure_open()
        if T is str and _file_encoding_is_multibyte(self._state._encoding_kind):
            self._state._raw_line_read = True
            line = _UnicodeCodecBuffer(128)
            while True:
                character = self._read_text_character()
                if len(character) == 0:
                    break
                if self._state._skip_initial_lf:
                    self._state._skip_initial_lf = False
                    if character == "\n":
                        continue
                line.append(character._load_codepoint(0))
                if character == "\n" and (self._state._newline is None or self._state._newline == "" or self._state._newline == "\n"):
                    break
                if character == "\r" and self._state._newline is None:
                    self._state._skip_initial_lf = True
                    break
                if character == "\r" and (self._state._newline is None or self._state._newline == "" or self._state._newline == "\r" or self._state._newline == "\r\n"):
                    following = self._read_text_character()
                    if self._state._newline == "\r\n" and following == "\n":
                        line.append(following._load_codepoint(0))
                    elif self._state._newline == "" and following == "\n":
                        line.append(following._load_codepoint(0))
                    elif len(following) > 0:
                        self._state._text_pending = following
                    if self._state._newline == "\r\n" and following != "\n":
                        continue
                    break
            self._state._raw_line_read = False
            return _file_translate_line_ending_inplace(line.finish(), self._state._newline)
        length = self._getline()
        if length == -1:
            if T is bytes:
                return bytes()
            return str()
        if T is bytes:
            return _file_buffer_bytes(self._state, length)
        return _file_translate_line_ending_inplace(
            _file_decode_buffer(
                self._state, length, 0
            ), self._state._newline
        )

    def write(self, s: T) -> int:
        self._ensure_open()
        if T is bytes:
            _C.BZ2_bzwrite(self._state._fp, s._ptr, i32(len(s)))
            self._state._position += len(s)
        else:
            data = _unicode_encode_code(
                _file_translate_write_newlines(s, self._state._newline),
                self._state._encoding_kind,
                self._state._error_code,
            )
            _C.BZ2_bzwrite(self._state._fp, data._ptr, i32(len(data)))
            self._state._position += len(data)
        _bz_errcheck(self._state._fp)
        return len(s)

    def __file_write_gen__(self, g: Generator[T], T: type):
        for s in g:
            self.write(s)

    def read(self) -> T:
        return self.read(-1)

    def read(self, sz: int) -> T:
        self._ensure_open()
        if sz < 0:
            chunk_size = 4096
            length = 0
            prefix = self._state._text_pending
            self._state._text_pending = str()
            if self._state._pending >= 0:
                _file_buffer_reserve(self._state, 1)
                self._state._buf[0] = u8(self._read_byte())
                length = 1
            _file_buffer_reserve(
                self._state, length + self._state._read_length - self._state._read_offset
            )
            buffered = _file_take_read_buffer(
                self._state,
                self._state._buf + length,
                self._state._read_length - self._state._read_offset,
            )
            length += buffered
            self._state._position += buffered
            while True:
                _file_buffer_reserve(self._state, length + chunk_size)
                count = int(_C.BZ2_bzread(
                    self._state._fp, self._state._buf + length, i32(chunk_size)
                ))
                _bz_errcheck(self._state._fp)
                length += count
                self._state._position += count
                if count < chunk_size:
                    break
            if T is bytes:
                return _file_buffer_bytes(self._state, length)
            else:
                value = _file_translate_read_newlines_inplace(
                    _file_decode_buffer(
                        self._state, length, 0
                    ), self._state._newline
                )
                return prefix + value if len(prefix) > 0 else value
        if T is bytes:
            _file_buffer_reserve(self._state, sz)
            buffered = _file_take_read_buffer(self._state, self._state._buf, sz)
            length = buffered
            self._state._position += buffered
            ret = _C.BZ2_bzread(
                self._state._fp, self._state._buf + length, i32(sz - length)
            )
            _bz_errcheck(self._state._fp)
            self._state._position += int(ret)
            length += int(ret)
            return _file_buffer_bytes(self._state, length)
        else:
            _file_buffer_reserve(self._state, sz)
            length = 0
            bom_length = 0
            for _ in range(sz):
                _file_buffer_reserve(self._state, length + 1)
                byte = self._read_byte()
                if byte < 0:
                    break
                self._state._buf[length] = u8(byte)
                width = _file_text_sequence_length(
                    int(self._state._buf[length]), self._state._encoding_kind
                )
                if not self._state._bom_checked:
                    width *= 2
                length += 1
                if width > 1:
                    _file_buffer_reserve(self._state, length + width - 1)
                    for _ in range(width - 1):
                        byte = self._read_byte()
                        if byte < 0:
                            break
                        self._state._buf[length] = u8(byte)
                        length += 1
                if not self._state._bom_checked:
                    self._state._encoding_kind, bom_length = _file_bom_encoding(
                        self._state._buf, length, self._state._encoding_kind
                    )
                    self._state._bom_checked = True
                if width == 2 and _file_utf16_surrogate_pair(
                    self._state._buf, length - 2, self._state._encoding_kind
                ):
                    _file_buffer_reserve(self._state, length + 2)
                    for _ in range(2):
                        byte = self._read_byte()
                        if byte < 0:
                            break
                        self._state._buf[length] = u8(byte)
                        length += 1
            value = _file_decode_buffer(
                self._state, length, bom_length
            )
            if self._state._newline is None and not _file_encoding_is_multibyte(self._state._encoding_kind) and value.endswith("\r"):
                following = self._read_byte()
                if following >= 0 and following != 0x0A:
                    self._state._pending = following
                    self._state._position -= 1
            if _file_encoding_is_multibyte(self._state._encoding_kind):
                if self._state._raw_line_read:
                    return value
                if self._state._newline is None:
                    if self._state._skip_initial_lf:
                        self._state._skip_initial_lf = False
                        if value == "\n":
                            return self.read(sz)
                        if value.startswith("\n"):
                            value = value[1:]
                    if value.endswith("\r"):
                        self._state._skip_initial_lf = True
                    return _file_translate_read_newlines_inplace(value, self._state._newline)
                return value
            return _file_translate_read_newlines_inplace(value, self._state._newline)

    def tell(self) -> int:
        self._ensure_open()
        return self._state._position

    def seekable(self) -> bool:
        self._ensure_open()
        return "r" in self._state._mode

    def seek(self, offset: int, whence: int):
        self._ensure_open()
        self._state._pending = -1
        self._state._text_pending = str()
        self._state._skip_initial_lf = False
        self._state._raw_line_read = False
        if "r" not in self._state._mode:
            raise IOError("file is not open for reading")
        if whence == 0:
            target = offset
        elif whence == 1:
            target = self._state._position + offset
        elif whence == 2:
            while self._read_byte() >= 0:
                pass
            target = self._state._position + offset
        else:
            raise ValueError("unsupported seek whence")
        if target < 0:
            raise ValueError("negative seek position")
        if target < self._state._position:
            _C.BZ2_bzclose(self._state._fp)
            self._state._fp = _C.BZ2_bzopen(self._state._path.c_str(), self._state._mode.c_str())
            if not self._state._fp:
                raise IOError(f"file {self._state._path} could not be opened")
            self._state._position = 0
            self._state._pending = -1
            _file_discard_read_buffer(self._state)
        while self._state._position < target:
            if self._read_byte() < 0:
                break

    def flush(self):
        self._ensure_open()
        _C.BZ2_bzflush(self._state._fp)
        _bz_errcheck(self._state._fp)

    def _iter_trim_newline(self) -> Generator[T]:
        self._ensure_open()
        while True:
            rd = self._getline()
            if rd != -1:
                if self._state._buf[rd - 1] == u8(10):
                    rd -= 1
                if T is bytes:
                    yield _file_buffer_bytes(self._state, rd)
                else:
                    yield _file_translate_line_ending_inplace(
                        _file_decode_buffer(
                            self._state, rd, 0
                        ), self._state._newline
                    )
            else:
                break

    def _ensure_open(self):
        if not self._state._fp:
            raise IOError("I/O operation on closed file")

    def _read_text_character(self) -> str:
        if len(self._state._text_pending) > 0:
            character = self._state._text_pending
            self._state._text_pending = str()
            return character
        return self.read(1)

    def _read_byte(self) -> int:
        if self._state._pending >= 0:
            byte = self._state._pending
            self._state._pending = -1
            self._state._position += 1
            return byte
        if self._state._read_offset == self._state._read_length:
            if not self._state._read_buf:
                self._state._read_buf = Ptr[u8](_FILE_READ_BUFFER_SIZE)
            self._state._read_offset = 0
            self._state._read_length = int(
                _C.BZ2_bzread(self._state._fp, self._state._read_buf, i32(_FILE_READ_BUFFER_SIZE))
            )
            _bz_errcheck(self._state._fp)
        if self._state._read_length == 0:
            return -1
        byte = self._state._read_buf[self._state._read_offset]
        self._state._read_offset += 1
        self._state._position += 1
        return int(byte)


def _literal_contains(needle: Literal[str], haystack: Literal[str]) -> Literal[bool]:
    import internal.static as static

    if static.len(needle) > static.len(haystack):
        return False
    elif haystack[0:static.len(needle)] == needle:
        return True
    else:
        return _literal_contains(needle, haystack[1:])

def open(
    path: str,
    mode: str = "r",
    encoding: str = "utf-8",
    errors: str = "strict",
    newline: Optional[str] = None,
) -> File[str]:
    return File[str](path, mode, encoding, errors, newline)

@overload
def open(
    path: str,
    mode: Literal[str],
    encoding: str = "utf-8",
    errors: str = "strict",
    newline: Optional[str] = None,
):
    if _literal_contains("b", mode):
        if encoding != "utf-8" or errors != "strict" or newline is not None:
            raise ValueError("binary mode does not take encoding, errors or newline")
        return File[bytes](path, mode)
    else:
        return File[str](path, mode, encoding, errors, newline)

def gzopen(
    path: str,
    mode: str = "r",
    encoding: str = "utf-8",
    errors: str = "strict",
    newline: Optional[str] = None,
) -> gzFile[str]:
    return gzFile[str](path, mode, encoding, errors, newline)

@overload
def gzopen(
    path: str,
    mode: Literal[str],
    encoding: str = "utf-8",
    errors: str = "strict",
    newline: Optional[str] = None,
):
    if _literal_contains("b", mode):
        if encoding != "utf-8" or errors != "strict" or newline is not None:
            raise ValueError("binary mode does not take encoding, errors or newline")
        return gzFile[bytes](path, mode)
    else:
        return gzFile[str](path, mode, encoding, errors, newline)

def bzopen(
    path: str,
    mode: str = "r",
    encoding: str = "utf-8",
    errors: str = "strict",
    newline: Optional[str] = None,
) -> bzFile[str]:
    return bzFile[str](path, mode, encoding, errors, newline)

@overload
def bzopen(
    path: str,
    mode: Literal[str],
    encoding: str = "utf-8",
    errors: str = "strict",
    newline: Optional[str] = None,
):
    if _literal_contains("b", mode):
        if encoding != "utf-8" or errors != "strict" or newline is not None:
            raise ValueError("binary mode does not take encoding, errors or newline")
        return bzFile[bytes](path, mode)
    else:
        return bzFile[str](path, mode, encoding, errors, newline)

def is_binary(path: str) -> bool:
    # https://stackoverflow.com/questions/898669/how-can-i-detect-if-a-file-is-binary-non-text-in-python/7392391#7392391
    # Can get both false positive and false negatives, but still is a
    # clever approach that works for the large majority of files
    with open(path, "rb") as f:
        header = f.read(1024)
        return any(
            c != 7
            and c != 8
            and c != 9
            and c != 10
            and c != 12
            and c != 13
            and c != 27
            and (c < 0x20 or c == 0x7F)
            for c in header
        )
