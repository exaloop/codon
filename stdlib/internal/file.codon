from internal.gc import realloc, free
from internal.str import _UnicodeCodecBuffer, _make_meta, _unicode_decode_ptr, _unicode_encode_code, \
                         _encoding_code, _error_code, _native_is_little_endian, _ENCODING_UTF8, \
                         _ENCODING_UTF16, _ENCODING_UTF16_LE, _ENCODING_UTF16_BE, _ENCODING_UTF32, \
                         _ENCODING_UTF32_LE, _ENCODING_UTF32_BE

# Match CPython's split between a relatively small TextIOWrapper decode chunk
# and a larger buffered raw I/O layer. CPython dynamically chooses the raw
# buffer from the device block size (commonly 128 KiB on regular files).
_FILE_READ_BUFFER_SIZE: Literal[int] = 131072
_FILE_TEXT_LARGE_CHUNK_SIZE: Literal[int] = 1048576
_FILE_READ_ALL_CHUNK_SIZE: Literal[int] = 131072

_FILE_BACKEND_STDIO: Literal[int] = 0
_FILE_BACKEND_GZIP: Literal[int] = 1
_FILE_BACKEND_BZIP2: Literal[int] = 2

_FILE_MODE_READ: Literal[int] = 1
_FILE_MODE_WRITE: Literal[int] = 2
_FILE_MODE_APPEND: Literal[int] = 4
_FILE_MODE_EXCLUSIVE: Literal[int] = 8
_FILE_MODE_UPDATE: Literal[int] = 16
_FILE_MODE_BINARY: Literal[int] = 32
_FILE_MODE_TEXT: Literal[int] = 64

_FILE_NEWLINE_LF: Literal[int] = 1
_FILE_NEWLINE_CR: Literal[int] = 2
_FILE_NEWLINE_CRLF: Literal[int] = 4
_FILE_NEWLINE_TRANSLATE: Literal[int] = 8
_FILE_NEWLINE_UNIVERSAL: Literal[int] = _FILE_NEWLINE_LF | _FILE_NEWLINE_CR

def _file_mode_flags(mode: str) -> int:
    flags = 0
    for i in range(len(mode)):
        character = mode._load_codepoint(i)
        if character == 0x72:  # r
            flags |= _FILE_MODE_READ
        elif character == 0x77:  # w
            flags |= _FILE_MODE_WRITE
        elif character == 0x61:  # a
            flags |= _FILE_MODE_WRITE | _FILE_MODE_APPEND
        elif character == 0x78:  # x
            flags |= _FILE_MODE_WRITE | _FILE_MODE_EXCLUSIVE
        elif character == 0x2B:  # +
            flags |= _FILE_MODE_READ | _FILE_MODE_WRITE | _FILE_MODE_UPDATE
        elif character == 0x62:  # b
            flags |= _FILE_MODE_BINARY
        elif character == 0x74:  # t
            flags |= _FILE_MODE_TEXT
    return flags

def _file_compressed_mode(flags: int) -> str:
    update = bool(flags & _FILE_MODE_UPDATE)
    if flags & _FILE_MODE_APPEND:
        return "ab+" if update else "ab"
    if flags & _FILE_MODE_EXCLUSIVE:
        return "xb+" if update else "xb"
    if flags & _FILE_MODE_WRITE:
        return "wb+" if update else "wb"
    return "rb+" if update else "rb"

def _file_utf8_sequence_length(first: int) -> int:
    if first < 0x80:
        return 1
    if first >= 0xC2 and first <= 0xDF:
        return 2
    if first >= 0xE0 and first <= 0xEF:
        return 3
    if first >= 0xF0 and first <= 0xF4:
        return 4
    return 1

def _file_utf16_surrogate_pair(data: Ptr[u8], offset: int, encoding_kind: int) -> bool:
    if encoding_kind != _ENCODING_UTF16_LE and encoding_kind != _ENCODING_UTF16_BE:
        return False
    if encoding_kind == _ENCODING_UTF16_LE:
        unit = int(data[offset]) | (int(data[offset + 1]) << 8)
    else:
        unit = (int(data[offset]) << 8) | int(data[offset + 1])
    return 0xD800 <= unit and unit <= 0xDBFF

def _file_bom_encoding(data: Ptr[u8], length: int, encoding: int) -> Tuple[int, int]:
    if encoding == _ENCODING_UTF16 and length >= 2:
        if data[0] == u8(0xFF) and data[1] == u8(0xFE):
            return (_ENCODING_UTF16_LE, 2)
        if data[0] == u8(0xFE) and data[1] == u8(0xFF):
            return (_ENCODING_UTF16_BE, 2)
    if encoding == _ENCODING_UTF32 and length >= 4:
        if data[0] == u8(0xFF) and data[1] == u8(0xFE) and data[2] == u8(0) and data[3] == u8(0):
            return (_ENCODING_UTF32_LE, 4)
        if data[0] == u8(0) and data[1] == u8(0) and data[2] == u8(0xFE) and data[3] == u8(0xFF):
            return (_ENCODING_UTF32_BE, 4)
    return (encoding, 0)

def _file_encoding_has_bom(encoding: int) -> bool:
    return encoding == _ENCODING_UTF16 or encoding == _ENCODING_UTF32

def _file_encoding_is_multibyte(encoding_kind: int) -> bool:
    return encoding_kind == _ENCODING_UTF16 or encoding_kind == _ENCODING_UTF16_LE or encoding_kind == _ENCODING_UTF16_BE or encoding_kind == _ENCODING_UTF32 or encoding_kind == _ENCODING_UTF32_LE or encoding_kind == _ENCODING_UTF32_BE

def _file_newline_flags(newline: Optional[str]) -> int:
    if newline is None:
        return _FILE_NEWLINE_UNIVERSAL | _FILE_NEWLINE_TRANSLATE
    if newline == "":
        return _FILE_NEWLINE_UNIVERSAL
    if newline == "\n":
        return _FILE_NEWLINE_LF
    if newline == "\r":
        return _FILE_NEWLINE_CR
    if newline == "\r\n":
        return _FILE_NEWLINE_CRLF
    raise ValueError("illegal newline value")

def _file_translate_read_newlines_inplace(value: str, newline_flags: int) -> str:
    if not newline_flags & _FILE_NEWLINE_TRANSLATE:
        return value

    # Universal-newline translation only changes CR. Codon's str.find uses the
    # optimized Unicode fast-search path, so the overwhelmingly common LF-only
    # case avoids the slower codepoint-by-codepoint rewrite completely.
    if value.find("\r") < 0:
        return value

    source = 0
    output = 0
    while source < len(value):
        codepoint = value._load_codepoint(source)
        if codepoint == 0x0D:
            value._store_codepoint(output, 0x0A)
            source += 1
            if source < len(value) and value._load_codepoint(source) == 0x0A:
                source += 1
        else:
            if output != source:
                value._store_codepoint(output, codepoint)
            source += 1
        output += 1
    if output == len(value):
        return value
    return str(value._ptr, _make_meta(output, value._kind()))

def _file_translate_line_ending_inplace(value: str, newline_flags: int) -> str:
    if not newline_flags & _FILE_NEWLINE_TRANSLATE or len(value) == 0:
        return value

    last = len(value) - 1
    if value._load_codepoint(last) == 0x0D:
        value._store_codepoint(last, 0x0A)
        return value
    if last > 0 and value._load_codepoint(last - 1) == 0x0D and value._load_codepoint(last) == 0x0A:
        value._store_codepoint(last - 1, 0x0A)
        return str(value._ptr, _make_meta(last, value._kind()))
    return value

class _FileBuffer:
    _ptr: Ptr[u8]
    _capacity: int

    def __init__(self, capacity: int = 0):
        self._ptr = Ptr[u8](capacity) if capacity > 0 else Ptr[u8]()
        self._capacity = capacity

    def reserve(self, required: int):
        if required <= self._capacity:
            return
        capacity = self._capacity if self._capacity > 0 else required
        while capacity < required:
            capacity *= 2
        self._ptr = (
            realloc(self._ptr, capacity, self._capacity)
            if self._ptr
            else Ptr[u8](capacity)
        )
        self._capacity = capacity

    def finish_bytes(self, length: int) -> bytes:
        result = Ptr[u8](length)
        if length > 0:
            bytes.memcpy(result, self._ptr, length)
        self.clear()
        return bytes(result, length)

    def detach(self) -> Ptr[u8]:
        result = self._ptr
        self._ptr = Ptr[u8]()
        self._capacity = 0
        return result

    def clear(self):
        if self._ptr:
            free(self._ptr)
            self._ptr = Ptr[u8]()
        self._capacity = 0

class _FileState:
    _fp: cobj
    _read_buf: Ptr[u8]
    _read_offset: int
    _read_length: int
    _write_buf: Ptr[u8]
    _write_length: int
    _newline_flags: int
    _encoding_kind: int
    _initial_encoding_kind: int
    _write_encoding_kind: int
    _error_code: int
    _pending: int
    _path: str
    _mode_flags: int
    _position: int
    _text_pending: str
    _text_pending_offset: int
    _last_text_read_bytes: int
    _bom_checked: bool
    _write_bom_done: bool
    _skip_initial_lf: bool
    _b2cratio: float
    _backend: int

    def __init__(
        self,
        fp: cobj,
        encoding: str = "utf-8",
        errors: str = "strict",
        newline: Optional[str] = None,
        path: str = "",
        mode_flags: int = 0,
        backend: int = _FILE_BACKEND_STDIO,
    ):
        self._fp = fp
        self._read_buf = Ptr[u8]()
        self._read_offset = 0
        self._read_length = 0
        self._write_buf = Ptr[u8]()
        self._write_length = 0
        self._newline_flags = _file_newline_flags(newline)
        self._encoding_kind = _encoding_code(encoding)
        self._initial_encoding_kind = self._encoding_kind
        self._write_encoding_kind = self._encoding_kind
        self._error_code = _error_code(errors)
        self._pending = -1
        self._path = path
        self._mode_flags = mode_flags
        self._position = 0
        self._backend = backend
        self._text_pending = str()
        self._text_pending_offset = 0
        self._last_text_read_bytes = 0
        self._bom_checked = not _file_encoding_has_bom(self._encoding_kind)
        self._write_bom_done = not _file_encoding_has_bom(self._write_encoding_kind)
        self._skip_initial_lf = False
        if self._encoding_kind == _ENCODING_UTF16 or self._encoding_kind == _ENCODING_UTF16_LE or self._encoding_kind == _ENCODING_UTF16_BE:
            self._b2cratio = 2.0
        elif self._encoding_kind == _ENCODING_UTF32 or self._encoding_kind == _ENCODING_UTF32_LE or self._encoding_kind == _ENCODING_UTF32_BE:
            self._b2cratio = 4.0
        else:
            self._b2cratio = 1.0


def _file_reset_text_state(state: _FileState, reset_encoding: bool = False):
    state._pending = -1
    state._text_pending = str()
    state._text_pending_offset = 0
    state._last_text_read_bytes = 0
    state._skip_initial_lf = False
    if reset_encoding:
        state._encoding_kind = state._initial_encoding_kind
        state._bom_checked = not _file_encoding_has_bom(state._encoding_kind)
        if state._encoding_kind == _ENCODING_UTF16 or state._encoding_kind == _ENCODING_UTF16_LE or state._encoding_kind == _ENCODING_UTF16_BE:
            state._b2cratio = 2.0
        elif state._encoding_kind == _ENCODING_UTF32 or state._encoding_kind == _ENCODING_UTF32_LE or state._encoding_kind == _ENCODING_UTF32_BE:
            state._b2cratio = 4.0
        else:
            state._b2cratio = 1.0

def _file_flush_stdio_write_buffer(state: _FileState):
    if state._backend != _FILE_BACKEND_STDIO or state._write_length == 0:
        return
    written = int(_C.fwrite(state._write_buf, 1, state._write_length, state._fp))
    if written != state._write_length or _C.ferror(state._fp):
        raise IOError("file I/O error: error in write")
    state._write_length = 0

def _file_buffered_stdio_write(state: _FileState, data: Ptr[u8], length: int):
    if length <= 0:
        return
    if not state._write_buf:
        state._write_buf = Ptr[u8](_FILE_READ_BUFFER_SIZE)

    # Large writes bypass the staging buffer once any earlier data has been
    # committed. Small writes are coalesced so line-at-a-time text output does
    # not pay a libc call/lock for every Python-level write().
    if length >= _FILE_READ_BUFFER_SIZE:
        _file_flush_stdio_write_buffer(state)
        written = int(_C.fwrite(data, 1, length, state._fp))
        if written != length or _C.ferror(state._fp):
            raise IOError("file I/O error: error in write")
        return

    if state._write_length + length > _FILE_READ_BUFFER_SIZE:
        _file_flush_stdio_write_buffer(state)
    bytes.memcpy(state._write_buf + state._write_length, data, length)
    state._write_length += length

def _file_raw_read(state: _FileState, output: Ptr[u8], length: int) -> int:
    if length <= 0:
        return 0

    if state._backend == _FILE_BACKEND_STDIO:
        count = int(_C.fread(output, 1, length, state._fp))
        if _C.ferror(state._fp):
            raise IOError("file I/O error: error in read")
        return count

    if state._backend == _FILE_BACKEND_GZIP:
        count = int(_C.gzread(state._fp, output, u32(length)))
        _gz_errcheck(state._fp)
        return count

    count = int(_C.BZ2_bzread(state._fp, output, i32(length)))
    _bz_errcheck(state._fp)
    return count

def _file_fill_read_buffer(state: _FileState) -> int:
    if not state._read_buf:
        state._read_buf = Ptr[u8](_FILE_READ_BUFFER_SIZE)
    state._read_offset = 0
    state._read_length = _file_raw_read(
        state, state._read_buf, _FILE_READ_BUFFER_SIZE
    )
    return state._read_length

def _file_read_byte(state: _FileState) -> int:
    if state._pending >= 0:
        byte = state._pending
        state._pending = -1
        if state._backend == _FILE_BACKEND_BZIP2:
            state._position += 1
        return byte

    if state._read_offset == state._read_length:
        if _file_fill_read_buffer(state) == 0:
            return -1

    byte = state._read_buf[state._read_offset]
    state._read_offset += 1
    if state._backend == _FILE_BACKEND_BZIP2:
        state._position += 1
    return int(byte)

def _file_check_initial_bom(state: _FileState, buffer: Ptr[u8], length: int) -> int:
    if state._bom_checked or length == 0:
        return 0
    encoding, bom_length = _file_bom_encoding(
        buffer, length, state._encoding_kind
    )
    if bom_length == 0:
        raise ValueError("UTF-16/UTF-32 stream does not start with BOM")
    state._encoding_kind = encoding
    state._bom_checked = True
    return bom_length

def _file_native_stream_encoding(encoding: int) -> int:
    if encoding == _ENCODING_UTF16:
        return _ENCODING_UTF16_LE if _native_is_little_endian() else _ENCODING_UTF16_BE
    if encoding == _ENCODING_UTF32:
        return _ENCODING_UTF32_LE if _native_is_little_endian() else _ENCODING_UTF32_BE
    return encoding

def _file_encoded_newline_layout(encoding: int) -> Tuple[int, int]:
    encoding = _file_native_stream_encoding(encoding)
    if encoding == _ENCODING_UTF16_LE:
        return 2, 0
    if encoding == _ENCODING_UTF16_BE:
        return 2, 1
    if encoding == _ENCODING_UTF32_LE:
        return 4, 0
    if encoding == _ENCODING_UTF32_BE:
        return 4, 3
    return 1, 0

def _file_encoded_is_lf(
    data: Ptr[u8], position: int, width: int, byte_offset: int
) -> bool:
    if data[position + byte_offset] != u8(0x0A):
        return False
    for offset in range(width):
        if offset != byte_offset and data[position + offset] != u8(0):
            return False
    return True

def _file_store_encoded_cr(
    data: Ptr[u8], position: int, width: int, byte_offset: int
):
    for offset in range(width):
        data[position + offset] = u8(0)
    data[position + byte_offset] = u8(0x0D)

def _file_translate_encoded_newlines(
    data: bytes, encoding: int, newline_flags: int
) -> bytes:
    if newline_flags != _FILE_NEWLINE_CR and newline_flags != _FILE_NEWLINE_CRLF:
        return data

    width, byte_offset = _file_encoded_newline_layout(encoding)
    newline_count = 0
    position = 0
    while position + width <= len(data):
        if _file_encoded_is_lf(data._ptr, position, width, byte_offset):
            newline_count += 1
        position += width

    if newline_count == 0:
        return data

    if newline_flags == _FILE_NEWLINE_CR:
        position = 0
        while position + width <= len(data):
            if _file_encoded_is_lf(data._ptr, position, width, byte_offset):
                data._ptr[position + byte_offset] = u8(0x0D)
            position += width
        return data

    old_length = len(data)
    new_length = old_length + newline_count * width
    output = realloc(data._ptr, new_length, old_length)
    source = old_length
    destination = new_length
    while source >= width:
        source -= width
        is_lf = _file_encoded_is_lf(output, source, width, byte_offset)
        destination -= width
        bytes.memcpy(output + destination, output + source, width)
        if is_lf:
            destination -= width
            _file_store_encoded_cr(output, destination, width, byte_offset)
    return bytes(output, new_length)

def _file_stream_encode(
    state: _FileState, value: str, newline_flags: int
) -> bytes:
    encoding = state._write_encoding_kind
    data = _unicode_encode_code(value, encoding, state._error_code)
    data = _file_translate_encoded_newlines(data, encoding, newline_flags)
    if not state._write_bom_done:
        state._write_bom_done = True
        state._write_encoding_kind = _file_native_stream_encoding(encoding)
    return data

def _file_text_raw_length(state: _FileState, value: str) -> int:
    encoding = state._encoding_kind
    if encoding == _ENCODING_UTF16:
        encoding = _ENCODING_UTF16_LE
    elif encoding == _ENCODING_UTF32:
        encoding = _ENCODING_UTF32_LE
    return len(_unicode_encode_code(value, encoding, state._error_code))

def _file_text_pending_length(state: _FileState) -> int:
    return len(state._text_pending) - state._text_pending_offset

def _file_take_text_pending(state: _FileState, length: int) -> str:
    available = _file_text_pending_length(state)
    if available <= 0 or length <= 0:
        return str()
    take = length if length < available else available
    start = state._text_pending_offset
    result = state._text_pending[start:start + take]
    state._text_pending_offset += take
    if state._text_pending_offset == len(state._text_pending):
        state._text_pending = str()
        state._text_pending_offset = 0
    return result

def _file_take_all_text_pending(state: _FileState) -> str:
    if _file_text_pending_length(state) <= 0:
        return str()
    start = state._text_pending_offset
    result = state._text_pending[start:] if start > 0 else state._text_pending
    state._text_pending = str()
    state._text_pending_offset = 0
    return result

def _file_set_text_pending(state: _FileState, value: str, offset: int = 0):
    state._text_pending = value
    state._text_pending_offset = offset

def _file_prepend_text_pending(state: _FileState, value: str):
    if _file_text_pending_length(state) > 0:
        value = value + state._text_pending[state._text_pending_offset:]
    state._text_pending = value
    state._text_pending_offset = 0

def _file_text_pending_raw_length(state: _FileState) -> int:
    # Raw-byte accounting is only needed by tell()/seek(). Keep it off the hot
    # read path; in particular, read(1) must not re-encode the remaining chunk.
    if _file_text_pending_length(state) <= 0:
        return 0
    value = state._text_pending[state._text_pending_offset:]
    return _file_text_raw_length(state, value)

# Number of additional raw bytes needed to avoid cutting a decode chunk in the
# middle of a code unit / UTF-8 sequence. This is the small bit of incremental
# decoder state we need for the encodings implemented by Codon.
def _file_text_chunk_extra(state: _FileState, buffer: Ptr[u8], length: int, offset: int) -> int:
    encoding = state._encoding_kind
    payload = length - offset
    if payload <= 0:
        return 0

    if encoding == _ENCODING_UTF32_LE or encoding == _ENCODING_UTF32_BE:
        rem = payload % 4
        return 0 if rem == 0 else 4 - rem

    if encoding == _ENCODING_UTF16_LE or encoding == _ENCODING_UTF16_BE:
        if payload % 2 != 0:
            return 1
        if payload >= 2 and _file_utf16_surrogate_pair(
            buffer, length - 2, encoding
        ):
            return 2
        return 0

    if encoding != _ENCODING_UTF8:
        return 0

    # Find the start byte of the final UTF-8 sequence. Invalid start/continuation
    # bytes are deliberately left to the configured decoder error handler.
    start = length - 1
    continuation = 0
    while start >= offset and continuation < 3 and (int(buffer[start]) & 0xC0) == 0x80:
        start -= 1
        continuation += 1
    if start < offset:
        return 0
    expected = _file_utf8_sequence_length(int(buffer[start]))
    available = length - start
    return expected - available if expected > available else 0

def _file_decode_text_chunk(
    state: _FileState, buffer: Ptr[u8], length: int, bom_length: int = -1
) -> str:
    state._last_text_read_bytes = length
    if length == 0:
        return str()

    if bom_length < 0:
        bom_length = _file_check_initial_bom(state, buffer, length)
    translate_newlines = True
    if state._newline_flags & _FILE_NEWLINE_TRANSLATE and state._encoding_kind == _ENCODING_UTF8:
        translate_newlines = bool(
            _C.memchr(buffer + bom_length, i32(0x0D), length - bom_length)
        )
    value = _file_decode_buffer(state, buffer, length, bom_length)
    raw_payload = length - bom_length
    if len(value) > 0 and raw_payload > 0:
        state._b2cratio = float(raw_payload) / float(len(value))

    if state._newline_flags & _FILE_NEWLINE_TRANSLATE:
        # Preserve IncrementalNewlineDecoder's pending-CR behavior across raw
        # decode chunks: CR at the end of one chunk and LF at the beginning of
        # the next is a single translated newline.
        if state._skip_initial_lf:
            state._skip_initial_lf = False
            if value == "\n":
                return str()
            if value.startswith("\n"):
                value = value[1:]
        if value.endswith("\r"):
            state._skip_initial_lf = True
            if translate_newlines:
                value = _file_translate_read_newlines_inplace(value, state._newline_flags)
    return value

def _file_decode_owned_text_chunk(
    state: _FileState, buffer: _FileBuffer, length: int, bom_length: int = -1
) -> str:
    state._last_text_read_bytes = length
    if length == 0:
        buffer.clear()
        return str()

    if bom_length < 0:
        bom_length = _file_check_initial_bom(state, buffer._ptr, length)
    translate_newlines = True
    if (
        state._newline_flags & _FILE_NEWLINE_TRANSLATE
        and state._encoding_kind == _ENCODING_UTF8
        and bom_length == 0
    ):
        is_ascii, translate_newlines = _file_classify_ascii_cr(
            buffer._ptr, length
        )
        if is_ascii:
            value = str(buffer.detach(), _make_meta(length, 0))
        else:
            value = _file_decode_owned_buffer(state, buffer, length, 0)
    else:
        if state._newline_flags & _FILE_NEWLINE_TRANSLATE and state._encoding_kind == _ENCODING_UTF8:
            translate_newlines = bool(
                _C.memchr(buffer._ptr + bom_length, i32(0x0D), length - bom_length)
            )
        value = _file_decode_owned_buffer(state, buffer, length, bom_length)
    raw_payload = length - bom_length
    if len(value) > 0 and raw_payload > 0:
        state._b2cratio = float(raw_payload) / float(len(value))

    if state._newline_flags & _FILE_NEWLINE_TRANSLATE:
        if state._skip_initial_lf:
            state._skip_initial_lf = False
            if value == "\n":
                return str()
            if value.startswith("\n"):
                value = value[1:]
        if value.endswith("\r"):
            state._skip_initial_lf = True
        if translate_newlines:
            value = _file_translate_read_newlines_inplace(value, state._newline_flags)
    return value

def _file_text_chunk_target(state: _FileState, remaining: int) -> int:
    # Decode from the full read buffer to amortize Unicode allocation and
    # validation; read(n) retains any extra characters as zero-copy views.
    estimated = int(float(remaining) * state._b2cratio)
    if remaining >= 65536 and estimated < _FILE_TEXT_LARGE_CHUNK_SIZE:
        return _FILE_TEXT_LARGE_CHUNK_SIZE
    if estimated < _FILE_READ_BUFFER_SIZE:
        return _FILE_READ_BUFFER_SIZE
    if estimated > _FILE_TEXT_LARGE_CHUNK_SIZE:
        return _FILE_TEXT_LARGE_CHUNK_SIZE
    return estimated

@pure
@llvm
def _file_byte_mask16(data: Ptr[u8], pos: int, needle: u8) -> u16:
    %src = getelementptr inbounds i8, ptr %data, i64 %pos
    %bytes = load <16 x i8>, ptr %src, align 1
    %base = insertelement <16 x i8> poison, i8 %needle, i64 0
    %needles = shufflevector <16 x i8> %base, <16 x i8> poison, <16 x i32> zeroinitializer
    %matches = icmp eq <16 x i8> %bytes, %needles
    %mask = bitcast <16 x i1> %matches to i16
    ret i16 %mask

@pure
@llvm
def _file_newline_mask16(data: Ptr[u8], pos: int) -> u16:
    %src = getelementptr inbounds i8, ptr %data, i64 %pos
    %bytes = load <16 x i8>, ptr %src, align 1
    %lfbase = insertelement <16 x i8> poison, i8 10, i64 0
    %lf = shufflevector <16 x i8> %lfbase, <16 x i8> poison, <16 x i32> zeroinitializer
    %crbase = insertelement <16 x i8> poison, i8 13, i64 0
    %cr = shufflevector <16 x i8> %crbase, <16 x i8> poison, <16 x i32> zeroinitializer
    %islf = icmp eq <16 x i8> %bytes, %lf
    %iscr = icmp eq <16 x i8> %bytes, %cr
    %matches = or <16 x i1> %islf, %iscr
    %mask = bitcast <16 x i1> %matches to i16
    ret i16 %mask

@pure
@llvm
def _file_nonascii_mask16(data: Ptr[u8], pos: int) -> u16:
    %src = getelementptr inbounds i8, ptr %data, i64 %pos
    %bytes = load <16 x i8>, ptr %src, align 1
    %nonascii = icmp slt <16 x i8> %bytes, zeroinitializer
    %mask = bitcast <16 x i1> %nonascii to i16
    ret i16 %mask

@pure
@llvm
def _file_ascii_cr_mask16(data: Ptr[u8], pos: int) -> u32:
    %src = getelementptr inbounds i8, ptr %data, i64 %pos
    %bytes = load <16 x i8>, ptr %src, align 1
    %nonascii = icmp slt <16 x i8> %bytes, zeroinitializer
    %nonascii16 = bitcast <16 x i1> %nonascii to i16
    %crbase = insertelement <16 x i8> poison, i8 13, i64 0
    %cr = shufflevector <16 x i8> %crbase, <16 x i8> poison, <16 x i32> zeroinitializer
    %iscr = icmp eq <16 x i8> %bytes, %cr
    %cr16 = bitcast <16 x i1> %iscr to i16
    %nonascii32 = zext i16 %nonascii16 to i32
    %cr32 = zext i16 %cr16 to i32
    %shifted = shl i32 %cr32, 16
    %mask = or i32 %nonascii32, %shifted
    ret i32 %mask

@pure
@llvm
def _file_first_match(mask: u16) -> int:
    declare i16 @llvm.cttz.i16(i16, i1)
    %index16 = call i16 @llvm.cttz.i16(i16 %mask, i1 true)
    %index = zext i16 %index16 to i64
    ret i64 %index

def _file_is_ascii(data: Ptr[u8], length: int) -> bool:
    i = 0
    while i + 16 <= length:
        if _file_nonascii_mask16(data, i):
            return False
        i += 16
    while i < length:
        if data[i] >= u8(0x80):
            return False
        i += 1
    return True

def _file_classify_ascii_cr(data: Ptr[u8], length: int) -> Tuple[bool, bool]:
    is_ascii = True
    has_cr = False
    i = 0
    while i + 16 <= length:
        mask = _file_ascii_cr_mask16(data, i)
        is_ascii = is_ascii and not bool(mask & u32(0xFFFF))
        has_cr = has_cr or bool(mask & u32(0xFFFF0000))
        i += 16
    while i < length:
        byte = data[i]
        is_ascii = is_ascii and byte < u8(0x80)
        has_cr = has_cr or byte == u8(0x0D)
        i += 1
    return is_ascii, has_cr

def _file_scan_line_buffer(
    buffer: Ptr[u8],
    start: int,
    end: int,
    newline_flags: int,
    binary: bool,
) -> Tuple[int, bool]:
    if binary or newline_flags == _FILE_NEWLINE_LF:
        needle = u8(0x0A)
        i = start
        while i + 16 <= end:
            mask = _file_byte_mask16(buffer, i, needle)
            if mask:
                return (i + _file_first_match(mask) + 1, False)
            i += 16
        while i < end:
            if buffer[i] == needle:
                return (i + 1, False)
            i += 1
        return (-1, False)

    if newline_flags == _FILE_NEWLINE_CR:
        needle = u8(0x0D)
        i = start
        while i + 16 <= end:
            mask = _file_byte_mask16(buffer, i, needle)
            if mask:
                return (i + _file_first_match(mask) + 1, False)
            i += 16
        while i < end:
            if buffer[i] == needle:
                return (i + 1, False)
            i += 1
        return (-1, False)

    if newline_flags == _FILE_NEWLINE_CRLF:
        i = start
        while i < end:
            while i + 16 <= end:
                mask = _file_byte_mask16(buffer, i, u8(0x0D))
                if mask:
                    i += _file_first_match(mask)
                    break
                i += 16
            while i < end and buffer[i] != u8(0x0D):
                i += 1
            if i == end:
                return (-1, False)
            if i + 1 == end:
                return (i + 1, True)
            if buffer[i + 1] == u8(0x0A):
                return (i + 2, False)
            i += 1
        return (-1, False)

    i = start
    while i + 16 <= end:
        mask = _file_newline_mask16(buffer, i)
        if mask:
            i += _file_first_match(mask)
            break
        i += 16
    while i < end and buffer[i] != u8(0x0A) and buffer[i] != u8(0x0D):
        i += 1
    if i == end:
        return (-1, False)
    if buffer[i] == u8(0x0A):
        return (i + 1, False)
    if i + 1 < end and buffer[i + 1] == u8(0x0A):
        return (i + 2, False)
    return (i + 1, i + 1 == end)

def _file_readline_raw(
    state: _FileState,
    buffer: _FileBuffer,
    newline_flags: int,
    binary: bool,
) -> int:
    length = 0

    if state._pending >= 0:
        byte = _file_read_byte(state)
        buffer.reserve(1)
        buffer._ptr[0] = u8(byte)
        length = 1
        if binary and byte == 0x0A:
            return length
        if not binary:
            if newline_flags == _FILE_NEWLINE_LF and byte == 0x0A:
                return length
            if newline_flags == _FILE_NEWLINE_CR and byte == 0x0D:
                return length

    while True:
        if state._read_offset == state._read_length:
            if _file_fill_read_buffer(state) == 0:
                break

        start = state._read_offset
        line_end, lookahead = _file_scan_line_buffer(
            state._read_buf, start, state._read_length, newline_flags, binary
        )
        copy_end = state._read_length if line_end < 0 else line_end
        count = copy_end - start
        buffer.reserve(length + count + 1)
        if count > 0:
            bytes.memcpy(buffer._ptr + length, state._read_buf + start, count)
            length += count
            state._read_offset = copy_end

        if line_end < 0:
            continue
        if not lookahead:
            break

        following = _file_read_byte(state)
        if newline_flags == _FILE_NEWLINE_CRLF:
            if following == 0x0A:
                buffer._ptr[length] = u8(following)
                length += 1
                break
            if following >= 0:
                state._read_offset -= 1
            continue

        if following == 0x0A:
            buffer._ptr[length] = u8(following)
            length += 1
        elif following >= 0:
            state._read_offset -= 1
        break

    return length

def _file_decode_buffer(
    state: _FileState, buffer: Ptr[u8], length: int, offset: int
) -> str:
    payload = length - offset
    if payload <= 0:
        return str()

    # UTF-8 is overwhelmingly ASCII in many text workloads. Avoid the generic
    # decoder entirely when every byte is ASCII: Codon's ASCII string layout is
    # byte-for-byte identical to the input payload.
    if state._encoding_kind == _ENCODING_UTF8:
        if _file_is_ascii(buffer + offset, payload):
            result = Ptr[u8](payload)
            bytes.memcpy(result, buffer + offset, payload)
            return str(result, _make_meta(payload, 0))

    return _unicode_decode_ptr(
        buffer + offset, payload, state._encoding_kind, state._error_code
    )

def _file_decode_owned_buffer(
    state: _FileState, buffer: _FileBuffer, length: int, offset: int
) -> str:
    payload = length - offset
    if payload <= 0:
        buffer.clear()
        return str()

    # For ASCII UTF-8 the raw bytes are already exactly Codon's in-memory
    # Unicode representation. Transfer ownership of the read allocation to the
    # str instead of allocating and copying the payload a second time.
    if state._encoding_kind == _ENCODING_UTF8 and offset == 0:
        if _file_is_ascii(buffer._ptr, length):
            data = buffer.detach()
            return str(data, _make_meta(length, 0))

    value = _file_decode_buffer(state, buffer._ptr, length, offset)
    buffer.clear()
    return value

def _file_read_all_append(
    state: _FileState, buffer: _FileBuffer, length: int
) -> int:
    start = _C.ftell(state._fp)
    if start >= 0 and _C.fseek(state._fp, 0, i32(2)) == 0:
        end = _C.ftell(state._fp)
        if end >= start and _C.fseek(state._fp, start, i32(0)) == 0:
            buffer.reserve(length + end - start)
            length += _C.fread(buffer._ptr + length, 1, end - start, state._fp)
            if _C.ferror(state._fp):
                raise IOError("file I/O error: error in read")
            return length

    while True:
        buffer.reserve(length + _FILE_READ_ALL_CHUNK_SIZE)
        count = _C.fread(
            buffer._ptr + length, 1, _FILE_READ_ALL_CHUNK_SIZE, state._fp
        )
        length += count
        if count < _FILE_READ_ALL_CHUNK_SIZE:
            break
    if _C.ferror(state._fp):
        raise IOError("file I/O error: error in read")
    return length

def _file_take_read_buffer(state: _FileState, output: Ptr[u8], length: int) -> int:
    available = state._read_length - state._read_offset
    if available <= 0 or length <= 0:
        return 0
    count = min(available, length)
    bytes.memcpy(output, state._read_buf + state._read_offset, count)
    state._read_offset += count
    return count

def _file_discard_read_buffer(state: _FileState):
    state._read_offset = 0
    state._read_length = 0

def _file_read_all_buffered(state: _FileState, buffer: _FileBuffer) -> int:
    length = 0
    if state._pending >= 0:
        buffer.reserve(1)
        buffer._ptr[0] = u8(_file_read_byte(state))
        length = 1
    buffered = state._read_length - state._read_offset
    buffer.reserve(length + buffered)
    if buffered > 0:
        bytes.memcpy(
            buffer._ptr + length, state._read_buf + state._read_offset, buffered
        )
        length += buffered
    _file_discard_read_buffer(state)
    return _file_read_all_append(state, buffer, length)

@tuple
class File[T]:
    _state: _FileState

    def __new__(fp: cobj, mode: str):
        return File[T](_FileState(fp, mode_flags=_file_mode_flags(mode)))

    def __new__(
        path: str,
        mode: str,
        encoding: str = "utf-8",
        errors: str = "strict",
        newline: Optional[str] = None,
    ):
        fp = _C.fopen(path.c_str(), mode.c_str())
        if not fp:
            raise IOError(f"file {path} could not be opened")
        return File[T](_FileState(fp, encoding, errors, newline, path, _file_mode_flags(mode)))

    def __new__(fd: int, mode: str):
        fp = _C.fdopen(fd, mode.c_str())
        if not fp:
            raise IOError(f"file descriptor {fd} could not be opened")
        return File[T](_FileState(fp, path="", mode_flags=_file_mode_flags(mode)))

    def _errcheck(self, msg: str):
        err = int(_C.ferror(self._state._fp))
        if err:
            raise IOError(f"file I/O error: {msg}")

    def __enter__(self):
        self._ensure_open()
        return self

    def __exit__(self):
        self.close()

    def __iter__(self) -> Generator[T]:
        self._ensure_open()
        while True:
            line = self.readline()
            if len(line) == 0:
                break
            yield line

    def readlines(self) -> List[T]:
        return [l for l in self]

    def readline(self) -> T:
        self._ensure_open()
        _file_flush_stdio_write_buffer(self._state)
        if T is str and (
            _file_encoding_is_multibyte(self._state._encoding_kind)
            or _file_text_pending_length(self._state) > 0
        ):
            line = _UnicodeCodecBuffer(128)
            while True:
                character = self._read_text_character()
                if len(character) == 0:
                    break
                if self._state._skip_initial_lf:
                    self._state._skip_initial_lf = False
                    if character == "\n":
                        continue
                line.append(character._load_codepoint(0))
                if character == "\n" and self._state._newline_flags & _FILE_NEWLINE_LF:
                    break
                if character == "\r" and self._state._newline_flags & _FILE_NEWLINE_TRANSLATE:
                    self._state._skip_initial_lf = True
                    break
                if character == "\r" and self._state._newline_flags & (_FILE_NEWLINE_CR | _FILE_NEWLINE_CRLF):
                    following = self._read_text_character()
                    if self._state._newline_flags == _FILE_NEWLINE_CRLF and following == "\n":
                        line.append(following._load_codepoint(0))
                    elif self._state._newline_flags == _FILE_NEWLINE_UNIVERSAL and following == "\n":
                        line.append(following._load_codepoint(0))
                    elif len(following) > 0:
                        _file_prepend_text_pending(self._state, following)
                    if self._state._newline_flags == _FILE_NEWLINE_CRLF and following != "\n":
                        continue
                    break
            return _file_translate_line_ending_inplace(line.finish(), self._state._newline_flags)
        buffer = _FileBuffer()
        length = _file_readline_raw(
            self._state, buffer, self._state._newline_flags, T is bytes
        )
        if T is bytes:
            return buffer.finish_bytes(length)
        value = _file_decode_owned_buffer(self._state, buffer, length, 0)
        return _file_translate_line_ending_inplace(
            value, self._state._newline_flags
        )

    def write(self, s: T) -> int:
        self._ensure_open()
        if (
            not self._state._mode_flags & _FILE_MODE_WRITE
        ):
            raise IOError("file is not open for writing")
        if T is bytes:
            _file_buffered_stdio_write(self._state, s._ptr, len(s))
        else:
            # ASCII UTF-8 is already in the exact byte representation required
            # by the stream. Avoid both encoding allocation and transcoding.
            if (
                self._state._write_encoding_kind == _ENCODING_UTF8
                and s._is_ascii()
                and self._state._newline_flags != _FILE_NEWLINE_CR
                and self._state._newline_flags != _FILE_NEWLINE_CRLF
            ):
                self._state._write_bom_done = True
                _file_buffered_stdio_write(self._state, s._ptr, len(s))
            else:
                data = _file_stream_encode(
                    self._state,
                    s,
                    self._state._newline_flags,
                )
                _file_buffered_stdio_write(self._state, data._ptr, len(data))
        return len(s)

    def __file_write_gen__(self, g: Generator[T], T: type):
        for s in g:
            self.write(s)

    def read(self, sz: int = -1) -> T:
        self._ensure_open()
        _file_flush_stdio_write_buffer(self._state)
        if sz == 0:
            return bytes() if T is bytes else str()

        if T is bytes:
            if sz < 0:
                buffer = _FileBuffer()
                length = _file_read_all_buffered(self._state, buffer)
                return buffer.finish_bytes(length)
            result = Ptr[u8](sz)
            length = self._read_raw_into(result, sz)
            return bytes(result, length)

        if sz < 0:
            prefix = _file_take_all_text_pending(self._state)
            buffer = _FileBuffer()
            length = _file_read_all_buffered(self._state, buffer)
            value = _file_decode_owned_text_chunk(self._state, buffer, length)
            return prefix + value if len(prefix) > 0 else value

        if sz >= 65536:
            return self._read_large_text(sz)

        result = str()
        pending_length = _file_text_pending_length(self._state)
        if pending_length > 0:
            if pending_length >= sz:
                return _file_take_text_pending(self._state, sz)
            result = _file_take_all_text_pending(self._state)

        while len(result) < sz:
            remaining = sz - len(result)
            value = self._read_text_chunk(
                _file_text_chunk_target(self._state, remaining)
            )
            if len(value) == 0:
                if self._state._last_text_read_bytes > 0:
                    continue
                break
            if len(value) > remaining:
                _file_set_text_pending(self._state, value, remaining)
                prefix = value[:remaining]
                return prefix if len(result) == 0 else result + prefix
            result = value if len(result) == 0 else result + value

        return result

    def _read_large_text(self, sz: int) -> str:
        if (
            sz <= _FILE_READ_BUFFER_SIZE
            and _file_text_pending_length(self._state) == 0
            and self._state._backend == _FILE_BACKEND_STDIO
            and self._state._encoding_kind == _ENCODING_UTF8
            and self._state._b2cratio == 1.0
            and self._state._pending < 0
            and not self._state._skip_initial_lf
        ):
            available = self._state._read_length - self._state._read_offset
            if available == 0:
                available = _file_fill_read_buffer(self._state)
            if available >= sz or self._state._read_length < _FILE_READ_BUFFER_SIZE:
                take = min(available, sz)
                source = self._state._read_buf + self._state._read_offset
                is_ascii, has_cr = _file_classify_ascii_cr(source, take)
                if is_ascii and (not self._state._newline_flags & _FILE_NEWLINE_TRANSLATE or not has_cr):
                    data = Ptr[u8](sz)
                    bytes.memcpy(data, source, take)
                    self._state._read_offset += take
                    self._state._last_text_read_bytes = take
                    return str(data, _make_meta(take, 0))
        return self._read_large_text_slow(sz)

    def _read_large_text_slow(self, sz: int) -> str:
        result = str()
        pending_length = _file_text_pending_length(self._state)
        if pending_length > 0:
            if pending_length >= sz:
                return _file_take_text_pending(self._state, sz)
            result = _file_take_all_text_pending(self._state)

        while len(result) < sz:
            remaining = sz - len(result)
            value = self._read_text_chunk(
                _file_text_chunk_target(self._state, remaining)
            )
            if len(value) == 0:
                if self._state._last_text_read_bytes > 0:
                    continue
                break
            if len(value) > remaining:
                _file_set_text_pending(self._state, value, remaining)
                prefix = value[:remaining]
                return prefix if len(result) == 0 else result + prefix
            result = value if len(result) == 0 else result + value

        return result

    def _read_raw_into(self, output: Ptr[u8], length: int) -> int:
        if length <= 0:
            return 0
        total = 0
        if self._state._pending >= 0:
            output[0] = u8(self._state._pending)
            self._state._pending = -1
            total = 1
        total += _file_take_read_buffer(
            self._state, output + total, length - total
        )
        if total < length:
            remaining = length - total
            if remaining <= _FILE_READ_BUFFER_SIZE // 2:
                if _file_fill_read_buffer(self._state) > 0:
                    total += _file_take_read_buffer(
                        self._state, output + total, remaining
                    )
            else:
                total += _C.fread(
                    output + total, 1, remaining, self._state._fp
                )
                self._errcheck("error in read")
        return total

    def _read_text_chunk(self, target: int) -> str:
        buffer = _FileBuffer(target + 4)
        length = self._read_raw_into(buffer._ptr, target)
        if length == 0:
            buffer.clear()
            self._state._last_text_read_bytes = 0
            return str()

        bom_length = 0
        if not self._state._bom_checked:
            bom_length = _file_check_initial_bom(
                self._state, buffer._ptr, length
            )
        while True:
            extra = _file_text_chunk_extra(
                self._state, buffer._ptr, length, bom_length
            )
            if extra <= 0:
                break
            buffer.reserve(length + extra)
            got = self._read_raw_into(buffer._ptr + length, extra)
            length += got
            if got < extra:
                break
        return _file_decode_owned_text_chunk(
            self._state, buffer, length, bom_length
        )

    def tell(self) -> int:
        self._ensure_open()
        _file_flush_stdio_write_buffer(self._state)
        ret = _C.ftell(self._state._fp)
        self._errcheck("error in tell")
        return (
            ret
            - self._state._read_length
            + self._state._read_offset
            - (1 if self._state._pending >= 0 else 0)
            - _file_text_pending_raw_length(self._state)
        )

    def seekable(self) -> bool:
        self._ensure_open()
        return _C.ftell(self._state._fp) >= 0

    def seek(self, offset: int, whence: int):
        self._ensure_open()
        _file_flush_stdio_write_buffer(self._state)
        if whence == 1:
            unread = self._state._read_length - self._state._read_offset
            if self._state._pending >= 0:
                unread += 1
            unread += _file_text_pending_raw_length(self._state)
            if unread > 0:
                if _C.fseek(self._state._fp, -unread, i32(1)) != 0:
                    raise IOError("file I/O error: error in seek")
        if _C.fseek(self._state._fp, offset, i32(whence)) != 0:
            raise IOError("file I/O error: error in seek")
        self._errcheck("error in seek")
        _file_discard_read_buffer(self._state)
        _file_reset_text_state(
            self._state, whence == 0 and offset == 0
        )

    def flush(self):
        self._ensure_open()
        _file_flush_stdio_write_buffer(self._state)
        if _C.fflush(self._state._fp) != 0:
            raise IOError("file I/O error: error in flush")

    def close(self):
        if self._state._fp:
            _file_flush_stdio_write_buffer(self._state)
            _C.fclose(self._state._fp)
            self._state._fp = cobj()
        if self._state._read_buf:
            free(self._state._read_buf)
            self._state._read_buf = Ptr[u8]()
        if self._state._write_buf:
            free(self._state._write_buf)
            self._state._write_buf = Ptr[u8]()
        self._state._write_length = 0
        _file_discard_read_buffer(self._state)
        _file_reset_text_state(self._state)

    def _ensure_open(self):
        if not self._state._fp:
            raise IOError("I/O operation on closed file")

    def _read_text_character(self) -> str:
        if _file_text_pending_length(self._state) > 0:
            character = _file_take_text_pending(self._state, 1)
            self._state._last_text_read_bytes = _file_text_raw_length(
                self._state, character
            )
            return character
        return self.read(1)

    def _iter_trim_newline(self) -> Generator[T]:
        self._ensure_open()
        while True:
            line = self.readline()
            if len(line) == 0:
                break
            if T is bytes:
                if line[len(line) - 1] == u8(10):
                    yield line[:-1]
                else:
                    yield line
            else:
                if line.endswith("\n"):
                    yield line[:-1]
                else:
                    yield line

def _gz_errcheck(stream: cobj):
    errnum = i32(0)
    msg = _C.gzerror(stream, __ptr__(errnum))
    if msg and msg[0]:
        raise IOError(f"zlib error: {str.from_ptr(msg)}")

@tuple
class gzFile[T]:
    _state: _FileState

    def __new__(fp: cobj, mode: str):
        return gzFile[T](_FileState(fp, mode_flags=_file_mode_flags(mode), backend=_FILE_BACKEND_GZIP))

    def __new__(
        path: str,
        mode: str,
        encoding: str = "utf-8",
        errors: str = "strict",
        newline: Optional[str] = None,
