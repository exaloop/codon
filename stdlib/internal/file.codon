        if not self._state._read_buf:
            self._state._read_buf = Ptr[u8](_FILE_READ_BUFFER_SIZE)
        while self._state._position < target:
            remaining = target - self._state._position
            request = min(remaining, _FILE_READ_BUFFER_SIZE)
            count = int(_C.BZ2_bzread(
                self._state._fp, self._state._read_buf, i32(request)
            ))
            _bz_errcheck(self._state._fp)
            self._state._position += count
            if count < request:
                break
        _file_discard_read_buffer(self._state)
        if target == 0:
            _file_reset_text_state(self._state, True)

    def flush(self):
        self._ensure_open()
        _C.BZ2_bzflush(self._state._fp)
        _bz_errcheck(self._state._fp)

    def _iter_trim_newline(self) -> Generator[T]:
        self._ensure_open()
        while True:
            line = self.readline()
            if len(line) == 0:
                break
            if T is bytes:
                if line.endswith(b"\n"):
                    yield line[:-1]
                else:
                    yield line
            else:
                if line.endswith("\n"):
                    yield line[:-1]
                else:
                    yield line

    def _ensure_open(self):
        if not self._state._fp:
            raise IOError("I/O operation on closed file")

    def _read_text_character(self) -> str:
        if _file_text_pending_length(self._state) > 0:
            character = _file_take_text_pending(self._state, 1)
            self._state._last_text_read_bytes = _file_text_raw_length(
                self._state, character
            )
            return character
        return self.read(1)

    def _read_byte(self) -> int:
        return _file_read_byte(self._state)


def _literal_mode_flags(mode: Literal[str]) -> Literal[int]:
    import internal.static as static

    if static.len(mode) == 0:
        return 0
    elif mode[0] == "r":
        return _FILE_MODE_READ | _literal_mode_flags(mode[1:])
    elif mode[0] == "w":
        return _FILE_MODE_WRITE | _literal_mode_flags(mode[1:])
    elif mode[0] == "a":
        return _FILE_MODE_WRITE | _FILE_MODE_APPEND | _literal_mode_flags(mode[1:])
    elif mode[0] == "x":
        return _FILE_MODE_WRITE | _FILE_MODE_EXCLUSIVE | _literal_mode_flags(mode[1:])
    elif mode[0] == "+":
        return _FILE_MODE_READ | _FILE_MODE_WRITE | _FILE_MODE_UPDATE | _literal_mode_flags(mode[1:])
    elif mode[0] == "b":
        return _FILE_MODE_BINARY | _literal_mode_flags(mode[1:])
    elif mode[0] == "t":
        return _FILE_MODE_TEXT | _literal_mode_flags(mode[1:])
    else:
        return _literal_mode_flags(mode[1:])

def _file_text_encoding(encoding: Optional[str]) -> str:
    return "utf-8" if encoding is None else encoding

def _file_text_errors(errors: Optional[str]) -> str:
    return "strict" if errors is None else errors

def open(
    path: str,
    mode: str = "r",
    encoding: Optional[str] = None,
    errors: Optional[str] = None,
    newline: Optional[str] = None,
) -> File[str]:
    return File[str](
        path,
        mode,
        _file_text_encoding(encoding),
        _file_text_errors(errors),
        newline,
    )

@overload
def open(
    path: str,
    mode: Literal[str],
    encoding: Optional[str] = None,
    errors: Optional[str] = None,
    newline: Optional[str] = None,
):
    mode_flags: Literal[int] = _literal_mode_flags(mode)
    binary: Literal[bool] = mode_flags & _FILE_MODE_BINARY != 0
    if binary:
        if encoding is not None or errors is not None or newline is not None:
            raise ValueError("binary mode does not take encoding, errors or newline")
        return File[bytes](path, mode)
    else:
        return File[str](
            path,
            mode,
            _file_text_encoding(encoding),
            _file_text_errors(errors),
            newline,
        )

def gzopen(
    path: str,
    mode: str = "rb",
    encoding: Optional[str] = None,
    errors: Optional[str] = None,
    newline: Optional[str] = None,
) -> gzFile[bytes]:
    if encoding is not None or errors is not None or newline is not None:
        raise ValueError("binary mode does not take encoding, errors or newline")
    return gzFile[bytes](path, mode)

@overload
def gzopen(
    path: str,
    mode: Literal[str],
    encoding: Optional[str] = None,
    errors: Optional[str] = None,
    newline: Optional[str] = None,
):
    mode_flags: Literal[int] = _literal_mode_flags(mode)
    binary: Literal[bool] = mode_flags & _FILE_MODE_BINARY != 0
    text: Literal[bool] = mode_flags & _FILE_MODE_TEXT != 0

    if binary and text:
        compile_error("can't have text and binary mode at once")

    if text:
        return gzFile[str](
            path,
            mode,
            _file_text_encoding(encoding),
            _file_text_errors(errors),
            newline,
        )

    # gzip.open() uses binary mode unless 't' is explicitly present.
    if encoding is not None or errors is not None or newline is not None:
        raise ValueError("binary mode does not take encoding, errors or newline")
    return gzFile[bytes](path, mode)

def bzopen(
    path: str,
    mode: str = "rb",
    encoding: Optional[str] = None,
    errors: Optional[str] = None,
    newline: Optional[str] = None,
) -> bzFile[bytes]:
    if encoding is not None or errors is not None or newline is not None:
        raise ValueError("binary mode does not take encoding, errors or newline")
    return bzFile[bytes](path, mode)

@overload
def bzopen(
    path: str,
    mode: Literal[str],
    encoding: Optional[str] = None,
    errors: Optional[str] = None,
    newline: Optional[str] = None,
):
    mode_flags: Literal[int] = _literal_mode_flags(mode)
    binary: Literal[bool] = mode_flags & _FILE_MODE_BINARY != 0
    text: Literal[bool] = mode_flags & _FILE_MODE_TEXT != 0

    if binary and text:
        compile_error("can't have text and binary mode at once")

    if text:
        return bzFile[str](
            path,
            mode,
            _file_text_encoding(encoding),
            _file_text_errors(errors),
            newline,
        )

    # bz2.open() uses binary mode unless 't' is explicitly present.
    if encoding is not None or errors is not None or newline is not None:
        raise ValueError("binary mode does not take encoding, errors or newline")
    return bzFile[bytes](path, mode)

def is_binary(path: str) -> bool:
    # https://stackoverflow.com/questions/898669/how-can-i-detect-if-a-file-is-binary-non-text-in-python/7392391#7392391
    # Can get both false positive and false negatives, but still is a
    # clever approach that works for the large majority of files
    with open(path, "rb") as f:
        header = f.read(1024)
        return any(
            c != 7
            and c != 8
            and c != 9
            and c != 10
            and c != 12
            and c != 13
            and c != 27
            and (c < 0x20 or c == 0x7F)
            for c in header
        )
