        raw_mode = _file_compressed_mode(mode_flags)
        fp = _C.gzopen(path.c_str(), raw_mode.c_str())
        if not fp:
            raise IOError(f"file {path} could not be opened")
        return gzFile[T](_FileState(fp, encoding, errors, newline, path, mode_flags, _FILE_BACKEND_GZIP))

    def _getline(self, buffer: _FileBuffer) -> int:
        length = 0
        while True:
            if self._state._pending >= 0:
                byte = self._read_byte()
                buffer.reserve(length + 1)
                buffer._ptr[length] = u8(byte)
                length += 1
                continue

            if self._state._read_offset == self._state._read_length:
                if not self._state._read_buf:
                    self._state._read_buf = Ptr[u8](_FILE_READ_BUFFER_SIZE)
                self._state._read_offset = 0
                self._state._read_length = int(_C.gzread(
                    self._state._fp,
                    self._state._read_buf,
                    u32(_FILE_READ_BUFFER_SIZE),
                ))
                _gz_errcheck(self._state._fp)
                if self._state._read_length == 0:
                    return -1 if length == 0 else length

            start = self._state._read_offset
            line_end, lookahead = _file_scan_line_buffer(
                self._state._read_buf,
                start,
                self._state._read_length,
                self._state._newline_flags,
                T is bytes,
            )
            copy_end = self._state._read_length if line_end < 0 else line_end
            count = copy_end - start
            buffer.reserve(length + count + 1)
            if count > 0:
                bytes.memcpy(
                    buffer._ptr + length,
                    self._state._read_buf + start,
                    count,
                )
                length += count
                self._state._read_offset = copy_end

            if line_end < 0:
                continue
            if not lookahead:
                return length

            following = self._read_byte()
            if self._state._newline_flags == _FILE_NEWLINE_CRLF:
                if following == 0x0A:
                    buffer._ptr[length] = u8(following)
                    return length + 1
                if following >= 0:
                    self._state._read_offset -= 1
                continue
            if following == 0x0A:
                buffer._ptr[length] = u8(following)
                length += 1
            elif following >= 0:
                self._state._read_offset -= 1
            return length

    def __iter__(self) -> Generator[T]:
        self._ensure_open()
        while True:
            line = self.readline()
            if len(line) == 0:
