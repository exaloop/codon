from internal.gc import realloc, free
from internal.str import _CodecByteBuffer, _encoding_matches, _unicode_encode_utf8_strict_append

def _file_bytes(data: Ptr[u8], length: int) -> bytes:
    result = _CodecByteBuffer(length)
    bytes.memcpy(result.data, data, length)
    result.length = length
    return result.finish()

def _file_buffer_reserve(buffer: _CodecByteBuffer, required: int):
    if required <= buffer.capacity:
        return

    capacity = buffer.capacity if buffer.capacity > 0 else 1
    while capacity < required:
        capacity *= 2

    expanded = Ptr[u8](capacity)
    str.memcpy(expanded, buffer.data, buffer.length)
    buffer.data = expanded
    buffer.capacity = capacity

def _file_read_all(fp: cobj) -> bytes:
    start = _C.ftell(fp)
    if start >= 0 and _C.fseek(fp, 0, i32(2)) == 0:
        end = _C.ftell(fp)
        if end >= start and _C.fseek(fp, start, i32(0)) == 0:
            result = _CodecByteBuffer(end - start)
            result.length = _C.fread(result.data, 1, end - start, fp)
            if _C.ferror(fp):
                raise IOError("file I/O error: error in read")
            return result.finish()

    chunk_size = 4096
    result = _CodecByteBuffer(chunk_size)
    while True:
        _file_buffer_reserve(result, result.length + chunk_size)
        length = _C.fread(result.data + result.length, 1, chunk_size, fp)
        result.length += length
        if length < chunk_size:
            break
    if _C.ferror(fp):
        raise IOError("file I/O error: error in read")
    return result.finish()

def _file_utf8_sequence_length(first: int) -> int:
    if first < 0x80:
        return 1
    if first >= 0xC2 and first <= 0xDF:
        return 2
    if first >= 0xE0 and first <= 0xEF:
        return 3
    if first >= 0xF0 and first <= 0xF4:
        return 4
    return 1

def _file_text_sequence_length(first: int, encoding: str) -> int:
    if _encoding_matches(encoding, "utf-16-le") or _encoding_matches(encoding, "utf16le") or _encoding_matches(encoding, "utf-16-be") or _encoding_matches(encoding, "utf16be"):
        return 2
    if _encoding_matches(encoding, "utf-32-le") or _encoding_matches(encoding, "utf32le") or _encoding_matches(encoding, "utf-32-be") or _encoding_matches(encoding, "utf32be"):
        return 4
    if _encoding_matches(encoding, "utf-16") or _encoding_matches(encoding, "utf16"):
        return 2
    if _encoding_matches(encoding, "utf-32") or _encoding_matches(encoding, "utf32"):
        return 4
    if _encoding_matches(encoding, "utf-8") or _encoding_matches(encoding, "utf8"):
        return _file_utf8_sequence_length(first)
    return 1

def _file_utf16_surrogate_pair(data: Ptr[u8], offset: int, encoding: str) -> bool:
    if not _encoding_matches(encoding, "utf-16-le") and not _encoding_matches(encoding, "utf16le") and not _encoding_matches(encoding, "utf-16-be") and not _encoding_matches(encoding, "utf16be"):
        return False
    if _encoding_matches(encoding, "utf-16-le") or _encoding_matches(encoding, "utf16le"):
        unit = int(data[offset]) | (int(data[offset + 1]) << 8)
    else:
        unit = (int(data[offset]) << 8) | int(data[offset + 1])
    return 0xD800 <= unit and unit <= 0xDBFF

def _file_bom_encoding(data: Ptr[u8], length: int, encoding: str) -> Tuple[str, int]:
    if (_encoding_matches(encoding, "utf-16") or _encoding_matches(encoding, "utf16")) and length >= 2:
        if data[0] == u8(0xFF) and data[1] == u8(0xFE):
            return ("utf-16-le", 2)
        if data[0] == u8(0xFE) and data[1] == u8(0xFF):
            return ("utf-16-be", 2)
    if (_encoding_matches(encoding, "utf-32") or _encoding_matches(encoding, "utf32")) and length >= 4:
        if data[0] == u8(0xFF) and data[1] == u8(0xFE) and data[2] == u8(0) and data[3] == u8(0):
            return ("utf-32-le", 4)
        if data[0] == u8(0) and data[1] == u8(0) and data[2] == u8(0xFE) and data[3] == u8(0xFF):
            return ("utf-32-be", 4)
    return (encoding, 0)

def _file_encoding_has_bom(encoding: str) -> bool:
    return (
        _encoding_matches(encoding, "utf-16")
        or _encoding_matches(encoding, "utf16")
        or _encoding_matches(encoding, "utf-32")
        or _encoding_matches(encoding, "utf32")
    )

def _file_encoding_is_multibyte(encoding: str) -> bool:
    return (
        _encoding_matches(encoding, "utf-16")
        or _encoding_matches(encoding, "utf16")
        or _encoding_matches(encoding, "utf-16-le")
        or _encoding_matches(encoding, "utf16le")
        or _encoding_matches(encoding, "utf-16-be")
        or _encoding_matches(encoding, "utf16be")
        or _encoding_matches(encoding, "utf-32")
        or _encoding_matches(encoding, "utf32")
        or _encoding_matches(encoding, "utf-32-le")
        or _encoding_matches(encoding, "utf32le")
        or _encoding_matches(encoding, "utf-32-be")
        or _encoding_matches(encoding, "utf32be")
    )

def _file_validate_newline(newline: Optional[str]):
    if (
        newline is not None
        and newline != ""
        and newline != "\n"
        and newline != "\r"
        and newline != "\r\n"
    ):
        raise ValueError("illegal newline value")

def _file_translate_read_newlines(value: str, newline: Optional[str]) -> str:
    if newline is None:
        return value.replace("\r\n", "\n").replace("\r", "\n")
    return value

def _file_translate_write_newlines(value: str, newline: Optional[str]) -> str:
    if newline == "\r" or newline == "\r\n":
        return value.replace("\n", newline)
    return value

def _file_readline_universal(fp: cobj) -> bytes:
    result = _CodecByteBuffer(128)
    while True:
        byte = _C.fgetc(fp)
        if byte < 0:
            break
        _file_buffer_reserve(result, result.length + 1)
        result.data[result.length] = u8(byte)
        result.length += 1
        if byte == 0x0A:
            break
        if byte == 0x0D:
            following = _C.fgetc(fp)
            if following == 0x0A:
                _file_buffer_reserve(result, result.length + 1)
                result.data[result.length] = u8(following)
                result.length += 1
            elif following >= 0:
                _C.ungetc(following, fp)
            break
    if _C.ferror(fp):
        raise IOError("file I/O error: error in read")
    return result.finish()

class _FileState:
    _fp: cobj
    _buf: Ptr[u8]
    _size: int
    _encoding: str
    _errors: str
    _newline: Optional[str]
    _pending: int
    _path: str
    _mode: str
    _position: int
    _text_pending: str
    _bom_checked: bool
    _skip_initial_lf: bool
    _raw_line_read: bool

    def __init__(
        self,
        fp: cobj,
        encoding: str = "utf-8",
        errors: str = "strict",
        newline: Optional[str] = None,
        path: str = "",
        mode: str = "",
    ):
        self._fp = fp
        self._buf = Ptr[u8]()
        self._size = 0
        self._encoding = encoding
        self._errors = errors
        self._newline = newline
        self._pending = -1
        self._path = path
        self._mode = mode
        self._position = 0
        self._text_pending = str()
        self._bom_checked = not _file_encoding_has_bom(encoding)
        self._skip_initial_lf = False
        self._raw_line_read = False

    def _reset_buffer(self):
        self._buf = Ptr[u8]()
        self._size = 0
        self._pending = -1
        self._skip_initial_lf = False
        self._raw_line_read = False
        self._text_pending = str()

@tuple
class File[T]:
    _state: _FileState

    def __new__(fp: cobj):
        return File[T](_FileState(fp))

    def __new__(
        path: str,
        mode: str,
        encoding: str = "utf-8",
        errors: str = "strict",
        newline: Optional[str] = None,
    ):
        fp = _C.fopen(path.c_str(), mode.c_str())
        if not fp:
            raise IOError(f"file {path} could not be opened")
        _file_validate_newline(newline)
        return File[T](_FileState(fp, encoding, errors, newline, path, mode))

    def __new__(fd: int, mode: str):
        fp = _C.fdopen(fd, mode.c_str())
        if not fp:
            raise IOError(f"file descriptor {fd} could not be opened")
        return File[T](_FileState(fp, path="", mode=mode))

    def _errcheck(self, msg: str):
        err = int(_C.ferror(self._state._fp))
        if err:
            raise IOError(f"file I/O error: {msg}")

    def __enter__(self):
        pass

    def __exit__(self):
        self.close()

    def __iter__(self) -> Generator[T]:
        for a in self._iter():
            if T is bytes:
                yield a.__ptrcopy__()
            else:
                yield a

    def readlines(self) -> List[T]:
        return [l for l in self]

    def readline(self) -> T:
        self._ensure_open()
        if T is str and _file_encoding_is_multibyte(self._state._encoding):
            line = _CodecByteBuffer(128)
            self._state._raw_line_read = True
            while True:
                character = self._read_text_character()
                if len(character) == 0:
                    break
                if self._state._skip_initial_lf:
                    self._state._skip_initial_lf = False
                    if character == "\n":
                        continue
                _unicode_encode_utf8_strict_append(character, line)
                if character == "\n" and (self._state._newline is None or self._state._newline == "" or self._state._newline == "\n"):
                    break
                if character == "\r" and self._state._newline is None:
                    self._state._skip_initial_lf = True
                    break
                if character == "\r" and (self._state._newline is None or self._state._newline == "" or self._state._newline == "\r" or self._state._newline == "\r\n"):
                    following = self._read_text_character()
                    if self._state._newline == "\r\n" and following == "\n":
                        _unicode_encode_utf8_strict_append(following, line)
                    elif self._state._newline == "" and following == "\n":
                        _unicode_encode_utf8_strict_append(following, line)
                    elif len(following) > 0:
                        self._state._text_pending = following
                    if self._state._newline == "\r\n" and following != "\n":
                        continue
                    break
            self._state._raw_line_read = False
            return _file_translate_read_newlines(line.finish().decode(), self._state._newline)
        if T is str and self._state._newline is None:
            data = _file_readline_universal(self._state._fp)
            return _file_translate_read_newlines(
                data.decode(self._state._encoding, self._state._errors), self._state._newline
            )
        data = _file_readline_universal(self._state._fp)
        if T is bytes:
            return data.__ptrcopy__()
        return data.decode(self._state._encoding, self._state._errors)

    def write(self, s: T) -> int:
        self._ensure_open()
        if T is bytes:
            _C.fwrite(s._ptr, 1, len(s), self._state._fp)
        else:
            data = _file_translate_write_newlines(s, self._state._newline).encode(
                self._state._encoding, self._state._errors
            )
            _C.fwrite(data._ptr, 1, len(data), self._state._fp)
        self._errcheck("error in write")
        return len(s)

    def __file_write_gen__(self, g: Generator[T], T: type):
        for s in g:
            self.write(s)

    def read(self) -> T:
        return self.read(-1)

    def read(self, sz: int) -> T:
        self._ensure_open()
        if T is bytes:
            if sz < 0:
                return _file_read_all(self._state._fp)
            result = _CodecByteBuffer(sz)
            result.length = _C.fread(result.data, 1, sz, self._state._fp)
            self._errcheck("error in read")
            return result.finish()
        if sz < 0:
            prefix = self._state._text_pending
            self._state._text_pending = str()
            value = _file_translate_read_newlines(
                _file_read_all(self._state._fp).decode(self._state._encoding, self._state._errors), self._state._newline
            )
            return prefix + value
        result = _CodecByteBuffer(sz)
        bom_length = 0
        for _ in range(sz):
            _file_buffer_reserve(result, result.length + 1)
            length = _C.fread(result.data + result.length, 1, 1, self._state._fp)
            if length == 0:
                break
            width = _file_text_sequence_length(
                int(result.data[result.length]), self._state._encoding
            )
            if not self._state._bom_checked:
                width *= 2
            result.length += length
            if width > 1:
                _file_buffer_reserve(result, result.length + width - 1)
                result.length += _C.fread(
                    result.data + result.length, 1, width - 1, self._state._fp
                )
            if not self._state._bom_checked:
                self._state._encoding, bom_length = _file_bom_encoding(
                    result.data, result.length, self._state._encoding
                )
                self._state._bom_checked = True
            if width == 2 and _file_utf16_surrogate_pair(
                result.data, result.length - 2, self._state._encoding
            ):
                _file_buffer_reserve(result, result.length + 2)
                result.length += _C.fread(result.data + result.length, 1, 2, self._state._fp)
        self._errcheck("error in read")
        value = _file_bytes(result.data + bom_length, result.length - bom_length).decode(
            self._state._encoding, self._state._errors
        )
        if self._state._newline is None and not _file_encoding_is_multibyte(self._state._encoding) and value.endswith("\r"):
            following = _C.fgetc(self._state._fp)
            if following >= 0 and following != 0x0A:
                _C.ungetc(following, self._state._fp)
        if _file_encoding_is_multibyte(self._state._encoding):
            if self._state._raw_line_read:
                return value
            if self._state._newline is None:
                if self._state._skip_initial_lf:
                    self._state._skip_initial_lf = False
                    if value == "\n":
                        return self.read(sz)
                    if value.startswith("\n"):
                        value = value[1:]
                if value.endswith("\r"):
                    self._state._skip_initial_lf = True
                return _file_translate_read_newlines(value, self._state._newline)
            return value
        return _file_translate_read_newlines(value, self._state._newline)

    def tell(self) -> int:
        self._ensure_open()
        ret = _C.ftell(self._state._fp)
        self._errcheck("error in tell")
        return ret

    def seekable(self) -> bool:
        self._ensure_open()
        return _C.ftell(self._state._fp) >= 0

    def seek(self, offset: int, whence: int):
        self._ensure_open()
        _C.fseek(self._state._fp, offset, i32(whence))
        self._errcheck("error in seek")
        self._state._text_pending = str()
        self._state._skip_initial_lf = False
        self._state._raw_line_read = False

    def flush(self):
        self._ensure_open()
        if _C.fflush(self._state._fp) != 0:
            raise IOError("file I/O error: error in flush")

    def close(self):
        if self._state._fp:
            _C.fclose(self._state._fp)
            self._state._fp = cobj()
        if self._state._buf:
            _C.free(self._state._buf)
            self._state._reset_buffer()

    def _ensure_open(self):
        if not self._state._fp:
            raise IOError("I/O operation on closed file")

    def _read_text_character(self) -> str:
        if len(self._state._text_pending) > 0:
            character = self._state._text_pending
            self._state._text_pending = str()
            return character
        return self.read(1)

    def _iter(self) -> Generator[T]:
        self._ensure_open()
        while True:
            line = self.readline()
            if len(line) == 0:
                break
            yield line

    def _iter_trim_newline(self) -> Generator[T]:
        self._ensure_open()
        while True:
            line = self.readline()
            if len(line) == 0:
                break
            if T is bytes:
                if line[len(line) - 1] == u8(10):
                    yield line[:-1]
                else:
                    yield line
            else:
                if line.endswith("\n"):
                    yield line[:-1]
                else:
                    yield line

def _gz_errcheck(stream: cobj):
    errnum = i32(0)
    msg = _C.gzerror(stream, __ptr__(errnum))
    if msg and msg[0]:
        raise IOError(f"zlib error: {bytes.from_ptr(msg).decode()}")

@tuple
class gzFile[T]:
    _state: _FileState

    def __new__(fp: cobj):
        return gzFile[T](_FileState(fp))

    def __new__(
        path: str,
        mode: str,
        encoding: str = "utf-8",
        errors: str = "strict",
        newline: Optional[str] = None,
    ):
        fp = _C.gzopen(path.c_str(), mode.c_str())
        if not fp:
            raise IOError(f"file {path} could not be opened")
        _file_validate_newline(newline)
        return gzFile[T](_FileState(fp, encoding, errors, newline, path, mode))

    def _getline(self) -> int:
        if not self._state._buf:
            self._state._size = 128
            self._state._buf = Ptr[u8](self._state._size)

        offset = 0
        while True:
            if offset == self._state._size:
                oldsz = self._state._size
                self._state._size *= 2
                self._state._buf = realloc(self._state._buf, self._state._size, oldsz)

            byte = self._read_byte()
            if byte < 0:
                if offset == 0:
                    return -1
                break

            self._state._buf[offset] = u8(byte)
            offset += 1
            if byte == 0x0A:
                break
            if T is str and self._state._newline is None and byte == 0x0D:
                following = self._read_byte()
                if following == 0x0A:
                    if offset == self._state._size:
                        oldsz = self._state._size
                        self._state._size *= 2
                        self._state._buf = realloc(self._state._buf, self._state._size, oldsz)
                    self._state._buf[offset] = u8(following)
                    offset += 1
                elif following >= 0:
                    self._state._pending = following
                break

        return offset

    def __iter__(self) -> Generator[T]:
        for a in self._iter():
            if T is bytes:
                yield a.__ptrcopy__()
            else:
                yield a

    def __enter__(self):
        pass

    def __exit__(self):
        self.close()

    def close(self):
        if self._state._fp:
            _C.gzclose(self._state._fp)
            self._state._fp = cobj()
        if self._state._buf:
            free(self._state._buf)
            self._state._reset_buffer()

    def readlines(self) -> List[T]:
        return [l for l in self]

    def readline(self) -> T:
        self._ensure_open()
        if T is str and _file_encoding_is_multibyte(self._state._encoding):
            self._state._raw_line_read = True
            line = _CodecByteBuffer(128)
            while True:
                character = self._read_text_character()
                if len(character) == 0:
                    break
                if self._state._skip_initial_lf:
                    self._state._skip_initial_lf = False
                    if character == "\n":
                        continue
                _unicode_encode_utf8_strict_append(character, line)
                if character == "\n" and (self._state._newline is None or self._state._newline == "" or self._state._newline == "\n"):
                    break
                if character == "\r" and self._state._newline is None:
                    self._state._skip_initial_lf = True
                    break
                if character == "\r" and (self._state._newline is None or self._state._newline == "" or self._state._newline == "\r" or self._state._newline == "\r\n"):
                    following = self._read_text_character()
                    if self._state._newline == "\r\n" and following == "\n":
                        _unicode_encode_utf8_strict_append(following, line)
                    elif self._state._newline == "" and following == "\n":
                        _unicode_encode_utf8_strict_append(following, line)
                    elif len(following) > 0:
                        self._state._text_pending = following
                    if self._state._newline == "\r\n" and following != "\n":
                        continue
                    break
            self._state._raw_line_read = False
            return _file_translate_read_newlines(line.finish().decode(), self._state._newline)
        length = self._getline()
        if length == -1:
            if T is bytes:
                return bytes()
            return str()
        data = bytes(self._state._buf, length)
        if T is bytes:
            return data.__ptrcopy__()
        return _file_translate_read_newlines(
            data.decode(self._state._encoding, self._state._errors), self._state._newline
        )

    def write(self, s: T) -> int:
        self._ensure_open()
        if T is bytes:
            _C.gzwrite(self._state._fp, s._ptr, u32(len(s)))
        else:
            data = _file_translate_write_newlines(s, self._state._newline).encode(
                self._state._encoding, self._state._errors
            )
            _C.gzwrite(self._state._fp, data._ptr, u32(len(data)))
        _gz_errcheck(self._state._fp)
        return len(s)

    def __file_write_gen__(self, g: Generator[T], T: type):
        for s in g:
            self.write(s)

    def read(self) -> T:
        return self.read(-1)

    def read(self, sz: int) -> T:
        self._ensure_open()
        if sz < 0:
            chunk_size = 4096
            result = _CodecByteBuffer(chunk_size)
            prefix = self._state._text_pending
            self._state._text_pending = str()
            if self._state._pending >= 0:
                result.append(self._read_byte())
            while True:
                _file_buffer_reserve(result, result.length + chunk_size)
                length = int(_C.gzread(
                    self._state._fp, result.data + result.length, u32(chunk_size)
                ))
                _gz_errcheck(self._state._fp)
                result.length += length
                if length < chunk_size:
                    break
            if T is bytes:
                return result.finish()
            else:
                value = _file_translate_read_newlines(
                    result.finish().decode(self._state._encoding, self._state._errors), self._state._newline
                )
                return prefix + value
        if T is bytes:
            buf = Ptr[u8](sz)
            ret = _C.gzread(self._state._fp, buf, u32(sz))
            _gz_errcheck(self._state._fp)
            return _file_bytes(buf, int(ret))
        else:
            result = _CodecByteBuffer(sz)
            bom_length = 0
            for _ in range(sz):
                _file_buffer_reserve(result, result.length + 1)
                byte = self._read_byte()
                if byte < 0:
                    break
                result.data[result.length] = u8(byte)
                length = 1
                width = _file_text_sequence_length(
                    int(result.data[result.length]), self._state._encoding
                )
                if not self._state._bom_checked:
                    width *= 2
                result.length += length
                if width > 1:
                    _file_buffer_reserve(result, result.length + width - 1)
                    for _ in range(width - 1):
                        byte = self._read_byte()
                        if byte < 0:
                            break
                        result.data[result.length] = u8(byte)
                        result.length += 1
                if not self._state._bom_checked:
                    self._state._encoding, bom_length = _file_bom_encoding(
                        result.data, result.length, self._state._encoding
                    )
                    self._state._bom_checked = True
                if width == 2 and _file_utf16_surrogate_pair(
                    result.data, result.length - 2, self._state._encoding
                ):
                    _file_buffer_reserve(result, result.length + 2)
                    for _ in range(2):
                        byte = self._read_byte()
                        if byte < 0:
                            break
                        result.data[result.length] = u8(byte)
                        result.length += 1
            value = _file_bytes(result.data + bom_length, result.length - bom_length).decode(
                self._state._encoding, self._state._errors
            )
            if self._state._newline is None and not _file_encoding_is_multibyte(self._state._encoding) and value.endswith("\r"):
                following = self._read_byte()
                if following >= 0 and following != 0x0A:
                    self._state._pending = following
            if _file_encoding_is_multibyte(self._state._encoding):
                if self._state._raw_line_read:
                    return value
                if self._state._newline is None:
                    if self._state._skip_initial_lf:
                        self._state._skip_initial_lf = False
                        if value == "\n":
                            return self.read(sz)
                        if value.startswith("\n"):
                            value = value[1:]
                    if value.endswith("\r"):
                        self._state._skip_initial_lf = True
                    return _file_translate_read_newlines(value, self._state._newline)
                return value
            return _file_translate_read_newlines(value, self._state._newline)

    def tell(self) -> int:
        self._ensure_open()
        ret = _C.gztell(self._state._fp)
        _gz_errcheck(self._state._fp)
        return ret

    def seek(self, offset: int, whence: int):
        self._ensure_open()
        _C.gzseek(self._state._fp, offset, i32(whence))
        _gz_errcheck(self._state._fp)
        self._state._pending = -1
        self._state._text_pending = str()
        self._state._skip_initial_lf = False
        self._state._raw_line_read = False

    def flush(self):
        Z_FINISH = 4
        self._ensure_open()
        _C.gzflush(self._state._fp, i32(Z_FINISH))
        _gz_errcheck(self._state._fp)

    def _iter(self) -> Generator[T]:
        self._ensure_open()
        while True:
            line = self.readline()
            if len(line) == 0:
                break
            yield line

    def _iter_trim_newline(self) -> Generator[T]:
        self._ensure_open()
        while True:
            rd = self._getline()
            if rd != -1:
                if self._state._buf[rd - 1] == u8(10):
                    rd -= 1
                data = bytes(self._state._buf, rd)
                if T is bytes:
                    yield data
                else:
                    yield _file_translate_read_newlines(
                        data.decode(self._state._encoding, self._state._errors), self._state._newline
                    )
            else:
                break

    def _ensure_open(self):
        if not self._state._fp:
            raise IOError("I/O operation on closed file")

    def _read_text_character(self) -> str:
        if len(self._state._text_pending) > 0:
            character = self._state._text_pending
            self._state._text_pending = str()
            return character
        return self.read(1)

    def _read_byte(self) -> int:
        if self._state._pending >= 0:
            byte = self._state._pending
            self._state._pending = -1
            return byte
        byte = u8(0)
        length = int(_C.gzread(self._state._fp, __ptr__(byte), u32(1)))
        _gz_errcheck(self._state._fp)
        if length == 0:
            return -1
        return int(byte)

def _bz_errcheck(stream: cobj):
    errnum = i32(0)
    msg = _C.BZ2_bzerror(stream, __ptr__(errnum))
    if errnum < i32(0):
        raise IOError(f"bzip2 error: {bytes.from_ptr(msg).decode()}")

@tuple
class bzFile[T]:
    _state: _FileState

    def __new__(fp: cobj):
        return bzFile[T](_FileState(fp))

    def __new__(
        path: str,
        mode: str,
        encoding: str = "utf-8",
        errors: str = "strict",
        newline: Optional[str] = None,
    ):
        fp = _C.BZ2_bzopen(path.c_str(), mode.c_str())
        if not fp:
            raise IOError(f"file {path} could not be opened")
        _file_validate_newline(newline)
        return bzFile[T](_FileState(fp, encoding, errors, newline, path, mode))

    def _getline(self) -> int:
        if not self._state._buf:
            self._state._size = 128
            self._state._buf = Ptr[u8](self._state._size)

        offset = 0
        while True:
            if offset == self._state._size:
                oldsz = self._state._size
                self._state._size *= 2
                self._state._buf = realloc(self._state._buf, self._state._size, oldsz)

            byte = self._read_byte()
            if byte < 0:
                if offset == 0:
                    return -1
                break
            self._state._buf[offset] = u8(byte)
            offset += 1
            if byte == 0x0A:
                break
            if T is str and self._state._newline is None and byte == 0x0D:
                following = self._read_byte()
                if following == 0x0A:
                    if offset == self._state._size:
                        oldsz = self._state._size
                        self._state._size *= 2
                        self._state._buf = realloc(self._state._buf, self._state._size, oldsz)
                    self._state._buf[offset] = u8(following)
                    offset += 1
                elif following >= 0:
                    self._state._pending = following
                    self._state._position -= 1
                break

        return offset

    def __iter__(self) -> Generator[T]:
        for a in self._iter():
            if T is bytes:
                yield a.__ptrcopy__()
            else:
                yield a

    def __enter__(self):
        pass

    def __exit__(self):
        self.close()

    def close(self):
        if self._state._fp:
            _C.BZ2_bzclose(self._state._fp)
            self._state._fp = cobj()
        if self._state._buf:
            free(self._state._buf)
            self._state._reset_buffer()

    def readlines(self) -> List[T]:
        return [l for l in self]

    def readline(self) -> T:
        self._ensure_open()
        if T is str and _file_encoding_is_multibyte(self._state._encoding):
            self._state._raw_line_read = True
            line = _CodecByteBuffer(128)
            while True:
                character = self._read_text_character()
                if len(character) == 0:
                    break
                if self._state._skip_initial_lf:
                    self._state._skip_initial_lf = False
                    if character == "\n":
                        continue
                _unicode_encode_utf8_strict_append(character, line)
                if character == "\n" and (self._state._newline is None or self._state._newline == "" or self._state._newline == "\n"):
                    break
                if character == "\r" and self._state._newline is None:
                    self._state._skip_initial_lf = True
                    break
                if character == "\r" and (self._state._newline is None or self._state._newline == "" or self._state._newline == "\r" or self._state._newline == "\r\n"):
                    following = self._read_text_character()
                    if self._state._newline == "\r\n" and following == "\n":
                        _unicode_encode_utf8_strict_append(following, line)
                    elif self._state._newline == "" and following == "\n":
                        _unicode_encode_utf8_strict_append(following, line)
                    elif len(following) > 0:
                        self._state._text_pending = following
                    if self._state._newline == "\r\n" and following != "\n":
                        continue
                    break
            self._state._raw_line_read = False
            return _file_translate_read_newlines(line.finish().decode(), self._state._newline)
        length = self._getline()
        if length == -1:
            if T is bytes:
                return bytes()
            return str()
        data = bytes(self._state._buf, length)
        if T is bytes:
            return data.__ptrcopy__()
        return _file_translate_read_newlines(
            data.decode(self._state._encoding, self._state._errors), self._state._newline
        )

    def write(self, s: T) -> int:
        self._ensure_open()
        if T is bytes:
            _C.BZ2_bzwrite(self._state._fp, s._ptr, i32(len(s)))
            self._state._position += len(s)
        else:
            data = _file_translate_write_newlines(s, self._state._newline).encode(
                self._state._encoding, self._state._errors
            )
            _C.BZ2_bzwrite(self._state._fp, data._ptr, i32(len(data)))
            self._state._position += len(data)
        _bz_errcheck(self._state._fp)
        return len(s)

    def __file_write_gen__(self, g: Generator[T], T: type):
        for s in g:
            self.write(s)

    def read(self) -> T:
        return self.read(-1)

    def read(self, sz: int) -> T:
        self._ensure_open()
        if sz < 0:
            chunk_size = 4096
            result = _CodecByteBuffer(chunk_size)
            prefix = self._state._text_pending
            self._state._text_pending = str()
            if self._state._pending >= 0:
                result.append(self._read_byte())
            while True:
                _file_buffer_reserve(result, result.length + chunk_size)
                length = int(_C.BZ2_bzread(
                    self._state._fp, result.data + result.length, i32(chunk_size)
                ))
                _bz_errcheck(self._state._fp)
                result.length += length
                self._state._position += length
                if length < chunk_size:
                    break
            if T is bytes:
                return result.finish()
            else:
                value = _file_translate_read_newlines(
                    result.finish().decode(self._state._encoding, self._state._errors), self._state._newline
                )
                return prefix + value
        if T is bytes:
            buf = Ptr[u8](sz)
            ret = _C.BZ2_bzread(self._state._fp, buf, i32(sz))
            _bz_errcheck(self._state._fp)
            self._state._position += int(ret)
            return _file_bytes(buf, int(ret))
        else:
            result = _CodecByteBuffer(sz)
            bom_length = 0
            for _ in range(sz):
                _file_buffer_reserve(result, result.length + 1)
                byte = self._read_byte()
                if byte < 0:
                    break
                result.data[result.length] = u8(byte)
                length = 1
                width = _file_text_sequence_length(
                    int(result.data[result.length]), self._state._encoding
                )
                if not self._state._bom_checked:
                    width *= 2
                result.length += length
                if width > 1:
                    _file_buffer_reserve(result, result.length + width - 1)
                    for _ in range(width - 1):
                        byte = self._read_byte()
                        if byte < 0:
                            break
                        result.data[result.length] = u8(byte)
                        result.length += 1
                if not self._state._bom_checked:
                    self._state._encoding, bom_length = _file_bom_encoding(
                        result.data, result.length, self._state._encoding
                    )
                    self._state._bom_checked = True
                if width == 2 and _file_utf16_surrogate_pair(
                    result.data, result.length - 2, self._state._encoding
                ):
                    _file_buffer_reserve(result, result.length + 2)
                    for _ in range(2):
                        byte = self._read_byte()
                        if byte < 0:
                            break
                        result.data[result.length] = u8(byte)
                        result.length += 1
            value = _file_bytes(result.data + bom_length, result.length - bom_length).decode(
                self._state._encoding, self._state._errors
            )
            if self._state._newline is None and not _file_encoding_is_multibyte(self._state._encoding) and value.endswith("\r"):
                following = self._read_byte()
                if following >= 0 and following != 0x0A:
                    self._state._pending = following
                    self._state._position -= 1
            if _file_encoding_is_multibyte(self._state._encoding):
                if self._state._raw_line_read:
                    return value
                if self._state._newline is None:
                    if self._state._skip_initial_lf:
                        self._state._skip_initial_lf = False
                        if value == "\n":
                            return self.read(sz)
                        if value.startswith("\n"):
                            value = value[1:]
                    if value.endswith("\r"):
                        self._state._skip_initial_lf = True
                    return _file_translate_read_newlines(value, self._state._newline)
                return value
            return _file_translate_read_newlines(value, self._state._newline)

    def tell(self) -> int:
        self._ensure_open()
        return self._state._position

    def seekable(self) -> bool:
        self._ensure_open()
        return "r" in self._state._mode

    def seek(self, offset: int, whence: int):
        self._ensure_open()
        self._state._pending = -1
        self._state._text_pending = str()
        self._state._skip_initial_lf = False
        self._state._raw_line_read = False
        if "r" not in self._state._mode:
            raise IOError("file is not open for reading")
        if whence == 0:
            target = offset
        elif whence == 1:
            target = self._state._position + offset
        elif whence == 2:
            while self._read_byte() >= 0:
                pass
            target = self._state._position + offset
        else:
            raise ValueError("unsupported seek whence")
        if target < 0:
            raise ValueError("negative seek position")
        if target < self._state._position:
            _C.BZ2_bzclose(self._state._fp)
            self._state._fp = _C.BZ2_bzopen(self._state._path.c_str(), self._state._mode.c_str())
            if not self._state._fp:
                raise IOError(f"file {self._state._path} could not be opened")
            self._state._position = 0
            self._state._pending = -1
        while self._state._position < target:
            if self._read_byte() < 0:
                break

    def flush(self):
        self._ensure_open()
        _C.BZ2_bzflush(self._state._fp)
        _bz_errcheck(self._state._fp)

    def _iter(self) -> Generator[T]:
        self._ensure_open()
        while True:
            line = self.readline()
            if len(line) == 0:
                break
            yield line

    def _iter_trim_newline(self) -> Generator[T]:
        self._ensure_open()
        while True:
            rd = self._getline()
            if rd != -1:
                if self._state._buf[rd - 1] == u8(10):
                    rd -= 1
                data = bytes(self._state._buf, rd)
                if T is bytes:
                    yield data
                else:
                    yield _file_translate_read_newlines(
                        data.decode(self._state._encoding, self._state._errors), self._state._newline
                    )
            else:
                break

    def _ensure_open(self):
        if not self._state._fp:
            raise IOError("I/O operation on closed file")

    def _read_text_character(self) -> str:
        if len(self._state._text_pending) > 0:
            character = self._state._text_pending
            self._state._text_pending = str()
            return character
        return self.read(1)

    def _read_byte(self) -> int:
        if self._state._pending >= 0:
            byte = self._state._pending
            self._state._pending = -1
            self._state._position += 1
            return byte
        byte = u8(0)
        length = int(_C.BZ2_bzread(self._state._fp, __ptr__(byte), i32(1)))
        _bz_errcheck(self._state._fp)
        if length == 0:
            return -1
        self._state._position += 1
        return int(byte)

    def _gets(self, buf: cobj, sz: int):
        if sz <= 0:
            return 0

        fp = self._state._fp
        b = u8(0)
        i = 0

        while i < sz - 1:
            status = _C.BZ2_bzread(fp, __ptr__(b), i32(1))
            if status == i32(0):
                break
            elif status < i32(0):
                return -1

            buf[i] = b
            i += 1
            if b == u8(10):
                break

        return i

def _literal_contains(needle: Literal[str], haystack: Literal[str]) -> Literal[bool]:
    import internal.static as static

    if static.len(needle) > static.len(haystack):
        return False
    elif haystack[0:static.len(needle)] == needle:
        return True
    else:
        return _literal_contains(needle, haystack[1:])

def open(
    path: str,
    mode: str = "r",
    encoding: str = "utf-8",
    errors: str = "strict",
    newline: Optional[str] = None,
) -> File[str]:
    return File[str](path, mode, encoding, errors, newline)

@overload
def open(
    path: str,
    mode: Literal[str],
    encoding: str = "utf-8",
    errors: str = "strict",
    newline: Optional[str] = None,
):
    if _literal_contains("b", mode):
        if encoding != "utf-8" or errors != "strict" or newline is not None:
            raise ValueError("binary mode does not take encoding, errors or newline")
        return File[bytes](path, mode)
    else:
        return File[str](path, mode, encoding, errors, newline)

def gzopen(
    path: str,
    mode: str = "r",
    encoding: str = "utf-8",
    errors: str = "strict",
    newline: Optional[str] = None,
) -> gzFile[str]:
    return gzFile[str](path, mode, encoding, errors, newline)

@overload
def gzopen(
    path: str,
    mode: Literal[str],
    encoding: str = "utf-8",
    errors: str = "strict",
    newline: Optional[str] = None,
):
    if _literal_contains("b", mode):
        if encoding != "utf-8" or errors != "strict" or newline is not None:
            raise ValueError("binary mode does not take encoding, errors or newline")
        return gzFile[bytes](path, mode)
    else:
        return gzFile[str](path, mode, encoding, errors, newline)

def bzopen(
    path: str,
    mode: str = "r",
    encoding: str = "utf-8",
    errors: str = "strict",
    newline: Optional[str] = None,
) -> bzFile[str]:
    return bzFile[str](path, mode, encoding, errors, newline)

@overload
def bzopen(
    path: str,
    mode: Literal[str],
    encoding: str = "utf-8",
    errors: str = "strict",
    newline: Optional[str] = None,
):
    if _literal_contains("b", mode):
        if encoding != "utf-8" or errors != "strict" or newline is not None:
            raise ValueError("binary mode does not take encoding, errors or newline")
        return bzFile[bytes](path, mode)
    else:
        return bzFile[str](path, mode, encoding, errors, newline)

def is_binary(path: str) -> bool:
    # https://stackoverflow.com/questions/898669/how-can-i-detect-if-a-file-is-binary-non-text-in-python/7392391#7392391
    # Can get both false positive and false negatives, but still is a
    # clever approach that works for the large majority of files
    with open(path, "rb") as f:
        header = f.read(1024)
        return any(
            c != 7
            and c != 8
            and c != 9
            and c != 10
            and c != 12
            and c != 13
            and c != 27
            and (c < 0x20 or c == 0x7F)
            for c in header
        )
