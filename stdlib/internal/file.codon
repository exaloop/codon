from internal.gc import realloc, free
from internal.str import _CodecByteBuffer

def _file_bytes(data: Ptr[u8], length: int) -> bytes:
    result = _CodecByteBuffer(length)
    bytes.memcpy(result.data, data, length)
    result.length = length
    return result.finish()

def _file_buffer_reserve(buffer: _CodecByteBuffer, required: int):
    if required <= buffer.capacity:
        return

    capacity = buffer.capacity if buffer.capacity > 0 else 1
    while capacity < required:
        capacity *= 2

    expanded = Ptr[u8](capacity)
    str.memcpy(expanded, buffer.data, buffer.length)
    buffer.data = expanded
    buffer.capacity = capacity

def _file_read_all(fp: cobj) -> bytes:
    start = _C.ftell(fp)
    if start >= 0 and _C.fseek(fp, 0, i32(2)) == 0:
        end = _C.ftell(fp)
        if end >= start and _C.fseek(fp, start, i32(0)) == 0:
            result = _CodecByteBuffer(end - start)
            result.length = _C.fread(result.data, 1, end - start, fp)
            if _C.ferror(fp):
                raise IOError("file I/O error: error in read")
            return result.finish()

    chunk_size = 4096
    result = _CodecByteBuffer(chunk_size)
    while True:
        _file_buffer_reserve(result, result.length + chunk_size)
        length = _C.fread(result.data + result.length, 1, chunk_size, fp)
        result.length += length
        if length < chunk_size:
            break
    if _C.ferror(fp):
        raise IOError("file I/O error: error in read")
    return result.finish()

def _file_utf8_sequence_length(first: int) -> int:
    if first < 0x80:
        return 1
    if first >= 0xC2 and first <= 0xDF:
        return 2
    if first >= 0xE0 and first <= 0xEF:
        return 3
    if first >= 0xF0 and first <= 0xF4:
        return 4
    return 1

def _file_validate_newline(newline: Optional[str]):
    if (
        newline is not None
        and newline != ""
        and newline != "\n"
        and newline != "\r"
        and newline != "\r\n"
    ):
        raise ValueError("illegal newline value")

def _file_translate_read_newlines(value: str, newline: Optional[str]) -> str:
    if newline is None:
        return value.replace("\r\n", "\n").replace("\r", "\n")
    return value

def _file_translate_write_newlines(value: str, newline: Optional[str]) -> str:
    if newline == "\r" or newline == "\r\n":
        return value.replace("\n", newline)
    return value

def _file_readline_universal(fp: cobj) -> bytes:
    result = _CodecByteBuffer(128)
    while True:
        byte = _C.fgetc(fp)
        if byte < 0:
            break
        _file_buffer_reserve(result, result.length + 1)
        result.data[result.length] = u8(byte)
        result.length += 1
        if byte == 0x0A:
            break
        if byte == 0x0D:
            following = _C.fgetc(fp)
            if following == 0x0A:
                _file_buffer_reserve(result, result.length + 1)
                result.data[result.length] = u8(following)
                result.length += 1
            elif following >= 0:
                _C.ungetc(following, fp)
            break
    if _C.ferror(fp):
        raise IOError("file I/O error: error in read")
    return result.finish()

class File[T]:
    sz: int
    buf: Ptr[u8]
    fp: cobj
    encoding: str
    errors: str
    newline: Optional[str]

    def __init__(self, fp: cobj):
        self.fp = fp
        self.encoding = "utf-8"
        self.errors = "strict"
        self.newline = None
        self._reset()

    def __init__(
        self,
        path: str,
        mode: str,
        encoding: str = "utf-8",
        errors: str = "strict",
        newline: Optional[str] = None,
    ):
        self.fp = _C.fopen(path.c_str(), mode.c_str())
        if not self.fp:
            raise IOError(f"file {path} could not be opened")
        _file_validate_newline(newline)
        self.encoding = encoding
        self.errors = errors
        self.newline = newline
        self._reset()

    def __init__(self, fd: int, mode: str):
        self.fp = _C.fdopen(fd, mode.c_str())
        if not self.fp:
            raise IOError(f"file descriptor {fd} could not be opened")
        self.encoding = "utf-8"
        self.errors = "strict"
        self.newline = None
        self._reset()

    def _errcheck(self, msg: str):
        err = int(_C.ferror(self.fp))
        if err:
            raise IOError(f"file I/O error: {msg}")

    def __enter__(self):
        pass

    def __exit__(self):
        self.close()

    def __iter__(self) -> Generator[T]:
        for a in self._iter():
            if T is bytes:
                yield a.__ptrcopy__()
            else:
                yield a

    def readlines(self) -> List[T]:
        return [l for l in self]

    def readline(self) -> T:
        self._ensure_open()
        if T is str and self.newline is None:
            data = _file_readline_universal(self.fp)
            return _file_translate_read_newlines(
                data.decode(self.encoding, self.errors), self.newline
            )
        length = _C.getline(
            Ptr[Ptr[u8]](self.__raw__() + 8), Ptr[int](self.__raw__()), self.fp
        )
        if length == -1:
            if T is bytes:
                return bytes()
            return str()
        data = bytes(self.buf, length)
        if T is bytes:
            return data.__ptrcopy__()
        return _file_translate_read_newlines(
            data.decode(self.encoding, self.errors), self.newline
        )

    def write(self, s: T) -> int:
        self._ensure_open()
        if T is bytes:
            _C.fwrite(s._ptr, 1, len(s), self.fp)
        else:
            data = _file_translate_write_newlines(s, self.newline).encode(
                self.encoding, self.errors
            )
            _C.fwrite(data._ptr, 1, len(data), self.fp)
        self._errcheck("error in write")
        return len(s)

    def __file_write_gen__(self, g: Generator[T], T: type):
        for s in g:
            self.write(s)

    def read(self) -> T:
        return self.read(-1)

    def read(self, sz: int) -> T:
        self._ensure_open()
        if T is bytes:
            if sz < 0:
                return _file_read_all(self.fp)
            result = _CodecByteBuffer(sz)
            result.length = _C.fread(result.data, 1, sz, self.fp)
            self._errcheck("error in read")
            return result.finish()
        if sz < 0:
            return _file_translate_read_newlines(
                _file_read_all(self.fp).decode(self.encoding, self.errors), self.newline
            )
        result = _CodecByteBuffer(sz)
        for _ in range(sz):
            _file_buffer_reserve(result, result.length + 1)
            length = _C.fread(result.data + result.length, 1, 1, self.fp)
            if length == 0:
                break
            width = _file_utf8_sequence_length(int(result.data[result.length]))
            result.length += length
            if width > 1:
                _file_buffer_reserve(result, result.length + width - 1)
                result.length += _C.fread(
                    result.data + result.length, 1, width - 1, self.fp
                )
        self._errcheck("error in read")
        return _file_translate_read_newlines(
            result.finish().decode(self.encoding, self.errors), self.newline
        )

    def tell(self) -> int:
        self._ensure_open()
        ret = _C.ftell(self.fp)
        self._errcheck("error in tell")
        return ret

    def seekable(self) -> bool:
        self._ensure_open()
        return _C.ftell(self.fp) >= 0

    def seek(self, offset: int, whence: int):
        self._ensure_open()
        _C.fseek(self.fp, offset, i32(whence))
        self._errcheck("error in seek")

    def flush(self):
        self._ensure_open()
        if _C.fflush(self.fp) != 0:
            raise IOError("file I/O error: error in flush")

    def close(self):
        if self.fp:
            _C.fclose(self.fp)
            self.fp = cobj()
        if self.buf:
            _C.free(self.buf)
            self._reset()

    def _ensure_open(self):
        if not self.fp:
            raise IOError("I/O operation on closed file")

    def _reset(self):
        self.buf = Ptr[u8]()
        self.sz = 0

    def _iter(self) -> Generator[T]:
        self._ensure_open()
        while True:
            line = self.readline()
            if len(line) == 0:
                break
            yield line

    def _iter_trim_newline(self) -> Generator[T]:
        self._ensure_open()
        while True:
            rd = _C.getline(
                Ptr[Ptr[u8]](self.__raw__() + 8), Ptr[int](self.__raw__()), self.fp
            )
            if rd != -1:
                if self.buf[rd - 1] == u8(10):
                    rd -= 1
                data = bytes(self.buf, rd)
                if T is bytes:
                    yield data
                else:
                    yield _file_translate_read_newlines(
                        data.decode(self.encoding, self.errors), self.newline
                    )
            else:
                break

def _gz_errcheck(stream: cobj):
    errnum = i32(0)
    msg = _C.gzerror(stream, __ptr__(errnum))
    if msg and msg[0]:
        raise IOError(f"zlib error: {bytes.from_ptr(msg).decode()}")

class gzFile[T]:
    sz: int
    buf: Ptr[u8]
    fp: cobj
    pending: int
    encoding: str
    errors: str
    newline: Optional[str]

    def __init__(self, fp: cobj):
        self.fp = fp
        self.encoding = "utf-8"
        self.errors = "strict"
        self.newline = None
        self._reset()

    def __init__(
        self,
        path: str,
        mode: str,
        encoding: str = "utf-8",
        errors: str = "strict",
        newline: Optional[str] = None,
    ):
        self.fp = _C.gzopen(path.c_str(), mode.c_str())
        if not self.fp:
            raise IOError(f"file {path} could not be opened")
        _file_validate_newline(newline)
        self.encoding = encoding
        self.errors = errors
        self.newline = newline
        self._reset()

    def _getline(self) -> int:
        if not self.buf:
            self.sz = 128
            self.buf = Ptr[u8](self.sz)

        offset = 0
        while True:
            if offset == self.sz:
                oldsz = self.sz
                self.sz *= 2
                self.buf = realloc(self.buf, self.sz, oldsz)

            byte = self._read_byte()
            if byte < 0:
                if offset == 0:
                    return -1
                break

            self.buf[offset] = u8(byte)
            offset += 1
            if byte == 0x0A:
                break
            if T is str and self.newline is None and byte == 0x0D:
                following = self._read_byte()
                if following == 0x0A:
                    if offset == self.sz:
                        oldsz = self.sz
                        self.sz *= 2
                        self.buf = realloc(self.buf, self.sz, oldsz)
                    self.buf[offset] = u8(following)
                    offset += 1
                elif following >= 0:
                    self.pending = following
                break

        return offset

    def __iter__(self) -> Generator[T]:
        for a in self._iter():
            if T is bytes:
                yield a.__ptrcopy__()
            else:
                yield a

    def __enter__(self):
        pass

    def __exit__(self):
        self.close()

    def close(self):
        if self.fp:
            _C.gzclose(self.fp)
            self.fp = cobj()
        if self.buf:
            free(self.buf)
            self._reset()

    def readlines(self) -> List[T]:
        return [l for l in self]

    def readline(self) -> T:
        self._ensure_open()
        length = self._getline()
        if length == -1:
            if T is bytes:
                return bytes()
            return str()
        data = bytes(self.buf, length)
        if T is bytes:
            return data.__ptrcopy__()
        return _file_translate_read_newlines(
            data.decode(self.encoding, self.errors), self.newline
        )

    def write(self, s: T) -> int:
        self._ensure_open()
        if T is bytes:
            _C.gzwrite(self.fp, s._ptr, u32(len(s)))
        else:
            data = _file_translate_write_newlines(s, self.newline).encode(
                self.encoding, self.errors
            )
            _C.gzwrite(self.fp, data._ptr, u32(len(data)))
        _gz_errcheck(self.fp)
        return len(s)

    def __file_write_gen__(self, g: Generator[T], T: type):
        for s in g:
            self.write(s)

    def read(self) -> T:
        return self.read(-1)

    def read(self, sz: int) -> T:
        self._ensure_open()
        if sz < 0:
            chunk_size = 4096
            result = _CodecByteBuffer(chunk_size)
            while True:
                _file_buffer_reserve(result, result.length + chunk_size)
                length = int(_C.gzread(
                    self.fp, result.data + result.length, u32(chunk_size)
                ))
                _gz_errcheck(self.fp)
                result.length += length
                if length < chunk_size:
                    break
            if T is bytes:
                return result.finish()
            else:
                return _file_translate_read_newlines(
                    result.finish().decode(self.encoding, self.errors), self.newline
                )
        if T is bytes:
            buf = Ptr[u8](sz)
            ret = _C.gzread(self.fp, buf, u32(sz))
            _gz_errcheck(self.fp)
            return _file_bytes(buf, int(ret))
        else:
            result = _CodecByteBuffer(sz)
            for _ in range(sz):
                _file_buffer_reserve(result, result.length + 1)
                length = int(_C.gzread(self.fp, result.data + result.length, u32(1)))
                _gz_errcheck(self.fp)
                if length == 0:
                    break
                width = _file_utf8_sequence_length(int(result.data[result.length]))
                result.length += length
                if width > 1:
                    _file_buffer_reserve(result, result.length + width - 1)
                    length = int(_C.gzread(
                        self.fp, result.data + result.length, u32(width - 1)
                    ))
                    _gz_errcheck(self.fp)
                    result.length += length
            return _file_translate_read_newlines(
                result.finish().decode(self.encoding, self.errors), self.newline
            )

    def tell(self) -> int:
        self._ensure_open()
        ret = _C.gztell(self.fp)
        _gz_errcheck(self.fp)
        return ret

    def seek(self, offset: int, whence: int):
        self._ensure_open()
        _C.gzseek(self.fp, offset, i32(whence))
        _gz_errcheck(self.fp)

    def flush(self):
        Z_FINISH = 4
        self._ensure_open()
        _C.gzflush(self.fp, i32(Z_FINISH))
        _gz_errcheck(self.fp)

    def _iter(self) -> Generator[T]:
        self._ensure_open()
        while True:
            rd = self._getline()
            if rd != -1:
                data = bytes(self.buf, rd)
                if T is bytes:
                    yield data
                else:
                    yield _file_translate_read_newlines(
                        data.decode(self.encoding, self.errors), self.newline
                    )
            else:
                break

    def _iter_trim_newline(self) -> Generator[T]:
        self._ensure_open()
        while True:
            rd = self._getline()
            if rd != -1:
                if self.buf[rd - 1] == u8(10):
                    rd -= 1
                data = bytes(self.buf, rd)
                if T is bytes:
                    yield data
                else:
                    yield _file_translate_read_newlines(
                        data.decode(self.encoding, self.errors), self.newline
                    )
            else:
                break

    def _ensure_open(self):
        if not self.fp:
            raise IOError("I/O operation on closed file")

    def _reset(self):
        self.buf = cobj()
        self.sz = 0
        self.pending = -1

    def _read_byte(self) -> int:
        if self.pending >= 0:
            byte = self.pending
            self.pending = -1
            return byte
        byte = u8(0)
        length = int(_C.gzread(self.fp, __ptr__(byte), u32(1)))
        _gz_errcheck(self.fp)
        if length == 0:
            return -1
        return int(byte)

def _bz_errcheck(stream: cobj):
    errnum = i32(0)
    msg = _C.BZ2_bzerror(stream, __ptr__(errnum))
    if errnum < i32(0):
        raise IOError(f"bzip2 error: {bytes.from_ptr(msg).decode()}")

class bzFile[T]:
    sz: int
    buf: Ptr[u8]
    fp: cobj
    pending: int
    encoding: str
    errors: str
    newline: Optional[str]

    def __init__(self, fp: cobj):
        self.fp = fp
        self.encoding = "utf-8"
        self.errors = "strict"
        self.newline = None
        self._reset()

    def __init__(
        self,
        path: str,
        mode: str,
        encoding: str = "utf-8",
        errors: str = "strict",
        newline: Optional[str] = None,
    ):
        self.fp = _C.BZ2_bzopen(path.c_str(), mode.c_str())
        if not self.fp:
            raise IOError(f"file {path} could not be opened")
        _file_validate_newline(newline)
        self.encoding = encoding
        self.errors = errors
        self.newline = newline
        self._reset()

    def _getline(self) -> int:
        if not self.buf:
            self.sz = 128
            self.buf = Ptr[u8](self.sz)

        offset = 0
        while True:
            if offset == self.sz:
                oldsz = self.sz
                self.sz *= 2
                self.buf = realloc(self.buf, self.sz, oldsz)

            byte = self._read_byte()
            if byte < 0:
                if offset == 0:
                    return -1
                break
            self.buf[offset] = u8(byte)
            offset += 1
            if byte == 0x0A:
                break
            if T is str and self.newline is None and byte == 0x0D:
                following = self._read_byte()
                if following == 0x0A:
                    if offset == self.sz:
                        oldsz = self.sz
                        self.sz *= 2
                        self.buf = realloc(self.buf, self.sz, oldsz)
                    self.buf[offset] = u8(following)
                    offset += 1
                elif following >= 0:
                    self.pending = following
                break

        return offset

    def __iter__(self) -> Generator[T]:
        for a in self._iter():
            if T is bytes:
                yield a.__ptrcopy__()
            else:
                yield a

    def __enter__(self):
        pass

    def __exit__(self):
        self.close()

    def close(self):
        if self.fp:
            _C.BZ2_bzclose(self.fp)
            self.fp = cobj()
        if self.buf:
            free(self.buf)
            self._reset()

    def readlines(self) -> List[T]:
        return [l for l in self]

    def readline(self) -> T:
        self._ensure_open()
        length = self._getline()
        if length == -1:
            if T is bytes:
                return bytes()
            return str()
        data = bytes(self.buf, length)
        if T is bytes:
            return data.__ptrcopy__()
        return _file_translate_read_newlines(
            data.decode(self.encoding, self.errors), self.newline
        )

    def write(self, s: T) -> int:
        self._ensure_open()
        if T is bytes:
            _C.BZ2_bzwrite(self.fp, s._ptr, i32(len(s)))
        else:
            data = _file_translate_write_newlines(s, self.newline).encode(
                self.encoding, self.errors
            )
            _C.BZ2_bzwrite(self.fp, data._ptr, i32(len(data)))
        _bz_errcheck(self.fp)
        return len(s)

    def __file_write_gen__(self, g: Generator[T], T: type):
        for s in g:
            self.write(s)

    def read(self) -> T:
        return self.read(-1)

    def read(self, sz: int) -> T:
        self._ensure_open()
        if sz < 0:
            chunk_size = 4096
            result = _CodecByteBuffer(chunk_size)
            while True:
                _file_buffer_reserve(result, result.length + chunk_size)
                length = int(_C.BZ2_bzread(
                    self.fp, result.data + result.length, i32(chunk_size)
                ))
                _bz_errcheck(self.fp)
                result.length += length
                if length < chunk_size:
                    break
            if T is bytes:
                return result.finish()
            else:
                return _file_translate_read_newlines(
                    result.finish().decode(self.encoding, self.errors), self.newline
                )
        if T is bytes:
            buf = Ptr[u8](sz)
            ret = _C.BZ2_bzread(self.fp, buf, i32(sz))
            _bz_errcheck(self.fp)
            return _file_bytes(buf, int(ret))
        else:
            result = _CodecByteBuffer(sz)
            for _ in range(sz):
                _file_buffer_reserve(result, result.length + 1)
                length = int(_C.BZ2_bzread(self.fp, result.data + result.length, i32(1)))
                _bz_errcheck(self.fp)
                if length == 0:
                    break
                width = _file_utf8_sequence_length(int(result.data[result.length]))
                result.length += length
                if width > 1:
                    _file_buffer_reserve(result, result.length + width - 1)
                    length = int(_C.BZ2_bzread(
                        self.fp, result.data + result.length, i32(width - 1)
                    ))
                    _bz_errcheck(self.fp)
                    result.length += length
            return _file_translate_read_newlines(
                result.finish().decode(self.encoding, self.errors), self.newline
            )

    def flush(self):
        self._ensure_open()
        _C.BZ2_bzflush(self.fp)
        _bz_errcheck(self.fp)

    def _iter(self) -> Generator[T]:
        self._ensure_open()
        while True:
            rd = self._getline()
            if rd != -1:
                data = bytes(self.buf, rd)
                if T is bytes:
                    yield data
                else:
                    yield _file_translate_read_newlines(
                        data.decode(self.encoding, self.errors), self.newline
                    )
            else:
                break

    def _iter_trim_newline(self) -> Generator[T]:
        self._ensure_open()
        while True:
            rd = self._getline()
            if rd != -1:
                if self.buf[rd - 1] == u8(10):
                    rd -= 1
                data = bytes(self.buf, rd)
                if T is bytes:
                    yield data
                else:
                    yield _file_translate_read_newlines(
                        data.decode(self.encoding, self.errors), self.newline
                    )
            else:
                break

    def _ensure_open(self):
        if not self.fp:
            raise IOError("I/O operation on closed file")

    def _reset(self):
        self.buf = cobj()
        self.sz = 0
        self.pending = -1

    def _read_byte(self) -> int:
        if self.pending >= 0:
            byte = self.pending
            self.pending = -1
            return byte
        byte = u8(0)
        length = int(_C.BZ2_bzread(self.fp, __ptr__(byte), i32(1)))
        _bz_errcheck(self.fp)
        if length == 0:
            return -1
        return int(byte)

    def _gets(self, buf: cobj, sz: int):
        if sz <= 0:
            return 0

        fp = self.fp
        b = u8(0)
        i = 0

        while i < sz - 1:
            status = _C.BZ2_bzread(fp, __ptr__(b), i32(1))
            if status == i32(0):
                break
            elif status < i32(0):
                return -1

            buf[i] = b
            i += 1
            if b == u8(10):
                break

        return i

def _literal_contains(needle: Literal[str], haystack: Literal[str]) -> Literal[bool]:
    import internal.static as static

    if static.len(needle) > static.len(haystack):
        return False
    elif haystack[0:static.len(needle)] == needle:
        return True
    else:
        return _literal_contains(needle, haystack[1:])

def open(
    path: str,
    mode: str = "r",
    encoding: str = "utf-8",
    errors: str = "strict",
    newline: Optional[str] = None,
) -> File[str]:
    return File[str](path, mode, encoding, errors, newline)

@overload
def open(
    path: str,
    mode: Literal[str],
    encoding: str = "utf-8",
    errors: str = "strict",
    newline: Optional[str] = None,
):
    if _literal_contains("b", mode):
        if encoding != "utf-8" or errors != "strict" or newline is not None:
            raise ValueError("binary mode does not take encoding, errors or newline")
        return File[bytes](path, mode)
    else:
        return File[str](path, mode, encoding, errors, newline)

def gzopen(
    path: str,
    mode: str = "r",
    encoding: str = "utf-8",
    errors: str = "strict",
    newline: Optional[str] = None,
) -> gzFile[str]:
    return gzFile[str](path, mode, encoding, errors, newline)

@overload
def gzopen(
    path: str,
    mode: Literal[str],
    encoding: str = "utf-8",
    errors: str = "strict",
    newline: Optional[str] = None,
):
    if _literal_contains("b", mode):
        if encoding != "utf-8" or errors != "strict" or newline is not None:
            raise ValueError("binary mode does not take encoding, errors or newline")
        return gzFile[bytes](path, mode)
    else:
        return gzFile[str](path, mode, encoding, errors, newline)

def bzopen(
    path: str,
    mode: str = "r",
    encoding: str = "utf-8",
    errors: str = "strict",
    newline: Optional[str] = None,
) -> bzFile[str]:
    return bzFile[str](path, mode, encoding, errors, newline)

@overload
def bzopen(
    path: str,
    mode: Literal[str],
    encoding: str = "utf-8",
    errors: str = "strict",
    newline: Optional[str] = None,
):
    if _literal_contains("b", mode):
        if encoding != "utf-8" or errors != "strict" or newline is not None:
            raise ValueError("binary mode does not take encoding, errors or newline")
        return bzFile[bytes](path, mode)
    else:
        return bzFile[str](path, mode, encoding, errors, newline)

def is_binary(path: str) -> bool:
    # https://stackoverflow.com/questions/898669/how-can-i-detect-if-a-file-is-binary-non-text-in-python/7392391#7392391
    # Can get both false positive and false negatives, but still is a
    # clever approach that works for the large majority of files
    textchars = {7, 8, 9, 10, 12, 13, 27} | set(iter(range(0x20, 0x100))) - {0x7F}
    with open(path, "rb") as f:
        header = f.read(1024)
        return any(c not in textchars for c in header)
