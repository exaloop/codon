        return x // y

    def __truediv__(self, b: float128):
        x, y = _unify(self, b)
        return x / y

    def __mod__(self, b: float128):
        x, y = _unify(self, b)
        return x % y

    def __divmod__(self, b: float128):
        x, y = _unify(self, b)
        return x.__divmod__(y)

    def __pow__(self, b: float128):
        x, y = _unify(self, b)
        return x ** y

    def __eq__(self, b: float128):
        x, y = _unify(self, b)
        return x == y

    def __ne__(self, b: float128):
        x, y = _unify(self, b)
        return x != y

    def __lt__(self, b: float128):
        x, y = _unify(self, b)
        return x < y

    def __gt__(self, b: float128):
        x, y = _unify(self, b)
        return x > y

    def __le__(self, b: float128):
        x, y = _unify(self, b)
        return x <= y

    def __ge__(self, b: float128):
        x, y = _unify(self, b)
        return x >= y

    @commutative
    def __add__(self, b: float32):
        x, y = _unify(self, b)
        return x + y

    def __sub__(self, b: float32):
        x, y = _unify(self, b)
