@extend
class float:

    @commutative
    def __add__(self, b: float128):
        x, y = _unify(self, b)
        return x + y

    def __sub__(self, b: float128):
        x, y = _unify(self, b)
        return x - y

    @commutative
    def __mul__(self, b: float128):
        x, y = _unify(self, b)
