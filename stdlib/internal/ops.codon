# Handle pairwise operators between primitive types:
#   - bool
#   - Int, UInt
#   - float, float128, float32, float16, bfloat16

def _float_int_pow(a: F, b: I, F: type, I: type) -> F:
    abs_exp = b.__abs__()
    result = F(1)
    factor = a

    while abs_exp:
        if abs_exp & I(1):
            result *= factor
        factor *= factor
        abs_exp >>= I(1)

    if not isinstance(b, UInt):
        if b < I(0):
            result = F(1) / result

    return result

@extend
class Int:

    def __new__(what) -> Int[N]:
        return Int[N](what.__int__())

    def __new__(what: bool) -> Int[N]:
        @pure
        @llvm
        def convert(what: bool, N: Literal[int]) -> Int[N]:
            %n = zext i8 %what to i{=N}
            ret i{=N} %n

        Int._check_bitwidth(N)
        return convert(what, N)

    def __new__(what: float) -> Int[N]:
        @pure
        @llvm
        def convert(what: float, N: Literal[int]) -> Int[N]:
            %n = fptosi double %what to i{=N}
            ret i{=N} %n

        Int._check_bitwidth(N)
        return convert(what)

    def __new__(what: float128) -> Int[N]:
        @pure
        @llvm
        def convert(what: float128, N: Literal[int]) -> Int[N]:
            %n = fptosi fp128 %what to i{=N}
            ret i{=N} %n

        Int._check_bitwidth(N)
        return convert(what)

    def __new__(what: float32) -> Int[N]:
        @pure
        @llvm
        def convert(what: float32, N: Literal[int]) -> Int[N]:
            %n = fptosi float %what to i{=N}
            ret i{=N} %n

        Int._check_bitwidth(N)
        return convert(what)

    def __new__(what: float16) -> Int[N]:
        @pure
        @llvm
        def convert(what: float16, N: Literal[int]) -> Int[N]:
            %n = fptosi half %what to i{=N}
            ret i{=N} %n

        Int._check_bitwidth(N)
        return convert(what)

    def __new__(what: bfloat16) -> Int[N]:
        @pure
        @llvm
        def convert(what: bfloat16, N: Literal[int]) -> Int[N]:
            %n = fptosi bfloat %what to i{=N}
            ret i{=N} %n

        Int._check_bitwidth(N)
        return convert(what)

@extend
class UInt:

    def __new__(what) -> UInt[N]:
        return UInt[N](what.__int__())

    def __new__(what: bool) -> UInt[N]:
        @pure
        @llvm
        def convert(what: bool, N: Literal[int]) -> UInt[N]:
            %n = zext i8 %what to i{=N}
            ret i{=N} %n

        Int._check_bitwidth(N)
        return convert(what, N)

    def __new__(what: float) -> UInt[N]:
        @pure
        @llvm
        def convert(what: float, N: Literal[int]) -> UInt[N]:
            %n = fptoui double %what to i{=N}
            ret i{=N} %n

        Int._check_bitwidth(N)
        return convert(what)

    def __new__(what: float128) -> UInt[N]:
        @pure
        @llvm
        def convert(what: float128, N: Literal[int]) -> UInt[N]:
            %n = fptoui fp128 %what to i{=N}
            ret i{=N} %n

        Int._check_bitwidth(N)
        return convert(what)

    def __new__(what: float32) -> UInt[N]:
        @pure
        @llvm
        def convert(what: float32, N: Literal[int]) -> UInt[N]:
            %n = fptoui float %what to i{=N}
            ret i{=N} %n

        Int._check_bitwidth(N)
        return convert(what)

    def __new__(what: float16) -> UInt[N]:
        @pure
        @llvm
        def convert(what: float16, N: Literal[int]) -> UInt[N]:
            %n = fptoui half %what to i{=N}
            ret i{=N} %n

        Int._check_bitwidth(N)
        return convert(what)

    def __new__(what: bfloat16) -> UInt[N]:
        @pure
        @llvm
        def convert(what: bfloat16, N: Literal[int]) -> UInt[N]:
            %n = fptoui bfloat %what to i{=N}
            ret i{=N} %n

        Int._check_bitwidth(N)
        return convert(what)

@extend
class float:

    def __new__(what) -> float:
        return what.__float__()

    def __new__(what: bool) -> float:
        return 1.0 if what else 0.0

    @pure
    @llvm
    def __new__(what: Int[N], N: Literal[int]) -> float:
        %0 = sitofp i{=N} %what to double
        ret double %0

    @pure
    @llvm
    def __new__(what: UInt[N], N: Literal[int]) -> float:
        %0 = uitofp i{=N} %what to double
        ret double %0

    @pure
    @llvm
    def __new__(what: float32) -> float:
        %0 = fpext float %what to double
        ret double %0

    @pure
    @llvm
    def __new__(what: float16) -> float:
        %0 = fpext half %what to double
        ret double %0

    @pure
    @llvm
    def __new__(what: bfloat16) -> float:
        %0 = fpext bfloat %what to double
        ret double %0

@extend
class float128:

    def __new__(what) -> float128:
        return float128(what.__float__())

    def __new__(what: bool) -> float128:
        return float128(1.0) if what else float128(0.0)

    @pure
    @llvm
    def __new__(what: Int[N], N: Literal[int]) -> float128:
        %0 = sitofp i{=N} %what to fp128
        ret fp128 %0

    @pure
    @llvm
    def __new__(what: UInt[N], N: Literal[int]) -> float128:
        %0 = uitofp i{=N} %what to fp128
        ret fp128 %0

    @pure
    @llvm
    def __new__(what: float32) -> float128:
        %0 = fpext float %what to fp128
        ret fp128 %0

    @pure
    @llvm
    def __new__(what: float16) -> float128:
        %0 = fpext half %what to fp128
        ret fp128 %0

    @pure
    @llvm
    def __new__(what: bfloat16) -> float128:
        %0 = fpext bfloat %what to fp128
        ret fp128 %0

@extend
class float32:

    def __new__(what) -> float32:
        return float32(what.__float__())

    def __new__(what: bool) -> float32:
        return float32(1.0) if what else float32(0.0)

    @pure
    @llvm
    def __new__(what: Int[N], N: Literal[int]) -> float32:
        %0 = sitofp i{=N} %what to float
        ret float %0

    @pure
    @llvm
    def __new__(what: UInt[N], N: Literal[int]) -> float32:
        %0 = uitofp i{=N} %what to float
        ret float %0

    @pure
    @llvm
    def __new__(what: float128) -> float32:
        %0 = fptrunc fp128 %what to float
        ret float %0

    @pure
    @llvm
    def __new__(what: float16) -> float32:
        %0 = fpext half %what to float
        ret float %0

    @pure
    @llvm
    def __new__(what: bfloat16) -> float32:
        %0 = fpext bfloat %what to float
        ret float %0

@extend
class float16:

    def __new__(what) -> float16:
        return float16(what.__float__())

    def __new__(what: bool) -> float16:
        return float16(1.0) if what else float16(0.0)

    @pure
    @llvm
    def __new__(what: Int[N], N: Literal[int]) -> float16:
        %0 = sitofp i{=N} %what to half
        ret half %0

    @pure
    @llvm
    def __new__(what: UInt[N], N: Literal[int]) -> float16:
        %0 = uitofp i{=N} %what to half
        ret half %0

    @pure
    @llvm
    def __new__(what: float128) -> float16:
        %0 = fptrunc fp128 %what to half
        ret half %0

    @pure
    @llvm
    def __new__(what: float32) -> float16:
        %0 = fptrunc float %what to half
        ret half %0

    @pure
    @llvm
    def __new__(what: bfloat16) -> float16:
        %0 = fpext bfloat %what to float
        %1 = fptrunc float %0 to half
        ret half %1

@extend
class bfloat16:

    def __new__(what) -> bfloat16:
        return bfloat16(what.__float__())

    def __new__(what: bool) -> bfloat16:
        return bfloat16(1.0) if what else bfloat16(0.0)

    @pure
    @llvm
    def __new__(what: Int[N], N: Literal[int]) -> bfloat16:
        %0 = sitofp i{=N} %what to bfloat
        ret bfloat %0

    @pure
    @llvm
    def __new__(what: UInt[N], N: Literal[int]) -> bfloat16:
        %0 = uitofp i{=N} %what to bfloat
        ret bfloat %0

    @pure
    @llvm
    def __new__(what: float128) -> bfloat16:
        %0 = fptrunc fp128 %what to bfloat
        ret bfloat %0

    @pure
    @llvm
    def __new__(what: float32) -> bfloat16:
        %0 = fptrunc float %what to bfloat
        ret bfloat %0

    @pure
    @llvm
    def __new__(what: float16) -> bfloat16:
        %0 = fpext float16 %what to float
        %1 = fptrunc float %0 to bfloat
        ret bfloat %1


def _unify(a, b):
    A = type(a)
    B = type(b)

    a_is_bool: Literal[bool] = (A is bool)
    a_is_int: Literal[bool] = isinstance(A, Int)
    a_is_uint: Literal[bool] = isinstance(A, UInt)
    a_is_float: Literal[bool] = (A is float or A is float128 or A is float32 or
                                 A is float16 or A is bfloat16)

    b_is_bool: Literal[bool] = (B is bool)
    b_is_int: Literal[bool] = isinstance(B, Int)
    b_is_uint: Literal[bool] = isinstance(B, UInt)
    b_is_float: Literal[bool] = (B is float or B is float128 or B is float32 or
                                 B is float16 or B is bfloat16)

    if A is B:
        return (a, b)
    elif (a_is_int and b_is_int) or (a_is_uint and b_is_uint):
        if A.N > B.N:
            return (a, A(b))
        else:
            return (B(a), b)
    elif a_is_int and b_is_uint:
        if A.N >= B.N:
            return (a, A(b))
        else:
            C = Int[B.N]
            return (C(a), C(b))
    elif a_is_uint and b_is_int:
        if B.N >= A.N:
            return (B(a), b)
        else:
            C = Int[A.N]
            return (C(a), C(b))
    elif a_is_float and b_is_float:
        if A is float128 or B is float128:
            return (float128(a), float128(b))
        elif A is float or B is float:
            return (float(a), float(b))
        elif A is float32 or B is float32:
            return (float32(a), float32(b))
        elif A is float16 or B is float16:
            return (float16(a), float16(b))
        else:
            return (bfloat16(a), bfloat16(b))
    elif a_is_float and b_is_int:
        return (a, A(b))
    elif a_is_float and b_is_uint:
        return (a, A(b))
    elif a_is_int and b_is_float:
        return (B(a), b)
    elif a_is_uint and b_is_float:
        return (B(a), b)
    elif (a_is_int or a_is_uint or a_is_float) and b_is_bool:
        return (a, A(b))
    elif a_is_bool and (b_is_int or b_is_uint or b_is_float):
        return (B(a), b)
    else:
        compile_error("cannot operate on types '" + A.__name__ + "' and '" + B.__name__ + "'")


# All pairwise operators:

@extend
class Int:

    @commutative
    def __add__(self, b: float):
        x, y = _unify(self, b)
        return x + y

    def __sub__(self, b: float):
        x, y = _unify(self, b)
        return x - y

    @commutative
    def __mul__(self, b: float):
        x, y = _unify(self, b)
        return x * y

    def __floordiv__(self, b: float):
        x, y = _unify(self, b)
        return x // y

    def __truediv__(self, b: float):
        x, y = _unify(self, b)
        return x / y

    def __mod__(self, b: float):
        x, y = _unify(self, b)
        return x % y

    def __divmod__(self, b: float):
        x, y = _unify(self, b)
        return x.__divmod__(y)

    def __pow__(self, b: float):
        x, y = _unify(self, b)
        return x ** y

    def __eq__(self, b: float):
        x, y = _unify(self, b)
        return x == y

    def __ne__(self, b: float):
        x, y = _unify(self, b)
        return x != y

    def __lt__(self, b: float):
        x, y = _unify(self, b)
        return x < y

    def __gt__(self, b: float):
        x, y = _unify(self, b)
        return x > y

    def __le__(self, b: float):
        x, y = _unify(self, b)
        return x <= y

    def __ge__(self, b: float):
        x, y = _unify(self, b)
        return x >= y

    @commutative
    def __add__(self, b: float128):
        x, y = _unify(self, b)
        return x + y

    def __sub__(self, b: float128):
        x, y = _unify(self, b)
        return x - y

    @commutative
    def __mul__(self, b: float128):
        x, y = _unify(self, b)
        return x * y

    def __floordiv__(self, b: float128):
