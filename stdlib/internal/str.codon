KIND_SHIFT: Literal[int] = 56

LEN_MASK: Literal[int] = (1 << KIND_SHIFT) - 1
KIND_MASK: Literal[int] = 3 << KIND_SHIFT

KIND_ASCII: Literal[int] = 0
KIND_LATIN1: Literal[int] = 1
KIND_UCS2: Literal[int] = 2
KIND_UCS4: Literal[int] = 3

UTF8_CONT_MASK: Literal[int] = 0xC0
UTF8_CONT_TAG: Literal[int] = 0x80

UNICODE_MAX: Literal[int] = 0x10FFFF
SURROGATE_MIN: Literal[int] = 0xD800
SURROGATE_MAX: Literal[int] = 0xDFFF

_ENCODING_UNKNOWN: Literal[int] = 0
_ENCODING_UTF8: Literal[int] = 1
_ENCODING_ASCII: Literal[int] = 2
_ENCODING_LATIN1: Literal[int] = 3
_ENCODING_CP1252: Literal[int] = 4
_ENCODING_CP1251: Literal[int] = 5
_ENCODING_CP1250: Literal[int] = 6
_ENCODING_CP1253: Literal[int] = 7
_ENCODING_CP1254: Literal[int] = 8
_ENCODING_ISO8859_15: Literal[int] = 9
_ENCODING_UTF16: Literal[int] = 10
_ENCODING_UTF16_LE: Literal[int] = 11
_ENCODING_UTF16_BE: Literal[int] = 12
_ENCODING_UTF32: Literal[int] = 13
_ENCODING_UTF32_LE: Literal[int] = 14
_ENCODING_UTF32_BE: Literal[int] = 15

_ERROR_UNKNOWN: Literal[int] = 0
_ERROR_STRICT: Literal[int] = 1
_ERROR_IGNORE: Literal[int] = 2
_ERROR_REPLACE: Literal[int] = 3
_ERROR_SURROGATEPASS: Literal[int] = 4
_ERROR_SURROGATEESCAPE: Literal[int] = 5
_ERROR_BACKSLASHREPLACE: Literal[int] = 6
_ERROR_XMLCHARREFREPLACE: Literal[int] = 7
_ERROR_NAMEREPLACE: Literal[int] = 8


@pure
@llvm
def _native_is_little_endian() -> bool:
    %p = alloca i16
    store i16 1, ptr %p
    %b = load i8, ptr %p
    %r = icmp eq i8 %b, 1
    %e = zext i1 %r to i8
    ret i8 %e


def _kind_for_maxchar(maxchar: int) -> int:
    if maxchar <= 0x7F:
        return KIND_ASCII
    elif maxchar <= 0xFF:
        return KIND_LATIN1
    elif maxchar <= 0xFFFF:
        return KIND_UCS2
    else:
        return KIND_UCS4


def _kind_width(kind: int) -> int:
    if kind <= KIND_LATIN1:
        return 1
    elif kind == KIND_UCS2:
        return 2
    else:
        return 4


def _make_meta(length: int, kind: int) -> int:
    return (length & LEN_MASK) | (kind << KIND_SHIFT)


def _meta_len(meta: int) -> int:
    return meta & LEN_MASK


def _meta_kind(meta: int) -> int:
    return (meta & KIND_MASK) >> KIND_SHIFT


def _is_surrogate(cp: int) -> bool:
    return SURROGATE_MIN <= cp <= SURROGATE_MAX


def _is_utf8_continuation(byte: int) -> bool:
    return (byte & UTF8_CONT_MASK) == UTF8_CONT_TAG


@pure
@llvm
def _utf8_nonascii_mask16(data: Ptr[u8], pos: int) -> u16:
    %p = getelementptr inbounds i8, ptr %data, i64 %pos
    %bytes = load <16 x i8>, ptr %p, align 1
    %nonascii = icmp slt <16 x i8> %bytes, zeroinitializer
    %mask = bitcast <16 x i1> %nonascii to i16
    ret i16 %mask


@pure
@llvm
def _utf8_scan_latin1_16(data: Ptr[u8], pos: int) -> int:
    declare i16 @llvm.ctpop.i16(i16)
    %src = getelementptr inbounds i8, ptr %data, i64 %pos
    %bytes = load <16 x i8>, ptr %src, align 1
    %ascii = icmp ult <16 x i8> %bytes, <i8 128, i8 128, i8 128, i8 128, i8 128, i8 128, i8 128, i8 128, i8 128, i8 128, i8 128, i8 128, i8 128, i8 128, i8 128, i8 128>
    %leadlower = icmp uge <16 x i8> %bytes, <i8 194, i8 194, i8 194, i8 194, i8 194, i8 194, i8 194, i8 194, i8 194, i8 194, i8 194, i8 194, i8 194, i8 194, i8 194, i8 194>
    %leadupper = icmp ule <16 x i8> %bytes, <i8 195, i8 195, i8 195, i8 195, i8 195, i8 195, i8 195, i8 195, i8 195, i8 195, i8 195, i8 195, i8 195, i8 195, i8 195, i8 195>
    %lead = and <16 x i1> %leadlower, %leadupper
    %conttag = and <16 x i8> %bytes, <i8 192, i8 192, i8 192, i8 192, i8 192, i8 192, i8 192, i8 192, i8 192, i8 192, i8 192, i8 192, i8 192, i8 192, i8 192, i8 192>
    %continuation = icmp eq <16 x i8> %conttag, <i8 128, i8 128, i8 128, i8 128, i8 128, i8 128, i8 128, i8 128, i8 128, i8 128, i8 128, i8 128, i8 128, i8 128, i8 128, i8 128>
    %valid0 = or <16 x i1> %ascii, %lead
    %valid = or <16 x i1> %valid0, %continuation
    %validmask = bitcast <16 x i1> %valid to i16
    %leadmask = bitcast <16 x i1> %lead to i16
    %continuationmask = bitcast <16 x i1> %continuation to i16
    %expected = shl i16 %leadmask, 1
    %allvalid = icmp eq i16 %validmask, -1
    %paired = icmp eq i16 %continuationmask, %expected
    %lastlead = and i16 %leadmask, -32768
    %endscomplete = icmp eq i16 %lastlead, 0
    %structure0 = and i1 %allvalid, %paired
    %structure = and i1 %structure0, %endscomplete
    %continuations = call i16 @llvm.ctpop.i16(i16 %continuationmask)
    %count16 = sub i16 16, %continuations
    %count = zext i16 %count16 to i64
    %result = select i1 %structure, i64 %count, i64 0
    ret i64 %result


@pure
@llvm
def _utf8_first_nonascii(mask: u16) -> int:
    declare i16 @llvm.cttz.i16(i16, i1)
    %index16 = call i16 @llvm.cttz.i16(i16 %mask, i1 true)
    %index = zext i16 %index16 to i64
    ret i64 %index


@llvm
def _utf8_copy_ascii16(data: Ptr[u8], pos: int, output: Ptr[u8], out: int) -> None:
    %src = getelementptr inbounds i8, ptr %data, i64 %pos
    %dst = getelementptr inbounds i8, ptr %output, i64 %out
    %bytes = load <16 x i8>, ptr %src, align 1
    store <16 x i8> %bytes, ptr %dst, align 1
    ret {} {}


@llvm
def _utf8_widen_ascii16_u16(data: Ptr[u8], pos: int, output: Ptr[u16], out: int) -> None:
    %src = getelementptr inbounds i8, ptr %data, i64 %pos
    %dst = getelementptr inbounds i16, ptr %output, i64 %out
    %bytes = load <16 x i8>, ptr %src, align 1
    %wide = zext <16 x i8> %bytes to <16 x i16>
    store <16 x i16> %wide, ptr %dst, align 2
    ret {} {}


@llvm
def _utf8_widen_ascii16_u32(data: Ptr[u8], pos: int, output: Ptr[u32], out: int) -> None:
    %src = getelementptr inbounds i8, ptr %data, i64 %pos
    %dst = getelementptr inbounds i32, ptr %output, i64 %out
    %bytes = load <16 x i8>, ptr %src, align 1
    %wide = zext <16 x i8> %bytes to <16 x i32>
    store <16 x i32> %wide, ptr %dst, align 4
    ret {} {}


@pure
@llvm
def _utf8_size16_u8(data: Ptr[u8], pos: int) -> int:
    declare i16 @llvm.ctpop.i16(i16)
    %src = getelementptr inbounds i8, ptr %data, i64 %pos
    %codepoints = load <16 x i8>, ptr %src, align 1
    %nonascii = icmp slt <16 x i8> %codepoints, zeroinitializer
    %mask = bitcast <16 x i1> %nonascii to i16
    %count16 = call i16 @llvm.ctpop.i16(i16 %mask)
    %count = zext i16 %count16 to i64
    %size = add i64 %count, 16
    ret i64 %size


@pure
@llvm
def _utf8_size16_u16(data: Ptr[u16], pos: int) -> u64:
    declare i16 @llvm.ctpop.i16(i16)
    %src = getelementptr inbounds i16, ptr %data, i64 %pos
    %codepoints = load <16 x i16>, ptr %src, align 2
    %v80base = insertelement <16 x i16> poison, i16 128, i64 0
    %v80 = shufflevector <16 x i16> %v80base, <16 x i16> poison, <16 x i32> zeroinitializer
    %v800base = insertelement <16 x i16> poison, i16 2048, i64 0
    %v800 = shufflevector <16 x i16> %v800base, <16 x i16> poison, <16 x i32> zeroinitializer
    %vd800base = insertelement <16 x i16> poison, i16 55296, i64 0
    %vd800 = shufflevector <16 x i16> %vd800base, <16 x i16> poison, <16 x i32> zeroinitializer
    %vdfffbase = insertelement <16 x i16> poison, i16 57343, i64 0
    %vdfff = shufflevector <16 x i16> %vdfffbase, <16 x i16> poison, <16 x i32> zeroinitializer
    %ge80 = icmp uge <16 x i16> %codepoints, %v80
    %ge800 = icmp uge <16 x i16> %codepoints, %v800
    %ged800 = icmp uge <16 x i16> %codepoints, %vd800
    %ledfff = icmp ule <16 x i16> %codepoints, %vdfff
    %invalid = and <16 x i1> %ged800, %ledfff
    %mask80 = bitcast <16 x i1> %ge80 to i16
    %mask800 = bitcast <16 x i1> %ge800 to i16
    %invalidmask = bitcast <16 x i1> %invalid to i16
    %count80i16 = call i16 @llvm.ctpop.i16(i16 %mask80)
    %count800i16 = call i16 @llvm.ctpop.i16(i16 %mask800)
    %count80 = zext i16 %count80i16 to i64
    %count800 = zext i16 %count800i16 to i64
    %size1 = add i64 %count80, 16
    %size = add i64 %size1, %count800
    %invalid64 = zext i16 %invalidmask to i64
    %shifted = shl i64 %invalid64, 32
    %result = or i64 %size, %shifted
    ret i64 %result


@pure
@llvm
def _utf8_nonascii_mask16_u16(data: Ptr[u16], pos: int) -> u16:
    %src = getelementptr inbounds i16, ptr %data, i64 %pos
    %codepoints = load <16 x i16>, ptr %src, align 2
    %v7fbase = insertelement <16 x i16> poison, i16 127, i64 0
    %v7f = shufflevector <16 x i16> %v7fbase, <16 x i16> poison, <16 x i32> zeroinitializer
    %nonascii = icmp ugt <16 x i16> %codepoints, %v7f
    %mask = bitcast <16 x i1> %nonascii to i16
    ret i16 %mask


@llvm
def _utf8_pack_ascii16_u16(data: Ptr[u16], pos: int, output: Ptr[u8], out: int) -> None:
    %src = getelementptr inbounds i16, ptr %data, i64 %pos
    %dst = getelementptr inbounds i8, ptr %output, i64 %out
    %codepoints = load <16 x i16>, ptr %src, align 2
    %bytes = trunc <16 x i16> %codepoints to <16 x i8>
    store <16 x i8> %bytes, ptr %dst, align 1
    ret {} {}


@pure
@llvm
def _utf8_size16_u32(data: Ptr[u32], pos: int) -> u64:
    declare i16 @llvm.ctpop.i16(i16)
    %src = getelementptr inbounds i32, ptr %data, i64 %pos
    %codepoints = load <16 x i32>, ptr %src, align 4
    %v80base = insertelement <16 x i32> poison, i32 128, i64 0
    %v80 = shufflevector <16 x i32> %v80base, <16 x i32> poison, <16 x i32> zeroinitializer
    %v800base = insertelement <16 x i32> poison, i32 2048, i64 0
    %v800 = shufflevector <16 x i32> %v800base, <16 x i32> poison, <16 x i32> zeroinitializer
    %v10000base = insertelement <16 x i32> poison, i32 65536, i64 0
    %v10000 = shufflevector <16 x i32> %v10000base, <16 x i32> poison, <16 x i32> zeroinitializer
    %vd800base = insertelement <16 x i32> poison, i32 55296, i64 0
    %vd800 = shufflevector <16 x i32> %vd800base, <16 x i32> poison, <16 x i32> zeroinitializer
    %vdfffbase = insertelement <16 x i32> poison, i32 57343, i64 0
    %vdfff = shufflevector <16 x i32> %vdfffbase, <16 x i32> poison, <16 x i32> zeroinitializer
    %vmaxbase = insertelement <16 x i32> poison, i32 1114111, i64 0
    %vmax = shufflevector <16 x i32> %vmaxbase, <16 x i32> poison, <16 x i32> zeroinitializer
    %ge80 = icmp uge <16 x i32> %codepoints, %v80
    %ge800 = icmp uge <16 x i32> %codepoints, %v800
    %ge10000 = icmp uge <16 x i32> %codepoints, %v10000
    %ged800 = icmp uge <16 x i32> %codepoints, %vd800
    %ledfff = icmp ule <16 x i32> %codepoints, %vdfff
    %surrogate = and <16 x i1> %ged800, %ledfff
    %above = icmp ugt <16 x i32> %codepoints, %vmax
    %invalid = or <16 x i1> %surrogate, %above
    %mask80 = bitcast <16 x i1> %ge80 to i16
    %mask800 = bitcast <16 x i1> %ge800 to i16
    %mask10000 = bitcast <16 x i1> %ge10000 to i16
    %invalidmask = bitcast <16 x i1> %invalid to i16
    %count80i16 = call i16 @llvm.ctpop.i16(i16 %mask80)
    %count800i16 = call i16 @llvm.ctpop.i16(i16 %mask800)
    %count10000i16 = call i16 @llvm.ctpop.i16(i16 %mask10000)
    %count80 = zext i16 %count80i16 to i64
    %count800 = zext i16 %count800i16 to i64
    %count10000 = zext i16 %count10000i16 to i64
    %size1 = add i64 %count80, 16
    %size2 = add i64 %size1, %count800
    %size = add i64 %size2, %count10000
    %invalid64 = zext i16 %invalidmask to i64
    %shifted = shl i64 %invalid64, 32
    %result = or i64 %size, %shifted
    ret i64 %result


@pure
@llvm
def _utf8_nonascii_mask16_u32(data: Ptr[u32], pos: int) -> u16:
    %src = getelementptr inbounds i32, ptr %data, i64 %pos
    %codepoints = load <16 x i32>, ptr %src, align 4
    %v7fbase = insertelement <16 x i32> poison, i32 127, i64 0
    %v7f = shufflevector <16 x i32> %v7fbase, <16 x i32> poison, <16 x i32> zeroinitializer
    %nonascii = icmp ugt <16 x i32> %codepoints, %v7f
    %mask = bitcast <16 x i1> %nonascii to i16
    ret i16 %mask


@llvm
def _utf8_pack_ascii16_u32(data: Ptr[u32], pos: int, output: Ptr[u8], out: int) -> None:
    %src = getelementptr inbounds i32, ptr %data, i64 %pos
    %dst = getelementptr inbounds i8, ptr %output, i64 %out
    %codepoints = load <16 x i32>, ptr %src, align 4
    %bytes = trunc <16 x i32> %codepoints to <16 x i8>
    store <16 x i8> %bytes, ptr %dst, align 1
    ret {} {}


@pure
@llvm
def _utf8_all_fourbyte4_u32(data: Ptr[u32], pos: int) -> bool:
    %src = getelementptr inbounds i32, ptr %data, i64 %pos
    %codepoints = load <4 x i32>, ptr %src, align 4
    %v10000base = insertelement <4 x i32> poison, i32 65536, i64 0
    %v10000 = shufflevector <4 x i32> %v10000base, <4 x i32> poison, <4 x i32> zeroinitializer
    %fourbyte = icmp uge <4 x i32> %codepoints, %v10000
    %mask = bitcast <4 x i1> %fourbyte to i4
    %all = icmp eq i4 %mask, 15
    %result = zext i1 %all to i8
    ret i8 %result


@llvm
def _utf8_pack_fourbyte4_u32(data: Ptr[u32], pos: int, output: Ptr[u8], out: int) -> None:
    %src = getelementptr inbounds i32, ptr %data, i64 %pos
    %dst = getelementptr inbounds i8, ptr %output, i64 %out
    %codepoints = load <4 x i32>, ptr %src, align 4
    %shift18 = lshr <4 x i32> %codepoints, <i32 18, i32 18, i32 18, i32 18>
    %first32 = or <4 x i32> %shift18, <i32 240, i32 240, i32 240, i32 240>
    %shift12 = lshr <4 x i32> %codepoints, <i32 12, i32 12, i32 12, i32 12>
    %secondbits = and <4 x i32> %shift12, <i32 63, i32 63, i32 63, i32 63>
    %second32 = or <4 x i32> %secondbits, <i32 128, i32 128, i32 128, i32 128>
    %shift6 = lshr <4 x i32> %codepoints, <i32 6, i32 6, i32 6, i32 6>
    %thirdbits = and <4 x i32> %shift6, <i32 63, i32 63, i32 63, i32 63>
    %third32 = or <4 x i32> %thirdbits, <i32 128, i32 128, i32 128, i32 128>
    %fourthbits = and <4 x i32> %codepoints, <i32 63, i32 63, i32 63, i32 63>
    %fourth32 = or <4 x i32> %fourthbits, <i32 128, i32 128, i32 128, i32 128>
    %first = trunc <4 x i32> %first32 to <4 x i8>
    %second = trunc <4 x i32> %second32 to <4 x i8>
    %third = trunc <4 x i32> %third32 to <4 x i8>
    %fourth = trunc <4 x i32> %fourth32 to <4 x i8>
    %first_second = shufflevector <4 x i8> %first, <4 x i8> %second, <8 x i32> <i32 0, i32 4, i32 1, i32 5, i32 2, i32 6, i32 3, i32 7>
    %third_fourth = shufflevector <4 x i8> %third, <4 x i8> %fourth, <8 x i32> <i32 0, i32 4, i32 1, i32 5, i32 2, i32 6, i32 3, i32 7>
    %bytes = shufflevector <8 x i8> %first_second, <8 x i8> %third_fourth, <16 x i32> <i32 0, i32 1, i32 8, i32 9, i32 2, i32 3, i32 10, i32 11, i32 4, i32 5, i32 12, i32 13, i32 6, i32 7, i32 14, i32 15>
    store <16 x i8> %bytes, ptr %dst, align 1
    ret {} {}


@pure
@llvm
def _utf8_all_fourbyte4(data: Ptr[u8], pos: int) -> bool:
    %src = getelementptr inbounds i8, ptr %data, i64 %pos
    %bytes = load <16 x i8>, ptr %src, align 1
    %starts = shufflevector <16 x i8> %bytes, <16 x i8> poison, <4 x i32> <i32 0, i32 4, i32 8, i32 12>
    %second = shufflevector <16 x i8> %bytes, <16 x i8> poison, <4 x i32> <i32 1, i32 5, i32 9, i32 13>
    %third = shufflevector <16 x i8> %bytes, <16 x i8> poison, <4 x i32> <i32 2, i32 6, i32 10, i32 14>
    %fourth = shufflevector <16 x i8> %bytes, <16 x i8> poison, <4 x i32> <i32 3, i32 7, i32 11, i32 15>
    %startlower = icmp uge <4 x i8> %starts, <i8 240, i8 240, i8 240, i8 240>
    %startupper = icmp ule <4 x i8> %starts, <i8 244, i8 244, i8 244, i8 244>
    %secondtag = and <4 x i8> %second, <i8 192, i8 192, i8 192, i8 192>
    %thirdtag = and <4 x i8> %third, <i8 192, i8 192, i8 192, i8 192>
    %fourthtag = and <4 x i8> %fourth, <i8 192, i8 192, i8 192, i8 192>
    %secondcont = icmp eq <4 x i8> %secondtag, <i8 128, i8 128, i8 128, i8 128>
    %thirdcont = icmp eq <4 x i8> %thirdtag, <i8 128, i8 128, i8 128, i8 128>
    %fourthcont = icmp eq <4 x i8> %fourthtag, <i8 128, i8 128, i8 128, i8 128>
    %notf0 = icmp ne <4 x i8> %starts, <i8 240, i8 240, i8 240, i8 240>
    %notf4 = icmp ne <4 x i8> %starts, <i8 244, i8 244, i8 244, i8 244>
    %secondge90 = icmp uge <4 x i8> %second, <i8 144, i8 144, i8 144, i8 144>
    %secondle8f = icmp ule <4 x i8> %second, <i8 143, i8 143, i8 143, i8 143>
    %not-overlong = or <4 x i1> %notf0, %secondge90
    %not-above = or <4 x i1> %notf4, %secondle8f
    %validstart = and <4 x i1> %startlower, %startupper
    %validcontinuations0 = and <4 x i1> %secondcont, %thirdcont
    %validcontinuations = and <4 x i1> %validcontinuations0, %fourthcont
    %validrange = and <4 x i1> %not-overlong, %not-above
    %valid0 = and <4 x i1> %validstart, %validcontinuations
    %valid = and <4 x i1> %valid0, %validrange
    %mask = bitcast <4 x i1> %valid to i4
    %all = icmp eq i4 %mask, 15
    %result = zext i1 %all to i8
    ret i8 %result


@llvm
def _utf8_unpack_fourbyte4_u32(data: Ptr[u8], pos: int, output: Ptr[u32], out: int) -> None:
    %src = getelementptr inbounds i8, ptr %data, i64 %pos
    %dst = getelementptr inbounds i32, ptr %output, i64 %out
    %bytes = load <16 x i8>, ptr %src, align 1
    %first8 = shufflevector <16 x i8> %bytes, <16 x i8> poison, <4 x i32> <i32 0, i32 4, i32 8, i32 12>
    %second8 = shufflevector <16 x i8> %bytes, <16 x i8> poison, <4 x i32> <i32 1, i32 5, i32 9, i32 13>
    %third8 = shufflevector <16 x i8> %bytes, <16 x i8> poison, <4 x i32> <i32 2, i32 6, i32 10, i32 14>
    %fourth8 = shufflevector <16 x i8> %bytes, <16 x i8> poison, <4 x i32> <i32 3, i32 7, i32 11, i32 15>
    %first = zext <4 x i8> %first8 to <4 x i32>
    %second = zext <4 x i8> %second8 to <4 x i32>
    %third = zext <4 x i8> %third8 to <4 x i32>
    %fourth = zext <4 x i8> %fourth8 to <4 x i32>
    %firstbits = and <4 x i32> %first, <i32 7, i32 7, i32 7, i32 7>
    %firstshift = shl <4 x i32> %firstbits, <i32 18, i32 18, i32 18, i32 18>
    %secondbits = and <4 x i32> %second, <i32 63, i32 63, i32 63, i32 63>
    %secondshift = shl <4 x i32> %secondbits, <i32 12, i32 12, i32 12, i32 12>
    %thirdbits = and <4 x i32> %third, <i32 63, i32 63, i32 63, i32 63>
    %thirdshift = shl <4 x i32> %thirdbits, <i32 6, i32 6, i32 6, i32 6>
    %fourthbits = and <4 x i32> %fourth, <i32 63, i32 63, i32 63, i32 63>
    %high = or <4 x i32> %firstshift, %secondshift
    %low = or <4 x i32> %thirdshift, %fourthbits
    %codepoints = or <4 x i32> %high, %low
    store <4 x i32> %codepoints, ptr %dst, align 4
    ret {} {}


def _normalize_search_bounds(length: int, start: int, end: int) -> Tuple[int, int]:
    if start < 0:
        start += length
        if start < 0:
            start = 0

    if end < 0:
        end += length

    if end < 0:
        end = 0
    elif end > length:
        end = length

    return start, end


def _raise_utf8_decode_error(pos: int, end: int, reason: str):
    raise ValueError(f"utf-8 decode error at bytes {pos}-{end}: {reason}")


def _raise_utf8_encode_error(pos: int, end: int, reason: str):
    raise ValueError(f"utf-8 encode error at code points {pos}-{end}: {reason}")


def _utf8_scan_strict(
    data: Ptr[u8],
    byte_length: int,
) -> Tuple[int, int]:
    length = 0
    maxchar = 0
    pos = 0

    while pos < byte_length:
        if pos + 16 <= byte_length:
            mask = _utf8_nonascii_mask16(data, pos)
            if mask == 0:
                pos += 16
                length += 16
                continue
            latin1_length = _utf8_scan_latin1_16(data, pos)
            if latin1_length != 0:
                pos += 16
                length += latin1_length
                if maxchar < 0xFF:
                    maxchar = 0xFF
                continue
            ascii = _utf8_first_nonascii(mask)
            pos += ascii
            length += ascii

        start = pos
        b0 = int(data[pos])
        if b0 < 0x80:
            cp = b0
            pos += 1
        elif 0xC2 <= b0 <= 0xDF:
            if pos + 1 >= byte_length:
                _raise_utf8_decode_error(pos, pos + 1, "unexpected EOF")
            b1 = int(data[pos + 1])
            if not _is_utf8_continuation(b1):
                _raise_utf8_decode_error(pos + 1, pos + 2, "invalid continuation byte")
            cp = ((b0 & 0x1F) << 6) | (b1 & 0x3F)
            pos += 2
        elif 0xE0 <= b0 <= 0xEF:
            if pos + 2 >= byte_length:
                _raise_utf8_decode_error(pos, pos + 3, "unexpected EOF")
            b1 = int(data[pos + 1])
            b2 = int(data[pos + 2])
            if not _is_utf8_continuation(b1) or not _is_utf8_continuation(b2):
                _raise_utf8_decode_error(pos + 1, pos + 3, "invalid continuation byte")
            cp = ((b0 & 0x0F) << 12) | ((b1 & 0x3F) << 6) | (b2 & 0x3F)
            if cp < 0x800 or _is_surrogate(cp):
                _raise_utf8_decode_error(start, start + 3, "invalid code point")
            pos += 3
        elif 0xF0 <= b0 <= 0xF4:
            if pos + 3 >= byte_length:
                _raise_utf8_decode_error(pos, pos + 4, "unexpected EOF")
            b1 = int(data[pos + 1])
            b2 = int(data[pos + 2])
            b3 = int(data[pos + 3])
            if (
                not _is_utf8_continuation(b1)
                or not _is_utf8_continuation(b2)
                or not _is_utf8_continuation(b3)
            ):
                _raise_utf8_decode_error(pos + 1, pos + 4, "invalid continuation byte")
            cp = (
                ((b0 & 0x07) << 18)
                | ((b1 & 0x3F) << 12)
                | ((b2 & 0x3F) << 6)
                | (b3 & 0x3F)
            )
            if cp < 0x10000 or cp > UNICODE_MAX:
                _raise_utf8_decode_error(start, start + 4, "invalid code point")
            pos += 4
        else:
            _raise_utf8_decode_error(start, start + 1, "invalid start byte")
            cp = 0
            pos += 1
        length += 1

        if cp > maxchar:
            maxchar = cp
            if cp > 0xFFFF:
                return length, maxchar

    return length, maxchar


def _unicode_decode_utf8_strict(
    data: Ptr[u8],
    byte_length: int,
) -> str:
    if byte_length < 0:
        raise ValueError("negative length")

    length, maxchar = _utf8_scan_strict(data, byte_length)
    if maxchar <= 0x7F:
        return str(data, _make_meta(byte_length, KIND_ASCII))

    if maxchar > 0xFFFF:
        output = Ptr[u32](byte_length)
        pos = 0
        out = 0
        while pos < byte_length:
            if pos + 16 <= byte_length:
                mask = _utf8_nonascii_mask16(data, pos)
                if mask == 0:
                    _utf8_widen_ascii16_u32(data, pos, output, out)
                    pos += 16
                    out += 16
                    continue
                ascii = _utf8_first_nonascii(mask)
                while ascii > 0:
                    output[out] = u32(data[pos])
                    pos += 1
                    out += 1
                    ascii -= 1

            while pos + 16 <= byte_length and _utf8_all_fourbyte4(data, pos):
                _utf8_unpack_fourbyte4_u32(data, pos, output, out)
                pos += 16
                out += 4
            if pos == byte_length:
                break

            start = pos
            b0 = int(data[pos])
            if b0 < 0x80:
                cp = b0
                pos += 1
            elif 0xC2 <= b0 <= 0xDF:
                if pos + 1 >= byte_length:
                    _raise_utf8_decode_error(pos, pos + 1, "unexpected EOF")
                b1 = int(data[pos + 1])
                if not _is_utf8_continuation(b1):
                    _raise_utf8_decode_error(pos + 1, pos + 2, "invalid continuation byte")
                cp = ((b0 & 0x1F) << 6) | (b1 & 0x3F)
                pos += 2
            elif 0xE0 <= b0 <= 0xEF:
                if pos + 2 >= byte_length:
                    _raise_utf8_decode_error(pos, pos + 3, "unexpected EOF")
                b1 = int(data[pos + 1])
                b2 = int(data[pos + 2])
                if not _is_utf8_continuation(b1) or not _is_utf8_continuation(b2):
                    _raise_utf8_decode_error(pos + 1, pos + 3, "invalid continuation byte")
                cp = ((b0 & 0x0F) << 12) | ((b1 & 0x3F) << 6) | (b2 & 0x3F)
                if cp < 0x800 or _is_surrogate(cp):
                    _raise_utf8_decode_error(start, start + 3, "invalid code point")
                pos += 3
            elif 0xF0 <= b0 <= 0xF4:
                if pos + 3 >= byte_length:
                    _raise_utf8_decode_error(pos, pos + 4, "unexpected EOF")
                b1 = int(data[pos + 1])
                b2 = int(data[pos + 2])
                b3 = int(data[pos + 3])
                if (
                    not _is_utf8_continuation(b1)
                    or not _is_utf8_continuation(b2)
                    or not _is_utf8_continuation(b3)
                ):
                    _raise_utf8_decode_error(pos + 1, pos + 4, "invalid continuation byte")
                cp = (
                    ((b0 & 0x07) << 18)
                    | ((b1 & 0x3F) << 12)
                    | ((b2 & 0x3F) << 6)
                    | (b3 & 0x3F)
                )
                if cp < 0x10000 or cp > UNICODE_MAX:
                    _raise_utf8_decode_error(start, start + 4, "invalid code point")
                pos += 4
            else:
                _raise_utf8_decode_error(start, start + 1, "invalid start byte")
                cp = 0
                pos += 1
            output[out] = u32(cp)
            out += 1
        return str(Ptr[u8](output), _make_meta(out, KIND_UCS4))

    result = _unicode_new_uninit(length, maxchar)
    kind = result._kind()
    pos = 0
    out = 0

    if kind <= KIND_LATIN1:
        output = result._ptr
        while pos < byte_length:
            if pos + 16 <= byte_length:
                mask = _utf8_nonascii_mask16(data, pos)
                if mask == 0:
                    _utf8_copy_ascii16(data, pos, output, out)
                    pos += 16
                    out += 16
                    continue
                ascii = _utf8_first_nonascii(mask)
                while ascii > 0:
                    output[out] = data[pos]
                    pos += 1
                    out += 1
                    ascii -= 1
            b0 = int(data[pos])
            if b0 < 0x80:
                output[out] = u8(b0)
                pos += 1
            else:
                output[out] = u8(((b0 & 0x1F) << 6) | (int(data[pos + 1]) & 0x3F))
                pos += 2
            out += 1
        return result

    if kind == KIND_UCS2:
        output = Ptr[u16](result._ptr)
        while pos < byte_length:
            if pos + 16 <= byte_length:
                mask = _utf8_nonascii_mask16(data, pos)
                if mask == 0:
                    _utf8_widen_ascii16_u16(data, pos, output, out)
                    pos += 16
                    out += 16
                    continue
                ascii = _utf8_first_nonascii(mask)
                while ascii > 0:
                    output[out] = u16(data[pos])
                    pos += 1
                    out += 1
                    ascii -= 1
            b0 = int(data[pos])
            if b0 < 0x80:
                cp = b0
                pos += 1
            elif b0 < 0xE0:
                cp = ((b0 & 0x1F) << 6) | (int(data[pos + 1]) & 0x3F)
                pos += 2
            else:
                cp = (
                    ((b0 & 0x0F) << 12)
                    | ((int(data[pos + 1]) & 0x3F) << 6)
                    | (int(data[pos + 2]) & 0x3F)
                )
                pos += 3
            output[out] = u16(cp)
            out += 1
        return result

    return result


def _utf8_encoded_width(cp: int) -> int:
    if cp < 0x80:
        return 1
    elif cp < 0x800:
        return 2
    elif cp < 0x10000:
        return 3
    else:
        return 4


def _utf8_size_strict(value: str) -> int:
    size = 0

    for i in range(len(value)):
        size += _utf8_encoded_width(value._load_codepoint(i))

    return size


def _utf8_encode_one(
    output: Ptr[u8],
    pos: int,
    cp: int,
) -> int:
    if cp > UNICODE_MAX or _is_surrogate(cp):
        _raise_utf8_encode_error(0, 0, "invalid code point")

    if cp < 0x80:
        output[pos] = u8(cp)
        return pos + 1

    if cp < 0x800:
        output[pos] = u8(0xC0 | (cp >> 6))
        output[pos + 1] = u8(0x80 | (cp & 0x3F))
        return pos + 2

    if cp < 0x10000:
        output[pos] = u8(0xE0 | (cp >> 12))
        output[pos + 1] = u8(0x80 | ((cp >> 6) & 0x3F))
        output[pos + 2] = u8(0x80 | (cp & 0x3F))
        return pos + 3

    output[pos] = u8(0xF0 | (cp >> 18))
    output[pos + 1] = u8(0x80 | ((cp >> 12) & 0x3F))
    output[pos + 2] = u8(0x80 | ((cp >> 6) & 0x3F))
    output[pos + 3] = u8(0x80 | (cp & 0x3F))

    return pos + 4


class _UnicodeDecodeErrorTracker:
    data: Ptr[int]
    length: int
    capacity: int
    raw_length: int

    def __init__(self):
        self.data = Ptr[int]()
        self.length = 0
        self.capacity = 0
        self.raw_length = 0

    def append(
        self,
        output_start: int,
        output_end: int,
        raw_start: int,
        raw_length: int,
    ):
        if self.length == self.capacity:
            old_capacity = self.capacity
            new_capacity = 4 if old_capacity == 0 else old_capacity * 2
            self.data = (
                Ptr[int](gc.realloc(
                    self.data.as_byte(),
                    new_capacity * 4 * gc.sizeof(int),
                    old_capacity * 4 * gc.sizeof(int),
                ))
                if self.data
                else Ptr[int](new_capacity * 4)
            )
            self.capacity = new_capacity
        self.set(
            self.length,
            output_start,
            output_end,
            raw_start,
            raw_length,
        )
        self.length += 1

    def get(self, index: int) -> Tuple[int, int, int, int]:
        offset = index * 4
        return (
            self.data[offset],
            self.data[offset + 1],
            self.data[offset + 2],
            self.data[offset + 3],
        )

    def set(
        self,
        index: int,
        output_start: int,
        output_end: int,
        raw_start: int,
        raw_length: int,
    ):
        offset = index * 4
        self.data[offset] = output_start
        self.data[offset + 1] = output_end
        self.data[offset + 2] = raw_start
        self.data[offset + 3] = raw_length


class _UnicodeCodecBuffer:
    data: Ptr[u8]
    length: int
    capacity: int
    kind: int
    errors: Optional[_UnicodeDecodeErrorTracker]

    def __init__(
        self,
        capacity: int,
        errors: Optional[_UnicodeDecodeErrorTracker] = None,
    ):
        self.data = Ptr[u8](capacity)
        self.length = 0
        self.capacity = capacity
        self.kind = KIND_ASCII
        self.errors = errors

    def append(self, codepoint: int):
        required = self.length + 1
        new_kind = self.kind
        codepoint_kind = _kind_for_maxchar(codepoint)
        if codepoint_kind > new_kind:
            new_kind = codepoint_kind

        if required > self.capacity or new_kind != self.kind:
            new_capacity = self.capacity
            if new_capacity == 0:
                new_capacity = 1
            while new_capacity < required:
                new_capacity *= 2

            old_kind = self.kind
            self.data = gc.realloc(
                self.data,
                new_capacity * _kind_width(new_kind),
                self.capacity * _kind_width(old_kind),
            )
            if new_kind != old_kind:
                source = str(self.data, _make_meta(self.length, old_kind))
                destination = str(self.data, _make_meta(new_capacity, new_kind))
                for i in range(self.length - 1, -1, -1):
                    destination._store_codepoint(i, source._load_codepoint(i))
            self.capacity = new_capacity
            self.kind = new_kind

        buffer = str(self.data, _make_meta(self.capacity, self.kind))
        buffer._store_codepoint(self.length, codepoint)
        self.length += 1

    def finish(self) -> str:
        if self.length != self.capacity:
            width = _kind_width(self.kind)
            self.data = gc.realloc(
                self.data,
                self.length * width,
                self.capacity * width,
            )
            self.capacity = self.length

        return str(self.data, _make_meta(self.length, self.kind))


class _CodecByteBuffer:
    data: Ptr[u8]
    length: int
    capacity: int

    def __init__(self, capacity: int):
        self.data = Ptr[u8](capacity)
        self.length = 0
        self.capacity = capacity

    def append(self, value: int):
        required = self.length + 1
        if required > self.capacity:
            capacity = self.capacity if self.capacity > 0 else 1
            while capacity < required:
                capacity *= 2

            self.data = gc.realloc(self.data, capacity, self.capacity)
            self.capacity = capacity

        self.data[self.length] = u8(value)
        self.length += 1

    def finish(self) -> bytes:
        if self.length != self.capacity:
            self.data = gc.realloc(
                self.data,
                self.length,
                self.capacity,
            )
            self.capacity = self.length

        return bytes(self.data, self.length)

    def finish_c_str(self) -> cobj:
        required = self.length + 1
        if required != self.capacity:
            self.data = gc.realloc(
                self.data,
                required,
                self.capacity,
            )
            self.capacity = required

        self.data[self.length] = u8(0)
        return self.data.as_byte()


def _unicode_encode_utf8_strict_append(
    value: str,
    output: _CodecByteBuffer,
):
    for i in range(len(value)):
        if _is_surrogate(value._load_codepoint(i)):
            _raise_utf8_encode_error(i, i + 1, "surrogates not allowed")

    for i in range(len(value)):
        codepoint = value._load_codepoint(i)
        if codepoint < 0x80:
            output.append(codepoint)
        elif codepoint < 0x800:
            output.append(0xC0 | (codepoint >> 6))
            output.append(0x80 | (codepoint & 0x3F))
        elif codepoint < 0x10000:
            output.append(0xE0 | (codepoint >> 12))
            output.append(0x80 | ((codepoint >> 6) & 0x3F))
            output.append(0x80 | (codepoint & 0x3F))
        else:
            output.append(0xF0 | (codepoint >> 18))
            output.append(0x80 | ((codepoint >> 12) & 0x3F))
            output.append(0x80 | ((codepoint >> 6) & 0x3F))
            output.append(0x80 | (codepoint & 0x3F))


def _unicode_encode_utf8_strict(value: str) -> bytes:
    if value._is_ascii():
        return bytes(value._ptr, len(value))

    if value._kind() == KIND_LATIN1:
        codepoints = value._ptr
        size = 0
        i = 0
        while i + 16 <= len(value):
            size += _utf8_size16_u8(codepoints, i)
            i += 16
        while i < len(value):
            size += 1 if codepoints[i] < u8(0x80) else 2
            i += 1

        output = Ptr[u8](size)
        pos = 0
        i = 0
        while i < len(value):
            if i + 16 <= len(value):
                mask = _utf8_nonascii_mask16(codepoints, i)
                if mask == 0:
                    _utf8_copy_ascii16(codepoints, i, output, pos)
                    i += 16
                    pos += 16
                    continue
                block_end = i + 16
                while i < block_end:
                    cp = codepoints[i]
                    if cp < u8(0x80):
                        output[pos] = cp
                        pos += 1
                    else:
                        output[pos] = u8(0xC0 | (int(cp) >> 6))
                        output[pos + 1] = u8(0x80 | (int(cp) & 0x3F))
                        pos += 2
                    i += 1
                continue
            cp = codepoints[i]
            if cp < u8(0x80):
                output[pos] = cp
                pos += 1
            else:
                output[pos] = u8(0xC0 | (int(cp) >> 6))
                output[pos + 1] = u8(0x80 | (int(cp) & 0x3F))
                pos += 2
            i += 1
        return bytes(output, size)

    if value._kind() == KIND_UCS2:
        codepoints = Ptr[u16](value._ptr)
        size = 0
        i = 0
        while i + 16 <= len(value):
            block = _utf8_size16_u16(codepoints, i)
            invalid = u16(block >> u64(32))
            if invalid:
                offset = _utf8_first_nonascii(invalid)
                _raise_utf8_encode_error(i + offset, i + offset + 1, "surrogates not allowed")
            size += int(block & u64(0xFFFFFFFF))
            i += 16
        while i < len(value):
            cp = int(codepoints[i])
            if _is_surrogate(cp):
                _raise_utf8_encode_error(i, i + 1, "surrogates not allowed")
            size += _utf8_encoded_width(cp)
            i += 1

        output = Ptr[u8](size)
        pos = 0
        i = 0
        while i < len(value):
            if i + 16 <= len(value):
                mask = _utf8_nonascii_mask16_u16(codepoints, i)
                if mask == 0:
                    _utf8_pack_ascii16_u16(codepoints, i, output, pos)
                    i += 16
                    pos += 16
                    continue
                ascii = _utf8_first_nonascii(mask)
                while ascii > 0:
                    output[pos] = u8(codepoints[i])
                    i += 1
                    pos += 1
                    ascii -= 1
            pos = _utf8_encode_one(output, pos, int(codepoints[i]))
            i += 1
        return bytes(output, size)

    if value._kind() == KIND_UCS4:
        codepoints = Ptr[u32](value._ptr)
        size = 0
        i = 0
        while i + 16 <= len(value):
            block = _utf8_size16_u32(codepoints, i)
            invalid = u16(block >> u64(32))
            if invalid:
                offset = _utf8_first_nonascii(invalid)
                _raise_utf8_encode_error(i + offset, i + offset + 1, "surrogates not allowed")
            size += int(block & u64(0xFFFFFFFF))
            i += 16
        while i < len(value):
            cp = int(codepoints[i])
            if cp > UNICODE_MAX or _is_surrogate(cp):
                _raise_utf8_encode_error(i, i + 1, "surrogates not allowed")
            size += _utf8_encoded_width(cp)
            i += 1

        output = Ptr[u8](size)
        pos = 0
        i = 0
        while i < len(value):
            if i + 16 <= len(value):
                mask = _utf8_nonascii_mask16_u32(codepoints, i)
                if mask == 0:
                    _utf8_pack_ascii16_u32(codepoints, i, output, pos)
                    i += 16
                    pos += 16
                    continue
                ascii = _utf8_first_nonascii(mask)
                while ascii > 0:
                    output[pos] = u8(codepoints[i])
                    i += 1
                    pos += 1
                    ascii -= 1
            while i + 4 <= len(value) and _utf8_all_fourbyte4_u32(codepoints, i):
                _utf8_pack_fourbyte4_u32(codepoints, i, output, pos)
                i += 4
                pos += 16
            if i == len(value):
                break
            pos = _utf8_encode_one(output, pos, int(codepoints[i]))
            i += 1
        return bytes(output, size)

    size = 0
    for i in range(len(value)):
        cp = value._load_codepoint(i)
        if _is_surrogate(cp):
            _raise_utf8_encode_error(i, i + 1, "surrogates not allowed")
        size += _utf8_encoded_width(cp)

    output = Ptr[u8](size)
    pos = 0
    for i in range(len(value)):
        pos = _utf8_encode_one(output, pos, value._load_codepoint(i))
    return bytes(output, size)


def _unicode_encode_utf8_c_str(value: str) -> cobj:
    output = _CodecByteBuffer(len(value) + 1)
    _unicode_encode_utf8_strict_append(value, output)
    return output.finish_c_str()


def _unicode_encode_utf8(value: str, errors: int) -> bytes:
    if value._is_ascii():
        return bytes(value._ptr, len(value))

    if errors == _ERROR_STRICT:
        return _unicode_encode_utf8_strict(value)

    output = _CodecByteBuffer(len(value))

    for i in range(len(value)):
        codepoint = value._load_codepoint(i)

        if _is_surrogate(codepoint):
            if errors == _ERROR_SURROGATEPASS:
                output.append(0xE0 | (codepoint >> 12))
                output.append(0x80 | ((codepoint >> 6) & 0x3F))
                output.append(0x80 | (codepoint & 0x3F))
                continue

            if errors == _ERROR_SURROGATEESCAPE and 0xDC80 <= codepoint <= 0xDCFF:
                output.append(codepoint - 0xDC00)
                continue

            _codec_encode_error_append(output, codepoint, errors)
            continue

        if codepoint < 0x80:
            output.append(codepoint)
        elif codepoint < 0x800:
            output.append(0xC0 | (codepoint >> 6))
            output.append(0x80 | (codepoint & 0x3F))
        elif codepoint < 0x10000:
            output.append(0xE0 | (codepoint >> 12))
            output.append(0x80 | ((codepoint >> 6) & 0x3F))
            output.append(0x80 | (codepoint & 0x3F))
        else:
            output.append(0xF0 | (codepoint >> 18))
            output.append(0x80 | ((codepoint >> 12) & 0x3F))
            output.append(0x80 | ((codepoint >> 6) & 0x3F))
            output.append(0x80 | (codepoint & 0x3F))

    return output.finish()


def _unicode_from_text(value: bytes) -> str:
    return _unicode_decode_utf8_strict(value._ptr, len(value))


def _is_encoding_separator(cp: int) -> bool:
    return cp == 0x20 or cp == 0x2D or cp == 0x5F


def _encoding_matches(encoding: str, target: str) -> bool:
    i = 0
    j = 0

    while True:
        while i < len(encoding) and _is_encoding_separator(encoding._load_codepoint(i)):
            i += 1
        while j < len(target) and _is_encoding_separator(target._load_codepoint(j)):
            j += 1

        if i == len(encoding) or j == len(target):
            while i < len(encoding) and _is_encoding_separator(encoding._load_codepoint(i)):
                i += 1
            while j < len(target) and _is_encoding_separator(target._load_codepoint(j)):
                j += 1
            return i == len(encoding) and j == len(target)

        left = encoding._load_codepoint(i)
        right = target._load_codepoint(j)
        if 0x41 <= left <= 0x5A:
            left += 0x20
        if 0x41 <= right <= 0x5A:
            right += 0x20
        if left != right:
            return False

        i += 1
        j += 1


def _encoding_code(encoding: str) -> int:
    if _encoding_matches(encoding, "utf-8") or _encoding_matches(encoding, "utf8"):
        return _ENCODING_UTF8
    if _encoding_matches(encoding, "ascii") or _encoding_matches(encoding, "us-ascii"):
        return _ENCODING_ASCII
    if _encoding_matches(encoding, "latin-1") or _encoding_matches(encoding, "latin1") or _encoding_matches(encoding, "iso-8859-1"):
        return _ENCODING_LATIN1
    if _encoding_matches(encoding, "cp1252") or _encoding_matches(encoding, "windows-1252") or _encoding_matches(encoding, "windows1252"):
        return _ENCODING_CP1252
    if _encoding_matches(encoding, "cp1251") or _encoding_matches(encoding, "windows-1251") or _encoding_matches(encoding, "windows1251"):
        return _ENCODING_CP1251
    if _encoding_matches(encoding, "cp1250") or _encoding_matches(encoding, "windows-1250") or _encoding_matches(encoding, "windows1250"):
        return _ENCODING_CP1250
    if _encoding_matches(encoding, "cp1253") or _encoding_matches(encoding, "windows-1253") or _encoding_matches(encoding, "windows1253"):
        return _ENCODING_CP1253
    if _encoding_matches(encoding, "cp1254") or _encoding_matches(encoding, "windows-1254") or _encoding_matches(encoding, "windows1254"):
        return _ENCODING_CP1254
    if _encoding_matches(encoding, "iso-8859-15") or _encoding_matches(encoding, "iso8859-15") or _encoding_matches(encoding, "latin-9") or _encoding_matches(encoding, "latin9"):
        return _ENCODING_ISO8859_15
    if _encoding_matches(encoding, "utf-16") or _encoding_matches(encoding, "utf16"):
        return _ENCODING_UTF16
    if _encoding_matches(encoding, "utf-16-le") or _encoding_matches(encoding, "utf16le"):
        return _ENCODING_UTF16_LE
    if _encoding_matches(encoding, "utf-16-be") or _encoding_matches(encoding, "utf16be"):
        return _ENCODING_UTF16_BE
    if _encoding_matches(encoding, "utf-32") or _encoding_matches(encoding, "utf32"):
        return _ENCODING_UTF32
    if _encoding_matches(encoding, "utf-32-le") or _encoding_matches(encoding, "utf32le"):
        return _ENCODING_UTF32_LE
    if _encoding_matches(encoding, "utf-32-be") or _encoding_matches(encoding, "utf32be"):
        return _ENCODING_UTF32_BE
    return _ENCODING_UNKNOWN

def _error_code(errors: str) -> int:
    if errors == "strict":
        return _ERROR_STRICT
    if errors == "ignore":
        return _ERROR_IGNORE
    if errors == "replace":
        return _ERROR_REPLACE
    if errors == "surrogatepass":
        return _ERROR_SURROGATEPASS
    if errors == "surrogateescape":
        return _ERROR_SURROGATEESCAPE
    if errors == "backslashreplace":
        return _ERROR_BACKSLASHREPLACE
    if errors == "xmlcharrefreplace":
        return _ERROR_XMLCHARREFREPLACE
    if errors == "namereplace":
        return _ERROR_NAMEREPLACE
    return _ERROR_UNKNOWN


def _codec_error_append(
    output: _UnicodeCodecBuffer,
    data: Ptr[u8],
    start: int,
    end: int,
    errors: int,
):
    if errors == _ERROR_STRICT:
        raise ValueError("invalid byte sequence")

    if errors == _ERROR_IGNORE:
        if output.errors is not None:
            output.errors.append(output.length, output.length, start, end - start)
        return

    if errors == _ERROR_REPLACE:
        output_start = output.length
        output.append(0xFFFD)
        if output.errors is not None:
            output.errors.append(output_start, output.length, start, end - start)
        return

    if errors == _ERROR_SURROGATEESCAPE:
        for i in range(start, end):
            byte = int(data[i])
            if byte < 0x80:
                raise ValueError("invalid byte sequence")
            output.append(0xDC00 + byte)
        return

    if errors == _ERROR_BACKSLASHREPLACE:
        output_start = output.length
        for i in range(start, end):
            byte = int(data[i])
            output.append(0x5C)  # \
            output.append(0x78)  # x
            high = byte >> 4
            output.append(0x30 + high if high < 10 else 0x61 + high - 10)
            digit = byte & 0xF
            output.append(0x30 + digit if digit < 10 else 0x61 + digit - 10)
        if output.errors is not None:
            output.errors.append(output_start, output.length, start, end - start)
        return

    if errors == _ERROR_XMLCHARREFREPLACE or errors == _ERROR_NAMEREPLACE:
        raise TypeError("unsupported Unicode decode error handler")

    if errors == _ERROR_UNKNOWN:
        raise LookupError("unknown error handler")

    raise ValueError("unsupported error handling")


def _unicode_decode_utf8(
    data: Ptr[u8],
    byte_length: int,
    errors: int,
    tracker: Optional[_UnicodeDecodeErrorTracker] = None,
) -> str:
    output = _UnicodeCodecBuffer(byte_length, tracker)
    pos = 0

    while pos < byte_length:
        start = pos
        b0 = int(data[pos])

        if b0 < 0x80:
            output.append(b0)
            pos += 1
            continue

        if 0xC2 <= b0 <= 0xDF:
            width = 2
        elif 0xE0 <= b0 <= 0xEF:
            width = 3
        elif 0xF0 <= b0 <= 0xF4:
            width = 4
        else:
            _codec_error_append(output, data, start, start + 1, errors)
            pos += 1
            continue

        if pos + 1 >= byte_length:
            _codec_error_append(output, data, start, byte_length, errors)
            break

        b1 = int(data[pos + 1])
        if (
            not _is_utf8_continuation(b1)
            or (b0 == 0xE0 and b1 < 0xA0)
            or (b0 == 0xED and b1 > 0x9F and errors != _ERROR_SURROGATEPASS)
            or (b0 == 0xF0 and b1 < 0x90)
            or (b0 == 0xF4 and b1 > 0x8F)
        ):
            _codec_error_append(output, data, start, start + 1, errors)
            pos += 1
            continue

        if width >= 3:
            if pos + 2 >= byte_length:
                _codec_error_append(output, data, start, byte_length, errors)
                break
            b2 = int(data[pos + 2])
            if not _is_utf8_continuation(b2):
                _codec_error_append(output, data, start, start + 2, errors)
                pos += 2
                continue

        if width == 4:
            if pos + 3 >= byte_length:
                _codec_error_append(output, data, start, byte_length, errors)
                break
            b3 = int(data[pos + 3])
            if not _is_utf8_continuation(b3):
                _codec_error_append(output, data, start, start + 3, errors)
                pos += 3
                continue

        codepoint = b0 & (0x7F >> width)
        for i in range(1, width):
            codepoint = (codepoint << 6) | (int(data[pos + i]) & 0x3F)

        output.append(codepoint)
        pos += width

    return output.finish()


def _unicode_decode_single_byte(
    data: Ptr[u8],
    byte_length: int,
    ascii: bool,
    errors: int,
    tracker: Optional[_UnicodeDecodeErrorTracker] = None,
) -> str:
    output = _UnicodeCodecBuffer(byte_length, tracker)

    for i in range(byte_length):
        byte = int(data[i])
        if ascii and byte > 0x7F:
                _codec_error_append(output, data, i, i + 1, errors)
        else:
                output.append(byte)

    return output.finish()


@pure
@llvm
def _cp1252_c1_codepoint(index: int) -> i32:
    @data = private unnamed_addr constant [32 x i32] [i32 8364, i32 -1, i32 8218, i32 402, i32 8222, i32 8230, i32 8224, i32 8225, i32 710, i32 8240, i32 352, i32 8249, i32 338, i32 -1, i32 381, i32 -1, i32 -1, i32 8216, i32 8217, i32 8220, i32 8221, i32 8226, i32 8211, i32 8212, i32 732, i32 8482, i32 353, i32 8250, i32 339, i32 -1, i32 382, i32 376]
    %p = getelementptr inbounds [32 x i32], ptr @data, i64 0, i64 %index
    %x = load i32, ptr %p, align 4
    ret i32 %x


@pure
@llvm
def _cp1252_c1_byte(codepoint: int) -> i32:
    @data = private unnamed_addr constant [64 x i64] [i64 0, i64 96415, i64 2141312, i64 0, i64 0, i64 0, i64 0, i64 2107013, i64 0, i64 0, i64 97678, i64 0, i64 97950, i64 0, i64 0, i64 0, i64 0, i64 0, i64 0, i64 0, i64 90250, i64 90522, i64 0, i64 0, i64 0, i64 0, i64 2109577, i64 0, i64 187544, i64 0, i64 0, i64 2171545, i64 0, i64 0, i64 0, i64 2102166, i64 0, i64 2102423, i64 0, i64 0, i64 0, i64 0, i64 2111883, i64 0, i64 2112155, i64 2103441, i64 2103698, i64 0, i64 2103938, i64 103043, i64 0, i64 181896, i64 2104467, i64 0, i64 2104724, i64 0, i64 2104964, i64 86668, i64 0, i64 86940, i64 2105478, i64 2105735, i64 0, i64 2106005]
    %product = mul i64 %codepoint, 15
    %shifted = lshr i64 %product, 3
    %index = and i64 %shifted, 63
    %p = getelementptr inbounds [64 x i64], ptr @data, i64 0, i64 %index
    %packed = load i64, ptr %p, align 8
    %stored = lshr i64 %packed, 8
    %matched = icmp eq i64 %stored, %codepoint
    %byte = trunc i64 %packed to i32
    %result = select i1 %matched, i32 %byte, i32 -1
    ret i32 %result


@pure
@llvm
def _cp1251_c1_codepoint(index: int) -> i32:
    @data = private unnamed_addr constant [64 x i32] [i32 1026, i32 1027, i32 8218, i32 1107, i32 8222, i32 8230, i32 8224, i32 8225, i32 8364, i32 8240, i32 1033, i32 8249, i32 1034, i32 1036, i32 1035, i32 1039, i32 1106, i32 8216, i32 8217, i32 8220, i32 8221, i32 8226, i32 8211, i32 8212, i32 -1, i32 8482, i32 1113, i32 8250, i32 1114, i32 1116, i32 1115, i32 1119, i32 160, i32 1038, i32 1118, i32 1032, i32 164, i32 1168, i32 166, i32 167, i32 1025, i32 169, i32 1028, i32 171, i32 172, i32 173, i32 174, i32 1031, i32 176, i32 177, i32 1030, i32 1110, i32 1169, i32 181, i32 182, i32 183, i32 1105, i32 8470, i32 1108, i32 187, i32 1112, i32 1029, i32 1109, i32 1111]
    %p = getelementptr inbounds [64 x i32], ptr @data, i64 0, i64 %index
    %x = load i32, ptr %p, align 4
    ret i32 %x


@pure
@llvm
def _cp1251_c1_byte(codepoint: int) -> i32:
    @data = private unnamed_addr constant [128 x i64] [i64 44718, i64 2168505, i64 263041, i64 0, i64 2141320, i64 2105478, i64 284860, i64 0, i64 48059, i64 0, i64 0, i64 0, i64 2104467, i64 283834, i64 0, i64 42662, i64 47031, i64 265357, i64 0, i64 2103441, i64 0, i64 2112155, i64 0, i64 0, i64 0, i64 264355, i64 0, i64 2102423, i64 0, i64 0, i64 0, i64 299173, i64 263338, i64 0, i64 0, i64 2105735, i64 285082, i64 0, i64 43947, i64 0, i64 0, i64 0, i64 2104724, i64 284094, i64 0, i64 42919, i64 0, i64 0, i64 0, i64 0, i64 2103698, i64 0, i64 0, i64 0, i64 0, i64 264586, i64 0, i64 0, i64 2107013, i64 286370, i64 45232, i64 299444, i64 263613, i64 0, i64 0, i64 2106005, i64 285340, i64 0, i64 44204, i64 0, i64 0, i64 0, i64 2104964, i64 0, i64 284339, i64 0, i64 0, i64 0, i64 265889, i64 0, i64 2103938, i64 283280, i64 42148, i64 46517, i64 0, i64 264844, i64 0, i64 0, i64 0, i64 286623, i64 41120, i64 45489, i64 263858, i64 0, i64 0, i64 0, i64 285598, i64 0, i64 44461, i64 0, i64 262784, i64 0, i64 0, i64 2109577, i64 284607, i64 43433, i64 0, i64 2171545, i64 266127, i64 0, i64 0, i64 283523, i64 0, i64 46774, i64 0, i64 265102, i64 0, i64 0, i64 0, i64 2111883, i64 0, i64 0, i64 0, i64 264111, i64 0, i64 2102166, i64 0, i64 285853]
    %product = mul i64 %codepoint, 3861
    %shifted = lshr i64 %product, 7
    %index = and i64 %shifted, 127
    %p = getelementptr inbounds [128 x i64], ptr @data, i64 0, i64 %index
    %packed = load i64, ptr %p, align 8
    %stored = lshr i64 %packed, 8
    %matched = icmp eq i64 %stored, %codepoint
    %byte = trunc i64 %packed to i32
    %result = select i1 %matched, i32 %byte, i32 -1
    ret i32 %result


def _unicode_decode_cp1252(
    data: Ptr[u8],
    byte_length: int,
    errors: int,
    tracker: Optional[_UnicodeDecodeErrorTracker] = None,
) -> str:
    output = _UnicodeCodecBuffer(byte_length, tracker)

    for i in range(byte_length):
        byte = int(data[i])
        codepoint = byte
        if 0x80 <= byte <= 0x9F:
            codepoint = int(_cp1252_c1_codepoint(byte - 0x80))

        if codepoint < 0:
            _codec_error_append(output, data, i, i + 1, errors)
        else:
            output.append(codepoint)

    return output.finish()


def _unicode_decode_cp1251(
    data: Ptr[u8],
    byte_length: int,
    errors: int,
    tracker: Optional[_UnicodeDecodeErrorTracker] = None,
) -> str:
    output = _UnicodeCodecBuffer(byte_length, tracker)

    for i in range(byte_length):
        byte = int(data[i])
        if byte < 0x80:
            codepoint = byte
        elif byte >= 0xC0:
            codepoint = 0x0410 + byte - 0xC0
        else:
            codepoint = int(_cp1251_c1_codepoint(byte - 0x80))

        if codepoint < 0:
            _codec_error_append(output, data, i, i + 1, errors)
        else:
            output.append(codepoint)

    return output.finish()


def _unicode_decode_cp1250(
    data: Ptr[u8],
    byte_length: int,
    errors: int,
    tracker: Optional[_UnicodeDecodeErrorTracker] = None,
) -> str:
    output = _UnicodeCodecBuffer(byte_length, tracker)

    for i in range(byte_length):
        codepoint = int(_single_byte_cp1250_decode(int(data[i])))
        if codepoint < 0:
            _codec_error_append(output, data, i, i + 1, errors)
        else:
            output.append(codepoint)

    return output.finish()


def _unicode_decode_cp1253(
    data: Ptr[u8],
    byte_length: int,
    errors: int,
    tracker: Optional[_UnicodeDecodeErrorTracker] = None,
) -> str:
    output = _UnicodeCodecBuffer(byte_length, tracker)

    for i in range(byte_length):
        codepoint = int(_single_byte_cp1253_decode(int(data[i])))
        if codepoint < 0:
            _codec_error_append(output, data, i, i + 1, errors)
        else:
            output.append(codepoint)

    return output.finish()


def _unicode_decode_cp1254(
    data: Ptr[u8],
    byte_length: int,
    errors: int,
    tracker: Optional[_UnicodeDecodeErrorTracker] = None,
) -> str:
    output = _UnicodeCodecBuffer(byte_length, tracker)

    for i in range(byte_length):
        codepoint = int(_single_byte_cp1254_decode(int(data[i])))
        if codepoint < 0:
            _codec_error_append(output, data, i, i + 1, errors)
        else:
            output.append(codepoint)

    return output.finish()


def _iso8859_15_decode_codepoint(byte: int) -> int:
    if byte == 0xA4:
        return 0x20AC
    if byte == 0xA6:
        return 0x0160
    if byte == 0xA8:
        return 0x0161
    if byte == 0xB4:
        return 0x017D
    if byte == 0xB8:
        return 0x017E
    if byte == 0xBC:
        return 0x0152
    if byte == 0xBD:
        return 0x0153
    if byte == 0xBE:
        return 0x0178
    return byte


def _unicode_decode_iso8859_15(data: Ptr[u8], byte_length: int) -> str:
    output = _UnicodeCodecBuffer(byte_length)

    for i in range(byte_length):
        output.append(_iso8859_15_decode_codepoint(int(data[i])))

    return output.finish()


def _unicode_decode_utf16(
    data: Ptr[u8],
    byte_length: int,
    little_endian: bool,
    detect_bom: bool,
    errors: int,
    tracker: Optional[_UnicodeDecodeErrorTracker] = None,
) -> str:
    output = _UnicodeCodecBuffer(byte_length, tracker)
    pos = 0

    if detect_bom and byte_length >= 2:
        bom = int(data[0]) | (int(data[1]) << 8)
        if bom == 0xFEFF:
            little_endian = True
            pos = 2
        elif bom == 0xFFFE:
            little_endian = False
            pos = 2

    while pos < byte_length:
        if pos + 2 > byte_length:
            _codec_error_append(output, data, pos, byte_length, errors)
            break

        if little_endian:
            unit = int(data[pos]) | (int(data[pos + 1]) << 8)
        else:
            unit = (int(data[pos]) << 8) | int(data[pos + 1])

        if 0xD800 <= unit <= 0xDBFF:
            if pos + 4 <= byte_length:
                if little_endian:
                    low = int(data[pos + 2]) | (int(data[pos + 3]) << 8)
                else:
                    low = (int(data[pos + 2]) << 8) | int(data[pos + 3])

                if 0xDC00 <= low <= 0xDFFF:
                    output.append(0x10000 + ((unit - 0xD800) << 10) + low - 0xDC00)
                    pos += 4
                    continue

            if errors == _ERROR_SURROGATEPASS:
                output.append(unit)
            else:
                _codec_error_append(output, data, pos, pos + 2, errors)
        elif 0xDC00 <= unit <= 0xDFFF:
            if errors == _ERROR_SURROGATEPASS:
                output.append(unit)
            else:
                _codec_error_append(output, data, pos, pos + 2, errors)
        else:
            output.append(unit)

        pos += 2

    return output.finish()


def _unicode_decode_utf32(
    data: Ptr[u8],
    byte_length: int,
    little_endian: bool,
    detect_bom: bool,
    errors: int,
    tracker: Optional[_UnicodeDecodeErrorTracker] = None,
) -> str:
    output = _UnicodeCodecBuffer(byte_length, tracker)
    pos = 0

    if detect_bom and byte_length >= 4:
        bom = (
            int(data[0])
            | (int(data[1]) << 8)
            | (int(data[2]) << 16)
            | (int(data[3]) << 24)
        )
        if bom == 0x0000FEFF:
            little_endian = True
            pos = 4
        elif bom == 0xFFFE0000:
            little_endian = False
            pos = 4

    while pos < byte_length:
        if pos + 4 > byte_length:
            _codec_error_append(output, data, pos, byte_length, errors)
            break

        if little_endian:
            codepoint = (
                int(data[pos])
                | (int(data[pos + 1]) << 8)
                | (int(data[pos + 2]) << 16)
                | (int(data[pos + 3]) << 24)
            )
        else:
            codepoint = (
                (int(data[pos]) << 24)
                | (int(data[pos + 1]) << 16)
                | (int(data[pos + 2]) << 8)
                | int(data[pos + 3])
            )

        if codepoint > UNICODE_MAX or (
            _is_surrogate(codepoint) and errors != _ERROR_SURROGATEPASS
        ):
            _codec_error_append(output, data, pos, pos + 4, errors)
        else:
            output.append(codepoint)

        pos += 4

    return output.finish()


def _unicode_decode_ptr(
    data: Ptr[u8],
    length: int,
    encoding: int,
    errors: int,
    tracker: Optional[_UnicodeDecodeErrorTracker] = None,
) -> str:
    if encoding == _ENCODING_UTF8:
        if errors == _ERROR_STRICT:
            return _unicode_decode_utf8_strict(data, length)
        return _unicode_decode_utf8(data, length, errors, tracker)
    if encoding == _ENCODING_ASCII:
        return _unicode_decode_single_byte(data, length, True, errors, tracker)
    if encoding == _ENCODING_LATIN1:
        return _unicode_decode_single_byte(data, length, False, errors, tracker)
    if encoding == _ENCODING_CP1252:
        return _unicode_decode_cp1252(data, length, errors, tracker)
    if encoding == _ENCODING_CP1251:
        return _unicode_decode_cp1251(data, length, errors, tracker)
    if encoding == _ENCODING_CP1250:
        return _unicode_decode_cp1250(data, length, errors, tracker)
    if encoding == _ENCODING_CP1253:
        return _unicode_decode_cp1253(data, length, errors, tracker)
    if encoding == _ENCODING_CP1254:
        return _unicode_decode_cp1254(data, length, errors, tracker)
    if encoding == _ENCODING_ISO8859_15:
        return _unicode_decode_iso8859_15(data, length)
    if encoding == _ENCODING_UTF16:
        return _unicode_decode_utf16(data, length, _native_is_little_endian(), True, errors, tracker)
    if encoding == _ENCODING_UTF16_LE:
        return _unicode_decode_utf16(data, length, True, False, errors, tracker)
    if encoding == _ENCODING_UTF16_BE:
        return _unicode_decode_utf16(data, length, False, False, errors, tracker)
    if encoding == _ENCODING_UTF32:
        return _unicode_decode_utf32(data, length, _native_is_little_endian(), True, errors, tracker)
    if encoding == _ENCODING_UTF32_LE:
        return _unicode_decode_utf32(data, length, True, False, errors, tracker)
    if encoding == _ENCODING_UTF32_BE:
        return _unicode_decode_utf32(data, length, False, False, errors, tracker)

    raise LookupError("unknown encoding")

def _unicode_decode_codec(
    data: bytes,
    encoding: str,
    errors: str,
) -> str:
    encoding_code = _encoding_code(encoding)
    if encoding_code == _ENCODING_UNKNOWN:
        raise LookupError("unknown encoding: " + encoding)

    if encoding_code == _ENCODING_LATIN1:
        return str(data._ptr, _make_meta(len(data), KIND_LATIN1))

    return _unicode_decode_ptr(data._ptr, len(data), encoding_code, _error_code(errors))


def _codec_encode_ascii_append(
    output: _CodecByteBuffer,
    codepoint: int,
    width: int,
    little_endian: bool,
):
    if width == 1:
        output.append(codepoint)
    elif width == 2:
        if little_endian:
            output.append(codepoint)
            output.append(0)
        else:
            output.append(0)
            output.append(codepoint)
    else:
        if little_endian:
            output.append(codepoint)
            output.append(0)
            output.append(0)
            output.append(0)
        else:
            output.append(0)
            output.append(0)
            output.append(0)
            output.append(codepoint)


def _codec_encode_backslashreplace_append(
    output: _CodecByteBuffer,
    codepoint: int,
    width: int = 1,
    little_endian: bool = True,
):
    _codec_encode_ascii_append(output, 0x5C, width, little_endian)  # \
    if codepoint <= 0xFF:
        _codec_encode_ascii_append(output, 0x78, width, little_endian)  # x
        digits = 2
    elif codepoint <= 0xFFFF:
        _codec_encode_ascii_append(output, 0x75, width, little_endian)  # u
        digits = 4
    else:
        _codec_encode_ascii_append(output, 0x55, width, little_endian)  # U
        digits = 8

    for i in range(digits - 1, -1, -1):
        digit = (codepoint >> (i * 4)) & 0xF
        _codec_encode_ascii_append(
            output,
            0x30 + digit if digit < 10 else 0x61 + digit - 10,
            width,
            little_endian,
        )


def _codec_encode_error_append(
    output: _CodecByteBuffer,
    codepoint: int,
    errors: int,
    allow_surrogateescape: bool = False,
    width: int = 1,
    little_endian: bool = True,
):
    if errors == _ERROR_STRICT or errors == _ERROR_SURROGATEPASS:
        _raise_utf8_encode_error(0, 0, "code point not encodable")

    if errors == _ERROR_IGNORE:
        return

    if errors == _ERROR_REPLACE:
        _codec_encode_ascii_append(output, 0x3F, width, little_endian)  # ?
        return

    if errors == _ERROR_SURROGATEESCAPE:
        if allow_surrogateescape and 0xDC80 <= codepoint <= 0xDCFF:
            output.append(codepoint - 0xDC00)
            return
        _raise_utf8_encode_error(0, 0, "code point not encodable")

    if errors == _ERROR_BACKSLASHREPLACE:
        _codec_encode_backslashreplace_append(
            output, codepoint, width, little_endian
        )
        return

    if errors == _ERROR_XMLCHARREFREPLACE:
        _codec_encode_ascii_append(output, 0x26, width, little_endian)  # &
        _codec_encode_ascii_append(output, 0x23, width, little_endian)  # #
        divisor = 1
        while codepoint // divisor >= 10:
            divisor *= 10
        while divisor > 0:
            _codec_encode_ascii_append(
                output, 0x30 + codepoint // divisor, width, little_endian
            )
            codepoint %= divisor
            divisor //= 10
        _codec_encode_ascii_append(output, 0x3B, width, little_endian)  # ;
        return

    if errors == _ERROR_NAMEREPLACE:
        from internal.unicode.unicodedata_data import (
            unicode_name_record_index,
            unicode_name_value,
        )

        name_index = unicode_name_record_index(codepoint)
        if name_index < 0:
            _codec_encode_backslashreplace_append(
                output, codepoint, width, little_endian
            )
            return
        _codec_encode_ascii_append(output, 0x5C, width, little_endian)  # \
        _codec_encode_ascii_append(output, 0x4E, width, little_endian)  # N
        _codec_encode_ascii_append(output, 0x7B, width, little_endian)  # {
        name = unicode_name_value(name_index)
        for character in name:
            _codec_encode_ascii_append(
                output, ord(character), width, little_endian
            )
        _codec_encode_ascii_append(output, 0x7D, width, little_endian)  # }
        return

    if errors == _ERROR_UNKNOWN:
        raise LookupError("unknown error handler")

    raise ValueError("unsupported error handling")


def _unicode_encode_single_byte(
    value: str,
    ascii: bool,
    errors: int,
) -> bytes:
    if value._kind() <= KIND_LATIN1:
        if not ascii or value._is_ascii():
            return bytes(value._ptr, len(value))

    output = _CodecByteBuffer(len(value))
    limit = 0x7F if ascii else 0xFF

    for i in range(len(value)):
        codepoint = value._load_codepoint(i)
        if codepoint > limit:
            _codec_encode_error_append(output, codepoint, errors, True)
        else:
            output.append(codepoint)

    return output.finish()


def _unicode_encode_cp1252(value: str, errors: int) -> bytes:
    output = _CodecByteBuffer(len(value))

    for i in range(len(value)):
        codepoint = value._load_codepoint(i)
        byte = -1

        if codepoint <= 0x7F or 0xA0 <= codepoint <= 0xFF:
            byte = codepoint
        else:
            byte = int(_cp1252_c1_byte(codepoint))

        if byte < 0:
            _codec_encode_error_append(output, codepoint, errors, True)
        else:
            output.append(byte)

    return output.finish()


def _unicode_encode_cp1251(value: str, errors: int) -> bytes:
    output = _CodecByteBuffer(len(value))

    for i in range(len(value)):
        codepoint = value._load_codepoint(i)
        byte = -1

        if codepoint <= 0x7F:
            byte = codepoint
        elif 0x0410 <= codepoint <= 0x044F:
            byte = codepoint - 0x0410 + 0xC0
        elif codepoint == 0x0401:
            byte = 0xA8
        elif codepoint == 0x0451:
            byte = 0xB8
        else:
            byte = int(_cp1251_c1_byte(codepoint))

        if byte < 0:
            _codec_encode_error_append(output, codepoint, errors, True)
        else:
            output.append(byte)

    return output.finish()


def _unicode_encode_cp1250(value: str, errors: int) -> bytes:
    output = _CodecByteBuffer(len(value))

    for i in range(len(value)):
        codepoint = value._load_codepoint(i)
        byte = codepoint if codepoint <= 0x7F else int(_single_byte_cp1250_encode(codepoint))
        if byte < 0:
            _codec_encode_error_append(output, codepoint, errors, True)
        else:
            output.append(byte)

    return output.finish()


def _unicode_encode_cp1253(value: str, errors: int) -> bytes:
    output = _CodecByteBuffer(len(value))

    for i in range(len(value)):
        codepoint = value._load_codepoint(i)
        byte = codepoint if codepoint <= 0x7F else int(_single_byte_cp1253_encode(codepoint))
        if byte < 0:
            _codec_encode_error_append(output, codepoint, errors, True)
        else:
            output.append(byte)

    return output.finish()


def _unicode_encode_cp1254(value: str, errors: int) -> bytes:
    output = _CodecByteBuffer(len(value))

    for i in range(len(value)):
        codepoint = value._load_codepoint(i)
        byte = codepoint if codepoint <= 0x7F else int(_single_byte_cp1254_encode(codepoint))
        if byte < 0:
            _codec_encode_error_append(output, codepoint, errors, True)
        else:
            output.append(byte)

    return output.finish()


def _iso8859_15_encode_byte(codepoint: int) -> int:
    if codepoint == 0x20AC:
        return 0xA4
    if codepoint == 0x0160:
        return 0xA6
    if codepoint == 0x0161:
        return 0xA8
    if codepoint == 0x017D:
        return 0xB4
    if codepoint == 0x017E:
        return 0xB8
    if codepoint == 0x0152:
        return 0xBC
    if codepoint == 0x0153:
        return 0xBD
    if codepoint == 0x0178:
        return 0xBE
    if (
        codepoint <= 0xFF
        and codepoint != 0xA4
        and codepoint != 0xA6
        and codepoint != 0xA8
        and codepoint != 0xB4
        and codepoint != 0xB8
        and codepoint != 0xBC
        and codepoint != 0xBD
        and codepoint != 0xBE
    ):
        return codepoint
    return -1


def _unicode_encode_iso8859_15(value: str, errors: int) -> bytes:
    output = _CodecByteBuffer(len(value))

    for i in range(len(value)):
        byte = _iso8859_15_encode_byte(value._load_codepoint(i))
        if byte < 0:
            _codec_encode_error_append(output, value._load_codepoint(i), errors, True)
        else:
            output.append(byte)

    return output.finish()


def _unicode_encode_utf16(
    value: str,
    little_endian: bool,
    bom: bool,
    errors: int,
) -> bytes:
    capacity = (len(value) * 2) + (2 if bom else 0)
    output = _CodecByteBuffer(capacity)

    if bom:
        if little_endian:
            output.append(0xFF)
            output.append(0xFE)
        else:
            output.append(0xFE)
            output.append(0xFF)

    for i in range(len(value)):
        codepoint = value._load_codepoint(i)
        if _is_surrogate(codepoint) and errors != _ERROR_SURROGATEPASS:
            _codec_encode_error_append(
                output, codepoint, errors, False, 2, little_endian
            )
            continue
        if codepoint <= 0xFFFF:
            if little_endian:
                output.append(codepoint & 0xFF)
                output.append(codepoint >> 8)
            else:
                output.append(codepoint >> 8)
                output.append(codepoint & 0xFF)
            continue

        scalar = codepoint - 0x10000
        high = 0xD800 + (scalar >> 10)
        low = 0xDC00 + (scalar & 0x3FF)
        if little_endian:
            output.append(high & 0xFF)
            output.append(high >> 8)
            output.append(low & 0xFF)
            output.append(low >> 8)
        else:
            output.append(high >> 8)
            output.append(high & 0xFF)
            output.append(low >> 8)
            output.append(low & 0xFF)

    return output.finish()


def _unicode_encode_utf32(
    value: str,
    little_endian: bool,
    bom: bool,
    errors: int,
) -> bytes:
    capacity = (len(value) * 4) + (4 if bom else 0)
    output = _CodecByteBuffer(capacity)

    if bom:
        if little_endian:
            output.append(0xFF)
            output.append(0xFE)
            output.append(0)
            output.append(0)
        else:
            output.append(0)
            output.append(0)
            output.append(0xFE)
            output.append(0xFF)

    for i in range(len(value)):
        codepoint = value._load_codepoint(i)
        if _is_surrogate(codepoint) and errors != _ERROR_SURROGATEPASS:
            _codec_encode_error_append(
                output, codepoint, errors, False, 4, little_endian
            )
            continue
        if little_endian:
            output.append(codepoint & 0xFF)
            output.append((codepoint >> 8) & 0xFF)
            output.append((codepoint >> 16) & 0xFF)
            output.append(codepoint >> 24)
        else:
            output.append(codepoint >> 24)
            output.append((codepoint >> 16) & 0xFF)
            output.append((codepoint >> 8) & 0xFF)
            output.append(codepoint & 0xFF)

    return output.finish()


def _unicode_encode_code(value: str, encoding: int, errors: int) -> bytes:
    if encoding == _ENCODING_UTF8:
        return _unicode_encode_utf8(value, errors)
    if encoding == _ENCODING_ASCII:
        return _unicode_encode_single_byte(value, True, errors)
    if encoding == _ENCODING_LATIN1:
        return _unicode_encode_single_byte(value, False, errors)
    if encoding == _ENCODING_CP1252:
        return _unicode_encode_cp1252(value, errors)
    if encoding == _ENCODING_CP1251:
        return _unicode_encode_cp1251(value, errors)
    if encoding == _ENCODING_CP1250:
        return _unicode_encode_cp1250(value, errors)
    if encoding == _ENCODING_CP1253:
        return _unicode_encode_cp1253(value, errors)
    if encoding == _ENCODING_CP1254:
        return _unicode_encode_cp1254(value, errors)
    if encoding == _ENCODING_ISO8859_15:
        return _unicode_encode_iso8859_15(value, errors)
    if encoding == _ENCODING_UTF16:
        return _unicode_encode_utf16(value, _native_is_little_endian(), True, errors)
    if encoding == _ENCODING_UTF16_LE:
        return _unicode_encode_utf16(value, True, False, errors)
    if encoding == _ENCODING_UTF16_BE:
        return _unicode_encode_utf16(value, False, False, errors)
    if encoding == _ENCODING_UTF32:
        return _unicode_encode_utf32(value, _native_is_little_endian(), True, errors)
    if encoding == _ENCODING_UTF32_LE:
        return _unicode_encode_utf32(value, True, False, errors)
    if encoding == _ENCODING_UTF32_BE:
        return _unicode_encode_utf32(value, False, False, errors)

    raise LookupError("unknown encoding")

def _unicode_encode_codec(value: str, encoding: str, errors: str) -> bytes:
    encoding_code = _encoding_code(encoding)
    if encoding_code == _ENCODING_UNKNOWN:
        raise LookupError("unknown encoding: " + encoding)
    return _unicode_encode_code(value, encoding_code, _error_code(errors))


@extend
class str:

    @__internal__
    def __new__(p: Ptr[u8], l: int) -> str:
        pass

    def __new__() -> str:
        return str(Ptr[u8](), _make_meta(0, KIND_ASCII))

    def __new__(data: bytes, encoding: str, errors: str = "strict") -> str:
        return _unicode_decode_codec(data, encoding, errors)

    def __new__(what) -> str:
        if isinstance(what, Union):
            return Union._str(what)
        elif isinstance(what, type):
            return what.__repr__()
        elif hasattr(what, "__str__"):
            return what.__str__()
        else:
            if not hasattr(what, "__repr__") and hasattr(what, "__repr_default__"):
                return what.__repr_default__()
            return what.__repr__()

    def from_ptr(t: cobj) -> str:
        n = _C.strlen(t)
        p = Ptr[u8](n)
        bytes.memcpy(p, t, n)
        return str(p, _make_meta(n, KIND_ASCII))

    def __len__(self) -> int:
        return _meta_len(self._meta)

    def __bool__(self) -> bool:
        return len(self) != 0

    def __match__(self, other: str) -> bool:
        return self.__eq__(other)

    def _kind(self) -> int:
        return _meta_kind(self._meta)

    def _width(self) -> int:
        return _kind_width(self._kind())

    def _is_ascii(self) -> bool:
        return self._kind() == KIND_ASCII

    def _load_codepoint(self, i: int) -> int:
        kind = self._kind()

        if kind <= KIND_LATIN1:
            return int(self._ptr[i])

        if kind == KIND_UCS2:
            return int(Ptr[u16](self._ptr)[i])

        return int(Ptr[u32](self._ptr)[i])

    def _store_codepoint(self, i: int, cp: int):
        kind = self._kind()

        if kind <= KIND_LATIN1:
            self._ptr[i] = u8(cp)
            return

        if kind == KIND_UCS2:
            Ptr[u16](self._ptr)[i] = u16(cp)
            return

        Ptr[u32](self._ptr)[i] = u32(cp)

    def _get_codepoint(self, i: int) -> int:
        if i < 0 or i >= len(self):
            raise IndexError("string index out of range")
        return self._load_codepoint(i)

    def __getitem__(self, item: int):
        n = len(self)

        if item < 0:
            item += n

        if item < 0 or item >= n:
            raise IndexError("string index out of range")

        return _unicode_from_codepoint(self._load_codepoint(item))

    def __getitem__(self, item: slice[int, int, int]) -> str:
        start, stop, step, slicelen = item.adjust_indices(len(self))

        if slicelen == 0:
            return str()

        if step == 1:
            return _unicode_slice_impl(self, start, stop)

        result = _unicode_new_uninit(slicelen, _unicode_maxchar(self))

        for i in range(slicelen):
            result._store_codepoint(i, self._load_codepoint(start + i * step))

        return result

    def _slice(self, start: int, stop: int) -> str:
        return _unicode_slice_impl(self, start, stop)

    def __eq__(self, other: str) -> bool:
        if len(self) != len(other):
            return False

        if self._width() == other._width():
            return _C.memcmp(
                self._ptr,
                other._ptr,
                len(self) * self._width(),
            ) == 0

        for i in range(len(self)):
            if self._load_codepoint(i) != other._load_codepoint(i):
                return False

        return True

    def __ne__(self, other: str) -> bool:
        return not self.__eq__(other)

    def __lt__(self, other: str) -> bool:
        return _unicode_compare(self, other) < 0

    def __le__(self, other: str) -> bool:
        return _unicode_compare(self, other) <= 0

    def __gt__(self, other: str) -> bool:
        return _unicode_compare(self, other) > 0

    def __ge__(self, other: str) -> bool:
        return _unicode_compare(self, other) >= 0

    def __add__(self, other: str) -> str:
        if len(self) == 0:
            return other

        if len(other) == 0:
            return self

        return _unicode_concat_impl(self, other)

    def __mul__(self, count: int) -> str:
        if count <= 0:
            return str()

        return _unicode_repeat_impl(self, count)

    def __rmul__(self, count: int) -> str:
        return self.__mul__(count)

    def find(self, sub: str) -> int:
        return self.find(sub, 0, len(self))

    def find(
        self,
        sub: str,
        start: int,
    ) -> int:
        return self.find(sub, start, len(self))

    def find(
        self,
        sub: str,
        start: int,
        end: int,
    ) -> int:
        start, end = _normalize_search_bounds(len(self), start, end)

        if len(sub) == 0:
            if start > end:
                return -1
            return start

        if len(sub) > end - start:
            return -1

        return _unicode_fastsearch(self, sub, start, end)

    def rfind(self, sub: str) -> int:
        return self.rfind(sub, 0, len(self))

    def rfind(
        self,
        sub: str,
        start: int,
    ) -> int:
        return self.rfind(sub, start, len(self))

    def rfind(
        self,
        sub: str,
        start: int,
        end: int,
    ) -> int:
        start, end = _normalize_search_bounds(len(self), start, end)

        if len(sub) == 0:
            if start > end:
                return -1
            return end

        if len(sub) > end - start:
            return -1

        return _unicode_fastsearch_reverse(self, sub, start, end)

    def index(self, sub: str) -> int:
        return self.index(sub, 0, len(self))

    def index(
        self,
        sub: str,
        start: int,
    ) -> int:
        return self.index(sub, start, len(self))

    def index(
        self,
        sub: str,
        start: int,
        end: int,
    ) -> int:
        pos = self.find(sub, start, end)

        if pos == -1:
            raise ValueError("substring not found")

        return pos

    def rindex(self, sub: str) -> int:
        return self.rindex(sub, 0, len(self))

    def rindex(
        self,
        sub: str,
        start: int,
    ) -> int:
        return self.rindex(sub, start, len(self))

    def rindex(
        self,
        sub: str,
        start: int,
        end: int,
    ) -> int:
        pos = self.rfind(sub, start, end)

        if pos == -1:
            raise ValueError("substring not found")

        return pos

    def count(self, sub: str) -> int:
        return self.count(sub, 0, len(self))

    def count(
        self,
        sub: str,
        start: int,
    ) -> int:
        return self.count(sub, start, len(self))

    def count(
        self,
        sub: str,
        start: int,
        end: int,
    ) -> int:
        start, end = _normalize_search_bounds(len(self), start, end)

        if len(sub) == 0:
            if start > end:
                return 0
            return end - start + 1

        return _unicode_count(self, sub, start, end)

    def startswith(self, prefix: str) -> bool:
        return self.startswith(prefix, 0, len(self))

    def startswith(
        self,
        prefix: str,
        start: int,
    ) -> bool:
        return self.startswith(prefix, start, len(self))

    def startswith(
        self,
        prefix: str,
        start: int,
        end: int,
    ) -> bool:
        start, end = _normalize_search_bounds(len(self), start, end)

        if len(prefix) == 0:
            return start <= end

        if end - start < len(prefix):
            return False

        return _unicode_starts_at(self, prefix, start)

    def endswith(self, suffix: str) -> bool:
        return self.endswith(suffix, 0, len(self))

    def endswith(
        self,
        suffix: str,
        start: int,
    ) -> bool:
        return self.endswith(suffix, start, len(self))

    def endswith(
        self,
        suffix: str,
        start: int,
        end: int,
    ) -> bool:
        start, end = _normalize_search_bounds(len(self), start, end)
        m = len(suffix)

        if m == 0:
            return start <= end

        if end - start < m:
            return False

        return _unicode_starts_at(self, suffix, end - m)

    def encode(
        self,
        encoding: str = "utf-8",
        errors: str = "strict",
    ) -> bytes:
        return _unicode_encode_codec(self, encoding, errors)

    def c_str(self) -> cobj:
        return _unicode_encode_utf8_c_str(self)

    def __repr__(self) -> str:
        single_quotes = 0
        double_quotes = 0

        for i in range(len(self)):
            cp = self._load_codepoint(i)

            if cp == 0x27:
                single_quotes += 1
            elif cp == 0x22:
                double_quotes += 1

        quote = 0x22 if single_quotes > 0 and double_quotes == 0 else 0x27
        output = _UnicodeByteBuffer(len(self) + 2)
        output.append_byte(u8(quote))

        for i in range(len(self)):
            _unicode_repr_append_codepoint(
                output,
                self._load_codepoint(i),
                quote,
            )

        output.append_byte(u8(quote))
        return _unicode_decode_utf8_strict(output.data, output.length)

    def __str__(self) -> str:
        return self

    def __contains__(self, sub: str) -> bool:
        return self.find(sub) != -1

    def __copy__(self) -> str:
        return self

    def __deepcopy__(self) -> str:
        return self

    def __ptrcopy__(self) -> str:
        data = Ptr[u8](len(self) * self._width())
        str.memcpy(data, self._ptr, len(self) * self._width())
        return str(data, self._meta)

    @staticmethod
    def maketrans(x: dict[int, int]) -> dict[int, int]:
        return x

    @staticmethod
    def maketrans(x: dict[int, str]) -> dict[int, str]:
        return x

    @staticmethod
    def maketrans(x: dict[int, Optional[int]]) -> dict[int, Optional[int]]:
        return x

    @staticmethod
    def maketrans(
        x: dict[int, Optional[str]],
    ) -> dict[int, Optional[str]]:
        return x

    @staticmethod
    def maketrans(
        x: str,
        y: str,
    ) -> dict[int, int]:
        if len(x) != len(y):
            raise ValueError("the first two maketrans arguments must have the same length")

        table = {}
        for i in range(len(x)):
            table[x._load_codepoint(i)] = y._load_codepoint(i)
        return table

    @staticmethod
    def maketrans(
        x: str,
        y: str,
        z: str,
    ) -> dict[int, Optional[int]]:
        if len(x) != len(y):
            raise ValueError("the first two maketrans arguments must have the same length")

        table: dict[int, Optional[int]] = {}
        for i in range(len(x)):
            table[x._load_codepoint(i)] = y._load_codepoint(i)
        for i in range(len(z)):
            table[z._load_codepoint(i)] = None
        return table

    def translate(self, table: dict[int, int]) -> str:
        return _unicode_translate_int_impl(self, table)

    def translate(self, table: dict[int, str]) -> str:
        return _unicode_translate_unicode_impl(self, table)

    def translate(self, table: dict[int, Optional[int]]) -> str:
        return _unicode_translate_optional_int_impl(self, table)

    def translate(self, table: dict[int, Optional[str]]) -> str:
        return _unicode_translate_optional_unicode_impl(self, table)

    def lower(self) -> str:
        if self._is_ascii():
            return _unicode_ascii_map(self, _ascii_lower)
        return _unicode_lower_full(self)

    def upper(self) -> str:
        if self._is_ascii():
            return _unicode_ascii_map(self, _ascii_upper)
        return _unicode_upper_full(self)

    def casefold(self) -> str:
        if self._is_ascii():
            return _unicode_ascii_map(self, _ascii_casefold)
        return _unicode_map_full(
            self,
            unicode_casefold_mapping_length,
            unicode_casefold_mapping_codepoint,
        )

    def capitalize(self) -> str:
        if self._is_ascii():
            return _unicode_ascii_capitalize(self)
        return _unicode_capitalize_full(self)

    def title(self) -> str:
        if self._is_ascii():
            return _unicode_ascii_title(self)
        return _unicode_title_full(self)

    def swapcase(self) -> str:
        if self._is_ascii():
            return _unicode_ascii_map(self, _ascii_swapcase)
        return _unicode_swapcase_full(self)

    def removeprefix(self, prefix: str) -> str:
        if len(prefix) > len(self) or not self.startswith(prefix):
            return self

        return _unicode_slice_impl(self, len(prefix), len(self))

    def removesuffix(self, suffix: str) -> str:
        if len(suffix) > len(self) or not self.endswith(suffix):
            return self

        return _unicode_slice_impl(self, 0, len(self) - len(suffix))

    def strip(self, chars: Optional[str] = None) -> str:
        if chars is None:
            return _unicode_strip_impl(self, True, True)
        return _unicode_strip_chars_impl(self, chars, True, True)

    def lstrip(self, chars: Optional[str] = None) -> str:
        if chars is None:
            return _unicode_strip_impl(self, True, False)
        return _unicode_strip_chars_impl(self, chars, True, False)

    def rstrip(self, chars: Optional[str] = None) -> str:
        if chars is None:
            return _unicode_strip_impl(self, False, True)
        return _unicode_strip_chars_impl(self, chars, False, True)

    def split(
        self,
        sep: Optional[str] = None,
        maxsplit: int = -1,
    ) -> List[str]:
        if sep is None:
            return _unicode_split_whitespace_impl(self, False, maxsplit)

        return _unicode_split_exact_impl(self, sep, maxsplit)

    def rsplit(
        self,
        sep: Optional[str] = None,
        maxsplit: int = -1,
    ) -> List[str]:
        if sep is None:
            return _unicode_split_whitespace_impl(self, True, maxsplit)

        return _unicode_split_exact_impl(self, sep, maxsplit, True)

    def splitlines(self, keepends: bool = False) -> List[str]:
        return _unicode_splitlines_impl(self, keepends)

    def join(self, values) -> str:
        result = _strbuf()
        first = True
        for value in values:
            if not isinstance(value, str):
                compile_error("sequence item is not a string")
            if not first:
                result.append(self)
            result.append(value)
            first = False
        return result.__str__()

    def join(self, values: List[str]) -> str:
        return _unicode_join_impl(self, values)

    def replace(
        self,
        old: str,
        new: str,
        count: int = -1,
    ) -> str:
        return _unicode_replace_impl(self, old, new, count)

    def center(self, width: int) -> str:
        if len(self) >= width:
            return self

        pad = width - len(self)
        left = pad // 2
        right = pad - left

        result = _unicode_new_uninit(width, _unicode_maxchar(self))

        for i in range(left):
            result._store_codepoint(i, 0x20)

        _unicode_copy_range(result, self, left, 0, len(self))

        for i in range(right):
            result._store_codepoint(left + len(self) + i, 0x20)

        return result

    def ljust(self, width: int) -> str:
        if len(self) >= width:
            return self

        result = _unicode_new_uninit(width, _unicode_maxchar(self))

        _unicode_copy_range(result, self, 0, 0, len(self))

        for i in range(width - len(self)):
            result._store_codepoint(len(self) + i, 0x20)

        return result

    def rjust(self, width: int) -> str:
        if len(self) >= width:
            return self

        result = _unicode_new_uninit(width, _unicode_maxchar(self))

        for i in range(width - len(self)):
            result._store_codepoint(i, 0x20)

        _unicode_copy_range(result, self, width - len(self), 0, len(self))

        return result

    def center(self, width: int, fillchar: str) -> str:
        return _unicode_center_impl(self, width, fillchar)

    def ljust(self, width: int, fillchar: str) -> str:
        return _unicode_ljust_impl(self, width, fillchar)

    def rjust(self, width: int, fillchar: str) -> str:
        return _unicode_rjust_impl(self, width, fillchar)

    def zfill(self, width: int) -> str:
        if len(self) >= width:
            return self

        sign_cp = -1
        body_start = 0

        if len(self) > 0:
            first = self._load_codepoint(0)
            if first == 0x2B or first == 0x2D:
                sign_cp = first
                body_start = 1

        body_len = len(self) - body_start

        if body_len >= width:
            return self

        pad = width - len(self)

        result = _unicode_new_uninit(width, _unicode_maxchar(self))

        if sign_cp == -1:
            for i in range(pad):
                result._store_codepoint(i, 0x30)

            _unicode_copy_range(result, self, pad, 0, len(self))
        else:
            result._store_codepoint(0, sign_cp)

            for i in range(pad):
                result._store_codepoint(i + 1, 0x30)

            _unicode_copy_range(result, self, pad + 1, body_start, len(self))

        return result

    def expandtabs(self, tabsize: int = 8) -> str:
        length = len(self)
        col = 0

        for i in range(len(self)):
            cp = self._load_codepoint(i)

            if cp == 0x09:
                spaces = 0
                if tabsize > 0:
                    spaces = tabsize - (col % tabsize)

                length += spaces - 1
                col += spaces
            elif cp == 0x0A or cp == 0x0D:
                col = 0
            else:
                col += 1

        result = _unicode_new_uninit(length, _unicode_maxchar(self))
        out = 0
        col = 0

        for i in range(len(self)):
            cp = self._load_codepoint(i)

            if cp == 0x09:
                spaces = 0
                if tabsize > 0:
                    spaces = tabsize - (col % tabsize)

                for j in range(spaces):
                    result._store_codepoint(out + j, 0x20)

                out += spaces
                col += spaces
            else:
                result._store_codepoint(out, cp)
                out += 1

                if cp == 0x0A or cp == 0x0D:
                    col = 0
                else:
                    col += 1

        return result

    def __hash__(self) -> int:
        h = u64(0x9e3779b97f4a7c15)

        for i in range(len(self)):
            h = (h * u64(1000003)) ^ u64(self._load_codepoint(i))

        h ^= u64(len(self))
        return int(h)

    def __iter__(self):
        for i in range(len(self)):
            yield self[i]

    def isalnum(self) -> bool:
        if len(self) == 0:
            return False

        if self._is_ascii():
            for i in range(len(self)):
                if not _is_ascii_alnum(int(self._ptr[i])):
                    return False
            return True

        for i in range(len(self)):
            cp = self._load_codepoint(i)
            if not (unicode_is_alpha(cp) or unicode_is_numeric(cp)):
                return False

        return True

    def isalpha(self) -> bool:
        if len(self) == 0:
            return False

        for i in range(len(self)):
            if not unicode_is_alpha(self._load_codepoint(i)):
                return False

        return True

    def isdigit(self) -> bool:
        if len(self) == 0:
            return False

        for i in range(len(self)):
            if not unicode_is_digit(self._load_codepoint(i)):
                return False

        return True

    def isspace(self) -> bool:
        if len(self) == 0:
            return False

        if self._is_ascii():
            for i in range(len(self)):
                if not _is_ascii_whitespace(int(self._ptr[i])):
                    return False
            return True

        for i in range(len(self)):
            if not unicode_is_space(self._load_codepoint(i)):
                return False

        return True

    def isascii(self) -> bool:
        if self._kind() != KIND_ASCII:
            for i in range(len(self)):
                if self._load_codepoint(i) > 0x7F:
                    return False
        return True

    def islower(self) -> bool:
        has_cased = False

        if self._is_ascii():
            for i in range(len(self)):
                cp = int(self._ptr[i])
                if _is_ascii_upper(cp):
                    return False
                if _is_ascii_lower(cp):
                    has_cased = True
            return has_cased

        for i in range(len(self)):
            cp = self._load_codepoint(i)

            if unicode_is_cased(cp):
                if not unicode_is_lower(cp):
                    return False
                has_cased = True

        return has_cased

    def isupper(self) -> bool:
        has_cased = False

        if self._is_ascii():
            for i in range(len(self)):
                cp = int(self._ptr[i])
                if _is_ascii_lower(cp):
                    return False
                if _is_ascii_upper(cp):
                    has_cased = True
            return has_cased

        for i in range(len(self)):
            cp = self._load_codepoint(i)

            if unicode_is_cased(cp):
                if not unicode_is_upper(cp):
                    return False
                has_cased = True

        return has_cased

    def istitle(self) -> bool:
        has_cased = False
        previous_is_cased = False

        for i in range(len(self)):
            cp = self._load_codepoint(i)

            if unicode_is_upper(cp) or unicode_is_title(cp):
                if previous_is_cased:
                    return False
                has_cased = True
                previous_is_cased = True
            elif unicode_is_lower(cp):
                if not previous_is_cased:
                    return False
                has_cased = True
                previous_is_cased = True
            else:
                previous_is_cased = False

        return has_cased

    def isnumeric(self) -> bool:
        if len(self) == 0:
            return False

        for i in range(len(self)):
            if not unicode_is_numeric(self._load_codepoint(i)):
                return False

        return True

    def isdecimal(self) -> bool:
        if len(self) == 0:
            return False

        for i in range(len(self)):
            if not unicode_is_decimal(self._load_codepoint(i)):
                return False

        return True

    def isprintable(self) -> bool:
        for i in range(len(self)):
            cp = self._load_codepoint(i)
            if not unicode_is_printable(cp):
                return False

        return True

    def isidentifier(self) -> bool:
        if len(self) == 0:
            return False

        if self._is_ascii():
            if not _is_ascii_id_start(int(self._ptr[0])):
                return False
            for i in range(1, len(self)):
                if not _is_ascii_id_continue(int(self._ptr[i])):
                    return False
            return True

        first = self._load_codepoint(0)
        if first != 0x5F and not unicode_is_xid_start(first):
            return False

        for i in range(1, len(self)):
            if not unicode_is_xid_continue(self._load_codepoint(i)):
                return False

        return True

    def partition(self, sep: str) -> Tuple[str, str, str]:
        if len(sep) == 0:
            raise ValueError("empty separator")

        pos = self.find(sep)

        if pos == -1:
            return (self, str(), str())

        return (
            _unicode_slice_impl(self, 0, pos),
            sep,
            _unicode_slice_impl(self, pos + len(sep), len(self)),
        )

    def rpartition(self, sep: str) -> Tuple[str, str, str]:
        if len(sep) == 0:
            raise ValueError("empty separator")

        pos = self.rfind(sep)

        if pos == -1:
            return (str(), str(), self)

        return (
            _unicode_slice_impl(self, 0, pos),
            sep,
            _unicode_slice_impl(self, pos + len(sep), len(self)),
        )


    def cat(*args) -> str:
        total = 0
        maxchar = 0

        if (
            static.len(args) == 1
            and hasattr(args[0], "__iter__")
            and hasattr(args[0], "__len__")
        ):
            for value in args[0]:
                if not isinstance(value, str):
                    compile_error("not a string")
                total += len(value)
                value_maxchar = _unicode_maxchar(value)
                if value_maxchar > maxchar:
                    maxchar = value_maxchar

            result = _unicode_new_uninit(total, maxchar)
            output = 0

            for value in args[0]:
                _unicode_copy_range(result, value, output, 0, len(value))
                output += len(value)

            return result
        elif static.len(args) == 1 and hasattr(args[0], "__iter__"):
            capacity = 10
            data = Ptr[u8](capacity)
            kind = KIND_ASCII

            for value in args[0]:
                if not isinstance(value, str):
                    compile_error("not a string")

                required = total + len(value)
                width = _kind_width(kind)
                value_width = value._width()

                if required > capacity or value_width > width:
                    if required > capacity:
                        capacity = 1 + 3 * required.cdiv(2)

                    new_kind = kind
                    if value_width > width:
                        new_kind = value._kind()

                    expanded = Ptr[u8](
                        capacity * _kind_width(new_kind)
                    )

                    if new_kind == kind:
                        str.memcpy(
                            expanded,
                            data,
                            total * width,
                        )
                    else:
                        source = str(data, _make_meta(total, kind))
                        destination = str(
                            expanded,
                            _make_meta(capacity, new_kind),
                        )
                        _unicode_copy_range(
                            destination,
                            source,
                            0,
                            0,
                            total,
                        )

                    data = expanded
                    kind = new_kind

                buffer = str(data, _make_meta(capacity, kind))
                _unicode_copy_range(buffer, value, total, 0, len(value))

                total = required
                value_maxchar = _unicode_maxchar(value)
                if value_maxchar > maxchar:
                    maxchar = value_maxchar

            result = _unicode_new_uninit(total, maxchar)
            source = str(data, _make_meta(total, kind))
            _unicode_copy_range(result, source, 0, 0, total)
            return result
        else:
            for i in static.range(static.len(args)):
                value = args[i]
                if not isinstance(value, str):
                    compile_error("not a string")
                total += len(value)
                value_maxchar = _unicode_maxchar(value)
                if value_maxchar > maxchar:
                    maxchar = value_maxchar

            result = _unicode_new_uninit(total, maxchar)
            output = 0

            for i in static.range(static.len(args)):
                value = args[i]
                _unicode_copy_range(result, value, output, 0, len(value))
                output += len(value)

            return result

    @llvm
    def memcpy(dest: Ptr[u8], src: Ptr[u8], len: int) -> None:
        declare void @llvm.memcpy.p0i8.p0i8.i64(ptr %dest, ptr %src, i64 %len, i32 %align, i1 %isvolatile)
        call void @llvm.memcpy.p0i8.p0i8.i64(ptr %dest, ptr %src, i64 %len, i32 0, i1 false)
        ret {} {}

    @llvm
    def memmove(dest: Ptr[u8], src: Ptr[u8], len: int) -> None:
        declare void @llvm.memmove.p0i8.p0i8.i64(ptr %dest, ptr %src, i64 %len, i32 %align, i1 %isvolatile)
        call void @llvm.memmove.p0i8.p0i8.i64(ptr %dest, ptr %src, i64 %len, i32 0, i1 false)
        ret {} {}

    @llvm
    def memset(dest: Ptr[u8], val: u8, len: int) -> None:
        declare void @llvm.memset.p0i8.i64(ptr %dest, i8 %val, i64 %len, i32 %align, i1 %isvolatile)
        call void @llvm.memset.p0i8.i64(ptr %dest, i8 %val, i64 %len, i32 0, i1 false)
        ret {} {}


def _unicode_new_uninit(length: int, maxchar: int) -> str:
    if length < 0:
        raise ValueError("negative length")

    if length > LEN_MASK:
        raise ValueError("string too large")

    if maxchar < 0 or maxchar > UNICODE_MAX:
        raise ValueError("invalid code point")

    kind = _kind_for_maxchar(maxchar)
    width = _kind_width(kind)

    return str(
        Ptr[u8](length * width),
        _make_meta(length, kind),
    )


def _unicode_from_codepoint(cp: int) -> str:
    if cp < 0 or cp > UNICODE_MAX:
        raise ValueError("invalid code point")

    result = _unicode_new_uninit(1, cp)
    result._store_codepoint(0, cp)

    return result


def _unicode_from_codepoints(codepoints: List[int]) -> str:
    maxchar = 0

    for cp in codepoints:
        if cp < 0 or cp > UNICODE_MAX:
            raise ValueError("invalid code point")
        if cp > maxchar:
            maxchar = cp

    result = _unicode_new_uninit(len(codepoints), maxchar)

    for i in range(len(codepoints)):
        result._store_codepoint(i, codepoints[i])

    return result


def _unicode_maxchar(value: str) -> int:
    kind = value._kind()

    if kind == KIND_ASCII:
        return 0x7F
    if kind == KIND_LATIN1:
        return 0xFF
    if kind == KIND_UCS2:
        return 0xFFFF
    return UNICODE_MAX


def _unicode_starts_at(
    value: str,
    sub: str,
    pos: int,
) -> bool:
    n = len(sub)

    if pos < 0 or pos + n > len(value):
        return False

    for i in range(n):
        if value._load_codepoint(pos + i) != sub._load_codepoint(i):
            return False

    return True


def _unicode_compare_typed(
    left: Ptr[Char],
    right: Ptr[Char],
    limit: int,
    Char: type,
) -> int:
    for i in range(limit):
        if left[i] < right[i]:
            return -1
        if left[i] > right[i]:
            return 1

    return 0


def _unicode_compare(left: str, right: str) -> int:
    left_length = len(left)
    right_length = len(right)
    limit = left_length if left_length < right_length else right_length
    comparison = 0

    if left._kind() <= KIND_LATIN1 and right._kind() <= KIND_LATIN1:
        comparison = _unicode_compare_typed(left._ptr, right._ptr, limit)
    elif left._kind() == KIND_UCS2 and right._kind() == KIND_UCS2:
        comparison = _unicode_compare_typed(
            Ptr[u16](left._ptr), Ptr[u16](right._ptr), limit
        )
    elif left._kind() == KIND_UCS4 and right._kind() == KIND_UCS4:
        comparison = _unicode_compare_typed(
            Ptr[u32](left._ptr), Ptr[u32](right._ptr), limit
        )
    else:
        for i in range(limit):
            left_codepoint = left._load_codepoint(i)
            right_codepoint = right._load_codepoint(i)

            if left_codepoint < right_codepoint:
                return -1
            if left_codepoint > right_codepoint:
                return 1

    if comparison != 0:
        return comparison

    if left_length < right_length:
        return -1
    if left_length > right_length:
        return 1
    return 0


def _unicode_search_bloom_add(bloom: u64, codepoint: int) -> u64:
    return bloom | (u64(1) << u64(codepoint & 63))


def _unicode_search_bloom_contains(bloom: u64, codepoint: int) -> bool:
    return (bloom & (u64(1) << u64(codepoint & 63))) != 0


def _unicode_coerce_kind(value: str, kind: int) -> Optional[str]:
    if value._kind() == kind:
        return value

    maxchar = 0xFF
    if kind == KIND_ASCII:
        maxchar = 0x7F
    elif kind == KIND_UCS2:
        maxchar = 0xFFFF
    elif kind == KIND_UCS4:
        maxchar = UNICODE_MAX

    for i in range(len(value)):
        if value._load_codepoint(i) > maxchar:
            return None

    result = str(
        Ptr[u8](len(value) * _kind_width(kind)),
        _make_meta(len(value), kind),
    )

    for i in range(len(value)):
        result._store_codepoint(i, value._load_codepoint(i))

    return result


def _unicode_starts_at_typed(
    value: Ptr[Char],
    sub: Ptr[Char],
    sub_length: int,
    pos: int,
    Char: type,
) -> bool:
    for i in range(sub_length):
        if value[pos + i] != sub[i]:
            return False
    return True


def _unicode_fastsearch_typed(
    value: Ptr[Char],
    value_length: int,
    sub: Ptr[Char],
    sub_length: int,
    start: int,
    end: int,
    Char: type,
) -> int:
    needle_length = sub_length
    if needle_length == 1:
        needle = sub[0]
        for position in range(start, end):
            if value[position] == needle:
                return position
        return -1

    bloom = u64(0)
    for index in range(needle_length):
        bloom = _unicode_search_bloom_add(bloom, int(sub[index]))

    last = needle_length - 1
    tail = sub[last]
    limit = end - needle_length
    position = start
    attempts = 0

    while position <= limit:
        candidate_tail = value[position + last]
        if candidate_tail == tail and _unicode_starts_at_typed(
            value, sub, needle_length, position
        ):
            return position

        attempts += 1
        if attempts > needle_length and position + needle_length <= limit:
            return _unicode_fastsearch_kmp_typed(
                value, sub, needle_length, position + 1, end
            )

        if _unicode_search_bloom_contains(bloom, int(candidate_tail)):
            position += 1
        else:
            position += needle_length

    return -1


def _unicode_fastsearch_kmp_typed(
    value: Ptr[Char],
    sub: Ptr[Char],
    sub_length: int,
    start: int,
    end: int,
    Char: type,
) -> int:
    needle_length = sub_length
    prefix = Ptr[int](needle_length)
    prefix[0] = 0
    matched = 0

    for index in range(1, needle_length):
        while matched > 0 and sub[index] != sub[matched]:
            matched = prefix[matched - 1]
        if sub[index] == sub[matched]:
            matched += 1
        prefix[index] = matched

    matched = 0
    for position in range(start, end):
        while matched > 0 and value[position] != sub[matched]:
            matched = prefix[matched - 1]
        if value[position] == sub[matched]:
            matched += 1
            if matched == needle_length:
                result = position - needle_length + 1
                gc.free(prefix.as_byte())
                return result

    gc.free(prefix.as_byte())
    return -1


def _unicode_fastsearch_reverse_typed(
    value: Ptr[Char],
    sub: Ptr[Char],
    sub_length: int,
    start: int,
    end: int,
    Char: type,
) -> int:
    needle_length = sub_length
    if needle_length == 1:
        needle = sub[0]
        for position in range(end - 1, start - 1, -1):
            if value[position] == needle:
                return position
        return -1

    bloom = u64(0)
    for index in range(needle_length):
        bloom = _unicode_search_bloom_add(bloom, int(sub[index]))

    first = sub[0]
    position = end - needle_length
    attempts = 0

    while position >= start:
        candidate_first = value[position]
        if candidate_first == first and _unicode_starts_at_typed(
            value, sub, needle_length, position
        ):
            return position

        attempts += 1
        if attempts > needle_length and position - needle_length >= start:
            return _unicode_fastsearch_reverse_kmp_typed(
                value, sub, needle_length, start, position + needle_length - 2
            )

        if _unicode_search_bloom_contains(bloom, int(candidate_first)):
            position -= 1
        else:
            position -= needle_length

    return -1


def _unicode_fastsearch_reverse_kmp_typed(
    value: Ptr[Char],
    sub: Ptr[Char],
    sub_length: int,
    start: int,
    end: int,
    Char: type,
) -> int:
    needle_length = sub_length
    prefix = Ptr[int](needle_length)
    prefix[0] = 0
    matched = 0

    for index in range(1, needle_length):
        while (
            matched > 0
            and sub[needle_length - 1 - index]
                != sub[needle_length - 1 - matched]
        ):
            matched = prefix[matched - 1]
        if (
            sub[needle_length - 1 - index]
            == sub[needle_length - 1 - matched]
        ):
            matched += 1
        prefix[index] = matched

    matched = 0
    for position in range(end, start - 1, -1):
        while (
            matched > 0
            and value[position]
                != sub[needle_length - 1 - matched]
        ):
            matched = prefix[matched - 1]
        if value[position] == sub[needle_length - 1 - matched]:
            matched += 1
            if matched == needle_length:
                gc.free(prefix.as_byte())
                return position

    gc.free(prefix.as_byte())
    return -1


def _unicode_count_kmp_typed(
    value: Ptr[Char],
    sub: Ptr[Char],
    sub_length: int,
    start: int,
    end: int,
    Char: type,
) -> int:
    if sub_length == 1:
        total = 0
        needle = sub[0]
        for position in range(start, end):
            if value[position] == needle:
                total += 1
        return total

    prefix = Ptr[int](sub_length)
    prefix[0] = 0
    matched = 0

    for index in range(1, sub_length):
        while matched > 0 and sub[index] != sub[matched]:
            matched = prefix[matched - 1]
        if sub[index] == sub[matched]:
            matched += 1
        prefix[index] = matched

    total = 0
    matched = 0
    for position in range(start, end):
        while matched > 0 and value[position] != sub[matched]:
            matched = prefix[matched - 1]
        if value[position] == sub[matched]:
            matched += 1
            if matched == sub_length:
                total += 1
                matched = 0

    gc.free(prefix.as_byte())
    return total


def _unicode_count_typed(
    value: Ptr[Char],
    sub: Ptr[Char],
    sub_length: int,
    start: int,
    end: int,
    Char: type,
) -> int:
    if sub_length == 1:
        total = 0
        needle = sub[0]
        for position in range(start, end):
            if value[position] == needle:
                total += 1
        return total

    bloom = u64(0)
    for index in range(sub_length):
        bloom = _unicode_search_bloom_add(bloom, int(sub[index]))

    last = sub_length - 1
    tail = sub[last]
    limit = end - sub_length
    position = start
    attempts = 0
    total = 0

    while position <= limit:
        candidate_tail = value[position + last]
        if candidate_tail == tail and _unicode_starts_at_typed(
            value, sub, sub_length, position
        ):
            total += 1
            position += sub_length
            attempts = 0
            continue

        attempts += 1
        if attempts > sub_length and position + sub_length <= limit:
            return total + _unicode_count_kmp_typed(
                value, sub, sub_length, position, end
            )

        if _unicode_search_bloom_contains(bloom, int(candidate_tail)):
            position += 1
        else:
            position += sub_length

    return total


def _unicode_count_kmp(
    value: str,
    sub: str,
    start: int,
    end: int,
) -> int:
    sub_length = len(sub)
    if sub_length == 1:
        total = 0
        needle = sub._load_codepoint(0)
        for position in range(start, end):
            if value._load_codepoint(position) == needle:
                total += 1
        return total

    prefix = Ptr[int](sub_length)
    prefix[0] = 0
    matched = 0

    for index in range(1, sub_length):
        while (
            matched > 0
            and sub._load_codepoint(index) != sub._load_codepoint(matched)
        ):
            matched = prefix[matched - 1]
        if sub._load_codepoint(index) == sub._load_codepoint(matched):
            matched += 1
        prefix[index] = matched

    total = 0
    matched = 0
    for position in range(start, end):
        while (
            matched > 0
            and value._load_codepoint(position) != sub._load_codepoint(matched)
        ):
            matched = prefix[matched - 1]
        if value._load_codepoint(position) == sub._load_codepoint(matched):
            matched += 1
            if matched == sub_length:
                total += 1
                matched = 0

    gc.free(prefix.as_byte())
    return total


def _unicode_count(
    value: str,
    sub: str,
    start: int,
    end: int,
) -> int:
    if value._kind() <= KIND_LATIN1 and sub._kind() <= KIND_LATIN1:
        return _unicode_count_typed(value._ptr, sub._ptr, len(sub), start, end)
    if value._kind() == KIND_UCS2 and sub._kind() == KIND_UCS2:
        return _unicode_count_typed(
            Ptr[u16](value._ptr), Ptr[u16](sub._ptr), len(sub), start, end
        )
    if value._kind() == KIND_UCS4 and sub._kind() == KIND_UCS4:
        return _unicode_count_typed(
            Ptr[u32](value._ptr), Ptr[u32](sub._ptr), len(sub), start, end
        )

    sub_length = len(sub)
    if sub_length == 1:
        total = 0
        needle = sub._load_codepoint(0)
        for position in range(start, end):
            if value._load_codepoint(position) == needle:
                total += 1
        return total

    bloom = u64(0)
    for index in range(sub_length):
        bloom = _unicode_search_bloom_add(bloom, sub._load_codepoint(index))

    last = sub_length - 1
    tail = sub._load_codepoint(last)
    limit = end - sub_length
    position = start
    attempts = 0
    total = 0

    while position <= limit:
        candidate_tail = value._load_codepoint(position + last)
        if candidate_tail == tail and _unicode_starts_at(value, sub, position):
            total += 1
            position += sub_length
            attempts = 0
            continue

        attempts += 1
        if attempts > sub_length and position + sub_length <= limit:
            return total + _unicode_count_kmp(value, sub, position, end)

        if _unicode_search_bloom_contains(bloom, candidate_tail):
            position += 1
        else:
            position += sub_length

    return total


def _unicode_fastsearch(
    value: str,
    sub: str,
    start: int,
    end: int,
) -> int:
    if value._kind() <= KIND_LATIN1 and sub._kind() <= KIND_LATIN1:
        position = string_algorithms.forward_find(
            value._ptr + start, end - start, sub._ptr, len(sub)
        )
        return start + position if position >= 0 else -1
    if value._kind() <= KIND_LATIN1 and sub._kind() == KIND_UCS2:
        position = string_algorithms.forward_find_u8_u16(
            value._ptr + start,
            end - start,
            Ptr[u16](sub._ptr),
            len(sub),
        )
        return start + position if position >= 0 else -1
    if value._kind() <= KIND_LATIN1 and sub._kind() == KIND_UCS4:
        position = string_algorithms.forward_find_u8_u32(
            value._ptr + start,
            end - start,
            Ptr[u32](sub._ptr),
            len(sub),
        )
        return start + position if position >= 0 else -1
    if value._kind() == KIND_UCS2 and sub._kind() <= KIND_LATIN1:
        position = string_algorithms.forward_find_u16_u8(
            Ptr[u16](value._ptr) + start,
            end - start,
            sub._ptr,
            len(sub),
        )
        return start + position if position >= 0 else -1
    if value._kind() == KIND_UCS2 and sub._kind() == KIND_UCS2:
        position = string_algorithms.forward_find_u16(
            Ptr[u16](value._ptr) + start,
            end - start,
            Ptr[u16](sub._ptr),
            len(sub),
        )
        return start + position if position >= 0 else -1
    if value._kind() == KIND_UCS2 and sub._kind() == KIND_UCS4:
        position = string_algorithms.forward_find_u16_u32(
            Ptr[u16](value._ptr) + start,
            end - start,
            Ptr[u32](sub._ptr),
            len(sub),
        )
        return start + position if position >= 0 else -1
    if value._kind() == KIND_UCS4 and sub._kind() <= KIND_LATIN1:
        position = string_algorithms.forward_find_u32_u8(
            Ptr[u32](value._ptr) + start,
            end - start,
            sub._ptr,
            len(sub),
        )
        return start + position if position >= 0 else -1
    if value._kind() == KIND_UCS4 and sub._kind() == KIND_UCS2:
        position = string_algorithms.forward_find_u32_u16(
            Ptr[u32](value._ptr) + start,
            end - start,
            Ptr[u16](sub._ptr),
            len(sub),
        )
        return start + position if position >= 0 else -1
    if value._kind() == KIND_UCS4 and sub._kind() == KIND_UCS4:
        position = string_algorithms.forward_find_u32(
            Ptr[u32](value._ptr) + start,
            end - start,
            Ptr[u32](sub._ptr),
            len(sub),
        )
        return start + position if position >= 0 else -1
    return -1


def _unicode_fastsearch_reverse(
    value: str,
    sub: str,
    start: int,
    end: int,
) -> int:
    if value._kind() <= KIND_LATIN1 and sub._kind() <= KIND_LATIN1:
        position = string_algorithms.backward_find(
            value._ptr + start, end - start, sub._ptr, len(sub)
        )
        return start + position if position >= 0 else -1
    if value._kind() <= KIND_LATIN1 and sub._kind() == KIND_UCS2:
        position = string_algorithms.backward_find_u8_u16(
            value._ptr + start,
            end - start,
            Ptr[u16](sub._ptr),
            len(sub),
        )
        return start + position if position >= 0 else -1
    if value._kind() <= KIND_LATIN1 and sub._kind() == KIND_UCS4:
        position = string_algorithms.backward_find_u8_u32(
            value._ptr + start,
            end - start,
            Ptr[u32](sub._ptr),
            len(sub),
        )
        return start + position if position >= 0 else -1
    if value._kind() == KIND_UCS2 and sub._kind() <= KIND_LATIN1:
        position = string_algorithms.backward_find_u16_u8(
            Ptr[u16](value._ptr) + start,
            end - start,
            sub._ptr,
            len(sub),
        )
        return start + position if position >= 0 else -1
    if value._kind() == KIND_UCS2 and sub._kind() == KIND_UCS2:
        position = string_algorithms.backward_find_u16(
            Ptr[u16](value._ptr) + start,
            end - start,
            Ptr[u16](sub._ptr),
            len(sub),
        )
        return start + position if position >= 0 else -1
    if value._kind() == KIND_UCS2 and sub._kind() == KIND_UCS4:
        position = string_algorithms.backward_find_u16_u32(
            Ptr[u16](value._ptr) + start,
            end - start,
            Ptr[u32](sub._ptr),
            len(sub),
        )
        return start + position if position >= 0 else -1
    if value._kind() == KIND_UCS4 and sub._kind() <= KIND_LATIN1:
        position = string_algorithms.backward_find_u32_u8(
            Ptr[u32](value._ptr) + start,
            end - start,
            sub._ptr,
            len(sub),
        )
        return start + position if position >= 0 else -1
    if value._kind() == KIND_UCS4 and sub._kind() == KIND_UCS2:
        position = string_algorithms.backward_find_u32_u16(
            Ptr[u32](value._ptr) + start,
            end - start,
            Ptr[u16](sub._ptr),
            len(sub),
        )
        return start + position if position >= 0 else -1
    if value._kind() == KIND_UCS4 and sub._kind() == KIND_UCS4:
        position = string_algorithms.backward_find_u32(
            Ptr[u32](value._ptr) + start,
            end - start,
            Ptr[u32](sub._ptr),
            len(sub),
        )
        return start + position if position >= 0 else -1
    return -1


def _unicode_copy_range(
    dst: str,
    src: str,
    dst_offset: int,
    src_start: int,
    src_end: int,
) -> None:
    length = src_end - src_start

    if length <= 0:
        return

    src_width = src._width()
    dst_width = dst._width()

    if src_width == dst_width:
        nbytes = length * src_width
        str.memcpy(
            dst._ptr + dst_offset * dst_width,
            src._ptr + src_start * src_width,
            nbytes,
        )
        return

    for i in range(length):
        dst._store_codepoint(dst_offset + i, src._load_codepoint(src_start + i))


def _unicode_slice_impl(
    value: str,
    start: int,
    end: int,
) -> str:
    if start >= end:
        return str()

    return str(
        value._ptr + start * value._width(),
        _make_meta(end - start, value._kind()),
    )


def _unicode_concat_impl(left: str, right: str) -> str:
    if len(left) == 0:
        return right

    if len(right) == 0:
        return left

    maxchar = _unicode_maxchar(left)
    right_max = _unicode_maxchar(right)

    if right_max > maxchar:
        maxchar = right_max

    result = _unicode_new_uninit(len(left) + len(right), maxchar)
    _unicode_copy_range(result, left, 0, 0, len(left))
    _unicode_copy_range(result, right, len(left), 0, len(right))
    return result


def _unicode_repeat_impl(value: str, count: int) -> str:
    if count <= 0:
        return str()

    length = len(value) * count
    maxchar = _unicode_maxchar(value)

    result = _unicode_new_uninit(length, maxchar)

    for i in range(count):
        _unicode_copy_range(result, value, i * len(value), 0, len(value))

    return result


def _unicode_new_from_repeat(cp: int, length: int) -> str:
    if length <= 0:
        return str()

    result = _unicode_new_uninit(length, cp)
    for i in range(length):
        result._store_codepoint(i, cp)

    return result


def _unicode_strip_impl(value: str, left: bool, right: bool) -> str:
    start = 0
    end = len(value)

    if left:
        while start < end and unicode_is_space(value._load_codepoint(start)):
            start += 1

    if right:
        while end > start and unicode_is_space(value._load_codepoint(end - 1)):
            end -= 1

    return _unicode_slice_impl(value, start, end)


def _unicode_contains_codepoint(value: str, cp: int) -> bool:
    for i in range(len(value)):
        if value._load_codepoint(i) == cp:
            return True
    return False


def _unicode_strip_chars_impl(
    value: str,
    chars: str,
    left: bool,
    right: bool,
) -> str:
    start = 0
    end = len(value)

    if left:
        while start < end and _unicode_contains_codepoint(
            chars, value._load_codepoint(start)
        ):
            start += 1

    if right:
        while end > start and _unicode_contains_codepoint(
            chars, value._load_codepoint(end - 1)
        ):
            end -= 1

    return _unicode_slice_impl(value, start, end)


def _unicode_fillchar(fillchar: str) -> int:
    if len(fillchar) != 1:
        raise TypeError("The fill character must be exactly one character long")
    return fillchar._load_codepoint(0)


def _unicode_center_impl(
    value: str,
    width: int,
    fillchar: str,
) -> str:
    if len(value) >= width:
        return value

    fill = _unicode_fillchar(fillchar)
    maxchar = _unicode_maxchar(value)
    if fill > maxchar:
        maxchar = fill

    padding = width - len(value)
    left = padding // 2
    result = _unicode_new_uninit(width, maxchar)

    for i in range(left):
        result._store_codepoint(i, fill)

    _unicode_copy_range(result, value, left, 0, len(value))

    for i in range(left + len(value), width):
        result._store_codepoint(i, fill)

    return result


def _unicode_ljust_impl(
    value: str,
    width: int,
    fillchar: str,
) -> str:
    if len(value) >= width:
        return value

    fill = _unicode_fillchar(fillchar)
    maxchar = _unicode_maxchar(value)
    if fill > maxchar:
        maxchar = fill

    result = _unicode_new_uninit(width, maxchar)
    _unicode_copy_range(result, value, 0, 0, len(value))

    for i in range(len(value), width):
        result._store_codepoint(i, fill)

    return result


def _unicode_rjust_impl(
    value: str,
    width: int,
    fillchar: str,
) -> str:
    if len(value) >= width:
        return value

    fill = _unicode_fillchar(fillchar)
    maxchar = _unicode_maxchar(value)
    if fill > maxchar:
        maxchar = fill

    padding = width - len(value)
    result = _unicode_new_uninit(width, maxchar)

    for i in range(padding):
        result._store_codepoint(i, fill)

    _unicode_copy_range(result, value, padding, 0, len(value))
    return result


def _unicode_split_capacity(maxsplit: int) -> int:
    if maxsplit < 0 or maxsplit >= 12:
        return 12
    return maxsplit + 1


def _unicode_split_whitespace_impl(
    value: str,
    reverse: Literal[bool] = False,
    maxsplit: int = -1,
) -> List[str]:
    parts = List[str](_unicode_split_capacity(maxsplit))
    length = len(value)

    if not reverse:
        i = 0
        splits = 0

        while i < length:
            while i < length and unicode_is_space(value._load_codepoint(i)):
                i += 1

            if i == length:
                break

            if maxsplit >= 0 and splits == maxsplit:
                parts.append(_unicode_slice_impl(value, i, length))
                break

            start = i

            while i < length and not unicode_is_space(value._load_codepoint(i)):
                i += 1

            parts.append(_unicode_slice_impl(value, start, i))
            splits += 1

        return parts

    i = length - 1
    splits = 0

    while i >= 0:
        while i >= 0 and unicode_is_space(value._load_codepoint(i)):
            i -= 1

        if i < 0:
            break

        if maxsplit >= 0 and splits == maxsplit:
            parts.append(_unicode_slice_impl(value, 0, i + 1))
            break

        end = i + 1

        while i >= 0 and not unicode_is_space(value._load_codepoint(i)):
            i -= 1

        parts.append(_unicode_slice_impl(value, i + 1, end))
        splits += 1

    parts.reverse()
    return parts


def _unicode_split_char_typed(
    value: str,
    data: Ptr[Char],
    separator: Char,
    maxsplit: int,
    reverse: Literal[bool],
    Char: type,
) -> List[str]:
    parts = List[str](_unicode_split_capacity(maxsplit))

    if not reverse:
        start = 0
        splits = 0

        for position in range(len(value)):
            if maxsplit >= 0 and splits == maxsplit:
                break
            if data[position] != separator:
                continue
            parts.append(_unicode_slice_impl(value, start, position))
            start = position + 1
            splits += 1

        parts.append(_unicode_slice_impl(value, start, len(value)))
        return parts

    end = len(value)
    splits = 0
    for position in range(len(value) - 1, -1, -1):
        if maxsplit >= 0 and splits == maxsplit:
            break
        if data[position] != separator:
            continue
        parts.append(_unicode_slice_impl(value, position + 1, end))
        end = position
        splits += 1

    parts.append(_unicode_slice_impl(value, 0, end))
    parts.reverse()
    return parts


def _unicode_split_exact_impl(
    value: str,
    sep: str,
    maxsplit: int,
    reverse: Literal[bool] = False,
) -> List[str]:
    if len(sep) == 0:
        raise ValueError("empty separator")

    parts = List[str](_unicode_split_capacity(maxsplit))

    if maxsplit == 0:
        parts.append(value)
        return parts

    if value._kind() != sep._kind():
        typed_sep = _unicode_coerce_kind(sep, value._kind())
        if typed_sep is None:
            parts.append(value)
            return parts
        sep = typed_sep

    if len(sep) == 1:
        if value._kind() <= KIND_LATIN1 and sep._kind() <= KIND_LATIN1:
            return _unicode_split_char_typed(
                value, value._ptr, sep._ptr[0], maxsplit, reverse
            )
        if value._kind() == KIND_UCS2 and sep._kind() == KIND_UCS2:
            data = Ptr[u16](value._ptr)
            separator = Ptr[u16](sep._ptr)[0]
            return _unicode_split_char_typed(
                value, data, separator, maxsplit, reverse
            )
        if value._kind() == KIND_UCS4 and sep._kind() == KIND_UCS4:
            data = Ptr[u32](value._ptr)
            separator = Ptr[u32](sep._ptr)[0]
            return _unicode_split_char_typed(
                value, data, separator, maxsplit, reverse
            )

        separator = sep._load_codepoint(0)

        if not reverse:
            start = 0
            splits = 0

            for position in range(len(value)):
                if maxsplit >= 0 and splits == maxsplit:
                    break
                if value._load_codepoint(position) != separator:
                    continue
                parts.append(_unicode_slice_impl(value, start, position))
                start = position + 1
                splits += 1

            parts.append(_unicode_slice_impl(value, start, len(value)))
            return parts

        end = len(value)
        splits = 0
        for position in range(len(value) - 1, -1, -1):
            if maxsplit >= 0 and splits == maxsplit:
                break
            if value._load_codepoint(position) != separator:
                continue
            parts.append(_unicode_slice_impl(value, position + 1, end))
            end = position
            splits += 1

        parts.append(_unicode_slice_impl(value, 0, end))
        parts.reverse()
        return parts

    if not reverse:
        start = 0
        remaining = maxsplit

        while True:
            if maxsplit >= 0 and remaining == 0:
                parts.append(_unicode_slice_impl(value, start, len(value)))
                break

            pos = _unicode_fastsearch(value, sep, start, len(value))

            if pos == -1:
                parts.append(_unicode_slice_impl(value, start, len(value)))
                break

            parts.append(_unicode_slice_impl(value, start, pos))

            start = pos + len(sep)
            remaining -= 1

        return parts

    start = len(value)
    remaining = maxsplit

    while True:
        if maxsplit >= 0 and remaining == 0:
            parts.append(_unicode_slice_impl(value, 0, start))
            break

        pos = _unicode_fastsearch_reverse(value, sep, 0, start)

        if pos == -1:
            parts.append(_unicode_slice_impl(value, 0, start))
            break

        parts.append(_unicode_slice_impl(value, pos + len(sep), start))

        start = pos
        remaining -= 1

    parts.reverse()
    return parts


def _unicode_splitlines_impl(value: str, keepends: bool) -> List[str]:
    parts = []
    start = 0
    i = 0

    while i < len(value):
        cp = value._load_codepoint(i)
        line_end = i
        next_start = i + 1

        if cp == 0x0D:
            if i + 1 < len(value) and value._load_codepoint(i + 1) == 0x0A:
                next_start = i + 2
        elif (
            cp != 0x0A
            and cp != 0x0B
            and cp != 0x0C
            and cp != 0x1C
            and cp != 0x1D
            and cp != 0x1E
            and cp != 0x85
            and cp != 0x2028
            and cp != 0x2029
        ):
            i += 1
            continue

        if keepends:
            parts.append(_unicode_slice_impl(value, start, next_start))
        else:
            parts.append(_unicode_slice_impl(value, start, line_end))

        start = next_start
        i = next_start

    if start < len(value):
        parts.append(_unicode_slice_impl(value, start, len(value)))

    return parts


def _unicode_join_impl(sep: str, values: List[str]) -> str:
    if len(values) == 0:
        return str()

    total_len = 0
    maxchar = 0

    for i in range(len(values)):
        piece = values[i]
        total_len += len(piece)
        piece_maxchar = _unicode_maxchar(piece)

        if piece_maxchar > maxchar:
            maxchar = piece_maxchar

    if len(values) > 1:
        total_len += (len(values) - 1) * len(sep)

    if len(sep) > 0 and _unicode_maxchar(sep) > maxchar:
        maxchar = _unicode_maxchar(sep)

    result = _unicode_new_uninit(total_len, maxchar)
    out = 0

    for i in range(len(values)):
        if i > 0 and len(sep) > 0:
            _unicode_copy_range(result, sep, out, 0, len(sep))
            out += len(sep)

        piece = values[i]
        _unicode_copy_range(result, piece, out, 0, len(piece))
        out += len(piece)

    return result


def _unicode_replace_impl(
    value: str,
    old: str,
    new: str,
    count: int,
) -> str:
    if count == 0:
        return value

    if len(old) == 0:
        insertions = len(value) + 1

        if count >= 0 and count < insertions:
            insertions = count

        if insertions == 0:
            return value

        maxchar = _unicode_maxchar(value)
        new_maxchar = _unicode_maxchar(new)

        if new_maxchar > maxchar:
            maxchar = new_maxchar

        result = _unicode_new_uninit(
            len(value) + insertions * len(new),
            maxchar,
        )
        out = 0

        for i in range(len(value) + 1):
            if i < insertions:
                _unicode_copy_range(result, new, out, 0, len(new))
                out += len(new)

            if i < len(value):
                result._store_codepoint(out, value._load_codepoint(i))
                out += 1

        return result

    total_len = len(value)
    start = 0
    remaining = count

    while True:
        if count >= 0 and remaining == 0:
            break

        pos = _unicode_fastsearch(value, old, start, len(value))

        if pos == -1:
            break

        total_len += len(new) - len(old)
        start = pos + len(old)

        if count >= 0:
            remaining -= 1

    if start == 0:
        return value

    maxchar = _unicode_maxchar(value)
    new_max = _unicode_maxchar(new)

    if new_max > maxchar:
        maxchar = new_max

    result = _unicode_new_uninit(total_len, maxchar)

    out = 0
    start = 0
    remaining = count

    while True:
        if count >= 0 and remaining == 0:
            break

        pos = _unicode_fastsearch(value, old, start, len(value))

        if pos == -1:
            break

        _unicode_copy_range(result, value, out, start, pos)
        out += pos - start

        _unicode_copy_range(result, new, out, 0, len(new))
        out += len(new)

        start = pos + len(old)

        if count >= 0:
            remaining -= 1

    _unicode_copy_range(result, value, out, start, len(value))
    return result


def _unicode_translate_int_impl(value: str, table: dict[int, int]) -> str:
    maxchar = 0
    out_len = 0

    for i in range(len(value)):
        cp = value._load_codepoint(i)
        mapped = table.get(cp, cp)

        if mapped < 0 or mapped > UNICODE_MAX:
            raise ValueError("invalid translation code point")

        if mapped > maxchar:
            maxchar = mapped

        out_len += 1

    result = _unicode_new_uninit(out_len, maxchar)
    out = 0

    for i in range(len(value)):
        cp = value._load_codepoint(i)
        mapped = table.get(cp, cp)

        result._store_codepoint(out, mapped)
        out += 1

    return result


def _unicode_translate_unicode_impl(
    value: str,
    table: dict[int, str],
) -> str:
    output_length = 0
    maxchar = 0

    for i in range(len(value)):
        cp = value._load_codepoint(i)
        mapped = table.get(cp)
        if mapped is not None:
            output_length += len(mapped)
            mapped_maxchar = _unicode_maxchar(mapped)
        else:
            output_length += 1
            mapped_maxchar = cp

        if mapped_maxchar > maxchar:
            maxchar = mapped_maxchar

    result = _unicode_new_uninit(output_length, maxchar)
    output = 0

    for i in range(len(value)):
        cp = value._load_codepoint(i)
        mapped = table.get(cp)
        if mapped is not None:
            _unicode_copy_range(result, mapped, output, 0, len(mapped))
            output += len(mapped)
        else:
            result._store_codepoint(output, cp)
            output += 1

    return result


def _unicode_translate_optional_int_impl(
    value: str,
    table: dict[int, Optional[int]],
) -> str:
    maxchar = 0
    out_len = 0

    for i in range(len(value)):
        codepoint = value._load_codepoint(i)
        mapped = table.get(codepoint, codepoint)

        if mapped is None:
            continue

        if mapped < 0 or mapped > UNICODE_MAX:
            raise ValueError("invalid translation code point")

        if mapped > maxchar:
            maxchar = mapped
        out_len += 1

    result = _unicode_new_uninit(out_len, maxchar)
    out = 0

    for i in range(len(value)):
        codepoint = value._load_codepoint(i)
        mapped = table.get(codepoint, codepoint)

        if mapped is not None:
            result._store_codepoint(out, mapped)
            out += 1

    return result


def _unicode_translate_optional_unicode_impl(
    value: str,
    table: dict[int, Optional[str]],
) -> str:
    output_length = 0
    maxchar = 0

    for i in range(len(value)):
        cp = value._load_codepoint(i)
        mapped = table.get(cp, value[i])
        if mapped is not None:
            output_length += len(mapped)
            mapped_maxchar = _unicode_maxchar(mapped)
            if mapped_maxchar > maxchar:
                maxchar = mapped_maxchar

    result = _unicode_new_uninit(output_length, maxchar)
    output = 0

    for i in range(len(value)):
        cp = value._load_codepoint(i)
        mapped = table.get(cp, value[i])
        if mapped is not None:
            _unicode_copy_range(result, mapped, output, 0, len(mapped))
            output += len(mapped)

    return result


def _unicode_ascii_map(value: str, transform) -> str:
    result = _unicode_new_uninit(len(value), 0x7F)

    for i in range(len(value)):
        result._ptr[i] = u8(transform(int(value._ptr[i])))

    return result


def _unicode_ascii_capitalize(value: str) -> str:
    result = _unicode_new_uninit(len(value), 0x7F)

    if len(value) == 0:
        return result

    result._ptr[0] = u8(_ascii_upper(int(value._ptr[0])))

    for i in range(1, len(value)):
        result._ptr[i] = u8(_ascii_lower(int(value._ptr[i])))

    return result


def _unicode_ascii_title(value: str) -> str:
    result = _unicode_new_uninit(len(value), 0x7F)
    previous_is_cased = False

    for i in range(len(value)):
        cp = int(value._ptr[i])

        if _is_ascii_alpha(cp):
            if previous_is_cased:
                cp = _ascii_lower(cp)
            else:
                cp = _ascii_upper(cp)
            previous_is_cased = True
        else:
            previous_is_cased = False

        result._ptr[i] = u8(cp)

    return result


def _unicode_map_full(value: str, mapping_length, mapping_codepoint) -> str:
    output_length = 0
    maxchar = 0
    unchanged = True

    for i in range(len(value)):
        cp = value._load_codepoint(i)
        length = mapping_length(cp)
        output_length += length

        if length != 1:
            unchanged = False

        for j in range(length):
            mapped = mapping_codepoint(cp, j)
            if mapped > maxchar:
                maxchar = mapped
            if mapped != cp:
                unchanged = False

    if unchanged:
        return value

    result = _unicode_new_uninit(output_length, maxchar)
    output = 0

    for i in range(len(value)):
        cp = value._load_codepoint(i)
        length = mapping_length(cp)

        for j in range(length):
            result._store_codepoint(output, mapping_codepoint(cp, j))
            output += 1

    return result


def _unicode_is_final_sigma(value: str, pos: int) -> bool:
    if value._load_codepoint(pos) != 0x03A3:
        return False

    i = pos - 1
    while i >= 0 and unicode_is_case_ignorable(value._load_codepoint(i)):
        i -= 1

    if i < 0 or not unicode_is_cased(value._load_codepoint(i)):
        return False

    i = pos + 1
    while i < len(value) and unicode_is_case_ignorable(value._load_codepoint(i)):
        i += 1

    return i >= len(value) or not unicode_is_cased(value._load_codepoint(i))


def _unicode_lower_mapping_length(value: str, pos: int) -> int:
    if _unicode_is_final_sigma(value, pos):
        return 1

    return unicode_lower_mapping_length(value._load_codepoint(pos))


def _unicode_lower_mapping_codepoint(
    value: str,
    pos: int,
    index: int,
) -> int:
    if _unicode_is_final_sigma(value, pos):
        return 0x03C2

    return unicode_lower_mapping_codepoint(value._load_codepoint(pos), index)


def _unicode_lower_full(value: str) -> str:
    output_length = 0
    maxchar = 0
    unchanged = True

    for i in range(len(value)):
        cp = value._load_codepoint(i)
        length = _unicode_lower_mapping_length(value, i)
        output_length += length

        if length != 1:
            unchanged = False

        for j in range(length):
            mapped = _unicode_lower_mapping_codepoint(value, i, j)
            if mapped > maxchar:
                maxchar = mapped
            if mapped != cp:
                unchanged = False

    if unchanged:
        return value

    result = _unicode_new_uninit(output_length, maxchar)
    output = 0

    for i in range(len(value)):
        length = _unicode_lower_mapping_length(value, i)

        for j in range(length):
            result._store_codepoint(
                output,
                _unicode_lower_mapping_codepoint(value, i, j),
            )
            output += 1

    return result


def _unicode_upper_full(value: str) -> str:
    output_length = 0
    maxchar = 0
    unchanged = True

    for i in range(len(value)):
        cp = value._load_codepoint(i)
        if cp < 0x80:
            mapped = _ascii_upper(cp)
            output_length += 1
            if mapped > maxchar:
                maxchar = mapped
            if mapped != cp:
                unchanged = False
            continue

        length = unicode_upper_mapping_length(cp)
        output_length += length
        if length != 1:
            unchanged = False
        for j in range(length):
            mapped = unicode_upper_mapping_codepoint(cp, j)
            if mapped > maxchar:
                maxchar = mapped
            if mapped != cp:
                unchanged = False

    if unchanged:
        return value

    result = _unicode_new_uninit(output_length, maxchar)
    output = 0
    for i in range(len(value)):
        cp = value._load_codepoint(i)
        if cp < 0x80:
            result._store_codepoint(output, _ascii_upper(cp))
            output += 1
            continue

        length = unicode_upper_mapping_length(cp)
        for j in range(length):
            result._store_codepoint(output, unicode_upper_mapping_codepoint(cp, j))
            output += 1

    return result


def _unicode_capitalize_full(value: str) -> str:
    output_length = 0
    maxchar = 0

    for i in range(len(value)):
        if i == 0:
            cp = value._load_codepoint(i)
            length = unicode_title_mapping_length(cp)

            for j in range(length):
                mapped = unicode_title_mapping_codepoint(cp, j)
                if mapped > maxchar:
                    maxchar = mapped
        else:
            length = _unicode_lower_mapping_length(value, i)

            for j in range(length):
                mapped = _unicode_lower_mapping_codepoint(value, i, j)
                if mapped > maxchar:
                    maxchar = mapped

        output_length += length

    result = _unicode_new_uninit(output_length, maxchar)
    output = 0

    for i in range(len(value)):
        cp = value._load_codepoint(i)
        if i == 0:
            length = unicode_title_mapping_length(cp)
            for j in range(length):
                result._store_codepoint(
                    output,
                    unicode_title_mapping_codepoint(cp, j),
                )
                output += 1
        else:
            length = _unicode_lower_mapping_length(value, i)
            for j in range(length):
                result._store_codepoint(
                    output,
                    _unicode_lower_mapping_codepoint(value, i, j),
                )
                output += 1

    return result


def _unicode_title_full(value: str) -> str:
    output_length = 0
    maxchar = 0
    previous_is_cased = False

    for i in range(len(value)):
        cp = value._load_codepoint(i)

        if previous_is_cased:
            length = _unicode_lower_mapping_length(value, i)
            for j in range(length):
                mapped = _unicode_lower_mapping_codepoint(value, i, j)
                if mapped > maxchar:
                    maxchar = mapped
        else:
            length = unicode_title_mapping_length(cp)
            for j in range(length):
                mapped = unicode_title_mapping_codepoint(cp, j)
                if mapped > maxchar:
                    maxchar = mapped

        output_length += length

        if unicode_is_cased(cp):
            previous_is_cased = True
        else:
            previous_is_cased = False

    result = _unicode_new_uninit(output_length, maxchar)
    output = 0
    previous_is_cased = False

    for i in range(len(value)):
        cp = value._load_codepoint(i)

        if previous_is_cased:
            length = _unicode_lower_mapping_length(value, i)
            for j in range(length):
                result._store_codepoint(
                    output,
                    _unicode_lower_mapping_codepoint(value, i, j),
                )
                output += 1
        else:
            length = unicode_title_mapping_length(cp)
            for j in range(length):
                result._store_codepoint(
                    output,
                    unicode_title_mapping_codepoint(cp, j),
                )
                output += 1

        if unicode_is_cased(cp):
            previous_is_cased = True
        else:
            previous_is_cased = False

    return result


def _unicode_swapcase_full(value: str) -> str:
    output_length = 0
    maxchar = 0

    for i in range(len(value)):
        cp = value._load_codepoint(i)

        if unicode_is_lower(cp):
            length = unicode_upper_mapping_length(cp)
            for j in range(length):
                mapped = unicode_upper_mapping_codepoint(cp, j)
                if mapped > maxchar:
                    maxchar = mapped
        elif unicode_is_upper(cp):
            length = _unicode_lower_mapping_length(value, i)
            for j in range(length):
                mapped = _unicode_lower_mapping_codepoint(value, i, j)
                if mapped > maxchar:
                    maxchar = mapped
        else:
            length = 1
            if cp > maxchar:
                maxchar = cp

        output_length += length

    result = _unicode_new_uninit(output_length, maxchar)
    output = 0

    for i in range(len(value)):
        cp = value._load_codepoint(i)

        if unicode_is_lower(cp):
            length = unicode_upper_mapping_length(cp)
            for j in range(length):
                result._store_codepoint(
                    output,
                    unicode_upper_mapping_codepoint(cp, j),
                )
                output += 1
        elif unicode_is_upper(cp):
            length = _unicode_lower_mapping_length(value, i)
            for j in range(length):
                result._store_codepoint(
                    output,
                    _unicode_lower_mapping_codepoint(value, i, j),
                )
                output += 1
        else:
            result._store_codepoint(output, cp)
            output += 1

    return result


def _ascii_lower(cp: int) -> int:
    if 0x41 <= cp <= 0x5A:
        return cp + 0x20
    return cp


def _ascii_upper(cp: int) -> int:
    if 0x61 <= cp <= 0x7A:
        return cp - 0x20
    return cp


def _ascii_casefold(cp: int) -> int:
    return _ascii_lower(cp)


def _ascii_swapcase(cp: int) -> int:
    if 0x41 <= cp <= 0x5A:
        return cp + 0x20
    if 0x61 <= cp <= 0x7A:
        return cp - 0x20
    return cp


def _is_ascii_whitespace(cp: int) -> bool:
    return (
        cp == 0x09
        or cp == 0x0A
        or cp == 0x0B
        or cp == 0x0C
        or cp == 0x0D
        or cp == 0x20
    )


def _is_ascii_alpha(cp: int) -> bool:
    return (0x41 <= cp <= 0x5A) or (0x61 <= cp <= 0x7A)


def _is_ascii_digit(cp: int) -> bool:
    return 0x30 <= cp <= 0x39


def _is_ascii_alnum(cp: int) -> bool:
    return _is_ascii_alpha(cp) or _is_ascii_digit(cp)


def _is_ascii_lower(cp: int) -> bool:
    return 0x61 <= cp <= 0x7A


def _is_ascii_upper(cp: int) -> bool:
    return 0x41 <= cp <= 0x5A


def _is_ascii_id_start(cp: int) -> bool:
    return _is_ascii_alpha(cp) or cp == 0x5F


def _is_ascii_id_continue(cp: int) -> bool:
    return _is_ascii_alpha(cp) or _is_ascii_digit(cp) or cp == 0x5F


class _UnicodeByteBuffer:
    data: Ptr[u8]
    length: int
    capacity: int

    def __init__(self, capacity: int = 16):
        self.data = Ptr[u8](capacity)
        self.length = 0
        self.capacity = capacity

    def reserve(self, extra: int):
        required = self.length + extra

        if required <= self.capacity:
            return

        old_capacity = self.capacity
        capacity = old_capacity

        while capacity < required:
            capacity *= 2

        self.data = gc.realloc(self.data, capacity, old_capacity)
        self.capacity = capacity

    def append_byte(self, value: u8):
        self.reserve(1)
        self.data[self.length] = value
        self.length += 1

    def append_utf8(self, cp: int):
        self.reserve(_utf8_encoded_width(cp))
        self.length = _utf8_encode_one(self.data, self.length, cp)


def _unicode_repr_append_hex(
    output: _UnicodeByteBuffer,
    value: int,
    digits: int,
):
    for i in range(digits - 1, -1, -1):
        digit = (value >> (i * 4)) & 0xF
        output.append_byte(
            u8(0x30 + digit if digit < 10 else 0x61 + digit - 10)
        )


def _unicode_repr_append_codepoint(
    output: _UnicodeByteBuffer,
    cp: int,
    quote: int,
):
    if cp == quote or cp == 0x5C:  # quote / backslash
        output.append_byte(u8(0x5C))
        output.append_byte(u8(cp))
        return

    if cp == 0x09:
        output.append_byte(u8(0x5C))
        output.append_byte(u8(0x74))
        return

    if cp == 0x0A:
        output.append_byte(u8(0x5C))
        output.append_byte(u8(0x6E))
        return

    if cp == 0x0D:
        output.append_byte(u8(0x5C))
        output.append_byte(u8(0x72))
        return

    if cp < 0x20 or cp == 0x7F:
        output.append_byte(u8(0x5C))
        output.append_byte(u8(0x78))
        _unicode_repr_append_hex(output, cp, 2)
        return

    if unicode_is_printable(cp):
        output.append_utf8(cp)
        return

    output.append_byte(u8(0x5C))

    if cp <= 0xFF:
        output.append_byte(u8(0x78))
        _unicode_repr_append_hex(output, cp, 2)
    elif cp <= 0xFFFF:
        output.append_byte(u8(0x75))
        _unicode_repr_append_hex(output, cp, 4)
    else:
        output.append_byte(u8(0x55))
        _unicode_repr_append_hex(output, cp, 8)
