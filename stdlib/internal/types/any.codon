import internal.static as static


@__internal__
class Any:
    _data: Ptr[byte]
    _typeinfo: TypeInfo

    def __str__(self):
        # if self._typeinfo.repr.__raw__() != cobj():
        #     return f"Any({self._typeinfo.repr(self._data)}, {self._typeinfo})"
        return f"Any({self._typeinfo.nice_name})"

    def __hash__(self):
        return self._data.__int__().__hash__()

    def __eq__(self, o):
        return self._data == o._data and self._typeinfo == o._typeinfo

    def __ne__(self, o):
        return not (self == o)

    def __repr__(self):
        return self.__str__()

    def __new__() -> Any:
        return __magic__.new(Any)

    def __init__(self, ti: TypeInfo, data: Ptr[byte]):
        if ti._isinstance(Any):  # Disallow Any[Any]
            obj = type._force_cast(data, Any)
            self._typeinfo = obj._typeinfo
            self._data = obj._data
        else:
            self._typeinfo = ti
            self._data = data

    def __init__(self, obj):
        if isinstance(obj, Any):  # Disallow Any[Any]
            self._typeinfo = obj._typeinfo
            self._data = obj._data
            return

        T: type = type(obj)
        self._typeinfo = TypeInfo.cache(__vtables__, T)
        if isinstance(T, ByVal):
            p = Ptr[T](1)
            p[0] = obj
            self._data = p.as_byte()
        else:
            self._data = obj.__raw__().as_byte()

    def __unwrap__(self, T: type) -> T:
        if T is Any:
            return self
        if not self._isinstance(T):
            raise TypeError(f"Any.unwrap failed: requested {T}, but got {self._typeinfo.nice_name} instead")
        if isinstance(T, ByVal):
            p = type._force_cast(self._data, Ptr[T])
            return p[0]
        else:
            ti, data = self._real_contents()
            if ti._rtti:
                for mro, off in ti.mro:
                    if T.__id__ == mro:
                        return RTTIType._new(data + off, ti.__raw__(), T)
                assert False, "cannot happen"
            else:
                return type._force_cast(data, T)

    def __cast__(self, T: type):
        if T is Ptr[Any]:
            if not self._typeinfo._isinstance(unrealized_type[Ptr]):
                raise ValueError("expected ptr")
            ti = TypeInfo.cache(self._typeinfo._params[0])
            ptr = Ptr[Ptr[byte]](self._data)
            p = Ptr[Any](1)
            p[0] = Any(ti, ptr[0])
            return p
        elif T is Optional[Any]:
            if not self._typeinfo._isinstance(unrealized_type[Optional]):
                raise ValueError("expected optional")

            ti = TypeInfo.cache(self._typeinfo._params[0])
            # jump to optional
            if ti._ref:
                data = Ptr[Ptr[byte]](self._data)[0]
                return Optional(Any(ti, data)) if data else None
            else:
                data = Ptr[i1](self._data)
                return Optional(Any(ti, (data + self._typeinfo._fields[0][2]).as_byte())) if data[0] else None
        elif T is List[Any]:
            if self._typeinfo._isinstance(unrealized_type[list]):
                ti = TypeInfo.cache(self._typeinfo._params[0])
                sz = Ptr[int](self._data)[0]
                data = self._data + int.__elemsize__ * 2
                data = Ptr[Ptr[byte]](data)[0]
                lst = List[Any](sz)
                for i in range(sz):
                    ptr = data + ti._size * i
                    if ti._ref:
                        ptr = Ptr[Ptr[byte]](ptr)[0]
                    lst.append(Any(ti, ptr))
                return lst
            elif self._typeinfo._isinstance(unrealized_type[Tuple]):
                lst = List[Any](len(self._typeinfo._fields))
                for _, i in self.members:
                    lst.append(i)
                return lst
            else:
                raise ValueError("expected list or tuple")
        elif T is Dict[Any, Any]:
            import internal.khash as khash

            if not self._typeinfo._isinstance(unrealized_type[Dict]):
                raise ValueError("expected dict")

            nbuckets = self.__getattr__("_n_buckets", int)
            flags = self.__getattr__("_flags", Ptr[u32])

            ti = self._real_typeinfo()
            data = self._data
            if ti._rtti:
                data = Ptr[cobj](data)[0]

            kidx, vidx = 5, 6
            kti, vti = TypeInfo.cache(ti._fields[kidx][1]), TypeInfo.cache(ti._fields[vidx][1])
            kti, vti = TypeInfo.cache(kti._params[0]), TypeInfo.cache(vti._params[0])
            kptr, vptr = data + ti._fields[kidx][2], data + ti._fields[vidx][2]
            kptr, vptr = Ptr[Ptr[byte]](kptr)[0], Ptr[Ptr[byte]](vptr)[0]
            print(kti._size, vti._size)
            d: Dict[Any, Any] = {}
            i = 0
            while i < nbuckets:
                if not khash.__ac_iseither(flags, i):
                    kp = kptr + i * kti._size
                    if kti._ref:
                        kp = Ptr[Ptr[byte]](kp)[0]
                    vp = vptr + i * vti._size
                    if vti._ref:
                        vp = Ptr[Ptr[byte]](vp)[0]
                    d[Any(kti, kp)] = Any(vti, vp)
                i += 1
            return d
        else:
            return self.__unwrap__(T)

    def _real_typeinfo(self):
        if self._typeinfo._rtti:
            return type._force_cast(type._force_cast(self._data, RTTIType).typeinfo, TypeInfo)
        return self._typeinfo

    def _real_contents(self):
        ptr = self._data
        ti = self._typeinfo
        if ti._rtti:
            # Get the original!
            rtti = type._force_cast(self._data, RTTIType)
            current = ti.id
            off = 0
            ti = type._force_cast(rtti.typeinfo, TypeInfo)
            for mro, offset in ti.mro:
                if mro == current:
                    off = offset
                    break
            else:
                raise TypeError(f"cannot find {ti.nice_name} in {self._typeinfo.nice_name}")
            ptr = rtti.data - off
        return ti, ptr

    def _isinstance(self, T: type) -> bool:
        if T is Ptr[Any]:
            return self._typeinfo._isinstance(unrealized_type[Ptr])
        if T is Optional[Any]:
            return self._typeinfo._isinstance(unrealized_type[Optional])
        if T is List[Any]:
            return self._typeinfo._isinstance(unrealized_type[List]) or self._typeinfo._isinstance(unrealized_type[Tuple])
        if T is Dict[Any, Any]:
            return self._typeinfo._isinstance(unrealized_type[Dict])
        return self._real_typeinfo()._isinstance(T)

    def _getinstance(self, T: type) -> T:
        # DO NOT USE DIRECTLY. Assumes that isinstance is true.
        return self.__cast__(T)

    def __getattr__(self, attr: Literal[str], T: type = Any) -> T:
        for name, value in self.members:
            if name == attr:
                return value.__unwrap__(T)
        raise AttributeError(f"{attr} not found")

    def __setattr__(self, attr: Literal[str], value: T, T: type):
        for name, any in self.members:
            if name == attr:
                if any._typeinfo.id != TypeInfo.cache(T).id:
                    raise TypeError(f"{attr} type does not match {T}")
                ptr = Ptr[T](any._data)
                ptr[0] = value
                return
        raise AttributeError(f"{attr} not found")

    def _hasattr(self, attr: Literal[str]):
        return any(name == attr for name, _ in self.members)

    @property
    def __name__(self) -> str:
        return self._real_typeinfo().nice_name

    @property
    def members(self):
        ti, ptr = self._real_contents()
        for name, fti, offset in ti:
            data = ptr + offset
            if fti._ref:
                data = Ptr[Ptr[byte]](data)[0]
            yield name, Any(fti, data)


@extend
class Capsule:
    @pure
    @derives
    @inline
    def _make(val: T, T: type) -> Capsule[T]:

        @pure
        @derives
        @inline
        @llvm
        def ctr(val: Ptr[T], T: type) -> Capsule[T]:
            %0 = insertvalue { ptr } undef, ptr %val, 0
            ret { ptr } %0

        p = Ptr[T](1)
        p[0] = val
        return ctr(p)

    @pure
    @derives
    @llvm
    def _ptr(ref: Capsule[T], T: type) -> Ptr[T]:
        %0 = extractvalue { ptr } %ref, 0
        %1 = getelementptr {=T}, ptr %0, i64 0
        ret ptr %1

    @pure
    @derives
    @llvm
    def _get(ref: Capsule[T], T: type) -> T:
        %0 = extractvalue { ptr } %ref, 0
        %1 = getelementptr {=T}, ptr %0, i64 0
        %2 = load {=T}, ptr %1
        ret {=T} %2
