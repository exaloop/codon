import internal.static as static


@tuple(init=False, container=False)
@__internal__
class Any:
    _data: Ptr[u8]
    _typeinfo: TypeInfo

    def _is_inline(self) -> bool:
        return self._typeinfo.inline_value

    @pure
    @llvm
    def _pack_inline(value: T, T: type) -> Ptr[byte]:
        %storage = alloca i64, align 8
        store i64 0, ptr %storage, align 8
        store {=T} %value, ptr %storage, align 1
        %bits = load i64, ptr %storage, align 8
        %packed = inttoptr i64 %bits to ptr
        ret ptr %packed

    def __str__(self):
        return f"Any({self._typeinfo.nice_name})"

    def __hash__(self):
        payload = self._data
        data = __ptr__(payload).as_byte() if self._is_inline() else payload
        return self._real_typeinfo().value_hash(data)

    def __eq__(self, o):
        info = self._real_typeinfo()
        if info != o._real_typeinfo():
            return False
        left = self._data
        right = o._data
        left_data = __ptr__(left).as_byte() if self._is_inline() else left
        right_data = __ptr__(right).as_byte() if o._is_inline() else right
        return info.value_equal(left_data, right_data)

    def __ne__(self, o):
        return not (self == o)

    def __repr__(self):
        return self.__str__()

    def __new__(ti: TypeInfo, data: Ptr[byte]) -> Any:
        if ti._isinstance(Any):  # Disallow Any[Any]
            return Ptr[Any](data)[0]
        if ti.inline_value:
            payload = Ptr[byte]()
            str.memcpy(__ptr__(payload).as_byte(), data, ti.size)
            return type._force_value_cast((payload, ti), Any)
        return type._force_value_cast((data, ti), Any)

    def __new__(obj) -> Any:
        if isinstance(obj, Any):  # Disallow Any[Any]
            return obj

        T: type = type(obj)
        typeinfo = TypeInfo.cache(T)
        if isinstance(T, ByVal):
            if typeinfo.inline_value:
                return type._force_value_cast((Any._pack_inline(obj), typeinfo), Any)
            pointer = Ptr[T](1)
            pointer[0] = obj
            return Any(typeinfo, pointer.as_byte())
        else:
            return Any(typeinfo, obj.__raw__().as_byte())

    def __unwrap__(self, T: type) -> T:
        if T is Any:
            return self
        if not self._isinstance(T):
            raise TypeError(f"Any.unwrap failed: requested {TypeInfo.cache(T).nice_name}, but got {self._typeinfo.nice_name} instead")
        if isinstance(T, ByVal):
            if self._is_inline():
                payload = self._data
                return Ptr[T](__ptr__(payload))[0]
            p = type._force_cast(self._data, Ptr[T])
            return p[0]
        else:
            ti, data = self._real_contents()
            return type._force_cast(data, T)

    def __cast__(self, T: type):
        if T is Ptr[Any]:
            if not self._typeinfo._isinstance(unrealized_type[Ptr]):
                raise ValueError("expected ptr")
            ti = TypeInfo.cache(self._typeinfo.params[0])
            ptr = Ptr[Ptr[byte]](self._data)
            p = Ptr[Any](1)
            p[0] = Any(ti, ptr[0])
            return p
        elif T is Optional[Any]:
            if not self._typeinfo._isinstance(unrealized_type[Optional]):
                raise ValueError("expected optional")

            ti = TypeInfo.cache(self._typeinfo.params[0])
            # jump to optional
            if ti.reference:
                data = Ptr[Ptr[byte]](self._data)[0]
                return Optional(Any(ti, data)) if data else None
            else:
                data = Ptr[i1](self._data)
                return Optional(Any(ti, self._data + self._typeinfo.slots[0][2])) if data[0] else None
        elif T is List[Any]:
            if self._typeinfo._isinstance(unrealized_type[list]):
                ti = TypeInfo.cache(self._typeinfo.params[0])
                sz = self.__getattr__("_len", int)
                data = Ptr[Ptr[byte]](self._data)[0]
                lst = List[Any](sz)
                for i in range(sz):
                    ptr = data + ti.size * i
                    if ti.reference:
                        ptr = Ptr[Ptr[byte]](ptr)[0]
                    lst.append(Any(ti, ptr))
                return lst
            elif self._typeinfo._isinstance(unrealized_type[Tuple]):
                lst = List[Any](self._typeinfo.n_slots)
                for _, i in self.members:
                    lst.append(i)
                return lst
            else:
                raise ValueError("expected list or tuple")
        elif T is Dict[Any, Any]:
            if not self._typeinfo._isinstance(unrealized_type[Dict]):
                raise ValueError("expected dict")
            return self._real_typeinfo().value_dict(self._data)
        else:
            return self.__unwrap__(T)

    def _real_typeinfo(self):
        if self._typeinfo.rtti:
            return get_typeinfo(self._data)
        return self._typeinfo

    def _real_contents(self):
        """Inline scalars have no fields and expose no addressable payload."""
        return self._real_typeinfo(), Ptr[byte]() if self._is_inline() else self._data

    def _isinstance(self, T: type) -> bool:
        if T is Ptr[Any]:
            return self._typeinfo._isinstance(unrealized_type[Ptr])
        if T is Optional[Any]:
            return self._typeinfo._isinstance(unrealized_type[Optional])
        if T is List[Any]:
            return self._typeinfo._isinstance(unrealized_type[List]) or self._typeinfo._isinstance(unrealized_type[Tuple])
        if T is Dict[Any, Any]:
            return self._typeinfo._isinstance(unrealized_type[Dict])
        return self._real_typeinfo()._isinstance(T)

    def _getinstance(self, T: type) -> T:
        # DO NOT USE DIRECTLY. Assumes that isinstance is true.
        return self.__cast__(T)

    def __getattr__(self, attr: Literal[str], T: type = Any) -> T:
        for name, value in self.members:
            if name == attr:
                return value.__unwrap__(T)
        raise AttributeError(f"{attr} not found")

    def __setattr__(self, attr: Literal[str], value: T, T: type):
        info, data = self._real_contents()
        for name, field_info, offset in info:
            if name == attr:
                if field_info.id != TypeInfo.cache(T).id:
                    raise TypeError(f"{attr} type does not match {TypeInfo.cache(T).nice_name}")
                ptr = Ptr[T](data + offset)
                ptr[0] = value
                return
        raise AttributeError(f"{attr} not found")

    def _hasattr(self, attr: Literal[str]):
        return any(name == attr for name, _ in self.members)

    @property
    def __name__(self) -> str:
        return self._real_typeinfo().nice_name

    @property
    def members(self):
        ti, ptr = self._real_contents()
        for name, fti, offset in ti:
            data = ptr + offset
            if fti.reference:
                data = Ptr[Ptr[byte]](data)[0]
            yield name, Any(fti, data)


@extend
class Capsule:
    @pure
    @derives
    @inline
    def _make(val: T, T: type) -> Capsule[T]:

        @pure
        @derives
        @inline
        @llvm
        def ctr(val: Ptr[T], T: type) -> Capsule[T]:
            %0 = insertvalue { ptr } undef, ptr %val, 0
            ret { ptr } %0

        p = Ptr[T](1)
        p[0] = val
        return ctr(p)

    @pure
    @derives
    @llvm
    def _ptr(ref: Capsule[T], T: type) -> Ptr[T]:
        %0 = extractvalue { ptr } %ref, 0
        %1 = getelementptr {=T}, ptr %0, i64 0
        ret ptr %1

    @pure
    @derives
    @llvm
    def _get(ref: Capsule[T], T: type) -> T:
        %0 = extractvalue { ptr } %ref, 0
        %1 = getelementptr {=T}, ptr %0, i64 0
        %2 = load {=T}, ptr %1
        ret {=T} %2
