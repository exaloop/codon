import internal.static as static

@extend
class bytes:
    @__internal__
    def __new__(p: Ptr[u8], l: int) -> bytes:
        pass

    @overload
    def __new__() -> bytes:
        return bytes(Ptr[u8](), 0)

    @overload
    def __new__(what: bytes) -> bytes:
        return what

    def __new__(what: str, encoding: str, errors: str = "strict") -> bytes:
        return what.encode(encoding, errors)

    def decode(self, encoding: str = "utf-8", errors: str = "strict") -> str:
        return str(self, encoding, errors)

    def __str__(what: bytes) -> str:
        return what.__repr__()

    def __len__(self) -> int:
        return self._len

    def __bool__(self) -> bool:
        return self._len != 0

    def __copy__(self) -> bytes:
        return self

    def __deepcopy__(self) -> bytes:
        return self

    def __ptrcopy__(self) -> bytes:
        n = self._len
        p = cobj(n)
        bytes.memcpy(p, self._ptr, n)
        return bytes(p, n)

    @llvm
    def memcpy(dest: Ptr[u8], src: Ptr[u8], len: int) -> None:
        declare void @llvm.memcpy.p0i8.p0i8.i64(ptr %dest, ptr %src, i64 %len, i32 %align, i1 %isvolatile)
        call void @llvm.memcpy.p0i8.p0i8.i64(ptr %dest, ptr %src, i64 %len, i32 0, i1 false)
        ret {} {}

    @llvm
    def memmove(dest: Ptr[u8], src: Ptr[u8], len: int) -> None:
        declare void @llvm.memmove.p0i8.p0i8.i64(ptr %dest, ptr %src, i64 %len, i32 %align, i1 %isvolatile)
        call void @llvm.memmove.p0i8.p0i8.i64(ptr %dest, ptr %src, i64 %len, i32 0, i1 false)
        ret {} {}

    @llvm
    def memset(dest: Ptr[u8], val: u8, len: int) -> None:
        declare void @llvm.memset.p0i8.i64(ptr %dest, i8 %val, i64 %len, i32 %align, i1 %isvolatile)
        call void @llvm.memset.p0i8.i64(ptr %dest, i8 %val, i64 %len, i32 0, i1 false)
        ret {} {}

    def __add__(self, other: bytes) -> bytes:
        len1 = self._len
        len2 = other._len
        len3 = len1 + len2
        p = Ptr[u8](len3)
        bytes.memcpy(p, self._ptr, len1)
        bytes.memcpy(p + len1, other._ptr, len2)
        return bytes(p, len3)

    def c_str(self) -> cobj:
        n = self.__len__()
        p = cobj(n + 1)
        bytes.memcpy(p, self._ptr, n)
        p[n] = u8(0)
        return p

    def from_ptr(t: cobj) -> bytes:
        n = _C.strlen(t)
        p = Ptr[u8](n)
        bytes.memcpy(p, t, n)
        return bytes(p, n)

    def __eq__(self, other: bytes) -> bool:
        if self._len != other._len:
            return False
        i = 0
        while i < self._len:
            if self._ptr[i] != other._ptr[i]:
                return False
            i += 1
        return True

    def __match__(self, obj: bytes) -> bool:
        return self.__eq__(obj)

    def __ne__(self, other: bytes) -> bool:
        return not self.__eq__(other)

    def cat(*args) -> bytes:
        total = 0
        if (
            static.len(args) == 1
            and hasattr(args[0], "__iter__")
            and hasattr(args[0], "__len__")
        ):
            for s in args[0]:
                if not isinstance(s, bytes):
                    compile_error("not a string")
                total += s._len
            p = cobj(total)
            n = 0
            for s in args[0]:
                bytes.memcpy(p + n, s._ptr, s._len)
                n += s._len
            return bytes(p, total)
        elif static.len(args) == 1 and hasattr(args[0], "__iter__"):
            sz = 10
            p = cobj(sz)
            n = 0
            for s in args[0]:
                if not isinstance(s, bytes):
                    compile_error("not a string")
                if n + s._len > sz:
                    sz = 1 + 3 * (n + s._len).cdiv(2)
                    pp = cobj(sz)
                    bytes.memcpy(pp, p, n)
                    p = pp
                bytes.memcpy(p + n, s._ptr, s._len)
                n += s._len
            return bytes(p, n)
        else:
            for i in static.range(static.len(args)):
                s = args[i]
                if not isinstance(s, bytes):
                    compile_error("not bytes")
                total += s._len
            p = cobj(total)
            n = 0
            for i in static.range(static.len(args)):
                s = args[i]
                bytes.memcpy(p + n, s._ptr, s._len)
                n += s._len
            return bytes(p, total)
