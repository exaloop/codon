@extend
class Super:
    def __new__(B: type, obj: D, D: type) -> Super[B]:
        if not (static.has_rtti(D) and static.has_rtti(B)):
            compile_error("classes are not polymorphic")
        obj_B: B = force_cast(obj, B)
        return type._force_value_cast((obj_B, 0), Super[B])

        # rtti = type._force_cast(obj, RTTIType)
        # (di, bi), (doff, boff) = RTTIType._find_offsets(obj, D, B)
        # if bi == -1 or di == -1:
        #     raise TypeError(f"{B} has no super class")
        # new_obj = RTTIType._new(rtti.data - doff + boff, rtti.typeinfo, B)
        # return type._force_value_cast((new_obj, bi), Super[B])

    def __getattr__(self, attr: Literal[str]):
        return Super[T]._dispatch(self, attr=attr, ...)

    @inline
    @__generated__
    def _dispatch(self, attr: Literal[str], *args, **kwargs):
