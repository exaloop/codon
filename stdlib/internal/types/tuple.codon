import internal.static as static

@extend
class Tuple:
    def _fix_index(idx: int, len: int) -> int:
        if idx < 0:
            idx += len
        if idx < 0 or idx >= len:
            raise IndexError("tuple index out of range")
        return idx

    def _getitem(t: T, idx: int, T: type, E: type) -> E:
        @pure
        @derives
        @llvm
        def llvm_helper(t: T, idx: int, T: type, E: type) -> E:
            %x = alloca {=T}
            store {=T} %t, ptr %x
            %p = getelementptr {=E}, ptr %x, i64 %idx
            %v = load {=E}, ptr %p
            ret {=E} %v

        return llvm_helper(t, Tuple._fix_index(idx, static.len(t)), T, E)

    def _offsetof(x, field: Literal[int]) -> int:
        @pure
        @llvm
        def llvm_helper(T: type, idx: Literal[int], TE: type) -> int:
            %a = alloca {=T}
            %b = getelementptr inbounds {=T}, ptr %a, i64 0, i32 {=idx}
            %base = ptrtoint ptr %a to i64
            %elem = ptrtoint ptr %b to i64
            %offset = sub i64 %elem, %base
            ret i64 %offset

        return llvm_helper(type(x), field, type(x[field]))

    def _str(strs: Ptr[str], names: Ptr[str], n: int) -> str:
        # special case of 1-element plain tuple: format as "(x,)"
        if n == 1 and len(names[0]) == 0:
            buf = _strbuf(len(strs[0]) + 3, strs[0]._kind())
            buf.append("(")
            buf.append(strs[0])
            buf.append(",)")
            return str(buf)

        total = 2  # one for each of '(' and ')'
        kind = 0
        i = 0
        while i < n:
            total += len(strs[i])
            if strs[i]._kind() > kind:
                kind = strs[i]._kind()
            if len(names[i]):
                total += len(names[i]) + 2  # extra : and space
                if names[i]._kind() > kind:
                    kind = names[i]._kind()
            if i < n - 1:
                total += 2  # ", "
            i += 1

        buf = _strbuf(total, kind)
        buf.append("(")
        i = 0
        while i < n:
            if len(names[i]):
                buf.append(names[i])
                buf.append(": ")
            buf.append(strs[i])
            if i < n - 1:
                buf.append(", ")
            i += 1
        buf.append(")")
        return str(buf)


@extend
class FixedDict:
    @__generated__
    def _index(N: Literal[int], key: Literal[str]):
        pass

    @__generated__
    def _keys(N: Literal[int]):
        pass

    def __len__(self):
        return static.len(self._values)

    def __bool__(self):
        return len(self) != 0

    def keys(self):
        return FixedDict._keys(N)

    def values(self):
        return _FixedDictView(self._values)

    def items(self):
        return _FixedDictView(tuple((self.keys()[index], self._values[index])
                                    for index in static.range(static.len(self._values))))

    def __iter__(self) -> Generator[str]:
        if N == 0:
            for index in range(0):
                yield ""
        else:
            for key in self.keys():
                yield key

    def __getitem__(self, key: str):
        compile_error("fixed dictionary lookup requires a compile-time string key")

    def __getitem__(self, key: Literal[str]):
        index: Literal[int] = FixedDict._index(N, key)
        if index < 0:
            compile_error("unknown fixed dictionary key: " + key)
        else:
            return self._values[index]

    def __contains__(self, key: str):
        for index in static.range(static.len(self._values)):
            if self.keys()[index] == key:
                return True
        return False

    def __contains__(self, key: Literal[str]) -> Literal[bool]:
        return FixedDict._index(N, key) >= 0

    def get(self, key: str, default=None):
        compile_error("fixed dictionary lookup requires a compile-time string key")

    def get(self, key: Literal[str], default=None):
        index: Literal[int] = FixedDict._index(N, key)
        if index < 0:
            return default
        else:
            return self._values[index]

    def __repr__(self):
        keys = self.keys()
        values = [repr(value) for value in self._values]
        return '{' + ', '.join(repr(keys[index]) + ': ' + values[index]
                              for index in range(len(keys))) + '}'


@tuple
class _FixedDictView:
    _values: T
    T: type

    @__generated__
    def _value_type(Values: type):
        pass

    def __len__(self):
        return static.len(self._values)

    def __iter__(self):
        if static.len(self._values) == 0:
            for index in range(0):
                yield NoneType()
        else:
            Result = _FixedDictView._value_type(T)
            for index in static.range(static.len(self._values)):
                result: Result = self._values[index]
                yield result
