KIND_SHIFT: Literal[int] = 56

LEN_MASK: Literal[int] = (1 << KIND_SHIFT) - 1
KIND_MASK: Literal[int] = 3 << KIND_SHIFT

KIND_ASCII: Literal[int] = 0
KIND_LATIN1: Literal[int] = 1
KIND_UCS2: Literal[int] = 2
KIND_UCS4: Literal[int] = 3

UTF8_CONT_MASK: Literal[int] = 0xC0
UTF8_CONT_TAG: Literal[int] = 0x80

UNICODE_MAX: Literal[int] = 0x10FFFF
SURROGATE_MIN: Literal[int] = 0xD800
SURROGATE_MAX: Literal[int] = 0xDFFF

HANGUL_SBASE: Literal[int] = 0xAC00
HANGUL_LBASE: Literal[int] = 0x1100
HANGUL_VBASE: Literal[int] = 0x1161
HANGUL_TBASE: Literal[int] = 0x11A7
HANGUL_LCOUNT: Literal[int] = 19
HANGUL_VCOUNT: Literal[int] = 21
HANGUL_TCOUNT: Literal[int] = 28
HANGUL_NCOUNT: Literal[int] = HANGUL_VCOUNT * HANGUL_TCOUNT
HANGUL_SCOUNT: Literal[int] = HANGUL_LCOUNT * HANGUL_NCOUNT


@tuple
class unicode:
    _data: Ptr[u8]
    _meta: int


def _kind_for_maxchar(maxchar: int) -> int:
    if maxchar <= 0x7F:
        return KIND_ASCII
    elif maxchar <= 0xFF:
        return KIND_LATIN1
    elif maxchar <= 0xFFFF:
        return KIND_UCS2
    else:
        return KIND_UCS4


def _kind_width(kind: int) -> int:
    if kind <= KIND_LATIN1:
        return 1
    elif kind == KIND_UCS2:
        return 2
    else:
        return 4


def _make_meta(length: int, kind: int) -> int:
    return (length & LEN_MASK) | (kind << KIND_SHIFT)


def _meta_len(meta: int) -> int:
    return meta & LEN_MASK


def _meta_kind(meta: int) -> int:
    return (meta & KIND_MASK) >> KIND_SHIFT


def _is_surrogate(cp: int) -> bool:
    return SURROGATE_MIN <= cp <= SURROGATE_MAX


def _is_utf8_continuation(byte: int) -> bool:
    return (byte & UTF8_CONT_MASK) == UTF8_CONT_TAG


def _normalize_search_bounds(length: int, start: int, end: int) -> Tuple[int, int]:
    if start < 0:
        start += length
        if start < 0:
            start = 0

    if end < 0:
        end += length

    if end < 0:
        end = 0
    elif end > length:
        end = length

    return start, end


def _normalize_slice_bounds(length: int, start: int, end: int) -> Tuple[int, int]:
    if start < 0:
        start += length

    if end < 0:
        end += length

    if start < 0:
        start = 0
    elif start > length:
        start = length

    if end < 0:
        end = 0
    elif end > length:
        end = length

    return start, end


def _raise_utf8_decode_error(pos: int, end: int, reason: str):
    raise ValueError(
        "utf-8 decode error at bytes "
        + str(pos)
        + "-"
        + str(end)
        + ": "
        + reason
    )


def _raise_utf8_encode_error(pos: int, end: int, reason: str):
    raise ValueError(
        "utf-8 encode error at code points "
        + str(pos)
        + "-"
        + str(end)
        + ": "
        + reason
    )


def _utf8_decode_one(
    data: Ptr[u8],
    length: int,
    pos: int,
) -> Tuple[int, int]:
    b0 = int(data[pos])

    if b0 < 0x80:
        return b0, pos + 1

    if 0xC2 <= b0 <= 0xDF:
        if pos + 1 >= length:
            _raise_utf8_decode_error(pos, pos + 1, "unexpected EOF")

        b1 = int(data[pos + 1])

        if not _is_utf8_continuation(b1):
            _raise_utf8_decode_error(pos + 1, pos + 2, "invalid continuation byte")

        cp = ((b0 & 0x1F) << 6) | (b1 & 0x3F)

        if cp < 0x80:
            _raise_utf8_decode_error(pos, pos + 2, "overlong sequence")

        return cp, pos + 2

    if 0xE0 <= b0 <= 0xEF:
        if pos + 2 >= length:
            _raise_utf8_decode_error(pos, pos + 3, "unexpected EOF")

        b1 = int(data[pos + 1])
        b2 = int(data[pos + 2])

        if not _is_utf8_continuation(b1) or not _is_utf8_continuation(b2):
            _raise_utf8_decode_error(pos + 1, pos + 3, "invalid continuation byte")

        cp = ((b0 & 0x0F) << 12) | ((b1 & 0x3F) << 6) | (b2 & 0x3F)

        if cp < 0x800 or _is_surrogate(cp):
            _raise_utf8_decode_error(pos, pos + 3, "invalid code point")

        return cp, pos + 3

    if 0xF0 <= b0 <= 0xF4:
        if pos + 3 >= length:
            _raise_utf8_decode_error(pos, pos + 4, "unexpected EOF")

        b1 = int(data[pos + 1])
        b2 = int(data[pos + 2])
        b3 = int(data[pos + 3])

        if (
            not _is_utf8_continuation(b1)
            or not _is_utf8_continuation(b2)
            or not _is_utf8_continuation(b3)
        ):
            _raise_utf8_decode_error(pos + 1, pos + 4, "invalid continuation byte")

        cp = (
            ((b0 & 0x07) << 18)
            | ((b1 & 0x3F) << 12)
            | ((b2 & 0x3F) << 6)
            | (b3 & 0x3F)
        )

        if cp < 0x10000 or cp > UNICODE_MAX:
            _raise_utf8_decode_error(pos, pos + 4, "invalid code point")

        return cp, pos + 4

    _raise_utf8_decode_error(pos, pos + 1, "invalid start byte")
    return 0, pos + 1


def _utf8_scan_strict(
    data: Ptr[u8],
    byte_length: int,
) -> Tuple[int, int]:
    length = 0
    maxchar = 0
    pos = 0

    while pos < byte_length:
        cp, pos = _utf8_decode_one(data, byte_length, pos)
        length += 1

        if cp > maxchar:
            maxchar = cp

    return length, maxchar


def _unicode_decode_utf8_strict(
    data: Ptr[u8],
    byte_length: int,
) -> unicode:
    if byte_length < 0:
        raise ValueError("negative length")

    length, maxchar = _utf8_scan_strict(data, byte_length)

    result = _unicode_new_uninit(length, maxchar)

    src = 0
    dst = 0

    while src < byte_length:
        cp, src = _utf8_decode_one(data, byte_length, src)
        result._store_codepoint(dst, cp)
        dst += 1

    return result


def _utf8_encoded_width(cp: int) -> int:
    if cp < 0x80:
        return 1
    elif cp < 0x800:
        return 2
    elif cp < 0x10000:
        return 3
    else:
        return 4


def _utf8_size_strict(value: unicode) -> int:
    size = 0

    for i in range(len(value)):
        size += _utf8_encoded_width(value._load_codepoint(i))

    return size


def _utf8_encode_one(
    output: Ptr[u8],
    pos: int,
    cp: int,
) -> int:
    if cp > UNICODE_MAX or _is_surrogate(cp):
        _raise_utf8_encode_error(0, 0, "invalid code point")

    if cp < 0x80:
        output[pos] = u8(cp)
        return pos + 1

    if cp < 0x800:
        output[pos] = u8(0xC0 | (cp >> 6))
        output[pos + 1] = u8(0x80 | (cp & 0x3F))
        return pos + 2

    if cp < 0x10000:
        output[pos] = u8(0xE0 | (cp >> 12))
        output[pos + 1] = u8(0x80 | ((cp >> 6) & 0x3F))
        output[pos + 2] = u8(0x80 | (cp & 0x3F))
        return pos + 3

    output[pos] = u8(0xF0 | (cp >> 18))
    output[pos + 1] = u8(0x80 | ((cp >> 12) & 0x3F))
    output[pos + 2] = u8(0x80 | ((cp >> 6) & 0x3F))
    output[pos + 3] = u8(0x80 | (cp & 0x3F))

    return pos + 4


def _unicode_encode_utf8_strict(value: unicode) -> str:
    for i in range(len(value)):
        if _is_surrogate(value._load_codepoint(i)):
            _raise_utf8_encode_error(i, i + 1, "surrogates not allowed")

    byte_length = _utf8_size_strict(value)
    output = Ptr[u8](byte_length + 1)

    pos = 0

    for i in range(len(value)):
        pos = _utf8_encode_one(output, pos, value._load_codepoint(i))

    output[byte_length] = u8(0)

    return str(output, byte_length)


def _unicode_encode_utf8(value: unicode, errors: str) -> str:
    if errors == "strict":
        return _unicode_encode_utf8_strict(value)

    output = []

    for i in range(len(value)):
        codepoint = value._load_codepoint(i)

        if _is_surrogate(codepoint):
            if errors == "surrogatepass":
                output.append(0xE0 | (codepoint >> 12))
                output.append(0x80 | ((codepoint >> 6) & 0x3F))
                output.append(0x80 | (codepoint & 0x3F))
                continue

            if errors == "surrogateescape" and 0xDC80 <= codepoint <= 0xDCFF:
                output.append(codepoint - 0xDC00)
                continue

            _codec_encode_error_append(output, codepoint, errors)
            continue

        if codepoint < 0x80:
            output.append(codepoint)
        elif codepoint < 0x800:
            output.append(0xC0 | (codepoint >> 6))
            output.append(0x80 | (codepoint & 0x3F))
        elif codepoint < 0x10000:
            output.append(0xE0 | (codepoint >> 12))
            output.append(0x80 | ((codepoint >> 6) & 0x3F))
            output.append(0x80 | (codepoint & 0x3F))
        else:
            output.append(0xF0 | (codepoint >> 18))
            output.append(0x80 | ((codepoint >> 12) & 0x3F))
            output.append(0x80 | ((codepoint >> 6) & 0x3F))
            output.append(0x80 | (codepoint & 0x3F))

    return _bytes_from_values(output)


def _unicode_from_text(value: str) -> unicode:
    return _unicode_decode_utf8_strict(value._ptr, len(value))


def _codec_name(encoding: str) -> str:
    return encoding.lower().replace("_", "-")


def _codec_error_append(
    output: List[int],
    data: Ptr[u8],
    start: int,
    end: int,
    errors: str,
):
    if errors == "strict":
        raise ValueError("invalid byte sequence")

    if errors == "ignore":
        return

    if errors == "replace":
        output.append(0xFFFD)
        return

    if errors == "surrogateescape":
        for i in range(start, end):
            byte = int(data[i])
            if byte < 0x80:
                raise ValueError("invalid byte sequence")
            output.append(0xDC00 + byte)
        return

    if errors == "backslashreplace":
        for i in range(start, end):
            byte = int(data[i])
            output.append(0x5C)  # \
            output.append(0x78)  # x
            high = byte >> 4
            output.append(0x30 + high if high < 10 else 0x61 + high - 10)
            digit = byte & 0xF
            output.append(0x30 + digit if digit < 10 else 0x61 + digit - 10)
        return

    raise ValueError("unsupported error handling: " + errors)


def _unicode_from_codepoints(codepoints: List[int]) -> unicode:
    maxchar = 0

    for codepoint in codepoints:
        if codepoint > maxchar:
            maxchar = codepoint

    result = _unicode_new_uninit(len(codepoints), maxchar)

    for i in range(len(codepoints)):
        result._store_codepoint(i, codepoints[i])

    return result


def _unicode_decode_utf8(
    data: Ptr[u8],
    byte_length: int,
    errors: str,
) -> unicode:
    codepoints = []
    pos = 0

    while pos < byte_length:
        start = pos
        b0 = int(data[pos])

        if b0 < 0x80:
            codepoints.append(b0)
            pos += 1
            continue

        width = 0
        if 0xC2 <= b0 <= 0xDF:
            width = 2
        elif 0xE0 <= b0 <= 0xEF:
            width = 3
        elif 0xF0 <= b0 <= 0xF4:
            width = 4

        if width == 0:
            _codec_error_append(codepoints, data, start, start + 1, errors)
            pos += 1
            continue

        if pos + width > byte_length:
            _codec_error_append(codepoints, data, start, byte_length, errors)
            break

        valid = True
        for i in range(1, width):
            if not _is_utf8_continuation(int(data[pos + i])):
                valid = False
                break

        b1 = int(data[pos + 1])
        if (
            not valid
            or (b0 == 0xE0 and b1 < 0xA0)
            or (
                b0 == 0xED
                and b1 > 0x9F
                and errors != "surrogatepass"
            )
            or (b0 == 0xF0 and b1 < 0x90)
            or (b0 == 0xF4 and b1 > 0x8F)
        ):
            _codec_error_append(codepoints, data, start, start + 1, errors)
            pos += 1
            continue

        codepoint = b0 & (0x7F >> width)
        for i in range(1, width):
            codepoint = (codepoint << 6) | (int(data[pos + i]) & 0x3F)

        codepoints.append(codepoint)
        pos += width

    return _unicode_from_codepoints(codepoints)


def _unicode_decode_single_byte(
    data: Ptr[u8],
    byte_length: int,
    ascii: bool,
    errors: str,
) -> unicode:
    codepoints = []

    for i in range(byte_length):
        byte = int(data[i])
        if ascii and byte > 0x7F:
            _codec_error_append(codepoints, data, i, i + 1, errors)
        else:
            codepoints.append(byte)

    return _unicode_from_codepoints(codepoints)


@pure
@llvm
def _cp1252_c1_codepoint(index: int) -> i32:
    @data = private unnamed_addr constant [32 x i32] [i32 8364, i32 -1, i32 8218, i32 402, i32 8222, i32 8230, i32 8224, i32 8225, i32 710, i32 8240, i32 352, i32 8249, i32 338, i32 -1, i32 381, i32 -1, i32 -1, i32 8216, i32 8217, i32 8220, i32 8221, i32 8226, i32 8211, i32 8212, i32 732, i32 8482, i32 353, i32 8250, i32 339, i32 -1, i32 382, i32 376]
    %p = getelementptr inbounds [32 x i32], ptr @data, i64 0, i64 %index
    %x = load i32, ptr %p, align 4
    ret i32 %x


@pure
@llvm
def _cp1252_c1_byte(codepoint: int) -> i32:
    @data = private unnamed_addr constant [64 x i64] [i64 0, i64 96415, i64 2141312, i64 0, i64 0, i64 0, i64 0, i64 2107013, i64 0, i64 0, i64 97678, i64 0, i64 97950, i64 0, i64 0, i64 0, i64 0, i64 0, i64 0, i64 0, i64 90250, i64 90522, i64 0, i64 0, i64 0, i64 0, i64 2109577, i64 0, i64 187544, i64 0, i64 0, i64 2171545, i64 0, i64 0, i64 0, i64 2102166, i64 0, i64 2102423, i64 0, i64 0, i64 0, i64 0, i64 2111883, i64 0, i64 2112155, i64 2103441, i64 2103698, i64 0, i64 2103938, i64 103043, i64 0, i64 181896, i64 2104467, i64 0, i64 2104724, i64 0, i64 2104964, i64 86668, i64 0, i64 86940, i64 2105478, i64 2105735, i64 0, i64 2106005]
    %product = mul i64 %codepoint, 15
    %shifted = lshr i64 %product, 3
    %index = and i64 %shifted, 63
    %p = getelementptr inbounds [64 x i64], ptr @data, i64 0, i64 %index
    %packed = load i64, ptr %p, align 8
    %stored = lshr i64 %packed, 8
    %matched = icmp eq i64 %stored, %codepoint
    %byte = trunc i64 %packed to i32
    %result = select i1 %matched, i32 %byte, i32 -1
    ret i32 %result


@pure
@llvm
def _cp1251_c1_codepoint(index: int) -> i32:
    @data = private unnamed_addr constant [64 x i32] [i32 1026, i32 1027, i32 8218, i32 1107, i32 8222, i32 8230, i32 8224, i32 8225, i32 8364, i32 8240, i32 1033, i32 8249, i32 1034, i32 1036, i32 1035, i32 1039, i32 1106, i32 8216, i32 8217, i32 8220, i32 8221, i32 8226, i32 8211, i32 8212, i32 -1, i32 8482, i32 1113, i32 8250, i32 1114, i32 1116, i32 1115, i32 1119, i32 160, i32 1038, i32 1118, i32 1032, i32 164, i32 1168, i32 166, i32 167, i32 1025, i32 169, i32 1028, i32 171, i32 172, i32 173, i32 174, i32 1031, i32 176, i32 177, i32 1030, i32 1110, i32 1169, i32 181, i32 182, i32 183, i32 1105, i32 8470, i32 1108, i32 187, i32 1112, i32 1029, i32 1109, i32 1111]
    %p = getelementptr inbounds [64 x i32], ptr @data, i64 0, i64 %index
    %x = load i32, ptr %p, align 4
    ret i32 %x


@pure
@llvm
def _cp1251_c1_byte(codepoint: int) -> i32:
    @data = private unnamed_addr constant [128 x i64] [i64 44718, i64 2168505, i64 263041, i64 0, i64 2141320, i64 2105478, i64 284860, i64 0, i64 48059, i64 0, i64 0, i64 0, i64 2104467, i64 283834, i64 0, i64 42662, i64 47031, i64 265357, i64 0, i64 2103441, i64 0, i64 2112155, i64 0, i64 0, i64 0, i64 264355, i64 0, i64 2102423, i64 0, i64 0, i64 0, i64 299173, i64 263338, i64 0, i64 0, i64 2105735, i64 285082, i64 0, i64 43947, i64 0, i64 0, i64 0, i64 2104724, i64 284094, i64 0, i64 42919, i64 0, i64 0, i64 0, i64 0, i64 2103698, i64 0, i64 0, i64 0, i64 0, i64 264586, i64 0, i64 0, i64 2107013, i64 286370, i64 45232, i64 299444, i64 263613, i64 0, i64 0, i64 2106005, i64 285340, i64 0, i64 44204, i64 0, i64 0, i64 0, i64 2104964, i64 0, i64 284339, i64 0, i64 0, i64 0, i64 265889, i64 0, i64 2103938, i64 283280, i64 42148, i64 46517, i64 0, i64 264844, i64 0, i64 0, i64 0, i64 286623, i64 41120, i64 45489, i64 263858, i64 0, i64 0, i64 0, i64 285598, i64 0, i64 44461, i64 0, i64 262784, i64 0, i64 0, i64 2109577, i64 284607, i64 43433, i64 0, i64 2171545, i64 266127, i64 0, i64 0, i64 283523, i64 0, i64 46774, i64 0, i64 265102, i64 0, i64 0, i64 0, i64 2111883, i64 0, i64 0, i64 0, i64 264111, i64 0, i64 2102166, i64 0, i64 285853]
    %product = mul i64 %codepoint, 3861
    %shifted = lshr i64 %product, 7
    %index = and i64 %shifted, 127
    %p = getelementptr inbounds [128 x i64], ptr @data, i64 0, i64 %index
    %packed = load i64, ptr %p, align 8
    %stored = lshr i64 %packed, 8
    %matched = icmp eq i64 %stored, %codepoint
    %byte = trunc i64 %packed to i32
    %result = select i1 %matched, i32 %byte, i32 -1
    ret i32 %result


def _unicode_decode_cp1252(
    data: Ptr[u8],
    byte_length: int,
    errors: str,
) -> unicode:
    codepoints = []

    for i in range(byte_length):
        byte = int(data[i])
        codepoint = byte
        if 0x80 <= byte <= 0x9F:
            codepoint = int(_cp1252_c1_codepoint(byte - 0x80))

        if codepoint < 0:
            _codec_error_append(codepoints, data, i, i + 1, errors)
        else:
            codepoints.append(codepoint)

    return _unicode_from_codepoints(codepoints)


def _unicode_decode_cp1251(
    data: Ptr[u8],
    byte_length: int,
    errors: str,
) -> unicode:
    codepoints = []

    for i in range(byte_length):
        byte = int(data[i])
        if byte < 0x80:
            codepoint = byte
        elif byte >= 0xC0:
            codepoint = 0x0410 + byte - 0xC0
        else:
            codepoint = int(_cp1251_c1_codepoint(byte - 0x80))

        if codepoint < 0:
            _codec_error_append(codepoints, data, i, i + 1, errors)
        else:
            codepoints.append(codepoint)

    return _unicode_from_codepoints(codepoints)


def _unicode_decode_cp1250(
    data: Ptr[u8],
    byte_length: int,
    errors: str,
) -> unicode:
    codepoints = []

    for i in range(byte_length):
        codepoint = int(_single_byte_cp1250_decode(int(data[i])))
        if codepoint < 0:
            _codec_error_append(codepoints, data, i, i + 1, errors)
        else:
            codepoints.append(codepoint)

    return _unicode_from_codepoints(codepoints)


def _unicode_decode_cp1253(
    data: Ptr[u8],
    byte_length: int,
    errors: str,
) -> unicode:
    codepoints = []

    for i in range(byte_length):
        codepoint = int(_single_byte_cp1253_decode(int(data[i])))
        if codepoint < 0:
            _codec_error_append(codepoints, data, i, i + 1, errors)
        else:
            codepoints.append(codepoint)

    return _unicode_from_codepoints(codepoints)


def _unicode_decode_cp1254(
    data: Ptr[u8],
    byte_length: int,
    errors: str,
) -> unicode:
    codepoints = []

    for i in range(byte_length):
        codepoint = int(_single_byte_cp1254_decode(int(data[i])))
        if codepoint < 0:
            _codec_error_append(codepoints, data, i, i + 1, errors)
        else:
            codepoints.append(codepoint)

    return _unicode_from_codepoints(codepoints)


def _iso8859_15_decode_codepoint(byte: int) -> int:
    if byte == 0xA4:
        return 0x20AC
    if byte == 0xA6:
        return 0x0160
    if byte == 0xA8:
        return 0x0161
    if byte == 0xB4:
        return 0x017D
    if byte == 0xB8:
        return 0x017E
    if byte == 0xBC:
        return 0x0152
    if byte == 0xBD:
        return 0x0153
    if byte == 0xBE:
        return 0x0178
    return byte


def _unicode_decode_iso8859_15(data: Ptr[u8], byte_length: int) -> unicode:
    codepoints = []

    for i in range(byte_length):
        codepoints.append(_iso8859_15_decode_codepoint(int(data[i])))

    return _unicode_from_codepoints(codepoints)


def _unicode_decode_utf16(
    data: Ptr[u8],
    byte_length: int,
    little_endian: bool,
    detect_bom: bool,
    errors: str,
) -> unicode:
    codepoints = []
    pos = 0

    if detect_bom and byte_length >= 2:
        bom = int(data[0]) | (int(data[1]) << 8)
        if bom == 0xFEFF:
            little_endian = True
            pos = 2
        elif bom == 0xFFFE:
            little_endian = False
            pos = 2
        elif errors == "strict":
            raise ValueError("UTF-16 stream does not start with BOM")

    while pos < byte_length:
        if pos + 2 > byte_length:
            _codec_error_append(codepoints, data, pos, byte_length, errors)
            break

        if little_endian:
            unit = int(data[pos]) | (int(data[pos + 1]) << 8)
        else:
            unit = (int(data[pos]) << 8) | int(data[pos + 1])

        if 0xD800 <= unit <= 0xDBFF:
            if pos + 4 <= byte_length:
                if little_endian:
                    low = int(data[pos + 2]) | (int(data[pos + 3]) << 8)
                else:
                    low = (int(data[pos + 2]) << 8) | int(data[pos + 3])

                if 0xDC00 <= low <= 0xDFFF:
                    codepoints.append(0x10000 + ((unit - 0xD800) << 10) + low - 0xDC00)
                    pos += 4
                    continue

            if errors == "surrogatepass":
                codepoints.append(unit)
            else:
                _codec_error_append(codepoints, data, pos, pos + 2, errors)
        elif 0xDC00 <= unit <= 0xDFFF:
            if errors == "surrogatepass":
                codepoints.append(unit)
            else:
                _codec_error_append(codepoints, data, pos, pos + 2, errors)
        else:
            codepoints.append(unit)

        pos += 2

    return _unicode_from_codepoints(codepoints)


def _unicode_decode_utf32(
    data: Ptr[u8],
    byte_length: int,
    little_endian: bool,
    detect_bom: bool,
    errors: str,
) -> unicode:
    codepoints = []
    pos = 0

    if detect_bom and byte_length >= 4:
        bom = (
            int(data[0])
            | (int(data[1]) << 8)
            | (int(data[2]) << 16)
            | (int(data[3]) << 24)
        )
        if bom == 0x0000FEFF:
            little_endian = True
            pos = 4
        elif bom == 0xFFFE0000:
            little_endian = False
            pos = 4
        elif errors == "strict":
            raise ValueError("UTF-32 stream does not start with BOM")

    while pos < byte_length:
        if pos + 4 > byte_length:
            _codec_error_append(codepoints, data, pos, byte_length, errors)
            break

        if little_endian:
            codepoint = (
                int(data[pos])
                | (int(data[pos + 1]) << 8)
                | (int(data[pos + 2]) << 16)
                | (int(data[pos + 3]) << 24)
            )
        else:
            codepoint = (
                (int(data[pos]) << 24)
                | (int(data[pos + 1]) << 16)
                | (int(data[pos + 2]) << 8)
                | int(data[pos + 3])
            )

        if codepoint > UNICODE_MAX or (
            _is_surrogate(codepoint) and errors != "surrogatepass"
        ):
            _codec_error_append(codepoints, data, pos, pos + 4, errors)
        else:
            codepoints.append(codepoint)

        pos += 4

    return _unicode_from_codepoints(codepoints)


def _unicode_decode_codec(data: str, encoding: str, errors: str) -> unicode:
    name = _codec_name(encoding)

    if name == "utf-8" or name == "utf8":
        return _unicode_decode_utf8(data._ptr, len(data), errors)
    if name == "ascii" or name == "us-ascii":
        return _unicode_decode_single_byte(data._ptr, len(data), True, errors)
    if name == "latin-1" or name == "latin1" or name == "iso-8859-1":
        return _unicode_decode_single_byte(data._ptr, len(data), False, errors)
    if name == "cp1252" or name == "windows-1252" or name == "windows1252":
        return _unicode_decode_cp1252(data._ptr, len(data), errors)
    if name == "cp1251" or name == "windows-1251" or name == "windows1251":
        return _unicode_decode_cp1251(data._ptr, len(data), errors)
    if name == "cp1250" or name == "windows-1250" or name == "windows1250":
        return _unicode_decode_cp1250(data._ptr, len(data), errors)
    if name == "cp1253" or name == "windows-1253" or name == "windows1253":
        return _unicode_decode_cp1253(data._ptr, len(data), errors)
    if name == "cp1254" or name == "windows-1254" or name == "windows1254":
        return _unicode_decode_cp1254(data._ptr, len(data), errors)
    if (
        name == "iso-8859-15"
        or name == "iso8859-15"
        or name == "latin-9"
        or name == "latin9"
    ):
        return _unicode_decode_iso8859_15(data._ptr, len(data))
    if name == "utf-16":
        return _unicode_decode_utf16(data._ptr, len(data), True, True, errors)
    if name == "utf-16-le" or name == "utf16le":
        return _unicode_decode_utf16(data._ptr, len(data), True, False, errors)
    if name == "utf-16-be" or name == "utf16be":
        return _unicode_decode_utf16(data._ptr, len(data), False, False, errors)
    if name == "utf-32":
        return _unicode_decode_utf32(data._ptr, len(data), True, True, errors)
    if name == "utf-32-le" or name == "utf32le":
        return _unicode_decode_utf32(data._ptr, len(data), True, False, errors)
    if name == "utf-32-be" or name == "utf32be":
        return _unicode_decode_utf32(data._ptr, len(data), False, False, errors)

    raise LookupError("unknown encoding: " + encoding)


def _bytes_from_values(values: List[int]) -> str:
    output = Ptr[u8](len(values) + 1)

    for i in range(len(values)):
        output[i] = u8(values[i])

    output[len(values)] = u8(0)
    return str(output, len(values))


def _codec_encode_error_append(output: List[int], codepoint: int, errors: str):
    if errors == "strict":
        _raise_utf8_encode_error(0, 0, "code point not encodable")

    if errors == "ignore":
        return

    if errors == "replace":
        output.append(0x3F)  # ?
        return

    if errors == "backslashreplace":
        output.append(0x5C)  # \
        if codepoint <= 0xFF:
            output.append(0x78)  # x
            digits = 2
        elif codepoint <= 0xFFFF:
            output.append(0x75)  # u
            digits = 4
        else:
            output.append(0x55)  # U
            digits = 8

        for i in range(digits - 1, -1, -1):
            digit = (codepoint >> (i * 4)) & 0xF
            output.append(0x30 + digit if digit < 10 else 0x61 + digit - 10)
        return

    raise ValueError("unsupported error handling: " + errors)


def _unicode_encode_single_byte(
    value: unicode,
    ascii: bool,
    errors: str,
) -> str:
    output = []
    limit = 0x7F if ascii else 0xFF

    for i in range(len(value)):
        codepoint = value._load_codepoint(i)
        if codepoint > limit:
            _codec_encode_error_append(output, codepoint, errors)
        else:
            output.append(codepoint)

    return _bytes_from_values(output)


def _unicode_encode_cp1252(value: unicode, errors: str) -> str:
    output = []

    for i in range(len(value)):
        codepoint = value._load_codepoint(i)
        byte = -1

        if codepoint <= 0x7F or 0xA0 <= codepoint <= 0xFF:
            byte = codepoint
        else:
            byte = int(_cp1252_c1_byte(codepoint))

        if byte < 0:
            _codec_encode_error_append(output, codepoint, errors)
        else:
            output.append(byte)

    return _bytes_from_values(output)


def _unicode_encode_cp1251(value: unicode, errors: str) -> str:
    output = []

    for i in range(len(value)):
        codepoint = value._load_codepoint(i)
        byte = -1

        if codepoint <= 0x7F:
            byte = codepoint
        elif 0x0410 <= codepoint <= 0x044F:
            byte = codepoint - 0x0410 + 0xC0
        elif codepoint == 0x0401:
            byte = 0xA8
        elif codepoint == 0x0451:
            byte = 0xB8
        else:
            byte = int(_cp1251_c1_byte(codepoint))

        if byte < 0:
            _codec_encode_error_append(output, codepoint, errors)
        else:
            output.append(byte)

    return _bytes_from_values(output)


def _unicode_encode_cp1250(value: unicode, errors: str) -> str:
    output = []

    for i in range(len(value)):
        codepoint = value._load_codepoint(i)
        byte = codepoint if codepoint <= 0x7F else int(_single_byte_cp1250_encode(codepoint))
        if byte < 0:
            _codec_encode_error_append(output, codepoint, errors)
        else:
            output.append(byte)

    return _bytes_from_values(output)


def _unicode_encode_cp1253(value: unicode, errors: str) -> str:
    output = []

    for i in range(len(value)):
        codepoint = value._load_codepoint(i)
        byte = codepoint if codepoint <= 0x7F else int(_single_byte_cp1253_encode(codepoint))
        if byte < 0:
            _codec_encode_error_append(output, codepoint, errors)
        else:
            output.append(byte)

    return _bytes_from_values(output)


def _unicode_encode_cp1254(value: unicode, errors: str) -> str:
    output = []

    for i in range(len(value)):
        codepoint = value._load_codepoint(i)
        byte = codepoint if codepoint <= 0x7F else int(_single_byte_cp1254_encode(codepoint))
        if byte < 0:
            _codec_encode_error_append(output, codepoint, errors)
        else:
            output.append(byte)

    return _bytes_from_values(output)


def _iso8859_15_encode_byte(codepoint: int) -> int:
    if codepoint == 0x20AC:
        return 0xA4
    if codepoint == 0x0160:
        return 0xA6
    if codepoint == 0x0161:
        return 0xA8
    if codepoint == 0x017D:
        return 0xB4
    if codepoint == 0x017E:
        return 0xB8
    if codepoint == 0x0152:
        return 0xBC
    if codepoint == 0x0153:
        return 0xBD
    if codepoint == 0x0178:
        return 0xBE
    if (
        codepoint <= 0xFF
        and codepoint != 0xA4
        and codepoint != 0xA6
        and codepoint != 0xA8
        and codepoint != 0xB4
        and codepoint != 0xB8
        and codepoint != 0xBC
        and codepoint != 0xBD
        and codepoint != 0xBE
    ):
        return codepoint
    return -1


def _unicode_encode_iso8859_15(value: unicode, errors: str) -> str:
    output = []

    for i in range(len(value)):
        byte = _iso8859_15_encode_byte(value._load_codepoint(i))
        if byte < 0:
            _codec_encode_error_append(output, value._load_codepoint(i), errors)
        else:
            output.append(byte)

    return _bytes_from_values(output)


def _unicode_encode_utf16(
    value: unicode,
    little_endian: bool,
    bom: bool,
    errors: str,
) -> str:
    output = []

    if bom:
        if little_endian:
            output.append(0xFF)
            output.append(0xFE)
        else:
            output.append(0xFE)
            output.append(0xFF)

    for i in range(len(value)):
        codepoint = value._load_codepoint(i)
        if _is_surrogate(codepoint) and errors != "surrogatepass":
            _codec_encode_error_append(output, codepoint, errors)
            continue
        if codepoint <= 0xFFFF:
            units = [codepoint]
        else:
            scalar = codepoint - 0x10000
            units = [0xD800 + (scalar >> 10), 0xDC00 + (scalar & 0x3FF)]

        for unit in units:
            if little_endian:
                output.append(unit & 0xFF)
                output.append(unit >> 8)
            else:
                output.append(unit >> 8)
                output.append(unit & 0xFF)

    return _bytes_from_values(output)


def _unicode_encode_utf32(
    value: unicode,
    little_endian: bool,
    bom: bool,
    errors: str,
) -> str:
    output = []

    if bom:
        if little_endian:
            output.append(0xFF)
            output.append(0xFE)
            output.append(0)
            output.append(0)
        else:
            output.append(0)
            output.append(0)
            output.append(0xFE)
            output.append(0xFF)

    for i in range(len(value)):
        codepoint = value._load_codepoint(i)
        if _is_surrogate(codepoint) and errors != "surrogatepass":
            _codec_encode_error_append(output, codepoint, errors)
            continue
        if little_endian:
            output.append(codepoint & 0xFF)
            output.append((codepoint >> 8) & 0xFF)
            output.append((codepoint >> 16) & 0xFF)
            output.append(codepoint >> 24)
        else:
            output.append(codepoint >> 24)
            output.append((codepoint >> 16) & 0xFF)
            output.append((codepoint >> 8) & 0xFF)
            output.append(codepoint & 0xFF)

    return _bytes_from_values(output)


def _unicode_encode_codec(value: unicode, encoding: str, errors: str) -> str:
    name = _codec_name(encoding)

    if name == "utf-8" or name == "utf8":
        return _unicode_encode_utf8(value, errors)
    if name == "ascii" or name == "us-ascii":
        return _unicode_encode_single_byte(value, True, errors)
    if name == "latin-1" or name == "latin1" or name == "iso-8859-1":
        return _unicode_encode_single_byte(value, False, errors)
    if name == "cp1252" or name == "windows-1252" or name == "windows1252":
        return _unicode_encode_cp1252(value, errors)
    if name == "cp1251" or name == "windows-1251" or name == "windows1251":
        return _unicode_encode_cp1251(value, errors)
    if name == "cp1250" or name == "windows-1250" or name == "windows1250":
        return _unicode_encode_cp1250(value, errors)
    if name == "cp1253" or name == "windows-1253" or name == "windows1253":
        return _unicode_encode_cp1253(value, errors)
    if name == "cp1254" or name == "windows-1254" or name == "windows1254":
        return _unicode_encode_cp1254(value, errors)
    if (
        name == "iso-8859-15"
        or name == "iso8859-15"
        or name == "latin-9"
        or name == "latin9"
    ):
        return _unicode_encode_iso8859_15(value, errors)
    if name == "utf-16":
        return _unicode_encode_utf16(value, True, True, errors)
    if name == "utf-16-le" or name == "utf16le":
        return _unicode_encode_utf16(value, True, False, errors)
    if name == "utf-16-be" or name == "utf16be":
        return _unicode_encode_utf16(value, False, False, errors)
    if name == "utf-32":
        return _unicode_encode_utf32(value, True, True, errors)
    if name == "utf-32-le" or name == "utf32le":
        return _unicode_encode_utf32(value, True, False, errors)
    if name == "utf-32-be" or name == "utf32be":
        return _unicode_encode_utf32(value, False, False, errors)

    raise LookupError("unknown encoding: " + encoding)


@extend
class unicode:

    def __new__() -> unicode:
        return unicode(Ptr[u8](), _make_meta(0, KIND_ASCII))

    def __new__(data: unicode) -> unicode:
        return data

    def __new__(data: str) -> unicode:
        return _unicode_decode_codec(data, "utf-8", "strict")

    def __new__(data: str, encoding: str) -> unicode:
        return _unicode_decode_codec(data, encoding, "strict")

    def __new__(data: str, encoding: str, errors: str) -> unicode:
        return _unicode_decode_codec(data, encoding, errors)

    def __len__(self) -> int:
        return _meta_len(self._meta)

    def __bool__(self) -> bool:
        return len(self) != 0

    def _kind(self) -> int:
        return _meta_kind(self._meta)

    def _width(self) -> int:
        return _kind_width(self._kind())

    def _is_ascii(self) -> bool:
        return self._kind() == KIND_ASCII

    def _load_codepoint(self, i: int) -> int:
        kind = self._kind()

        if kind <= KIND_LATIN1:
            return int(self._data[i])

        if kind == KIND_UCS2:
            return (
                int(self._data[2 * i])
                | (int(self._data[2 * i + 1]) << 8)
            )

        return (
            int(self._data[4 * i])
            | (int(self._data[4 * i + 1]) << 8)
            | (int(self._data[4 * i + 2]) << 16)
            | (int(self._data[4 * i + 3]) << 24)
        )

    def _store_codepoint(self, i: int, cp: int):
        kind = self._kind()

        if kind <= KIND_LATIN1:
            self._data[i] = u8(cp)
            return

        if kind == KIND_UCS2:
            self._data[2 * i] = u8(cp & 0xFF)
            self._data[2 * i + 1] = u8((cp >> 8) & 0xFF)
            return

        self._data[4 * i] = u8(cp & 0xFF)
        self._data[4 * i + 1] = u8((cp >> 8) & 0xFF)
        self._data[4 * i + 2] = u8((cp >> 16) & 0xFF)
        self._data[4 * i + 3] = u8((cp >> 24) & 0xFF)

    def _get_codepoint(self, i: int) -> int:
        if i < 0 or i >= len(self):
            raise IndexError("string index out of range")
        return self._load_codepoint(i)

    def __getitem__(self, item: int):
        n = len(self)

        if item < 0:
            item += n

        if item < 0 or item >= n:
            raise IndexError("string index out of range")

        return _unicode_from_codepoint(self._load_codepoint(item))

    def __getitem__(self, item: slice[int, int, int]) -> unicode:
        start, stop, step, slicelen = item.adjust_indices(len(self))

        if slicelen == 0:
            return _unicode_empty()

        if step == 1:
            return _unicode_slice_impl(self, start, stop)

        result = _unicode_new_uninit(slicelen, _unicode_maxchar(self))

        for i in range(slicelen):
            result._store_codepoint(i, self._load_codepoint(start + i * step))

        return result

    def __eq__(self, other: unicode) -> bool:
        if len(self) != len(other):
            return False

        if self._width() == other._width():
            return _C.memcmp(
                self._data,
                other._data,
                len(self) * self._width(),
            ) == 0

        for i in range(len(self)):
            if self._load_codepoint(i) != other._load_codepoint(i):
                return False

        return True

    def __ne__(self, other: unicode) -> bool:
        return not self.__eq__(other)

    def __lt__(self, other: unicode) -> bool:
        return _unicode_compare(self, other) < 0

    def __le__(self, other: unicode) -> bool:
        return _unicode_compare(self, other) <= 0

    def __gt__(self, other: unicode) -> bool:
        return _unicode_compare(self, other) > 0

    def __ge__(self, other: unicode) -> bool:
        return _unicode_compare(self, other) >= 0

    def __add__(self, other: unicode) -> unicode:
        if len(self) == 0:
            return other

        if len(other) == 0:
            return self

        return _unicode_concat_impl(self, other)

    def __mul__(self, count: int) -> unicode:
        if count < 0:
            raise ValueError("can't multiply unicode by negative value")

        if count == 0:
            return _unicode_empty()

        return _unicode_repeat_impl(self, count)

    def __rmul__(self, count: int) -> unicode:
        return self.__mul__(count)

    def find(self, sub: unicode) -> int:
        return self.find(sub, 0, len(self))

    def find(
        self,
        sub: unicode,
        start: int,
    ) -> int:
        return self.find(sub, start, len(self))

    def find(
        self,
        sub: unicode,
        start: int,
        end: int,
    ) -> int:
        start, end = _normalize_search_bounds(len(self), start, end)

        if len(sub) == 0:
            if start > end:
                return -1
            return start

        if len(sub) > end - start:
            return -1

        return _unicode_fastsearch(self, sub, start, end)

    def rfind(self, sub: unicode) -> int:
        return self.rfind(sub, 0, len(self))

    def rfind(
        self,
        sub: unicode,
        start: int,
    ) -> int:
        return self.rfind(sub, start, len(self))

    def rfind(
        self,
        sub: unicode,
        start: int,
        end: int,
    ) -> int:
        start, end = _normalize_search_bounds(len(self), start, end)

        if len(sub) == 0:
            if start > end:
                return -1
            return end

        if len(sub) > end - start:
            return -1

        return _unicode_fastsearch_reverse(self, sub, start, end)

    def index(self, sub: unicode) -> int:
        return self.index(sub, 0, len(self))

    def index(
        self,
        sub: unicode,
        start: int,
    ) -> int:
        return self.index(sub, start, len(self))

    def index(
        self,
        sub: unicode,
        start: int,
        end: int,
    ) -> int:
        pos = self.find(sub, start, end)

        if pos == -1:
            raise ValueError("substring not found")

        return pos

    def rindex(self, sub: unicode) -> int:
        return self.rindex(sub, 0, len(self))

    def rindex(
        self,
        sub: unicode,
        start: int,
    ) -> int:
        return self.rindex(sub, start, len(self))

    def rindex(
        self,
        sub: unicode,
        start: int,
        end: int,
    ) -> int:
        pos = self.rfind(sub, start, end)

        if pos == -1:
            raise ValueError("substring not found")

        return pos

    def count(self, sub: unicode) -> int:
        return self.count(sub, 0, len(self))

    def count(
        self,
        sub: unicode,
        start: int,
    ) -> int:
        return self.count(sub, start, len(self))

    def count(
        self,
        sub: unicode,
        start: int,
        end: int,
    ) -> int:
        start, end = _normalize_search_bounds(len(self), start, end)

        if len(sub) == 0:
            if start > end:
                return 0
            return end - start + 1

        return _unicode_count(self, sub, start, end)

    def startswith(self, prefix: unicode) -> bool:
        return self.startswith(prefix, 0, len(self))

    def startswith(
        self,
        prefix: unicode,
        start: int,
    ) -> bool:
        return self.startswith(prefix, start, len(self))

    def startswith(
        self,
        prefix: unicode,
        start: int,
        end: int,
    ) -> bool:
        start, end = _normalize_search_bounds(len(self), start, end)

        if len(prefix) == 0:
            return start <= end

        if end - start < len(prefix):
            return False

        return _unicode_starts_at(self, prefix, start)

    def endswith(self, suffix: unicode) -> bool:
        return self.endswith(suffix, 0, len(self))

    def endswith(
        self,
        suffix: unicode,
        start: int,
    ) -> bool:
        return self.endswith(suffix, start, len(self))

    def endswith(
        self,
        suffix: unicode,
        start: int,
        end: int,
    ) -> bool:
        start, end = _normalize_search_bounds(len(self), start, end)
        m = len(suffix)

        if m == 0:
            return start <= end

        if end - start < m:
            return False

        return _unicode_starts_at(self, suffix, end - m)

    def encode(self) -> str:
        return self.encode("utf-8", "strict")

    def encode(self, encoding: str) -> str:
        return self.encode(encoding, "strict")

    def encode(
        self,
        encoding: str,
        errors: str,
    ) -> str:
        return _unicode_encode_codec(self, encoding, errors)

    def __repr__(self) -> str:
        single_quotes = 0
        double_quotes = 0

        for i in range(len(self)):
            cp = self._load_codepoint(i)

            if cp == 0x27:
                single_quotes += 1
            elif cp == 0x22:
                double_quotes += 1

        quote = 0x27 if single_quotes <= double_quotes else 0x22
        output = _UnicodeByteBuffer(len(self) + 2)
        output.append_byte(u8(quote))

        for i in range(len(self)):
            _unicode_repr_append_codepoint(
                output,
                self._load_codepoint(i),
                quote,
            )

        output.append_byte(u8(quote))
        return str(output.data, output.length)

    def __str__(self) -> str:
        return self.encode("utf-8", "strict")

    def __contains__(self, sub: unicode) -> bool:
        return self.find(sub) != -1

    @staticmethod
    def maketrans(x: dict[int, int]) -> dict[int, int]:
        return x

    @staticmethod
    def maketrans(x: dict[int, unicode]) -> dict[int, unicode]:
        return x

    @staticmethod
    def maketrans(x: dict[int, Optional[int]]) -> dict[int, Optional[int]]:
        return x

    @staticmethod
    def maketrans(
        x: dict[int, Optional[unicode]],
    ) -> dict[int, Optional[unicode]]:
        return x

    @staticmethod
    def maketrans(
        x: unicode,
        y: unicode = unicode(),
        z: unicode = unicode(),
    ) -> dict[int, int]:
        if len(y) != 0 and len(x) != len(y):
            raise ValueError("the first two maketrans arguments must have the same length")

        table = {}

        for i in range(len(x)):
            table[x._load_codepoint(i)] = y._load_codepoint(i)

        for i in range(len(z)):
            table[z._load_codepoint(i)] = -1

        return table

    def translate(self, table: dict[int, int]) -> unicode:
        return _unicode_translate_int_impl(self, table)

    def translate(self, table: dict[int, unicode]) -> unicode:
        return _unicode_translate_unicode_impl(self, table)

    def translate(self, table: dict[int, Optional[int]]) -> unicode:
        return _unicode_translate_optional_int_impl(self, table)

    def translate(self, table: dict[int, Optional[unicode]]) -> unicode:
        return _unicode_translate_optional_unicode_impl(self, table)

    def lower(self) -> unicode:
        if self._is_ascii():
            return _unicode_ascii_map(self, _ascii_lower)
        return _unicode_lower_full(self)

    def upper(self) -> unicode:
        if self._is_ascii():
            return _unicode_ascii_map(self, _ascii_upper)
        return _unicode_upper_full(self)

    def casefold(self) -> unicode:
        if self._is_ascii():
            return _unicode_ascii_map(self, _ascii_casefold)
        return _unicode_map_full(
            self,
            unicode_casefold_mapping_length,
            unicode_casefold_mapping_codepoint,
        )

    def capitalize(self) -> unicode:
        if self._is_ascii():
            return _unicode_ascii_capitalize(self)
        return _unicode_capitalize_full(self)

    def title(self) -> unicode:
        if self._is_ascii():
            return _unicode_ascii_title(self)
        return _unicode_title_full(self)

    def swapcase(self) -> unicode:
        if self._is_ascii():
            return _unicode_ascii_map(self, _ascii_swapcase)
        return _unicode_swapcase_full(self)

    def removeprefix(self, prefix: unicode) -> unicode:
        if len(prefix) > len(self) or not self.startswith(prefix):
            return self

        return _unicode_slice_impl(self, len(prefix), len(self))

    def removesuffix(self, suffix: unicode) -> unicode:
        if len(suffix) > len(self) or not self.endswith(suffix):
            return self

        return _unicode_slice_impl(self, 0, len(self) - len(suffix))

    def strip(self) -> unicode:
        return _unicode_strip_impl(self, True, True)

    def lstrip(self) -> unicode:
        return _unicode_strip_impl(self, True, False)

    def rstrip(self) -> unicode:
        return _unicode_strip_impl(self, False, True)

    def strip(self, chars: unicode) -> unicode:
        return _unicode_strip_chars_impl(self, chars, True, True)

    def lstrip(self, chars: unicode) -> unicode:
        return _unicode_strip_chars_impl(self, chars, True, False)

    def rstrip(self, chars: unicode) -> unicode:
        return _unicode_strip_chars_impl(self, chars, False, True)

    def split(
        self,
        sep: Optional[unicode] = None,
        maxsplit: int = -1,
    ) -> List[unicode]:
        if sep is None:
            return _unicode_split_whitespace_impl(self, False, maxsplit)

        return _unicode_split_exact_impl(self, sep, maxsplit)

    def rsplit(
        self,
        sep: Optional[unicode] = None,
        maxsplit: int = -1,
    ) -> List[unicode]:
        if sep is None:
            return _unicode_split_whitespace_impl(self, True, maxsplit)

        return _unicode_split_exact_impl(self, sep, maxsplit, True)

    def splitlines(self, keepends: bool = False) -> List[unicode]:
        return _unicode_splitlines_impl(self, keepends)

    def join(self, values: List[unicode]) -> unicode:
        return _unicode_join_impl(self, values)

    def replace(self, old: unicode, new: unicode) -> unicode:
        return self.replace(old, new, -1)

    def replace(
        self,
        old: unicode,
        new: unicode,
        count: int,
    ) -> unicode:
        return _unicode_replace_impl(self, old, new, count)

    def center(self, width: int) -> unicode:
        if len(self) >= width:
            return self

        pad = width - len(self)
        left = pad // 2
        right = pad - left

        result = _unicode_new_uninit(width, _unicode_maxchar(self))

        for i in range(left):
            result._store_codepoint(i, 0x20)

        _unicode_copy_range(result, self, left, 0, len(self))

        for i in range(right):
            result._store_codepoint(left + len(self) + i, 0x20)

        return result

    def ljust(self, width: int) -> unicode:
        if len(self) >= width:
            return self

        result = _unicode_new_uninit(width, _unicode_maxchar(self))

        _unicode_copy_range(result, self, 0, 0, len(self))

        for i in range(width - len(self)):
            result._store_codepoint(len(self) + i, 0x20)

        return result

    def rjust(self, width: int) -> unicode:
        if len(self) >= width:
            return self

        result = _unicode_new_uninit(width, _unicode_maxchar(self))

        for i in range(width - len(self)):
            result._store_codepoint(i, 0x20)

        _unicode_copy_range(result, self, width - len(self), 0, len(self))

        return result

    def center(self, width: int, fillchar: unicode) -> unicode:
        return _unicode_center_impl(self, width, fillchar)

    def ljust(self, width: int, fillchar: unicode) -> unicode:
        return _unicode_ljust_impl(self, width, fillchar)

    def rjust(self, width: int, fillchar: unicode) -> unicode:
        return _unicode_rjust_impl(self, width, fillchar)

    def zfill(self, width: int) -> unicode:
        if len(self) >= width:
            return self

        sign_cp = -1
        body_start = 0

        if len(self) > 0:
            first = self._load_codepoint(0)
            if first == 0x2B or first == 0x2D:
                sign_cp = first
                body_start = 1

        body_len = len(self) - body_start

        if body_len >= width:
            return self

        pad = width - len(self)

        result = _unicode_new_uninit(width, _unicode_maxchar(self))

        if sign_cp == -1:
            for i in range(pad):
                result._store_codepoint(i, 0x30)

            _unicode_copy_range(result, self, pad, 0, len(self))
        else:
            result._store_codepoint(0, sign_cp)

            for i in range(pad):
                result._store_codepoint(i + 1, 0x30)

            _unicode_copy_range(result, self, pad + 1, body_start, len(self))

        return result

    def expandtabs(self, tabsize: int = 8) -> unicode:
        length = len(self)
        col = 0

        for i in range(len(self)):
            cp = self._load_codepoint(i)

            if cp == 0x09:
                spaces = 0
                if tabsize > 0:
                    spaces = tabsize - (col % tabsize)

                length += spaces - 1
                col += spaces
            elif cp == 0x0A or cp == 0x0D:
                col = 0
            else:
                col += 1

        result = _unicode_new_uninit(length, _unicode_maxchar(self))
        out = 0
        col = 0

        for i in range(len(self)):
            cp = self._load_codepoint(i)

            if cp == 0x09:
                spaces = 0
                if tabsize > 0:
                    spaces = tabsize - (col % tabsize)

                for j in range(spaces):
                    result._store_codepoint(out + j, 0x20)

                out += spaces
                col += spaces
            else:
                result._store_codepoint(out, cp)
                out += 1

                if cp == 0x0A or cp == 0x0D:
                    col = 0
                else:
                    col += 1

        return result

    def __hash__(self) -> int:
        h = u64(0x9e3779b97f4a7c15)

        for i in range(len(self)):
            cp = self._load_codepoint(i)
            h = (h * u64(1000003)) ^ u64(cp)

        h ^= u64(len(self))

        if h == u64(0xFFFFFFFFFFFFFFFF):
            h = u64(0xFFFFFFFFFFFFFFFE)

        return int(h)

    def __iter__(self):
        for i in range(len(self)):
            yield self[i]

    def isalnum(self) -> bool:
        if len(self) == 0:
            return False

        for i in range(len(self)):
            cp = self._load_codepoint(i)
            if not (unicode_is_alpha(cp) or unicode_is_numeric(cp)):
                return False

        return True

    def isalpha(self) -> bool:
        if len(self) == 0:
            return False

        for i in range(len(self)):
            if not unicode_is_alpha(self._load_codepoint(i)):
                return False

        return True

    def isdigit(self) -> bool:
        if len(self) == 0:
            return False

        for i in range(len(self)):
            if not unicode_is_digit(self._load_codepoint(i)):
                return False

        return True

    def isspace(self) -> bool:
        if len(self) == 0:
            return False

        for i in range(len(self)):
            if not unicode_is_space(self._load_codepoint(i)):
                return False

        return True

    def isascii(self) -> bool:
        for i in range(len(self)):
            if self._load_codepoint(i) > 0x7F:
                return False

        return True

    def islower(self) -> bool:
        has_cased = False

        for i in range(len(self)):
            cp = self._load_codepoint(i)

            if unicode_is_cased(cp):
                if not unicode_is_lower(cp):
                    return False
                has_cased = True

        return has_cased

    def isupper(self) -> bool:
        has_cased = False

        for i in range(len(self)):
            cp = self._load_codepoint(i)

            if unicode_is_cased(cp):
                if not unicode_is_upper(cp):
                    return False
                has_cased = True

        return has_cased

    def istitle(self) -> bool:
        has_cased = False
        previous_is_cased = False

        for i in range(len(self)):
            cp = self._load_codepoint(i)

            if unicode_is_upper(cp) or unicode_is_title(cp):
                if previous_is_cased:
                    return False
                has_cased = True
                previous_is_cased = True
            elif unicode_is_lower(cp):
                if not previous_is_cased:
                    return False
                has_cased = True
                previous_is_cased = True
            elif not unicode_is_case_ignorable(cp):
                previous_is_cased = False

        return has_cased

    def isnumeric(self) -> bool:
        if len(self) == 0:
            return False

        for i in range(len(self)):
            if not unicode_is_numeric(self._load_codepoint(i)):
                return False

        return True

    def isdecimal(self) -> bool:
        if len(self) == 0:
            return False

        for i in range(len(self)):
            if not unicode_is_decimal(self._load_codepoint(i)):
                return False

        return True

    def isprintable(self) -> bool:
        for i in range(len(self)):
            cp = self._load_codepoint(i)
            if not unicode_is_printable(cp):
                return False

        return True

    def isidentifier(self) -> bool:
        if len(self) == 0:
            return False

        first = self._load_codepoint(0)
        if first != 0x5F and not unicode_is_xid_start(first):
            return False

        for i in range(1, len(self)):
            if not unicode_is_xid_continue(self._load_codepoint(i)):
                return False

        return True

    def partition(self, sep: unicode) -> Tuple[unicode, unicode, unicode]:
        if len(sep) == 0:
            raise ValueError("empty separator")

        pos = self.find(sep)

        if pos == -1:
            return (self, _unicode_empty(), _unicode_empty())

        return (
            _unicode_slice_impl(self, 0, pos),
            sep,
            _unicode_slice_impl(self, pos + len(sep), len(self)),
        )

    def rpartition(self, sep: unicode) -> Tuple[unicode, unicode, unicode]:
        if len(sep) == 0:
            raise ValueError("empty separator")

        pos = self.rfind(sep)

        if pos == -1:
            return (self, _unicode_empty(), _unicode_empty())

        return (
            _unicode_slice_impl(self, 0, pos),
            sep,
            _unicode_slice_impl(self, pos + len(sep), len(self)),
        )


def _unicode_new_uninit(length: int, maxchar: int) -> unicode:
    if length < 0:
        raise ValueError("negative length")

    if length > LEN_MASK:
        raise ValueError("string too large")

    if maxchar < 0 or maxchar > UNICODE_MAX:
        raise ValueError("invalid code point")

    kind = _kind_for_maxchar(maxchar)
    width = _kind_width(kind)

    return unicode(
        Ptr[u8](length * width),
        _make_meta(length, kind),
    )


def _unicode_empty() -> unicode:
    return unicode()


def _unicode_from_codepoint(cp: int) -> unicode:
    if cp < 0 or cp > UNICODE_MAX:
        raise ValueError("invalid code point")

    result = _unicode_new_uninit(1, cp)
    result._store_codepoint(0, cp)

    return result


def _unicode_maxchar(value: unicode) -> int:
    kind = value._kind()

    if kind == KIND_ASCII:
        return 0x7F
    if kind == KIND_LATIN1:
        return 0xFF
    if kind == KIND_UCS2:
        return 0xFFFF
    return UNICODE_MAX


def _unicode_starts_at(
    value: unicode,
    sub: unicode,
    pos: int,
) -> bool:
    n = len(sub)

    if pos < 0 or pos + n > len(value):
        return False

    for i in range(n):
        if value._load_codepoint(pos + i) != sub._load_codepoint(i):
            return False

    return True


def _unicode_compare_typed(
    left: Ptr[Char],
    right: Ptr[Char],
    limit: int,
    Char: type,
) -> int:
    for i in range(limit):
        if left[i] < right[i]:
            return -1
        if left[i] > right[i]:
            return 1

    return 0


def _unicode_compare(left: unicode, right: unicode) -> int:
    left_length = len(left)
    right_length = len(right)
    limit = left_length if left_length < right_length else right_length
    comparison = 0

    if left._kind() <= KIND_LATIN1 and right._kind() <= KIND_LATIN1:
        comparison = _unicode_compare_typed(left._data, right._data, limit)
    elif left._kind() == KIND_UCS2 and right._kind() == KIND_UCS2:
        comparison = _unicode_compare_typed(
            Ptr[u16](left._data), Ptr[u16](right._data), limit
        )
    elif left._kind() == KIND_UCS4 and right._kind() == KIND_UCS4:
        comparison = _unicode_compare_typed(
            Ptr[u32](left._data), Ptr[u32](right._data), limit
        )
    else:
        for i in range(limit):
            left_codepoint = left._load_codepoint(i)
            right_codepoint = right._load_codepoint(i)

            if left_codepoint < right_codepoint:
                return -1
            if left_codepoint > right_codepoint:
                return 1

    if comparison != 0:
        return comparison

    if left_length < right_length:
        return -1
    if left_length > right_length:
        return 1
    return 0


def _unicode_search_bloom_add(bloom: u64, codepoint: int) -> u64:
    return bloom | (u64(1) << u64(codepoint & 63))


def _unicode_search_bloom_contains(bloom: u64, codepoint: int) -> bool:
    return (bloom & (u64(1) << u64(codepoint & 63))) != 0


def _unicode_coerce_kind(value: unicode, kind: int) -> Optional[unicode]:
    if value._kind() == kind:
        return value

    maxchar = 0xFF
    if kind == KIND_ASCII:
        maxchar = 0x7F
    elif kind == KIND_UCS2:
        maxchar = 0xFFFF
    elif kind == KIND_UCS4:
        maxchar = UNICODE_MAX

    for i in range(len(value)):
        if value._load_codepoint(i) > maxchar:
            return None

    result = unicode(
        Ptr[u8](len(value) * _kind_width(kind)),
        _make_meta(len(value), kind),
    )

    for i in range(len(value)):
        result._store_codepoint(i, value._load_codepoint(i))

    return result


def _unicode_starts_at_typed(
    value: Ptr[Char],
    sub: Ptr[Char],
    sub_length: int,
    pos: int,
    Char: type,
) -> bool:
    for i in range(sub_length):
        if value[pos + i] != sub[i]:
            return False
    return True


def _unicode_fastsearch_typed(
    value: Ptr[Char],
    value_length: int,
    sub: Ptr[Char],
    sub_length: int,
    start: int,
    end: int,
    Char: type,
) -> int:
    needle_length = sub_length
    if needle_length == 1:
        needle = sub[0]
        for position in range(start, end):
            if value[position] == needle:
                return position
        return -1

    bloom = u64(0)
    for index in range(needle_length):
        bloom = _unicode_search_bloom_add(bloom, int(sub[index]))

    last = needle_length - 1
    tail = sub[last]
    limit = end - needle_length
    position = start
    attempts = 0

    while position <= limit:
        candidate_tail = value[position + last]
        if candidate_tail == tail and _unicode_starts_at_typed(
            value, sub, needle_length, position
        ):
            return position

        attempts += 1
        if attempts > needle_length and position + needle_length <= limit:
            return _unicode_fastsearch_kmp_typed(
                value, sub, needle_length, position + 1, end
            )

        if _unicode_search_bloom_contains(bloom, int(candidate_tail)):
            position += 1
        else:
            position += needle_length

    return -1


def _unicode_fastsearch_kmp_typed(
    value: Ptr[Char],
    sub: Ptr[Char],
    sub_length: int,
    start: int,
    end: int,
    Char: type,
) -> int:
    needle_length = sub_length
    prefix = Ptr[int](needle_length)
    prefix[0] = 0
    matched = 0

    for index in range(1, needle_length):
        while matched > 0 and sub[index] != sub[matched]:
            matched = prefix[matched - 1]
        if sub[index] == sub[matched]:
            matched += 1
        prefix[index] = matched

    matched = 0
    for position in range(start, end):
        while matched > 0 and value[position] != sub[matched]:
            matched = prefix[matched - 1]
        if value[position] == sub[matched]:
            matched += 1
            if matched == needle_length:
                result = position - needle_length + 1
                gc.free(prefix.as_byte())
                return result

    gc.free(prefix.as_byte())
    return -1


def _unicode_fastsearch_reverse_typed(
    value: Ptr[Char],
    sub: Ptr[Char],
    sub_length: int,
    start: int,
    end: int,
    Char: type,
) -> int:
    needle_length = sub_length
    if needle_length == 1:
        needle = sub[0]
        for position in range(end - 1, start - 1, -1):
            if value[position] == needle:
                return position
        return -1

    bloom = u64(0)
    for index in range(needle_length):
        bloom = _unicode_search_bloom_add(bloom, int(sub[index]))

    first = sub[0]
    position = end - needle_length
    attempts = 0

    while position >= start:
        candidate_first = value[position]
        if candidate_first == first and _unicode_starts_at_typed(
            value, sub, needle_length, position
        ):
            return position

        attempts += 1
        if attempts > needle_length and position - needle_length >= start:
            return _unicode_fastsearch_reverse_kmp_typed(
                value, sub, needle_length, start, position + needle_length - 2
            )

        if _unicode_search_bloom_contains(bloom, int(candidate_first)):
            position -= 1
        else:
            position -= needle_length

    return -1


def _unicode_fastsearch_reverse_kmp_typed(
    value: Ptr[Char],
    sub: Ptr[Char],
    sub_length: int,
    start: int,
    end: int,
    Char: type,
) -> int:
    needle_length = sub_length
    prefix = Ptr[int](needle_length)
    prefix[0] = 0
    matched = 0

    for index in range(1, needle_length):
        while (
            matched > 0
            and sub[needle_length - 1 - index]
                != sub[needle_length - 1 - matched]
        ):
            matched = prefix[matched - 1]
        if (
            sub[needle_length - 1 - index]
            == sub[needle_length - 1 - matched]
        ):
            matched += 1
        prefix[index] = matched

    matched = 0
    for position in range(end, start - 1, -1):
        while (
            matched > 0
            and value[position]
                != sub[needle_length - 1 - matched]
        ):
            matched = prefix[matched - 1]
        if value[position] == sub[needle_length - 1 - matched]:
            matched += 1
            if matched == needle_length:
                gc.free(prefix.as_byte())
                return position

    gc.free(prefix.as_byte())
    return -1


def _unicode_count_kmp_typed(
    value: Ptr[Char],
    sub: Ptr[Char],
    sub_length: int,
    start: int,
    end: int,
    Char: type,
) -> int:
    if sub_length == 1:
        total = 0
        needle = sub[0]
        for position in range(start, end):
            if value[position] == needle:
                total += 1
        return total

    prefix = Ptr[int](sub_length)
    prefix[0] = 0
    matched = 0

    for index in range(1, sub_length):
        while matched > 0 and sub[index] != sub[matched]:
            matched = prefix[matched - 1]
        if sub[index] == sub[matched]:
            matched += 1
        prefix[index] = matched

    total = 0
    matched = 0
    for position in range(start, end):
        while matched > 0 and value[position] != sub[matched]:
            matched = prefix[matched - 1]
        if value[position] == sub[matched]:
            matched += 1
            if matched == sub_length:
                total += 1
                matched = 0

    gc.free(prefix.as_byte())
    return total


def _unicode_count_typed(
    value: Ptr[Char],
    sub: Ptr[Char],
    sub_length: int,
    start: int,
    end: int,
    Char: type,
) -> int:
    if sub_length == 1:
        total = 0
        needle = sub[0]
        for position in range(start, end):
            if value[position] == needle:
                total += 1
        return total

    bloom = u64(0)
    for index in range(sub_length):
        bloom = _unicode_search_bloom_add(bloom, int(sub[index]))

    last = sub_length - 1
    tail = sub[last]
    limit = end - sub_length
    position = start
    attempts = 0
    total = 0

    while position <= limit:
        candidate_tail = value[position + last]
        if candidate_tail == tail and _unicode_starts_at_typed(
            value, sub, sub_length, position
        ):
            total += 1
            position += sub_length
            attempts = 0
            continue

        attempts += 1
        if attempts > sub_length and position + sub_length <= limit:
            return total + _unicode_count_kmp_typed(
                value, sub, sub_length, position, end
            )

        if _unicode_search_bloom_contains(bloom, int(candidate_tail)):
            position += 1
        else:
            position += sub_length

    return total


def _unicode_count_kmp(
    value: unicode,
    sub: unicode,
    start: int,
    end: int,
) -> int:
    sub_length = len(sub)
    if sub_length == 1:
        total = 0
        needle = sub._load_codepoint(0)
        for position in range(start, end):
            if value._load_codepoint(position) == needle:
                total += 1
        return total

    prefix = Ptr[int](sub_length)
    prefix[0] = 0
    matched = 0

    for index in range(1, sub_length):
        while (
            matched > 0
            and sub._load_codepoint(index) != sub._load_codepoint(matched)
        ):
            matched = prefix[matched - 1]
        if sub._load_codepoint(index) == sub._load_codepoint(matched):
            matched += 1
        prefix[index] = matched

    total = 0
    matched = 0
    for position in range(start, end):
        while (
            matched > 0
            and value._load_codepoint(position) != sub._load_codepoint(matched)
        ):
            matched = prefix[matched - 1]
        if value._load_codepoint(position) == sub._load_codepoint(matched):
            matched += 1
            if matched == sub_length:
                total += 1
                matched = 0

    gc.free(prefix.as_byte())
    return total


def _unicode_count(
    value: unicode,
    sub: unicode,
    start: int,
    end: int,
) -> int:
    if value._kind() <= KIND_LATIN1 and sub._kind() <= KIND_LATIN1:
        return _unicode_count_typed(value._data, sub._data, len(sub), start, end)
    if value._kind() == KIND_UCS2 and sub._kind() == KIND_UCS2:
        return _unicode_count_typed(
            Ptr[u16](value._data), Ptr[u16](sub._data), len(sub), start, end
        )
    if value._kind() == KIND_UCS4 and sub._kind() == KIND_UCS4:
        return _unicode_count_typed(
            Ptr[u32](value._data), Ptr[u32](sub._data), len(sub), start, end
        )

    sub_length = len(sub)
    if sub_length == 1:
        total = 0
        needle = sub._load_codepoint(0)
        for position in range(start, end):
            if value._load_codepoint(position) == needle:
                total += 1
        return total

    bloom = u64(0)
    for index in range(sub_length):
        bloom = _unicode_search_bloom_add(bloom, sub._load_codepoint(index))

    last = sub_length - 1
    tail = sub._load_codepoint(last)
    limit = end - sub_length
    position = start
    attempts = 0
    total = 0

    while position <= limit:
        candidate_tail = value._load_codepoint(position + last)
        if candidate_tail == tail and _unicode_starts_at(value, sub, position):
            total += 1
            position += sub_length
            attempts = 0
            continue

        attempts += 1
        if attempts > sub_length and position + sub_length <= limit:
            return total + _unicode_count_kmp(value, sub, position, end)

        if _unicode_search_bloom_contains(bloom, candidate_tail):
            position += 1
        else:
            position += sub_length

    return total


def _unicode_fastsearch(
    value: unicode,
    sub: unicode,
    start: int,
    end: int,
) -> int:
    if value._kind() <= KIND_LATIN1 and sub._kind() <= KIND_LATIN1:
        return _unicode_fastsearch_typed(value._data, len(value), sub._data, len(sub), start, end)
    if value._kind() == KIND_UCS2 and sub._kind() == KIND_UCS2:
        return _unicode_fastsearch_typed(Ptr[u16](value._data), len(value), Ptr[u16](sub._data), len(sub), start, end)
    if value._kind() == KIND_UCS4 and sub._kind() == KIND_UCS4:
        return _unicode_fastsearch_typed(Ptr[u32](value._data), len(value), Ptr[u32](sub._data), len(sub), start, end)

    needle_length = len(sub)
    if needle_length == 1:
        needle = sub._load_codepoint(0)
        for position in range(start, end):
            if value._load_codepoint(position) == needle:
                return position
        return -1

    bloom = u64(0)
    for index in range(needle_length):
        bloom = _unicode_search_bloom_add(bloom, sub._load_codepoint(index))

    last = needle_length - 1
    tail = sub._load_codepoint(last)
    limit = end - needle_length
    position = start
    attempts = 0

    while position <= limit:
        candidate_tail = value._load_codepoint(position + last)
        if candidate_tail == tail and _unicode_starts_at(value, sub, position):
            return position

        attempts += 1
        if attempts > needle_length and position + needle_length <= limit:
            return _unicode_fastsearch_kmp(value, sub, position + 1, end)

        if _unicode_search_bloom_contains(bloom, candidate_tail):
            position += 1
        else:
            position += needle_length

    return -1


def _unicode_fastsearch_reverse(
    value: unicode,
    sub: unicode,
    start: int,
    end: int,
) -> int:
    if value._kind() <= KIND_LATIN1 and sub._kind() <= KIND_LATIN1:
        return _unicode_fastsearch_reverse_typed(value._data, sub._data, len(sub), start, end)
    if value._kind() == KIND_UCS2 and sub._kind() == KIND_UCS2:
        return _unicode_fastsearch_reverse_typed(Ptr[u16](value._data), Ptr[u16](sub._data), len(sub), start, end)
    if value._kind() == KIND_UCS4 and sub._kind() == KIND_UCS4:
        return _unicode_fastsearch_reverse_typed(Ptr[u32](value._data), Ptr[u32](sub._data), len(sub), start, end)

    needle_length = len(sub)
    if needle_length == 1:
        needle = sub._load_codepoint(0)
        for position in range(end - 1, start - 1, -1):
            if value._load_codepoint(position) == needle:
                return position
        return -1

    bloom = u64(0)
    for index in range(needle_length):
        bloom = _unicode_search_bloom_add(bloom, sub._load_codepoint(index))

    first = sub._load_codepoint(0)
    position = end - needle_length
    attempts = 0

    while position >= start:
        candidate_first = value._load_codepoint(position)
        if candidate_first == first and _unicode_starts_at(value, sub, position):
            return position

        attempts += 1
        if attempts > needle_length and position - needle_length >= start:
            return _unicode_fastsearch_reverse_kmp(
                value, sub, start, position + needle_length - 2
            )

        if _unicode_search_bloom_contains(bloom, candidate_first):
            position -= 1
        else:
            position -= needle_length

    return -1


def _unicode_fastsearch_kmp(
    value: unicode,
    sub: unicode,
    start: int,
    end: int,
) -> int:
    needle_length = len(sub)
    prefix = Ptr[int](needle_length)
    prefix[0] = 0
    matched = 0

    for index in range(1, needle_length):
        while matched > 0 and sub._load_codepoint(index) != sub._load_codepoint(matched):
            matched = prefix[matched - 1]
        if sub._load_codepoint(index) == sub._load_codepoint(matched):
            matched += 1
        prefix[index] = matched

    matched = 0
    for position in range(start, end):
        while matched > 0 and value._load_codepoint(position) != sub._load_codepoint(matched):
            matched = prefix[matched - 1]
        if value._load_codepoint(position) == sub._load_codepoint(matched):
            matched += 1
            if matched == needle_length:
                result = position - needle_length + 1
                gc.free(prefix.as_byte())
                return result

    gc.free(prefix.as_byte())
    return -1


def _unicode_fastsearch_reverse_kmp(
    value: unicode,
    sub: unicode,
    start: int,
    end: int,
) -> int:
    needle_length = len(sub)
    prefix = Ptr[int](needle_length)
    prefix[0] = 0
    matched = 0

    for index in range(1, needle_length):
        while (
            matched > 0
            and sub._load_codepoint(needle_length - 1 - index)
                != sub._load_codepoint(needle_length - 1 - matched)
        ):
            matched = prefix[matched - 1]
        if (
            sub._load_codepoint(needle_length - 1 - index)
            == sub._load_codepoint(needle_length - 1 - matched)
        ):
            matched += 1
        prefix[index] = matched

    matched = 0
    for position in range(end, start - 1, -1):
        while (
            matched > 0
            and value._load_codepoint(position)
                != sub._load_codepoint(needle_length - 1 - matched)
        ):
            matched = prefix[matched - 1]
        if (
            value._load_codepoint(position)
            == sub._load_codepoint(needle_length - 1 - matched)
        ):
            matched += 1
            if matched == needle_length:
                gc.free(prefix.as_byte())
                return position

    gc.free(prefix.as_byte())
    return -1


def _unicode_copy_range(
    dst: unicode,
    src: unicode,
    dst_offset: int,
    src_start: int,
    src_end: int,
) -> None:
    length = src_end - src_start

    if length <= 0:
        return

    src_width = src._width()
    dst_width = dst._width()

    if src_width == dst_width:
        nbytes = length * src_width
        str.memcpy(
            dst._data + dst_offset * dst_width,
            src._data + src_start * src_width,
            nbytes,
        )
        return

    for i in range(length):
        dst._store_codepoint(dst_offset + i, src._load_codepoint(src_start + i))


def _unicode_slice_impl(
    value: unicode,
    start: int,
    end: int,
) -> unicode:
    if start >= end:
        return _unicode_empty()

    return unicode(
        value._data + start * value._width(),
        _make_meta(end - start, value._kind()),
    )


def _unicode_concat_impl(left: unicode, right: unicode) -> unicode:
    if len(left) == 0:
        return right

    if len(right) == 0:
        return left

    maxchar = _unicode_maxchar(left)
    right_max = _unicode_maxchar(right)

    if right_max > maxchar:
        maxchar = right_max

    result = _unicode_new_uninit(len(left) + len(right), maxchar)
    _unicode_copy_range(result, left, 0, 0, len(left))
    _unicode_copy_range(result, right, len(left), 0, len(right))
    return result


def _unicode_repeat_impl(value: unicode, count: int) -> unicode:
    if count <= 0:
        return _unicode_empty()

    length = len(value) * count
    maxchar = _unicode_maxchar(value)

    result = _unicode_new_uninit(length, maxchar)

    for i in range(count):
        _unicode_copy_range(result, value, i * len(value), 0, len(value))

    return result


def _unicode_new_from_repeat(cp: int, length: int) -> unicode:
    if length <= 0:
        return _unicode_empty()

    result = _unicode_new_uninit(length, cp)
    for i in range(length):
        result._store_codepoint(i, cp)

    return result


def _unicode_strip_impl(value: unicode, left: bool, right: bool) -> unicode:
    start = 0
    end = len(value)

    if left:
        while start < end and unicode_is_space(value._load_codepoint(start)):
            start += 1

    if right:
        while end > start and unicode_is_space(value._load_codepoint(end - 1)):
            end -= 1

    return _unicode_slice_impl(value, start, end)


def _unicode_contains_codepoint(value: unicode, cp: int) -> bool:
    for i in range(len(value)):
        if value._load_codepoint(i) == cp:
            return True
    return False


def _unicode_strip_chars_impl(
    value: unicode,
    chars: unicode,
    left: bool,
    right: bool,
) -> unicode:
    start = 0
    end = len(value)

    if left:
        while start < end and _unicode_contains_codepoint(
            chars, value._load_codepoint(start)
        ):
            start += 1

    if right:
        while end > start and _unicode_contains_codepoint(
            chars, value._load_codepoint(end - 1)
        ):
            end -= 1

    return _unicode_slice_impl(value, start, end)


def _unicode_fillchar(fillchar: unicode) -> int:
    if len(fillchar) != 1:
        raise TypeError("The fill character must be exactly one character long")
    return fillchar._load_codepoint(0)


def _unicode_center_impl(
    value: unicode,
    width: int,
    fillchar: unicode,
) -> unicode:
    if len(value) >= width:
        return value

    fill = _unicode_fillchar(fillchar)
    maxchar = _unicode_maxchar(value)
    if fill > maxchar:
        maxchar = fill

    padding = width - len(value)
    left = padding // 2
    result = _unicode_new_uninit(width, maxchar)

    for i in range(left):
        result._store_codepoint(i, fill)

    _unicode_copy_range(result, value, left, 0, len(value))

    for i in range(left + len(value), width):
        result._store_codepoint(i, fill)

    return result


def _unicode_ljust_impl(
    value: unicode,
    width: int,
    fillchar: unicode,
) -> unicode:
    if len(value) >= width:
        return value

    fill = _unicode_fillchar(fillchar)
    maxchar = _unicode_maxchar(value)
    if fill > maxchar:
        maxchar = fill

    result = _unicode_new_uninit(width, maxchar)
    _unicode_copy_range(result, value, 0, 0, len(value))

    for i in range(len(value), width):
        result._store_codepoint(i, fill)

    return result


def _unicode_rjust_impl(
    value: unicode,
    width: int,
    fillchar: unicode,
) -> unicode:
    if len(value) >= width:
        return value

    fill = _unicode_fillchar(fillchar)
    maxchar = _unicode_maxchar(value)
    if fill > maxchar:
        maxchar = fill

    padding = width - len(value)
    result = _unicode_new_uninit(width, maxchar)

    for i in range(padding):
        result._store_codepoint(i, fill)

    _unicode_copy_range(result, value, padding, 0, len(value))
    return result


def _unicode_split_capacity(maxsplit: int) -> int:
    if maxsplit < 0 or maxsplit >= 12:
        return 12
    return maxsplit + 1


def _unicode_split_whitespace_impl(
    value: unicode,
    reverse: Literal[bool] = False,
    maxsplit: int = -1,
) -> List[unicode]:
    parts = List[unicode](_unicode_split_capacity(maxsplit))
    length = len(value)

    if not reverse:
        i = 0
        splits = 0

        while i < length:
            while i < length and unicode_is_space(value._load_codepoint(i)):
                i += 1

            if i == length:
                break

            if maxsplit >= 0 and splits == maxsplit:
                parts.append(_unicode_slice_impl(value, i, length))
                break

            start = i

            while i < length and not unicode_is_space(value._load_codepoint(i)):
                i += 1

            parts.append(_unicode_slice_impl(value, start, i))
            splits += 1

        return parts

    i = length - 1
    splits = 0

    while i >= 0:
        while i >= 0 and unicode_is_space(value._load_codepoint(i)):
            i -= 1

        if i < 0:
            break

        if maxsplit >= 0 and splits == maxsplit:
            parts.append(_unicode_slice_impl(value, 0, i + 1))
            break

        end = i + 1

        while i >= 0 and not unicode_is_space(value._load_codepoint(i)):
            i -= 1

        parts.append(_unicode_slice_impl(value, i + 1, end))
        splits += 1

    parts.reverse()
    return parts


def _unicode_split_char_typed(
    value: unicode,
    data: Ptr[Char],
    separator: Char,
    maxsplit: int,
    reverse: Literal[bool],
    Char: type,
) -> List[unicode]:
    parts = List[unicode](_unicode_split_capacity(maxsplit))

    if not reverse:
        start = 0
        splits = 0

        for position in range(len(value)):
            if maxsplit >= 0 and splits == maxsplit:
                break
            if data[position] != separator:
                continue
            parts.append(_unicode_slice_impl(value, start, position))
            start = position + 1
            splits += 1

        parts.append(_unicode_slice_impl(value, start, len(value)))
        return parts

    end = len(value)
    splits = 0
    for position in range(len(value) - 1, -1, -1):
        if maxsplit >= 0 and splits == maxsplit:
            break
        if data[position] != separator:
            continue
        parts.append(_unicode_slice_impl(value, position + 1, end))
        end = position
        splits += 1

    parts.append(_unicode_slice_impl(value, 0, end))
    parts.reverse()
    return parts


def _unicode_split_exact_impl(
    value: unicode,
    sep: unicode,
    maxsplit: int,
    reverse: Literal[bool] = False,
) -> List[unicode]:
    if len(sep) == 0:
        raise ValueError("empty separator")

    parts = List[unicode](_unicode_split_capacity(maxsplit))

    if maxsplit == 0:
        parts.append(value)
        return parts

    if value._kind() != sep._kind():
        typed_sep = _unicode_coerce_kind(sep, value._kind())
        if typed_sep is None:
            parts.append(value)
            return parts
        sep = typed_sep

    if len(sep) == 1:
        if value._kind() <= KIND_LATIN1 and sep._kind() <= KIND_LATIN1:
            return _unicode_split_char_typed(
                value, value._data, sep._data[0], maxsplit, reverse
            )
        if value._kind() == KIND_UCS2 and sep._kind() == KIND_UCS2:
            data = Ptr[u16](value._data)
            separator = Ptr[u16](sep._data)[0]
            return _unicode_split_char_typed(
                value, data, separator, maxsplit, reverse
            )
        if value._kind() == KIND_UCS4 and sep._kind() == KIND_UCS4:
            data = Ptr[u32](value._data)
            separator = Ptr[u32](sep._data)[0]
            return _unicode_split_char_typed(
                value, data, separator, maxsplit, reverse
            )

        separator = sep._load_codepoint(0)

        if not reverse:
            start = 0
            splits = 0

            for position in range(len(value)):
                if maxsplit >= 0 and splits == maxsplit:
                    break
                if value._load_codepoint(position) != separator:
                    continue
                parts.append(_unicode_slice_impl(value, start, position))
                start = position + 1
                splits += 1

            parts.append(_unicode_slice_impl(value, start, len(value)))
            return parts

        end = len(value)
        splits = 0
        for position in range(len(value) - 1, -1, -1):
            if maxsplit >= 0 and splits == maxsplit:
                break
            if value._load_codepoint(position) != separator:
                continue
            parts.append(_unicode_slice_impl(value, position + 1, end))
            end = position
            splits += 1

        parts.append(_unicode_slice_impl(value, 0, end))
        parts.reverse()
        return parts

    if not reverse:
        start = 0
        remaining = maxsplit

        while True:
            if maxsplit >= 0 and remaining == 0:
                parts.append(_unicode_slice_impl(value, start, len(value)))
                break

            pos = _unicode_fastsearch(value, sep, start, len(value))

            if pos == -1:
                parts.append(_unicode_slice_impl(value, start, len(value)))
                break

            parts.append(_unicode_slice_impl(value, start, pos))

            start = pos + len(sep)
            remaining -= 1

        return parts

    start = len(value)
    remaining = maxsplit

    while True:
        if maxsplit >= 0 and remaining == 0:
            parts.append(_unicode_slice_impl(value, 0, start))
            break

        pos = _unicode_fastsearch_reverse(value, sep, 0, start)

        if pos == -1:
            parts.append(_unicode_slice_impl(value, 0, start))
            break

        parts.append(_unicode_slice_impl(value, pos + len(sep), start))

        start = pos
        remaining -= 1

    parts.reverse()
    return parts


def _unicode_splitlines_impl(value: unicode, keepends: bool) -> List[unicode]:
    parts = []
    start = 0
    i = 0

    while i < len(value):
        cp = value._load_codepoint(i)
        line_end = i
        next_start = i + 1

        if cp == 0x0D:
            if i + 1 < len(value) and value._load_codepoint(i + 1) == 0x0A:
                next_start = i + 2
        elif (
            cp != 0x0A
            and cp != 0x0B
            and cp != 0x0C
            and cp != 0x1C
            and cp != 0x1D
            and cp != 0x1E
            and cp != 0x85
            and cp != 0x2028
            and cp != 0x2029
        ):
            i += 1
            continue

        if keepends:
            parts.append(_unicode_slice_impl(value, start, next_start))
        else:
            parts.append(_unicode_slice_impl(value, start, line_end))

        start = next_start
        i = next_start

    if start < len(value):
        parts.append(_unicode_slice_impl(value, start, len(value)))

    return parts


def _unicode_join_impl(sep: unicode, values: List[unicode]) -> unicode:
    if len(values) == 0:
        return _unicode_empty()

    total_len = 0
    maxchar = 0

    for i in range(len(values)):
        piece = values[i]
        total_len += len(piece)

        if _unicode_maxchar(piece) > maxchar:
            maxchar = _unicode_maxchar(piece)

    if len(values) > 1:
        total_len += (len(values) - 1) * len(sep)

    if len(sep) > 0 and _unicode_maxchar(sep) > maxchar:
        maxchar = _unicode_maxchar(sep)

    result = _unicode_new_uninit(total_len, maxchar)
    out = 0

    for i in range(len(values)):
        if i > 0 and len(sep) > 0:
            _unicode_copy_range(result, sep, out, 0, len(sep))
            out += len(sep)

        piece = values[i]
        _unicode_copy_range(result, piece, out, 0, len(piece))
        out += len(piece)

    return result


def _unicode_replace_impl(
    value: unicode,
    old: unicode,
    new: unicode,
    count: int,
) -> unicode:
    if count == 0:
        return value

    if len(old) == 0:
        insertions = len(value) + 1

        if count >= 0 and count < insertions:
            insertions = count

        if insertions == 0:
            return value

        maxchar = _unicode_maxchar(value)
        new_maxchar = _unicode_maxchar(new)

        if new_maxchar > maxchar:
            maxchar = new_maxchar

        result = _unicode_new_uninit(
            len(value) + insertions * len(new),
            maxchar,
        )
        out = 0

        for i in range(len(value) + 1):
            if i < insertions:
                _unicode_copy_range(result, new, out, 0, len(new))
                out += len(new)

            if i < len(value):
                result._store_codepoint(out, value._load_codepoint(i))
                out += 1

        return result

    total_len = len(value)
    start = 0
    remaining = count

    while True:
        pos = value.find(old, start)

        if pos == -1 or (count >= 0 and remaining == 0):
            break

        total_len += len(new) - len(old)
        start = pos + len(old)

        if count >= 0:
            remaining -= 1

    maxchar = _unicode_maxchar(value)
    new_max = _unicode_maxchar(new)

    if new_max > maxchar:
        maxchar = new_max

    result = _unicode_new_uninit(total_len, maxchar)

    out = 0
    start = 0
    remaining = count

    while True:
        pos = value.find(old, start)

        if pos == -1 or (count >= 0 and remaining == 0):
            break

        _unicode_copy_range(result, value, out, start, pos)
        out += pos - start

        _unicode_copy_range(result, new, out, 0, len(new))
        out += len(new)

        start = pos + len(old)

        if count >= 0:
            remaining -= 1

    _unicode_copy_range(result, value, out, start, len(value))
    return result


def _unicode_translate_int_impl(value: unicode, table: dict[int, int]) -> unicode:
    maxchar = 0
    out_len = 0

    for i in range(len(value)):
        cp = value._load_codepoint(i)
        mapped = table.get(cp, cp)

        if mapped == -1:
            continue

        if mapped < 0 or mapped > UNICODE_MAX or _is_surrogate(mapped):
            raise ValueError("invalid translation code point")

        if mapped > maxchar:
            maxchar = mapped

        out_len += 1

    result = _unicode_new_uninit(len(value), maxchar)
    out = 0

    for i in range(len(value)):
        cp = value._load_codepoint(i)
        mapped = table.get(cp, cp)

        if mapped == -1:
            continue

        result._store_codepoint(out, mapped)
        out += 1

    return _unicode_slice_impl(result, 0, out)


def _unicode_translate_unicode_impl(
    value: unicode,
    table: dict[int, unicode],
) -> unicode:
    pieces = []

    for i in range(len(value)):
        cp = value._load_codepoint(i)
        if cp in table:
            pieces.append(table[cp])
        else:
            pieces.append(value[i])

    return _unicode_join_impl(_unicode_empty(), pieces)


def _unicode_translate_optional_int_impl(
    value: unicode,
    table: dict[int, Optional[int]],
) -> unicode:
    maxchar = 0
    out_len = 0

    for i in range(len(value)):
        codepoint = value._load_codepoint(i)
        mapped = table[codepoint] if codepoint in table else codepoint

        if mapped is None:
            continue

        if mapped < 0 or mapped > UNICODE_MAX or _is_surrogate(mapped):
            raise ValueError("invalid translation code point")

        if mapped > maxchar:
            maxchar = mapped
        out_len += 1

    result = _unicode_new_uninit(out_len, maxchar)
    out = 0

    for i in range(len(value)):
        codepoint = value._load_codepoint(i)
        mapped = table[codepoint] if codepoint in table else codepoint

        if mapped is not None:
            result._store_codepoint(out, mapped)
            out += 1

    return result


def _unicode_translate_optional_unicode_impl(
    value: unicode,
    table: dict[int, Optional[unicode]],
) -> unicode:
    pieces = []

    for i in range(len(value)):
        cp = value._load_codepoint(i)
        if cp not in table:
            pieces.append(value[i])
            continue

        mapped = table[cp]
        if mapped is not None:
            pieces.append(mapped)

    return _unicode_join_impl(_unicode_empty(), pieces)


def _unicode_ascii_map(value: unicode, transform) -> unicode:
    result = _unicode_new_uninit(len(value), 0x7F)

    for i in range(len(value)):
        result._data[i] = u8(transform(int(value._data[i])))

    return result


def _unicode_ascii_capitalize(value: unicode) -> unicode:
    result = _unicode_new_uninit(len(value), 0x7F)

    if len(value) == 0:
        return result

    result._data[0] = u8(_ascii_upper(int(value._data[0])))

    for i in range(1, len(value)):
        result._data[i] = u8(_ascii_lower(int(value._data[i])))

    return result


def _unicode_ascii_title(value: unicode) -> unicode:
    result = _unicode_new_uninit(len(value), 0x7F)
    previous_is_cased = False

    for i in range(len(value)):
        cp = int(value._data[i])

        if _is_ascii_alpha(cp):
            if previous_is_cased:
                cp = _ascii_lower(cp)
            else:
                cp = _ascii_upper(cp)
            previous_is_cased = True
        else:
            previous_is_cased = False

        result._data[i] = u8(cp)

    return result


def _unicode_map_full(value: unicode, mapping_length, mapping_codepoint) -> unicode:
    output_length = 0
    maxchar = 0

    for i in range(len(value)):
        cp = value._load_codepoint(i)
        length = mapping_length(cp)
        output_length += length

        for j in range(length):
            mapped = mapping_codepoint(cp, j)
            if mapped > maxchar:
                maxchar = mapped

    result = _unicode_new_uninit(output_length, maxchar)
    output = 0

    for i in range(len(value)):
        cp = value._load_codepoint(i)
        length = mapping_length(cp)

        for j in range(length):
            result._store_codepoint(output, mapping_codepoint(cp, j))
            output += 1

    return result


def _unicode_is_final_sigma(value: unicode, pos: int) -> bool:
    if value._load_codepoint(pos) != 0x03A3:
        return False

    i = pos - 1
    while i >= 0 and unicode_is_case_ignorable(value._load_codepoint(i)):
        i -= 1

    if i < 0 or not unicode_is_cased(value._load_codepoint(i)):
        return False

    i = pos + 1
    while i < len(value) and unicode_is_case_ignorable(value._load_codepoint(i)):
        i += 1

    return i >= len(value) or not unicode_is_cased(value._load_codepoint(i))


def _unicode_lower_mapping_length(value: unicode, pos: int) -> int:
    if _unicode_is_final_sigma(value, pos):
        return 1

    return unicode_lower_mapping_length(value._load_codepoint(pos))


def _unicode_lower_mapping_codepoint(
    value: unicode,
    pos: int,
    index: int,
) -> int:
    if _unicode_is_final_sigma(value, pos):
        return 0x03C2

    return unicode_lower_mapping_codepoint(value._load_codepoint(pos), index)


def _unicode_lower_full(value: unicode) -> unicode:
    output_length = 0
    maxchar = 0

    for i in range(len(value)):
        length = _unicode_lower_mapping_length(value, i)
        output_length += length

        for j in range(length):
            mapped = _unicode_lower_mapping_codepoint(value, i, j)
            if mapped > maxchar:
                maxchar = mapped

    result = _unicode_new_uninit(output_length, maxchar)
    output = 0

    for i in range(len(value)):
        length = _unicode_lower_mapping_length(value, i)

        for j in range(length):
            result._store_codepoint(
                output,
                _unicode_lower_mapping_codepoint(value, i, j),
            )
            output += 1

    return result


def _unicode_upper_full(value: unicode) -> unicode:
    return _unicode_map_full(
        value,
        unicode_upper_mapping_length,
        unicode_upper_mapping_codepoint,
    )


def _unicode_capitalize_full(value: unicode) -> unicode:
    output_length = 0
    maxchar = 0

    for i in range(len(value)):
        if i == 0:
            cp = value._load_codepoint(i)
            length = unicode_title_mapping_length(cp)

            for j in range(length):
                mapped = unicode_title_mapping_codepoint(cp, j)
                if mapped > maxchar:
                    maxchar = mapped
        else:
            length = _unicode_lower_mapping_length(value, i)

            for j in range(length):
                mapped = _unicode_lower_mapping_codepoint(value, i, j)
                if mapped > maxchar:
                    maxchar = mapped

        output_length += length

    result = _unicode_new_uninit(output_length, maxchar)
    output = 0
    previous_is_cased = False

    for i in range(len(value)):
        cp = value._load_codepoint(i)

        if previous_is_cased:
            length = _unicode_lower_mapping_length(value, i)
            for j in range(length):
                result._store_codepoint(
                    output,
                    _unicode_lower_mapping_codepoint(value, i, j),
                )
                output += 1
        else:
            length = unicode_title_mapping_length(cp)
            for j in range(length):
                result._store_codepoint(
                    output,
                    unicode_title_mapping_codepoint(cp, j),
                )
                output += 1

        if unicode_is_cased(cp):
            previous_is_cased = True
        elif not unicode_is_case_ignorable(cp):
            previous_is_cased = False

    return result


def _unicode_title_full(value: unicode) -> unicode:
    output_length = 0
    maxchar = 0
    previous_is_cased = False

    for i in range(len(value)):
        cp = value._load_codepoint(i)

        if previous_is_cased:
            length = _unicode_lower_mapping_length(value, i)
            for j in range(length):
                mapped = _unicode_lower_mapping_codepoint(value, i, j)
                if mapped > maxchar:
                    maxchar = mapped
        else:
            length = unicode_title_mapping_length(cp)
            for j in range(length):
                mapped = unicode_title_mapping_codepoint(cp, j)
                if mapped > maxchar:
                    maxchar = mapped

        output_length += length

        if unicode_is_cased(cp):
            previous_is_cased = True
        else:
            previous_is_cased = False

    result = _unicode_new_uninit(output_length, maxchar)
    output = 0
    previous_is_cased = False

    for i in range(len(value)):
        cp = value._load_codepoint(i)

        if previous_is_cased:
            length = _unicode_lower_mapping_length(value, i)
            for j in range(length):
                result._store_codepoint(
                    output,
                    _unicode_lower_mapping_codepoint(value, i, j),
                )
                output += 1
        else:
            length = unicode_title_mapping_length(cp)
            for j in range(length):
                result._store_codepoint(
                    output,
                    unicode_title_mapping_codepoint(cp, j),
                )
                output += 1

        if unicode_is_cased(cp):
            previous_is_cased = True
        else:
            previous_is_cased = False

    return result


def _unicode_swapcase_full(value: unicode) -> unicode:
    output_length = 0
    maxchar = 0

    for i in range(len(value)):
        cp = value._load_codepoint(i)

        if unicode_is_lower(cp):
            length = unicode_upper_mapping_length(cp)
            for j in range(length):
                mapped = unicode_upper_mapping_codepoint(cp, j)
                if mapped > maxchar:
                    maxchar = mapped
        elif unicode_is_upper(cp):
            length = _unicode_lower_mapping_length(value, i)
            for j in range(length):
                mapped = _unicode_lower_mapping_codepoint(value, i, j)
                if mapped > maxchar:
                    maxchar = mapped
        else:
            length = 1
            if cp > maxchar:
                maxchar = cp

        output_length += length

    result = _unicode_new_uninit(output_length, maxchar)
    output = 0

    for i in range(len(value)):
        cp = value._load_codepoint(i)

        if unicode_is_lower(cp):
            length = unicode_upper_mapping_length(cp)
            for j in range(length):
                result._store_codepoint(
                    output,
                    unicode_upper_mapping_codepoint(cp, j),
                )
                output += 1
        elif unicode_is_upper(cp):
            length = _unicode_lower_mapping_length(value, i)
            for j in range(length):
                result._store_codepoint(
                    output,
                    _unicode_lower_mapping_codepoint(value, i, j),
                )
                output += 1
        else:
            result._store_codepoint(output, cp)
            output += 1

    return result


def _ascii_lower(cp: int) -> int:
    if 0x41 <= cp <= 0x5A:
        return cp + 0x20
    return cp


def _ascii_upper(cp: int) -> int:
    if 0x61 <= cp <= 0x7A:
        return cp - 0x20
    return cp


def _ascii_casefold(cp: int) -> int:
    return _ascii_lower(cp)


def _ascii_swapcase(cp: int) -> int:
    if 0x41 <= cp <= 0x5A:
        return cp + 0x20
    if 0x61 <= cp <= 0x7A:
        return cp - 0x20
    return cp


def _is_ascii_whitespace(cp: int) -> bool:
    return (
        cp == 0x09
        or cp == 0x0A
        or cp == 0x0B
        or cp == 0x0C
        or cp == 0x0D
        or cp == 0x20
    )


def _is_ascii_alpha(cp: int) -> bool:
    return (0x41 <= cp <= 0x5A) or (0x61 <= cp <= 0x7A)


def _is_ascii_digit(cp: int) -> bool:
    return 0x30 <= cp <= 0x39


def _is_ascii_alnum(cp: int) -> bool:
    return _is_ascii_alpha(cp) or _is_ascii_digit(cp)


def _is_ascii_lower(cp: int) -> bool:
    return 0x61 <= cp <= 0x7A


def _is_ascii_upper(cp: int) -> bool:
    return 0x41 <= cp <= 0x5A


def _is_ascii_id_start(cp: int) -> bool:
    return _is_ascii_alpha(cp) or cp == 0x5F


def _is_ascii_id_continue(cp: int) -> bool:
    return _is_ascii_alpha(cp) or _is_ascii_digit(cp) or cp == 0x5F


class _UnicodeByteBuffer:
    data: Ptr[u8]
    length: int
    capacity: int

    def __init__(self, capacity: int = 16):
        self.data = Ptr[u8](capacity)
        self.length = 0
        self.capacity = capacity

    def reserve(self, extra: int):
        required = self.length + extra

        if required <= self.capacity:
            return

        old_capacity = self.capacity
        capacity = old_capacity

        while capacity < required:
            capacity *= 2

        self.data = gc.realloc(self.data, capacity, old_capacity)
        self.capacity = capacity

    def append_byte(self, value: u8):
        self.reserve(1)
        self.data[self.length] = value
        self.length += 1

    def append_utf8(self, cp: int):
        self.reserve(_utf8_encoded_width(cp))
        self.length = _utf8_encode_one(self.data, self.length, cp)


def _unicode_repr_append_hex(
    output: _UnicodeByteBuffer,
    value: int,
    digits: int,
):
    for i in range(digits - 1, -1, -1):
        digit = (value >> (i * 4)) & 0xF
        output.append_byte(
            u8(0x30 + digit if digit < 10 else 0x61 + digit - 10)
        )


def _unicode_repr_append_codepoint(
    output: _UnicodeByteBuffer,
    cp: int,
    quote: int,
):
    if cp == quote or cp == 0x5C:  # quote / backslash
        output.append_byte(u8(0x5C))
        output.append_byte(u8(cp))
        return

    if cp == 0x09:
        output.append_byte(u8(0x5C))
        output.append_byte(u8(0x74))
        return

    if cp == 0x0A:
        output.append_byte(u8(0x5C))
        output.append_byte(u8(0x6E))
        return

    if cp == 0x0D:
        output.append_byte(u8(0x5C))
        output.append_byte(u8(0x72))
        return

    if cp < 0x20 or cp == 0x7F:
        output.append_byte(u8(0x5C))
        output.append_byte(u8(0x78))
        _unicode_repr_append_hex(output, cp, 2)
        return

    if unicode_is_printable(cp):
        output.append_utf8(cp)
        return

    output.append_byte(u8(0x5C))

    if cp <= 0xFF:
        output.append_byte(u8(0x78))
        _unicode_repr_append_hex(output, cp, 2)
    elif cp <= 0xFFFF:
        output.append_byte(u8(0x75))
        _unicode_repr_append_hex(output, cp, 4)
    else:
        output.append_byte(u8(0x55))
        _unicode_repr_append_hex(output, cp, 8)
