def unicode_is_numeric(cp: int) -> bool:
    if cp < 0 or cp > 194815:
        return False

    page = cp >> UNICODE_PAGE_SHIFT
    page_index = int(_unicode_numeric_page(page))

    if page_index < 0:
        return False

    word = _unicode_numeric_word(
        page_index * UNICODE_PAGE_WORDS + ((cp >> 6) & 3)
    )
    return ((word >> u64(cp & 63)) & u64(1)) != 0

