def _unicode_casefold_mapping_lookup(cp: int) -> int:
    if cp < 0 or cp > 125439:
        return 0

    page_index = int(_unicode_casefold_mapping_page(cp >> UNICODE_PAGE_SHIFT))

    if page_index < 0:
        return 0

    return int(
        _unicode_casefold_mapping_record(
            page_index * 256 + (cp & 255)
        )
    )


def unicode_casefold_mapping_record(cp: int) -> int:
    return _unicode_casefold_mapping_lookup(cp)


def unicode_casefold_mapping_record_length(record: int) -> int:
    if record >= 0:
        return 1

    return int(
        _unicode_casefold_mapping_data(
            (record & 0x7FFFFFFF) * 4
        )
    )


def unicode_casefold_mapping_record_codepoint(
    cp: int,
    record: int,
    index: int,
) -> int:
    if record == 0:
        return cp

    if record > 0:
        return cp + record - 1114112

    return int(
        _unicode_casefold_mapping_data(
            (record & 0x7FFFFFFF) * 4 + 1 + index
        )
    )


def unicode_casefold_mapping_length(cp: int) -> int:
    return unicode_casefold_mapping_record_length(
        unicode_casefold_mapping_record(cp)
    )


def unicode_casefold_mapping_codepoint(cp: int, index: int) -> int:
    return unicode_casefold_mapping_record_codepoint(
        cp,
        unicode_casefold_mapping_record(cp),
        index,
    )
