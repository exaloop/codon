import internal.static as static

@tuple(container=False)  # disallow default __getitem__
class Vec[T, N: Literal[int]]:
    def _is_int(T: type) -> Literal[bool]:
        return isinstance(T, Int) or isinstance(T, UInt)

    def _is_sint(T: type) -> Literal[bool]:
        return isinstance(T, Int)

    def _is_uint(T: type) -> Literal[bool]:
        return isinstance(T, UInt)

    def _int_prefix(T: type) -> Literal[str]:
        return 'u' if isinstance(T, UInt) else 's'

    def _is_float(T: type) -> Literal[bool]:
        return isinstance(T, float16) \
            or isinstance(T, float32) \
            or isinstance(T, float) \
            or isinstance(T, float128) \
            or isinstance(T, bfloat16)

    def _is_valid(T: type) -> Literal[bool]:
        return Vec._is_int(T) or Vec._is_float(T)

    def _sizeof(T: type) -> Literal[int]:
        if isinstance(T, Int):
            return T.N
        if isinstance(T, UInt):
            return T.N
        if isinstance(T, float16):
            return 16
        if isinstance(T, float32):
            return 32
        if isinstance(T, float):
            return 64
        if isinstance(T, float128):
            return 128
        if isinstance(T, bfloat16):
            return 16
        compile_error("invalid type")

    @pure
    @llvm
    def _set(val: T) -> Vec[T, N]:
        %0 = insertelement <{=N} x {=T}> undef, {=T} %val, i32 0
        %1 = shufflevector <{=N} x {=T}> %0, <{=N} x {=T}> undef, <{=N} x i32> zeroinitializer
        ret <{=N} x {=T}> %1

    @pure
    @llvm
    def _load_packed(data: cobj, ALIGNMENT: Literal[int] = 1) -> Vec[T, N]:
        %result = load <{=N} x {=T}>, ptr %data, align {=ALIGNMENT}
        ret <{=N} x {=T}> %result

    @pure
    @llvm
    def _load_lane(data: Ptr[T], index: int) -> T:
        %address = getelementptr {=T}, ptr %data, i64 %index
        %result = load {=T}, ptr %address, align 1
        ret {=T} %result

    @pure
    @llvm
    def _insert(self, index: Literal[int], value: T) -> Vec[T, N]:
        %result = insertelement <{=N} x {=T}> %self, {=T} %value, i32 {=index}
        ret <{=N} x {=T}> %result

    def _packed_layout() -> Literal[bool]:
        return Vec._sizeof(T) >= 8 and (Vec._sizeof(T) & (Vec._sizeof(T) - 1)) == 0

    def _load(data) -> Vec[T, N]:
        if Vec[T, N]._packed_layout():
            return Vec[T, N]._load_packed(cobj(data))
        result = Vec[T, N](T(0))
        for index in static.range(N):
            result = result._insert(index, Vec[T, N]._load_lane(Ptr[T](data), index))
        return result

    def _check_bounds(size: int, offset: int):
        if offset < 0 or offset > size or N > size - offset:
            raise IndexError("SIMD load out of range")

    def _check_alignment(ALIGNMENT: Literal[int]):
        MAX_ALIGNMENT: Literal[int] = 1 << 31
        if ALIGNMENT <= 0 or ALIGNMENT > MAX_ALIGNMENT or (ALIGNMENT & (ALIGNMENT - 1)) != 0:
            compile_error("SIMD alignment must be a power of two between 1 and 2**31")

    def _memory_mask(mask) -> Vec[u1, N]:
        if mask is None:
            return Vec[u1, N](1u1)
        if not isinstance(mask, Vec[u1, N]):
            compile_error("SIMD memory mask must have matching width and u1 elements")
        return mask

    @pure
    @llvm
    def _masked_load(data: Ptr[T], mask: Vec[u1, N], passthrough: Vec[T, N], ALIGNMENT: Literal[int]) -> Vec[T, N]:
        declare <{=N} x {=T}> @llvm.masked.load.v{=N}{=T}.p0(ptr, i32, <{=N} x i1>, <{=N} x {=T}>)
        %result = call <{=N} x {=T}> @llvm.masked.load.v{=N}{=T}.p0(ptr %data, i32 {=ALIGNMENT}, <{=N} x i1> %mask, <{=N} x {=T}> %passthrough)
        ret <{=N} x {=T}> %result

    def load(data: Ptr[T], offset: int = 0, alignment: Literal[int] = 1, mask=NoneType(), passthrough=NoneType()) -> Vec[T, N]:
        Vec[T, N]._check_alignment(alignment)
        active = Vec[T, N]._memory_mask(mask)
        result = Vec[T, N](T(0)) if passthrough is None else Vec[T, N](passthrough)
        if Vec[T, N]._packed_layout():
            if mask is None:
                return Vec[T, N]._load_packed(cobj(data + offset), alignment)
            return Vec[T, N]._masked_load(data + offset, active, result, alignment)
        for lane in static.range(N):
            if active._extract(lane) != 0u1:
                result = result._insert(lane, Vec[T, N]._load_lane(data + offset, lane))
        return result

    @llvm
    def _store_lane(data: Ptr[T], index: int, value: T) -> None:
        %address = getelementptr {=T}, ptr %data, i64 %index
        store {=T} %value, ptr %address, align 1
        ret {} zeroinitializer

    @llvm
    def _store_packed(self, data: Ptr[T], ALIGNMENT: Literal[int]) -> None:
        store <{=N} x {=T}> %self, ptr %data, align {=ALIGNMENT}
        ret {} zeroinitializer

    @llvm
    def _masked_store(self, data: Ptr[T], mask: Vec[u1, N], ALIGNMENT: Literal[int]) -> None:
        declare void @llvm.masked.store.v{=N}{=T}.p0(<{=N} x {=T}>, ptr, i32, <{=N} x i1>)
        call void @llvm.masked.store.v{=N}{=T}.p0(<{=N} x {=T}> %self, ptr %data, i32 {=ALIGNMENT}, <{=N} x i1> %mask)
        ret {} zeroinitializer

    def store(self, data: Ptr[T], offset: int = 0, alignment: Literal[int] = 1, mask=NoneType()):
        Vec[T, N]._check_alignment(alignment)
        active = Vec[T, N]._memory_mask(mask)
        if Vec[T, N]._packed_layout():
            if mask is None:
                self._store_packed(data + offset, alignment)
            else:
                self._masked_store(data + offset, active, alignment)
        else:
            for lane in static.range(N):
                if active._extract(lane) != 0u1:
                    Vec[T, N]._store_lane(data + offset, lane, self._extract(lane))

    @pure
    @llvm
    def _gather(data: Ptr[T], indices: Vec[int, N], mask: Vec[u1, N], passthrough: Vec[T, N], ALIGNMENT: Literal[int]) -> Vec[T, N]:
        declare <{=N} x {=T}> @llvm.masked.gather.v{=N}{=T}.v{=N}p0(<{=N} x ptr>, i32, <{=N} x i1>, <{=N} x {=T}>)
        %addresses = getelementptr {=T}, ptr %data, <{=N} x i64> %indices
        %result = call <{=N} x {=T}> @llvm.masked.gather.v{=N}{=T}.v{=N}p0(<{=N} x ptr> %addresses, i32 {=ALIGNMENT}, <{=N} x i1> %mask, <{=N} x {=T}> %passthrough)
        ret <{=N} x {=T}> %result

    def gather(data: Ptr[T], indices: Vec[int, N], alignment: Literal[int] = 1, mask=NoneType(), passthrough=NoneType()) -> Vec[T, N]:
        Vec[T, N]._check_alignment(alignment)
        active = Vec[T, N]._memory_mask(mask)
        result = Vec[T, N](T(0)) if passthrough is None else Vec[T, N](passthrough)
        if Vec[T, N]._packed_layout():
            return Vec[T, N]._gather(data, indices, active, result, alignment)
        for lane in static.range(N):
            if active._extract(lane) != 0u1:
                result = result._insert(lane, Vec[T, N]._load_lane(data, indices._extract(lane)))
        return result

    @llvm
    def _scatter(self, data: Ptr[T], indices: Vec[int, N], mask: Vec[u1, N], ALIGNMENT: Literal[int]) -> None:
        declare void @llvm.masked.scatter.v{=N}{=T}.v{=N}p0(<{=N} x {=T}>, <{=N} x ptr>, i32, <{=N} x i1>)
        %addresses = getelementptr {=T}, ptr %data, <{=N} x i64> %indices
        call void @llvm.masked.scatter.v{=N}{=T}.v{=N}p0(<{=N} x {=T}> %self, <{=N} x ptr> %addresses, i32 {=ALIGNMENT}, <{=N} x i1> %mask)
        ret {} zeroinitializer

    def scatter(self, data: Ptr[T], indices: Vec[int, N], alignment: Literal[int] = 1, mask=NoneType()):
        Vec[T, N]._check_alignment(alignment)
        active = Vec[T, N]._memory_mask(mask)
        if Vec[T, N]._packed_layout():
            self._scatter(data, indices, active, alignment)
        else:
            for lane in static.range(N):
                if active._extract(lane) != 0u1:
                    Vec[T, N]._store_lane(data, indices._extract(lane), self._extract(lane))

    def __new__(x, check: Literal[bool] = True) -> Vec[T, N]:
        if Vec._is_valid(x):
            return Vec[T, N]._set(x)
        if isinstance(x, Ptr) and Vec._is_valid(x.T):
            return Vec[T, N]._load(x)
        if isinstance(x, str) and (
            isinstance(T, i8) or isinstance(T, u8)
        ):
            return Vec[T, N](x, 0, check=check)
        if isinstance(x, bytes) and (
            isinstance(T, i8) or isinstance(T, u8)
        ):
            if check:
                Vec[T, N]._check_bounds(len(x), 0)
            return Vec[T, N]._load(x._ptr)
        if isinstance(x, List) and Vec._is_valid(x.T):
            if not isinstance(x.T, T):
                compile_error("SIMD list element type must match vector element type")
            if check:
                Vec[T, N]._check_bounds(len(x), 0)
            return Vec[T, N]._load(x._ptr)
        if isinstance(x, Vec) and N == x.N:
            return x.cast(T)
        compile_error("invalid SIMD vector constructor")

    def __new__(x: str, offset: int = 0, check: Literal[bool] = True) -> Vec[T, N]:
        if not (isinstance(T, i8) or isinstance(T, u8)):
            compile_error("SIMD string loads require i8 or u8 elements")
        if x._is_ascii():
            if check:
                Vec[T, N]._check_bounds(len(x), offset)
            return Vec[T, N]._load(x._ptr + offset)
        return Vec[T, N](x.encode(), offset, check=check)

    def __new__(x: bytes, offset: int = 0, check: Literal[bool] = True) -> Vec[T, N]:
        if not (isinstance(T, i8) or isinstance(T, u8)):
            compile_error("SIMD byte loads require i8 or u8 elements")
        if check:
            Vec[T, N]._check_bounds(len(x), offset)
        return Vec[T, N]._load(x._ptr + offset)

    def __new__(x: List[T], offset: int = 0, check: Literal[bool] = True) -> Vec[T, N]:
        if check:
            Vec[T, N]._check_bounds(len(x), offset)
        return Vec[T, N]._load(x._ptr + offset)

    @pure
    @llvm
    def _zext(self: Vec[T, N], T2: type) -> Vec[T2, N]:
        %0 = zext <{=N} x {=T}> %self to <{=N} x {=T2}>
        ret <{=N} x {=T2}> %0

    @pure
    @llvm
    def _sext(self: Vec[T, N], T2: type) -> Vec[T2, N]:
        %0 = sext <{=N} x {=T}> %self to <{=N} x {=T2}>
        ret <{=N} x {=T2}> %0

    @pure
    @llvm
    def _uitofp(self: Vec[T, N], T2: type) -> Vec[T2, N]:
        %0 = uitofp <{=N} x {=T}> %self to <{=N} x {=T2}>
        ret <{=N} x {=T2}> %0

    @pure
    @llvm
    def _sitofp(self: Vec[T, N], T2: type) -> Vec[T2, N]:
        %0 = sitofp <{=N} x {=T}> %self to <{=N} x {=T2}>
        ret <{=N} x {=T2}> %0

    @pure
    @llvm
    def _fpext(self: Vec[T, N], T2: type) -> Vec[T2, N]:
        %0 = fpext <{=N} x {=T}> %self to <{=N} x {=T2}>
        ret <{=N} x {=T2}> %0

    @pure
    @llvm
    def _trunc(self: Vec[T, N], T2: type) -> Vec[T2, N]:
        %0 = trunc <{=N} x {=T}> %self to <{=N} x {=T2}>
        ret <{=N} x {=T2}> %0

    @pure
    @llvm
    def _fptrunc(self: Vec[T, N], T2: type) -> Vec[T2, N]:
        %0 = fptrunc <{=N} x {=T}> %self to <{=N} x {=T2}>
        ret <{=N} x {=T2}> %0

    @pure
    @llvm
    def _fptoui(self: Vec[T, N], T2: type) -> Vec[T2, N]:
        %0 = fptoui <{=N} x {=T}> %self to <{=N} x {=T2}>
        ret <{=N} x {=T2}> %0

    @pure
    @llvm
    def _fptosi(self: Vec[T, N], T2: type) -> Vec[T2, N]:
        %0 = fptosi <{=N} x {=T}> %self to <{=N} x {=T2}>
        ret <{=N} x {=T2}> %0

    @pure
    @llvm
    def _bitcast(self: Vec[T, N], T2: type) -> Vec[T2, N]:
        %0 = bitcast <{=N} x {=T}> %self to <{=N} x {=T2}>
        ret <{=N} x {=T2}> %0

    def cast(self, T2: type) -> Vec[T2, N]:
        if not Vec._is_valid(T2):
            compile_error("invalid cast")
        if isinstance(T, T2):
            return self
        if Vec._is_sint(T) and Vec._is_sint(T2):
            return self._sext(T2) if Vec._sizeof(T) < Vec._sizeof(T2) \
              else self._trunc(T2)
        if Vec._is_uint(T) and Vec._is_uint(T2):
            return self._zext(T2) if Vec._sizeof(T) < Vec._sizeof(T2) \
              else self._trunc(T2)
        if Vec._is_uint(T) and Vec._is_sint(T2):
            if Vec._sizeof(T) != Vec._sizeof(T2):
                return self.cast(UInt[Vec._sizeof(T2)])._bitcast(T2)
            return self._bitcast(T2)
        if Vec._is_sint(T) and Vec._is_uint(T2):
            if Vec._sizeof(T) != Vec._sizeof(T2):
                return self.cast(Int[Vec._sizeof(T2)])._bitcast(T2)
            return self._bitcast(T2)
        if Vec._is_float(T) and Vec._is_float(T2) and Vec._sizeof(T) == Vec._sizeof(T2):
            return self.cast(float32).cast(T2)
        if Vec._is_float(T) and Vec._is_float(T2):
            return self._fpext(T2) if Vec._sizeof(T) < Vec._sizeof(T2) \
              else self._fptrunc(T2)
        if Vec._is_float(T) and Vec._is_int(T2):
            return self._fptoui(T2) if Vec._is_uint(T2) else self._fptosi(T2)
        if Vec._is_int(T) and Vec._is_float(T2):
            return self._uitofp(T2) if Vec._is_uint(T) else self._sitofp(T2)
        compile_error("invalid cast")

    @pure
    @llvm
    def cast_ptr(ptr: Ptr[T], T: type, T2: type) -> Ptr[T2]:
        ret ptr %ptr

    def __copy__(self) -> Vec[T, N]:
        return self

    def __len__(self) -> int:
        return N

    @pure
    @llvm
    def _fneg(self: Vec[T, N]) -> Vec[T, N]:
        %result = fneg <{=N} x {=T}> %self
        ret <{=N} x {=T}> %result

    def __neg__(self) -> Vec[T, N]:
        if Vec._is_float(T):
            return self._fneg()
        return Vec[T, N](T(0)) - self

    @pure
    @llvm
    def _extract(self, n: Literal[int]) -> T:
        %0 = extractelement <{=N} x {=T}> %self, i32 {=n}
        ret {=T} %0

    @pure
    @llvm
    def _extract_dynamic(self, index: int) -> T:
        %result = extractelement <{=N} x {=T}> %self, i64 %index
        ret {=T} %result

    @pure
    @llvm
    def _insert_dynamic(self, index: int, value: T) -> Vec[T, N]:
        %result = insertelement <{=N} x {=T}> %self, {=T} %value, i64 %index
        ret <{=N} x {=T}> %result

    def _checked_index(index: int, check: Literal[bool] = True) -> int:
        if check and (index < -N or index >= N):
            raise IndexError("SIMD lane index out of range")
        return index + N if index < 0 else index

    def extract(self, index: int, check: Literal[bool] = True) -> T:
        return self._extract_dynamic(Vec[T, N]._checked_index(index, check))

    def insert(self, index: int, value: T, check: Literal[bool] = True) -> Vec[T, N]:
        return self._insert_dynamic(Vec[T, N]._checked_index(index, check), value)

    def _shuffle_vector(self, indices: Vec[int, WIDTH], other: Vec[T, N], WIDTH: Literal[int], check: Literal[bool] = True) -> Vec[T, WIDTH]:
        if check and indices.cast(u64).max() >= u64(2 * N):
            raise IndexError("SIMD shuffle index out of range")
        result = Vec[T, WIDTH](T(0))
        for lane in static.range(WIDTH):
            index = indices._extract(lane)
            value = self._extract_dynamic(index) if index < N else other._extract_dynamic(index - N)
            result = result._insert(lane, value)
        return result

    def _shuffle_vector(self, indices: Vec[int, WIDTH], WIDTH: Literal[int], check: Literal[bool] = True) -> Vec[T, WIDTH]:
        if check and indices.cast(u64).max() >= u64(N):
            raise IndexError("SIMD shuffle index out of range")
        result = Vec[T, WIDTH](T(0))
        for lane in static.range(WIDTH):
            result = result._insert(lane, self._extract_dynamic(indices._extract(lane)))
        return result

    def shuffle(self, indices, other=NoneType(), check: Literal[bool] = True):
        if isinstance(indices, Vec):
            if other is None:
                return self._shuffle_vector(indices, check=check)
            return self._shuffle_vector(indices, other, check=check)
        if not isinstance(indices, Tuple):
            compile_error("SIMD shuffle requires tuple or integer-vector indices")
        if static.len(indices) == 0:
            compile_error("SIMD shuffle requires at least one index")
        selectors = Vec[int, static.len(indices)](0)
        for lane in static.range(static.len(indices)):
            if not isinstance(indices[lane], int):
                compile_error("SIMD shuffle tuple indices must be integers")
            selectors = selectors._insert(lane, indices[lane])
        if other is None:
            return self._shuffle_vector(selectors, check=check)
        return self._shuffle_vector(selectors, other, check=check)

    def interleave(self, other: Vec[T, N]) -> Vec[T, 2 * N]:
        result = Vec[T, 2 * N](T(0))
        for lane in static.range(N):
            result = result._insert(2 * lane, self._extract(lane))
            result = result._insert(2 * lane + 1, other._extract(lane))
        return result

    def __getitem__(self, index: int) -> T:
        return self.extract(index)

    def __getitem__(self, n: Literal[int]) -> T:
        if n < -N or n >= N:
            compile_error("SIMD lane index out of range")
        return self._extract(n + N if n < 0 else n)

    def __repr__(self):
        return f"<{','.join(repr(i) for i in self.scatter())}>"

    @pure
    @llvm
    def _eq(self: Vec[T, N], other: Vec[T, N]) -> Vec[u1, N]:
        %0 = icmp eq <{=N} x {=T}> %self, %other
        ret <{=N} x i1> %0

    @pure
    @llvm
    def _feq(self: Vec[T, N], other: Vec[T, N]) -> Vec[u1, N]:
        %result = fcmp oeq <{=N} x {=T}> %self, %other
        ret <{=N} x i1> %result

    def __eq__(self, other: Vec[T, N]) -> Vec[u1, N]:
        if Vec._is_float(T):
            return self._feq(other)
        return self._eq(other)

    def __eq__(self, other: T) -> Vec[u1, N]:
        return self == Vec[T, N](other)

    def __ne__(self: Vec[T, N], other: Vec[T, N]) -> Vec[u1, N]:
        return (self == other) ^ Vec[u1, N](1u1)

    def __ne__(self, other: T) -> Vec[u1, N]:
        return self != Vec[T, N](other)

    @pure
    @llvm
    def _and(self: Vec[T, N], other: Vec[T, N]) -> Vec[T, N]:
        %0 = and <{=N} x {=T}> %self, %other
        ret <{=N} x {=T}> %0

    def __and__(self, other: Vec[T, N]) -> Vec[T, N]:
        if Vec._is_float(T):
            return self._as_int()._and(other._as_int())._bitcast(T)
        return self._and(other)

    @pure
    @llvm
    def _or(self: Vec[T, N], other: Vec[T, N]) -> Vec[T, N]:
        %0 = or <{=N} x {=T}> %self, %other
        ret <{=N} x {=T}> %0

    def __or__(self, other: Vec[T, N]) -> Vec[T, N]:
        if Vec._is_float(T):
            return self._as_int()._or(other._as_int())._bitcast(T)
        return self._or(other)

    @pure
    @llvm
    def _xor(self: Vec[T, N], other: Vec[T, N]) -> Vec[T, N]:
        %0 = xor <{=N} x {=T}> %self, %other
        ret <{=N} x {=T}> %0

    def __xor__(self, other: Vec[T, N]) -> Vec[T, N]:
        if Vec._is_float(T):
            return self._as_int()._xor(other._as_int())._bitcast(T)
        return self._xor(other)

    def _as_int(self):
        return self._bitcast(UInt[Vec._sizeof(T)])

    def __and__(self, other: T) -> Vec[T, N]:
        return self & Vec[T, N](other)

    def __rand__(self, other: T) -> Vec[T, N]:
        return self & other

    def __or__(self, other: T) -> Vec[T, N]:
        return self | Vec[T, N](other)

    def __ror__(self, other: T) -> Vec[T, N]:
        return self | other

    def __xor__(self, other: T) -> Vec[T, N]:
        return self ^ Vec[T, N](other)

    def __rxor__(self, other: T) -> Vec[T, N]:
        return self ^ other

    def __invert__(self) -> Vec[T, N]:
        return self.bitflip()

    @pure
    @llvm
    def _lsh(self: Vec[T, N], other: Vec[T, N]) -> Vec[T, N]:
        %0 = shl <{=N} x {=T}> %self, %other
        ret <{=N} x {=T}> %0

    @pure
    @llvm
    def _lshuffle(self: Vec[T, N], I: Literal[int]) -> Vec[T, N]:
        %0 = shufflevector <{=N} x {=T}> %self, <{=N} x {=T}> zeroinitializer, \
            <{=N} x i32> < {=static.loop_string(I, N, "i32 %%", ", ")}, \
                           {=static.loop_string(N, N + I, "i32 %%", ", ")} >
        ret <{=N} x {=T}> %0

    def lshift(self, other: Vec[T, N], check: Literal[bool] = True) -> Vec[T, N]:
        self._check_shift(other, check)
        return self._lsh(other)

    def lshift(self, other: T, check: Literal[bool] = True) -> Vec[T, N]:
        return self.lshift(Vec[T, N](other), check=check)

    def lshift(self, other: int, check: Literal[bool] = True) -> Vec[T, N]:
        if not Vec._is_int(T):
            compile_error("bit shifts require an integer type")
        if check and __py_numerics__ and (other < 0 or other >= Vec._sizeof(T)):
            raise ValueError("SIMD bit shift count out of range")
        return self._lsh(Vec[T, N](T(other)))

    def __lshift__(self, other: Vec[T, N]) -> Vec[T, N]:
        return self.lshift(other)

    def __lshift__(self, other: T) -> Vec[T, N]:
        return self.lshift(other)

    def __lshift__(self, other: int) -> Vec[T, N]:
        return self.lshift(other)

    def __rlshift__(self, other: T) -> Vec[T, N]:
        return Vec[T, N](other) << self

    def lsh(self, other: Literal[int]) -> Vec[T, N]:
        if other < 0 or other > N:
            compile_error("SIMD lane shift out of range")
        if other == 0:
            return self
        if other == N:
            return Vec[T, N](T(0))
        return self._lshuffle(other)

    @pure
    @llvm
    def _rsh(self: Vec[T, N], other: Vec[T, N], OP: Literal[str]) -> Vec[T, N]:
        %0 = {=OP} <{=N} x {=T}> %self, %other
        ret <{=N} x {=T}> %0

    @pure
    @llvm
    def _rshuffle(self: Vec[T, N], I: Literal[int]) -> Vec[T, N]:
        %0 = shufflevector <{=N} x {=T}> %self, <{=N} x {=T}> zeroinitializer, \
            <{=N} x i32> < {=static.loop_string(N, N + I, "i32 %%", ", ")}, \
                           {=static.loop_string(0, N - I, "i32 %%", ", ")} >
        ret <{=N} x {=T}> %0

    def rshift(self, other: Vec[T, N], check: Literal[bool] = True) -> Vec[T, N]:
        self._check_shift(other, check)
        return self._rsh(other, 'ashr' if Vec._is_sint(T) else 'lshr')

    def rshift(self, other: T, check: Literal[bool] = True) -> Vec[T, N]:
        return self.rshift(Vec[T, N](other), check=check)

    def rshift(self, other: int, check: Literal[bool] = True) -> Vec[T, N]:
        if not Vec._is_int(T):
            compile_error("bit shifts require an integer type")
        if check and __py_numerics__ and (other < 0 or other >= Vec._sizeof(T)):
            raise ValueError("SIMD bit shift count out of range")
        return self._rsh(Vec[T, N](T(other)), 'ashr' if Vec._is_sint(T) else 'lshr')

    def __rshift__(self, other: Vec[T, N]) -> Vec[T, N]:
        return self.rshift(other)

    def __rshift__(self, other: T) -> Vec[T, N]:
        return self.rshift(other)

    def __rshift__(self, other: int) -> Vec[T, N]:
        return self.rshift(other)

    def __rrshift__(self, other: T) -> Vec[T, N]:
        return Vec[T, N](other) >> self

    def rsh(self, other: Literal[int]) -> Vec[T, N]:
        if other < 0 or other > N:
            compile_error("SIMD lane shift out of range")
        if other == 0:
            return self
        if other == N:
            return Vec[T, N](T(0))
        return self._rshuffle(other)

    @pure
    @llvm
    def _add(self: Vec[T, N], other: Vec[T, N]) -> Vec[T, N]:
        %0 = add <{=N} x {=T}> %self, %other
        ret <{=N} x {=T}> %0

