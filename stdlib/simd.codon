        %0 = fmul <{=N} x {=T}> %self, %other
        ret <{=N} x {=T}> %0

    def __mul__(self, other: Vec[T, N]) -> Vec[T, N]:
        if Vec._is_float(T):
            return self._fmul(other)
        return self._mul(other)

    def __mul__(self, other: T) -> Vec[T, N]:
        return self * Vec[T, N](other)

    def __rmul__(self, other: T) -> Vec[T, N]:
        return self * other

    @pure
    @llvm
    def _sdiv(self: Vec[T, N], other: Vec[T, N]) -> Vec[T, N]:
        %0 = sdiv <{=N} x {=T}> %self, %other
        ret <{=N} x {=T}> %0

    @pure
    @llvm
    def _udiv(self: Vec[T, N], other: Vec[T, N]) -> Vec[T, N]:
        %0 = udiv <{=N} x {=T}> %self, %other
        ret <{=N} x {=T}> %0

    @pure
    @llvm
    def _fdiv(self: Vec[T, N], other: Vec[T, N]) -> Vec[T, N]:
        %0 = fdiv <{=N} x {=T}> %self, %other
        ret <{=N} x {=T}> %0

    def __truediv__(self, other: Vec[T, N]) -> Vec[T, N]:
        if not Vec._is_float(T):
            compile_error("true division requires a float type")
        return self._fdiv(other)

    def __truediv__(self, other: T) -> Vec[T, N]:
        return self / Vec[T, N](other)

    def __rtruediv__(self, other: T) -> Vec[T, N]:
        return Vec[T, N](other) / self

    @pure
    @llvm
    def _any(self: Vec[u1, N]) -> bool:
        declare i1 @llvm.vector.reduce.or.v{=N}i1(<{=N} x i1>)
        %result = call i1 @llvm.vector.reduce.or.v{=N}i1(<{=N} x i1> %self)
        %extended = zext i1 %result to i8
        ret i8 %extended

    def any(self) -> bool:
        return (self != T(0))._any()

    def all(self) -> bool:
        return not (self == T(0))._any()

    def count(self) -> int:
        return (self != T(0)).cast(int).sum()

    def to_bits(self) -> UInt[N]:
        mask = self != T(0)
        bits = UInt[N](0)
        for index in static.range(N):
            bits |= UInt[N](mask._extract(index)) << index
        return bits

    def from_bits(bits: UInt[N]) -> Vec[T, N]:
        if not isinstance(T, u1):
            compile_error("from_bits requires u1 elements")
        result = Vec[T, N](T(0))
        for index in static.range(N):
            result = result._insert(index, T(bits >> index))
        return result

    def _check_shift(self, other: Vec[T, N], check: Literal[bool] = True):
        if not Vec._is_int(T):
            compile_error("bit shifts require an integer type")
        if check and __py_numerics__:
            if other._ge(Vec[T, N](T(Vec._sizeof(T))), 'u')._any():
                raise ValueError("SIMD bit shift count out of range")

    def _check_divisor(self, other: Vec[T, N], check: Literal[bool] = True):
        if not Vec._is_int(T):
            compile_error("integer division requires an integer type")
        if check and __py_numerics__:
            if (other == T(0))._any():
                raise ZeroDivisionError("integer division or modulo by zero")
            if Vec._is_sint(T):
                minimum = T(1) << (Vec._sizeof(T) - 1)
                if ((self == minimum) & (other == T(-1)))._any():
                    raise OverflowError("SIMD integer division overflow")

    def floordiv(self, other: Vec[T, N], check: Literal[bool] = True) -> Vec[T, N]:
        self._check_divisor(other, check)
        if Vec._is_uint(T):
            return self._udiv(other)
        quotient = self._sdiv(other)
        if __py_numerics__:
            remainder = self._mod(other, 's')
            adjust = (remainder != T(0)) & ((self ^ other) < T(0))
            return quotient - adjust.cast(T)
        return quotient

    def floordiv(self, other: T, check: Literal[bool] = True) -> Vec[T, N]:
        return self.floordiv(Vec[T, N](other), check=check)

    def __floordiv__(self, other: Vec[T, N]) -> Vec[T, N]:
        return self.floordiv(other)

    def __floordiv__(self, other: T) -> Vec[T, N]:
        return self.floordiv(other)

    def __rfloordiv__(self, other: T) -> Vec[T, N]:
        return Vec[T, N](other) // self

    @pure
    @llvm
    def _mod(self: Vec[T, N], other: Vec[T, N], PREFIX: Literal[str]) -> Vec[T, N]:
        %0 = {=PREFIX}rem <{=N} x {=T}> %self, %other
        ret <{=N} x {=T}> %0

    def mod(self, other: Vec[T, N], check: Literal[bool] = True) -> Vec[T, N]:
        self._check_divisor(other, check)
        remainder = self._mod(other, Vec._int_prefix(T))
        if Vec._is_sint(T) and __py_numerics__:
            adjust = (remainder != T(0)) & ((self ^ other) < T(0))
            return remainder + other.mask(Vec[T, N](T(0)), adjust)
        return remainder

    def mod(self, other: T, check: Literal[bool] = True) -> Vec[T, N]:
        return self.mod(Vec[T, N](other), check=check)

    def __mod__(self, other: Vec[T, N]) -> Vec[T, N]:
        return self.mod(other)

    def __mod__(self, other: T) -> Vec[T, N]:
        return self.mod(other)

    def __rmod__(self, other: T) -> Vec[T, N]:
        return Vec[T, N](other) % self

