    @pure
    @llvm
    def _min(self: Vec[T, N], other: Vec[T, N], PREFIX: Literal[str]) -> Vec[T, N]:
        declare <{=N} x {=T}> @llvm.{=PREFIX}min.v{=N}{=T}(<{=N} x {=T}>, <{=N} x {=T}>)
        %0 = call <{=N} x {=T}> @llvm.{=PREFIX}min.v{=N}{=T}(<{=N} x {=T}> %self, <{=N} x {=T}> %other)
        ret <{=N} x {=T}> %0

    def min(self, other: Vec[T, N]) -> Vec[T, N]:
        if Vec._is_int(T):
            return self._min(other, Vec._int_prefix(T))
        if isinstance(T, float128):
            compile_error("SIMD min/max do not support float128")
        return self._float_minmax(other, 'minimum')

    def min(self, other: T) -> Vec[T, N]:
        return self.min(Vec[T, N](other))

    def min(self) -> T:
        if Vec._is_int(T):
            return self._reduce(Vec._int_prefix(T) + 'min')
        if isinstance(T, float128):
            compile_error("SIMD min/max do not support float128")
        return self._reduce('fminimum')

    @pure
    @llvm
    def _max(self: Vec[T, N], other: Vec[T, N], PREFIX: Literal[str]) -> Vec[T, N]:
        declare <{=N} x {=T}> @llvm.{=PREFIX}max.v{=N}{=T}(<{=N} x {=T}>, <{=N} x {=T}>)
        %0 = call <{=N} x {=T}> @llvm.{=PREFIX}max.v{=N}{=T}(<{=N} x {=T}> %self, <{=N} x {=T}> %other)
        ret <{=N} x {=T}> %0

    def max(self, other: Vec[T, N]) -> Vec[T, N]:
        if Vec._is_int(T):
            return self._max(other, Vec._int_prefix(T))
        if isinstance(T, float128):
            compile_error("SIMD min/max do not support float128")
        return self._float_minmax(other, 'maximum')

    def max(self, other: T) -> Vec[T, N]:
        return self.max(Vec[T, N](other))

    def max(self) -> T:
        if Vec._is_int(T):
            return self._reduce(Vec._int_prefix(T) + 'max')
        if isinstance(T, float128):
            compile_error("SIMD min/max do not support float128")
        return self._reduce('fmaximum')

    @pure
    @llvm
    def _float_minmax(self, other: Vec[T, N], OP: Literal[str]) -> Vec[T, N]:
        declare <{=N} x {=T}> @llvm.{=OP}.v{=N}{=T}(<{=N} x {=T}>, <{=N} x {=T}>)
        %result = call <{=N} x {=T}> @llvm.{=OP}.v{=N}{=T}(<{=N} x {=T}> %self, <{=N} x {=T}> %other)
        ret <{=N} x {=T}> %result

    @pure
    @llvm
    def _mask(self: Vec[T, N], mask: Vec[u1, N], other: Vec[T, N]) -> Vec[T, N]:
        %0 = select <{=N} x i1> %mask, <{=N} x {=T}> %self, <{=N} x {=T}> %other
        ret <{=N} x {=T}> %0

    def mask(self, other: Vec[T, N], mask) -> Vec[T, N]:
        return self._mask(mask.cast(u1), other)

    @pure
    @llvm
    def _add_overflow(self: Vec[T, N], other: Vec[T, N], PREFIX: Literal[str]) -> Tuple[Vec[T, N], Vec[u1, N]]:
        declare {<{=N} x {=T}>, <{=N} x i1>} @llvm.{=PREFIX}add.with.overflow.v{=N}{=T}(<{=N} x {=T}>, <{=N} x {=T}>)
        %0 = call {<{=N} x {=T}>, <{=N} x i1>} @llvm.{=PREFIX}add.with.overflow.v{=N}{=T}(<{=N} x {=T}> %self, <{=N} x {=T}> %other)
        ret {<{=N} x {=T}>, <{=N} x i1>} %0

    def add(self, other: Vec[T, N], overflow: Literal[bool] = False):
        if overflow:
            if not Vec._is_int(T):
                compile_error("overflow reporting requires an integer type")
            return self._add_overflow(other, Vec._int_prefix(T))
        else:
            return self + other

    @pure
    @llvm
    def _sub_overflow(self: Vec[T, N], other: Vec[T, N], PREFIX: Literal[str]) -> Tuple[Vec[T, N], Vec[u1, N]]:
        declare {<{=N} x {=T}>, <{=N} x i1>} @llvm.{=PREFIX}sub.with.overflow.v{=N}{=T}(<{=N} x {=T}>, <{=N} x {=T}>)
        %0 = call {<{=N} x {=T}>, <{=N} x i1>} @llvm.{=PREFIX}sub.with.overflow.v{=N}{=T}(<{=N} x {=T}> %self, <{=N} x {=T}> %other)
        ret {<{=N} x {=T}>, <{=N} x i1>} %0

    def sub(self, other: Vec[T, N], overflow: Literal[bool] = False):
        if overflow:
            if not Vec._is_int(T):
                compile_error("overflow reporting requires an integer type")
            return self._sub_overflow(other, Vec._int_prefix(T))
        else:
            return self - other

    @pure
    @llvm
    def _sum(self: Vec[T, N]) -> T:
        declare {=T} @llvm.vector.reduce.add.v{=N}{=T}(<{=N} x {=T}>)
        %0 = call {=T} @llvm.vector.reduce.add.v{=N}{=T}(<{=N} x {=T}> %self)
        ret {=T} %0

    @pure
    @llvm
    def _fsum(self: Vec[T, N], initial: T, S: Literal[int]) -> T:
        declare {=T} @llvm.vector.reduce.fadd.v{=N}f{=S}({=T}, <{=N} x {=T}>)
        %0 = call {=T} @llvm.vector.reduce.fadd.v{=N}f{=S}({=T} %initial, <{=N} x {=T}> %self)
        ret {=T} %0

    def sum(self) -> T:
        if Vec._is_float(T):
            return self._fsum(T(0), S=Vec._sizeof(T))
        return self._sum()

    @pure
    @llvm
    def _reduce(self, OP: Literal[str]) -> T:
        declare {=T} @llvm.vector.reduce.{=OP}.v{=N}{=T}(<{=N} x {=T}>)
        %result = call {=T} @llvm.vector.reduce.{=OP}.v{=N}{=T}(<{=N} x {=T}> %self)
        ret {=T} %result

    @pure
    @llvm
    def _fprod(self, initial: T) -> T:
        declare {=T} @llvm.vector.reduce.fmul.v{=N}{=T}({=T}, <{=N} x {=T}>)
        %result = call {=T} @llvm.vector.reduce.fmul.v{=N}{=T}({=T} %initial, <{=N} x {=T}> %self)
        ret {=T} %result

    def prod(self) -> T:
        if Vec._is_float(T):
            return self._fprod(T(1))
        return self._reduce('mul')

    @pure
    @llvm
    def _fma(self, other: Vec[T, N], addend: Vec[T, N]) -> Vec[T, N]:
        declare <{=N} x {=T}> @llvm.fma.v{=N}{=T}(<{=N} x {=T}>, <{=N} x {=T}>, <{=N} x {=T}>)
        %result = call <{=N} x {=T}> @llvm.fma.v{=N}{=T}(<{=N} x {=T}> %self, <{=N} x {=T}> %other, <{=N} x {=T}> %addend)
        ret <{=N} x {=T}> %result

    def fma(self, other, addend) -> Vec[T, N]:
        if not Vec._is_float(T):
            compile_error("fma requires a floating-point type")
        if isinstance(T, float128):
            compile_error("SIMD fma does not support float128")
        return self._fma(Vec[T, N](other), Vec[T, N](addend))

    @pure
    @llvm
    def _float_unary(self, OP: Literal[str]) -> Vec[T, N]:
        declare <{=N} x {=T}> @llvm.{=OP}.v{=N}{=T}(<{=N} x {=T}>)
        %result = call <{=N} x {=T}> @llvm.{=OP}.v{=N}{=T}(<{=N} x {=T}> %self)
        ret <{=N} x {=T}> %result

    def _math_unary(self, OP: Literal[str]) -> Vec[T, N]:
        if not Vec._is_float(T):
            compile_error("vector type must be a float")
        if isinstance(T, float128):
            compile_error("SIMD math intrinsics do not support float128")
        if isinstance(T, float16) or isinstance(T, bfloat16):
            return self.cast(float32)._float_unary(OP).cast(T)
        return self._float_unary(OP)

    def exp(self) -> Vec[T, N]:
        return self._math_unary('exp')

    def exp2(self) -> Vec[T, N]:
        return self._math_unary('exp2')

    def log2(self) -> Vec[T, N]:
        return self._math_unary('log2')

    def log10(self) -> Vec[T, N]:
        return self._math_unary('log10')

    def floor(self) -> Vec[T, N]:
        return self._math_unary('floor')

    def ceil(self) -> Vec[T, N]:
        return self._math_unary('ceil')

    def trunc(self) -> Vec[T, N]:
        return self._math_unary('trunc')

    def round(self) -> Vec[T, N]:
        return self._math_unary('roundeven')

    @pure
    @llvm
    def _fpclass(self, MASK: Literal[int]) -> Vec[u1, N]:
        declare <{=N} x i1> @llvm.is.fpclass.v{=N}{=T}(<{=N} x {=T}>, i32)
        %result = call <{=N} x i1> @llvm.is.fpclass.v{=N}{=T}(<{=N} x {=T}> %self, i32 {=MASK})
        ret <{=N} x i1> %result

    def _classify(self, MASK: Literal[int]) -> Vec[u1, N]:
        if not Vec._is_float(T):
            compile_error("classification requires a floating-point type")
        return self._fpclass(MASK)

    def isnan(self) -> Vec[u1, N]:
        NAN_CLASSES: Literal[int] = 3
        return self._classify(NAN_CLASSES)

    def isinf(self) -> Vec[u1, N]:
        INFINITY_CLASSES: Literal[int] = 516
        return self._classify(INFINITY_CLASSES)

    def isfinite(self) -> Vec[u1, N]:
        NONFINITE_CLASSES: Literal[int] = 519
        return ~self._classify(NONFINITE_CLASSES)

    def signbit(self) -> Vec[u1, N]:
        if not Vec._is_float(T):
            compile_error("classification requires a floating-point type")
        return (self._as_int() >> (Vec._sizeof(T) - 1)).cast(u1)

    # Utilities
    def scatter(self: Vec[T, N]) -> List[T]:
        return [self[i] for i in static.range(N)]

    def bitflip(self) -> Vec[T, N]:
        if Vec._is_int(T):
            return self ^ Vec[T, N](T(-1))
        compile_error("vector type must be an integer")


@extend
class Ptr:
    @pure
    @derives
    @llvm
    def __getitem__(self: Ptr[Vec[S, M]], index: int, S: type, M: Literal[int]) -> Vec[S, M]:
        %address = getelementptr <{=M} x {=S}>, ptr %self, i64 %index
        %result = load <{=M} x {=S}>, ptr %address, align 1
        ret <{=M} x {=S}> %result

    @self_captures
    @llvm
    def __setitem__(self: Ptr[Vec[S, M]], index: int, what: Vec[S, M], S: type, M: Literal[int]) -> None:
        %address = getelementptr <{=M} x {=S}>, ptr %self, i64 %index
        store <{=M} x {=S}> %what, ptr %address, align 1
        ret {} zeroinitializer
