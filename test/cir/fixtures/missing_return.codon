
def error():
  raise ValueError("original")
def error_wrapper():
  error()
@export
def required(flag: bool) -> int:
  if flag:
    return 17
@export
def complete(flag: bool) -> int:
  if flag:
    return 17
  else:
    return 18
@export
def nullable(flag: bool) -> Optional[int]:
  if flag:
    return 17
@export
def nullable_union(flag: bool) -> Union[int, str, NoneType]:
  if flag:
    return "present"
@export
def optional_union(flag: bool) -> Optional[Union[int, str]]:
  if flag:
    return "present"
@export
def required_union(flag: bool) -> Union[int, str]:
  if flag:
    return "present"
@export
def nothing(flag: bool):
  if flag:
    print(flag)
@export
def calls_error(flag: bool) -> int:
  if flag:
    return 17
  error_wrapper()
@export
def caught_error() -> int:
  try:
    error_wrapper()
  except ValueError:
    pass
@export
def finally_returns(flag: bool) -> int:
  try:
    if flag:
      return 17
  finally:
    return 18
@export
def finally_breaks() -> int:
  while True:
    try:
      return 17
    finally:
      break
@export
def forever() -> int:
  while True:
    continue
def throwing_generator():
  error()
  yield 17
@export
def creates_generator() -> int:
  throwing_generator()
@export
def protected_return(flag: bool) -> int:
  try:
    if flag:
      error()
    return 17
  except ValueError:
    return 18
@export
def nonempty_loop() -> int:
  for index in range(1):
    return index
@export
def possibly_empty_loop(count: int) -> int:
  for index in range(count):
    return index
@export
def caught_return_expression() -> int:
  try:
    return int("bad")
  except ValueError:
    pass
@export
def complete_else(flag: bool) -> int:
  try:
    if flag:
      error()
  except ValueError:
    return 17
  else:
    return 18
