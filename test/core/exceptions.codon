@test
def test_native_hierarchy():
    assert IOError is OSError and EnvironmentError is OSError
    assert isinstance(FileNotFoundError("missing"), OSError)
    assert isinstance(BrokenPipeError("pipe"), ConnectionError)
    assert isinstance(UnicodeError("unicode"), ValueError)
    assert isinstance(RecursionError("recursion"), RuntimeError)
    assert not isinstance(KeyboardInterrupt(), Exception)
    assert not isinstance(GeneratorExit(), Exception)
    assert isinstance(OSError(2, "missing", "file"), FileNotFoundError)
    assert isinstance(OSError(13, "denied"), PermissionError)
    assert isinstance(OSError(17, "exists"), FileExistsError)
    assert not isinstance(FileNotFoundError(13, "explicit"), PermissionError)
    decoded = UnicodeDecodeError("utf-8", b"a\xff", 1, 2, "invalid start byte")
    assert isinstance(decoded, UnicodeError) and isinstance(decoded, ValueError)
    assert decoded.args == ("utf-8", b"a\xff", 1, 2, "invalid start byte")
    assert str(decoded) == "'utf-8' codec can't decode byte 0xff in position 1: invalid start byte"
    decoded.reason = "changed"
    assert decoded.args[-1] == "invalid start byte"
    try:
        raise decoded
    except ValueError as error:
        assert str(error).endswith(": changed")
        assert repr(error) == "UnicodeDecodeError('utf-8', b'a\\xff', 1, 2, 'invalid start byte')"
    encoded = UnicodeEncodeError("ascii", "\u00e9", 0, 1, "ordinal not in range(128)")
    assert str(encoded) == "'ascii' codec can't encode character '\\xe9' in position 0: ordinal not in range(128)"
    for encoding in ["utf-8", "utf-16-le", "ascii", "cp1252"]:
        value = "a" + chr(0xD800) + chr(0xD801) + "b"
        try:
            value.encode(encoding)
            assert False
        except UnicodeEncodeError as error:
            assert error.object == value and error.start == 1
            assert error.end == (2 if encoding == "utf-16-le" else 3)
    translated = UnicodeTranslateError("\u1234", 0, 1, "invalid")
    assert str(translated) == "can't translate character '\\u1234' in position 0: invalid"
    for raw in [b"a\xff", b"a\xe2\x82", b"a\xe2\x82b"]:
        try:
            raw.decode("utf-8")
            assert False
        except UnicodeDecodeError as error:
            assert error.encoding == "utf-8" and error.object == raw
            assert error.start == 1
            assert error.end == (2 if raw == b"a\xff" else 3)
            assert str(error) == error.message
    try:
        raise OSError(2, "missing", "file")
    except FileNotFoundError as error:
        assert error.errno == 2 and error.filename == "file"

test_native_hierarchy()

from internal.types.error import OSError as NativeOSError

class OSError:
    value: int

    def __init__(self, value: int):
        self.value = value

@test
def test_shadowed_oserror():
    shadowed = OSError(7)
    assert shadowed.value == 7
    assert isinstance(NativeOSError(2, "missing"), FileNotFoundError)
    assert isinstance(IOError(13, "denied"), PermissionError)
    assert isinstance(EnvironmentError(17, "exists"), FileExistsError)

test_shadowed_oserror()

class Exc1(Exception):
    def __init__(self, msg: str):
        super().__init__(msg)

    def show(self):
        print self.message

class Exc2(Exception):
    def __init__(self, msg: str):
        super().__init__(msg)

    def show(self):
        print self.message

class A(Exception):
    def __init__(self, msg: str):
        super().__init__(msg)

class B(Exception):
    def __init__(self, msg: str):
        super().__init__(msg)

class C(Exception):
    def __init__(self, msg: str):
        super().__init__(msg)

class D(Exception):
    def __init__(self, msg: str):
        super().__init__(msg)

class E(Exception):
    def __init__(self, msg: str):
        super().__init__(msg)

def foo1(x):
    if x:
        raise Exc1('e1')
    else:
        raise Exc2('e2')

def foo2(x):
    foo1(x)

def foo(x):
    foo2(x)

def square(x):
    return x * x

def bar(x):
    try:
        print 'try'
        foo(x)
        print 'error'
    except Exc1 as e:
        print 'catch Exc1 1'
        print e.message
        print 'catch Exc1 2'
    except Exc2 as e:
        print 'catch Exc2 1'
        print e.message
        print 'catch Exc2 2'
    finally:
        print 'finally'
    print 'done'

def baz(x):
    try:
        print 'try 1'
        square(x)
        print 'try 2'
    except Exc1 as e:
        print 'catch Exc1 1'
        print e.message
        print 'catch Exc1 2'
    except Exc2 as e:
        print 'catch Exc2 1'
        print e.message
        print 'catch Exc2 2'
    finally:
        print 'finally'
    print 'done'

def baz1(x):
    try:
        print 'try 1.1'
        foo(x)
        print 'try 1.2'
    except Exc1 as e:
        print 'catch Exc1 1.1'
        print e.message
        print 'catch Exc1 1.2'
    finally:
        print 'finally 1'
    print 'done 1'

def baz2(x):
    try:
        print 'try 2.1'
        baz1(x)
        print 'try 2.2'
    except:
        print 'catch Exc2'
    finally:
        print 'finally 2'
    print 'done 2'

def nest1(b):
    if b:
        raise C('C')
    else:
        raise E('E')

def nest2(b):
    try:
        try:
            try:
                try:
                    nest1(b)
                except A:
                    print 'A'
                finally:
                    print 'f A'
            except B:
                print 'B'
            finally:
                print 'f B'
        except C as c:
            print c.message
        finally:
            print 'f C'
    except D:
        print 'D'
    finally:
        print 'f D'

def nest3(b):
    try:
        nest2(b)
    except:
        print 'except'
    finally:
        print 'done'

def finally_return(x):
    try:
        try:
            return 'A'
        finally:
            if x < 5:
                return 'B'
    finally:
        if x > 10:
            return 'C'

def finally_return_void():
    try:
        try:
            print 'A'
            return
        finally:
            print 'B'
            return
    finally:
        print 'C'

def finally_break_continue1():
    try:
        for i in range(3):
            try:
                continue
            finally:
                print i
                continue
            print 'X'
    finally:
        print 'f'

def finally_break_continue2():
    try:
        for i in range(5):
            try:
                if i == 4:
                    continue

                for j in range(i):
                    try:
                        try:
                            if j == 3:
                                break
                            elif j == 1:
                                continue
                            print j
                        finally:
                            print 'f1'
                    finally:
                        print 'f2'
                        if j == 4:
                            break
            finally:
                print 'f3'
    finally:
        print 'f4'

def finally_break_continue3(n):
    while n != 0:
        print 'A'
        try:
            while n != 0:
                print 'B'
                if n == 42:
                    print 'C'
                    n -= 1
                    continue
                try:
                    print 'D'
                    if n > 0:
                        print 'E'
                        continue
                    else:
                        print 'F'
                        break
                finally:
                    print('G')
                    return -1
            print 'H'
            return -2
        finally:
            print 'I'
            return n + 1

def test_try_with_loop1(_):
    try:
        print 'A'
        while True:
            print 'B'
            try:
                print 'C'
                raise ValueError()
                assert False
            except ValueError:
                print 'D'
                break
    finally:
        print 'E'

def test_try_with_loop2(_):
    try:
        print 'A'
        while True:
            print 'B'
            try:
                print 'C'
                raise ValueError()
                assert False
            except:
                print 'D'
                break
    finally:
        print 'E'

def test_try_with_loop3(_):
    try:
        try:
            print 'A'
            while True:
                print 'B'
                try:
                    print 'C'
                    raise ValueError()
                    assert False
                except IOError:
                    print 'D'
                    break
        finally:
            print 'E'
    except:
        print 'F'
    finally:
        print 'G'

def test_try_with_loop4(_):
    try:
        try:
            print 'A'
            while True:
                print 'B'
                try:
                    print 'C'
                    raise ValueError()
                    assert False
                except:
                    print 'D'
                    raise IOError()
                    break
        finally:
            print 'E'
    except:
        print 'F'
    finally:
        print 'G'

