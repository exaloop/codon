import numpy as np

@noinline
def materialize(array):
    return array

def square(array):
    return array * array

def reversed_arguments(first, second, unused):
    return second - first * first

def scalar_first(array, scalar):
    return scalar - array

def staged_square(array):
    squared = array * array
    shifted = squared + 1
    return shifted

def staged_rebind(array):
    array = array + 1
    result = array * 2
    return result

def staged_arguments(first, second, unused):
    squared = first * first
    result = second - squared
    return result

def staged_mean(array):
    squared = array * array
    result = np.mean(squared + 1)
    return result

def staged_where(array):
    condition = array > 2
    selected = np.where(condition, array * 2, array + 1)
    return selected

def staged_nested(array):
    return staged_square(array) + 2

def staged_shared(array):
    temporary = record(array + 1, 5)
    return temporary * temporary + temporary

def staged_uncovered(array, other):
    unused = array + other
    return array + 1

def staged_mutation(array):
    temporary = array + 1
    mutate_array(array)
    return temporary * 2

def staged_reduction(array):
    temporary = array + 1
    total = temporary.mean()
    return temporary - total

def mutate_none(array):
    array[0] = 100

def staged_ufunc_effect(array, other):
    temporary = np.add(array, array, out=mutate_none(other))
    return other * 2 + temporary

events: List[int] = []

def record(value, label):
    events.append(label)
    return value

def fail_argument():
    events.append(9)
    raise ValueError('argument')
    return np.arange(2)

def mutate_initial(array):
    array[0] = 100
    return 2

def mutate_array(array):
    array[0] = 100
    return array

def mutate_index(array):
    array[0] = 100
    return 0

@noinline
def indexed_callback(array, callback):
    return (array + 1) + array[callback(array):]

def effectful_none():
    events.append(7)

@noinline
def effectful_ufunc_receiver():
    events.append(8)
    return np.add

def receiver_expression(array):
    return effectful_ufunc_receiver()(array, array)

@test
def test_inline_arguments():
    array = np.arange(6)
    events.clear()
    result = record(10, 0) + reversed_arguments(
        record(array, 1), record(array * 2, 2), record(array, 3))
    assert np.array_equal(result, 10 + array * 2 - array * array)
    assert events == [0, 1, 2, 3]
    events.clear()
    assert np.array_equal(square(record(array, 4)) + 1, array * array + 1)
    assert events == [4]
    assert np.array_equal(scalar_first(array, 8) + 1, 9 - array)
    events.clear()
    try:
        reversed_arguments(record(array, 1), record(array, 2), fail_argument()) + 1
        assert False
    except ValueError:
        assert events == [1, 2, 9]
    mutable = np.array([1, 2])
    assert np.array_equal(square(mutable) + mutate_array(mutable), [101, 6])
    events.clear()
    result = receiver_expression(record(array, 6))
    assert np.array_equal(result, array + array)
    assert events == [6, 8]
    events.clear()
    try:
        receiver_expression(fail_argument())
        assert False
    except ValueError:
        assert events == [9]

def check_staged_layout(dtype: type):
    values = np.arange(24, dtype=dtype).reshape(4, 6)
    for array in (values, values.copy(order='F'), values.T, values[::-1, ::-2],
                  values[:0], values[:, :0]):
        expected = materialize(materialize(array * array) + 1) + 2
        result = staged_square(array) + 2
        assert np.array_equal(result, expected)
        assert result.dtype is expected.dtype
        assert result.strides == expected.strides
        assert np.array_equal(staged_nested(array), expected)
        assert np.array_equal(staged_square(array + 1),
                              materialize((array + 1) * (array + 1)) + 1)
        assert np.array_equal(staged_rebind(array) + 2, materialize((array + 1) * 2) + 2)
        assert np.allclose(staged_mean(array),
                           np.mean(materialize(materialize(array * array) + 1)),
                           rtol=0, atol=0, equal_nan=True)
        assert np.array_equal(staged_where(array) + 1,
                              materialize(np.where(array > 2, array * 2, array + 1)) + 1)

@test
def test_multistatement_helpers():
    check_staged_layout(np.int64)
    check_staged_layout(np.float32)
    check_staged_layout(np.float64)
    array = np.arange(6.)
    events.clear()
    result = record(10., 0) + staged_arguments(
        record(array, 1), record(array * 2, 2), record(array, 3))
    assert events == [0, 1, 2, 3]
    assert np.array_equal(result, 10 + array * 2 - array * array)
    events.clear()
    try:
        staged_arguments(record(array, 1), record(array, 2), fail_argument())
        assert False
    except ValueError:
        assert events == [1, 2, 9]
    events.clear()
    assert np.array_equal(staged_shared(array), (array + 1) * (array + 1) + array + 1)
    assert events == [5]
    for other in (np.ones(2), np.ones(3)):
        try:
            staged_uncovered(array, other) + 1
            assert False
        except ValueError:
            pass
    original = np.array([1., 2.])
    rebound = staged_rebind(original)
    assert np.array_equal(original, [1., 2.])
    assert np.array_equal(rebound, [4., 6.])
    assert np.array_equal(staged_mutation(original), [4., 6.])
    assert np.array_equal(original, [100., 2.])
    original = np.array([1., 2.])
    result = staged_square(original) + mutate_array(original)
    assert np.array_equal(result, [102., 7.])
    result = staged_reduction(array)
    expected = materialize(array + 1)
    assert np.array_equal(result, expected - expected.mean())
    other = np.array([1., 2.])
    assert np.array_equal(staged_ufunc_effect(np.array([1., 2.]), other), [202., 8.])
    assert np.array_equal(other, [100., 2.])

test_multistatement_helpers()

@test
def test_safe_fusion_leaves():
    matrix = np.arange(12).reshape(3, 4)
    result = (matrix[1:, :-1] + matrix[:-1, 1:]) * matrix[1:, 1:]
    expected = materialize(matrix[1:, :-1] + matrix[:-1, 1:]) * matrix[1:, 1:]
    assert np.array_equal(result, expected)
    result = (np.clip(matrix, 2, 10) * 3 + matrix) * 2
    assert np.array_equal(result, (materialize(np.clip(matrix, 2, 10)) * 3 + matrix) * 2)
    mutable = np.array([1, 2, 3])
    result = (mutable + 1) + mutable[mutate_index(mutable):]
    assert np.array_equal(result, [102, 5, 7])
    mutable = np.array([1, 2, 3])
    result = (mutable + 1) + np.clip(mutable, mutate_initial(mutable), 10)
    assert np.array_equal(result, [12, 5, 7])
    mutable = np.array([1, 2, 3])
    result = (mutable + 1) + np.clip(mutable, 0, 2, out=mutable)
    assert np.array_equal(result, [3, 5, 6])
    mutable = np.array([1, 2, 3])
    assert np.array_equal(indexed_callback(mutable, mutate_index), [102, 5, 7])
    mutable = np.array([1, 2, 3])
    result = (mutable + 1) / (2 * mutate_initial(mutable))
    assert np.array_equal(result, [0.5, 0.75, 1.])
    dx, dy = 0.5, 2.
    result = (matrix[1:, :-1] / (2 * dx) + matrix[:-1, 1:] * (1 / dy)) / (2 * (dx ** 2 + dy ** 2))
    left = materialize(matrix[1:, :-1] / (2 * dx))
    right = materialize(matrix[:-1, 1:] * (1 / dy))
    assert np.array_equal(result, (left + right) / (2 * (dx ** 2 + dy ** 2)))

@noinline
def forwarding_branch(values, condition):
    temporary = values + 1
    if condition:
        values[0] = 100
    return temporary * 2

@noinline
def forwarding_reassignment(values, condition):
    factor = 2
    temporary = values * factor
    if condition:
        factor = 10
    return temporary + factor

@noinline
def forwarding_loop_before(values, count):
    temporary = values + 1
    while count > 0:
        values[0] += 10
        count -= 1
    return temporary * 2

@noinline
def forwarding_loop_consumer(values, count):
    temporary = values + 1
    result = np.zeros_like(values)
    for iteration in range(count):
        result[:] = temporary * 2
        values[0] += 10
    return result

@noinline
def forwarding_conditional_error(left, right, condition):
    temporary = left + right
    if condition:
        return temporary * 2.
    return np.zeros(1)

@noinline
def forwarding_early_return_error(left, right, condition):
    temporary = left + right
    if condition:
        return np.zeros(1)
    return temporary * 2.

@noinline
def forwarding_loop_error(left, right, count):
    temporary = left + right
    result = np.zeros(1)
    for iteration in range(count):
        result = temporary * 2.
    return result

@noinline
def forwarding_join(left, right, condition):
    temporary = left + right
    factor = 2. if condition else 3.
    return temporary * factor

@test
def test_forwarding_eager_errors():
    left = np.ones(2)
    right = np.ones(3)
    for condition in (False, True):
        caught = False
        try:
            forwarding_conditional_error(left, right, condition)
        except ValueError:
            caught = True
        assert caught
        caught = False
        try:
            forwarding_early_return_error(left, right, condition)
        except ValueError:
            caught = True
        assert caught
        caught = False
        try:
            forwarding_join(left, right, condition)
        except ValueError:
            caught = True
        assert caught
        assert np.array_equal(forwarding_conditional_error(left, left, condition),
                              np.full(2, 4.) if condition else np.zeros(1))
        assert np.array_equal(forwarding_early_return_error(left, left, condition),
                              np.zeros(1) if condition else np.full(2, 4.))
        assert np.array_equal(forwarding_join(left, left, condition),
                              np.full(2, 4. if condition else 6.))
    for count in (0, 1, 3):
        caught = False
        try:
            forwarding_loop_error(left, right, count)
        except ValueError:
            caught = True
        assert caught
        assert np.array_equal(forwarding_loop_error(left, left, count),
                              np.full(2, 4.) if count else np.zeros(1))

test_forwarding_eager_errors()

@test
def test_forwarding_control_flow():
    for condition in (False, True):
        values = np.array([1, 2, 3])
        assert np.array_equal(forwarding_branch(values, condition), [4, 6, 8])
        assert values[0] == (100 if condition else 1)
        values = np.array([1, 2, 3])
        expected = [12, 14, 16] if condition else [4, 6, 8]
        assert np.array_equal(forwarding_reassignment(values, condition), expected)
    for count in (0, 1, 3):
        values = np.array([1, 2, 3])
        assert np.array_equal(forwarding_loop_before(values, count), [4, 6, 8])
        assert values[0] == 1 + 10 * count
        values = np.array([1, 2, 3])
        expected = [4, 6, 8] if count else [0, 0, 0]
        assert np.array_equal(forwarding_loop_consumer(values, count), expected)
        assert values[0] == 1 + 10 * count

test_forwarding_control_flow()

@noinline
def lifetime_update(values):
    values += 2.0 * values[::-1]
    temporary = values * values + 1.0
    values[:] = temporary
    values[:] = temporary
    temporary = values * 2.0
    values[:] = temporary
    temporary = temporary * 3.0
    values[:] = temporary

@noinline
def lifetime_escape(values):
    temporary = values * 2.0
    view = temporary[::-1]
    values[:] = temporary
    return view

@noinline
def lifetime_loop(values):
    temporary = values * 2.0
    for iteration in range(4):
        values[:] = temporary
        temporary = values + 1.0
    return temporary

@noinline
def lifetime_exception(values):
    temporary = values * 2.0
    try:
        values[:1] = temporary
    except ValueError:
        return temporary[::-1]
    return temporary

@noinline
def lifetime_local_loop(values, count):
    for iteration in range(count):
        temporary = values + 1.0
        values[:] = temporary
        values[:] = temporary

@noinline
def lifetime_transferred(values):
    temporary = np.exp(values)
    total = temporary.sum()
    return temporary / total

@noinline
def masked_update(values, mask, other):
    values[mask] = values[mask] ** 2 + other[mask]

@noinline
def gathered_view(values, mask, output):
    temporary = values[mask]
    view = temporary[::-1]
    output[:] = temporary
    return view

@noinline
def mutate_mask(mask):
    mask[:] = False
    return mask

@test
def test_masked_ownership():
    for original in (np.arange(12.).reshape(3, 4).astype(complex),
                     np.arange(12.).reshape(3, 4).astype(complex).T,
                     np.arange(12.).reshape(3, 4).astype(complex)[::-1, ::-1]):
        for mask in (original.real > 5, original.real > 100, original.real >= 0):
            values = original.copy()
            other = original + 1j
            selected = materialize(values[mask])
            expected = values.copy()
            expected[mask] = materialize(selected * selected) + materialize(other[mask])
            masked_update(values, mask, other)
            assert np.array_equal(values, expected)
            assert np.array_equal(other, original + 1j)
            output = np.empty(selected.shape, dtype=complex)
            escaped = gathered_view(original, mask, output)
            for repeat in range(16):
                replacement = np.ones(selected.shape, dtype=complex) * (repeat + 1)
                assert replacement.size == selected.size
            assert np.array_equal(escaped, selected[::-1])
            assert np.array_equal(output, selected)
    values = np.arange(8.)
    indices = np.array([6, 1, 6, 0])
    before = values.copy()
    values[indices] = values[indices] * 2 + values[indices]
    assert np.array_equal(values, [0., 3., 2., 3., 4., 5., 18., 7.])
    assert np.array_equal(indices, [6, 1, 6, 0])
    assert np.array_equal(before, np.arange(8.))
    values = np.array([1., 2., 3.])
    mask = np.array([True, True, True])
    result = values[mask] ** 2 + mutate_array(values)
    assert np.array_equal(result, [101., 6., 12.])
    mask[:] = True
    try:
        values[mask] ** 2 + values[mutate_mask(mask)]
        assert False
    except ValueError:
        assert not np.any(mask)

test_masked_ownership()

@noinline
def filtered_replacement(values, count, stop):
    for iteration in range(count):
        if iteration == stop:
            break
        if iteration % 2:
            continue
        mask = values > iteration
        values = values[mask]
    return values

@noinline
def filtered_aliases(values, count):
    saved = []
    for iteration in range(count):
        saved.append(values[::-1])
        values = values[values > iteration]
    return saved

@noinline
def filtered_exception(values, count):
    for iteration in range(count):
        try:
            values = values[values > iteration]
            if iteration == 2:
                raise ValueError('filtered')
        except ValueError:
            return values[::-1]
    return values[::-1]

@noinline
def filtered_pair(left, right, count):
    for iteration in range(count):
        if not len(left):
            break
        np.multiply(left, 1., left)
        mask = left > iteration
        np.logical_not(mask, mask)
        np.logical_not(mask, mask)
        left, right = left[mask], right[mask]
    return left, right

@noinline
def retained_filtered_tuple(values, count):
    saved = []
    for iteration in range(count):
        pair = values[values > iteration], values[values > iteration]
        values = pair[0]
        saved.append(pair)
    return saved

@test
def test_filtered_replacement():
    for original in (np.arange(16.), np.arange(16.)[::-1], np.arange(32.)[::2], np.arange(0.)):
        for count in (0, 1, 7):
            for stop in (-1, 0, 3):
                snapshot = original.copy()
                expected = original
                for iteration in range(count):
                    if iteration == stop:
                        break
                    if iteration % 2:
                        continue
                    expected = materialize(expected[expected > iteration])
                result = filtered_replacement(original, count, stop)
                for repeat in range(32):
                    replacement = np.ones(original.shape) * repeat
                    assert replacement.size == original.size
                assert np.array_equal(result, expected)
                assert np.array_equal(original, snapshot)
            saved = filtered_aliases(original, count)
            expected = original
            for iteration in range(count):
                assert np.array_equal(saved[iteration], expected[::-1])
                expected = materialize(expected[expected > iteration])
            expected = original
            for iteration in range(min(count, 3)):
                expected = materialize(expected[expected > iteration])
            assert np.array_equal(filtered_exception(original, count), expected[::-1])
            left, right = filtered_pair(original.copy(), original.copy() + 10., count)
            saved = retained_filtered_tuple(original, count)
            expected = original
            for iteration in range(count):
                expected = materialize(expected[expected > iteration])
                assert np.array_equal(saved[iteration][0], expected)
                assert np.array_equal(saved[iteration][1], expected)
            for repeat in range(32):
                replacement = np.ones(original.shape) * repeat
                assert replacement.size == original.size
            assert np.array_equal(left, expected)
            assert np.array_equal(right, expected + 10.)
    matrix = np.arange(12.).reshape(3, 4)
    rows, columns = np.array([2, 0, 2]), np.array([3, 1, 0])
    assert np.array_equal(matrix[rows, columns] ** 2 + matrix[rows, columns], [132., 2., 72.])
    assert np.array_equal(matrix[rows, 1] * 2 + matrix[rows, 1], [27., 3., 27.])

test_filtered_replacement()

@test
def test_prompt_release():
    for original in (np.arange(17.), np.arange(34.)[::2], np.arange(17.)[::-1], np.arange(0.)):
        for values in (original.copy(), original.copy()[::-1], np.repeat(original, 2)[::2]):
            snapshot = values.copy()
            expected = snapshot + 2.0 * snapshot[::-1]
            expected = (expected * expected + 1.0) * 6.0
            lifetime_update(values)
            assert np.array_equal(values, expected)
            for count in (0, 1, 7):
                before = values.copy()
                lifetime_local_loop(values, count)
                assert np.array_equal(values, before + count)
        escaped_input = original.copy()
        escaped = lifetime_escape(escaped_input)
        carried = lifetime_loop(original.copy())
        caught = lifetime_exception(np.arange(17.))
        borrowed = original.astype(float, copy=False)
        values = original.copy()
        values[:] = borrowed
        for repeat in range(32):
            replacement = np.ones(original.shape) * (repeat + 1.0)
            assert replacement.size == original.size
        assert np.array_equal(values, original)
        assert np.array_equal(escaped, (original * 2.0)[::-1])
        assert np.array_equal(carried, original * 2.0 + 4.0)
        assert np.array_equal(caught, (np.arange(17.) * 2.0)[::-1])
    values = np.arange(17.)
    expected = np.exp(values)
    expected /= expected.sum()
    transferred = lifetime_transferred(values)
    values[:] = np.conj(values)
    for repeat in range(32):
        replacement = np.ones(17) * (repeat + 1.0)
        assert replacement.size == 17
    assert np.allclose(transferred, expected)
    assert np.array_equal(values, np.arange(17.))

@test
def test_inner_loop_aliases():
    from numpy.fusion import _loop_basic

    def subtract(destination, left, right, extra):
        destination[0] = left[0] - right[0] + extra

    original = np.arange(63.).reshape(7, 9)
    for array in (original.copy(), original.copy(order='F'),
                  original[:, ::-1], original[::2, ::2], original[:0, :]):
        for other in (np.ones(array.shape), np.ones((1, array.shape[1])),
                      np.ones((array.shape[0], 1)), np.array(2.),
                      np.ones(array.shape, dtype=np.float32)):
            expected = array - other + 3.
            _loop_basic((array, array, other), subtract, 3.)
            assert np.array_equal(array, expected)
            expected = other - array + 3.
            _loop_basic((array, other, array), subtract, 3.)
            assert np.array_equal(array, expected)
            output = np.empty_like(array)
            expected = array - other + 3.
            _loop_basic((output, array, other), subtract, 3.)
            assert np.array_equal(output, expected)

    array = np.arange(9.).reshape(3, 3)
    reference = array.copy()
    other = np.ones((3, 3))
    np.ndarray._loop((reference, reference.T, other), subtract, extra=3.)
    _loop_basic((array, array.T, other), subtract, 3.)
    assert np.array_equal(array, reference)

test_safe_fusion_leaves()
test_prompt_release()
test_inner_loop_aliases()

def check_reduction_dtype(dtype: type):
    for size in (0, 1, 7, 8, 63, 64, 65, 127, 128, 129, 255, 513):
        array = np.arange(size, dtype=dtype)
        assert np.sum(array * array + 1) == np.sum(materialize(array * array + 1))
        assert (array + 1).sum(initial=3) == materialize(array + 1).sum(initial=3)
        assert np.sum(array[::-2] + 1) == np.sum(materialize(array[::-2] + 1))
    small = np.array([1, 2, 3], dtype=dtype)
    assert np.prod(small + 1, initial=2) == np.prod(materialize(small + 1), initial=2)
    assert (small[:0] + 1).prod() == 1

@test
def test_fused_reductions():
    check_reduction_dtype(np.float64)
    check_reduction_dtype(np.float32)
    check_reduction_dtype(np.float16)
    check_reduction_dtype(np.int64)
    check_reduction_dtype(np.int8)
    check_reduction_dtype(np.uint8)
    check_reduction_dtype(np.complex128)
    check_reduction_dtype(np.complex64)

    array = np.array([1e16, 1., -1e16, 1.] * 257)
    assert np.sum(array + 0.) == np.sum(materialize(array + 0.))
    assert np.sum(array + 0., where=True) == np.sum(materialize(array + 0.), where=True)
    narrow = np.array([120, 125], dtype=np.int8)
    assert np.sum(narrow + np.int8(10)) == 9
    assert type(np.sum(narrow + np.int8(10))) is np.int8
    assert np.sum(narrow + np.int8(10), dtype=np.float64) == -247.
    assert np.sum(narrow > 122) == 1
    assert np.sum(narrow + np.array([1], dtype=np.int8)) == -9
    assert np.sum(narrow[:0] + np.array([1], dtype=np.int8)) == 0
    try:
        np.sum(narrow + np.arange(3))
        assert False
    except ValueError:
        pass

    intermediate = array * array
    assert np.sum(intermediate + 1) == np.sum(materialize(array * array + 1))
    intermediate = narrow + np.int8(1)
    total = intermediate.sum()
    assert total == -9
    assert np.array_equal(intermediate, [121, 126])
    matrix = np.arange(12).reshape(3, 4)
    assert np.array_equal(np.sum(matrix + 1, axis=0), [15, 18, 21, 24])
    assert np.array_equal(np.sum(narrow + 1, keepdims=True), [-9])
    mutable = np.array([1, 2, 3])
    assert np.sum(mutable + 1, initial=mutate_initial(mutable)) == 11
    mutable = np.array([1, 2, 3])
    temporary = mutable + 1
    mutable[0] = 100
    assert temporary.sum() == 9
    scalar = (mutable + 1).sum()
    assert np.array_equal(scalar + mutable, [208, 110, 111])
    events.clear()
    assert np.sum(narrow + 1, axis=effectful_none()) == -9
    assert events == [7]

@test
def test_array_copies_and_casts():
    array = np.array([127, 128, 255, 256])
    assert np.array_equal(array.astype(np.int8) + np.int8(1), [-128, -127, 0, 1])
    assert np.sum(array.astype(np.int8) + np.int8(1), dtype=int) == -254
    assert np.array_equal((array + 1).astype(np.float32), [128., 129., 256., 257.])
    assert np.array_equal(array[::-1].copy() + 1, [257, 256, 129, 128])
    assert np.array_equal(array.copy(order='F') * 2, array * 2)
    assert np.array_equal(array.astype(int, copy=False) + 1, array + 1)
    mutable = np.array([1, 2])
    assert np.array_equal(mutable.copy() + mutate_array(mutable), [101, 4])
    fractional = np.array([16777217., 1.1, -1.1])
    assert np.array_equal(fractional.astype(np.float32).astype(float) + 0.,
                          materialize(fractional.astype(np.float32)).astype(float))
    expensive = np.arctan2(np.arctan2(array, array + 1), array + 2).astype(np.float32)
    expected = materialize(np.arctan2(np.arctan2(array, array + 1), array + 2))
    assert np.array_equal(expensive, expected.astype(np.float32))
    independent = (array + 1).copy()
    independent[0] = 0
    assert array[0] == 127
    vector = np.arange(6.)
    view = vector.astype(float, copy=False).astype(float, copy=False)
    assert view.data == vector.data
    view[0] = 123.
    assert vector[0] == 123.
    matrix = np.arange(12.).reshape(3, 4) * 0.125
    snapshot = matrix.copy()
    result = np.sin(matrix.astype(float, copy=False)) + 1.
    assert np.array_equal(matrix, snapshot)
    assert result.data != matrix.data
    assert np.allclose(result, np.sin(snapshot) + 1.)
    try:
        array.astype(float, order='bad') + 1
        assert False
    except ValueError:
        pass

test_inline_arguments()
test_fused_reductions()
test_array_copies_and_casts()

def check_higher_rank_producer_order(array, order: Literal[str]):
    got = (array + 0.).copy(order=order)
    expected = materialize(array + 0.).copy(order=order)
    assert np.array_equal(got, expected)
    assert got.strides == expected.strides, (order, got.strides, expected.strides)
    assert ((array.copy(order=order) + 1).sum() ==
            (materialize(array.copy(order=order)) + 1).sum())
    got = (array + 0.).astype(np.float32, order=order)
    expected = materialize(array + 0.).astype(np.float32, order=order)
    assert np.array_equal(got, expected)
    assert got.strides == expected.strides, (order, got.strides, expected.strides)
    assert ((array.astype(np.float32, order=order) + 1).sum() ==
            (materialize(array.astype(np.float32, order=order)) + 1).sum())
    assert (array.astype(float, order=order, copy=False).sum() ==
            materialize(array.astype(float, order=order, copy=False)).sum())
    got = array.astype(float, order=order, copy=False).astype(
        float, order=order, copy=False)
    expected = materialize(array.astype(float, order=order, copy=False)).astype(
        float, order=order, copy=False)
    assert got.strides == expected.strides
    assert np.array_equal(got, expected)
    if order == 'K' or order == 'A':
        assert got.data == array.data
    got = np.zeros_like(array + 1, order=order)
    expected = np.zeros_like(materialize(array + 1), order=order)
    assert np.array_equal(got, expected)
    assert got.strides == expected.strides, (order, got.strides, expected.strides)
    got = (np.ones_like(array, dtype=np.int8, order=order) +
           np.zeros_like(array, dtype=np.int8, order=order))
    expected = (materialize(np.ones_like(array, dtype=np.int8, order=order)) +
                materialize(np.zeros_like(array, dtype=np.int8, order=order)))
    assert np.array_equal(got, expected)
    assert got.strides == expected.strides
    assert ((np.ones_like(array, order=order) + array).sum() ==
            (materialize(np.ones_like(array, order=order)) + array).sum())
    got = np.ones_like(array + 1, order=order)
    expected = np.ones_like(materialize(array + 1), order=order)
    assert np.array_equal(got, expected)
    assert got.strides == expected.strides, (order, got.strides, expected.strides)

@test
def test_higher_rank_producers():
    values = np.array([1e16, 1., -1e16, -1.] * 258).reshape(2, 3, 172)
    for array in (values, values.copy(order='F'), values.transpose((1, 2, 0)),
                  values[:, ::-1, ::2], values[:, :0, :], values[:, :1, :]):
        check_higher_rank_producer_order(array, 'C')
        check_higher_rank_producer_order(array, 'F')
        check_higher_rank_producer_order(array, 'A')
        check_higher_rank_producer_order(array, 'K')
    check_higher_rank_producer_order(values.reshape(6, 172).T, 'C')
    check_higher_rank_producer_order(values.reshape(2, 3, 4, 43), 'F')
    assert ((values.copy(order='F') + values.copy(order='C')).sum() ==
            (materialize(values.copy(order='F')) +
             materialize(values.copy(order='C'))).sum())
    matrix = np.arange(12.).reshape(3, 4)
    row = np.arange(4.)
    column = np.arange(3.).reshape(3, 1)
    got = np.ones_like((matrix + column).copy(order='F')) + row
    expected = materialize(np.ones_like(materialize(matrix + column).copy(order='F'))) + row
    assert np.array_equal(got, expected)
    assert got.strides == expected.strides
    assert ((matrix.astype(np.float32) + column + row).sum() ==
            materialize(matrix.astype(np.float32) + column + row).sum())
    narrowed = np.array([127, 128, 255, 256]).reshape(2, 2)
    assert np.array_equal(narrowed.astype(np.int8) + np.int8(1),
                          np.array([-128, -127, 0, 1]).reshape(2, 2))
    fractional = np.array([16777217., 1.1, -1.1, 0.]).reshape(2, 2)
    assert np.array_equal(fractional.astype(np.float32, order='F').astype(float) + 0.,
                          materialize(fractional.astype(np.float32, order='F')).astype(float))
    expensive = np.arctan2(np.arctan2(matrix, matrix + 1), matrix + 2).astype(
        np.float32, order='F')
    expected = materialize(np.arctan2(np.arctan2(matrix, matrix + 1), matrix + 2)).astype(
        np.float32, order='F')
    assert np.array_equal(expensive, expected)
    assert expensive.strides == expected.strides
    independent = (matrix + 1).copy(order='F')
    independent[0, 0] = 100.
    assert matrix[0, 0] == 0.
    try:
        np.ones_like(matrix + np.ones((2, 4))).sum()
        assert False
    except ValueError:
        pass
    try:
        matrix.copy(order='bad') + 1
        assert False
    except ValueError:
        pass

test_higher_rank_producers()

@test
def test_filled_producers():
    array = np.array([float('nan'), float('inf'), -2., 0., 3.])
    assert np.array_equal(np.zeros_like(array) + 1, [1., 1., 1., 1., 1.])
    assert np.array_equal(np.ones_like(array, dtype=np.int8) + 2, [3, 3, 3, 3, 3])
    assert np.sum(np.ones_like(array[::-2]) + 2) == 9.
    assert np.sum(np.ones_like(array[:0]) + 2) == 0.
    assert np.array_equal(np.ones_like(array) + np.arange(5), [1., 2., 3., 4., 5.])

test_filled_producers()

def check_multidimensional_reduction(array):
    got = (array + 1).sum()
    expected = materialize(array + 1).sum()
    assert got == expected, (array.shape, array.strides, got, expected)
    got = np.sum(array * 2 + 1)
    expected = np.sum(materialize(array * 2 + 1))
    assert got == expected, (array.shape, array.strides, got, expected)
    assert np.sum(array > 0) == np.sum(materialize(array > 0))

@test
def test_multidimensional_reductions():
    values = np.array([1e16, 1., -1e16, -1.] * 258).reshape(2, 3, 172)
    check_multidimensional_reduction(values)
    check_multidimensional_reduction(values.copy(order='F'))
    check_multidimensional_reduction(values.transpose((1, 2, 0)))
    check_multidimensional_reduction(values.transpose((2, 0, 1)))
    check_multidimensional_reduction(values[:, ::-1, ::2])
    check_multidimensional_reduction(values[:, :0, :])
    check_multidimensional_reduction(values.reshape(6, 172))
    check_multidimensional_reduction(values.reshape(6, 172).T)
    check_multidimensional_reduction(values.reshape(6, 172)[::-1, ::-2])
    check_multidimensional_reduction(values.reshape(1, 2, 3, 172))
    check_multidimensional_reduction(values.astype(np.float32))
    check_multidimensional_reduction(values.astype(np.complex128))
    integers = np.arange(120).reshape(2, 3, 4, 5)
    check_multidimensional_reduction(integers.transpose((2, 0, 3, 1)))

    matrix = np.arange(15, dtype=float).reshape(3, 5)
    assert (matrix.T + 1).sum() == materialize(matrix.T + 1).sum()
    column = np.array([[1.], [2.], [3.]])
    row = np.arange(5, dtype=float)
    assert np.sum(matrix + column + row) == np.sum(materialize(matrix + column + row))
    assert np.sum(column + row) == np.sum(materialize(column + row))
    assert np.sum(matrix + np.array(2.)) == np.sum(materialize(matrix + np.array(2.)))
    assert np.sum(matrix[:0] + row) == 0.
    try:
        np.sum(matrix + np.arange(4))
        assert False
    except ValueError:
        pass

    products = (np.arange(120, dtype=float) * 1e-7).reshape(2, 3, 20)
    for array in (products, products.copy(order='F'), products.transpose((1, 2, 0)),
                  products[:, ::-1, ::2]):
        got = (array + 1.).prod(initial=2.)
        expected = materialize(array + 1.).prod(initial=2.)
        assert got == expected, (array.shape, array.strides, got, expected)
    assert (products[:0] + 1.).prod(initial=2.) == 2.

test_multidimensional_reductions()

@test
def test_short_circuit_reduction_loop():
    from numpy.fusion import _loop_reduce

    def counted(pointer, calls):
        calls[0] += 1
        return pointer[0]

    values = np.array([1, 0, 0, 0]).reshape(2, 2)
    calls = 0
    assert _loop_reduce((values,), counted, __ptr__(calls), False, int, bool, 'any')
    assert calls == 1
    calls = 0
    assert not _loop_reduce((values,), counted, __ptr__(calls), True, int, bool, 'all')
    assert calls == 2
    calls = 0
    assert not _loop_reduce((values[:0],), counted, __ptr__(calls), False, int, bool, 'any')
    assert _loop_reduce((values[:0],), counted, __ptr__(calls), True, int, bool, 'all')
    assert calls == 0
    strided = np.array([[0, 9, 0], [0, 9, 1]])[:, ::2]
    calls = 0
    assert _loop_reduce((strided,), counted, __ptr__(calls), (), int, bool, 'any')
    assert calls == 4
    calls = 0
    assert not _loop_reduce((strided,), counted, __ptr__(calls), (), int, bool, 'all')
    assert calls == 1
    strided = np.array([[1, 9, 1], [1, 9, 0]])[:, ::2]
    calls = 0
    assert not _loop_reduce((strided,), counted, __ptr__(calls), (), int, bool, 'all')
    assert calls == 4
    calls = 0
    assert not _loop_reduce((strided[:0],), counted, __ptr__(calls), (), int, bool, 'any')
    assert calls == 0

test_short_circuit_reduction_loop()

def check_highway_broadcast(dtype: type):
    from numpy.fusion import _apply_vectorized_loop_binary
    from math import hypot, atan2

    values = (np.arange(7 * 37, dtype=dtype).reshape(7, 37) + dtype(1)) * dtype(0.01)
    for array in (values, values.copy(order='F'), values[:, ::-1]):
        for small in (array[:, :1], array[:1, :]):
            for left, right in ((small, array), (array, small)):
                output = np.empty_like(array)
                _apply_vectorized_loop_binary(left, right, output, 'hypot')
                expanded_left = np.broadcast_to(left, array.shape)
                expanded_right = np.broadcast_to(right, array.shape)
                for row in range(array.shape[0]):
                    for column in range(array.shape[1]):
                        expected = hypot(float(expanded_left[row, column]), float(expanded_right[row, column]))
                        assert abs(float(output[row, column]) - expected) < 1e-5
                _apply_vectorized_loop_binary(left, right, output, 'arctan2')
                for row in range(array.shape[0]):
                    for column in range(array.shape[1]):
                        expected = atan2(float(expanded_left[row, column]), float(expanded_right[row, column]))
                        assert abs(float(output[row, column]) - expected) < 1e-5

@test
def test_highway_broadcast():
    check_highway_broadcast(np.float32)
    check_highway_broadcast(np.float64)

test_highway_broadcast()

def check_truth_and_extrema(array):
    assert (array < 1).any() == materialize(array < 1).any()
    assert np.any(array >= 2) == np.any(materialize(array >= 2))
    assert (array < 3).all() == materialize(array < 3).all()
    assert np.all(array >= 0) == np.all(materialize(array >= 0))
    assert (array * 2).any() == materialize(array * 2).any()
    assert (array * 2).all() == materialize(array * 2).all()
    assert (array + 1).min() == materialize(array + 1).min()
    assert (array + 1).max() == materialize(array + 1).max()
    assert np.amin(array * 2) == np.min(materialize(array * 2))
    assert np.amax(array * 2) == np.max(materialize(array * 2))
    assert np.min(array + 1, initial=-3) == np.min(materialize(array + 1), initial=-3)
    assert np.max(array + 1, initial=99) == np.max(materialize(array + 1), initial=99)

def check_truth_and_extrema_dtype(dtype: type):
    array = np.array([0, 1, 2, 3, 4, 5], dtype=dtype)
    check_truth_and_extrema(array)
    check_truth_and_extrema(array.reshape(2, 3))
    check_truth_and_extrema(array[::-2])
    assert not (array[:0] < 1).any()
    assert (array[:0] < 1).all()
    assert (array[:0] + 1).min(initial=3) == dtype(3)
    assert (array[:0] + 1).max(initial=3) == dtype(3)

@test
def test_truth_and_extrema_reductions():
    check_truth_and_extrema_dtype(np.float64)
    check_truth_and_extrema_dtype(np.float32)
    check_truth_and_extrema_dtype(np.float16)
    check_truth_and_extrema_dtype(np.int8)
    check_truth_and_extrema_dtype(np.uint8)
    check_truth_and_extrema_dtype(np.int64)
    check_truth_and_extrema_dtype(np.complex128)
    check_truth_and_extrema_dtype(np.complex64)
    values = np.arange(120, dtype=float).reshape(2, 3, 20)
    for array in (values, values.copy(order='F'), values.transpose((1, 2, 0)),
                  values[:, ::-1, ::2]):
        check_truth_and_extrema(array)
    matrix = values.reshape(6, 20)
    row = np.arange(20)
    assert np.any(matrix < row + 1) == np.any(materialize(matrix < row + 1))
    assert np.all(matrix >= row) == np.all(materialize(matrix >= row))
    assert np.amin(matrix + row) == np.min(materialize(matrix + row))
    assert np.amax(matrix.T + 1) == np.max(materialize(matrix.T + 1))
    assert not np.any(matrix[:0] < row)
    assert np.all(matrix[:0] < row)
    assert np.amin(matrix[:0] + row, initial=7.) == 7.
    assert np.amax(matrix[:0] + row, initial=-7.) == -7.
    for reduction in (np.min, np.max, np.amin, np.amax):
        try:
            reduction(matrix[:0] + 1)
            assert False
        except ValueError as error:
            assert 'zero-size array to reduction operation' in str(error)
    try:
        np.any(matrix < np.arange(19))
        assert False
    except ValueError:
        pass

    booleans = np.array([True, False])
    assert not np.min(~booleans)
    assert np.max(~booleans)
    zeros = np.array([0., -0.])
    assert np.signbit((zeros * 1.).min())
    assert not np.signbit((zeros * 1.).max())
    special = np.array([0., float('inf'), float('-inf'), float('nan')])
    assert np.isnan(np.min(special * 1.))
    assert np.isnan(np.max(special * 1.))
    assert np.any(special * 1.)
    assert not np.all(special * 1.)
    assert np.all(special[1:] * 1.)
    narrow = np.array([120, 125], dtype=np.int8)
    assert np.min(narrow + np.int8(10), dtype=float) == -126.
    assert np.max(narrow + np.int8(10), dtype=float) == -121.

    assert np.any(matrix < 1, where=True)
    assert not np.all(matrix < 1, where=True)
    assert np.min(matrix + 1, where=True, initial=1000.) == 1.
    assert np.max(matrix + 1, where=True, initial=-1000.) == 120.
    assert np.array_equal(np.any(matrix < 1, axis=0), materialize(matrix < 1).any(axis=0))
    assert np.array_equal(np.all(matrix < 1, keepdims=True), [[False]])
    output = np.array(0.)
    assert np.max(matrix + 1, out=output) is output
    assert output == 120.
    events.clear()
    assert np.any(matrix < 1, axis=effectful_none())
    assert events == [7]
    mutable = np.array([1, 2, 3])
    assert np.max(mutable + 1, initial=mutate_initial(mutable)) == 4

test_truth_and_extrema_reductions()

def check_axis_result(actual, expected):
    assert np.array_equal(actual, expected), (actual, expected)
    if hasattr(actual, 'shape'):
        assert actual.shape == expected.shape, (actual.shape, expected.shape)
        assert actual.strides == expected.strides, (actual.strides, expected.strides)

def check_axis_reducers(array, axis, keepdims: Literal[bool]):
    check_axis_result((array + 1).sum(axis=axis, keepdims=keepdims),
                      materialize(array + 1).sum(axis=axis, keepdims=keepdims))
    check_axis_result(np.sum(array * 2, axis=axis, keepdims=keepdims, initial=0.5),
                      np.sum(materialize(array * 2), axis=axis,
                             keepdims=keepdims, initial=0.5))
    check_axis_result((array * 0.01 + 1).prod(axis=axis, keepdims=keepdims, initial=2.),
                      materialize(array * 0.01 + 1).prod(axis=axis,
                                                       keepdims=keepdims, initial=2.))
    check_axis_result((array < 1).any(axis=axis, keepdims=keepdims),
                      materialize(array < 1).any(axis=axis, keepdims=keepdims))
    check_axis_result(np.all(array >= 1, axis=axis, keepdims=keepdims),
                      np.all(materialize(array >= 1), axis=axis, keepdims=keepdims))
    check_axis_result((array + 1).min(axis=axis, keepdims=keepdims, initial=0.),
                      materialize(array + 1).min(axis=axis, keepdims=keepdims, initial=0.))
    check_axis_result(np.amax(array + 1, axis=axis, keepdims=keepdims, initial=0.),
                      np.amax(materialize(array + 1), axis=axis,
                              keepdims=keepdims, initial=0.))

@test
def test_axis_reductions():
    values = np.array([1e16, 1., -1e16, -1.] * 258).reshape(2, 3, 172)
    for array in (values, values.copy(order='F'), values.transpose((1, 2, 0)),
                  values[:, ::-1, ::2], values[:, :0, :], values[:, :1, :]):
        for axis in range(-3, 3):
            check_axis_reducers(array, axis, False)
            check_axis_reducers(array, axis, True)
        for axes in ((0, 1), (2, 0), (-1, -2)):
            check_axis_reducers(array, axes, False)
            check_axis_reducers(array, axes, True)
        check_axis_reducers(array, (), False)
        check_axis_reducers(array, (), True)
        check_axis_reducers(array, (2, 1, 0), False)
        check_axis_reducers(array, (2, 1, 0), True)
        check_axis_reducers(array, None, True)
    matrix = np.arange(24.).reshape(4, 6)
    check_axis_reducers(matrix.T, 0, False)
    check_axis_reducers(matrix.T, -1, True)
    check_axis_reducers(matrix.reshape(2, 1, 3, 4), (0, 2), True)
    check_axis_reducers(np.arange(17.), -1, False)
    check_axis_reducers(np.arange(17.), 0, True)
    check_axis_result((matrix.astype(np.float32, order='F') + 1).sum(axis=1),
                      materialize(matrix.astype(np.float32, order='F') + 1).sum(axis=1))
    check_axis_result((matrix + np.arange(6.)).sum(axis=0),
                      materialize(matrix + np.arange(6.)).sum(axis=0))
    for axis in range(2):
        check_axis_result((matrix + 1).min(axis=axis),
                          materialize(matrix + 1).min(axis=axis))
        check_axis_result(np.amin(matrix * 2, axis=axis),
                          np.amin(materialize(matrix * 2), axis=axis))
        check_axis_result((matrix + 1).max(axis=axis, keepdims=True),
                          materialize(matrix + 1).max(axis=axis, keepdims=True))

test_axis_reductions()

def check_axis_dtype(dtype: type):
    array = np.array([120, 125, 1, 2, 3, 4], dtype=dtype).reshape(2, 3)
    for axis in range(2):
        check_axis_result((array + dtype(10)).sum(axis=axis),
                          materialize(array + dtype(10)).sum(axis=axis))
        check_axis_result((array + dtype(10)).prod(axis=axis),
                          materialize(array + dtype(10)).prod(axis=axis))
        check_axis_result((array + dtype(10)).min(axis=axis),
                          materialize(array + dtype(10)).min(axis=axis))
        check_axis_result((array + dtype(10)).max(axis=axis),
                          materialize(array + dtype(10)).max(axis=axis))
        check_axis_result(np.sum(array + dtype(10), axis=axis, dtype=np.complex128),
                          np.sum(materialize(array + dtype(10)), axis=axis,
                                 dtype=np.complex128))

@test
def test_axis_reduction_edges():
    check_axis_dtype(np.int8)
    check_axis_dtype(np.uint8)
    check_axis_dtype(np.float16)
    check_axis_dtype(np.float32)
    check_axis_dtype(np.complex64)
    check_axis_dtype(np.complex128)
    values = np.arange(24.).reshape(4, 6)
    for axis in (-3, 2):
        try:
            (values + 1).sum(axis=axis)
            assert False
        except np.AxisError:
            pass
    for axes in ((0, 0), (1, -1)):
        try:
            (values < 1).any(axis=axes)
            assert False
        except ValueError as error:
            assert 'repeated axis' in str(error)
    for empty in (values[:0], values[:, :0]):
        for axis in range(2):
            try:
                (empty + 1).min(axis=axis)
                assert False
            except ValueError as error:
                assert 'zero-size array' in str(error)
            try:
                (empty + 1).max(axis=axis, keepdims=True)
                assert False
            except ValueError as error:
                assert 'zero-size array' in str(error)
    special = np.array([[0., -0.], [float('nan'), float('inf')]])
    assert np.array_equal(np.isnan((special * 1).min(axis=1)), [False, True])
    assert np.array_equal(np.isnan((special * 1).max(axis=1)), [False, True])
    assert np.signbit((special * 1).min(axis=1)[0])
    assert not np.signbit((special * 1).max(axis=1)[0])
    check_axis_result((values > 3).sum(axis=0), materialize(values > 3).sum(axis=0))
    check_axis_result(np.sum(values + 1, axis=1, where=True),
                      np.sum(materialize(values + 1), axis=1, where=True))
    output = np.zeros(6)
    returned = np.sum(values + 1, axis=0, out=output)
    assert returned.data == output.data
    assert np.array_equal(output, materialize(values + 1).sum(axis=0))

    def mutate_axis(array):
        array[0, 0] = 100.
        return 0

    mutable = np.array([[1., 2.], [3., 4.]])
    assert np.array_equal(np.sum(mutable + 1, axis=mutate_axis(mutable)), [6., 8.])
    assert mutable[0, 0] == 100.
    independent = (values + 1).sum(axis=())
    independent[0, 0] = 100.
    assert values[0, 0] == 0.

test_axis_reduction_edges()

def check_mean_where_result(actual, expected):
    assert np.allclose(actual, expected, rtol=0, atol=0, equal_nan=True), (actual, expected)
    if hasattr(actual, 'shape'):
        assert actual.shape == expected.shape
        assert actual.strides == expected.strides, (actual.strides, expected.strides)
        assert actual.dtype is expected.dtype
    else:
        assert type(actual) is type(expected)

def check_fused_mean_dtype(dtype: type):
    values = np.arange(24, dtype=dtype).reshape(4, 6)
    for array in (values, values.copy(order='F'), values.T, values[::-1, ::-2],
                  values[:0], values[:, :0]):
        check_mean_where_result(np.mean(array + dtype(1)),
                                np.mean(materialize(array + dtype(1))))
        for axis in (0, 1, -1):
            check_mean_where_result((array + dtype(1)).mean(axis=axis),
                                    materialize(array + dtype(1)).mean(axis=axis))
            check_mean_where_result(np.mean(array + dtype(1), axis=axis, keepdims=True),
                                    np.mean(materialize(array + dtype(1)),
                                            axis=axis, keepdims=True))
        check_mean_where_result((array + dtype(1)).mean(axis=(), keepdims=True),
                                materialize(array + dtype(1)).mean(axis=(), keepdims=True))
        check_mean_where_result(np.mean(array + dtype(1), axis=(1, 0), dtype=np.complex128),
                                np.mean(materialize(array + dtype(1)),
                                        axis=(1, 0), dtype=np.complex128))
    for size in (0, 1, 17, 257):
        array = np.arange(size, dtype=dtype)[::-1]
        check_mean_where_result((array + dtype(1)).mean(),
                                materialize(array + dtype(1)).mean())

@test
def test_fused_mean():
    check_fused_mean_dtype(np.int8)
    check_fused_mean_dtype(np.uint8)
    check_fused_mean_dtype(np.float16)
    check_fused_mean_dtype(np.float32)
    check_fused_mean_dtype(np.float64)
    check_fused_mean_dtype(np.complex64)
    check_fused_mean_dtype(np.complex128)
    values = np.array([1e16, 1., -1e16, -1.] * 258).reshape(2, 3, 172)
    for array in (values, values.copy(order='F'), values[:, ::-1, ::-2]):
        check_mean_where_result((array + 0.).mean(), materialize(array + 0.).mean())
        check_mean_where_result(np.mean(array + 0., axis=(0, 2), keepdims=True),
                                np.mean(materialize(array + 0.), axis=(0, 2), keepdims=True))
        check_mean_where_result(np.mean(array + 0., dtype=np.float32, axis=1),
                                np.mean(materialize(array + 0.), dtype=np.float32, axis=1))
    values = np.array([[1.25, 2.75], [3.5, 4.5]])
    for axis in (0, 1):
        check_mean_where_result(np.mean(values + 0., axis=axis, dtype=np.int32),
                                np.mean(materialize(values + 0.), axis=axis, dtype=np.int32))
    check_mean_where_result(np.mean(values > 2), np.mean(materialize(values > 2)))
    check_mean_where_result(np.mean(values + 1, where=values > 2),
                            np.mean(materialize(values + 1), where=values > 2))
    output = np.zeros(2)
    returned = np.mean(values + 1, axis=0, out=output)
    assert returned.data == output.data
    check_mean_where_result(output, np.mean(materialize(values + 1), axis=0))
    for axis in (-3, 2):
        try:
            np.mean(values + 1, axis=axis)
            assert False
        except np.AxisError:
            pass
    try:
        np.mean(values + 1, axis=(0, 0))
        assert False
    except ValueError:
        pass
    special = np.array([0., -0., float('nan'), float('inf'), -float('inf')])
    check_mean_where_result(np.mean(special * 1), np.mean(materialize(special * 1)))

test_fused_mean()

def check_fused_where_dtype(dtype: type):
    values = np.arange(24, dtype=dtype).reshape(4, 6)
    for array in (values, values.copy(order='F'), values.T, values[::-1, ::-2],
                  values[:0], values[:, :0]):
        condition = array.real > 3
        snapshot = array.copy()
        expected = np.where(condition, materialize(array * dtype(2)),
                            materialize(array + dtype(1)))
        check_mean_where_result(np.where(condition, array * dtype(2), array + dtype(1)), expected)
        check_mean_where_result(np.where(condition, array * dtype(2), array + dtype(1)) + dtype(3),
                                materialize(expected) + dtype(3))
        check_mean_where_result(np.mean(np.where(condition, array * dtype(2), array + dtype(1))),
                                np.mean(materialize(expected)))
        check_mean_where_result(np.where(condition, array * dtype(2), 3.),
                                np.where(condition, materialize(array * dtype(2)), 3.))
        check_mean_where_result(np.where(True, array + dtype(1), array),
                                np.where(True, materialize(array + dtype(1)), array))
        assert np.array_equal(array, snapshot)

@test
def test_fused_where():
    check_fused_where_dtype(np.int8)
    check_fused_where_dtype(np.float32)
    check_fused_where_dtype(np.float64)
    check_fused_where_dtype(np.complex64)
    left = np.arange(3.).reshape(3, 1)
    right = np.arange(4.).reshape(1, 4)
    condition = np.array([[0., float('nan'), 1., -2.]])
    expected = np.where(condition, materialize(left * 2), materialize(right + 1))
    check_mean_where_result(np.where(condition, left * 2, right + 1), expected)
    check_mean_where_result(np.where(condition + 0., np.array(3), np.array(4.)),
                            np.where(materialize(condition + 0.), np.array(3), np.array(4.)))
    check_mean_where_result(np.where(condition > 0, left + 1, np.where(right > 2, right, -right)),
                            np.where(materialize(condition > 0), materialize(left + 1),
                                     materialize(np.where(right > 2, right, -right))))
    check_mean_where_result(np.where(condition, np.sin(left) + np.exp(left), right * right),
                            np.where(condition, materialize(np.sin(left) + np.exp(left)),
                                     materialize(right * right)))
    special = np.array([0., -0., float('nan'), float('inf')])
    selected = np.where(special == 0, special * 1., special)
    reference = np.where(materialize(special == 0), materialize(special * 1.), special)
    assert np.array_equal(np.signbit(selected), np.signbit(reference))
    check_mean_where_result(selected, reference)
    assert np.array_equal(np.where(special == 0)[0], [0, 1])
    events.clear()
    result = np.where(record(special == 0, 1), record(special, 2), record(special, 3)) + 1
    assert events == [1, 2, 3]
    check_mean_where_result(result, special + 1)
    values = np.array([1., 2.])
    result = np.where(values < 2, values + 1, mutate_array(values))
    assert np.array_equal(result, [2., 2.])
    for condition in (False, True):
        try:
            np.where(condition, np.ones(2) + 1, np.ones(3) * 2)
            assert False
        except ValueError:
            pass
        events.clear()
        try:
            np.where(condition, np.ones(2) + np.ones(3), record(np.ones(2), 1))
            assert False
        except ValueError:
            assert events == []

test_fused_where()

@test
def test_axis_negative_strides():
    from numpy.fusion import _loop_reduce_axis

    def record_axis(pointer, context):
        trace, count = context
        trace[count[0]] = pointer[0]
        count[0] += 1
        return pointer[0]

    values = np.arange(12).reshape(3, 4)
    for array in (values[::-1], values[:, ::-1], values[::-1, ::-1]):
        trace = np.empty(12, dtype=int)
        count = 0
        result = _loop_reduce_axis((array,), record_axis, (trace.data, __ptr__(count)),
                                   0, array, 0, int, int, 'sum', 1)
        assert np.array_equal(result, array.sum(axis=0))
        assert count == 12
        assert np.array_equal(trace, array.flatten())

test_axis_negative_strides()

def check_axis_gradual_identity(dtype: type, operation: Literal[str], initial):
    from numpy.fusion import _axis_gradual_expr

    def read_value(pointer, extra):
        return pointer[0]

    values = np.array([[2, 3], [4, 5]], dtype=dtype)
    partitions = (((values.strides[0],), (values.strides[1],)),)
    for length in (0, 2):
        output = np.full(2, 123, dtype=dtype)
        _axis_gradual_expr(output, (length,), partitions, (values.data,), read_value,
                           None, initial, False, operation)
        if length == 0:
            expected = np.full(2, initial, dtype=dtype)
        elif operation == 'sum':
            expected = np.array([6, 8], dtype=dtype) + initial
        else:
            expected = np.array([8, 15], dtype=dtype) * initial
        assert np.array_equal(output, expected)

def check_axis_default_identities(dtype: type):
    values = np.array([[2, 3], [4, 5]], dtype=dtype)
    for array in (values, values[::-1], values[:, ::-1], values.copy(order='F')):
        for length in (0, 2):
            view = array[:length]
            assert np.array_equal((view + dtype(1)).sum(axis=0),
                                  materialize(view + dtype(1)).sum(axis=0))
            assert np.array_equal((view + dtype(1)).prod(axis=0),
                                  materialize(view + dtype(1)).prod(axis=0))
    check_axis_gradual_identity(dtype, 'sum', 0)
    check_axis_gradual_identity(dtype, 'prod', 1)
    check_axis_gradual_identity(dtype, 'sum', 7)
    check_axis_gradual_identity(dtype, 'prod', 3)

@test
def test_axis_gradual_identities():
    check_axis_default_identities(np.int64)
    check_axis_default_identities(np.float32)
    check_axis_default_identities(np.float64)
    check_axis_default_identities(np.complex128)

test_axis_gradual_identities()

@test
def test_axis_short_circuit_loop():
    from numpy.fusion import _loop_reduce_axis

    def counted(pointer, calls):
        calls[0] += 1
        return pointer[0]

    values = np.array([[1, 0, 0], [0, 0, 1], [0, 0, 0]])
    calls = 0
    result = _loop_reduce_axis((values,), counted, __ptr__(calls), (), values,
                               1, int, bool, 'any', 1)
    assert np.array_equal(result, [True, True, False])
    assert calls == 7
    calls = 0
    result = _loop_reduce_axis((values,), counted, __ptr__(calls), (), values,
                               1, int, bool, 'all', 1)
    assert np.array_equal(result, [False, False, False])
    assert calls == 4
    calls = 0
    cube = values.reshape(3, 1, 3)
    result = _loop_reduce_axis((cube,), counted, __ptr__(calls), (), cube,
                               (1, 2), int, bool, 'any', 1)
    assert np.array_equal(result, [True, True, False])
    assert calls == 7
    calls = 0
    empty = values[:, :0]
    result = _loop_reduce_axis((empty,), counted, __ptr__(calls), (), empty,
                               1, int, bool, 'all', 2)
    assert np.array_equal(result, [[True], [True], [True]])
    assert calls == 0

test_axis_short_circuit_loop()

@noinline
def forwarded_sum_epilogue(values, axis, keepdims: Literal[bool]):
    reduced = np.sum(values, axis=axis, keepdims=keepdims, initial=0.25)
    return reduced * 2

def check_forwarded_sum(values, axis, keepdims: Literal[bool]):
    expected = materialize(np.sum(values, axis=axis, keepdims=keepdims, initial=0.25)) * 2
    actual = forwarded_sum_epilogue(values, axis, keepdims)
    assert type(actual) is type(expected)
    check_axis_result(actual, expected)

@noinline
def forwarded_softmax(values):
    maximum = np.max(values, axis=-1, keepdims=True)
    exponentials = np.exp(values - maximum)
    total = np.sum(exponentials, axis=-1, keepdims=True)
    return exponentials / total

def check_forwarded_dtype(dtype: type):
    values = np.array([120, 125, 1, 2, 3, 4], dtype=dtype).reshape(2, 3)
    check_forwarded_sum(values, 1, False)
    check_forwarded_sum(values, 0, True)

@test
def test_forwarded_reduction_values():
    for size in (7, 8, 63, 64, 65, 127, 128, 129, 513):
        values = np.array([1e8, 1., -1e8, 3.] * (size + 1), dtype=np.float32)
        values = values[:3 * size].reshape(3, size)
        for array in (values, values.copy(order='F'), values[:, ::-1],
                      values[::2, ::2], values[:, :0]):
            for axis in range(2):
                check_forwarded_sum(array, axis, False)
                check_forwarded_sum(array, axis, True)
            check_forwarded_sum(array, (), False)
            check_forwarded_sum(array, (0, 1), True)
    check_forwarded_dtype(np.int8)
    check_forwarded_dtype(np.uint8)
    check_forwarded_dtype(np.float16)
    check_forwarded_dtype(np.float32)
    check_forwarded_dtype(np.complex64)
    check_forwarded_dtype(np.complex128)

    values = np.array([[16777216., 1.], [1., 1e-8]], dtype=np.float32)
    reduced = np.sum(values, axis=1, dtype=np.float64)
    actual = reduced.astype(np.float32) + np.float32(1)
    expected = materialize(np.sum(values, axis=1, dtype=np.float64)).astype(np.float32)
    expected = materialize(expected) + np.float32(1)
    check_axis_result(actual, expected)
    assert type(actual) is np.ndarray[np.float32, 1]
    reduced = np.sum(values, axis=1)
    actual = (reduced + np.float32(1)) - np.float32(16777216)
    expected = materialize(np.sum(values, axis=1)) + np.float32(1)
    expected = materialize(expected) - np.float32(16777216)
    check_axis_result(actual, expected)
    total = np.sum(values)
    check_axis_result(values / total, values / materialize(np.sum(values)))

    values = np.arange(2 * 3 * 4 * 129, dtype=np.float32).reshape(2, 3, 4, 129) * 0.001
    for array in (values, values.copy(order='F'), values[:, :, :, ::-1]):
        snapshot = array.copy()
        maximum = materialize(np.max(array, axis=-1, keepdims=True))
        centered = materialize(array - maximum)
        exponentials = materialize(np.exp(centered))
        total = materialize(np.sum(exponentials, axis=-1, keepdims=True))
        check_axis_result(forwarded_softmax(array), exponentials / total)
        assert np.array_equal(array, snapshot)

test_forwarded_reduction_values()

@noinline
def repeated_reduction_consumer(values):
    reduced = values.sum(axis=1)
    result = np.zeros(values.shape[0])
    for iteration in range(4):
        result = materialize(reduced * 2)
    return result

@test
def test_forwarded_reduction_lifetimes():
    values = np.array([[1., 2.], [3., 4.]])
    axis = 1
    initial = 0.25
    reduced = np.sum(values, axis=axis, initial=initial)
    axis = 0
    initial = 100.
    values[0, 0] = 100.
    assert np.array_equal(reduced * 2, [6.5, 14.5])
    assert axis == 0 and initial == 100.

    reduced = values.sum(axis=1)
    retained = reduced
    result = reduced * 2
    assert np.array_equal(retained, [102., 7.])
    assert np.array_equal(result, [204., 14.])
    assert result.data != retained.data
    check_axis_result(repeated_reduction_consumer(values), np.array([204., 14.]))

    reduced = values.sum(axis=())
    result = reduced * 2
    result[0, 0] = -1.
    assert values[0, 0] == 100.
    reduced = values.prod(axis=1)
    assert np.array_equal(reduced * 2, [400., 24.])
    reduced = values.min(axis=1)
    assert np.array_equal(-reduced, [-2., -3.])
    reduced = values.max(axis=1)
    assert np.array_equal(reduced + 1, [101., 5.])
    reduced = values.any(axis=1)
    assert np.array_equal(~reduced, [False, False])
    reduced = values.all(axis=1)
    assert np.array_equal(~reduced, [False, False])

    special = np.array([[0., -0.], [float('nan'), 1.]])
    reduced = special.min(axis=1)
    actual = -reduced
    expected = -materialize(special.min(axis=1))
    assert np.array_equal(np.isnan(actual), np.isnan(expected))
    assert np.array_equal(np.signbit(actual), np.signbit(expected))

    events.clear()
    reduced = np.sum(record(values, 1), axis=record(1, 2), initial=record(0.25, 3))
    result = reduced * record(2, 4)
    assert events == [1, 2, 3, 4]
    assert np.array_equal(result, [204.5, 14.5])
    events.clear()
    try:
        reduced = values[:, :0].min(axis=1)
        result = reduced * record(2, 5)
        assert False
    except ValueError:
        assert events == []

test_forwarded_reduction_lifetimes()

@noinline
def last_use_normalize(values, axis, keepdims: Literal[bool]):
    temporary = np.exp(values)
    total = temporary.sum(axis=axis, keepdims=keepdims)
    return temporary / total

@noinline
def last_use_retained(values):
    temporary = np.exp(values)
    alias = temporary
    view = temporary[:, ::-1]
    total = temporary.sum(axis=1, keepdims=True)
    result = temporary / total
    return result, alias, view

@noinline
def last_use_later_read(values, read_later):
    temporary = np.exp(values)
    total = temporary.sum(axis=1, keepdims=True)
    result = temporary / total
    if read_later:
        return result, temporary.sum()
    return result, np.float32(0)

@noinline
def last_use_repeated(values):
    temporary = np.exp(values)
    total = temporary.sum(axis=1, keepdims=True)
    result = np.zeros_like(values)
    for iteration in range(3):
        result = materialize(temporary / total)
    return result

escaped_temporaries: List[np.ndarray[np.float32, 2]] = []

@noinline
def retain_temporary(values):
    escaped_temporaries.append(values)

@noinline
def last_use_escaped(values):
    temporary = np.exp(values)
    retain_temporary(temporary)
    total = temporary.sum(axis=1, keepdims=True)
    return temporary / total

@noinline
def last_use_alias_mutation(values):
    temporary = np.exp(values)
    alias = temporary
    total = temporary.sum(axis=1, keepdims=True)
    alias[0, :] = 123.
    return temporary / total

@noinline
def last_use_view_mutation(values):
    temporary = np.exp(values)
    view = temporary[::-1]
    total = temporary.sum(axis=1, keepdims=True)
    view[0, :] = 123.
    return temporary / total

@noinline
def mutate_last_use_alias(values):
    values[0, :] = 123.

@noinline
def last_use_indirect_mutation(values):
    temporary = np.exp(values)
    alias = temporary[::-1]
    total = temporary.sum(axis=1, keepdims=True)
    mutate_last_use_alias(alias)
    return temporary / total

def check_last_use_mutation(dtype: type):
    for rows, columns in ((1, 1), (3, 17), (5, 129)):
        values = np.linspace(-2., 2., rows * columns, dtype=dtype).reshape(rows, columns)
        for array in (values, values.copy(order='F'), values[::-1, ::-1],
                      values[:, ::2], values[:, :0]):
            snapshot = array.copy()
            exponential = materialize(np.exp(array))
            total = materialize(exponential.sum(axis=1, keepdims=True))
            mutated = materialize(np.exp(array))
            mutated[0, :] = 123.
            expected = materialize(mutated / total)
            check_axis_result(last_use_alias_mutation(array), expected)
            mutated = materialize(np.exp(array))
            mutated[-1, :] = 123.
            expected = materialize(mutated / total)
            check_axis_result(last_use_view_mutation(array), expected)
            check_axis_result(last_use_indirect_mutation(array), expected)
            assert np.array_equal(array, snapshot)

@test
def test_last_use_mutation():
    check_last_use_mutation(np.float32)
    check_last_use_mutation(np.float64)

test_last_use_mutation()

@test
def test_last_use_normalization():
    from numpy.fusion import _broadcast, _loop_basic

    def subtract_into(output, left, right, extra):
        output[0] = left[0] - right[0]

    for order in ('C', 'F'):
        left = np.arange(15, dtype=float).reshape(3, 5).copy(order=order)
        right = np.full((3, 1), 2.)
        expected = materialize(left - right)
        _loop_basic((left, left, right), subtract_into, ())
        assert np.array_equal(left, expected)
        right = np.arange(15, dtype=float).reshape(3, 5).copy(order=order)
        left = np.full((1, 5), 2.)
        expected = materialize(left - right)
        _loop_basic((right, left, right), subtract_into, ())
        assert np.array_equal(right, expected)
        output = np.empty_like(right)
        _loop_basic((output, left, right), subtract_into, ())
        assert np.array_equal(output, left - right)

    assert _broadcast((3, 0), (3, 1)) == (3, 0)
    assert _broadcast((3, 1), (3, 0)) == (3, 0)
    assert _broadcast((0,), (2, 1)) == (2, 0)
    values = np.arange(3 * 129, dtype=np.float32).reshape(3, 129) * 0.001
    for array in (values, values.copy(order='F'), values[:, ::-1],
                  values[:, ::2], values[:, :0], values[:0, :],
                  values[:0, :0], values[:1, :]):
        snapshot = array.copy()
        exponential = materialize(np.exp(array))
        check_axis_result(last_use_normalize(array, 1, True),
                          exponential / materialize(exponential.sum(axis=1, keepdims=True)))
        check_axis_result(last_use_normalize(array, None, False),
                          exponential / materialize(exponential.sum()))
        assert np.array_equal(array, snapshot)

    exponential = materialize(np.exp(values))
    total = materialize(exponential.sum(axis=1, keepdims=True))
    expected = materialize(exponential / total)
    result, alias, view = last_use_retained(values)
    check_axis_result(result, expected)
    assert result.data != alias.data
    assert np.array_equal(alias, exponential)
    assert np.array_equal(view, exponential[:, ::-1])
    result, later = last_use_later_read(values, True)
    check_axis_result(result, expected)
    assert later == exponential.sum()
    check_axis_result(last_use_repeated(values), expected)
    escaped_temporaries.clear()
    check_axis_result(last_use_escaped(values), expected)
    assert len(escaped_temporaries) == 1
    assert np.array_equal(escaped_temporaries[0], exponential)
    escaped_temporaries.clear()

    snapshot = values.copy()
    total = values.sum(axis=1, keepdims=True)
    result = values / total
    check_axis_result(result, snapshot / materialize(snapshot.sum(axis=1, keepdims=True)))
    assert np.array_equal(values, snapshot)
    borrowed = values.astype(np.float32, copy=False)
    total = borrowed.sum(axis=1, keepdims=True)
    result = borrowed / total
    assert np.array_equal(values, snapshot)
    check_axis_result(result, snapshot / materialize(snapshot.sum(axis=1, keepdims=True)))
    borrowed = values.T
    total = borrowed.sum(axis=0, keepdims=True)
    result = borrowed / total
    assert np.array_equal(values, snapshot)
    check_axis_result(result, snapshot.T / materialize(snapshot.T.sum(axis=0, keepdims=True)))

    temporary = np.exp(values)
    total = temporary.sum(axis=1, dtype=np.float64, keepdims=True)
    result = temporary / total
    assert type(result) is np.ndarray[np.float64, 2]
    check_axis_result(result, exponential /
                      materialize(exponential.sum(axis=1, dtype=np.float64, keepdims=True)))

test_last_use_normalization()

@noinline
def into_slice(values, increment, order):
    output = np.empty_like(values, order=order)
    output[:] = values * values + increment
    return output

@noinline
def into_ufunc(values, increment, order):
    output = np.empty_like(values, order=order)
    result = np.add(values * values, increment, out=output)
    assert result.data == output.data
    assert result.shape == output.shape and result.strides == output.strides
    return output

def check_destination_dtype(dtype: type):
    values = np.array([127, -128, 33, -17, 1, 0], dtype=dtype).reshape(2, 3)
    increment = dtype(3)
    for array in (values, values.copy(order='F'), values[:, ::-1],
                  values[:, ::2], values[:, :0], values[:0, :]):
        snapshot = array.copy()
        expected = materialize(array * array) + increment
        for order in ('C', 'F'):
            assigned = into_slice(array, increment, order)
            returned = into_ufunc(array, increment, order)
            layout = np.empty_like(array, order=order)
            assert np.array_equal(assigned, expected)
            assert np.array_equal(returned, expected)
            assert assigned.strides == layout.strides
            assert returned.strides == layout.strides
            assert np.array_equal(array, snapshot)

@noinline
def into_broadcast(left, right, shape):
    output = np.empty(shape)
    output[:] = left * left + right
    return output

@noinline
def into_self():
    output = np.full((2, 3), 2.0)
    output[:] = output * output + 1.0
    return output

@noinline
def into_ufunc_self():
    output = np.full((2, 3), 2.0)
    return np.add(output * output, 1.0, out=output)

@noinline
def into_simple_ufunc(values, increment):
    output = np.empty_like(values)
    return np.add(values, increment, out=output)

@test
def test_destination_values():
    check_destination_dtype(np.float64)
    check_destination_dtype(np.float32)
    check_destination_dtype(np.float16)
    check_destination_dtype(np.int64)
    check_destination_dtype(np.int8)
    values = np.array([1.0000001192092896, 4097., 8193., -0.], dtype=np.float32)
    expected = materialize(values * values) + np.float32(-16785408)
    assert np.array_equal(into_slice(values, np.float32(-16785408), 'C'), expected)
    assert np.array_equal(into_ufunc(values, np.float32(-16785408), 'F'), expected)
    left = np.array([[1.], [2.]])
    right = np.array([[10., 20., 30.]])
    assert np.array_equal(into_broadcast(left, right, (2, 3)), [[11., 21., 31.], [14., 24., 34.]])
    assert np.array_equal(into_broadcast(left, right, (4, 2, 3)),
                          np.broadcast_to(materialize(left * left) + right, (4, 2, 3)))
    assert np.array_equal(into_self(), np.full((2, 3), 5.0))
    assert np.array_equal(into_ufunc_self(), np.full((2, 3), 5.0))
    flags = np.array([True, False])
    assert np.array_equal(into_simple_ufunc(flags, flags), flags)

test_destination_values()

@noinline
def into_unknown(output, values):
    output[:] = values * values + 1.0
    return output

@noinline
def into_unknown_ufunc(output, values):
    return np.add(values * values, 1.0, out=output)

@noinline
def into_retained_view():
    output = np.ones(6)
    reverse = output[::-1]
    reverse[:] = np.arange(6, dtype=float)
    output[:] = reverse * reverse + 1.0
    return output

@noinline
def recorded_slice():
    events.append(8)
    return slice(None, None, None)

@noinline
def into_recorded_slice(values):
    output = np.empty_like(values)
    output[recorded_slice()] = values * values + 1.0
    return output

@noinline
def recorded_add():
    events.append(9)
    return np.add

@noinline
def into_recorded_add(values):
    output = np.empty_like(values)
    return recorded_add()(values * values, 1.0, out=output)

@noinline
def into_effectful_none(values):
    output = np.empty_like(values)
    output[:] = np.add(values * values, 1.0, out=effectful_none())
    return output

@test
def test_destination_fallbacks():
    values = np.arange(6, dtype=float)
    expected = materialize(values[::-1] * values[::-1]) + 1.0
    actual = into_unknown(values, values[::-1])
    assert actual.data == values.data and np.array_equal(actual, expected)
    values = np.arange(6, dtype=float)
    expected = materialize(values[:-1] * values[:-1]) + 1.0
    actual = into_unknown_ufunc(values[1:], values[:-1])
    assert np.array_equal(actual, expected)
    assert np.array_equal(into_retained_view(), np.arange(6, dtype=float) ** 2 + 1.0)
    values = np.arange(6, dtype=float)
    values[1:] = values[:-1] * values[:-1] + 1.0
    assert np.array_equal(values, [0., 1., 2., 5., 10., 17.])

    values = np.array([1.25, 2.75])
    output = np.empty(2, dtype=np.int64)
    result = np.add(values * values, 0.25, out=output)
    assert result.data == output.data and np.array_equal(output, [1, 7])
    output = np.full(2, -1.)
    np.add(values * values, 1., out=output, where=False)
    assert np.array_equal(output, [-1., -1.])
    np.add(values * values, 1., out=output, where=np.array([True, False]))
    assert np.array_equal(output, [2.5625, -1.])
    output = np.empty(2)
    np.add(values * values, 1., out=output, dtype=np.float32)
    assert np.array_equal(output, [2.5625, 8.5625])

    events.clear()
    output = np.empty(2)
    np.add(record(values, 1) * record(values, 2), record(1., 3),
           out=record(output, 4))
    assert events == [1, 2, 3, 4]
    assert np.array_equal(output, [2.5625, 8.5625])
    output = np.ones(2)
    output[:] = output * output + mutate_array(output)
    assert np.array_equal(output, [101., 2.])
    events.clear()
    assert np.array_equal(into_recorded_slice(values), [2.5625, 8.5625])
    assert events == [8]
    events.clear()
    assert np.array_equal(into_recorded_add(values), [2.5625, 8.5625])
    assert events == [9]
    events.clear()
    assert np.array_equal(into_effectful_none(values), [2.5625, 8.5625])
    assert events == [7]
    output = np.empty(2)
    result = np.add(values * values, 1., out=output) * 2.
    assert np.array_equal(output, [2.5625, 8.5625])
    assert np.array_equal(result, [5.125, 17.125])

test_destination_fallbacks()

@noinline
def into_bad_shape(values, shape):
    output = np.full(shape, -7.)
    try:
        output[:] = values * values + 1.0
    except ValueError:
        return output
    assert False
    return output

def destination_add(output, left, right, extra):
    output[0] = left[0] + right[0]

@test
def test_destination_errors():
    from numpy.fusion import _loop_into
    values = np.arange(6, dtype=float).reshape(2, 3)
    assert np.array_equal(into_bad_shape(values, (2, 2)), np.full((2, 2), -7.))
    output = np.full((2, 3), -7.)
    try:
        _loop_into((values, np.ones((2, 2))), destination_add, (), output)
        assert False
    except ValueError:
        assert np.array_equal(output, np.full((2, 3), -7.))
    events.clear()
    output = np.full((2, 3), -7.)
    try:
        np.add(values * np.ones((2, 2)), record(1., 1), out=record(output, 2))
        assert False
    except ValueError:
        assert events == []
        assert np.array_equal(output, np.full((2, 3), -7.))

test_destination_errors()

@noinline
def matmul_add(left, right, bias, mode: int = 0):
    if mode == 0:
        return left @ right + bias
    elif mode == 1:
        return bias + left @ right
    elif mode == 2:
        return left @ right - bias
    else:
        return bias - left @ right

@noinline
def matmul_add_reference(left, right, bias, mode: int = 0):
    product = materialize(left @ right)
    if mode == 0:
        return product + bias
    elif mode == 1:
        return bias + product
    elif mode == 2:
        return product - bias
    else:
        return bias - product

@noinline
def matmul_add_transposed(left, bias, mode: int = 0):
    if mode == 0:
        return left @ left.T + bias
    elif mode == 1:
        return bias + left @ left.T
    elif mode == 2:
        return left @ left.T - bias
    else:
        return bias - left @ left.T

@noinline
def matmul_add_into(left, right, shape, order, mode: int = 0):
    if mode == 0:
        output = np.full(shape, left.dtype(3), order=order)
        output[:] = left @ right + output
    elif mode == 1:
        output = np.full(shape, left.dtype(3), order=order)
        output[:] = output + left @ right
    elif mode == 2:
        output = np.full(shape, left.dtype(3), order=order)
        output[:] = left @ right - output
    else:
        output = np.full(shape, left.dtype(3), order=order)
        output[:] = output - left @ right
    return output

@noinline
def matmul_add_out(left, right, shape, order, mode: int = 0):
    if mode == 0:
        output = np.full(shape, left.dtype(3), order=order)
        result = np.add(left @ right, output, out=output)
    elif mode == 1:
        output = np.full(shape, left.dtype(3), order=order)
        result = np.add(output, left @ right, out=output)
    elif mode == 2:
        output = np.full(shape, left.dtype(3), order=order)
        result = np.subtract(left @ right, output, out=output)
    else:
        output = np.full(shape, left.dtype(3), order=order)
        result = np.subtract(output, left @ right, out=output)
    assert result.data == output.data
    return output

@noinline
def matmul_add_borrowed(left, right, output, mode: int = 0):
    if mode == 0:
        output[:] = left @ right + output
    elif mode == 1:
        output[:] = output + left @ right
    elif mode == 2:
        output[:] = left @ right - output
    else:
        output[:] = output - left @ right
    return output

@noinline
def matmul_add_self(right, mode: int = 0):
    if mode == 0:
        output = np.ones((3, 3))
        output[:] = output @ right + output
    elif mode == 1:
        output = np.ones((3, 3))
        output[:] = output + output @ right
    elif mode == 2:
        output = np.ones((3, 3))
        output[:] = output @ right - output
    else:
        output = np.ones((3, 3))
        output[:] = output - output @ right
    return output

@noinline
def matmul_add_alias(right, mode: int = 0):
    output = np.ones((3, 3))
    alias = output.T
    if mode == 0:
        output[:] = alias @ right + output
    elif mode == 1:
        output[:] = output + alias @ right
    elif mode == 2:
        output[:] = alias @ right - output
    else:
        output[:] = output - alias @ right
    return output

def check_matmul_add_result(actual, expected):
    assert actual.shape == expected.shape
    assert actual.dtype is expected.dtype
    assert np.array_equal(np.isnan(actual), np.isnan(expected))
    assert np.array_equal(np.isposinf(actual), np.isposinf(expected))
    assert np.array_equal(np.isneginf(actual), np.isneginf(expected))
    finite = np.isfinite(expected)
    assert np.allclose(actual[finite], expected[finite], rtol=2e-5, atol=2e-6)

def check_matmul_add_dtype(dtype: type, mode: int):
    matrix = np.arange(12, dtype=dtype).reshape(3, 4) * dtype(0.125)
    right = np.arange(20, dtype=dtype).reshape(4, 5) * dtype(-0.25)
    bias = np.arange(15, dtype=dtype).reshape(3, 5)
    for left in (matrix, matrix.copy(order='F'), matrix[:, ::-1]):
        for operand in (right, right.copy(order='F'), right[::-1, :]):
            expected = matmul_add_reference(left, operand, bias, mode)
            snapshot = bias.copy()
            result = matmul_add(left, operand, bias, mode)
            check_matmul_add_result(result, expected)
            assert result.data != bias.data
            assert np.array_equal(bias, snapshot)
            for addend in (bias.copy(order='F'), bias[:, ::-1]):
                snapshot = addend.copy()
                result = matmul_add(left, operand, addend, mode)
                check_matmul_add_result(result, matmul_add_reference(left, operand, addend, mode))
                assert result.data != addend.data
                assert np.array_equal(addend, snapshot)
            for order in ('C', 'F'):
                expected = matmul_add_reference(left, operand, np.full((3, 5), dtype(3)), mode)
                check_matmul_add_result(matmul_add_into(left, operand, (3, 5), order, mode), expected)
                check_matmul_add_result(matmul_add_out(left, operand, (3, 5), order, mode), expected)
        vector = np.arange(4, dtype=dtype)
        vector_bias = np.arange(3, dtype=dtype)
        for operand in (vector, vector[::-1]):
            check_matmul_add_result(matmul_add(left, operand, vector_bias, mode),
                                    matmul_add_reference(left, operand, vector_bias, mode))
            expected = matmul_add_reference(left, operand, np.full(3, dtype(3)), mode)
            check_matmul_add_result(matmul_add_into(left, operand, (3,), 'C', mode), expected)
            check_matmul_add_result(matmul_add_out(left, operand, (3,), 'C', mode), expected)
    for bias in (np.ones(5, dtype=dtype), np.ones((1, 5), dtype=dtype),
                 np.ones((3, 1), dtype=dtype), np.array(dtype(2))):
        check_matmul_add_result(matmul_add(matrix, right, bias, mode),
                    matmul_add_reference(matrix, right, bias, mode))
    nonsymmetric = np.arange(9, dtype=dtype).reshape(3, 3)
    check_matmul_add_result(matmul_add_transposed(matrix, nonsymmetric, mode),
                            matmul_add_reference(matrix, matrix.T, nonsymmetric, mode))
    for rows, inner, columns in ((0, 4, 5), (3, 0, 5), (3, 4, 0),
                                  (1, 4, 5), (3, 1, 5), (3, 4, 1)):
        left = np.ones((rows, inner), dtype=dtype)
        operand = np.ones((inner, columns), dtype=dtype)
        bias = np.full((rows, columns), dtype(-0.0))
        actual = matmul_add(left, operand, bias, mode)
        expected = matmul_add_reference(left, operand, bias, mode)
        check_matmul_add_result(actual, expected)
        assert np.array_equal(np.signbit(actual), np.signbit(expected))
    check_matmul_add_result(matmul_add(matrix[:1], right, np.ones((3, 5), dtype=dtype), mode),
                            matmul_add_reference(matrix[:1], right, np.ones((3, 5), dtype=dtype), mode))

@test
def test_matmul_add_values():
    right = np.arange(9, dtype=float).reshape(3, 3)
    for mode in range(4):
        check_matmul_add_dtype(np.float32, mode)
        check_matmul_add_dtype(np.float64, mode)
        expected = matmul_add_reference(np.ones((3, 3)), right, np.ones((3, 3)), mode)
        check_matmul_add_result(matmul_add_self(right, mode), expected)
        check_matmul_add_result(matmul_add_alias(right, mode), expected)
        output = np.ones((3, 3))
        check_matmul_add_result(matmul_add_borrowed(output, right, output, mode), expected)
    left = np.arange(12, dtype=np.float32).reshape(3, 4)
    operand = np.arange(20, dtype=np.float32).reshape(4, 5)
    bias = np.ones((3, 5), dtype=np.float64)
    assert np.array_equal(matmul_add(left, operand, bias),
                          matmul_add_reference(left, operand, bias))
    integer = np.arange(9).reshape(3, 3)
    assert np.array_equal(matmul_add(integer, integer, integer),
                          matmul_add_reference(integer, integer, integer))

test_matmul_add_values()

def check_matmul_special_dtype(dtype: type, huge_value, tiny_value):
    right = np.array([[1., 2.], [-1., 1.]], dtype=dtype)
    for value in (float('nan'), float('inf'), -float('inf'), 0., -0., tiny_value):
        left = np.array([[value, 1.], [2., value]], dtype=dtype)
        bias = np.array([[value, 3.], [4., value]], dtype=dtype)
        for mode in range(4):
            check_matmul_add_result(matmul_add(left, right, bias, mode),
                                    matmul_add_reference(left, right, bias, mode))
            check_matmul_add_result(matmul_add(left, right[:, 0], bias[:, 0], mode),
                                    matmul_add_reference(left, right[:, 0], bias[:, 0], mode))
        for coefficient in (0., -0., 0.75):
            coefficient = dtype(coefficient)
            product = materialize(left @ right)
            expected = materialize(coefficient * product) + bias
            check_matmul_add_result(coefficient * (left @ right) + bias, expected)
            expected = product + materialize(coefficient * bias)
            check_matmul_add_result(left @ right + coefficient * bias, expected)
    huge = np.array([[huge_value, huge_value], [-huge_value, -huge_value]], dtype=dtype)
    bias = -huge
    right = np.ones((2, 2), dtype=dtype)
    for mode in range(4):
        check_matmul_add_result(matmul_add(huge, right, bias, mode),
                                matmul_add_reference(huge, right, bias, mode))

@test
def test_matmul_add_special_values():
    check_matmul_special_dtype(np.float32, 3e38, 1e-40)
    check_matmul_special_dtype(np.float64, 1e308, 1e-310)

test_matmul_add_special_values()

@test
def test_matmul_add_errors_and_effects():
    left = np.ones((3, 4))
    right = np.ones((4, 5))
    output = np.full((3, 5), -7.)
    for bad_right in (np.ones((2, 5)), np.ones((4, 2))):
        for mode in range(4):
            snapshot = output.copy()
            try:
                matmul_add_borrowed(left, bad_right, output, mode)
                assert False
            except ValueError:
                assert np.array_equal(output, snapshot)
    events.clear()
    actual = record(left, 1) @ record(right, 2) + record(output, 3)
    assert events == [1, 2, 3]
    check_matmul_add_result(actual, matmul_add_reference(left, right, output))
    events.clear()
    actual = record(output, 3) + record(left, 1) @ record(right, 2)
    assert events == [3, 1, 2]
    check_matmul_add_result(actual, matmul_add_reference(left, right, output, 1))
    events.clear()
    actual = record(left, 1) @ record(right, 2) - record(output, 3)
    assert events == [1, 2, 3]
    check_matmul_add_result(actual, matmul_add_reference(left, right, output, 2))
    events.clear()
    actual = record(output, 3) - record(left, 1) @ record(right, 2)
    assert events == [3, 1, 2]
    check_matmul_add_result(actual, matmul_add_reference(left, right, output, 3))
    events.clear()
    try:
        left @ np.ones((2, 5)) + record(output, 4)
        assert False
    except ValueError:
        assert events == []
    events.clear()
    try:
        left @ np.ones((2, 5)) - record(output, 4)
        assert False
    except ValueError:
        assert events == []
    events.clear()
    try:
        record(output, 4) + left @ np.ones((2, 5))
        assert False
    except ValueError:
        assert events == [4]
    events.clear()
    try:
        record(output, 4) - left @ np.ones((2, 5))
        assert False
    except ValueError:
        assert events == [4]
    values = np.ones((3, 3))
    expected = materialize(values @ values)
    actual = values @ values + mutate_array(values)
    check_matmul_add_result(actual, expected + values)
    values = np.ones((3, 3))
    expected = materialize(values @ values)
    actual = values @ values - mutate_array(values)
    check_matmul_add_result(actual, expected - values)
    values = np.ones((3, 3))
    actual = mutate_array(values) + values @ values
    check_matmul_add_result(actual, values + materialize(values @ values))
    values = np.ones((3, 3))
    actual = mutate_array(values) - values @ values
    check_matmul_add_result(actual, values - materialize(values @ values))

test_matmul_add_errors_and_effects()


