    assert False

#%% fixed_dict_tuple_evaluation
events: list[int] = []
def observed(events, label):
    events.append(label)
    return label
def empty_values(events):
    events.append(2)
    mapping: FixedDict = {}
    return mapping.values()
def receive(first, third):
    return first + third
assert receive(observed(events, 1), *empty_values(events),
               third=observed(events, 3)) == 4
assert events == [1, 2, 3]
def empty_items(events):
    events.append(4)
    mapping: FixedDict = {}
    return mapping.items()
for key, value in empty_items(events):
    assert False
assert events == [1, 2, 3, 4]
callback = receive(first=5, ...)
assert callback(*empty_values(events), third=observed(events, 7)) == 12
assert events == [1, 2, 3, 4, 2, 7]

