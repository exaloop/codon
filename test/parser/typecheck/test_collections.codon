print(a, a.__class__.__name__)
#: [] List[NoneType]

d = {}
print(d, d.__class__.__name__)
#: {} OrderedDict[NoneType,NoneType]

s = set()
print(s, s.__class__.__name__)
#: set() Set[NoneType]

#%% star_err,barebones
