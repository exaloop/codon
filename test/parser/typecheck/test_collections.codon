mapping: FixedDict = {'first': 1, 'second': 2}
assert list(iter(mapping.keys())) == ['first', 'second']
assert list(iter(mapping.values())) == [1, 2]
assert list(iter(mapping.items())) == [('first', 1), ('second', 2)]
