#%% fixed_dict_spreading
from typing import Union

mapping: FixedDict = {'number': 42, 'text': 'hello'}
merged: FixedDict = {**mapping, 'number': [1, 2], 'extra': False}
assert merged.keys() == ('number', 'text', 'extra')
assert type(merged['number']) is list[int] and merged['text'] == 'hello'
explicit: FixedDict = {'start': 0, **mapping, 'text': [3]}
assert explicit.keys() == ('start', 'number', 'text') and explicit['text'] == [3]
events: list[int] = []
def record(events, label, value):
    events.append(label)
    return value
empty: FixedDict = {}
ordered: FixedDict = {'number': record(events, 1, 'old'),
                      **record(events, 2, mapping), 'text': record(events, 3, [3]),
                      **record(events, 4, empty)}
assert events == [1, 2, 3, 4]
assert ordered['number'] == 42 and ordered['text'] == [3]
homogeneous: FixedDict = {'first': 1, 'second': 2}
regular: dict[str, Union[int, str]] = {**homogeneous, 'third': 'three'}
assert isinstance(regular, dict) and regular['first'] == 1 and regular['third'] == 'three'
runtime_mapping = {'runtime': 1}
mixed: dict[str, Union[int, str]] = {**homogeneous, **runtime_mapping}
assert isinstance(mixed, dict) and mixed['runtime'] == 1
copied = {**homogeneous}
assert type(copied) is dict[str, int]
copied['third'] = 3
empty_copy = {**empty}
assert isinstance(empty_copy, dict) and len(empty_copy) == 0
with_empty = {**empty, 'number': 1}
assert type(with_empty) is dict[str, int]
# Empty ordinary spreads still evaluate once, in literal order.
events.clear()
with_effects = {**record(events, 1, empty), 'number': record(events, 2, 42),
                **record(events, 3, empty)}
assert with_effects == {'number': 42} and events == [1, 2, 3]
# Mapping items supplied as ordinary tuples use the same expansion path.
class PairSource:
    def items(self):
        return (('first', 1), ('second', 2))
pairs = {**PairSource()}
assert pairs == {'first': 1, 'second': 2}
print('fixed dictionary spreading ok')  #: fixed dictionary spreading ok

