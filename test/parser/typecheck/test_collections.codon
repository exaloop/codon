print gs #: {1.12}
fs = {1, 2, 3, 1, 2, 3}
gs.add(1.12)
gs.add(1.13)
print fs, gs #: {1, 2, 3} {1.13, 1.12}
print {*fs, 5, *fs} #: {1, 2, 3, 5}

#%% dict,barebones
gd = {1: 'jedan', 2: 'dva', 2: 'two', 3: 'tri'}
fd = {}
fd['jedan'] = 1
fd['dva'] = 2
print gd, fd #: {1: 'jedan', 2: 'two', 3: 'tri'} {'jedan': 1, 'dva': 2}

#%% dictionary_unpacking
# **mapping entries retain order, overwrite semantics, and evaluation count.
source = {'a': 1, 'b': 2, 'c': 3}
copied = {**source}
copied = {**copied, 'x': 99, **{'a': 42}}
assert copied == {'a': 42, 'b': 2, 'c': 3, 'x': 99}
assert source == {'a': 1, 'b': 2, 'c': 3}
assert list(copied.keys()) == ['a', 'b', 'c', 'x']
empty: dict[str, int] = {}
assert {**empty, **source, **empty} == source

def record(events, label, value):
    events.append(label)
    return value
events: list[int] = []
combined = {**record(events, 1, {'a': 1}),
            record(events, 2, 'b'): record(events, 3, 2),
            **record(events, 4, {'a': 3})}
assert combined == {'a': 3, 'b': 2} and events == [1, 2, 3, 4]
print('dictionary unpacking ok')  #: dictionary unpacking ok

#%% fixed_dict_context_variable
data: FixedDict = {'number': 42, 'text': 'hello'}
assert isinstance(data, FixedDict)
assert type(data['number']) is int and type(data['text']) is str
separate: FixedDict = {'first': [], 'second': []}
separate['first'].append(1)
separate['second'].append('two')
assert type(separate['first']) is list[int]
assert type(separate['second']) is list[str]
alias = data
assert alias['number'] == 42 and alias['text'] == 'hello'
empty: FixedDict = {}
assert len(empty) == 0 and not empty
homogeneous: FixedDict = {'first': 1, 'second': 2}
assert isinstance(homogeneous, FixedDict)
assert homogeneous.keys() == ('first', 'second')
print('fixed dictionary variable context ok')  #: fixed dictionary variable context ok

#%% fixed_dict_context_call
def read(value: FixedDict):
    return value['number'], value['text']
assert read({'number': 42, 'text': 'hello'}) == (42, 'hello')
assert read(value={'number': 43, 'text': 'world'}) == (43, 'world')
def count(value: FixedDict):
    return len(value)
assert count({}) == 0
assert count({'first': 1, 'second': 2}) == 2
def separate(value: FixedDict):
    value['first'].append(3)
    value['second'].append('four')
    return value['first'], value['second']
assert separate({'first': [1], 'second': ['two']}) == ([1, 3], ['two', 'four'])
class Receiver:
    offset: int
    def read(self, value: FixedDict):
        return self.offset + value['number']
assert Receiver(1).read({'number': 2}) == 3
def selected(value: FixedDict, tag: int):
    return value['number'] + tag
@overload
def selected(value: int, tag: str):
    return value + len(tag)
assert selected({'number': 2}, 3) == 5
assert selected(tag=3, value={'number': 2}) == 5
def ordinary(value: FixedDict):
    return 'fixed'
@overload
def ordinary(value: dict[str, int]):
    return 'dict'
assert ordinary({'number': 2}) == 'dict'
print('fixed dictionary call context ok')  #: fixed dictionary call context ok

#%% fixed_dict_context_dispatch
# Deferred literals must use concrete element types for final overload selection.
def typed(value: dict[str, str]):
    return 'str'
@overload
def typed(value: dict[str, int]):
    return 'int'
assert typed({'value': 'text'}) == 'str'
assert typed(value={'value': 42}) == 'int'
# Ordinary dict interpretation wins regardless of overload declaration order.
def ordinary(value: dict[str, int]):
    return 'dict'
@overload
def ordinary(value: FixedDict):
    return 'fixed'
assert ordinary({'value': 42}) == 'dict'
def variadic(tag: int, *values: FixedDict):
    return tag + sum(value['number'] for value in values)
@overload
def variadic(tag: str, *values: int):
    return len(tag) + sum(values)
assert variadic(1, {'number': 2}, {'number': 3}) == 6
def keywords(tag: int, **values: FixedDict):
    return tag + values['left']['number'] + values['right']['number']
@overload
def keywords(tag: str, **values: int):
    return len(tag) + sum(values.values())
assert keywords(right={'number': 3}, tag=1, left={'number': 2}) == 6
print('fixed dictionary deferred dispatch ok')  #: fixed dictionary deferred dispatch ok

#%% fixed_dict_context_binding
def read(prefix: int, value: FixedDict, *, suffix: int = 3):
    return prefix + value['number'] + suffix
alias = read
assert alias(1, {'number': 2}) == 6
partial = read(1, ...)
assert partial({'number': 2}) == 6
captured = read(value={'number': 2}, ...)
assert captured(1) == 6
def variadic(*values: FixedDict):
    return sum(value['number'] for value in values)
assert variadic({'number': 1}, {'number': 2}) == 3
def keywords(**values: FixedDict):
    return values['left']['number'] + values['right']['number']
assert keywords(left={'number': 1}, right={'number': 2}) == 3
print('fixed dictionary argument binding ok')  #: fixed dictionary argument binding ok

#%% fixed_dict_context_default
def read(value: FixedDict = {'number': 42, 'text': 'hello'}):
    return value['number'], value['text']
assert read() == (42, 'hello')
assert read({'number': 43, 'text': 'world'}) == (43, 'world')
Mapping = FixedDict
def aliased(value: Mapping = {'number': 1}):
    return value['number']
assert aliased() == 1
class Receiver:
    def read(self, value: FixedDict = {'number': 2}):
        return value['number']
assert Receiver().read() == 2
print('fixed dictionary default context ok')  #: fixed dictionary default context ok

#%% fixed_dict_context_evaluation
events: list[int] = []
def observed(events, label, value):
    events.append(label)
    return value
def read(prefix: int, value: FixedDict, suffix: int):
    return prefix + value['number'] + suffix
assert read(suffix=observed(events, 1, 3),
            value={'number': observed(events, 2, 0),
                   'number': observed(events, 3, 2)},
            prefix=observed(events, 4, 1)) == 6
assert events == [1, 2, 3, 4]
events.clear()
def capture(**kwargs):
    return kwargs
def empty(events):
    events.append(2)
    return capture()
def receive(value: FixedDict):
    return value['number']
assert receive({'number': observed(events, 1, 42)}, **empty(events)) == 42
assert events == [1, 2]
# Dispatch retries and empty unpacking must preserve the literal's evaluation.
@overload
def receive(value: int):
    return value
assert receive({'number': observed(events, 3, 43)}, **empty(events)) == 43
assert events == [1, 2, 3, 2]
assert read(1, {'number': (last := 3)}, last) == 7
def ordinary(value, suffix: int):
    return value['number'] + suffix
assert ordinary({'number': (last_ordinary := 4)}, last_ordinary) == 8
print('fixed dictionary evaluation order ok')  #: fixed dictionary evaluation order ok

#%% fixed_dict_literals
from typing import Union

data: FixedDict = {'foo': [1, 2, 3], 'bar': ['x', 'y', 'z']}
assert isinstance(data, FixedDict)
assert type(data['foo']) is list[int] and type(data['bar']) is list[str]
assert len(data) == 2 and bool(data)
assert list(data) == ['foo', 'bar']
assert repr(data) == "{'foo': [1, 2, 3], 'bar': ['x', 'y', 'z']}"
data['foo'].append(4)
assert data['foo'] == [1, 2, 3, 4]
separate: FixedDict = {'a': [], 'b': []}
separate['a'].append(1)
separate['b'].append('second')
assert type(separate['a']) is list[int] and type(separate['b']) is list[str]
Mapping = FixedDict
key: Literal[str] = 'first'
aliased: Mapping = {key: [], 'second': []}
aliased[key].append(1)
aliased['second'].append('two')
assert aliased[key] == [1] and aliased['second'] == ['two']
ordinary = {'a': 1, 'b': 2.5}
assert type(ordinary) is dict[str, float]
ordinary['c'] = 3.5
nullable = {'a': None, 'b': 1}
assert type(nullable) is dict[str, Optional[int]]
class Base:
    pass
class Child(Base):
    pass
related = {'base': Base(), 'child': Child()}
assert type(related) is dict[str, Base]
empty = {'a': [], 'b': []}
assert type(empty) is dict[str, list[NoneType]]
annotated: dict[str, Union[int, str]] = {'a': 1, 'b': 'second'}
annotated['c'] = 'third'
assert isinstance(annotated, dict)
reserved: FixedDict = {'args': 1, 'keys': 'value', 'items': [3], 'a;b': 4, '': 5}
assert reserved.keys() == ('args', 'keys', 'items', 'a;b', '')
assert reserved['args'] == 1 and reserved['keys'] == 'value' and reserved[''] == 5
first: FixedDict = {'a;b': 1, 'c': 'first'}
second: FixedDict = {'a': 2, 'b;c': 'second'}
assert first.keys() == ('a;b', 'c') and second.keys() == ('a', 'b;c')
events: list[int] = []
def record(events, label, value):
    events.append(label)
    return value
duplicate: FixedDict = {'a': record(events, 1, 'old'), 'b': record(events, 2, 2),
                        'a': record(events, 3, [3])}
assert events == [1, 2, 3]
assert duplicate.keys() == ('a', 'b') and duplicate['a'] == [3]
print('fixed dictionary literals ok')  #: fixed dictionary literals ok

#%% fixed_dict_repr
single: FixedDict = {'': '\u00e9\n'}
assert repr(single) == repr({'': '\u00e9\n'})
wide: FixedDict = {'ascii': '\u00e9', '\u03a9': '\U0001f600', '\U0001f600': 'plain'}
ordinary = {'ascii': '\u00e9', '\u03a9': '\U0001f600', '\U0001f600': 'plain'}
assert repr(wide) == str(wide) == repr(ordinary)

@tuple
class ReprValue:
    text: str
    events: list[str]

    def __repr__(self):
        self.events.append(self.text)
        if self.text == 'failure':
            raise ValueError('repr failed')
        return self.text

events: list[str] = []
ordered: FixedDict = {'first': ReprValue('one', events), 'second': ReprValue('two', events)}
assert repr(ordered) == "{'first': one, 'second': two}"
assert events == ['one', 'two']
events.clear()
failing: FixedDict = {'first': ReprValue('one', events),
                      'second': ReprValue('failure', events),
                      'third': ReprValue('unreached', events)}
try:
    repr(failing)
    assert False
except ValueError as error:
    assert str(error) == 'repr failed'
assert events == ['one', 'failure']
print('fixed dictionary repr ok')  #: fixed dictionary repr ok

#%% fixed_dict_read_api
mapping: FixedDict = {'number': 42, 'text': 'hello'}
assert 'number' in mapping and 'missing' not in mapping
assert type(mapping.get('number')) is int
assert mapping.get('number') == 42
assert mapping.get('absent', 'fallback') == 'fallback'
assert mapping.get('absent') is None
assert type(mapping.get('absent', 3.5)) is float
assert type(mapping.__getitem__('number')) is int
key: Literal[str] = 'text'
assert mapping[key] == 'hello'
assert type(mapping.get(key, 42)) is str
events: list[int] = []
def default_value(events):
    events.append(1)
    return 'unused'
assert mapping.get('number', default_value(events)) == 42 and events == [1]
def dynamic_contains(mapping, key: str):
    return key in mapping
assert dynamic_contains(mapping, 'number')
assert dynamic_contains(mapping, 'text')
assert not dynamic_contains(mapping, 'missing')
assert len(mapping.values()) == 2 and len(mapping.items()) == 2
seen: list[str] = []
for value in mapping.values():
    seen.append(type(value).__name__)
assert seen == ['int', 'str']
items_seen: list[tuple[str, str]] = []
for key, value in mapping.items():
    items_seen.append((key, type(value).__name__))
assert items_seen == [('number', 'int'), ('text', 'str')]
assert type(mapping.keys()) is tuple[str, str]
assert type(mapping.values()) is tuple[int, str]
assert type(mapping.items()) is tuple[tuple[str, int], tuple[str, str]]
assert tuple(mapping.values()) == (42, 'hello')
assert tuple(mapping) == ('number', 'text')
first, second = mapping
assert first == 'number' and second == 'text'
number, text = mapping.values()
assert type(number) is int and type(text) is str
assert number == 42 and text == 'hello'
def arguments(*args):
    return args
assert arguments(*mapping) == ('number', 'text')
assert arguments(*mapping.values()) == (42, 'hello')
empty: FixedDict = {}
assert not empty and len(empty) == 0
assert list(empty) == []
assert len(list(empty.values())) == 0 and len(list(empty.items())) == 0
assert empty.get('missing') is None and repr(empty) == '{}'
assert not dynamic_contains(empty, 'missing')
print('fixed dictionary reads ok')  #: fixed dictionary reads ok

