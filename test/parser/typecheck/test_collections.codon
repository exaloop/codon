#%% fixed_dict_kwargs
mapping: FixedDict = {'number': 42, 'text': 'hello'}
def target(number: int, text: str):
    return str(number) + text
assert target(**mapping) == '42hello'
def passthrough(**kwargs):
    return kwargs
assert passthrough(**mapping)['text'] == 'hello'
events: list[int] = []
def empty_keywords(events):
    events.append(2)
    empty: FixedDict = {}
    return empty
def argument(events, value):
    events.append(value)
    return value
def ordered_call(events, first, third):
    events.append(4)
    return first + third
assert ordered_call(events, argument(events, 1), **empty_keywords(events),
                    third=argument(events, 3)) == 4
assert events == [1, 2, 3, 4]
events.clear()
assert ordered_call(events, argument(events, 1), *empty_keywords(events),
                    third=argument(events, 3)) == 4
assert events == [1, 2, 3, 4]
print('fixed dictionary kwargs ok')  #: fixed dictionary kwargs ok

#%% named_record_protocols
from collections import namedtuple
from internal.gc import sizeof

Entry = namedtuple('RecordEntry', ('number', 'text'))
OtherEntry = namedtuple('OtherRecordEntry', ('number', 'text'))
entry = Entry(42, 'hello')
other = OtherEntry(42, 'hello')
mapping: FixedDict = {'number': 42, 'text': 'hello'}
def capture(**kwargs):
    return kwargs
keywords = capture(number=42, text='hello')
def accept(number: int, text: str):
    return number, text
def check_fields(record):
    assert accept(**record) == (42, 'hello')
check_fields(entry)
check_fields(mapping)
check_fields(keywords)
assert entry.number == 42 and entry.text == 'hello'
Point = namedtuple('RecordPoint', ('left', 'right'))
point = Point(1, 2)
assert point[0] == 1 and point[-1] == 2
assert list(point) == [1, 2]
assert tuple(entry) == (42, 'hello')
assert type(entry) is not type(other)
assert not isinstance(entry, FixedDict)
assert list(mapping) == ['number', 'text']
assert keywords.keys() == mapping.keys() == ('number', 'text')
assert type(keywords.get('number', 'unused')) is int
assert type(keywords.get('missing', 3.5)) is float
assert keywords.get('missing') is None
assert 'number' in keywords and 'missing' not in keywords
assert repr(keywords) == repr(mapping) == "{'number': 42, 'text': 'hello'}"
assert str(keywords) == str(mapping) == repr(mapping)
assert type(keywords) is type(mapping)
assert isinstance(keywords, FixedDict)
assert keywords['number'] == mapping['number'] == 42
assert not hasattr(keywords, 'number') and not hasattr(mapping, 'number')
assert hasattr(keywords, 'keys') and hasattr(mapping, 'keys')
assert not hasattr(keywords, 'args') and not hasattr(mapping, 'args')
assert not hasattr(keywords, '__keys__') and not hasattr(mapping, '__keys__')
assert not hasattr(keywords, 'missing')
assert list(keywords) == ['number', 'text'] and len(keywords) == 2
assert tuple(keywords.values()) == (42, 'hello')
def accept_mapping(record: FixedDict):
    return record['number'], record['text']
assert accept_mapping(keywords) == accept_mapping(mapping) == (42, 'hello')
assert bool(keywords)
assert sizeof(type(keywords)) == sizeof(type(mapping)) == sizeof(type(entry))
assert sizeof(type(mapping)) == sizeof(type((42, 'hello')))
empty: FixedDict = {}
assert sizeof(type(capture())) == sizeof(type(empty)) == sizeof(type(()))
assert repr(capture()) == str(capture()) == repr(empty) == str(empty) == '{}'
assert type(capture()) is type(empty)
assert not bool(capture())
escaped: FixedDict = {"quote'key": 'line\nslash\\', 'plain': 'value'}
ordinary = {"quote'key": 'line\nslash\\', 'plain': 'value'}
escaped_keywords = capture(**escaped)
assert repr(escaped_keywords) == repr(escaped) == repr(ordinary)
assert str(escaped_keywords) == str(escaped) == str(ordinary)
nested: FixedDict = {'keywords': capture(inner=1), 'mapping': mapping}
nested_keywords = capture(**nested)
expected = "{'keywords': {'inner': 1}, 'mapping': {'number': 42, 'text': 'hello'}}"
assert repr(nested_keywords) == repr(nested) == expected
assert str(nested_keywords) == str(nested) == expected
events: list[int] = []
def observed(events, label, value):
    events.append(label)
    return value
ordered = capture(before=observed(events, 1, 0), **observed(events, 2, entry),
                  after=observed(events, 3, False))
assert events == [1, 2, 3]
assert ordered.keys() == ('before', 'number', 'text', 'after')
assert ordered['number'] == 42 and ordered['text'] == 'hello'
print('named record protocols ok')  #: named record protocols ok

#%% named_record_keyword_fields
from collections import namedtuple

def capture(**kwargs):
    return kwargs
fields = namedtuple('RecordFieldNames', ('_record', '_values', 'args'))
entry = fields(1, 'value', [3])
mapping: FixedDict = {'_record': 1, '_values': 'value', 'args': [3]}
def check_fields(record):
    keywords = capture(**record)
    assert keywords['_record'] == 1
    assert keywords['_values'] == 'value'
    assert keywords['args'] == [3]
    assert keywords.__getitem__('_record') == 1
    assert keywords.__getitem__('args') == [3]
    assert keywords.get('_values') == 'value'
check_fields(entry)
check_fields(mapping)
reserved = capture(args=1, __keys__=2, keys=3, values=4, items=5)
assert reserved.keys() == ('args', '__keys__', 'keys', 'values', 'items')
assert tuple(reserved.values()) == (1, 2, 3, 4, 5)
assert reserved['args'] == 1 and reserved['__keys__'] == 2
assert reserved['keys'] == 3 and reserved['values'] == 4 and reserved['items'] == 5
assert not hasattr(reserved, 'args') and not hasattr(reserved, '__keys__')
assert hasattr(reserved, 'keys') and hasattr(reserved, 'values') and hasattr(reserved, 'items')
print('named record keyword fields ok')  #: named record keyword fields ok

