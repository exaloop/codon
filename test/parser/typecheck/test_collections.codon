#%% named_record_empty_expansion
from collections import namedtuple

Empty = namedtuple('EmptyRecord', ())
def capture(**kwargs):
    return kwargs
def observed(events, label, value):
    events.append(label)
    return value
def accept(first, third):
    return first + third
def check_empty(empty):
    events: list[int] = []
    assert accept(observed(events, 1, 1), **observed(events, 2, empty),
                  third=observed(events, 3, 3)) == 4
    assert events == [1, 2, 3]
    events.clear()
    assert observed(events, 0, accept)(observed(events, 1, 1),
                                       **observed(events, 2, empty),
                                       third=observed(events, 3, 3)) == 4
    assert events == [0, 1, 2, 3]
check_empty(Empty())
empty: FixedDict = {}
check_empty(empty)
check_empty(capture())
print('named record empty expansion ok')  #: named record empty expansion ok

#%% fixed_dict_json
import json

metadata: FixedDict = {'active': True, 'rank': 4}
document: FixedDict = {'name': 'entry', 'numbers': [1, 2, 3], 'metadata': metadata}
assert json.dumps(document) == '{"name": "entry", "numbers": [1, 2, 3], "metadata": {"active": true, "rank": 4}}'
assert json.JSON(document)['numbers'][1].as_int() == 2
empty: FixedDict = {}
assert json.dumps(empty) == '{}'
print('fixed dictionary JSON ok')  #: fixed dictionary JSON ok

