#%% dictionary_unpacking
# **mapping entries retain order, overwrite semantics, and evaluation count.
source = {'a': 1, 'b': 2, 'c': 3}
copied = {**source}
copied = {**copied, 'x': 99, **{'a': 42}}
assert copied == {'a': 42, 'b': 2, 'c': 3, 'x': 99}
assert source == {'a': 1, 'b': 2, 'c': 3}
assert list(copied.keys()) == ['a', 'b', 'c', 'x']
empty: dict[str, int] = {}
assert {**empty, **source, **empty} == source

def record(events, label, value):
    events.append(label)
    return value
events: list[int] = []
combined = {**record(events, 1, {'a': 1}),
            record(events, 2, 'b'): record(events, 3, 2),
            **record(events, 4, {'a': 3})}
assert combined == {'a': 3, 'b': 2} and events == [1, 2, 3, 4]
print('dictionary unpacking ok')  #: dictionary unpacking ok

#%% fixed_dict_literals
from typing import Union

data = {'foo': [1, 2, 3], 'bar': ['x', 'y', 'z']}
assert isinstance(data, FixedDict)
assert type(data['foo']) is list[int] and type(data['bar']) is list[str]
assert len(data) == 2 and bool(data)
assert list(data) == ['foo', 'bar']
assert repr(data) == "{'foo': [1, 2, 3], 'bar': ['x', 'y', 'z']}"
data['foo'].append(4)
assert data['foo'] == [1, 2, 3, 4]
separate = fixed_dict({'a': [], 'b': []})
separate['a'].append(1)
separate['b'].append('second')
assert type(separate['a']) is list[int] and type(separate['b']) is list[str]
factory = fixed_dict
key: Literal[str] = 'first'
aliased = factory({key: [], 'second': []})
aliased[key].append(1)
aliased['second'].append('two')
assert aliased[key] == [1] and aliased['second'] == ['two']
ordinary = {'a': 1, 'b': 2.5}
assert type(ordinary) is dict[str, float]
ordinary['c'] = 3.5
nullable = {'a': None, 'b': 1}
assert type(nullable) is dict[str, Optional[int]]
class Base:
    pass
class Child(Base):
    pass
related = {'base': Base(), 'child': Child()}
assert type(related) is dict[str, Base]
empty = {'a': [], 'b': []}
assert type(empty) is dict[str, list[NoneType]]
annotated: dict[str, Union[int, str]] = {'a': 1, 'b': 'second'}
annotated['c'] = 'third'
assert isinstance(annotated, dict)
reserved = fixed_dict({'args': 1, 'keys': 'value', 'items': [3], 'a;b': 4, '': 5})
assert reserved.keys() == ('args', 'keys', 'items', 'a;b', '')
assert reserved['args'] == 1 and reserved['keys'] == 'value' and reserved[''] == 5
first = fixed_dict({'a;b': 1, 'c': 'first'})
second = fixed_dict({'a': 2, 'b;c': 'second'})
assert first.keys() == ('a;b', 'c') and second.keys() == ('a', 'b;c')
events: list[int] = []
def record(events, label, value):
    events.append(label)
    return value
duplicate = fixed_dict({'a': record(events, 1, 'old'), 'b': record(events, 2, 2),
                        'a': record(events, 3, [3])})
assert events == [1, 2, 3]
assert duplicate.keys() == ('a', 'b') and duplicate['a'] == [3]
print('fixed dictionary literals ok')  #: fixed dictionary literals ok

#%% fixed_dict_read_api
mapping = {'number': 42, 'text': 'hello'}
assert 'number' in mapping and 'missing' not in mapping
assert type(mapping.get('number')) is int
assert mapping.get('number') == 42
assert mapping.get('absent', 'fallback') == 'fallback'
assert mapping.get('absent') is None
assert type(mapping.get('absent', 3.5)) is float
assert type(mapping.__getitem__('number')) is int
key: Literal[str] = 'text'
assert mapping[key] == 'hello'
assert type(mapping.get(key, 42)) is str
events: list[int] = []
def default_value(events):
    events.append(1)
    return 'unused'
assert mapping.get('number', default_value(events)) == 42 and events == [1]
def dynamic_contains(mapping, key: str):
    return key in mapping
assert dynamic_contains(mapping, 'number')
assert dynamic_contains(mapping, 'text')
assert not dynamic_contains(mapping, 'missing')
assert len(mapping.values()) == 2 and len(mapping.items()) == 2
seen: list[str] = []
for value in mapping.values():
    seen.append(type(value).__name__)
assert seen == ['int', 'str']
items_seen: list[tuple[str, str]] = []
for key, value in mapping.items():
    items_seen.append((key, type(value).__name__))
assert items_seen == [('number', 'int'), ('text', 'str')]
assert repr(list(mapping.values())) == "[42, 'hello']"
assert repr(list(mapping.items())) == "[('number', 42), ('text', 'hello')]"
assert tuple(mapping.values()) == (42, 'hello')
assert tuple(mapping) == ('number', 'text')
first, second = mapping
assert first == 'number' and second == 'text'
number, text = mapping.values()
assert type(number) is int and type(text) is str
assert number == 42 and text == 'hello'
def arguments(*args):
    return args
assert arguments(*mapping) == ('number', 'text')
assert arguments(*mapping.values()) == (42, 'hello')
empty = fixed_dict({})
assert not empty and len(empty) == 0
assert list(empty) == []
assert len(list(empty.values())) == 0 and len(list(empty.items())) == 0
assert empty.get('missing') is None and repr(empty) == '{}'
assert not dynamic_contains(empty, 'missing')
print('fixed dictionary reads ok')  #: fixed dictionary reads ok

#%% fixed_dict_spreading
from typing import Union

mapping = {'number': 42, 'text': 'hello'}
merged = {**mapping, 'number': [1, 2], 'extra': False}
assert merged.keys() == ('number', 'text', 'extra')
assert type(merged['number']) is list[int] and merged['text'] == 'hello'
explicit = fixed_dict({'start': 0, **mapping, 'text': [3]})
assert explicit.keys() == ('start', 'number', 'text') and explicit['text'] == [3]
events: list[int] = []
def record(events, label, value):
    events.append(label)
    return value
ordered = fixed_dict({'number': record(events, 1, 'old'),
                      **record(events, 2, mapping), 'text': record(events, 3, [3]),
                      **record(events, 4, fixed_dict({}))})
assert events == [1, 2, 3, 4]
assert ordered['number'] == 42 and ordered['text'] == [3]
regular: dict[str, Union[int, str]] = {**mapping, 'third': 3}
assert isinstance(regular, dict) and regular['text'] == 'hello'
runtime_mapping = {'runtime': 1}
mixed: dict[str, Union[int, str]] = {**mapping, **runtime_mapping}
assert isinstance(mixed, dict) and mixed['runtime'] == 1
print('fixed dictionary spreading ok')  #: fixed dictionary spreading ok

#%% fixed_dict_kwargs
mapping = {'number': 42, 'text': 'hello'}
def target(number: int, text: str):
    return str(number) + text
assert target(**mapping) == '42hello'
def passthrough(**kwargs):
    return kwargs
assert passthrough(**mapping)['text'] == 'hello'
events: list[int] = []
def empty_keywords(events):
    events.append(2)
    return fixed_dict({})
def argument(events, value):
    events.append(value)
    return value
def ordered_call(events, first, third):
    events.append(4)
    return first + third
assert ordered_call(events, argument(events, 1), **empty_keywords(events),
                    third=argument(events, 3)) == 4
assert events == [1, 2, 3, 4]
events.clear()
assert ordered_call(events, argument(events, 1), *empty_keywords(events),
                    third=argument(events, 3)) == 4
assert events == [1, 2, 3, 4]
print('fixed dictionary kwargs ok')  #: fixed dictionary kwargs ok

#%% named_record_protocols
from collections import namedtuple
from internal.gc import sizeof

Entry = namedtuple('RecordEntry', ('number', 'text'))
OtherEntry = namedtuple('OtherRecordEntry', ('number', 'text'))
entry = Entry(42, 'hello')
other = OtherEntry(42, 'hello')
mapping = {'number': 42, 'text': 'hello'}
def capture(**kwargs):
    return kwargs
keywords = capture(number=42, text='hello')
def accept(number: int, text: str):
    return number, text
def check_fields(record):
    assert accept(**record) == (42, 'hello')
check_fields(entry)
check_fields(mapping)
check_fields(keywords)
assert entry.number == 42 and entry.text == 'hello'
Point = namedtuple('RecordPoint', ('left', 'right'))
point = Point(1, 2)
assert point[0] == 1 and point[-1] == 2
assert list(point) == [1, 2]
assert tuple(entry) == (42, 'hello')
assert type(entry) is not type(other)
assert not isinstance(entry, FixedDict)
assert list(mapping) == ['number', 'text']
assert keywords.args == (42, 'hello')
assert keywords.__keys__() == mapping.keys() == ('number', 'text')
assert type(keywords.get('number', 'unused')) is int
assert type(keywords.get('missing', 3.5)) is float
assert keywords.get('missing') is None
assert 'number' in keywords and 'missing' not in keywords
assert repr(keywords) == "(number: 42, text: 'hello')"
assert repr(mapping) == "{'number': 42, 'text': 'hello'}"
assert sizeof(type(keywords)) == sizeof(type(mapping)) == sizeof(type(entry))
assert sizeof(type(mapping)) == sizeof(type((42, 'hello')))
assert sizeof(type(capture())) == sizeof(type(fixed_dict({}))) == sizeof(type(()))
events: list[int] = []
def observed(events, label, value):
    events.append(label)
    return value
ordered = capture(before=observed(events, 1, 0), **observed(events, 2, entry),
                  after=observed(events, 3, False))
assert events == [1, 2, 3]
assert ordered.__keys__() == ('before', 'number', 'text', 'after')
assert ordered['number'] == 42 and ordered['text'] == 'hello'
print('named record protocols ok')  #: named record protocols ok

#%% named_record_keyword_fields
from collections import namedtuple

def capture(**kwargs):
    return kwargs
fields = namedtuple('RecordFieldNames', ('_record', '_values', 'args'))
entry = fields(1, 'value', [3])
mapping = fixed_dict({'_record': 1, '_values': 'value', 'args': [3]})
def check_fields(record):
    keywords = capture(**record)
    assert keywords['_record'] == 1
    assert keywords['_values'] == 'value'
    assert keywords['args'] == [3]
    assert keywords.__getitem__('_record') == 1
    assert keywords.__getitem__('args') == [3]
    assert keywords.get('_values') == 'value'
check_fields(entry)
check_fields(mapping)
print('named record keyword fields ok')  #: named record keyword fields ok

#%% named_record_empty_expansion
from collections import namedtuple

Empty = namedtuple('EmptyRecord', ())
def capture(**kwargs):
    return kwargs
def observed(events, label, value):
    events.append(label)
    return value
def accept(first, third):
    return first + third
def check_empty(empty):
    events: list[int] = []
    assert accept(observed(events, 1, 1), **observed(events, 2, empty),
                  third=observed(events, 3, 3)) == 4
    assert events == [1, 2, 3]
    events.clear()
    assert observed(events, 0, accept)(observed(events, 1, 1),
                                       **observed(events, 2, empty),
                                       third=observed(events, 3, 3)) == 4
    assert events == [0, 1, 2, 3]
check_empty(Empty())
check_empty(fixed_dict({}))
check_empty(capture())
print('named record empty expansion ok')  #: named record empty expansion ok

