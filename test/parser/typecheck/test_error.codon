#%% simd_check_runtime_constructor
from simd import Vec
@export
def runtime_check_constructor(data: List[int], check: bool):
    return Vec[int, 4](data, check=check)
#! no function 'Vec.__new__'
#! during the realization of runtime_check_constructor

#%% simd_check_runtime_lane
from simd import Vec
@export
def runtime_check_lane(value: Vec[int, 4], index: int, check: bool):
    return value.extract(index, check=check)
#! expected static expression
#! during the realization of runtime_check_lane

#%% simd_check_runtime_shift
from simd import Vec
@export
def runtime_check_shift(value: Vec[int, 4], count: int, check: bool):
    return value.lshift(count, check=check)
#! no function 'Vec.lshift'
#! during the realization of runtime_check_shift

#%% functools_cmp_to_key_unhashable
from functools import cmp_to_key

def compare(a: int, b: int) -> int:
    return a - b

key = cmp_to_key(compare)
hash(key(1))
#! unhashable type: '_CmpKey'
#! during the realization of __hash__
#! during the realization of hash
