#%% python
from python import os
print os.curdir  #: .

from python import datetime
z = datetime.datetime.utcfromtimestamp(0)
print z  #: 1970-01-01 00:00:00

#%% python_fixed_dict
from python import builtins

metadata: FixedDict = {'active': True, 'rank': 4}
document: FixedDict = {'name': 'entry', 'numbers': [1, 2, 3], 'metadata': metadata}
converted: pyobj = document
assert builtins.isinstance(converted, builtins.dict)
assert builtins.list(converted.keys()) == ['name', 'numbers', 'metadata']
assert converted['name'] == 'entry' and converted['numbers'][2] == 3
assert converted['metadata']['active'] == True
empty: FixedDict = {}
assert builtins.isinstance(empty, builtins.dict)
def capture(**kwargs):
    return kwargs
keywords = capture(**document)
assert type(keywords) is type(document)
converted_keywords: pyobj = keywords
assert builtins.isinstance(converted_keywords, builtins.dict)
assert converted_keywords == converted
assert builtins.isinstance(capture(), builtins.dict)
python_capture = builtins.eval('lambda *args, **kwargs: (args, kwargs)', builtins.dict())
assert python_capture() == ((), {})
assert python_capture(7) == ((7,), {})
assert python_capture(7, 'eight') == ((7, 'eight'), {})
result = python_capture(7, 'eight', **keywords)
assert result[0] == (7, 'eight') and result[1] == converted
assert builtins.list(result[1].keys()) == ['name', 'numbers', 'metadata']
reserved = capture(values=1, keys=2, __keys__=3)
converted_reserved = python_capture(**reserved)
assert converted_reserved[1] == {'values': 1, 'keys': 2, '__keys__': 3}
ordinary = {'native': 1, 'python': builtins.int(2)}
assert type(ordinary) is dict[str, pyobj]
ordinary['later'] = 'value'
print('fixed dictionary Python conversion ok')  #: fixed dictionary Python conversion ok

#%% python_fixed_dict_conversion_checks
from python import builtins
from python import sys as python_sys
from internal.python import PyDict_SetItem

def collect_python_owners():
    from C import GC_gcollect()
    GC_gcollect()

value = builtins.object()
references = int(python_sys.getrefcount(value))
mapping: FixedDict = {'value': value}
for iteration in range(3):
    converted = mapping.__to_py__()
    pyobj.decref(converted)
collect_python_owners()
assert int(python_sys.getrefcount(value)) == references

@tuple
class FailedConversion:
    def __to_py__(self) -> cobj:
        raise ValueError('value conversion failed')

failing: FixedDict = {'value': value, 'failure': FailedConversion()}
try:
    failing.__to_py__()
    assert False
except ValueError as error:
    assert str(error) == 'value conversion failed'

for iteration in range(3):
    try:
        builtins.dict(value, failure=FailedConversion())
        assert False
    except ValueError as error:
        assert str(error) == 'value conversion failed'
    try:
        builtins.int(value, base=value)
        assert False
    except PyError:
        pass
collect_python_owners()
assert int(python_sys.getrefcount(value)) == references

insertion_status = PyDict_SetItem(value.p, value.p, value.p)
assert insertion_status == i32(-1)
try:
    pyobj.exc_check()
    assert False
except PyError:
    pass
print('fixed dictionary conversion checks ok')  #: fixed dictionary conversion checks ok

#%% python_numpy
from python import numpy as np
a = np.arange(9).reshape(3, 3)
print a
#: [[0 1 2]
#:  [3 4 5]
#:  [6 7 8]]
print a.dtype.name  #: int64
print np.transpose(a)
#: [[0 3 6]
#:  [1 4 7]
#:  [2 5 8]]
n = np.array([[1, 2], [3, 4]])
print n[0], n[0][0] + 1 #: [1 2] 2

a = np.array([1,2,3])
print(a + 1) #: [2 3 4]
print(a - 1) #: [0 1 2]
print(1 - a) #: [ 0 -1 -2]

