#%% python_integer_width
from python import builtins as pybuiltins
for value in [-9223372036854775807 - 1, -4294967296, -1, 0, 4294967296, 9223372036854775807]:
    converted = pybuiltins.int(value)
    assert int(converted) == value
    assert str(converted) == str(value)
try:
    int(pybuiltins.int("9223372036854775808"))
    assert False
except PyError:
    pass
assert int(pybuiltins.int("7")) == 7
