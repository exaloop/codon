import gzip
import bz2
import sys
from internal.str import (
    _encoding_matches,
    _unicode_from_codepoint,
    _unicode_encode_code_with_ownership,
    _ENCODING_UTF8,
    _ENCODING_ASCII,
    _ENCODING_LATIN1,
    _ERROR_STRICT,
    _ERROR_REPLACE,
)
from internal.file import (
    _file_translate_encoded_newlines,
    _FILE_NEWLINE_CR,
)
from C import remove(cobj) -> i32

FIXTURE = "test/stdlib/data/io_fixture.txt"
PREFIX = "build/io-test"


def _latin1_value() -> str:
    return "caf" + _unicode_from_codepoint(0xE9)

def _raw_bytes(values: List[int]) -> bytes:
    data = Ptr[u8](len(values))
    for index in range(len(values)):
        data[index] = u8(values[index])
    return bytes(data, len(values))

@test
def test_encoded_newline_buffer_ownership():
    ascii_value = "a\nb"
    borrowed, uniquely_owned = _unicode_encode_code_with_ownership(
        ascii_value, _ENCODING_UTF8, _ERROR_STRICT
    )
    assert not uniquely_owned
    assert borrowed._ptr == ascii_value._ptr
    translated = _file_translate_encoded_newlines(
        borrowed, _ENCODING_UTF8, _FILE_NEWLINE_CR, uniquely_owned
    )
    assert translated == b"a\rb"
    assert translated._ptr != ascii_value._ptr
    assert ascii_value == "a\nb"

    borrowed, uniquely_owned = _unicode_encode_code_with_ownership(
        ascii_value, _ENCODING_ASCII, _ERROR_REPLACE
    )
    assert not uniquely_owned
    assert borrowed._ptr == ascii_value._ptr

    unicode_value = _latin1_value() + "\n"
    borrowed, uniquely_owned = _unicode_encode_code_with_ownership(
        unicode_value, _ENCODING_LATIN1, _ERROR_STRICT
    )
    assert not uniquely_owned
    assert borrowed._ptr == unicode_value._ptr

    owned, uniquely_owned = _unicode_encode_code_with_ownership(
        unicode_value, _ENCODING_ASCII, _ERROR_REPLACE
    )
    assert uniquely_owned
    assert owned == b"caf?\n"

    owned, uniquely_owned = _unicode_encode_code_with_ownership(
        unicode_value, _ENCODING_UTF8, _ERROR_STRICT
    )
    assert uniquely_owned
    owned_pointer = owned._ptr
    translated = _file_translate_encoded_newlines(
        owned, _ENCODING_UTF8, _FILE_NEWLINE_CR, uniquely_owned
    )
    assert translated._ptr == owned_pointer
    assert translated == (_latin1_value() + "\r").encode()

def _assert_stateful_text_reads(reader):
    first = reader.read(1)
    assert reader.read(0) == ""
    assert reader.tell() == 1
    line = reader.readline()
    assert reader.read(0) == ""
    tail = reader.read()
    assert reader.read() == ""
    assert reader.readline() == ""
    assert reader.read(0) == ""
    assert reader.tell() == 12
    reader.close()

    assert first == "A"
    assert line == _unicode_from_codepoint(0x1F600) + "B\n"
    assert tail == "C\nD\n"

def _assert_mixed_text_iteration(reader):
    iterator = iter(reader)
    assert next(iterator) == "A" + _unicode_from_codepoint(0x1F600) + "B\n"
    assert reader.read(1) == "C"
    assert list(iterator) == ["\n", "D\n"]
    reader.close()


@test
def test_regular_file_basics():
    with open(FIXTURE) as reader:
        assert reader.read() == "alpha\nbeta\ngamma\n"

    path = PREFIX + "-basic.txt"
    writer = open(path, "w")
    assert writer.write("alpha\nbeta\ngamma\n") == 17
    writer.flush()
    assert writer.seekable()
    writer.close()

    reader = open(path)
    assert reader.readline() == "alpha\n"
    assert reader.tell() == 6
    assert reader.read(4) == "beta"
    reader.seek(-4, 1)
    assert reader.read(4) == "beta"
    assert reader.readlines() == ["\n", "gamma\n"]
    assert reader.readline() == ""
    reader.seek(0, 0)
    assert reader.tell() == 0
    assert reader.read(2) == "al"
    assert reader.read() == "pha\nbeta\ngamma\n"
    reader.close()


@test
def test_regular_file_modes_and_read_boundaries():
    path = PREFIX + "-modes.txt"
    writer = open(path, "w")
    writer.write("first")
    writer.close()

    writer = open(path, "w")
    writer.write("second")
    writer.close()
    reader = open(path)
    assert reader.read() == "second"
    reader.close()

    writer = open(path, "a")
    assert writer.write("-third") == 6
    writer.close()
    reader = open(path)
    assert reader.read(0) == ""
    assert reader.tell() == 0
    assert reader.read(-2) == "second-third"
    assert reader.read() == ""
    reader.close()

    binary_path = PREFIX + "-read-boundaries.bin"
    writer = open(binary_path, "wb")
    writer.write(_raw_bytes([0, 1, 2]))
    writer.close()
    reader = open(binary_path, "rb")
    assert reader.read(0) == bytes()
    assert reader.tell() == 0
    assert reader.read(-2) == _raw_bytes([0, 1, 2])
    assert reader.read() == bytes()
    reader.close()

    writer = open(path, "r+")
    assert writer.read(6) == "second"
    writer.seek(0, 0)
    writer.write("FIRST")
    writer.flush()
    writer.close()
    reader = open(path)
    assert reader.read() == "FIRSTd-third"
    reader.close()

    update_path = PREFIX + "-update-buffer.txt"
    with open(update_path, "w") as writer:
        writer.write("abcdef")
    with open(update_path, "r+") as writer:
        assert writer.read(1) == "a"
        assert writer.tell() == 1
        assert writer.write("X") == 1
        assert writer.tell() == 7
    with open(update_path) as reader:
        assert reader.read() == "abcdefX"
    with open(update_path, "r+") as stream:
        assert stream.write("ABC") == 3
        assert stream.read(1) == "d"

    binary_update_path = PREFIX + "-update-buffer.bin"
    with open(binary_update_path, "wb") as writer:
        writer.write(b"abcdef")
    with open(binary_update_path, "rb+") as writer:
        assert writer.read(1) == b"a"
        assert writer.tell() == 1
        assert writer.write(b"X") == 1
        assert writer.tell() == 2
    with open(binary_update_path, "rb") as reader:
        assert reader.read() == b"aXcdef"
    with open(binary_update_path, "rb+") as stream:
        assert stream.write(b"ABC") == 3
        assert stream.read(1) == b"d"

    exclusive_path = PREFIX + "-exclusive.txt"
    remove(exclusive_path.c_str())
    with open(exclusive_path, "x") as writer:
        writer.write("exclusive")
    try:
        open(exclusive_path, "x")
        assert False
    except IOError:
        pass

    for mode in ("br", "tr", "+rb"):
        with open(FIXTURE, mode) as reader:
            assert len(reader.read(1)) == 1

    with open(path, "r") as reader:
        assert reader.seek(1, 0) == 1


@test
def test_large_read_chunks_do_not_alias():
    chunk_size = 65536
    binary_chunk_size = 1024 * 1024
    characters = ["A", "B", "C", "D"]
    text_path = PREFIX + "-retained-chunks.txt"
    with open(text_path, "w", encoding="utf-8", newline="") as writer:
        for character in characters:
            writer.write(character * chunk_size)

    text_chunks = List[str]()
    with open(text_path, "r", encoding="utf-8") as reader:
        while True:
            chunk = reader.read(chunk_size)
            if not chunk:
                break
            text_chunks.append(chunk)

    assert len(text_chunks) == len(characters)
    for index, character in enumerate(characters):
        assert len(text_chunks[index]) == chunk_size
        assert text_chunks[index][0] == character
        assert text_chunks[index][-1] == character

    binary_path = PREFIX + "-retained-chunks.bin"
    with open(binary_path, "wb") as writer:
        for character in characters:
            writer.write(character.encode("ascii") * binary_chunk_size)

    binary_chunks = List[bytes]()
    with open(binary_path, "rb") as reader:
        while True:
            chunk = reader.read(binary_chunk_size)
            if not chunk:
                break
            binary_chunks.append(chunk)

    assert len(binary_chunks) == len(characters)
    for index, character in enumerate(characters):
        expected = character.encode("ascii")[0]
        assert len(binary_chunks[index]) == binary_chunk_size
        assert binary_chunks[index][0] == expected
        assert binary_chunks[index][-1] == expected


@test
def test_stateful_buffering_and_retained_results():
    value = "A" + _unicode_from_codepoint(0x1F600) + "B\r\nC\rD\n"

    path = PREFIX + "-stateful-regular.txt"
    with open(path, "w", newline="") as writer:
        writer.write(value)
    _assert_stateful_text_reads(open(path, "r"))
    _assert_mixed_text_iteration(open(path, "r"))

    gzip_path = PREFIX + "-stateful.gz"
    with gzip.open(gzip_path, "wt", newline="") as writer:
        writer.write(value)
    _assert_stateful_text_reads(gzip.open(gzip_path, "rt"))
    _assert_mixed_text_iteration(gzip.open(gzip_path, "rt"))

    bzip_path = PREFIX + "-stateful.bz2"
    with bz2.open(bzip_path, "wt", newline="") as writer:
        writer.write(value)
    _assert_stateful_text_reads(bz2.open(bzip_path, "rt"))
    _assert_mixed_text_iteration(bz2.open(bzip_path, "rt"))

    flush_path = PREFIX + "-flush-visible.txt"
    writer = open(flush_path, "w")
    writer.write("visible")
    with open(flush_path, "r") as reader:
        assert reader.read() == ""
    writer.flush()
    with open(flush_path, "r") as reader:
        assert reader.read() == "visible"
    writer.write("-tail")
    writer.close()
    with open(flush_path, "r") as reader:
        assert reader.read() == "visible-tail"


@test
def test_regular_file_context_and_closed_errors():
    path = PREFIX + "-closed.txt"
    with open(path, "w") as writer:
        writer.write("value")

    reader = open(path)
    reader.close()
    for operation in (reader.read, reader.readline, reader.tell, reader.flush):
        try:
            operation()
            assert False
        except IOError:
            pass

    writer = open(path, "r")
    try:
        writer.write("nope")
        assert False
    except IOError:
        pass
    writer.close()


@test
def test_regular_file_iteration_and_line_endings():
    path = PREFIX + "-lines.txt"
    writer = open(path, "w", newline="")
    writer.write("one\ntwo\nthree")
    writer.close()

    reader = open(path)
    assert list(reader) == ["one\n", "two\n", "three"]
    assert reader.readlines() == []
    reader.close()

    writer = open(path, "w", newline="")
    writer.write("a\r\nb\rc\n")
    writer.close()
    reader = open(path, newline=None)
    assert reader.readline() == "a\n"
    assert reader.readline() == "b\n"
    assert reader.readline() == "c\n"
    assert reader.readline() == ""
    reader.close()


@test
def test_text_encoding_and_error_modes():
    path = PREFIX + "-latin1.txt"
    value = _latin1_value()

    writer = open(path, "w", encoding="latin-1")
    assert writer.write(value) == len(value)
    writer.close()

    reader = open(path, "r", encoding="latin-1")
    assert reader.read() == value
    reader.close()

    try:
        open(path, "r", encoding="ascii").read()
        assert False
    except ValueError:
        pass

    reader = open(path, "r", encoding="ascii", errors="replace")
    assert reader.read() == "caf" + _unicode_from_codepoint(0xFFFD)
    reader.close()

    reader = open(path, "r", encoding="ascii", errors="ignore")
    assert reader.read() == "caf"
    reader.close()

    append_path = PREFIX + "-utf16-append.txt"
    with open(append_path, "w", encoding="utf-16") as writer:
        writer.write("AB")
    with open(append_path, "a", encoding="utf-16") as writer:
        writer.write("C")
    with open(append_path, "r", encoding="utf-16") as reader:
        assert reader.read() == "ABC"

    empty_append_path = PREFIX + "-utf16-empty-append.txt"
    with open(empty_append_path, "w"):
        pass
    with open(empty_append_path, "a", encoding="utf-16") as writer:
        writer.write("A")
    with open(empty_append_path, "r", encoding="utf-16") as reader:
        assert reader.read() == "A"

    try:
        open(path, "r", encoding="unknown")
        assert False
    except LookupError:
        pass

    unknown_errors = open(path, "r", encoding="latin-1", errors="unknown")
    assert unknown_errors.read() == value
    unknown_errors.close()


@test
def test_lossy_decode_position_round_trip():
    data = _raw_bytes([0x41, 0xFF, 0x42, 0x0D, 0x0A, 0x43])
    replacement = _unicode_from_codepoint(0xFFFD)

    for errors in ("ignore", "replace"):
        suffix = "B\nC" if errors == "ignore" else replacement + "B\nC"

        path = PREFIX + "-lossy-position-" + errors + ".txt"
        with open(path, "wb") as writer:
            writer.write(data)
        with open(path, "r", errors=errors) as reader:
            assert reader.read(1) == "A"
            position = reader.tell()
            assert position == 1
            assert reader.read() == suffix
            assert reader.seek(position, 0) == position
            assert reader.read() == suffix

        gzip_path = PREFIX + "-lossy-position-" + errors + ".gz"
        with gzip.open(gzip_path, "wb") as writer:
            writer.write(data)
        with gzip.open(gzip_path, "rt", errors=errors) as reader:
            assert reader.read(1) == "A"
            position = reader.tell()
            assert position == 1
            assert reader.read() == suffix
            assert reader.seek(position, 0) == position
            assert reader.read() == suffix

        bzip_path = PREFIX + "-lossy-position-" + errors + ".bz2"
        with bz2.open(bzip_path, "wb") as writer:
            writer.write(data)
        with bz2.open(bzip_path, "rt", errors=errors) as reader:
            assert reader.read(1) == "A"
            position = reader.tell()
            assert position == 1
            assert reader.read() == suffix
            assert reader.seek(position, 0) == position
            assert reader.read() == suffix

    malformed = _raw_bytes([0xF0, 0x80, 0x80, 0x80, 0x5A])
    replacement = _unicode_from_codepoint(0xFFFD)
    escaped = _unicode_from_codepoint(0xDCF0)
    escaped_tail = _unicode_from_codepoint(0xDC80) * 3 + "Z"
    for errors in ("replace", "backslashreplace", "surrogateescape"):
        if errors == "replace":
            prefix = replacement
            suffix = replacement * 3 + "Z"
        elif errors == "backslashreplace":
            prefix = "\\"
            suffix = "xf0\\x80\\x80\\x80Z"
        else:
            prefix = escaped
            suffix = escaped_tail

        path = PREFIX + "-lossy-span-" + errors + ".txt"
        with open(path, "wb") as writer:
            writer.write(malformed)
        with open(path, "r", errors=errors) as reader:
            assert reader.read(1) == prefix
            position = reader.tell()
            assert reader.read() == suffix
            assert reader.seek(position, 0) == position
            assert reader.read() == suffix

        gzip_path = PREFIX + "-lossy-span-" + errors + ".gz"
        with gzip.open(gzip_path, "wb") as writer:
            writer.write(malformed)
        with gzip.open(gzip_path, "rt", errors=errors) as reader:
            assert reader.read(1) == prefix
            position = reader.tell()
            assert reader.read() == suffix
            assert reader.seek(position, 0) == position
            assert reader.read() == suffix

        bzip_path = PREFIX + "-lossy-span-" + errors + ".bz2"
        with bz2.open(bzip_path, "wb") as writer:
            writer.write(malformed)
        with bz2.open(bzip_path, "rt", errors=errors) as reader:
            assert reader.read(1) == prefix
            position = reader.tell()
            assert reader.read() == suffix
            assert reader.seek(position, 0) == position
            assert reader.read() == suffix

    utf16_path = PREFIX + "-lossy-utf16.txt"
    utf16_data = _raw_bytes([
        0x41, 0x00, 0x00, 0xD8, 0x42, 0x00,
        0x3D, 0xD8, 0x00, 0xDE, 0x5A, 0x00,
    ])
    with open(utf16_path, "wb") as writer:
        writer.write(utf16_data)
    for errors in ("replace", "backslashreplace"):
        with open(utf16_path, "r", encoding="utf-16-le", errors=errors) as reader:
            assert reader.read(1) == "A"
            if errors == "replace":
                assert reader.read(1) == replacement
                suffix = "B" + _unicode_from_codepoint(0x1F600) + "Z"
            else:
                assert reader.read(1) == "\\"
                suffix = "x00\\xd8B" + _unicode_from_codepoint(0x1F600) + "Z"
            position = reader.tell()
            assert reader.read() == suffix
            assert reader.seek(position, 0) == position
            assert reader.read() == suffix


@test
def test_text_character_count_reads():
    path = PREFIX + "-characters.txt"
    value = "A" + _unicode_from_codepoint(0xE9) + _unicode_from_codepoint(0x3B2)
    value += _unicode_from_codepoint(0x1F600) + "Z"
    writer = open(path, "w")
    writer.write(value)
    writer.close()

    reader = open(path)
    assert reader.read(1) == "A"
    assert reader.read(2) == _unicode_from_codepoint(0xE9) + _unicode_from_codepoint(0x3B2)
    assert reader.read(1) == _unicode_from_codepoint(0x1F600)
    assert reader.read(1) == "Z"
    assert reader.read(1) == ""
    reader.close()


@test
def test_utf16_and_utf32_bounded_reads():
    value = "A" + _unicode_from_codepoint(0xE9) + _unicode_from_codepoint(0x3B2)
    value += _unicode_from_codepoint(0x1F600)
    for encoding in ("utf-16-le", "utf-16-be", "utf-32-le", "utf-32-be"):
        path = PREFIX + "-" + encoding + ".txt"
        writer = open(path, "w", encoding=encoding)
        writer.write(value)
        writer.close()
        reader = open(path, "r", encoding=encoding)
        assert reader.read(1) == "A"
        assert reader.read(1) == _unicode_from_codepoint(0xE9)
        assert reader.read(1) == _unicode_from_codepoint(0x3B2)
        assert reader.read(1) == _unicode_from_codepoint(0x1F600)
        assert reader.read(1) == ""
        reader.close()

    assert _encoding_matches("UTF_16_LE", "utf-16-le")
    assert _encoding_matches("Windows_1252", "windows-1252")
    assert not _encoding_matches("utf-16-be", "utf-16-le")

    for encoding in ("utf-16", "utf-32"):
        path = PREFIX + "-bom-" + encoding + ".txt"
        writer = open(path, "w", encoding=encoding)
        writer.write(value)
        writer.close()
        reader = open(path, "r", encoding=encoding)
        assert reader.read(1) == "A"
        assert reader.read(1) == _unicode_from_codepoint(0xE9)
        assert reader.read(1) == _unicode_from_codepoint(0x3B2)
        assert reader.read(1) == _unicode_from_codepoint(0x1F600)
        assert reader.read(1) == ""
        reader.close()


@test
def test_multibyte_text_readline_and_iteration():
    value = "first\nsecond\n"

    path = PREFIX + "-utf16-lines.txt"
    writer = open(path, "w", encoding="UTF_16_LE")
    writer.write(value)
    writer.close()
    reader = open(path, "r", encoding="utf-16-le")
    assert reader.readline() == "first\n"
    assert list(reader) == ["second\n"]
    reader.close()

    gzip_path = PREFIX + "-utf16-lines.gz"
    writer = gzip.open(gzip_path, "wt", encoding="utf-16-le")
    writer.write(value)
    writer.close()
    reader = gzip.open(gzip_path, "rt", encoding="utf-16-le")
    assert reader.readlines() == ["first\n", "second\n"]
    reader.close()

    bzip_path = PREFIX + "-utf32-lines.bz2"
    writer = bz2.open(bzip_path, "wt", encoding="utf-32-be")
    writer.write(value)
    writer.close()
    reader = bz2.open(bzip_path, "rt", encoding="utf-32-be")
    assert reader.readline() == "first\n"
    assert list(reader) == ["second\n"]
    reader.close()


@test
def test_multibyte_newline_modes_and_long_lines():
    value = "a\r\nb\rc\n"
    path = PREFIX + "-utf16-newline-modes.txt"
    writer = open(path, "w", encoding="utf-16-le", newline="")
    writer.write(value)
    writer.close()

    reader = open(path, "r", encoding="utf-16-le")
    first = reader.readline()
    second = reader.readline()
    third = reader.readline()
    fourth = reader.readline()
    assert first == "a\n"
    assert second == "b\n"
    assert third == "c\n"
    assert fourth == ""
    reader.close()

    reader = open(path, "r", encoding="utf-16-le")
    assert reader.read(2) == "a\n"
    assert reader.read(1) == "b"
    assert reader.read(1) == "\n"
    assert reader.read(1) == "c"
    assert reader.read(1) == "\n"
    reader.close()

    reader = open(path, "r", encoding="utf-16-le", newline="")
    assert reader.readlines() == ["a\r\n", "b\r", "c\n"]
    reader.close()

    reader = open(path, "r", encoding="utf-16-le", newline="\n")
    assert reader.readlines() == ["a\r\n", "b\rc\n"]
    reader.close()

    reader = open(path, "r", encoding="utf-16-le", newline="\r")
    assert reader.readlines() == ["a\r", "\nb\r", "c\n"]
    reader.close()

    reader = open(path, "r", encoding="utf-16-le", newline="\r\n")
    assert reader.readlines() == ["a\r\n", "b\rc\n"]
    reader.close()

    long_line = "x" * 300 + "\n"
    gzip_path = PREFIX + "-long-line.gz"
    writer = gzip.open(gzip_path, "wt", encoding="utf-16-le")
    writer.write(long_line)
    writer.close()
    reader = gzip.open(gzip_path, "rt", encoding="utf-16-le")
    assert reader.readline() == long_line
    reader.close()

    bzip_path = PREFIX + "-long-line.bz2"
    writer = bz2.open(bzip_path, "wt", encoding="utf-32-be")
    writer.write(long_line)
    writer.close()
    reader = bz2.open(bzip_path, "rt", encoding="utf-32-be")
    assert reader.readline() == long_line
    reader.close()

    boundary_value = "\n" + "x" * 65534 + "\r"
    boundary_tail = "x" * 65534 + "\n"

    boundary_path = PREFIX + "-utf16-leading-lf.txt"
    with open(boundary_path, "w", encoding="utf-16-le", newline="") as writer:
        writer.write(boundary_value)
    with open(boundary_path, "r", encoding="utf-16-le") as reader:
        assert reader.readline() == "\n"
        assert reader.readline() == boundary_tail

    gzip_boundary_path = PREFIX + "-utf16-leading-lf.gz"
    with gzip.open(gzip_boundary_path, "wt", encoding="utf-16-le", newline="") as writer:
        writer.write(boundary_value)
    with gzip.open(gzip_boundary_path, "rt", encoding="utf-16-le") as reader:
        assert reader.readline() == "\n"
        assert reader.readline() == boundary_tail

    bzip_boundary_path = PREFIX + "-utf16-leading-lf.bz2"
    with bz2.open(bzip_boundary_path, "wt", encoding="utf-16-le", newline="") as writer:
        writer.write(boundary_value)
    with bz2.open(bzip_boundary_path, "rt", encoding="utf-16-le") as reader:
        assert reader.readline() == "\n"
        assert reader.readline() == boundary_tail


@test
def test_compressed_multibyte_bounded_newline_reads():
    value = "a\r\nb"

    gzip_path = PREFIX + "-utf16-read.gz"
    writer = gzip.open(gzip_path, "wt", encoding="utf-16-le", newline="")
    writer.write(value)
    writer.close()
    reader = gzip.open(gzip_path, "rt", encoding="utf-16-le")
    assert reader.read(2) == "a\n"
    assert reader.read(1) == "b"
    reader.close()

    bzip_path = PREFIX + "-utf32-read.bz2"
    writer = bz2.open(bzip_path, "wt", encoding="utf-32-be", newline="")
    writer.write(value)
    writer.close()
    reader = bz2.open(bzip_path, "rt", encoding="utf-32-be")
    assert reader.read(2) == "a\n"
    assert reader.read(1) == "b"
    reader.close()


@test
def test_compressed_pending_byte_full_reads():
    value = "a\rb"

