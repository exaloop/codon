        pass


@test
def test_gzip_and_bzip_text_apis():
    value = _latin1_value() + "\nnext\n"

    gzip_path = PREFIX + ".gz"
    writer = gzip.open(gzip_path, "wt")
    assert writer.write(value) == len(value)
    writer.close()
    reader = gzip.open(gzip_path, "rt")
    assert reader.readline() == _latin1_value() + "\n"
    assert list(reader) == ["next\n"]
    reader.close()

    bzip_path = PREFIX + ".bz2"
    writer = bz2.open(bzip_path, "wt")
    assert writer.write(value) == len(value)
    writer.close()
    reader = bz2.open(bzip_path, "rt")
    assert reader.read(4) == _latin1_value()
    assert reader.read() == "\nnext\n"
    reader.close()


@test
def test_compression_levels():
    value = b"compression-level-data" * 8192

    gzip_default_path = PREFIX + "-level-default.gz"
    with gzip.open(gzip_default_path, "wb") as writer:
        writer.write(value)
    with open(gzip_default_path, "rb") as reader:
        assert reader.read(9)[8] == u8(2)

    gzip_stored_path = PREFIX + "-level-0.gz"
    with gzip.open(gzip_stored_path, "wb", 0) as writer:
        writer.write(value)
    gzip_best_path = PREFIX + "-level-9.gz"
    with gzip.open(gzip_best_path, "wb", compresslevel=9) as writer:
        writer.write(value)
    with open(gzip_stored_path, "rb") as reader:
        gzip_stored_size = len(reader.read())
    with open(gzip_best_path, "rb") as reader:
        gzip_best_data = reader.read()
    assert gzip_stored_size > len(gzip_best_data)
    assert gzip_best_data[8] == u8(2)
    with gzip.open(gzip_stored_path, "rb") as reader:
        assert reader.read() == value
    with gzip.open(gzip_best_path, "rb") as reader:
        assert reader.read() == value

    gzip_class_path = PREFIX + "-level-class.gz"
    with gzip.GzipFile[bytes](
        gzip_class_path, "wb", compresslevel=1
    ) as writer:
        writer.write(value)
    with open(gzip_class_path, "rb") as reader:
        assert reader.read(9)[8] == u8(4)

    bzip_default_path = PREFIX + "-level-default.bz2"
    with bz2.open(bzip_default_path, "wb") as writer:
        writer.write(value)
    with open(bzip_default_path, "rb") as reader:
        assert reader.read(4) == b"BZh9"

    bzip_fast_path = PREFIX + "-level-1.bz2"
    with bz2.open(bzip_fast_path, "wb", 1) as writer:
        writer.write(value)
    bzip_best_path = PREFIX + "-level-9.bz2"
    with bz2.open(bzip_best_path, "wb", compresslevel=9) as writer:
        writer.write(value)
    with open(bzip_fast_path, "rb") as reader:
        assert reader.read(4) == b"BZh1"
    with open(bzip_best_path, "rb") as reader:
        assert reader.read(4) == b"BZh9"
    with bz2.open(bzip_fast_path, "rb") as reader:
        assert reader.read() == value
    with bz2.open(bzip_best_path, "rb") as reader:
        assert reader.read() == value

    bzip_class_path = PREFIX + "-level-class.bz2"
    with bz2.BZ2File[bytes](
        bzip_class_path, "wb", compresslevel=1
    ) as writer:
        writer.write(value)
    with open(bzip_class_path, "rb") as reader:
        assert reader.read(4) == b"BZh1"

    for compresslevel in (-2, 10):
        try:
            gzip.open(PREFIX + "-invalid-level.gz", "wb", compresslevel)
            assert False
        except ValueError:
            pass
    for compresslevel in (0, 10):
        try:
            bz2.open(PREFIX + "-invalid-level.bz2", "wb", compresslevel)
            assert False
        except ValueError:
            pass
        try:
            bz2.open(bzip_best_path, "rb", compresslevel)
            assert False
        except ValueError:
            pass


@test
def test_compressed_text_configuration():
    value = _latin1_value() + "\nnext\n"
    gzip_path = PREFIX + "-config.gz"
    writer = gzip.open(gzip_path, "wt", encoding="latin-1", newline="\r\n")
    writer.write(value)
    writer.close()
    reader = gzip.open(gzip_path, "rt", encoding="latin-1", newline="")
    assert reader.read() == _latin1_value() + "\r\nnext\r\n"
    reader.close()

    bzip_path = PREFIX + "-config.bz2"
    writer = bz2.open(bzip_path, "wt", encoding="latin-1", newline="\r\n")
    writer.write(value)
    writer.close()
    reader = bz2.open(bzip_path, "rt", encoding="latin-1", newline="")
    assert reader.read() == _latin1_value() + "\r\nnext\r\n"
    reader.close()

    multibyte_value = "a\n" + _unicode_from_codepoint(0x010A) + "\nb"
    multibyte_path = PREFIX + "-config-utf32.bz2"
    writer = bz2.open(
        multibyte_path, "wt", encoding="utf-32-be", newline="\r\n"
    )
    writer.write(multibyte_value)
    writer.close()
    assert multibyte_value == "a\n" + _unicode_from_codepoint(0x010A) + "\nb"
    reader = bz2.open(
        multibyte_path, "rt", encoding="utf-32-be", newline=""
    )
    assert reader.read() == "a\r\n" + _unicode_from_codepoint(0x010A) + "\r\nb"
    reader.close()

    try:
        gzip.open(PREFIX + "-config.gz", "rb", encoding="latin-1")
        assert False
    except ValueError:
        pass


@test
def test_compressed_utf16_and_utf32_bounded_reads():
    value = "A" + _unicode_from_codepoint(0xE9) + _unicode_from_codepoint(0x3B2)

    gzip_path = PREFIX + "-utf16.gz"
    writer = gzip.open(gzip_path, "wt", encoding="utf-16-le")
    writer.write(value)
    writer.close()
    reader = gzip.open(gzip_path, "rt", encoding="utf-16-le")
    assert reader.read(1) == "A"
    assert reader.read(1) == _unicode_from_codepoint(0xE9)
    assert reader.read(1) == _unicode_from_codepoint(0x3B2)
    reader.close()

    gzip_path = PREFIX + "-bom-utf16.gz"
    writer = gzip.open(gzip_path, "wt", encoding="utf-16")
    writer.write(value)
    writer.close()
    reader = gzip.open(gzip_path, "rt", encoding="utf-16")
    assert reader.read(1) == "A"
    assert reader.read(1) == _unicode_from_codepoint(0xE9)
    assert reader.read(1) == _unicode_from_codepoint(0x3B2)
    reader.close()

    bzip_path = PREFIX + "-bom-utf32.bz2"
    writer = bz2.open(bzip_path, "wt", encoding="utf-32")
    writer.write(value)
    writer.close()
    reader = bz2.open(bzip_path, "rt", encoding="utf-32-le")
    assert reader.read(1) == "A"
    assert reader.read(1) == _unicode_from_codepoint(0xE9)
    assert reader.read(1) == _unicode_from_codepoint(0x3B2)
    reader.close()

    bzip_path = PREFIX + "-utf32.bz2"
    writer = bz2.open(bzip_path, "wt", encoding="utf-32-be")
    writer.write(value)
    writer.close()
    reader = bz2.open(bzip_path, "rt", encoding="utf-32-be")
    assert reader.read(1) == "A"
    assert reader.read(1) == _unicode_from_codepoint(0xE9)
    assert reader.read(1) == _unicode_from_codepoint(0x3B2)
    reader.close()

    try:
        bz2.open(PREFIX + "-config.bz2", "wb", newline="\n")
        assert False
    except ValueError:
        pass


@test
def test_compressed_universal_newline_boundaries():
    value = "a\r\nb\rc\n"

    gzip_path = PREFIX + "-newlines.gz"
    writer = gzip.open(gzip_path, "wt", newline="")
    writer.write(value)
    writer.close()
    reader = gzip.open(gzip_path, "rt")
    assert reader.read() == "a\nb\nc\n"
    reader.close()
    reader = gzip.open(gzip_path)
    assert reader.readlines() == [b"a\r\n", b"b\rc\n"]
    reader.close()
    reader = gzip.open(gzip_path)
    assert reader.read(1) == b"a"
    assert reader.read(1) == b"\r"
    assert reader.read(1) == b"\n"
    assert reader.read(1) == b"b"
    assert reader.read(1) == b"\r"
    assert reader.read(1) == b"c"
    assert reader.read(1) == b"\n"
    reader.close()

    bzip_path = PREFIX + "-newlines.bz2"
    writer = bz2.open(bzip_path, "wt", newline="")
    writer.write(value)
    writer.close()
    reader = bz2.open(bzip_path, "rt")
    assert reader.read() == "a\nb\nc\n"
    reader.close()
    reader = bz2.open(bzip_path)
    assert reader.readlines() == [b"a\r\n", b"b\rc\n"]
    reader.close()
    reader = bz2.open(bzip_path)
    assert reader.read(1) == b"a"
    assert reader.read(1) == b"\r"
    assert reader.read(1) == b"\n"
    assert reader.read(1) == b"b"
    assert reader.read(1) == b"\r"
    assert reader.read(1) == b"c"
    assert reader.read(1) == b"\n"
    reader.close()


@test
def test_compressed_binary_and_gzip_position_apis():
    data = _raw_bytes([0, 1, 255, 10])

    gzip_path = PREFIX + "-binary.gz"
    writer = gzip.open(gzip_path, "wb")
    assert writer.write(data) == len(data)
    writer.close()
    reader = gzip.open(gzip_path, "rb")
    assert reader.read(2) == _raw_bytes([0, 1])
    assert reader.tell() == 2
    assert reader.seek(1, 1) == 3
    assert reader.tell() == 3
    assert reader.read(1) == _raw_bytes([10])
    reader.seek(0, 0)
    assert reader.tell() == 0
    assert reader.read() == data
    reader.close()
    reader = gzip.open(gzip_path, "rb")
    assert reader.seek(-1, 2) == len(data) - 1
    assert reader.read() == _raw_bytes([10])
    reader.close()
    reader = gzip.open(gzip_path, "rb")
    assert reader.seek(100, 0) == len(data)
    assert reader.read() == bytes()
    reader.close()
    reader = gzip.open(gzip_path, "rb")
    assert reader.seek(-100, 0) == 0
    assert reader.read(1) == _raw_bytes([0])
    reader.close()

    large_gzip_path = PREFIX + "-large-seek.gz"
    large_data = b"0123456789" * 20000
    with gzip.open(large_gzip_path, "wb") as writer:
        writer.write(large_data)
    with gzip.open(large_gzip_path, "rb") as reader:
        try:
            position = reader.seek(-4, 2)
        except IOError:
            assert False
        assert position == len(large_data) - 4
        assert reader.read() == b"6789"
    with gzip.open(large_gzip_path, "rb") as reader:
        try:
            position = reader.seek(len(large_data) + 100, 0)
        except IOError:
            assert False
        assert position == len(large_data)
        assert reader.read() == bytes()
    with gzip.open(large_gzip_path, "rb") as reader:
        try:
            position = reader.seek(-100, 0)
        except IOError:
            assert False
        assert position == 0
        assert reader.read(4) == b"0123"

    text_path = PREFIX + "-position.bz2"
    writer = bz2.open(text_path, "w")
    writer.write(b"alpha")
    writer.close()
    reader = bz2.open(text_path)
    assert reader.read(2) == b"al"
    assert reader.tell() == 2
    reader.seek(0, 0)
    assert reader.read() == b"alpha"
    reader.close()

    pending_path = PREFIX + "-pending-position.bz2"
    writer = bz2.open(pending_path, "w")
    writer.write(b"a\nb")
    writer.close()
    reader = bz2.open(pending_path)
    assert reader.readline() == b"a\n"
    assert reader.tell() == 2
    assert reader.read(1) == b"b"
    reader.close()

    bzip_path = PREFIX + "-binary.bz2"
    writer = bz2.open(bzip_path, "wb")
    assert writer.write(data) == len(data)
    writer.close()
    reader = bz2.open(bzip_path, "rb")
    assert reader.seekable()
    assert reader.read(2) == _raw_bytes([0, 1])
    assert reader.tell() == 2
    assert reader.seek(0, 0) == 0
    assert reader.tell() == 0
    assert reader.read() == data
    reader.close()
    reader = bz2.open(bzip_path, "rb")
    assert reader.seek(100, 0) == len(data)
    reader.close()
    reader = bz2.open(bzip_path, "rb")
    try:
        position = reader.seek(-100, 0)
    except ValueError:
        assert False
    assert position == 0
    assert reader.read(1) == _raw_bytes([0])
    reader.close()

    reader = bz2.open(bzip_path, "rb")
    assert reader.seek(-1, 2) == len(data) - 1
    assert reader.tell() == len(data) - 1
    assert reader.read() == _raw_bytes([10])
    reader.close()


@test
def test_text_positions_across_translated_crlf():
    path = PREFIX + "-crlf-position.txt"
    with open(path, "w", newline="") as writer:
        writer.write("a\r\nb")
    with open(path, "r") as reader:
        assert reader.read(1) == "a"
        assert reader.tell() == 1
        reader.seek(0, 1)
        assert reader.read(1) == "\n"
        assert reader.tell() == 3

    dense_path = PREFIX + "-dense-crlf-position.txt"
    with open(dense_path, "w", newline="") as writer:
        writer.write("a\r\nb\r\nc\r\nd\r\ne\r\nf")
    with open(dense_path, "r") as reader:
        assert reader.read(1) == "a"
        assert reader.tell() == 1
        assert reader.read(8) == "\nb\nc\nd\ne"
        assert reader.tell() == 13
        assert reader.read(1) == "\n"
        assert reader.tell() == 15

    utf16_path = PREFIX + "-crlf-position-utf16.txt"
    with open(
        utf16_path, "w", encoding="utf-16-le", newline=""
    ) as writer:
        writer.write("a\r\nb")
    with open(utf16_path, "r", encoding="utf-16-le") as reader:
        assert reader.read(1) == "a"
        assert reader.tell() == 2
        assert reader.read(1) == "\n"
        assert reader.tell() == 6

    gzip_path = PREFIX + "-crlf-position.gz"
    with gzip.open(gzip_path, "wt", newline="") as writer:
        writer.write("a\r\nb")
    with gzip.open(gzip_path, "rt") as reader:
        assert reader.read(1) == "a"
        assert reader.tell() == 1
        reader.seek(0, 1)
        assert reader.read(1) == "\n"
        assert reader.tell() == 3

    bzip_path = PREFIX + "-crlf-position.bz2"
    with bz2.open(bzip_path, "wt", newline="") as writer:
        writer.write("a\r\nb")
    with bz2.open(bzip_path, "rt") as reader:
        assert reader.read(1) == "a"
        assert reader.tell() == 1
        reader.seek(0, 1)
        assert reader.read(1) == "\n"
        assert reader.tell() == 3

    boundary_value = "x" * 131071 + "\r\nz"
    boundary_path = PREFIX + "-crlf-position-boundary.txt"
    with open(boundary_path, "w", newline="") as writer:
        writer.write(boundary_value)
    with open(boundary_path) as reader:
        assert reader.read(1) == "x"
        assert len(reader.read(131071)) == 131071
        position = reader.tell()
        assert reader.read() == "z"
        assert reader.seek(position, 0) == position
        assert reader.read() == "z"

    gzip_boundary_path = PREFIX + "-crlf-position-boundary.gz"
    with gzip.open(gzip_boundary_path, "wt", newline="") as writer:
        writer.write(boundary_value)
    with gzip.open(gzip_boundary_path, "rt") as reader:
        assert reader.read(1) == "x"
        assert len(reader.read(131071)) == 131071
        position = reader.tell()
        assert reader.read() == "z"
        assert reader.seek(position, 0) == position
        assert reader.read() == "z"

    bzip_boundary_path = PREFIX + "-crlf-position-boundary.bz2"
    with bz2.open(bzip_boundary_path, "wt", newline="") as writer:
        writer.write(boundary_value)
    with bz2.open(bzip_boundary_path, "rt") as reader:
        assert reader.read(1) == "x"
        assert len(reader.read(131071)) == 131071
        position = reader.tell()
        assert reader.read() == "z"
        assert reader.seek(position, 0) == position
        assert reader.read() == "z"


@test
def test_compressed_modes_and_closed_errors():
    gzip_path = PREFIX + "-lifecycle.gz"
    writer = gzip.open(gzip_path, "w")
    writer.write(b"first")
    writer.flush()
    writer.close()
    writer = gzip.open(gzip_path, "a")
    writer.write(b"-second")
    writer.close()
    reader = gzip.open(gzip_path)
    assert reader.read() == b"first-second"
    reader.close()
    with gzip.open(gzip_path, "br") as reader:
        assert reader.read() == b"first-second"
    with gzip.open(gzip_path, "tr") as reader:
        assert reader.read() == "first-second"

    exclusive_path = PREFIX + "-exclusive.gz"
    remove(exclusive_path.c_str())
    with gzip.open(exclusive_path, "xb") as writer:
        writer.write(b"exclusive")
    try:
        gzip.open(exclusive_path, "xb")
        assert False
    except IOError:
        pass
    for operation in (reader.read, reader.readline, reader.tell, reader.flush):
        try:
            operation()
            assert False
        except IOError:
            pass

    bzip_path = PREFIX + "-lifecycle.bz2"
    writer = bz2.open(bzip_path, "w")
    writer.write(b"value")
    writer.flush()
    writer.close()
    writer = bz2.open(bzip_path, "ab")
    writer.write(b"-second")
    writer.close()
    reader = bz2.open(bzip_path)
    assert reader.read() == b"value-second"
    reader.close()
    with bz2.open(bzip_path, "br") as reader:
        assert reader.read() == b"value-second"
    with bz2.open(bzip_path, "tr") as reader:
        assert reader.read() == "value-second"
    for operation in (reader.read, reader.readline, reader.flush):
        try:
            operation()
            assert False
        except IOError:
            pass

    large_bzip_path = PREFIX + "-large-concatenated.bz2"
    payload = bytearray(20000)
    random_state = 1
    for i in range(len(payload)):
        random_state = (random_state * 1103515245 + 12345) & 0x7FFFFFFF
        payload[i] = random_state & 0xFF
    with bz2.open(large_bzip_path, "wb", 1) as writer:
        writer.write(bytes(payload))
    with bz2.open(large_bzip_path, "ab", 1) as writer:
        writer.write(b"-tail")
    with bz2.open(large_bzip_path, "rb") as reader:
        assert reader.read() == bytes(payload) + b"-tail"

    exclusive_path = PREFIX + "-exclusive.bz2"
    remove(exclusive_path.c_str())
    with bz2.open(exclusive_path, "xb") as writer:
        writer.write(b"exclusive")
    try:
        bz2.open(exclusive_path, "xb")
        assert False
    except IOError:
        pass

    text_seek_path = PREFIX + "-text-end-seek.bz2"
    with bz2.open(text_seek_path, "wt", encoding="utf-8") as writer:
        writer.write("AéβZ")
    with bz2.open(text_seek_path, "rt", encoding="utf-8") as reader:
        assert reader.read(1) == "A"
        assert reader.seek(0, 2) == 6
        assert reader.read() == ""

    try:
        failed_writer = bz2.open("/dev/full", "wb")
    except IOError:
        return
    failed_writer.write(b"close error")
    try:
        failed_writer.close()
        assert False
    except IOError:
        pass


@test
def test_invalid_modes_and_operation_permissions():
    path = PREFIX + "-permissions.txt"
    invalid_modes = ["", "garbage", "rr", "rw", "rbt", "r++"]
    for mode in invalid_modes:
        try:
            open(path, mode)
            assert False
        except ValueError:
            pass
        try:
            gzip.open(path + ".gz", mode)
            assert False
        except ValueError:
            pass
        try:
            bz2.open(path + ".bz2", mode)
            assert False
        except ValueError:
            pass

    for mode in ["r+", "rb+"]:
        try:
            gzip.open(path + ".gz", mode)
            assert False
        except ValueError:
            pass
        try:
            bz2.open(path + ".bz2", mode)
            assert False
        except ValueError:
            pass

    with open(path, "w") as writer:
        writer.write("data")
        try:
            writer.read()
            assert False
        except IOError:
            pass
        try:
            writer.readline()
            assert False
        except IOError:
            pass
    with open(path, "r") as reader:
        try:
            reader.write("data")
            assert False
        except IOError:
            pass

    gzip_path = path + ".gz"
    with gzip.open(gzip_path, "wb") as writer:
        writer.write(b"data")
        try:
            writer.read()
            assert False
        except IOError:
            pass
    with gzip.open(gzip_path, "rb") as reader:
        try:
            reader.write(b"data")
            assert False
        except IOError:
            pass

    bzip_path = path + ".bz2"
    with bz2.open(bzip_path, "wb") as writer:
        writer.write(b"data")
        try:
            writer.read()
            assert False
        except IOError:
            pass
    with bz2.open(bzip_path, "rb") as reader:
        try:
            reader.write(b"data")
            assert False
        except IOError:
            pass


