    assert reader.read() == "b"
    reader.seek(0, 0)
    assert reader.readline() == "a\r"
    reader.close()

    gzip_path = PREFIX + "-pending-text.gz"
    writer = gzip.open(gzip_path, "wt", encoding="utf-16-le", newline="")
    writer.write(value)
    writer.close()
    reader = gzip.open(gzip_path, "rt", encoding="utf-16-le", newline="")
    assert reader.readline() == "a\r"
    assert reader.read() == "b"
    reader.seek(0, 0)
    assert reader.readline() == "a\r"
    reader.close()

    bzip_path = PREFIX + "-pending-text.bz2"
    writer = bz2.open(bzip_path, "wt", encoding="utf-16-le", newline="")
    writer.write(value)
    writer.close()
    reader = bz2.open(bzip_path, "rt", encoding="utf-16-le", newline="")
    assert reader.readline() == "a\r"
    assert reader.read() == "b"
    reader.seek(0, 0)
    assert reader.readline() == "a\r"
    reader.close()

    bzip_path = PREFIX + "-pending.bz2"
    writer = bz2.open(bzip_path, "wt", newline="")
    writer.write(value)
    writer.close()
    reader = bz2.open(bzip_path)
    assert reader.read(1) == b"a"
    assert reader.read(1) == b"\r"
    assert reader.read() == b"b"
    reader.close()


@test
def test_utf8_pending_text_readline():
    long_line = "x" * 131072 + "\n"
    value = "a\n" + long_line + "end"

    path = PREFIX + "-pending-readline.txt"
    with open(path, "w") as writer:
        writer.write(value)
    with open(path) as reader:
        assert reader.read(1) == "a"
        assert reader.readline() == "\n"
        assert reader.readline() == long_line
        assert reader.readline() == "end"

    gzip_path = PREFIX + "-pending-readline.gz"
    with gzip.open(gzip_path, "wt") as writer:
        writer.write(value)
    with gzip.open(gzip_path, "rt") as reader:
        assert reader.read(1) == "a"
        assert reader.readline() == "\n"
        assert reader.readline() == long_line
        assert reader.readline() == "end"

    bzip_path = PREFIX + "-pending-readline.bz2"
    with bz2.open(bzip_path, "wt") as writer:
        writer.write(value)
    with bz2.open(bzip_path, "rt") as reader:
        assert reader.read(1) == "a"
        assert reader.readline() == "\n"
        assert reader.readline() == long_line
        assert reader.readline() == "end"

    pending_value = "0a\r\nb\rc\nd\r\nend\r"
    pending_path = PREFIX + "-pending-readlines.txt"
    with open(pending_path, "w", newline="") as writer:
        writer.write(pending_value)
    with open(pending_path, newline="\n") as reader:
        assert reader.read(1) == "0"
        assert reader.readlines() == ["a\r\n", "b\rc\n", "d\r\n", "end\r"]

    pending_gzip_path = PREFIX + "-pending-readlines.gz"
    with gzip.open(pending_gzip_path, "wt", newline="") as writer:
        writer.write(pending_value)
    with gzip.open(pending_gzip_path, "rt", newline="\n") as reader:
        assert reader.read(1) == "0"
        assert reader.readlines() == ["a\r\n", "b\rc\n", "d\r\n", "end\r"]

    pending_bzip_path = PREFIX + "-pending-readlines.bz2"
    with bz2.open(pending_bzip_path, "wt", newline="") as writer:
        writer.write(pending_value)
    with bz2.open(pending_bzip_path, "rt", newline="\n") as reader:
        assert reader.read(1) == "0"
        assert reader.readlines() == ["a\r\n", "b\rc\n", "d\r\n", "end\r"]


@test
def test_text_newline_read_semantics():
    path = PREFIX + "-newlines.txt"
    writer = open(path, "w", newline="")
    writer.write("a\r\nb\rc\n")
    writer.close()

    reader = open(path, "r")
    assert reader.read() == "a\nb\nc\n"
    reader.close()

    reader = open(path, "r", newline="")
    assert reader.read() == "a\r\nb\rc\n"
    reader.close()

    reader = open(path, "r", newline="\n")
    assert reader.read() == "a\r\nb\rc\n"
    reader.close()

    reader = open(path, "r")
    assert reader.read(1) == "a"
    assert reader.read(1) == "\n"
    assert reader.read(1) == "b"
    assert reader.read(1) == "\n"
    assert reader.read(1) == "c"
    assert reader.read(1) == "\n"
    assert reader.read(1) == ""
    reader.close()

    writer = open(path, "w", newline="")
    writer.write(_latin1_value() + "\r\n")
    writer.close()
    reader = open(path, "r")
    assert reader.read() == _latin1_value() + "\n"
    reader.close()


@test
def test_text_newline_write_semantics():
    path = PREFIX + "-write-newlines.txt"
    value = "a\nb\n"

    writer = open(path, "w", newline="\r\n")
    writer.write(value)
    writer.close()
    assert value == "a\nb\n"
    reader = open(path, "r", newline="")
    assert reader.read() == "a\r\nb\r\n"
    reader.close()

    writer = open(path, "w", newline="\r")
    writer.write(value)
    writer.close()
    assert value == "a\nb\n"
    reader = open(path, "r", newline="")
    assert reader.read() == "a\rb\r"
    reader.close()

    native_newline = "\r\n" if sys.platform == "win32" else "\n"
    native_value = "a" + native_newline + "b"

    native_path = PREFIX + "-write-native-newlines.txt"
    with open(native_path, "w", newline=None) as writer:
        writer.write("a\nb")
    with open(native_path, "rb") as reader:
        assert reader.read() == native_value.encode()

    native_gzip_path = PREFIX + "-write-native-newlines.gz"
    with gzip.open(native_gzip_path, "wt", newline=None) as writer:
        writer.write("a\nb")
    with gzip.open(native_gzip_path, "rb") as reader:
        assert reader.read() == native_value.encode()

    native_bzip_path = PREFIX + "-write-native-newlines.bz2"
    with bz2.open(native_bzip_path, "wt", newline=None) as writer:
        writer.write("a\nb")
    with bz2.open(native_bzip_path, "rb") as reader:
        assert reader.read() == native_value.encode()

    native_utf16_path = PREFIX + "-write-native-newlines-utf16.txt"
    with open(
        native_utf16_path,
        "w",
        encoding="utf-16-le",
        newline=None,
    ) as writer:
        writer.write("a\nb")
    with open(
        native_utf16_path,
        "r",
        encoding="utf-16-le",
        newline="",
    ) as reader:
        assert reader.read() == native_value

    utf16_path = PREFIX + "-write-newlines-utf16.txt"
    utf16_value = "a\n" + _unicode_from_codepoint(0x010A) + "\nb"
    writer = open(utf16_path, "w", encoding="utf-16-le", newline="\r\n")
    writer.write(utf16_value)
    writer.close()
    assert utf16_value == "a\n" + _unicode_from_codepoint(0x010A) + "\nb"
    reader = open(utf16_path, "r", encoding="utf-16-le", newline="")
    assert reader.read() == "a\r\n" + _unicode_from_codepoint(0x010A) + "\r\nb"
    reader.close()

    replacement_path = PREFIX + "-write-newlines-utf16-replace.txt"
    replacement_value = _unicode_from_codepoint(0xD800) + "\n"
    with open(
        replacement_path,
        "w",
        encoding="utf-16-le",
        errors="replace",
        newline="\r\n",
    ) as writer:
        writer.write(replacement_value)
    with open(replacement_path, "rb") as reader:
        assert reader.read() == _raw_bytes([0x3F, 0, 0x0D, 0, 0x0A, 0])

    try:
        open(path, "w", newline="invalid")
        assert False
    except ValueError:
        pass


@test
def test_binary_mode_and_text_argument_validation():
    path = PREFIX + "-binary.bin"
    data = _raw_bytes([0, 1, 255, 10])

    writer = open(path, "wb")
