        unicode("%5.2") % 1.0
        assert False
    except ValueError:
        pass


@test
def test_percent_flags_odd_orders():
    assert unicode("%-+8d") % 12 == unicode("+12     ")
    assert unicode("%+-8d") % 12 == unicode("+12     ")
    assert unicode("%0+8d") % 12 == unicode("+0000012")
    assert unicode("%+08d") % 12 == unicode("+0000012")
    assert unicode("%#08x") % 42 == unicode("0x00002a")
    assert unicode("%0#8x") % 42 == unicode("0x00002a")
    assert unicode("%-#8x") % 42 == unicode("0x2a    ")
    assert unicode("%#-8x") % 42 == unicode("0x2a    ")
    assert unicode("%--5d") % 12 == unicode("12   ")
    assert unicode("%++d") % 12 == unicode("+12")
    assert unicode("%  d") % 12 == unicode(" 12")
    assert unicode("%##x") % 15 == unicode("0xf")
    assert unicode("%0005d") % 12 == unicode("00012")


@test
def test_percent_length_modifiers():
    assert unicode("%hd") % 12 == unicode("12")
    assert unicode("%ld") % 12 == unicode("12")
    assert unicode("%Ld") % 12 == unicode("12")
    assert unicode("%hi") % -12 == unicode("-12")
    assert unicode("%lu") % 12 == unicode("12")
    assert unicode("%lx") % 255 == unicode("ff")
    assert unicode("%lX") % 255 == unicode("FF")
    assert unicode("%lo") % 8 == unicode("10")
    assert unicode("%lf") % 1.25 == unicode("1.250000")
    assert unicode("%Le") % 1.25 == unicode("1.250000e+00")


@test
def test_percent_bools():
    assert unicode("%d") % True == unicode("1")
    assert unicode("%d") % False == unicode("0")
    assert unicode("%i") % True == unicode("1")
    assert unicode("%x") % True == unicode("1")
    assert unicode("%o") % False == unicode("0")
    assert unicode("%s") % True == unicode("True")
    assert unicode("%r") % False == unicode("False")
    assert unicode("%f") % True == unicode("1.000000")


@test
def test_percent_embedded_nulls():
    assert unicode("%s") % unicode("a\x00b") == unicode("a\x00b")
    assert unicode("%.2s") % unicode("a\x00b") == unicode("a\x00")
    assert unicode("%5s") % unicode("a\x00b") == unicode("  a\x00b")
    assert unicode("x%sx") % unicode("\x00") == unicode("x\x00x")
    assert unicode("%c") % 0 == unicode("\x00")


@test
def test_percent_unicode_content():
    assert unicode("%s") % unicode("λ") == unicode("λ")
    assert unicode("%s") % unicode("😀") == unicode("😀")
    assert unicode("%.1s") % unicode("λx") == unicode("λ")
    assert unicode("%.1s") % unicode("😀x") == unicode("😀")
    assert unicode("%3s") % unicode("λ") == unicode("  λ")
    assert unicode("%3s") % unicode("😀") == unicode("  😀")
    assert unicode("%c") % 0x03BB == unicode("λ")
    assert unicode("%c") % 0x1F600 == unicode("😀")


@test
def test_percent_literal_percent_corner_cases():
    assert unicode("%%%%") % () == unicode("%%")
    assert unicode("%%%%%%") % () == unicode("%%%")
    assert unicode("a%%b") % () == unicode("a%b")
    assert unicode("%%s") % () == unicode("%s")
    assert unicode("%%%s") % unicode("x") == unicode("%x")
    assert unicode("%s%%") % unicode("x") == unicode("x%")
    assert unicode("%%%s%%") % unicode("x") == unicode("%x%")
    assert unicode("%%%(x)s%%") % {
        unicode("x"): unicode("a")
    } == unicode("%a%")


@test
def test_percent_large_width_precision():
    assert unicode("%50d") % 1 == unicode(" ") * 49 + unicode("1")
    assert unicode("%-50d") % 1 == unicode("1") + unicode(" ") * 49
    assert unicode("%050d") % 1 == unicode("0") * 49 + unicode("1")
    assert unicode("%.50d") % 1 == unicode("0") * 49 + unicode("1")
    assert unicode("%.50s") % unicode("abc") == unicode("abc")

    expected = unicode("1.") + unicode("0") * 50
    assert unicode("%.50f") % 1.0 == expected
    assert unicode("%60.50f") % 1.0 == unicode(" ") * 8 + expected
    assert unicode("%-60.50f") % 1.0 == expected + unicode(" ") * 8


@test
def test_percent_numeric_coercions():
    assert unicode("%d") % 1.0 == unicode("1")
    assert unicode("%i") % -1.0 == unicode("-1")
    assert unicode("%u") % 12.0 == unicode("12")
    assert unicode("%d") % 1.9 == unicode("1")
    assert unicode("%d") % -1.9 == unicode("-1")
    assert unicode("%f") % 1 == unicode("1.000000")
    assert unicode("%e") % 1 == unicode("1.000000e+00")
    assert unicode("%g") % 1 == unicode("1")


@test
def test_percent_mapping_positional_mixing_errors():
    d = {unicode("x"): 12}
    assert unicode("%(x)d") % d == unicode("12")

    try:
        unicode("%(x)*d") % d
        assert False
    except TypeError:
        pass

    try:
        unicode("%(x).*f") % {unicode("x"): 1.25}
        assert False
    except TypeError:
        pass

    try:
        unicode("%(x)s %s") % (
            {unicode("x"): unicode("a")},
            unicode("b"),
        )
        assert False
    except TypeError:
        pass


@test
def test_percent_regression_combinations():
    assert unicode("[%10s]") % unicode("x") == unicode("[         x]")
    assert unicode("[%-10s]") % unicode("x") == unicode("[x         ]")
    assert unicode("[%010d]") % -123 == unicode("[-000000123]")
    assert unicode("[%+10.3f]") % 1.25 == unicode("[    +1.250]")
    assert unicode("[%-+10.3f]") % 1.25 == unicode("[+1.250    ]")
    assert unicode("[%#10x]") % 255 == unicode("[      0xff]")
    assert unicode("[%-#10x]") % 255 == unicode("[0xff      ]")
    assert unicode("[%#010x]") % 255 == unicode("[0x000000ff]")
    assert unicode("[%10.4s]") % unicode("abcdefgh") == unicode("[      abcd]")

    assert unicode("%d:%#x:%#o:%.2f:%s") % (
        -17, 255, 8, 1.25, unicode("done")
    ) == unicode("-17:0xff:0o10:1.25:done")


@test
def test_percent_cpython_adversarial_matrix():
    minimum = -(1 << 63)

    numeric_cases = (
        (unicode("%+#018x"), -0x1234, unicode("-0x000000000001234")),
        (unicode("%#024o"), minimum, unicode("-0o1000000000000000000000")),
        (unicode("%+020.4e"), 1.25, unicode("+0000000001.2500e+00")),
        (unicode("%#.0g"), 1000000.0, unicode("1.e+06")),
        (unicode("%#08.0f"), float("inf"), unicode("00000inf")),
        (unicode("%+#08.0F"), float("nan"), unicode("+0000NAN")),
    )

    for format, value, expected in numeric_cases:
        assert format % value == expected

    unicode_cases = (
        (unicode("%7s"), unicode("a"), unicode("      a")),
        (unicode("%4.2s"), unicode("éΩx"), unicode("  éΩ")),
        (unicode("%.0s"), unicode("é"), unicode("")),
        (unicode("%12.3r"), unicode("éΩx"), unicode("         'éΩ")),
        (unicode("%12.6a"), unicode("café"), unicode("      'caf\\x")),
    )

    for format, value, expected in unicode_cases:
        assert format % value == expected

    assert unicode("%*.*f|%*s|%+06d") % (
        8,
        3,
        1.25,
        5,
        unicode("x"),
        42,
    ) == unicode("   1.250|    x|+00042")

    slash = unicode("\\")
    assert unicode("pre (%%%s) \\ %r \n %a") % (
        unicode("x"),
        unicode("a\tb"),
        unicode("é\nΩ"),
    ) == (
        unicode("pre (%x) ")
        + slash
        + unicode(" 'a")
        + slash
        + unicode("tb' \n '")
        + slash
        + unicode("xe9")
        + slash
        + unicode("n")
        + slash
        + unicode("u03a9'")
    )

    assert unicode("") % () == unicode("")
    assert unicode("%%") % () == unicode("%")
    assert unicode("%s|%d|%.1f") % (unicode(""), 0, -0.0) == unicode(
        "|0|-0.0"
    )
    assert unicode("<%s>|<%.0s>|<%r>") % (
        unicode("\x00"),
        unicode("\x00"),
        unicode(""),
    ) == unicode("<\x00>|<>|<''>")

    assert unicode("%10000d") % 1 == unicode(" " * 9999 + "1")
    assert unicode("%010000.1f") % 12.5 == unicode("0" * 9996 + "12.5")
    assert unicode("%1005.1000f") % 1.0 == unicode(
        " " * 3 + "1." + "0" * 1000
    )

    malformed_formats = (
        unicode("%"),
        unicode("%..2f"),
        unicode("%08.2.1f"),
        unicode("%q"),
        unicode("%(name"),
    )

    for format in malformed_formats:
        try:
            format % 1
            assert False
        except ValueError:
            pass


@test
def test_bytes_percent_format():
    raw = _raw_bytes([0x00, 0x7F, 0x80, 0xFF])
    percent_b = bytes("%b", "ascii")
    percent_s = bytes("%s", "ascii")

    assert percent_b % raw == raw
    assert percent_s % raw == raw
    assert bytes("%.2b", "ascii") % raw == _raw_bytes([0x00, 0x7F])
    assert bytes("%6s", "ascii") % raw == bytes("  ", "ascii") + raw
    assert bytes("%-6s", "ascii") % raw == raw + bytes("  ", "ascii")

    assert bytes("%r", "ascii") % _raw_bytes([0xFF]) == bytes(
        "b'\\xff'", "ascii"
    )
    assert bytes("%a", "ascii") % unicode("é") == bytes("'\\xe9'", "ascii")
    assert bytes("%c", "ascii") % 0xFF == _raw_bytes([0xFF])
    assert bytes("%c", "ascii") % bytes("Z", "ascii") == bytes("Z", "ascii")
    assert bytes("%.*s", "ascii") % (-1, bytes("abc", "ascii")) == bytes()
    assert bytes("%.*f", "ascii") % (-1, 1.75) == bytes("2", "ascii")
    assert bytes("%.*c", "ascii") % (-1, 65) == bytes("A", "ascii")

    assert bytes("%+06d:%#x:%.2f", "ascii") % (42, 255, 1.25) == bytes(
        "+00042:0xff:1.25", "ascii"
    )
    assert bytes("%*.*f|%*b", "ascii") % (
        8,
        3,
        1.25,
        5,
        bytes("x", "ascii"),
    ) == bytes("   1.250|    x", "ascii")
    assert bytes("a%%b", "ascii") % () == bytes("a%b", "ascii")


@test
def test_bytes_percent_mapping():
    key = bytes("name", "ascii")
    value = _raw_bytes([0x80, 0xFF])
    mapping = {key: value}

    assert bytes("%(name)b", "ascii") % mapping == value
    assert bytes("[%(name)4s]", "ascii") % mapping == (
        bytes("[  ", "ascii") + value + bytes("]", "ascii")
    )


@test
def test_bytes_percent_format_errors():
    try:
        bytes("%b", "ascii") % unicode("text")
        assert False
    except TypeError:
        pass

    try:
        bytes("%c", "ascii") % 256
        assert False
    except OverflowError:
        pass

    try:
        bytes("%c", "ascii") % bytes("ab", "ascii")
        assert False
    except TypeError:
        pass

    try:
        bytes("%d %d", "ascii") % (1,)
        assert False
    except TypeError:
        pass

    try:
        bytes("%q", "ascii") % 1
        assert False
    except ValueError:
        pass


@test
def test_bytes_search_algorithms():
    value = _raw_bytes([0x00, 0xFF, 0x61, 0x00, 0xFF, 0x61])
    needle = _raw_bytes([0x00, 0xFF])

    assert value.find(needle) == 0
    assert value.find(needle, 1) == 3
    assert value.rfind(needle) == 3
    assert value.count(needle) == 2
    assert value.find(bytes()) == 0
    assert value.rfind(bytes()) == len(value)
    assert value.count(bytes()) == len(value) + 1
    assert value.replace(needle, _raw_bytes([0x42]), 1) == _raw_bytes(
        [0x42, 0x61, 0x00, 0xFF, 0x61]
    )


