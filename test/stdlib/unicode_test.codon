# Regression tests for format.codon CPython compatibility fixes.

@test
def test_percent_length_modifiers():
    assert "%hd" % 12 == "12"
    assert "%ld" % 12 == "12"
    assert "%Ld" % 12 == "12"

    try:
        "%lld" % 12
        assert False
    except ValueError:
        pass

    try:
        "%hhd" % 12
        assert False
    except ValueError:
        pass

    try:
        "%LLf" % 1.0
        assert False
    except ValueError:
        pass


@test
def test_percent_c_allows_surrogates():
    s = "%c" % 0xD800
    assert len(s) == 1
    assert ord(s) == 0xD800

    s = "{:c}".format(0xDFFF)
    assert len(s) == 1
    assert ord(s) == 0xDFFF

    try:
        "%c" % 0x110000
        assert False
    except OverflowError:
        pass

    try:
        "{:c}".format(-1)
        assert False
    except OverflowError:
        pass


@test
def test_percent_mapping_can_be_positional_operand():
    d = {"x": "value"}

    assert "%s" % d == str(d)
    assert "%r" % d == repr(d)
    assert "%s %(x)s" % d == str(d) + " value"
    assert "%% %s" % d == "% " + str(d)

    try:
        "%(x)s %s" % d
        assert False
    except TypeError:
        pass

    try:
        "%s %s" % d
        assert False
    except TypeError:
        pass


@test
def test_bytes_percent_mapping_positional_rules():
    d = {b"x": b"value"}

    assert b"%r" % d == bytes(repr(d), "ascii")
    assert b"%r %(x)s" % d == bytes(repr(d), "ascii") + b" value"

    try:
        b"%(x)s %r" % d
        assert False
    except TypeError:
        pass

    # A mapping is not itself a bytes-like value for %s/%b.
    try:
        b"%s" % d
        assert False
    except TypeError:
        pass


@test
def test_brace_rejects_percent_only_i_u_codes():
    for spec in ("i", "u"):
        try:
            format(1, spec)
            assert False
        except ValueError:
            pass

        try:
            format(1.25, spec)
            assert False
        except ValueError:
            pass


@test
def test_default_float_zero_padding_is_sign_aware():
    assert format(-1.2, "08") == "-00001.2"
    assert format(-0.0, "08") == "-00000.0"
    assert format(1.2, "08") == "000001.2"
    assert format(1.2, "+08") == "+00001.2"
    assert format(1.2, " 08") == " 00001.2"

    assert "{:08}".format(-1.2) == "-00001.2"
    assert "{:08}".format(-0.0) == "-00000.0"


@test
def test_underscore_grouping_decimal_vs_nondecimal():
    assert format(123456789, "_") == "123_456_789"
    assert format(123456789, "_d") == "123_456_789"
    assert format(1234567.89, "_") == "1_234_567.89"
    assert format(1234567.89, "_.2f") == "1_234_567.89"

    # Non-decimal integer formats group by four.
    assert format(0x75BCD15, "_x") == "75b_cd15"
    assert format(0o726746425, "_o") == "7_2674_6425"
    assert format(0b111010110111100110100010101, "_b") == (
        "111_0101_1011_1100_1101_0001_0101"
    )


@test
def test_comma_nondecimal_is_rejected():
    for spec in (",b", ",o", ",x", ",X"):
        try:
            format(123, spec)
            assert False
        except ValueError:
            pass


@test
def test_zero_padding_with_grouping():
    assert format(-1.2, "010,") == "-000,001.2"
    assert format(-1.2, "0=10,") == "-000,001.2"
    assert format(1234, "010_d") == "00_001_234"


@test
def test_unicode_fill_and_character_width():
    assert format("x", "🦄^5") == "🦄🦄x🦄🦄"
    assert format("é", ">3") == "  é"
    assert format("é", ".1s") == "é"


@test
def test_percent_regressions_baseline():
    assert "%#o" % 8 == "0o10"
    assert "%.0d" % 0 == "0"
    assert "%05.3d" % 1 == "00001"
    assert "%#05x" % 1 == "0x001"
    assert "%+05d" % 1 == "+0001"
    assert "%05s" % "x" == "    x"
    assert "%05c" % 65 == "    A"
    assert "%*s" % (-5, "x") == "x    "
    assert "%.*s" % (-1, "abc") == ""


@test
def test_brace_regressions_baseline():
    assert format("x", "05") == "x0000"
    assert format("x", "0>5") == "0000x"
    assert format("x", "^5") == "  x  "
    assert format(-1, "0=5d") == "-0001"
    assert format(-1, "#06x") == "-0x001"
    assert format(123456789, ",d") == "123,456,789"
    assert format(1234567.89, ",.2f") == "1,234,567.89"


@test
def test_invalid_string_specs():
    for spec in ("=5", "-5", "+5", "z", "#5", ",5"):
        try:
            format("x", spec)
            assert False
        except ValueError:
            pass


test_percent_length_modifiers()
test_percent_c_allows_surrogates()
test_percent_mapping_can_be_positional_operand()
test_bytes_percent_mapping_positional_rules()
test_brace_rejects_percent_only_i_u_codes()
test_default_float_zero_padding_is_sign_aware()
test_underscore_grouping_decimal_vs_nondecimal()
test_comma_nondecimal_is_rejected()
test_zero_padding_with_grouping()
test_unicode_fill_and_character_width()
test_percent_regressions_baseline()
test_brace_regressions_baseline()
test_invalid_string_specs()


# File I/O tests

from gzip import open as gzopen
from bz2 import open as bzopen


@test
def test_file_context_manager_returns_self():
    path = "build/file_context_manager.txt"
    with open(path, "w") as f:
        assert f is not None
        assert f.write("hello") == 5

    with open(path, "r") as f:
        assert f.read() == "hello"


@test
def test_binary_readline_only_splits_on_lf():
    path = "build/file_binary_readline.bin"
    with open(path, "wb") as f:
        f.write(b"a\rb\nc")

    with open(path, "rb") as f:
        assert f.readline() == b"a\rb\n"
        assert f.readline() == b"c"
        assert f.readline() == b""


@test
def test_text_readline_newline_modes():
    path = "build/file_newline_modes.txt"
    with open(path, "wb") as f:
        f.write(b"a\rb\r\nc\n")

    with open(path, "r", newline=None) as f:
        assert f.readline() == "a\n"
        assert f.readline() == "b\n"
        assert f.readline() == "c\n"

    with open(path, "r", newline="") as f:
        assert f.readline() == "a\r"
        assert f.readline() == "b\r\n"
        assert f.readline() == "c\n"

    with open(path, "r", newline="\n") as f:
        assert f.readline() == "a\rb\r\n"
        assert f.readline() == "c\n"

    with open(path, "r", newline="\r") as f:
        assert f.readline() == "a\r"
        assert f.readline() == "b\r"
        assert f.readline() == "\nc\n"

    with open(path, "r", newline="\r\n") as f:
        assert f.readline() == "a\rb\r\n"
        assert f.readline() == "c\n"


@test
def test_gzip_and_bzip_newline_empty_mode():
    gz_path = "build/file_newline_modes.gz"
    bz_path = "build/file_newline_modes.bz2"
    data = b"a\rb\r\nc\n"

    with gzopen(gz_path, "wb") as f:
        f.write(data)
    with gzopen(gz_path, "rt", newline="") as f:
        assert f.readline() == "a\r"
        assert f.readline() == "b\r\n"
        assert f.readline() == "c\n"

    with bzopen(bz_path, "wb") as f:
        f.write(data)
    with bzopen(bz_path, "rt", newline="") as f:
        assert f.readline() == "a\r"
        assert f.readline() == "b\r\n"
        assert f.readline() == "c\n"


@test
def test_utf16_bom_written_once_file():
    path = "build/file_utf16_once.txt"
    with open(path, "w", encoding="utf-16") as f:
        f.write("A")
        f.write("B")

    with open(path, "rb") as f:
        data = f.read()

    assert data == b"\xff\xfeA\x00B\x00"


@test
def test_utf32_bom_written_once_file():
    path = "build/file_utf32_once.txt"
    with open(path, "w", encoding="utf-32") as f:
        f.write("A")
        f.write("B")

    with open(path, "rb") as f:
        data = f.read()

    assert data == b"\xff\xfe\x00\x00A\x00\x00\x00B\x00\x00\x00"


@test
def test_utf16_compressed_writer_matches_python():
    gz_path = "build/file_utf16_once.gz"
    bz_path = "build/file_utf16_once.bz2"

    # gzip's text wrapper is seekable, so generic UTF-16 emits its BOM once.
    with gzopen(gz_path, "wt", encoding="utf-16") as f:
        f.write("A")
        f.write("B")
    with gzopen(gz_path, "rb") as f:
        assert f.read() == b"\xff\xfeA\x00B\x00"

    # CPython's writable BZ2File is non-seekable. TextIOWrapper therefore
    # uses the native-endian UTF-16 encoder without writing a BOM.
    with bzopen(bz_path, "wt", encoding="utf-16") as f:
        f.write("A")
        f.write("B")
    with bzopen(bz_path, "rb") as f:
        assert f.read() == b"A\x00B\x00"


@test
def test_utf32_compressed_writer_matches_python():
    gz_path = "build/file_utf32_once.gz"
    bz_path = "build/file_utf32_once.bz2"

    with gzopen(gz_path, "wt", encoding="utf-32") as f:
        f.write("A")
        f.write("B")
    with gzopen(gz_path, "rb") as f:
        assert f.read() == b"\xff\xfe\x00\x00A\x00\x00\x00B\x00\x00\x00"

    with bzopen(bz_path, "wt", encoding="utf-32") as f:
        f.write("A")
        f.write("B")
    with bzopen(bz_path, "rb") as f:
        assert f.read() == b"A\x00\x00\x00B\x00\x00\x00"


@test
def test_utf16_stream_requires_bom():
    path = "build/file_utf16_no_bom.txt"
    with open(path, "wb") as f:
        f.write(b"A\x00")

    try:
        with open(path, "r", encoding="utf-16") as f:
            f.read()
        assert False
    except ValueError:
        pass


@test
def test_empty_utf16_stream_is_allowed():
    path = "build/file_utf16_empty.txt"
    with open(path, "wb") as f:
        pass

    with open(path, "r", encoding="utf-16") as f:
        assert f.read() == ""


@test
def test_utf16_seek_zero_resets_bom_state():
    path = "build/file_utf16_seek.txt"
    with open(path, "w", encoding="utf-16") as f:
        f.write("AB")

    with open(path, "r", encoding="utf-16") as f:
        assert f.read(1) == "A"
        f.seek(0, 0)
        assert f.read(1) == "A"
        assert f.read(1) == "B"


@test
def test_utf16_seek_zero_resets_bom_state_compressed():
    gz_path = "build/file_utf16_seek.gz"
    bz_path = "build/file_utf16_seek.bz2"
    payload = b"\xff\xfeA\x00B\x00"

    # Write the encoded payload explicitly so this test is about decoder/seek
    # state, not the different TextIOWrapper write behavior of gzip vs. bz2.
    with gzopen(gz_path, "wb") as f:
        f.write(payload)
    with gzopen(gz_path, "rt", encoding="utf-16") as f:
        assert f.read(1) == "A"
        f.seek(0, 0)
        assert f.read(1) == "A"
        assert f.read(1) == "B"

    with bzopen(bz_path, "wb") as f:
        f.write(payload)
    with bzopen(bz_path, "rt", encoding="utf-16") as f:
        assert f.read(1) == "A"
        f.seek(0, 0)
        assert f.read(1) == "A"
        assert f.read(1) == "B"


@test
def test_read_n_characters_with_ignore_errors():
    path = "build/file_ignore_read.txt"
    with open(path, "wb") as f:
        f.write(b"\xffAB")

    with open(path, "r", encoding="ascii", errors="ignore") as f:
        assert f.read(1) == "A"
        assert f.read(1) == "B"
        assert f.read(1) == ""


@test
def test_readline_skips_ignored_decode_errors():
    path = "build/file_ignore_readline.txt"
    with open(path, "wb") as f:
        f.write(b"\xffA\nB\n")

    with open(path, "r", encoding="ascii", errors="ignore") as f:
        assert f.readline() == "A\n"
        assert f.readline() == "B\n"


@test
def test_utf8_malformed_read_one_preserves_following_character():
    path = "build/file_utf8_replace.txt"
    with open(path, "wb") as f:
        f.write(b"\xe1\x80A")

    with open(path, "r", encoding="utf-8", errors="replace") as f:
        assert f.read(1) == "\ufffd"
        assert f.read(1) == "A"
        assert f.read(1) == ""


@test
def test_gzip_tell_accounts_for_read_ahead():
    path = "build/file_gzip_tell.gz"
    data = b"a" * 9000

    with gzopen(path, "wb") as f:
        f.write(data)

    with gzopen(path, "rb") as f:
        assert f.tell() == 0
        assert f.read(1) == b"a"
        assert f.tell() == 1
        assert f.read(10) == b"a" * 10
        assert f.tell() == 11
        f.seek(0, 0)
        assert f.tell() == 0
        assert f.read(1) == b"a"
        assert f.tell() == 1


@test
def test_gzip_seek_accounts_for_pending_byte():
    path = "build/file_gzip_pending.gz"
    with gzopen(path, "wb") as f:
        f.write(b"a\rb")

    with gzopen(path, "rt", newline="") as f:
        assert f.readline() == "a\r"
        pos = f.tell()

        # Text-mode tell() values are opaque seek cookies in CPython, not
        # necessarily raw byte offsets. The portable contract is that the
        # returned value can be passed back to seek().
        f.seek(pos, 0)
        assert f.read(1) == "b"


@test
def test_bzip_tell_accounts_for_pending_text():
    path = "build/file_bzip_pending.bz2"
    with bzopen(path, "wb") as f:
        f.write(b"a\rb")

    with bzopen(path, "rt", newline="") as f:
        assert f.readline() == "a\r"
        pos = f.tell()

        # As with gzip, text-mode tell() is an opaque cookie under CPython.
        f.seek(pos, 0)
        assert f.read(1) == "b"


@test
def test_gzip_flush_does_not_finish_stream():
    path = "build/file_gzip_flush.gz"
    with gzopen(path, "wb") as f:
        f.write(b"A")
        f.flush()
        f.write(b"B")
        f.flush()
        f.write(b"C")

    with gzopen(path, "rb") as f:
        assert f.read() == b"ABC"



@test
def test_compressed_bare_modes_are_binary():
    gz_path = "build/file_gzip_default_binary.gz"
    bz_path = "build/file_bzip_default_binary.bz2"

    with gzopen(gz_path, "w") as f:
        assert f.write(b"abc") == 3
    with gzopen(gz_path, "r") as f:
        assert f.read() == b"abc"

    with bzopen(bz_path, "w") as f:
        assert f.write(b"abc") == 3
    with bzopen(bz_path, "r") as f:
        assert f.read() == b"abc"


@test
def test_compressed_text_options_require_text_mode():
    gz_path = "build/file_gzip_text_mode.gz"
    bz_path = "build/file_bzip_text_mode.bz2"

    try:
        gzopen(gz_path, "w", encoding="utf-8")
        assert False
    except ValueError:
        pass

    try:
        gzopen(gz_path, "r", newline="")
        assert False
    except ValueError:
        pass

    try:
        bzopen(bz_path, "w", encoding="utf-8", newline="\n")
        assert False
    except ValueError:
        pass

    try:
        bzopen(bz_path, "r", errors="ignore")
        assert False
    except ValueError:
        pass


@test
def test_compressed_explicit_text_mode():
    gz_path = "build/file_gzip_explicit_text.gz"
    bz_path = "build/file_bzip_explicit_text.bz2"

    with gzopen(gz_path, "wt", encoding="utf-8", newline="") as f:
        assert f.write("a\rb\n") == 4
    with gzopen(gz_path, "rt", encoding="utf-8", newline="") as f:
        assert f.readline() == "a\r"
        assert f.readline() == "b\n"

    with bzopen(bz_path, "wt", encoding="utf-8", newline="") as f:
        assert f.write("a\rb\n") == 4
    with bzopen(bz_path, "rt", encoding="utf-8", newline="") as f:
        assert f.readline() == "a\r"
        assert f.readline() == "b\n"


test_compressed_bare_modes_are_binary()
