_native_is_little_endian = lambda: True

@test
def test_negative_repeat():
    assert "abc" * -1 == ""
    assert "abc" * -100 == ""
    assert "abc" * 0 == ""
    assert "abc" * 2 == "abcabc"


@test
def test_capitalize_full_unicode():
    assert "élan VITAL".capitalize() == "Élan vital"
    assert "ßFOO".capitalize() == "Ssfoo"
    assert "ǳABC DEF".capitalize() == "ǲabc def"


@test
def test_istitle_combining_marks():
    assert "A\u0301a".istitle() == False
    assert "A\u0301A".istitle() == True
    assert "A-a".istitle() == False
    assert "A-A".istitle() == True


@test
def test_cat_generator_multibyte():
    def pieces():
        yield "A"
        yield "é"
        yield "Ω"
        yield "😀"
        yield "Z"

    assert str.cat(pieces()) == "AéΩ😀Z"

    def ucs2_only():
        yield "α"
        yield "β"
        yield "γ"

    assert str.cat(ucs2_only()) == "αβγ"


@test
def test_utf8_error_span_replace():
    assert str(b"\xe1\x80A", "utf-8", "replace") == "\ufffdA"
    assert str(b"\xf0\x90\x80A", "utf-8", "replace") == "\ufffdA"
    assert str(b"\xe1\x80", "utf-8", "replace") == "\ufffd"
    assert str(b"\xf0\x90\x80", "utf-8", "replace") == "\ufffd"

    # Illegal second bytes make the lead byte an error on its own.
    assert str(b"\xe0\x80\x80", "utf-8", "replace") == "\ufffd\ufffd\ufffd"
    assert str(b"\xed\xa0\x80", "utf-8", "replace") == "\ufffd\ufffd\ufffd"


@test
def test_utf8_error_span_ignore():
    assert str(b"\xe1\x80A", "utf-8", "ignore") == "A"
    assert str(b"\xf0\x90\x80A", "utf-8", "ignore") == "A"
    assert str(b"\xe1\x80", "utf-8", "ignore") == ""


@test
def test_utf8_error_span_backslashreplace():
    assert str(b"\xe1\x80A", "utf-8", "backslashreplace") == "\\xe1\\x80A"
    assert str(b"\xf0\x90\x80A", "utf-8", "backslashreplace") == "\\xf0\\x90\\x80A"


@test
def test_utf8_error_span_surrogateescape():
    s = str(b"\xe1\x80A", "utf-8", "surrogateescape")
    assert len(s) == 3
    assert s._load_codepoint(0) == 0xDCE1
    assert s._load_codepoint(1) == 0xDC80
    assert s[2] == "A"


@test
def test_utf16_without_bom_uses_native_endian():
    if _native_is_little_endian():
        assert str(b"a\x00", "utf-16") == "a"
        assert str(b"a\x00b\x00", "utf-16") == "ab"
    else:
        assert str(b"\x00a", "utf-16") == "a"
        assert str(b"\x00a\x00b", "utf-16") == "ab"


@test
def test_utf32_without_bom_uses_native_endian():
    if _native_is_little_endian():
        assert str(b"a\x00\x00\x00", "utf-32") == "a"
    else:
        assert str(b"\x00\x00\x00a", "utf-32") == "a"


@test
def test_utf16_utf32_bom_roundtrip():
    text = "AéΩ😀"
    assert str(text.encode("utf-16"), "utf-16") == text
    assert str(text.encode("utf-32"), "utf-32") == text
    assert str(text.encode("utf-16-le"), "utf-16-le") == text
    assert str(text.encode("utf-16-be"), "utf-16-be") == text
    assert str(text.encode("utf-32-le"), "utf-32-le") == text
    assert str(text.encode("utf-32-be"), "utf-32-be") == text


@test
def test_internal_storage_is_native_endian():
    a = _unicode_from_codepoint(0x1234)
    b = _unicode_from_codepoint(0x1F600)
    assert int(Ptr[u16](a._ptr)[0]) == 0x1234
    assert int(Ptr[u32](b._ptr)[0]) == 0x1F600


@test
def test_maketrans_string_forms():
    table = str.maketrans("abc", "xyz")
    assert "cab".translate(table) == "zxy"

    table2 = str.maketrans("ab", "xy", "c")
    assert table2[ord("c")] is None
    assert "cabca".translate(table2) == "xyx"

    try:
        str.maketrans("ab", "x")
        assert False
    except ValueError:
        pass


@test
def test_translate_int_minus_one_is_invalid():
