@test
def test_repr_quote_choice_matches_python():
    assert repr("abc") == "'abc'"
    assert repr("a'b") == "\"a'b\""
    assert repr('a"b') == "'a\"b'"
    assert repr("a'\"b") == "'a\\'\"b'"


@test
def test_strip_none():
    assert "  abc \t".strip(None) == "abc"
    assert "  abc \t".lstrip(None) == "abc \t"
    assert "  abc \t".rstrip(None) == "  abc"


@test
def test_slices_do_not_alias_parent_storage():
    # This is primarily a lifetime/ownership regression test. The result must
    # remain valid after the source reference is replaced.
    source = "xx😀éΩyy"
    middle = source[2:5]
    source = "replacement"
    assert middle == "😀éΩ"


@test
def test_utf8_strict_encoding_paths():
    assert "".encode("utf-8") == b""
    assert "ascii".encode("utf-8") == b"ascii"
    assert "é".encode("utf-8") == b"\xc3\xa9"
    assert ("é" * 16).encode("utf-8") == b"\xc3\xa9" * 16
    assert ("a" * 15 + "é" + "z" * 16).encode("utf-8") == (
        b"a" * 15 + b"\xc3\xa9" + b"z" * 16
    )
    assert "Ω".encode("utf-8") == b"\xce\xa9"
    assert "😀".encode("utf-8") == b"\xf0\x9f\x98\x80"
    value = "a" * 31 + "\x7f\x80\u07ff\u0800\ud7ff\ue000\uffff" + "z" * 33
    expected = (
        b"a" * 31
        + b"\x7f\xc2\x80\xdf\xbf\xe0\xa0\x80"
        + b"\xed\x9f\xbf\xee\x80\x80\xef\xbf\xbf"
        + b"z" * 33
    )
    assert value.encode("utf-8") == expected

    try:
        ("a" * 16 + chr(0xD800) + "z" * 16).encode("utf-8")
        assert False
    except ValueError:
        pass

    assert ("😀" * 17).encode("utf-8") == b"\xf0\x9f\x98\x80" * 17
    assert ("\U00010000\U0010ffff" * 9).encode("utf-8") == (
        b"\xf0\x90\x80\x80\xf4\x8f\xbf\xbf" * 9
    )
    assert (b"\xf0\x9f\x98\x80" * 17).decode("utf-8") == "😀" * 17
    assert (b"\xf0\x90\x80\x80\xf4\x8f\xbf\xbf" * 9).decode("utf-8") == (
        "\U00010000\U0010ffff" * 9
    )
    assert (b"\xc3\xa9" * 8).decode("utf-8") == "é" * 8
    assert (b"a" * 15 + b"\xc3\xa9").decode("utf-8") == "a" * 15 + "é"
    assert (b"\xc4\x80" * 8).decode("utf-8") == "Ā" * 8

    for invalid in (
        b"a" * 14 + b"\xc3x",
        b"\xc3\xa9" * 7 + b"\x80a",
    ):
        try:
            invalid.decode("utf-8")
            assert False
        except ValueError:
            pass

    valid_prefix = b"\xf0\x9f\x98\x80" * 4
    for invalid in (
        b"\xf0\x80\x80\x80",
        b"\xf4\x90\x80\x80",
        b"\xf0\x90\x00\x80",
        b"\xf5\x80\x80\x80",
    ):
        try:
            (valid_prefix + invalid * 4).decode("utf-8")
            assert False
        except ValueError:
            pass


@test
def test_identity_codecs_share_immutable_storage():
    ascii_text = "shared ascii storage"
    assert ascii_text.encode("utf-8")._ptr == ascii_text._ptr
    assert ascii_text.encode("ascii")._ptr == ascii_text._ptr
    assert ascii_text.encode("latin-1")._ptr == ascii_text._ptr
    assert ascii_text.encode("utf-8", "ignore")._ptr == ascii_text._ptr

    latin1_text = "café Noël"
    assert latin1_text.encode("latin-1")._ptr == latin1_text._ptr
    ascii_slice = latin1_text[5:]
    assert ascii_slice.encode("utf-8")._ptr != ascii_slice._ptr

    ascii_data = _raw_bytes([0x61, 0x62, 0x63])
    assert ascii_data.decode("utf-8")._ptr == ascii_data._ptr
    assert ascii_data.decode("ascii")._ptr != ascii_data._ptr
    assert ascii_data.decode("utf-8", "ignore")._ptr != ascii_data._ptr

    latin1_data = _raw_bytes([0x63, 0x61, 0x66, 0xE9])
    assert latin1_data.decode("latin-1")._ptr == latin1_data._ptr

    encoded = ascii_text.encode("utf-8")
    ascii_text = "replacement"
    assert encoded == b"shared ascii storage"

    decoded = ascii_data.decode("utf-8")
    ascii_data = b"replacement"
    assert decoded == "abc"


@test
def test_bytes_constructor_requires_explicit_decode_to_decode_contents():
    # CPython: str(bytes_obj) is its repr; decoding bytes requires an encoding.
    assert str(b"abc") == "b'abc'"
    assert str(b"abc", "utf-8") == "abc"


