    assert "banana".translate(table) == "bnn"


@test
def test_translate_allows_surrogate_codepoint():
    table: dict[int, int] = {ord("a"): 0xD800}
    result = "a".translate(table)
    assert len(result) == 1
    assert result._load_codepoint(0) == 0xD800


@test
def test_surrogateescape_single_byte_encoders():
    s = _unicode_from_codepoint(0xDC80)
    assert s.encode("ascii", "surrogateescape") == b"\x80"
    assert s.encode("latin-1", "surrogateescape") == b"\x80"
    assert s.encode("cp1252", "surrogateescape") == b"\x80"
    assert s.encode("cp1250", "surrogateescape") == b"\x80"


@test
def test_surrogateescape_not_raw_for_utf16_utf32():
