# new-style format
@test
def test_brace_format_automatic_fields():
    assert unicode("hello, {}").format(unicode("Codon")) == unicode(
        "hello, Codon"
    )
    assert unicode("{} + {} = {}").format(1, 2, 3) == unicode("1 + 2 = 3")
    assert unicode("{{{}}}").format(unicode("x")) == unicode("{x}")
    assert unicode("{{}}").format() == unicode("{}")


@test
def test_brace_format_conversions():
    assert unicode("{!s}").format(unicode("hello")) == unicode("hello")
    assert unicode("{!r}").format(unicode("hello")) == unicode("'hello'")
    assert unicode("{!a}").format(unicode("café")) == unicode("'caf\\xe9'")


@test
def test_brace_format_positional_fields():
    assert unicode("{1}, {0}!").format(unicode("world"), unicode("hello")) == (
        unicode("hello, world!")
    )
    assert unicode("{0!r} {1!a}").format(
        unicode("hello"),
        unicode("café"),
    ) == unicode("'hello' 'caf\\xe9'")

    try:
        unicode("{1}").format(unicode("only"))
        assert False
    except IndexError:
        pass

    try:
        unicode("{} {0}").format(1, 2)
        assert False
    except ValueError:
        pass

    try:
        unicode("{0} {}").format(1, 2)
        assert False
    except ValueError:
        pass


@test
def test_brace_format_basic_specs():
    assert unicode("{:d}").format(42) == unicode("42")
    assert unicode("{:b}").format(42) == unicode("101010")
    assert unicode("{:#b}").format(42) == unicode("0b101010")
    assert unicode("{:#x}").format(255) == unicode("0xff")
    assert unicode("{:05d}").format(-12) == unicode("-0012")
    assert unicode("{:.2f}").format(1.25) == unicode("1.25")
    assert unicode("{:08.2f}").format(1.25) == unicode("00001.25")
    assert unicode("{:s}").format(unicode("Codon")) == unicode("Codon")
    assert unicode("{:.3s}").format(unicode("Codon")) == unicode("Cod")
    assert unicode("{:05}").format(unicode("x")) == unicode("x0000")
    assert unicode("{:0>5}").format(unicode("x")) == unicode("0000x")
    assert unicode("{!r:05}").format(unicode("x")) == unicode("'x'00")
    assert unicode("{:05}").format(unicode("é")) == unicode("é0000")
    assert unicode("{:.2}").format(1.234) == unicode("1.2")
    assert unicode("{:+}").format(12) == unicode("+12")
    assert unicode("{: }").format(12) == unicode(" 12")
    assert unicode("{:#}").format(1.0) == unicode("1.0")
    assert unicode("{:08}").format(1.25) == unicode("00001.25")
    assert unicode("{:+.3}").format(1.25) == unicode("+1.25")
    assert unicode("{:,}").format(1234567) == unicode("1,234,567")
    assert unicode("{:n}").format(1234567) == unicode("1234567")
    assert unicode("{:.4n}").format(1234.5) == unicode("1234")
    assert unicode("{:z.1f}").format(-0.0) == unicode("0.0")
    assert unicode("{:z.1f}").format(-0.04) == unicode("0.0")
    assert unicode("{:z.1f}").format(-0.06) == unicode("-0.1")
    assert unicode("{:+z.1f}").format(-0.04) == unicode("+0.0")
    assert unicode("{:z}").format(-0.0) == unicode("0.0")

    try:
        unicode("{:z}").format(1)
        assert False
    except ValueError:
        pass

    assert unicode("{:.1%}").format(0.125) == unicode("12.5%")
    assert unicode("{:6.1%}").format(0.125) == unicode(" 12.5%")
    assert unicode("{:08.1%}").format(0.125) == unicode("00012.5%")
    assert unicode("{:+08.1%}").format(0.125) == unicode("+0012.5%")
    assert unicode("{:<8.1%}").format(0.125) == unicode("12.5%   ")


@test
def test_brace_format_locale_numeric():
    original = seq_locale_numeric()

    if seq_set_locale_numeric(unicode("en_US.UTF-8")):
        assert unicode("{:n}").format(1234567) == unicode("1,234,567")
        assert unicode("{:.4n}").format(1234.5) == unicode("1,234")
        assert seq_set_locale_numeric(original)


@test
def test_brace_format_type_validation():
    assert unicode("{:c}").format(65) == unicode("A")
    assert unicode("{:5c}").format(65) == unicode("    A")
    assert unicode("{:05c}").format(65) == unicode("0000A")
    assert unicode("{:<5c}").format(65) == unicode("A    ")
    assert unicode("{:.2f}").format(1) == unicode("1.00")
    assert unicode("{!r:>8}").format(unicode("x")) == unicode("     'x'")
    assert unicode("{:-5d}").format(12) == unicode("   12")
    assert unicode("{:-5d}").format(-12) == unicode("  -12")
    assert unicode("{:-5.1f}").format(1.2) == unicode("  1.2")
    assert unicode("{:<5d}").format(12) == unicode("12   ")

    invalid_formats = (
        (unicode("{:.3d}"), 12),
        (unicode("{:d}"), 1.5),
        (unicode("{:s}"), 1.5),
        (unicode("{:s}"), 12),
        (unicode("{:c}"), unicode("x")),
        (unicode("{:+c}"), 65),
        (unicode("{:#c}"), 65),
        (unicode("{:.1c}"), 65),
        (unicode("{:,c}"), 65),
        (unicode("{:_c}"), 65),
        (unicode("{:zc}"), 65),
        (unicode("{:n}"), unicode("x")),
        (unicode("{:,n}"), 1),
        (unicode("{:-5}"), unicode("x")),
        (unicode("{:+5}"), unicode("x")),
        (unicode("{:#}"), unicode("x")),
        (unicode("{:,}"), unicode("x")),
        (unicode("{:_}"), unicode("x")),
        (unicode("{:#s}"), unicode("x")),
        (unicode("{!r:#}"), unicode("x")),
        (unicode("{!a:,}"), unicode("é")),
    )

    for format, value in invalid_formats:
        try:
            format.format(value)
            assert False
        except ValueError:
            pass


@test
def test_brace_format_spec_grammar():
    assert unicode("{:+z#08,.2f}").format(1.25) == unicode("+0,001.25")
    assert unicode("{:z#0.1f}").format(1.0) == unicode("1.0")
    assert unicode("{:#010x}").format(15) == unicode("0x0000000f")

    invalid_formats = (
        (unicode("{:0#8x}"), 15),
        (unicode("{:#z.2f}"), 1.2),
        (unicode("{:+ d}"), 1),
        (unicode("{:+ +d}"), 1),
        (unicode("{:##x}"), 1),
        (unicode("{:, ,d}"), 1),
    )

    for format, value in invalid_formats:
        try:
            format.format(value)
            assert False
        except ValueError:
            pass


@test
def test_brace_format_alignment():
    assert unicode("{:<8}").format(unicode("Codon")) == unicode("Codon   ")
    assert unicode("{:>8}").format(unicode("Codon")) == unicode("   Codon")
    assert unicode("{:^8}").format(unicode("Codon")) == unicode(" Codon  ")
    assert unicode("{:*^8}").format(unicode("Codon")) == unicode("*Codon**")

    assert unicode("{:>5d}").format(12) == unicode("   12")
    assert unicode("{:<5d}").format(12) == unicode("12   ")
    assert unicode("{:^5d}").format(12) == unicode(" 12  ")
    assert unicode("{:=+8d}").format(12) == unicode("+     12")
    assert unicode("{:=+8d}").format(-12) == unicode("-     12")
    assert unicode("{:0=+8d}").format(12) == unicode("+0000012")
    assert unicode("{:=#10x}").format(255) == unicode("0x      ff")
    assert unicode("{:=+12,d}").format(1234) == unicode("+      1,234")

    try:
        unicode("{:=8s}").format(unicode("x"))
        assert False
    except ValueError:
        pass


@test
def test_brace_format_grouping():
    assert unicode("{:,d}").format(1234567) == unicode("1,234,567")
    assert unicode("{:_x}").format(0xDEADBEEF) == unicode("dead_beef")
    assert unicode("{:#_x}").format(0xDEADBEEF) == unicode("0xdead_beef")
    assert unicode("{:_b}").format(0b101010101010) == unicode("1010_1010_1010")
    assert unicode("{:,.2f}").format(1234.5) == unicode("1,234.50")
    assert unicode("{:010,d}").format(1234) == unicode("00,001,234")
    assert unicode("{:,}").format(1e20) == unicode("1e+20")
    assert unicode("{:_}").format(1e20) == unicode("1e+20")
    assert unicode("{:,}").format(1234.0) == unicode("1,234.0")

    try:
        unicode("{:,x}").format(15)
        assert False
    except ValueError:
        pass

    try:
        unicode("{:,b}").format(15)
        assert False
    except ValueError:
        pass


@test
def test_brace_format_adversarial_combinations():
    assert unicode("{:+#012x}").format(0xBEEF) == unicode("+0x00000beef")
    assert unicode("{:=#012x}").format(-0xBEEF) == unicode("-0x00000beef")
    assert unicode("{:0=+12,d}").format(1234) == unicode("+000,001,234")
    assert unicode("{:*^11,d}").format(1234) == unicode("***1,234***")
    assert unicode("{:#012b}").format(0b101101) == unicode("0b0000101101")

    assert unicode("{:#012.0f}").format(1.0) == unicode("00000000001.")
    assert unicode("{:=+10.0e}").format(1.0) == unicode("+    1e+00")
    assert unicode("{:#.0g}").format(1.0) == unicode("1.")
    assert unicode("{:z#08.0f}").format(-0.0) == unicode("0000000.")
    assert unicode("{:,.0f}").format(999.5) == unicode("1,000")
    assert unicode("{:_>12.2f}").format(-12.5) == unicode("______-12.50")

    assert unicode("{!r:0^9}").format(unicode("x")) == unicode("000'x'000")
    assert unicode("{!a:.6}").format(unicode("café")) == unicode("'caf\\x")
    assert unicode("{:0=5c}").format(65) == unicode("0000A")
    assert unicode("{:^6c}").format(0x03A9) == unicode("  Ω   ")
    assert unicode("{{{:0=+8d}}}").format(12) == unicode("{+0000012}")
    assert unicode("{0:{1}}").format(12, unicode("0=+8d")) == unicode("+0000012")

    try:
        unicode("{").format()
        assert False
    except ValueError:
        pass

    try:
        unicode("{{}").format()
        assert False
    except ValueError:
        pass

    try:
        unicode("{0!q}").format(1)
        assert False
    except ValueError:
        pass

    try:
        unicode("{0:{1:{2}}}").format(1, 2, 3)
        assert False
    except ValueError:
        pass


@test
def test_brace_format_adversarial_multi_argument_sequences():
    assert unicode("pre {2:#0{0}x} mid {1:0^7} post {3:z#08.1f}").format(
        8,
        unicode("x"),
        0xBEEF,
        -0.04,
    ) == unicode("pre 0x00beef mid 000x000 post 000000.0")

    assert unicode("{0:#0{1}b} {2:{3}.{4}f}").format(
        45,
        12,
        1.25,
        9,
        2,
    ) == unicode("0b0000101101      1.25")

    assert unicode("{0:{1}} {2} {3:{4}}").format(
        12,
        unicode("+06d"),
        unicode("ok"),
        1e20,
        unicode(","),
    ) == unicode("+00012 ok 1e+20")

    assert unicode("{{ {0:{1}} }} | {{ {2:{3}} }}").format(
        12,
        unicode("0=+8d"),
        1.25,
        unicode("+08.1f"),
    ) == unicode("{ +0000012 } | { +00001.2 }")

    assert unicode("{2:{0}}:{1:{3}}:{4:#0{5}x}").format(
        5,
        12,
        7,
        unicode("0=+6d"),
        255,
        8,
    ) == unicode("    7:+00012:0x0000ff")


@test
def test_brace_format_adversarial_malformed_sequences():
    try:
        unicode("}").format()
        assert False
    except ValueError:
        pass

    try:
        unicode("{0!").format(1)
        assert False
    except ValueError:
        pass

    try:
        unicode("{0!r").format(1)
        assert False
    except ValueError:
        pass

    try:
        unicode("{0:").format(1)
        assert False
    except ValueError:
        pass

    try:
        unicode("{0:{1}").format(1, 2)
        assert False
    except ValueError:
        pass

    try:
        unicode("{}}").format(1)
        assert False
    except ValueError:
        pass


@test
def test_brace_format_adversarial_dynamic_buffer_growth():
    assert unicode("α{{{0:{1}}}}β").format(1, 10) == unicode("α{         1}β")
    assert unicode("{0:{1}d}").format(1, 10000) == unicode(" " * 9999 + "1")
    assert unicode("{:010000.1%}").format(0.125) == unicode(
        "0" * 9995 + "12.5%"
    )
    assert unicode("{0:{1}.{2}f}").format(1.0, 1005, 1000) == unicode(
        " " * 3 + "1." + "0" * 1000
    )

    try:
        unicode("{0:{1}{2}}").format(1, unicode("d"), unicode("x"))
        assert False
    except ValueError:
        pass

    assert unicode("{0:{1!r}}").format(1, 8) == unicode("       1")


@test
def test_brace_format_cpython_adversarial_matrix():
    minimum = -(1 << 63)

    numeric_cases = (
        (unicode("{:+#018x}"), -0x1234, unicode("-0x000000000001234")),
        (unicode("{:#_b}"), 0b1111000011110000, unicode("0b1111_0000_1111_0000")),
        (unicode("{:=+#15,d}"), 1234567, unicode("+     1,234,567")),
        (unicode("{:0=+#15,d}"), 1234567, unicode("+00,001,234,567")),
        (unicode("{:#024o}"), minimum, unicode("-0o1000000000000000000000")),
        (unicode("{:+020.4e}"), 1.25, unicode("+0000000001.2500e+00")),
        (unicode("{:#.0g}"), 1000000.0, unicode("1.e+06")),
        (unicode("{:020,.2f}"), 1234.5, unicode("0,000,000,001,234.50")),
        (unicode("{:0=+16,.1%}"), 12.34, unicode("+0,000,001,234.0%")),
        (unicode("{:=+z12.1f}"), -0.04, unicode("+        0.0")),
        (unicode("{:=+z012.1f}"), -0.04, unicode("+000000000.0")),
        (unicode("{:+08.1%}"), -0.0, unicode("-0000.0%")),
        (unicode("{:#08.0f}"), float("inf"), unicode("00000inf")),
        (unicode("{:+#08.0F}"), float("nan"), unicode("+0000NAN")),
    )

    for format, value, expected in numeric_cases:
        assert format.format(value) == expected

    unicode_cases = (
        (unicode("{:界^7}"), unicode("a"), unicode("界界界a界界界")),
        (unicode("{:😀>4.2}"), unicode("éΩx"), unicode("😀😀éΩ")),
        (unicode("{:.0s}"), unicode("é"), unicode("")),
        (unicode("{!r:*>12.3}"), unicode("éΩx"), unicode("*********'éΩ")),
    )

    for format, value, expected in unicode_cases:
        assert format.format(value) == expected

    assert unicode("{2:{0}.{1}f}|{3:{4}}|{5:{6}}").format(
        8,
        3,
        1.25,
        unicode("x"),
        unicode("*^5"),
        42,
        unicode("0=+6d"),
    ) == unicode("   1.250|**x**|+00042")

    assert unicode("{{{0:0=+8d}}} {1!a:{2}}").format(
        12,
        unicode("é"),
        unicode("^8"),
    ) == unicode("{+0000012}  '\\xe9' ")

    assert unicode("{2:0=+{0},d}|{1:{3}.{4}%}|{5:{6}}").format(
        14,
        0.125,
        1234567,
        8,
        1,
        unicode("xy"),
        unicode("^8"),
    ) == unicode("+0,001,234,567|   12.5%|   xy   ")

    assert unicode("{{{3:{0}}}}:{2:{1}.{4}f}:{5:{6}}").format(
        7,
        10,
        1.25,
        42,
        2,
        unicode("x"),
        unicode("*^5"),
    ) == unicode("{     42}:      1.25:**x**")

    assert unicode("{3:{0}}|{2:{1}}|{4:{5}}").format(
        unicode("0=+7d"),
        unicode(">6"),
        12,
        7,
        unicode("éΩx"),
        unicode(".^8"),
    ) == unicode("+000007|    12|..éΩx...")

    assert unicode("{0:{2}}/{1:{3}}/{4:{5}}").format(
        unicode("é"),
        unicode("Ω"),
        unicode("^8"),
        unicode(">12"),
        1234,
        unicode("0=+8,d"),
    ) == unicode("   é    /           Ω/+001,234")

    slash = unicode("\\")
    assert unicode("pre ({{{0}}}) \\ {1!r} \n {2!a}").format(
        unicode("x"),
        unicode("a\tb"),
        unicode("é\nΩ"),
    ) == (
        unicode("pre ({x}) ")
        + slash
        + unicode(" 'a")
        + slash
        + unicode("tb' \n '")
        + slash
        + unicode("xe9")
        + slash
        + unicode("n")
        + slash
        + unicode("u03a9'")
    )

    assert unicode("({0:{2}})\\({1!r:{3}})\\n[{4!a:{5}}]").format(
        unicode("é"),
        unicode("a\tb"),
        unicode("^5"),
        unicode(">10"),
        unicode("Ω\n"),
        unicode("^12"),
    ) == (
        unicode("(  é  )")
        + slash
        + unicode("(    'a")
        + slash
        + unicode("tb')")
        + slash
        + unicode("n[ '")
        + slash
        + unicode("u03a9")
        + slash
        + unicode("n' ]")
    )

    assert unicode("{{({0})}} -> {1!r} -> {2!a}").format(
        unicode("x\ny"),
        unicode("a\\b"),
        unicode("é\t"),
    ) == (
        unicode("{(x\ny)} -> 'a")
        + slash
        + slash
        + unicode("b' -> '")
        + slash
        + unicode("xe9")
        + slash
        + unicode("t'")
    )

    assert unicode("").format() == unicode("")
    assert unicode("{{}}").format() == unicode("{}")
    assert unicode("{{{}}}").format(unicode("")) == unicode("{}")
    assert unicode("{}|{}|{}").format(unicode(""), 0, -0.0) == unicode(
        "|0|-0.0"
    )
    assert unicode("[{:}]|[{:0}]|[{:>0}]|[{:^0}]").format(
        unicode(""),
        unicode(""),
        unicode(""),
        unicode(""),
    ) == unicode("[]|[]|[]|[]")
    assert unicode("[{:.0}]|[{:.0s}]|[{:.0f}]|[{:.0%}]").format(
        unicode(""),
        unicode(""),
        0.0,
        0.0,
    ) == unicode("[]|[]|[0]|[0%]")
    assert unicode("{0:{1}}|{2:{3}}|{4:{5}}").format(
        unicode(""),
        unicode(""),
        0,
        unicode(""),
        unicode("x"),
        unicode(""),
    ) == unicode("|0|x")
    assert unicode("<{0}>|<{1:.0}>|<{2!r}>").format(
        unicode("\x00"),
        unicode("\x00"),
        unicode(""),
    ) == unicode("<\x00>|<>|<''>")

    numbering_errors = (
        unicode("{} {1} {0:{2}}"),
        unicode("{1} {} {0:{2}}"),
        unicode("{0:{}} {1}"),
        unicode("{:{1}} {0}"),
    )

    for format in numbering_errors:
        try:
            format.format(1, 2, 3)
            assert False
        except ValueError:
            pass

    malformed_formats = (
        unicode("{:..2f}"),
        unicode("{:08.2.1f}"),
        unicode("{:++d}"),
        unicode("{:--d}"),
        unicode("{0!r!s}"),
        unicode("{0:{1:{2}}}"),
        unicode("{0:😀}"),
        unicode("{:n,}"),
    )

    for format in malformed_formats:
        try:
            format.format(1, 2, 3, 4)
            assert False
        except ValueError:
            pass


@test
def test_brace_format_nested_specs():
    assert unicode("{0:{1}}").format(42, 5) == unicode("   42")
    assert unicode("{0:.{1}f}").format(1.25, 1) == unicode("1.2")
    assert unicode("{:{}}").format(42, 5) == unicode("   42")

    try:
        unicode("{0:{}}").format(42, 5)
        assert False
    except ValueError:
        pass

    try:
        unicode("{:{0}}").format(42, 5)
        assert False
    except ValueError:
        pass


@test
def test_brace_format_custom_protocol():
    class Token:
        value: unicode

        def __init__(self, value: unicode):
            self.value = value

        def __format__(self, spec: unicode) -> unicode:
            return unicode("<") + self.value + unicode(":") + spec + unicode(">")

    token = Token(unicode("payload"))
    assert unicode("{}").format("raw") == unicode("raw")
    assert unicode("{}").format(token) == unicode("<payload:>")
    assert unicode("before {:opaque} after").format(token) == unicode(
        "before <payload:opaque> after"
    )
    assert unicode("{0:{1}}").format(token, unicode("nested")) == unicode(
        "<payload:nested>"
    )


@test
def test_brace_format_map():
    values: Dict[unicode, unicode] = {
        unicode("name"): unicode("Codon"),
        unicode("greeting"): unicode("hi"),
        unicode("width"): unicode(">8"),
    }
    assert unicode("{name}").format_map(values) == unicode("Codon")
    assert unicode("{greeting:>8}|{name:.3}").format_map(values) == unicode(
        "      hi|Cod"
    )
    assert unicode("{name:{width}}").format_map(values) == unicode("   Codon")
    assert unicode("{{{name}}}").format_map(values) == unicode("{Codon}")

    class Names:
        values: Dict[unicode, unicode]

        def __init__(self):
            self.values = values

        def __getitem__(self, key: unicode) -> unicode:
            return self.values[key]

    assert unicode("{greeting}, {name}").format_map(Names()) == unicode(
        "hi, Codon"
    )

    class Token:
        value: unicode

        def __init__(self, value: unicode):
            self.value = value

        def __format__(self, spec: unicode) -> unicode:
            return unicode("[") + self.value + unicode(":") + spec + unicode("]")

    class Tokens:
        value: Token
        spec: Token

        def __init__(self):
            self.value = Token(unicode("payload"))
            self.spec = Token(unicode("nested"))

        def __getitem__(self, key: unicode) -> Token:
            if key == unicode("value"):
                return self.value
            return self.spec

    assert unicode("{value:opaque}").format_map(Tokens()) == unicode(
        "[payload:opaque]"
    )
    assert unicode("{value:{spec}}").format_map(Tokens()) == unicode(
        "[payload:[nested:]]"
    )

    try:
        unicode("{}").format_map(values)
        assert False
    except ValueError:
        pass

    try:
        unicode("{0}").format_map(values)
        assert False
    except ValueError:
        pass

    try:
        unicode("{name:{}}").format_map(values)
        assert False
    except ValueError:
        pass

    try:
        unicode("{name}").format(unicode("Codon"))
        assert False
    except ValueError:
        pass


