        pass


@test
def test_surrogatepass_utf_encoders():
    s = _unicode_from_codepoint(0xD800)
    assert s.encode("utf-8", "surrogatepass") == b"\xed\xa0\x80"
    assert s.encode("utf-16-le", "surrogatepass") == b"\x00\xd8"
    assert s.encode("utf-32-le", "surrogatepass") == b"\x00\xd8\x00\x00"


@test
def test_utf16_utf32_encode_error_alignment():
    s = _unicode_from_codepoint(0xD800)
    assert s.encode("utf-16-le", "replace") == b"?\x00"
    assert s.encode("utf-16-be", "replace") == b"\x00?"
    assert s.encode("utf-32-le", "replace") == b"?\x00\x00\x00"
    assert s.encode("utf-32-be", "replace") == b"\x00\x00\x00?"
    assert s.encode("utf-16-le", "backslashreplace") == "\\ud800".encode("utf-16-le")
    assert s.encode("utf-32-be", "backslashreplace") == "\\ud800".encode("utf-32-be")


@test
def test_error_handler_lookup_is_lazy_decode():
