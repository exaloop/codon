unicode = str

def _raw_bytes(values: List[int]) -> bytes:
    data = Ptr[u8](len(values))

    for i in range(len(values)):
        data[i] = u8(values[i])

    return bytes(data, len(values))


@test
def test_empty():
    u = unicode("")
    assert len(u) == 0
    assert not u
    assert u == unicode("")
    assert u[0:0] == unicode("")
    assert u.startswith(unicode(""))
    assert u.endswith(unicode(""))


@test
def test_ascii_and_slicing():
    u = unicode("hello")
    assert len(u) == 5
    assert u[0] == unicode("h")
    assert u[-1] == unicode("o")
    assert u[1:4] == unicode("ell")
    assert u[:0] == unicode("")
    assert u[10:12] == unicode("")
    assert u[4:1] == unicode("")


@test
def test_chr_ord():
    for codepoint in [
        0, 0x7F, 0x80, 0xFF, 0x100, 0xD7FF, 0xD800, 0xDFFF,
        0xE000, 0xFFFF, 0x10000, 0x10FFFF,
    ]:
        character = chr(codepoint)
        assert len(character) == 1
        assert ord(character) == codepoint
        assert character == _unicode_from_codepoint(codepoint)

    for codepoint in [-1, 0x110000]:
        try:
            chr(codepoint)
            assert False
        except ValueError:
            pass

    for value in [unicode(""), unicode("ab")]:
        try:
            ord(value)
            assert False
        except TypeError:
            pass


@test
def test_unicode_literal_escapes():
    assert "\u0041" == "A"
    assert "\u00e9" == _unicode_from_codepoint(0xE9)
    assert "\u03a9" == _unicode_from_codepoint(0x03A9)
    assert "\ud800" == _unicode_from_codepoint(0xD800)
    assert "\U0001f600" == _unicode_from_codepoint(0x1F600)


@test
def test_from_ptr():
    ascii_source = b"ascii".c_str()
    ascii_value = str.from_ptr(ascii_source)
    ascii_source[0] = u8(ord("X"))
    assert ascii_value == "ascii"

    utf8_source = _raw_bytes([
        0x63, 0x61, 0x66, 0xC3, 0xA9,
        0xCE, 0xA9,
        0xF0, 0x9F, 0x98, 0x80,
    ]).c_str()
    utf8_value = str.from_ptr(utf8_source)
    utf8_source[0] = u8(ord("X"))
    assert utf8_value == "caf\u00e9\u03a9\U0001f600"

    assert str.from_ptr(b"".c_str()) == ""
    try:
        str.from_ptr(_raw_bytes([0xFF]).c_str())
        assert False
    except ValueError:
        pass


@test
def test_comparisons_and_search():
    u = unicode("banana")
    assert u == unicode("banana")
    assert u != unicode("bandana")
    assert u < unicode("candy")
    assert u > unicode("apple")
    assert u <= unicode("banana")
    assert u >= unicode("banana")
    assert unicode("abc") < unicode("abcd")
    assert unicode("abcd") > unicode("abc")

    latin1 = _unicode_from_codepoint(0xE9)
    ucs2 = _unicode_from_codepoint(0x03A9)
    ucs4 = _unicode_from_codepoint(0x1F600)
    latin1_view = (latin1 + u)[1:]
    ucs2_view = (ucs2 + u)[1:]
    ucs4_view = (ucs4 + u)[1:]
    assert latin1_view == u
    assert ucs2_view == u
    assert ucs4_view == u
    assert latin1 < ucs2
    assert ucs2 < ucs4
    assert latin1 + unicode("z") > latin1 + unicode("a")
    assert u.find(unicode("ana")) == 1
    assert u.rfind(unicode("ana")) == 3
    assert u.index(unicode("na")) == 2
    assert u.rindex(unicode("na")) == 4
    assert u.count(unicode("an")) == 2
    assert u.find(unicode("zzz")) == -1
    assert u.startswith(unicode("ban"))
    assert u.endswith(unicode("ana"))
    assert u.startswith(unicode("na"), 2)
    assert u.endswith(unicode("na"), 2, 6)


@test
def test_pointer_description():
    pointer = Ptr[u8]()
    address = pointer.__repr__()
    names = [
        unicode("pointer"),
        _unicode_from_codepoint(0xE9),
        _unicode_from_codepoint(0x03A9),
        _unicode_from_codepoint(0x1F600),
    ]

    for name in names:
        assert Ptr._ptr_to_str(pointer, name) == unicode("<") + name + unicode(
            " at "
        ) + address + unicode(">")


@test
def test_fastsearch_paths():
    periodic = unicode("a" * 1024 + "b")
    needle = unicode("a" * 128 + "b")
    assert periodic.find(needle) == 896
    assert periodic.rfind(needle) == 896
    assert periodic.count(unicode("aa")) == 512
    no_match = unicode("a" * 1024)
    assert no_match.find(needle) == -1
    assert no_match.rfind(needle) == -1

    repeated = unicode("prefix--needle--needle--suffix")
    assert repeated.find(unicode("needle"), 8) == 8
    assert repeated.rfind(unicode("needle"), 0, 24) == 16
    assert repeated.split(unicode("--")) == [
        unicode("prefix"), unicode("needle"), unicode("needle"), unicode("suffix"),
    ]
    assert repeated.rsplit(unicode("--"), 1) == [
        unicode("prefix--needle--needle"), unicode("suffix"),
    ]
    assert repeated.replace(unicode("needle"), unicode("match")) == (
        unicode("prefix--match--match--suffix")
    )
    assert repeated.replace(unicode("needle"), unicode("match"), 0) == repeated
    assert repeated.replace(unicode("needle"), unicode("match"), 1) == (
        unicode("prefix--match--needle--suffix")
    )
    assert repeated.replace(unicode("needle"), unicode("match"), -2) == (
        unicode("prefix--match--match--suffix")
    )
    assert repeated.replace(unicode("needle"), unicode("")) == (
        unicode("prefix------suffix")
    )
    assert repeated.replace(unicode("missing"), unicode("match")) == repeated
    assert unicode("ababa").replace(unicode("aba"), unicode("z")) == unicode("zba")
    assert unicode("aaaa").replace(unicode("aa"), unicode("b")) == unicode("bb")
    assert unicode("abc").replace(unicode(""), unicode("-")) == unicode("-a-b-c-")
    assert unicode("abc").replace(unicode(""), unicode("-"), 2) == unicode("-a-bc")
    assert unicode("abc").replace(unicode(""), unicode("-"), 0) == unicode("abc")
    latin1 = unicode("caf") + _unicode_from_codepoint(0xE9)
    ucs2 = unicode("a") + _unicode_from_codepoint(0x03A9)
    ucs4 = unicode("a") + _unicode_from_codepoint(0x1F600) + _unicode_from_codepoint(0x03A9)
    assert latin1.replace(_unicode_from_codepoint(0xE9), _unicode_from_codepoint(0x1F600)) == (
        unicode("caf") + _unicode_from_codepoint(0x1F600)
    )
    assert ucs2.replace(_unicode_from_codepoint(0x03A9), _unicode_from_codepoint(0x1F600)) == (
        unicode("a") + _unicode_from_codepoint(0x1F600)
    )
    assert ucs4.replace(_unicode_from_codepoint(0x1F600), unicode("x")) == (
        unicode("ax") + _unicode_from_codepoint(0x03A9)
    )
    assert repeated.partition(unicode("--")) == (
        unicode("prefix"), unicode("--"), unicode("needle--needle--suffix"),
    )
    assert repeated.rpartition(unicode("--")) == (
        unicode("prefix--needle--needle"), unicode("--"), unicode("suffix"),
    )
    assert unicode("needle") in repeated
    omega = _unicode_from_codepoint(0x03A9)
    ucs2_needle = omega + unicode("needle")
    ucs2_value = (omega + unicode("x")) * 24 + ucs2_needle + (
        omega + unicode("x")
    ) * 10 + ucs2_needle
    assert ucs2_value.find(ucs2_needle) == 48
    assert ucs2_value.rfind(ucs2_needle) == 75

    smile = _unicode_from_codepoint(0x1F600)
    ucs4_needle = smile + unicode("needle")
    ucs4_value = (smile + unicode("x")) * 16 + ucs4_needle + (
        smile + unicode("x")
    ) * 6 + ucs4_needle
    assert ucs4_value.find(ucs4_needle) == 32
    assert ucs4_value.rfind(ucs4_needle) == 51
    assert unicode("αβγδβγ").find(unicode("βγ")) == 1
    assert unicode("αβγδβγ").rfind(unicode("βγ")) == 4


@test
def test_fastsearch_sliced_bounds():
    parent = unicode("x" + "a" * 1024 + "b" + "z")
    needle = unicode("a" * 128 + "b")

    truncated = parent[1:1025]
    assert truncated.find(needle) == -1
    assert truncated.rfind(needle) == -1

    bounded = parent[1:1026]
    assert bounded.find(needle) == 896
    assert bounded.rfind(needle) == 896
    assert bounded.find(unicode("a" * 128 + "bz")) == -1
    assert bounded.rfind(unicode("a" * 128 + "bz")) == -1


@test
def test_fastsearch_mixed_kind_views():
    ascii_value = unicode("a--b--c")
    wide_separator = unicode("Ω--Ω")[1:3]
    assert ascii_value.find(wide_separator) == 1
    assert ascii_value.rfind(wide_separator) == 4
    assert ascii_value.count(wide_separator) == 2
    assert ascii_value.split(wide_separator) == [
        unicode("a"), unicode("b"), unicode("c"),
    ]
    assert ascii_value.find(unicode("Ω--Ω")[0:1]) == -1

    ucs2_value = unicode("ΩabcΩ")[1:4]
    assert ucs2_value.find(unicode("bc")) == 1
    assert ucs2_value.rfind(unicode("bc")) == 1
    assert ucs2_value.count(unicode("bc")) == 1
    assert ucs2_value.split(unicode("b")) == [unicode("a"), unicode("c")]

    ucs4_value = unicode("😀abc😀")[1:4]
    assert ucs4_value.find(unicode("bc")) == 1
    assert ucs4_value.rfind(unicode("bc")) == 1
    assert ucs4_value.count(unicode("bc")) == 1
    assert ucs4_value.split(unicode("b")) == [unicode("a"), unicode("c")]


@test
def test_split_and_rsplit_paths():
    value = unicode("  alpha  beta  gamma  ")
    assert value.split() == [unicode("alpha"), unicode("beta"), unicode("gamma")]
    assert value.rsplit() == [unicode("alpha"), unicode("beta"), unicode("gamma")]
    assert value.split(None, 1) == [unicode("alpha"), unicode("beta  gamma  ")]
    assert value.rsplit(None, 1) == [unicode("  alpha  beta"), unicode("gamma")]

    fields = unicode("a--b--c--d")
    assert fields.split(unicode("--"), 2) == [
        unicode("a"), unicode("b"), unicode("c--d"),
    ]
    long_tail = unicode("head--" + "tail" * 1024)
    assert long_tail.split(unicode("--"), 1) == [
        unicode("head"), unicode("tail" * 1024),
    ]
    assert long_tail.split(unicode("-"), 1) == [
        unicode("head"), unicode("-" + "tail" * 1024),
    ]
    assert long_tail.rsplit(unicode("--"), 1) == [
        unicode("head"), unicode("tail" * 1024),
    ]
    assert fields.rsplit(unicode("--"), 2) == [
        unicode("a--b"), unicode("c"), unicode("d"),
    ]
    assert unicode("a,b,c,d").split(unicode(","), 2) == [
        unicode("a"), unicode("b"), unicode("c,d"),
    ]
    assert unicode("a,b,c,d").rsplit(unicode(","), 2) == [
        unicode("a,b"), unicode("c"), unicode("d"),
    ]
    assert unicode("a--").split(unicode("--")) == [unicode("a"), unicode("")]
    assert unicode("").split(unicode("--")) == [unicode("")]


@test
def test_concat_and_repeat():
    u = unicode("ab") + unicode("cd")
    assert u == unicode("abcd")
    assert u * 2 == unicode("abcdabcd")
    assert u * 0 == unicode("")


@test
def test_unicode_codepoints():
    u = unicode("héllo🙂")
    assert len(u) == 6
    assert u[0] == unicode("h")
    assert u[2] == unicode("l")
    assert u[5] == unicode("🙂")
    assert unicode("AΩ😀") == unicode("AΩ😀")
    assert unicode("AΩ😀")[1] == unicode("Ω")


@test
def test_unicode_regex():
    value = unicode("aβ😀γ😀")
    match = re.search(unicode("β(?P<face>😀)"), value)
    assert match is not None
    assert match.span() == (1, 3)
    assert match.span("face") == (2, 3)
    assert match.group("face") == unicode("😀")
    assert match.re.groupindex == {unicode("face"): 1}

    assert [match.span() for match in re.finditer(unicode("😀"), value)] == [
        (2, 3), (4, 5),
    ]
    assert re.compile(unicode("😀")).search(value, 2, 3).span() == (2, 3)
    assert re.compile(unicode("γ")).search(value, 3, 4).span() == (3, 4)
    assert re.sub(unicode("😀"), unicode("!"), value) == unicode("aβ!γ!")
    assert re.escape(unicode("é😀+")) == unicode("é😀\\+")

    pattern = re.compile(unicode("(?P<latin>é)(?P<greek>β)?(?P<face>😀)"))
    grouped = unwrap(pattern.match(unicode("é😀")))
    assert grouped.group() == unicode("é😀")
    assert unwrap(grouped.group(1)) == unicode("é")
    assert grouped.group("greek") is None
    assert grouped["greek"] is None
    assert grouped.group(1, "greek", "face") == (
        Optional[unicode](unicode("é")),
        Optional[unicode](),
        Optional[unicode](unicode("😀")),
    )
    assert [unwrap(group) for group in grouped.groups(unicode("-"))] == [
        unicode("é"), unicode("-"), unicode("😀")
    ]
    groupdict = grouped.groupdict(unicode("-"))
    assert len(groupdict) == 3
    assert unwrap(groupdict[unicode("latin")]) == unicode("é")
    assert unwrap(groupdict[unicode("greek")]) == unicode("-")
    assert unwrap(groupdict[unicode("face")]) == unicode("😀")
    assert grouped.lastindex == 3
    assert grouped.lastgroup == unicode("face")
    assert grouped.expand(unicode("<\\g<face>\\1>")) == unicode("<😀é>")

    assert re.match(unicode("β"), value) is None
    assert re.fullmatch(unicode("aβ😀γ😀"), value).span() == (0, 5)
    assert re.fullmatch(unicode("aβ😀"), value) is None
    assert re.compile(unicode("β😀")).match(value, 1, 3).span() == (1, 3)
    assert re.compile(unicode("β😀")).fullmatch(value, 1, 3).span() == (1, 3)
    assert re.compile(unicode("β")).search(value, 4, 2) is None

    assert re.findall(unicode("[β😀]"), value) == [
        unicode("β"), unicode("😀"), unicode("😀")
    ]
    assert [item.group() for item in re.finditer(unicode(""), unicode("é😀"))] == [
        unicode(""), unicode(""), unicode("")
    ]
    assert [item.span() for item in re.compile(unicode("😀")).finditer(value, 2, 5)] == [
        (2, 3), (4, 5)
    ]

    split = re.split(unicode("(?P<face>😀)"), unicode("é😀β😀"), 1)
    assert unwrap(split[0]) == unicode("é")
    assert unwrap(split[1]) == unicode("😀")
    assert unwrap(split[2]) == unicode("β😀")
    assert re.split(unicode("😀"), value, -1) == [Optional[unicode](value)]

    assert re.sub(unicode("(β)(😀)"), unicode("\\2\\1"), value) == unicode("a😀βγ😀")
    assert re.sub(unicode("😀"), lambda _: unicode("!"), value, 1) == unicode("aβ!γ😀")
    assert re.subn(unicode("😀"), unicode("!"), value) == (unicode("aβ!γ!"), 2)
    assert re.search(unicode("é"), unicode("É"), re.IGNORECASE).span() == (0, 1)

    re.purge()
    assert re.search(unicode("😀"), value).span() == (2, 3)
    try:
        re.compile(unicode("("))
        assert False
    except re.error as exc:
        assert exc.pattern == unicode("(")


@test
def test_unicode_file_io():
    text = unicode("éβ😀\n")
    raw = b'\x00\xff\x61'

    writer = open(unicode("build/unicode-file.txt"), "w")
    assert writer.write(text) == len(text)
    writer.close()
    reader = open(unicode("build/unicode-file.txt"), "r")
    assert reader.read() == text
    reader.close()

    writer = gzip.open(unicode("build/unicode-file.gz"), "wt")
    assert writer.write(text) == len(text)
    writer.close()
    reader = gzip.open(unicode("build/unicode-file.gz"), "rt")
    assert reader.read() == text
    reader.close()

    writer = bz2.open(unicode("build/unicode-file.bz2"), "wt")
    assert writer.write(text) == len(text)
    writer.close()
    reader = bz2.open(unicode("build/unicode-file.bz2"), "rt")
    assert reader.read() == text
    reader.close()

    writer = open("build/unicode-read.txt", "w")
    writer.write(unicode("éβ😀!"))
    writer.close()
    reader = open("build/unicode-read.txt", "r")
    assert reader.read(1) == unicode("é")
    assert reader.read(2) == unicode("β😀")
    assert reader.read() == unicode("!")
    reader.close()

    writer = gzip.open("build/unicode-read.gz", "wt")
    writer.write(unicode("éβ😀!"))
    writer.close()
    reader = gzip.open("build/unicode-read.gz", "rt")
    assert reader.read(1) == unicode("é")
    assert reader.read(2) == unicode("β😀")
    assert reader.read() == unicode("!")
    reader.close()

    writer = bz2.open("build/unicode-read.bz2", "wt")
    writer.write(unicode("éβ😀!"))
    writer.close()
    reader = bz2.open("build/unicode-read.bz2", "rt")
    assert reader.read(1) == unicode("é")
    assert reader.read(2) == unicode("β😀")
    assert reader.read() == unicode("!")
    reader.close()

    writer = gzip.open(unicode("build/unicode-nul.gz"), "wt")
    writer.write(unicode("a\x00é\nb"))
    writer.close()
    reader = gzip.open(unicode("build/unicode-nul.gz"), "rt")
    assert reader.readline() == unicode("a\x00é\n")
    assert reader.readline() == unicode("b")
    assert reader.readline() == unicode("")
    reader.close()

    writer = open(unicode("build/unicode-file.bin"), "wb")
    writer.write(raw)
    writer.close()
    reader = open(unicode("build/unicode-file.bin"), "rb")
    assert reader.read() == raw
    reader.close()

    writer = gzip.open(unicode("build/unicode-file.bin.gz"), "wb")
    writer.write(raw)
    writer.close()
    reader = gzip.open(unicode("build/unicode-file.bin.gz"), "rb")
    assert reader.read() == raw
    reader.close()

    writer = bz2.open(unicode("build/unicode-file.bin.bz2"), "wb")
    writer.write(raw)
    writer.close()
    reader = bz2.open(unicode("build/unicode-file.bin.bz2"), "rb")
    assert reader.read() == raw
    reader.close()


@test
def test_unicode_normalization():
    assert unicodedata.normalize("NFD", unicode("é")) == unicode("é")
    assert unicodedata.normalize("NFC", unicode("é")) == unicode("é")
    assert unicodedata.normalize("NFD", unicode("ά")) == unicode("ά")
    assert unicodedata.normalize("NFC", unicode("ά")) == unicode("ά")
    assert unicodedata.normalize("NFD", unicode("각")) == unicode("각")
    assert unicodedata.normalize("NFC", unicode("각")) == unicode("각")
    assert unicodedata.normalize("NFD", unicode("ạ̇")) == unicode("ạ̇")
    assert unicodedata.normalize("NFC", unicode("ạ̇")) == unicode("ạ̇")
    assert unicodedata.normalize("NFKD", unicode("ﬃ")) == unicode("ffi")
    assert unicodedata.normalize("NFKD", unicode("①")) == unicode("1")
    assert unicodedata.normalize("NFKC", unicode("ﬃ")) == unicode("ffi")
    assert unicodedata.normalize("NFKC", unicode("①")) == unicode("1")
    assert unicodedata.normalize("NFKC", unicode("Å")) == unicode("Å")
    assert unicodedata.normalize("NFKC", unicode(" ")) == unicode(" ")
    assert unicodedata.is_normalized("NFD", unicode("é"))
    assert not unicodedata.is_normalized("NFC", unicode("é"))
    assert unicodedata.is_normalized("NFC", unicode("é"))
    assert unicodedata.is_normalized("NFKC", unicode("ffi"))
    assert not unicodedata.is_normalized("NFKC", unicode("ﬃ"))

    try:
        unicodedata.normalize("invalid", unicode("é"))
        assert False
    except ValueError:
        pass


@test
def test_unicodedata_category_and_combining():
    assert unicodedata.category(unicode("A")) == "Lu"
    assert unicodedata.category(unicode("é")) == "Ll"
    assert unicodedata.category(unicode("́")) == "Mn"
    assert unicodedata.category(unicode("😀")) == "So"
    assert unicodedata.category(unicode("\x00")) == "Cc"
    assert unicodedata.category(_unicode_from_codepoints([0xFDD0])) == "Cn"
    assert unicodedata.combining(unicode("A")) == 0
    assert unicodedata.combining(unicode("́")) == 230
    assert unicodedata.combining(unicode("̧")) == 202

    try:
        unicodedata.category(unicode("ab"))
        assert False
    except TypeError:
        pass

    try:
        unicodedata.combining(unicode(""))
        assert False
    except TypeError:
        pass


@test
def test_unicodedata_directionality_and_width():
    assert unicodedata.bidirectional(unicode("A")) == "L"
    assert unicodedata.bidirectional(_unicode_from_codepoints([0x0627])) == "AL"
    assert unicodedata.bidirectional(_unicode_from_codepoints([0x0301])) == "NSM"
    assert unicodedata.bidirectional(_unicode_from_codepoints([0xFDD0])) == ""
    assert unicodedata.east_asian_width(unicode("A")) == "Na"
    assert unicodedata.east_asian_width(_unicode_from_codepoints([0x00B7])) == "A"
    assert unicodedata.east_asian_width(_unicode_from_codepoints([0x4E2D])) == "W"
    assert unicodedata.mirrored(unicode("("))
    assert not unicodedata.mirrored(unicode("A"))

    try:
        unicodedata.bidirectional(unicode("ab"))
        assert False
    except TypeError:
        pass

    try:
        unicodedata.east_asian_width(unicode(""))
        assert False
    except TypeError:
        pass

    try:
        unicodedata.mirrored(unicode("ab"))
        assert False
    except TypeError:
        pass


@test
def test_unicodedata_numeric_values():
    assert unicodedata.decimal(unicode("7")) == 7
    assert unicodedata.decimal(_unicode_from_codepoints([0x0665])) == 5
    assert unicodedata.digit(_unicode_from_codepoints([0x00B2])) == 2
    assert unicodedata.numeric(_unicode_from_codepoints([0x00BD])) == 0.5
    assert unicodedata.numeric(_unicode_from_codepoints([0x216B])) == 12.0
    assert unicodedata.decimal(unicode("A"), -1) == -1
    assert unicodedata.digit(unicode("A"), -1) == -1
    assert unicodedata.numeric(unicode("A"), -1.0) == -1.0
    assert unicodedata.numeric(unicode("A"), -1) == -1.0
    assert unicodedata.decimal(unicode("A"), None) is None
    assert unicodedata.digit(unicode("A"), None) is None
    assert unicodedata.numeric(unicode("A"), None) is None
    assert unicodedata.decimal(unicode("7"), None) == 7
    assert unicodedata.digit(_unicode_from_codepoint(0x00B2), None) == 2
    assert unicodedata.numeric(_unicode_from_codepoint(0x00BD), None) == 0.5

    try:
        unicodedata.decimal(unicode("A"))
        assert False
    except ValueError:
        pass

    try:
        unicodedata.digit(unicode("A"))
        assert False
    except ValueError:
        pass

    try:
        unicodedata.numeric(unicode("A"))
        assert False
    except ValueError:
        pass


@test
def test_unicodedata_decomposition():
    assert unicodedata.decomposition(unicode("À")) == "0041 0300"
    assert unicodedata.decomposition(unicode(" ")) == "<noBreak> 0020"
    assert unicodedata.decomposition(unicode("½")) == "<fraction> 0031 2044 0032"
    assert unicodedata.decomposition(unicode("각")) == ""
    assert unicodedata.decomposition(unicode("A")) == ""

    try:
        unicodedata.decomposition(unicode("ab"))
        assert False
    except TypeError:
        pass


@test
def test_unicodedata_names():
    assert unicodedata.name(unicode("A")) == "LATIN CAPITAL LETTER A"
    assert unicodedata.name(unicode("가")) == "HANGUL SYLLABLE GA"
    assert (
        unicodedata.name(_unicode_from_codepoints([0x20000]))
        == "CJK UNIFIED IDEOGRAPH-20000"
    )
    assert unicodedata.name(_unicode_from_codepoint(0xE000), "private") == "private"
    assert unicodedata.name(_unicode_from_codepoint(0xE000), None) is None
    assert unicodedata.name(unicode("A"), None) == "LATIN CAPITAL LETTER A"
    assert unicodedata.lookup("LATIN CAPITAL LETTER A") == unicode("A")
    assert unicodedata.lookup("HANGUL SYLLABLE GA") == unicode("가")
    assert unicodedata.lookup("CJK UNIFIED IDEOGRAPH-20000") == (
        _unicode_from_codepoints([0x20000])
    )
    assert unicodedata.lookup("NULL") == unicode("\x00")
    assert unicodedata.lookup("KEYCAP DIGIT ONE") == (
        _unicode_from_codepoints([0x0031, 0xFE0F, 0x20E3])
    )

    try:
        unicodedata.name(_unicode_from_codepoint(0xE000))
        assert False
    except ValueError:
        pass

    try:
        unicodedata.lookup("NOT A NAME")
        assert False
    except KeyError:
        pass


@test
def test_unicodedata_version():
    assert unicodedata.unidata_version == "16.0.0"


@test
def test_unicodedata_exhaustive_metadata():
    for codepoint in range(0x110000):
        value = _unicode_from_codepoint(codepoint)
        assert len(unicodedata.category(value)) == 2
        assert unicodedata.combining(value) >= 0
        assert len(unicodedata.bidirectional(value)) <= 3
        assert unicodedata.east_asian_width(value) in ("F", "A", "H", "N", "Na", "W")
        unicodedata.mirrored(value)
        unicodedata.decimal(value, -1)
        unicodedata.digit(value, -1)
        unicodedata.numeric(value, -1.0)
        unicodedata.decomposition(value)

        character_name = unicodedata.name(value, "")
        if character_name:
            assert unicodedata.lookup(character_name) == value


def _normalization_field_to_unicode(field: str) -> unicode:
    codepoints = []
    for codepoint in field.split():
        codepoints.append(int(codepoint, 16))
    return _unicode_from_codepoints(codepoints)


def _check_normalization_conformance(
    form: str,
    value: unicode,
    expected: unicode,
    case: int,
) -> bool:
    if unicodedata.normalize(form, value) == expected:
        return True
    print("normalization conformance failure", case, form)
    return False


@test
def test_unicode_normalization_conformance():
    cases = 0
    with open("test/stdlib/data/NormalizationTest.txt") as fixture:
        for line in fixture:
            line = line.split("#")[0].strip()
            if not line or line.startswith("@"):
                continue

            fields = line.split(";")[:-1]
            assert len(fields) == 5
            c1 = _normalization_field_to_unicode(fields[0])
            c2 = _normalization_field_to_unicode(fields[1])
            c3 = _normalization_field_to_unicode(fields[2])
            c4 = _normalization_field_to_unicode(fields[3])
            c5 = _normalization_field_to_unicode(fields[4])

            if not _check_normalization_conformance("NFC", c1, c2, cases):
                assert False
                return
            if not _check_normalization_conformance("NFC", c2, c2, cases):
                assert False
                return
            if not _check_normalization_conformance("NFC", c3, c2, cases):
                assert False
                return
            if not _check_normalization_conformance("NFD", c1, c3, cases):
                assert False
                return
            if not _check_normalization_conformance("NFD", c2, c3, cases):
                assert False
                return
            if not _check_normalization_conformance("NFD", c3, c3, cases):
                assert False
                return

            for value in [c1, c2, c3, c4, c5]:
                if not _check_normalization_conformance("NFKC", value, c4, cases):
                    assert False
                    return
                if not _check_normalization_conformance("NFKD", value, c5, cases):
                    assert False
                    return

            cases += 1

    assert cases > 0


@test
def test_codecs_and_error_handlers():
    assert unicode(_raw_bytes([0x68, 0xC3, 0xA9]), "UTF_8") == unicode("hé")
    assert unicode(_raw_bytes([0xE9]), "iso-8859-1") == unicode("é")
    assert unicode(_raw_bytes([0x41, 0, 0xA9, 0x03]), "utf16le") == unicode("AΩ")
    assert unicode(_raw_bytes([0x00, 0x41, 0x03, 0xA9]), "utf-16-be") == unicode("AΩ")
    assert unicode(_raw_bytes([0x00, 0xF6, 0x01, 0x00]), "utf32le") == unicode("😀")
    assert unicode(_raw_bytes([0x00, 0x01, 0xF6, 0x00]), "utf-32-be") == unicode("😀")

    assert unicode(_raw_bytes([0xFF, 0xFE, 0x41, 0x00]), "utf-16") == unicode("A")
    assert unicode(
        _raw_bytes([0xFF, 0xFE, 0x00, 0x00, 0x00, 0xF6, 0x01, 0x00]),
        "utf-32",
    ) == unicode("😀")

    assert unicode("AΩ").encode("utf-16-le") == _raw_bytes([0x41, 0, 0xA9, 3])
    assert unicode("AΩ").encode("utf-16-be") == _raw_bytes([0, 0x41, 3, 0xA9])
    assert unicode("😀").encode("utf-32-le") == _raw_bytes([0, 0xF6, 1, 0])
    assert unicode("😀").encode("utf-32-be") == _raw_bytes([0, 1, 0xF6, 0])
    assert unicode("A").encode("utf-16") == _raw_bytes([0xFF, 0xFE, 0x41, 0])
    assert unicode("A").encode("utf-32") == _raw_bytes([0xFF, 0xFE, 0, 0, 0x41, 0, 0, 0])

    malformed_utf8 = _raw_bytes([0x61, 0xFF, 0x62, 0xE2, 0x82])
    assert unicode(malformed_utf8, "utf-8", "ignore") == unicode("ab")
    assert unicode(malformed_utf8, "utf-8", "replace") == unicode("a�b�")
    assert unicode(malformed_utf8, "utf-8", "backslashreplace") == unicode("a\\xffb\\xe2\\x82")

    assert unicode(_raw_bytes([0xFF]), "ascii", "ignore") == unicode("")
    assert unicode(_raw_bytes([0xFF]), "ascii", "replace") == unicode("�")
    assert unicode(_raw_bytes([0xFF]), "ascii", "backslashreplace") == unicode("\\xff")
    assert unicode("éΩ").encode("ascii", "ignore") == _raw_bytes([])
    assert unicode("éΩ").encode("ascii", "replace") == _raw_bytes([0x3F, 0x3F])
    assert unicode("éΩ").encode("ascii", "backslashreplace") == _raw_bytes(
        [0x5C, 0x78, 0x65, 0x39, 0x5C, 0x75, 0x30, 0x33, 0x61, 0x39]
    )
    assert unicode("éΩ").encode("ascii", "xmlcharrefreplace") == b"&#233;&#937;"
    assert unicode("éΩ").encode("ascii", "namereplace") == (
        b"\\N{LATIN SMALL LETTER E WITH ACUTE}\\N{GREEK CAPITAL LETTER OMEGA}"
    )
    unnamed = _unicode_from_codepoints([0xE000, 0xD800])
    assert unnamed.encode("ascii", "namereplace") == b"\\ue000\\ud800"
    assert _unicode_from_codepoint(0xD800).encode(
        "utf-16-le", "xmlcharrefreplace"
    ) == unicode("&#55296;").encode("utf-16-le")

    assert unicode(_raw_bytes([0x41]), "utf-16-le", "replace") == unicode("�")
    assert unicode(_raw_bytes([0x00, 0x00, 0x11, 0x00]), "utf-32-le", "replace") == unicode("�")

    try:
        unicode(malformed_utf8, "utf-8")
        assert False
    except ValueError:
        pass

    try:
        unicode("é").encode("ascii")
        assert False
    except ValueError:
        pass

    try:
        unicode("x").encode("unknown-codec")
        assert False
    except LookupError:
        pass


@test
def test_codecs_differential_recovery_and_bom_semantics():
    malformed_utf8 = _raw_bytes([0xE2, 0x41, 0xA1])
    assert unicode(malformed_utf8, "utf-8", "ignore") == unicode("A")
    assert unicode(malformed_utf8, "utf-8", "replace") == unicode("�A�")
    assert unicode(malformed_utf8, "utf-8", "backslashreplace") == unicode("\\xe2A\\xa1")

    overlong_utf8 = _raw_bytes([0xF0, 0x80, 0x80, 0x80])
    assert unicode(overlong_utf8, "utf-8", "ignore") == unicode("")
    assert unicode(overlong_utf8, "utf-8", "replace") == unicode("����")
    assert unicode(overlong_utf8, "utf-8", "backslashreplace") == unicode("\\xf0\\x80\\x80\\x80")

    surrogate_utf8 = _raw_bytes([0xED, 0xA0, 0x80])
    assert unicode(surrogate_utf8, "utf-8", "replace") == unicode("���")

    high_surrogate = _raw_bytes([0x41, 0, 0, 0xD8, 0x42, 0])
    assert unicode(high_surrogate, "utf-16-le", "ignore") == unicode("AB")
    assert unicode(high_surrogate, "utf-16-le", "replace") == unicode("A�B")
    assert unicode(high_surrogate, "utf-16-le", "backslashreplace") == unicode("A\\x00\\xd8B")

    invalid_utf32 = _raw_bytes([0x41, 0, 0, 0, 0, 0, 0x11, 0])
    assert unicode(invalid_utf32, "utf-32-le", "ignore") == unicode("A")
    assert unicode(invalid_utf32, "utf-32-le", "replace") == unicode("A�")
    assert unicode(invalid_utf32, "utf-32-le", "backslashreplace") == unicode("A\\x00\\x00\\x11\\x00")

    assert unicode(_raw_bytes([0xFF, 0xFE, 0x41, 0]), "utf-16-le") == unicode("﻿A")
    assert unicode(_raw_bytes([0, 0x41, 0xFE, 0xFF]), "utf-16-be") == unicode("A﻿")
    assert unicode(
        _raw_bytes([0xFF, 0xFE, 0, 0, 0x41, 0, 0, 0]),
        "utf-32-le",
    ) == unicode("﻿A")

    assert unicode(_raw_bytes([0x41, 0]), "utf-16") == unicode("A")
    assert unicode(_raw_bytes([0x41, 0, 0, 0]), "utf-32") == unicode("A")


@test
def test_codecs_surrogates_and_cp1252():
    utf8_surrogate = _raw_bytes([0xED, 0xA0, 0x80])
    surrogate = unicode(utf8_surrogate, "utf-8", "surrogatepass")
    assert surrogate.encode("utf-8", "surrogatepass") == utf8_surrogate
    assert surrogate.encode("utf-16-le", "surrogatepass") == _raw_bytes([0, 0xD8])
    assert surrogate.encode("utf-32-le", "surrogatepass") == _raw_bytes([0, 0xD8, 0, 0])
    assert unicode(_raw_bytes([0, 0xD8]), "utf-16-le", "surrogatepass").encode(
        "utf-8", "surrogatepass"
    ) == utf8_surrogate
    assert unicode(_raw_bytes([0, 0xD8, 0, 0]), "utf-32-le", "surrogatepass").encode(
        "utf-8", "surrogatepass"
    ) == utf8_surrogate

    escaped_bytes = _raw_bytes([0xFF, 0x80, 0x61])
    escaped = unicode(escaped_bytes, "utf-8", "surrogateescape")
    assert escaped.encode("utf-8", "surrogateescape") == escaped_bytes

    try:
        unicode(utf8_surrogate, "utf-8")
        assert False
    except ValueError:
        pass

    try:
        surrogate.encode("utf-8")
        assert False
    except ValueError:
        pass

    assert unicode(_raw_bytes([0x80, 0x82, 0x9F]), "cp1252") == unicode("€‚Ÿ")
    assert unicode("€‚Ÿ").encode("windows-1252") == _raw_bytes([0x80, 0x82, 0x9F])
    assert unicode(_raw_bytes([0x80]), "windows1252") == unicode("€")
    defined_c1_bytes = _raw_bytes(
        [
            0x80, 0x82, 0x83, 0x84, 0x85, 0x86, 0x87, 0x88, 0x89,
            0x8A, 0x8B, 0x8C, 0x8E, 0x91, 0x92, 0x93, 0x94, 0x95,
            0x96, 0x97, 0x98, 0x99, 0x9A, 0x9B, 0x9C, 0x9E, 0x9F,
        ]
    )
    assert unicode(defined_c1_bytes, "cp1252").encode("cp1252") == defined_c1_bytes
    assert unicode(_raw_bytes([0x81]), "cp1252", "ignore") == unicode("")
    assert unicode(_raw_bytes([0x81]), "cp1252", "replace") == unicode("�")
    assert unicode(_raw_bytes([0x81]), "cp1252", "backslashreplace") == unicode("\\x81")
    assert surrogate.encode("cp1252", "backslashreplace") == _raw_bytes(
        [0x5C, 0x75, 0x64, 0x38, 0x30, 0x30]
    )

    try:
        unicode(_raw_bytes([0x81]), "cp1252")
        assert False
    except ValueError:
        pass

    iso8859_15_bytes = _raw_bytes([0xA4, 0xA6, 0xA8, 0xB4, 0xB8, 0xBC, 0xBD, 0xBE])
    iso8859_15_value = unicode("€ŠšŽžŒœŸ")
    assert unicode(iso8859_15_bytes, "iso-8859-15") == iso8859_15_value
    assert iso8859_15_value.encode("latin-9") == iso8859_15_bytes
    assert unicode(iso8859_15_bytes, "iso8859-15") == iso8859_15_value

    try:
        unicode("¤").encode("iso-8859-15")
        assert False
    except ValueError:
        pass

    cp1251_bytes = []
    for byte in range(256):
        if byte != 0x98:
            cp1251_bytes.append(byte)
    cp1251_data = _raw_bytes(cp1251_bytes)
    assert unicode(cp1251_data, "cp1251").encode("windows-1251") == cp1251_data
    assert unicode(_raw_bytes([0x80, 0xA8, 0xC0, 0xFF]), "windows1251") == unicode(
        "ЂЁАя"
    )
    assert unicode(_raw_bytes([0x98]), "cp1251", "replace") == unicode("�")

    try:
        unicode(_raw_bytes([0x98]), "cp1251")
        assert False
    except ValueError:
        pass

    cp1250_values = []
    for byte in range(256):
        if byte not in [0x81, 0x83, 0x88, 0x90, 0x98]:
            cp1250_values.append(byte)
    cp1250_data = _raw_bytes(cp1250_values)
    assert unicode(cp1250_data, "cp1250").encode("windows-1250") == cp1250_data
    assert unicode(_raw_bytes([0x81]), "windows1250", "replace") == unicode("�")

    cp1253_values = []
    for byte in range(256):
        if byte not in [
            0x81, 0x88, 0x8A, 0x8C, 0x8D, 0x8E, 0x8F, 0x90,
            0x98, 0x9A, 0x9C, 0x9D, 0x9E, 0x9F, 0xAA, 0xD2, 0xFF,
        ]:
            cp1253_values.append(byte)
    cp1253_data = _raw_bytes(cp1253_values)
    assert unicode(cp1253_data, "cp1253").encode("windows-1253") == cp1253_data
    assert unicode(_raw_bytes([0x81]), "windows1253", "replace") == unicode("�")

    cp1254_values = []
    for byte in range(256):
        if byte not in [0x81, 0x8D, 0x8E, 0x8F, 0x90, 0x9D, 0x9E]:
            cp1254_values.append(byte)
    cp1254_data = _raw_bytes(cp1254_values)
    assert unicode(cp1254_data, "cp1254").encode("windows-1254") == cp1254_data
    assert unicode(_raw_bytes([0x81]), "windows1254", "replace") == unicode("�")


@test
def test_codecs_handler_fuzz_round_trips():
    utf8_values = []
    state = 0x13579BDF
    for _ in range(257):
        state = (state * 1103515245 + 12345) & 0x7FFFFFFF
        utf8_values.append(state & 0xFF)
    utf8_data = _raw_bytes(utf8_values)
    assert unicode(utf8_data, "utf-8", "surrogateescape").encode(
        "utf-8", "surrogateescape"
    ) == utf8_data

    utf16_units = [0, 0x41, 0xD800, 0x42, 0xDC80, 0xD83D, 0xDE00, 0xDFFF, 0xFFFF]
    utf16_le = []
    utf16_be = []
    for unit in utf16_units:
        utf16_le.append(unit & 0xFF)
        utf16_le.append(unit >> 8)
        utf16_be.append(unit >> 8)
        utf16_be.append(unit & 0xFF)
    assert unicode(_raw_bytes(utf16_le), "utf-16-le", "surrogatepass").encode(
        "utf-16-le", "surrogatepass"
    ) == _raw_bytes(utf16_le)
    assert unicode(_raw_bytes(utf16_be), "utf-16-be", "surrogatepass").encode(
        "utf-16-be", "surrogatepass"
    ) == _raw_bytes(utf16_be)

    utf32_points = [0, 0x41, 0xD800, 0xDC80, 0x1F600, 0x10FFFF]
    utf32_le = []
    utf32_be = []
    for codepoint in utf32_points:
        for shift in range(0, 32, 8):
            utf32_le.append((codepoint >> shift) & 0xFF)
            utf32_be.append((codepoint >> (24 - shift)) & 0xFF)
    assert unicode(_raw_bytes(utf32_le), "utf-32-le", "surrogatepass").encode(
        "utf-32-le", "surrogatepass"
    ) == _raw_bytes(utf32_le)
    assert unicode(_raw_bytes(utf32_be), "utf-32-be", "surrogatepass").encode(
        "utf-32-be", "surrogatepass"
    ) == _raw_bytes(utf32_be)


@test
def test_membership_and_casefold():
    u = unicode("Hello, World!")
    assert unicode("ell") in u
    assert unicode("zzz") not in u
    assert u.lower() == unicode("hello, world!")
    assert u.upper() == unicode("HELLO, WORLD!")
    assert u.casefold() == unicode("hello, world!")

    assert unicode("  hello\t\n").strip() == unicode("hello")
    assert unicode("  hello").lstrip() == unicode("hello")
    assert unicode("hello  ").rstrip() == unicode("hello")


@test
def test_unicode_differential_casing_and_predicates():
    assert unicode("ΟΣ").lower() == unicode("ος")
    assert unicode("ΟΣΑ").lower() == unicode("οσα")
    assert unicode("İ").lower() == unicode("i̇")
    assert unicode("straße").upper() == unicode("STRASSE")
    assert unicode("ﬃ").upper() == unicode("FFI")
    assert unicode("Straße").casefold() == unicode("strasse")
    assert unicode("h́ELLO-world").title() == unicode("H́Ello-World")
    assert unicode("ǅelta").swapcase() == unicode("ǅELTA")

    assert unicode("٣").isdecimal()
    assert unicode("٣").isdigit()
    assert unicode("٣").isnumeric()
    assert not unicode("²").isdecimal()
    assert unicode("²").isdigit()
    assert unicode("⅕").isnumeric()
    assert not unicode("⅕").isdigit()
    assert unicode("①").isdigit()
    assert unicode("Ⅻ").isnumeric()
    assert unicode("Ⅻ").isidentifier()
    assert unicode(" ").isspace()
    assert not unicode("​").isspace()
    assert unicode("变量").isidentifier()
    assert unicode("á").isidentifier()
    assert not unicode("a​").isidentifier()
    assert not unicode("​").isprintable()


@test
def test_unicode_differential_lines_bounds_and_repr():
    lines = unicode("a\x1cbc d\r\ne").splitlines()
    assert lines == [unicode("a"), unicode("b"), unicode("c"), unicode("d"), unicode("e")]
    lines = unicode("a\x1cbc d\r\ne").splitlines(True)
    assert lines == [unicode("a\x1c"), unicode("b"), unicode("c "), unicode("d\r\n"), unicode("e")]

    value = unicode("abc")
    assert value.find(unicode(""), -10, 10) == 0
    assert value.rfind(unicode(""), -10, 10) == 3
    assert value.find(unicode("a"), -10, 10) == 0
    assert value.find(unicode(""), 10, 20) == -1
    assert value.rfind(unicode(""), 10, 20) == -1
    assert value.find(unicode(""), 2, 1) == -1
    assert value.find(unicode(""), -1, -3) == -1

    assert unicode("'\"\\\x1f\x7f​😀").__repr__() == "'\\'\"\\\\\\x1f\\x7f\\u200b😀'"


def _unicode_fuzz_normalize_bounds(
    value: unicode,
    start: int,
    end: int,
) -> Tuple[int, int]:
    length = len(value)

    if start < 0:
        start += length
        if start < 0:
            start = 0

    if end < 0:
        end += length

    if end < 0:
        end = 0
    elif end > length:
        end = length

    return start, end


def _unicode_fuzz_starts_at(value: unicode, sub: unicode, start: int) -> bool:
    if start < 0 or start + len(sub) > len(value):
        return False

    for index in range(len(sub)):
        if value._load_codepoint(start + index) != sub._load_codepoint(index):
            return False

    return True


def _unicode_fuzz_find(
    value: unicode,
    sub: unicode,
    start: int,
    end: int,
    reverse: bool = False,
) -> int:
    start, end = _unicode_fuzz_normalize_bounds(value, start, end)

    if len(sub) == 0:
        if start > end:
            return -1
        return end if reverse else start

    if len(sub) > end - start:
        return -1

    if reverse:
        for position in range(end - len(sub), start - 1, -1):
            if _unicode_fuzz_starts_at(value, sub, position):
                return position
        return -1

    for position in range(start, end - len(sub) + 1):
        if _unicode_fuzz_starts_at(value, sub, position):
            return position

    return -1


def _unicode_fuzz_count(
    value: unicode,
    sub: unicode,
    start: int,
    end: int,
) -> int:
    start, end = _unicode_fuzz_normalize_bounds(value, start, end)

    if len(sub) == 0:
        return 0 if start > end else end - start + 1

    total = 0
    position = start

    while position <= end - len(sub):
        position = _unicode_fuzz_find(value, sub, position, end)
        if position == -1:
            break
        total += 1
        position += len(sub)

    return total


def _unicode_fuzz_compare(left: unicode, right: unicode) -> int:
    limit = len(left) if len(left) < len(right) else len(right)

    for index in range(limit):
        left_codepoint = left._load_codepoint(index)
        right_codepoint = right._load_codepoint(index)

        if left_codepoint < right_codepoint:
            return -1
        if left_codepoint > right_codepoint:
            return 1

    if len(left) < len(right):
        return -1
    if len(left) > len(right):
        return 1
    return 0


def _unicode_fuzz_split(
    value: unicode,
    sub: unicode,
    maxsplit: int,
    reverse: bool = False,
) -> List[unicode]:
    parts = []

    if not reverse:
        start = 0
        splits = 0

        while maxsplit < 0 or splits < maxsplit:
            position = _unicode_fuzz_find(value, sub, start, len(value))
            if position == -1:
                break
            parts.append(value[start:position])
            start = position + len(sub)
            splits += 1

        parts.append(value[start:])
        return parts

    end = len(value)
    splits = 0

    while maxsplit < 0 or splits < maxsplit:
        position = _unicode_fuzz_find(value, sub, 0, end, True)
        if position == -1:
            break
        parts.append(value[position + len(sub):end])
        end = position
        splits += 1

    parts.append(value[:end])
    parts.reverse()
    return parts


def _unicode_fuzz_next(state: int) -> int:
    return (state * 1103515245 + 12345) & 0x7FFFFFFF


def _unicode_fuzz_value(state: int, length: int) -> Tuple[unicode, int]:
    codepoints = []
    alphabet = [
        0x00, 0x20, 0x2D, 0x41, 0x61, 0x7F, 0xE9,
        0x301, 0x3A9, 0x2028, 0x1F600, 0x10FFFF,
    ]

    for _ in range(length):
        state = _unicode_fuzz_next(state)
        codepoints.append(alphabet[state % len(alphabet)])

    return _unicode_from_codepoints(codepoints), state


@test
def test_unicode_differential_fuzz_search_and_split():
    state = 0x5EED1234

    for case in range(200):
        state = _unicode_fuzz_next(state)
        value, state = _unicode_fuzz_value(state, state % 25)
        state = _unicode_fuzz_next(state)
        sub, state = _unicode_fuzz_value(state, state % 8 + 1)

        if case % 2 == 0:
            value = (_unicode_from_codepoint(0x1F600) + value)[1:]
        if case % 3 == 0:
            sub = (_unicode_from_codepoint(0x1F600) + sub)[1:]

        state = _unicode_fuzz_next(state)
        start = state % 65 - 32
        state = _unicode_fuzz_next(state)
        end = state % 65 - 32
        state = _unicode_fuzz_next(state)
        maxsplit = state % 8 - 1
        comparison = _unicode_fuzz_compare(value, sub)

        assert (value == sub) == (comparison == 0)
        assert (value != sub) == (comparison != 0)
        assert (value < sub) == (comparison < 0)
        assert (value <= sub) == (comparison <= 0)
        assert (value > sub) == (comparison > 0)
        assert (value >= sub) == (comparison >= 0)
        assert value.find(sub, start, end) == _unicode_fuzz_find(
            value, sub, start, end
        )
        assert value.rfind(sub, start, end) == _unicode_fuzz_find(
            value, sub, start, end, True
        )
        assert value.count(sub, start, end) == _unicode_fuzz_count(
            value, sub, start, end
        )
        assert value.split(sub, maxsplit) == _unicode_fuzz_split(
            value, sub, maxsplit
        )
        assert value.rsplit(sub, maxsplit) == _unicode_fuzz_split(
            value, sub, maxsplit, True
        )


@test
def test_split_join_and_replace():
    u = unicode("a,b,c")
    parts = u.split(unicode(","))
    assert len(parts) == 3
    assert parts[0] == unicode("a")
    assert parts[1] == unicode("b")
    assert parts[2] == unicode("c")

    ws = unicode("a b  c\t d")
    wsparts = ws.split()
    assert len(wsparts) == 4
    assert wsparts[0] == unicode("a")
    assert wsparts[1] == unicode("b")
    assert wsparts[2] == unicode("c")
    assert wsparts[3] == unicode("d")

    joined = unicode(",").join([unicode("a"), unicode("b"), unicode("c")])
    assert joined == unicode("a,b,c")

    replaced = unicode("ababa").replace(unicode("aba"), unicode("z"))
    assert replaced == unicode("zba")

    limited = unicode("a,b,c").split(unicode(","), 1)
    assert len(limited) == 2
    assert limited[0] == unicode("a")
    assert limited[1] == unicode("b,c")

    assert unicode(" a b c ").split(None, 1) == [unicode("a"), unicode("b c ")]
    assert unicode(" a b c ").rsplit(None, 1) == [unicode(" a b"), unicode("c")]
    assert unicode(" a b ").split(None, 0) == [unicode("a b ")]
    assert unicode(" a b ").rsplit(None, 0) == [unicode(" a b")]
    assert unicode(" a b c ").split(None, 1) == [unicode("a"), unicode("b c ")]
    assert unicode(" a b c ").rsplit(None, 1) == [unicode(" a b"), unicode("c")]
    assert unicode(" a b ").split(None, 0) == [unicode("a b ")]
    assert unicode(" a b ").rsplit(None, 0) == [unicode(" a b")]


@test
def test_unicode_api_edge_contracts():
    value = unicode("abc")

    assert value.partition(unicode("x")) == (
        value, unicode(""), unicode(""),
    )
    assert value.rpartition(unicode("x")) == (
        unicode(""), unicode(""), value,
    )
    assert unicode("a--b--c").replace(unicode("--"), unicode("/"), 1) == (
        unicode("a/b--c")
    )
    assert unicode("aaaa").replace(unicode("aa"), unicode("b")) == unicode("bb")
    assert unicode("abc").replace(unicode(""), unicode("-"), 2) == unicode("-a-bc")
    assert unicode(",").join([]) == unicode("")
    assert unicode(",").join([unicode("only")]) == unicode("only")
    assert value.removeprefix(unicode("x")) == value
    assert value.removesuffix(unicode("x")) == value
    assert value.removeprefix(unicode("ab")) == unicode("c")
    assert value.removesuffix(unicode("bc")) == unicode("a")
    assert unicode("+12").zfill(5) == unicode("+0012")
    assert unicode("-12").zfill(5) == unicode("-0012")
    assert unicode("a\tb").expandtabs(4) == unicode("a   b")

    try:
        value.index(unicode("x"))
        assert False
    except ValueError:
        pass

    try:
        value.rindex(unicode("x"))
        assert False
    except ValueError:
        pass

    try:
        value.split(unicode(""))
        assert False
    except ValueError:
        pass

    try:
        value.rsplit(unicode(""))
        assert False
    except ValueError:
        pass

    try:
        value.center(5, unicode("ab"))
        assert False
    except TypeError:
        pass


@test
def test_unicode_views_hash_translation_and_codec_edges():
    value = unicode("abc")
    wide_view = (_unicode_from_codepoint(0x1F600) + value)[1:]
    copied = value.__ptrcopy__()
    copied._ptr[0] = u8(ord("z"))
    wide_copy = wide_view.__ptrcopy__()

    assert wide_view == value
    assert copied == unicode("zbc")
    assert value == unicode("abc")
    assert wide_copy == wide_view
    assert wide_copy._meta == wide_view._meta
    assert hash(wide_view) == hash(value)
    values = {wide_view: 1}
    assert values[value] == 1
    assert wide_view[-3:-1] == unicode("ab")
    assert wide_view[::-1] == unicode("cba")

    table = unicode.maketrans(
        unicode("ab"), unicode("12"), unicode("x")
    )
    assert unicode("xabc").translate(table) == unicode("12c")
    assert unicode("aba").translate(
        {ord("a"): unicode("xy"), ord("b"): None}
    ) == unicode("xyxy")
    assert value.translate({}) == value

    assert unicode(_raw_bytes([0xC3, 0xA9]), "utf8") == unicode("é")
    assert unicode(_raw_bytes([0xE9]), "latin_1") == unicode("é")
    assert unicode(_raw_bytes([0x41, 0]), "utf_16_le") == unicode("A")

    try:
        value[3]
        assert False
    except IndexError:
        pass

    try:
        value.partition(unicode(""))
        assert False
    except ValueError:
        pass

    try:
        value.rpartition(unicode(""))
        assert False
    except ValueError:
        pass

    try:
        unicode(_raw_bytes([88]), "unknown-codec")
        assert False
    except LookupError:
        pass


@test
def test_partition_and_predicates():
    assert unicode("abc").isalnum()
    assert unicode("abc").isalpha()
    assert unicode("123").isdigit()
    assert unicode(" ").isspace()

    assert not unicode("").isalnum()
    assert not unicode("").isalpha()
    assert not unicode("").isdigit()
    assert not unicode("").isspace()

    left, mid, right = unicode("hello,world").partition(unicode(","))
    assert left == unicode("hello")
    assert mid == unicode(",")
    assert right == unicode("world")

    left, mid, right = unicode("hello,world,again").rpartition(unicode(","))
    assert left == unicode("hello,world")
    assert mid == unicode(",")
    assert right == unicode("again")

    chars = []
    for ch in unicode("abc"):
        chars.append(ch)

    assert chars[0] == unicode("a")
    assert chars[1] == unicode("b")
    assert chars[2] == unicode("c")


@test
def test_iterator():
    chars = []
    for ch in unicode("abc"):
        chars.append(ch)

    assert len(chars) == 3
    assert chars[0] == unicode("a")
    assert chars[1] == unicode("b")
    assert chars[2] == unicode("c")


@test
def test_padding_and_tabs():
    assert unicode("abc").center(5) == unicode(" abc ")
    assert unicode("abc").ljust(5) == unicode("abc  ")
    assert unicode("abc").rjust(5) == unicode("  abc")
    assert unicode("12").zfill(5) == unicode("00012")
    assert unicode("-12").zfill(5) == unicode("-0012")
    assert unicode("a\tb").expandtabs(2) == unicode("a b")


@test
def test_text_normalization_and_splitlines():
    assert unicode("hello").capitalize() == unicode("Hello")
    assert unicode("hELLO").swapcase() == unicode("Hello")
    assert unicode("hello world").title() == unicode("Hello World")

    assert unicode("hello").removeprefix(unicode("he")) == unicode("llo")
    assert unicode("hello").removesuffix(unicode("lo")) == unicode("hel")
    assert unicode("hello").removesuffix(unicode("xyz")) == unicode("hello")

    assert unicode("").splitlines() == []
    lines = unicode("a\nb\r\nc").splitlines()
    assert len(lines) == 3
    assert lines[0] == unicode("a")
    assert lines[1] == unicode("b")
    assert lines[2] == unicode("c")


@test
def test_predicates():
    assert unicode("abc").islower()
    assert not unicode("ABC").islower()
    assert unicode("ABC").isupper()
    assert not unicode("abc").isupper()
    assert unicode("Hello World").istitle()
    assert not unicode("hello world").istitle()

    assert unicode("123").isnumeric()
    assert unicode("123").isdecimal()
    assert unicode("abc").isascii()
    assert not unicode("héllo").isascii()
    assert unicode("abc").isprintable()
    assert not unicode("abc\n").isprintable()


@test
def test_identifier_and_printable():
    assert unicode("abc").isidentifier()
    assert unicode("_abc").isidentifier()
    assert not unicode("123abc").isidentifier()
    assert not unicode("abc-def").isidentifier()

    assert unicode("abc").isprintable()
    assert not unicode("abc\n").isprintable()


@test
def test_translate_and_maketrans():
    table = unicode.maketrans(unicode("aeiou"), unicode("12345"))
    assert unicode("hello").translate(table) == unicode("h2ll4")

    delete_table = unicode.maketrans(unicode("aeiou"), unicode("12345"), unicode("o"))
    assert unicode("hello").translate(delete_table) == unicode("h2ll")

    optional_integer_table: Dict[int, Optional[int]] = {
        ord("a"): ord("A"),
        ord("-"): None,
    }
    assert unicode("a-b").translate(optional_integer_table) == unicode("Ab")
    assert unicode("a-b").translate(
        unicode.maketrans(optional_integer_table)
    ) == unicode("Ab")

    text_table: Dict[int, unicode] = {
        ord("a"): unicode("αβ"),
        ord("b"): unicode(""),
    }
    assert unicode("abc").translate(text_table) == unicode("αβc")
    assert unicode("cab").translate(unicode.maketrans(text_table)) == unicode("cαβ")

    optional_table: Dict[int, Optional[unicode]] = {
        ord("a"): unicode("α"),
        ord("-"): None,
        ord("b"): unicode("βγ"),
    }
    assert unicode("a-bc").translate(optional_table) == unicode("αβγc")
    assert unicode("a-b").translate(unicode.maketrans(optional_table)) == unicode("αβγ")
    assert unicode("x").translate({ord("x"): 0xD800}) == unicode("\ud800")


@test
def test_operator_helpers():
    assert unicode("ab") + unicode("cd") == unicode("abcd")
    assert unicode("ab") * 3 == unicode("ababab")
    assert 2 * unicode("ab") == unicode("abab")


@test
def test_rsplit():
    parts = unicode("a b c").rsplit()
    assert len(parts) == 3
    assert parts[0] == unicode("a")
    assert parts[1] == unicode("b")
    assert parts[2] == unicode("c")

    parts = unicode("a,b,c").rsplit(unicode(","), 1)
    assert len(parts) == 2
    assert parts[0] == unicode("a,b")
    assert parts[1] == unicode("c")


@test
def test_slice_steps():
    value = unicode("abcde")

    assert value[::2] == unicode("ace")
    assert value[1:5:2] == unicode("bd")
    assert value[::-1] == unicode("edcba")
    assert value[4::-2] == unicode("eca")
    assert value[3:0:-1] == unicode("dcb")
    try:
        value[::0]
        assert False
    except ValueError:
        pass


@test
def test_padding_strip_chars_and_splitlines_keepends():
    assert unicode("abc").center(7, unicode("-")) == unicode("--abc--")
    assert unicode("abc").ljust(5, unicode(".")) == unicode("abc..")
    assert unicode("abc").rjust(5, unicode(".")) == unicode("..abc")

    assert unicode("xyabcxy").strip(unicode("xy")) == unicode("abc")
    assert unicode("xyabc").lstrip(unicode("xy")) == unicode("abc")
    assert unicode("abcxy").rstrip(unicode("xy")) == unicode("abc")

    lines = unicode("a\r\nb\n").splitlines(True)
    assert len(lines) == 2
    assert lines[0] == unicode("a\r\n")
    assert lines[1] == unicode("b\n")


@test
def test_empty_substring_count_and_replace():
    value = unicode("abc")

    assert value.count(unicode("")) == 4
    assert value.count(unicode(""), 1, 2) == 2
    assert value.count(unicode(""), 2, 1) == 0

    assert value.replace(unicode(""), unicode("-")) == unicode("-a-b-c-")
    assert value.replace(unicode(""), unicode("-"), 2) == unicode("-a-bc")
    assert value.replace(unicode(""), unicode("-"), 0) == unicode("abc")
    assert unicode("").replace(unicode(""), unicode("-")) == unicode("-")


@test
def test_empty_bounds_partition_and_expandtabs_edges():
    value = unicode("abc")
    empty = unicode("")

    assert value.find(empty, 2, 1) == -1
    assert value.rfind(empty, 2, 1) == -1
    assert not value.startswith(empty, 2, 1)
    assert not value.endswith(empty, 2, 1)

    assert unicode("a\tb").expandtabs(0) == unicode("ab")
    assert unicode("a\tb").expandtabs(-1) == unicode("ab")
    assert unicode("a\n\tb").expandtabs(4) == unicode("a\n    b")


@test
def test_case_method_edge_cases():
    assert unicode("abc-123").islower()
    assert unicode("ABC-123").isupper()
    assert not unicode("123-!").islower()
    assert not unicode("123-!").isupper()

    assert unicode("Hello-World").istitle()
    assert unicode("Hello3World").istitle()
    assert not unicode("Hello3world").istitle()
    assert not unicode("hello-World").istitle()

    assert unicode("foo-bar").title() == unicode("Foo-Bar")
    assert unicode("foo3bar").title() == unicode("Foo3Bar")
    assert unicode("FOO3BAR").title() == unicode("Foo3Bar")


@test
def test_search_bounds():
    value = unicode("abc")
    empty = unicode("")

    assert value.find(empty, 4) == -1
    assert value.rfind(empty, 4) == -1
    assert value.count(empty, 4) == 0
    assert not value.startswith(empty, 4)
    assert not value.endswith(empty, 4)

    assert value.find(empty, -10, 99) == 0
    assert value.rfind(empty, -10, 99) == 3
    assert value.count(empty, -10, 99) == 4


@test
def test_splitlines_all_boundaries():
    nel = _unicode_from_codepoint(0x85)
    line_separator = _unicode_from_codepoint(0x2028)
    paragraph_separator = _unicode_from_codepoint(0x2029)

    value = (
        unicode("a\rb\nc\r\nd\ve\ff\x1cg\x1dh\x1ei")
        + nel
        + unicode("j")
        + line_separator
        + unicode("k")
        + paragraph_separator
    )
    lines = value.splitlines()

    assert len(lines) == 11
    assert lines[0] == unicode("a")
    assert lines[1] == unicode("b")
    assert lines[2] == unicode("c")
    assert lines[3] == unicode("d")
    assert lines[4] == unicode("e")
    assert lines[5] == unicode("f")
    assert lines[6] == unicode("g")
    assert lines[7] == unicode("h")
    assert lines[8] == unicode("i")
    assert lines[9] == unicode("j")
    assert lines[10] == unicode("k")

    assert unicode("a\n").splitlines() == [unicode("a")]

    with_ends = unicode("a\rb\nc\r\n").splitlines(True)
    assert len(with_ends) == 3
    assert with_ends[0] == unicode("a\r")
    assert with_ends[1] == unicode("b\n")
    assert with_ends[2] == unicode("c\r\n")


@test
def test_unicode_data():
    e_acute = _unicode_from_codepoint(0xE9)
    superscript_two = _unicode_from_codepoint(0xB2)
    arabic_digits = _unicode_from_codepoints([0x661, 0x662])
    nbsp = _unicode_from_codepoint(0xA0)
    em_space = _unicode_from_codepoint(0x2003)
    pi = _unicode_from_codepoint(0x3C0)
    combining_acute = _unicode_from_codepoint(0x301)

    assert e_acute.isalpha()
    assert (e_acute + unicode("2")).isalnum()
    assert not (e_acute + unicode("-2")).isalnum()

    assert superscript_two.isdigit()
    assert not superscript_two.isdecimal()
    assert superscript_two.isnumeric()
    assert arabic_digits.isdecimal()

    assert nbsp.isspace()
    assert (nbsp + unicode("hello") + nbsp).strip() == unicode("hello")
    assert (unicode("one") + nbsp + unicode("two") + em_space + unicode("three")).split() == [
        unicode("one"),
        unicode("two"),
        unicode("three"),
    ]

    assert pi.isidentifier()
    assert (pi + unicode("2")).isidentifier()
    assert (unicode("a") + combining_acute).isidentifier()
    assert unicode("_value").isidentifier()
    assert not (unicode("2") + pi).isidentifier()
    assert not (pi + unicode("-1")).isidentifier()

    assert unicode("hello world").isprintable()
    assert unicode("café").isprintable()
    assert unicode("你好").isprintable()
    assert unicode("😀").isprintable()

    assert not unicode("hello\nworld").isprintable()
    assert not _unicode_from_codepoint(0xA0).isprintable()  # NO-BREAK SPACE
    assert not _unicode_from_codepoint(0x200B).isprintable()  # ZERO WIDTH SPACE
    assert not _unicode_from_codepoint(0x2028).isprintable()  # LINE SEPARATOR


@test
def test_unicode_case_predicates():
    lower_alpha = _unicode_from_codepoint(0x3B1)  # alpha
    upper_alpha = _unicode_from_codepoint(0x391)  # capital alpha
    title_dz = _unicode_from_codepoint(0x1C5)  # titlecase DZ
    combining_acute = _unicode_from_codepoint(0x301)

    assert lower_alpha.islower()
    assert not lower_alpha.isupper()
    assert not lower_alpha.istitle()

    assert upper_alpha.isupper()
    assert not upper_alpha.islower()
    assert upper_alpha.istitle()

    assert title_dz.istitle()
    assert not title_dz.islower()
    assert not title_dz.isupper()

    assert (lower_alpha + unicode("-123")).islower()
    assert (upper_alpha + unicode("-123")).isupper()
    assert not (unicode("123-") + combining_acute).islower()
    assert not (unicode("123-") + combining_acute).isupper()
    assert not (unicode("123-") + combining_acute).istitle()

    assert not (unicode("A") + combining_acute + unicode("b")).istitle()
    assert (unicode("A") + combining_acute + unicode("B")).istitle()


@test
def test_unicode_case_mappings():
    sharp_s = _unicode_from_codepoint(0xDF)
    dotted_i = _unicode_from_codepoint(0x130)
    ligature_ffi = _unicode_from_codepoint(0xFB03)
    combining_dot = _unicode_from_codepoint(0x307)

    assert sharp_s.upper() == unicode("SS")
    assert sharp_s.title() == unicode("Ss")
    assert sharp_s.swapcase() == unicode("SS")

    assert dotted_i.lower() == unicode("i") + combining_dot
    assert ligature_ffi.upper() == unicode("FFI")
    assert ligature_ffi.casefold() == unicode("ffi")
    assert (unicode("Stra") + sharp_s + unicode("e")).casefold() == unicode("strasse")

    title_dz = _unicode_from_codepoint(0x1C5)
    assert title_dz.swapcase() == title_dz


@test
def test_unicode_final_sigma():
    omicron_sigma = _unicode_from_codepoints([0x39F, 0x3A3])
    assert omicron_sigma.lower() == _unicode_from_codepoints([0x3BF, 0x3C2])
    assert _unicode_from_codepoints([0x39F, 0x3A3, 0x391]).lower() == (
        _unicode_from_codepoints([0x3BF, 0x3C3, 0x3B1])
    )

    # Case-ignorable marks do not prevent final-sigma detection.
    assert _unicode_from_codepoints([0x39F, 0x3A3, 0x301]).lower() == (
        _unicode_from_codepoints([0x3BF, 0x3C2, 0x301])
    )


@test
def test_unicode_title_and_capitalize_mappings():
    combining_acute = _unicode_from_codepoint(0x301)
    sharp_s = _unicode_from_codepoint(0xDF)
    assert (unicode("a") + combining_acute + unicode("BC")).title() == (
        unicode("A") + combining_acute + unicode("Bc")
    )
    assert (sharp_s + unicode("ABC")).capitalize() == unicode("Ssabc")
    assert (unicode("hELLO ") + sharp_s).title() == unicode("Hello Ss")


@test
def test_unicode_ascii_case_mappings():
    value = unicode("hELLO, wORLD! 123")

    assert value.lower() == unicode("hello, world! 123")
    assert value.upper() == unicode("HELLO, WORLD! 123")
    assert value.casefold() == unicode("hello, world! 123")
    assert value.capitalize() == unicode("Hello, world! 123")
    assert value.title() == unicode("Hello, World! 123")
    assert value.swapcase() == unicode("Hello, World! 123")

    assert unicode("").lower() == unicode("")
    assert unicode("123!?").title() == unicode("123!?")


@test
def test_unicode_case_mapping_identity():
    value = unicode("123!?")
    assert value.lower() == value
    assert value.upper() == value
    assert value.casefold() == value
    assert value.capitalize() == value
    assert value.swapcase() == value

    assert _unicode_from_codepoint(0x3A3).lower() == _unicode_from_codepoint(0x3C3)
    combining_acute = _unicode_from_codepoint(0x301)
    value = unicode("A") + combining_acute + unicode("B")
    assert value.title() == value


@test
def test_unicode_final_sigma_case_methods():
    omicron_sigma = _unicode_from_codepoints([0x39F, 0x3A3])
    capitalized = _unicode_from_codepoints([0x39F, 0x3C2])
    lower = _unicode_from_codepoints([0x3BF, 0x3C2])
    assert omicron_sigma.capitalize() == capitalized
    assert omicron_sigma.title() == capitalized
    assert omicron_sigma.swapcase() == lower


