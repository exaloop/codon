# float-format tests
@test
def test_float_shortest_decimal():
    result = _float_shortest_decimal(1.0)
    assert result.significand == u64(1)
    assert result.exponent == 0

    result = _float_shortest_decimal(1.25)
    assert result.significand == u64(125)
    assert result.exponent == -2

    result = _float_shortest_decimal(0.1)
    assert result.significand == u64(1)
    assert result.exponent == -1

    result = _float_shortest_decimal(1e20)
    assert result.significand == u64(1)
    assert result.exponent == 20

    result = _float_shortest_decimal(1e-20)
    assert result.significand == u64(1)
    assert result.exponent == -20

    result = _float_shortest_decimal(1.2345678901234567)
    assert result.significand == u64(12345678901234567)
    assert result.exponent == -16


@test
def test_float_shortest_decimal_boundaries():
    result = _float_shortest_decimal(2.0)
    assert result.significand == u64(2)
    assert result.exponent == 0

    result = _float_shortest_decimal(0.5)
    assert result.significand == u64(5)
    assert result.exponent == -1

    result = _float_shortest_decimal(2.2250738585072014e-308)
    assert result.significand == u64(22250738585072014)
    assert result.exponent == -324

    result = _float_shortest_decimal(5e-324)
    assert result.significand == u64(5)
    assert result.exponent == -324


@test
def test_float_dtoa_shortest():
    assert _float_dtoa_shortest(0.0) == "0"
    assert _float_dtoa_shortest(-0.0) == "-0"
    assert _float_dtoa_shortest(1.0) == "1.0"
    assert _float_dtoa_shortest(-1.0) == "-1.0"
    assert _float_dtoa_shortest(1.25) == "1.25"
    assert _float_dtoa_shortest(0.1) == "0.1"

    assert _float_dtoa_shortest(1e-4) == "0.0001"
    assert _float_dtoa_shortest(1e-5) == "1e-05"
    assert _float_dtoa_shortest(1e16) == "1e+16"
    assert _float_dtoa_shortest(1e20) == "1e+20"

    assert _float_dtoa_shortest(5e-324) == "5e-324"
    assert _float_dtoa_shortest(2.2250738585072014e-308) == (
        "2.2250738585072014e-308"
    )
    assert _float_dtoa_shortest(1.2345678901234567) == (
        "1.2345678901234567"
    )

    assert _float_dtoa_shortest(float("inf")) == "inf"
    assert _float_dtoa_shortest(float("-inf")) == "-inf"
    assert _float_dtoa_shortest(float("nan")) == "nan"


@test
def test_float_dtoa_biguint_division():
    value = _BigUInt(8)
    divisor = _BigUInt(8)

    value.set_u64(u64(123456789))
    divisor.set_u64(u64(10000))

    quotient = value.divmod(divisor)

    assert quotient.length == 1
    assert quotient.data[0] == u32(12345)
    assert value.length == 1
    assert value.data[0] == u32(6789)


@test
def test_float_dtoa_scaled_integer():
    result = _float_dtoa_scaled_integer(1.25, 2)
    assert result.length == 1
    assert result.data[0] == u32(125)

    # The binary64 value is below exact decimal 1.005.
    result = _float_dtoa_scaled_integer(1.005, 2)
    assert result.data[0] == u32(100)

    result = _float_dtoa_scaled_integer(1.999, 2)
    assert result.data[0] == u32(200)

    # Exact ties round to even.
    result = _float_dtoa_scaled_integer(2.5, 0)
    assert result.data[0] == u32(2)

    result = _float_dtoa_scaled_integer(3.5, 0)
    assert result.data[0] == u32(4)


@test
def test_float_dtoa_fixed():
    assert _float_dtoa_fixed(1.0, 0) == "1"
    assert _float_dtoa_fixed(1.0, 2) == "1.00"
    assert _float_dtoa_fixed(-0.0, 3) == "-0.000"

    assert _float_dtoa_fixed(1.25, 1) == "1.2"
    assert _float_dtoa_fixed(1.25, 2) == "1.25"
    assert _float_dtoa_fixed(1.999, 2) == "2.00"
    assert _float_dtoa_fixed(1.005, 2) == "1.00"

    assert _float_dtoa_fixed(0.0001, 5) == "0.00010"
    assert _float_dtoa_fixed(1e20, 2) == "100000000000000000000.00"

    assert _float_dtoa_fixed(float("inf"), 2) == "inf"
    assert _float_dtoa_fixed(float("-inf"), 2) == "-inf"
    assert _float_dtoa_fixed(float("nan"), 2) == "nan"


@test
def test_float_dtoa_exponent():
    assert _float_dtoa_exponent(1.0, 0) == "1e+00"
    assert _float_dtoa_exponent(1.0, 2) == "1.00e+00"
    assert _float_dtoa_exponent(-0.0, 3) == "-0.000e+00"

    assert _float_dtoa_exponent(1.25, 1) == "1.2e+00"
    assert _float_dtoa_exponent(1.25, 2) == "1.25e+00"
    assert _float_dtoa_exponent(1.999, 2) == "2.00e+00"
    assert _float_dtoa_exponent(9.999, 1) == "1.0e+01"

    assert _float_dtoa_exponent(0.0001, 2) == "1.00e-04"
    assert _float_dtoa_exponent(1e20, 2) == "1.00e+20"

    assert _float_dtoa_exponent(float("inf"), 2) == "inf"
    assert _float_dtoa_exponent(float("-inf"), 2) == "-inf"
    assert _float_dtoa_exponent(float("nan"), 2) == "nan"


@test
def test_float_dtoa_general():
    assert _float_dtoa_general(1.0, 6) == "1"
    assert _float_dtoa_general(1.0, 6, True) == "1.00000"
    assert _float_dtoa_general(-0.0, 3) == "-0"
    assert _float_dtoa_general(-0.0, 3, True) == "-0.00"

    assert _float_dtoa_general(1.25, 3) == "1.25"
    assert _float_dtoa_general(1.25, 5, True) == "1.2500"
    assert _float_dtoa_general(1.23456, 4) == "1.235"

    assert _float_dtoa_general(0.0001, 3) == "0.0001"
    assert _float_dtoa_general(0.00001, 3) == "1e-05"
    assert _float_dtoa_general(12345.0, 4) == "1.234e+04"
    assert _float_dtoa_general(999.9, 3) == "1e+03"

    assert _float_dtoa_general(float("inf"), 4) == "inf"
    assert _float_dtoa_general(float("-inf"), 4) == "-inf"
    assert _float_dtoa_general(float("nan"), 4) == "nan"


@test
def test_float_dtoa_uppercase():
    assert _float_dtoa_fixed(1.25, 2, True) == "1.25"
    assert _float_dtoa_exponent(1.25, 2, True) == "1.25E+00"
    assert _float_dtoa_general(0.00001, 3, False, True) == "1E-05"

    assert _float_dtoa_fixed(float("inf"), 2, True) == "INF"
    assert _float_dtoa_exponent(float("-inf"), 2, True) == "-INF"
    assert _float_dtoa_general(float("nan"), 4, False, True) == "NAN"


@test
def test_float_format_padding():
    assert _float_format(1.25, 0x66, 2, 0, 0) == "1.25"
    assert _float_format(1.25, 0x46, 2, 0, 0) == "1.25"

    assert _float_format(1.0, 0x66, 0, FORMAT_FLAG_ALT, 0) == "1."
    assert _float_format(1.0, 0x65, 0, FORMAT_FLAG_ALT, 0) == "1.e+00"
    assert _float_format(1.0, 0x45, 0, FORMAT_FLAG_ALT, 0) == "1.E+00"

    assert _float_format(1.25, 0x66, 2, FORMAT_FLAG_PLUS, 0) == "+1.25"
    assert _float_format(1.25, 0x66, 2, FORMAT_FLAG_SPACE, 0) == " 1.25"
    assert _float_format(-1.25, 0x66, 2, FORMAT_FLAG_PLUS, 0) == "-1.25"

    assert _float_format(1.25, 0x66, 2, 0, 8) == "    1.25"
    assert _float_format(1.25, 0x66, 2, FORMAT_FLAG_LEFT, 8) == "1.25    "
    assert _float_format(1.25, 0x66, 2, FORMAT_FLAG_ZERO, 8) == "00001.25"
    assert _float_format(-1.25, 0x66, 2, FORMAT_FLAG_ZERO, 8) == "-0001.25"

    assert _float_format(1.25, 0x45, 2, 0, 10) == "  1.25E+00"
    assert _float_format(float("inf"), 0x47, 3, FORMAT_FLAG_PLUS, 0) == "+INF"
    assert _float_format(float("nan"), 0x67, 3, FORMAT_FLAG_PLUS, 0) == "+nan"


test_float_shortest_decimal()
test_float_shortest_decimal_boundaries()
test_float_dtoa_shortest()
test_float_dtoa_biguint_division()
test_float_dtoa_scaled_integer()
test_float_dtoa_fixed()
test_float_dtoa_exponent()
test_float_dtoa_general()
test_float_dtoa_uppercase()
test_float_format_padding()


# integer-format tests
@test
def test_integer_format():
    assert _integer_format(123, 0x64, -1, 0, 0) == "123"
    assert _integer_format(-123, 0x69, -1, 0, 0) == "-123"
    assert _integer_format(-123, 0x75, -1, 0, 0) == "-123"
    assert _integer_format(-15, 0x78, -1, 0, 0) == "-f"

    assert _integer_format(15, 0x6F, -1, 0, 0) == "17"
    assert _integer_format(255, 0x78, -1, 0, 0) == "ff"
    assert _integer_format(255, 0x58, -1, 0, 0) == "FF"

    assert _integer_format(0, 0x64, 0, 0, 0) == "0"
    assert _integer_format(0, 0x6F, 0, FORMAT_FLAG_ALT, 0) == "0o0"
    assert _integer_format(15, 0x78, -1, FORMAT_FLAG_ALT, 0) == "0xf"
    assert _integer_format(15, 0x58, -1, FORMAT_FLAG_ALT, 0) == "0XF"

    assert _integer_format(12, 0x64, 5, 0, 0) == "00012"
    assert _integer_format(12, 0x64, -1, FORMAT_FLAG_PLUS, 5) == "  +12"
    assert _integer_format(12, 0x64, -1, FORMAT_FLAG_ZERO, 5) == "00012"
    assert _integer_format(-12, 0x64, -1, FORMAT_FLAG_ZERO, 5) == "-0012"
    assert _integer_format(15, 0x78, -1, FORMAT_FLAG_ALT | FORMAT_FLAG_ZERO, 6) == (
        "0x000f"
    )
    assert _integer_format(12, 0x64, -1, FORMAT_FLAG_LEFT, 5) == "12   "


test_integer_format()


# tuple format
@test
def test_percent_format():
    assert unicode("hello") % () == unicode("hello")
    assert unicode("100%%") % () == unicode("100%")
    assert unicode("%d") % 42 == unicode("42")
    assert unicode("%+06d") % 42 == unicode("+00042")
    assert unicode("%#x") % 255 == unicode("0xff")

    assert unicode("%.2f") % 1.25 == unicode("1.25")
    assert unicode("%8.2f") % 1.25 == unicode("    1.25")
    assert unicode("%+.1E") % 1.25 == unicode("+1.2E+00")
    assert unicode("%.3g") % 0.00001 == unicode("1e-05")

    assert unicode("%d %.1f %#x") % (12, 1.25, 255) == unicode(
        "12 1.2 0xff"
    )


@test
def test_percent_format_large_width_and_precision():
    assert unicode("%10000d") % 1 == unicode(" " * 9999 + "1")
    assert unicode("%.1000f") % 1.0 == unicode("1." + "0" * 1000)
    assert unicode("%#1000.0x") % 15 == unicode(" " * 997 + "0xf")


@test
def test_percent_format_string():
    assert unicode("%s") % unicode("hello") == unicode("hello")
    assert unicode("hello %s") % unicode("world") == unicode("hello world")
    assert unicode("%s %s") % (unicode("one"), unicode("two")) == unicode(
        "one two"
    )

    assert unicode("%10s") % unicode("x") == unicode("         x")
    assert unicode("%-10s") % unicode("x") == unicode("x         ")
    assert unicode("%010s") % unicode("x") == unicode("         x")

    assert unicode("%.3s") % unicode("abcdef") == unicode("abc")
    assert unicode("%6.3s") % unicode("abcdef") == unicode("   abc")
    assert unicode("%-6.3s") % unicode("abcdef") == unicode("abc   ")

    assert unicode("%% %s") % unicode("ok") == unicode("% ok")
    assert unicode("%s:%d:%.1f") % (unicode("value"), 12, 1.25) == unicode(
        "value:12:1.2"
    )


@test
def test_percent_format_unicode():
    assert unicode("héllo %s") % unicode("世界") == unicode("héllo 世界")
    assert unicode("%.1s") % unicode("世界") == unicode("世")
    assert unicode("%3s") % unicode("é") == unicode("  é")
    assert unicode("%-3s") % unicode("é") == unicode("é  ")


@test
def test_percent_format_char():
    assert unicode("%c") % 65 == unicode("A")
    assert unicode("%c") % unicode("x") == unicode("x")
    assert unicode("%5c") % 65 == unicode("    A")
    assert unicode("%-5c") % unicode("x") == unicode("x    ")

    assert unicode("%c") % 0x03A9 == unicode("Ω")
    assert unicode("%3c") % unicode("世") == unicode("  世")

    try:
        unicode("%c") % unicode("ab")
        assert False
    except TypeError:
        pass

    try:
        unicode("%c") % -1
        assert False
    except OverflowError:
        pass

    try:
        unicode("%c") % 0x110000
        assert False
    except OverflowError:
        pass


@test
def test_percent_format_repr():
    assert unicode("%r") % 42 == unicode("42")
    assert unicode("%r") % unicode("hello") == unicode("'hello'")
    assert unicode("%10r") % unicode("x") == unicode("       'x'")
    assert unicode("%-10r") % unicode("x") == unicode("'x'       ")
    assert unicode("%.4r") % unicode("hello") == unicode("'hel")

    assert unicode("%r") % unicode("a'b") == unicode('"a\'b"')
    assert unicode("%r") % unicode("a\nb") == unicode("'a\\nb'")


@test
def test_percent_format_ascii():
    assert unicode("%a") % 42 == unicode("42")
    assert unicode("%a") % unicode("hello") == unicode("'hello'")
    assert unicode("%a") % unicode("café") == unicode("'caf\\xe9'")
    assert unicode("%a") % unicode("世界") == unicode("'\\u4e16\\u754c'")
    assert unicode("%a") % unicode("🙂") == unicode("'\\U0001f642'")

    assert unicode("%10a") % unicode("é") == unicode("    '\\xe9'")
    assert unicode("%.4a") % unicode("世界") == unicode("'\\u4")
    assert unicode("%-8a") % unicode("é") == unicode("'\\xe9'  ")


@test
def test_percent_format_mapping():
    names = {unicode("name"): unicode("Codon")}
    counts = {unicode("count"): 3}

    assert unicode("%(name)s") % names == unicode("Codon")
    assert unicode("%(count)04d") % counts == unicode("0003")
    assert unicode("%(name)-8s") % names == unicode("Codon   ")


@test
def test_percent_format_dynamic_width_precision():
    assert unicode("%*d") % (5, 12) == unicode("   12")
    assert unicode("%*d") % (-5, 12) == unicode("12   ")
    assert unicode("%0*d") % (5, 12) == unicode("00012")

    assert unicode("%.*f") % (2, 1.25) == unicode("1.25")
    assert unicode("%*.*f") % (8, 2, 1.25) == unicode("    1.25")
    assert unicode("%.*f") % (-1, 1.25) == unicode("1.250000")

    assert unicode("%*.*s") % (6, 3, unicode("abcdef")) == unicode("   abc")


@test
def test_percent_format_argument_errors():
    try:
        unicode("%d %d") % (1,)
        assert False
    except TypeError:
        pass

    try:
        unicode("%d") % (1, 2)
        assert False
    except TypeError:
        pass

    try:
        unicode("%*d") % (1.5, 2)
        assert False
    except TypeError:
        pass

    try:
        unicode("%(name)s") % unicode("not a mapping")
        assert False
    except TypeError:
        pass


@test
def test_percent_format_length_modifiers():
    assert unicode("%ld") % 42 == unicode("42")
    assert unicode("%lld") % -42 == unicode("-42")
    assert unicode("%#lx") % 255 == unicode("0xff")
    assert unicode("%.2Lf") % 1.25 == unicode("1.25")


@test
def test_percent_format_general_precision_zero():
    assert unicode("%.0g") % 1.25 == unicode("1")
    assert unicode("%.0G") % 12.5 == unicode("1E+01")
    assert unicode("%#.0g") % 1.0 == unicode("1.")


@test
def test_percent_format_mapping_errors():
    names = {unicode("name"): unicode("Codon")}

    try:
        unicode("%(name)*s") % names
        assert False
    except TypeError:
        pass

    try:
        unicode("%(missing)s") % names
        assert False
    except KeyError:
        pass


@test
def test_percent_format_errors():
    try:
        unicode("%") % ()
        assert False
    except ValueError:
        pass

    try:
        unicode("%q") % 1
        assert False
    except ValueError:
        pass

    try:
        unicode("%d") % ()
        assert False
    except TypeError:
        pass

    try:
        unicode("text") % 1
        assert False
    except TypeError:
        pass

    try:
        unicode("%d") % (1, 2)
        assert False
    except TypeError:
        pass

    assert unicode("%%") % () == unicode("%")


@test
def test_percent_format_mapping_literal_percent():
    names = {unicode("name"): unicode("Codon")}
    assert unicode("%% %(name)s") % names == unicode("% Codon")


@test
def test_unicode_repr():
    assert repr(unicode("")) == "''"
    assert repr(unicode("hello")) == "'hello'"
    assert repr(unicode("a'b")) == '"a\'b"'
    assert repr(unicode('a"b')) == "'a\"b'"
    assert repr(unicode("a\nb\tc")) == "'a\\nb\\tc'"
    assert repr(unicode("é")) == "'é'"
    assert repr(unicode("\x01")) == "'\\x01'"

    text = unicode("x") * 1000
    assert repr(text) == "'" + "x" * 1000 + "'"


@test
def test_percent_format_integer_as_float():
    assert unicode("%f") % 1 == unicode("1.000000")
    assert unicode("%.2e") % 12 == unicode("1.20e+01")


@test
def test_percent_format_flag_precedence():
    assert unicode("%+ d") % 1 == unicode("+1")
    assert unicode("%-05d") % 1 == unicode("1    ")
    assert unicode("%05.3d") % 1 == unicode("00001")
    assert unicode("%#.0o") % 0 == unicode("0o0")
    assert unicode("%#.0x") % 0 == unicode("0x0")
    assert unicode("%#.0f") % 1.0 == unicode("1.")


@test
def test_percent_format_unicode_mapping_key():
    values = {unicode("世界"): unicode("hello")}
    assert unicode("%(世界)s") % values == unicode("hello")
    assert unicode("value: %(世界).3s") % values == unicode("value: hel")


@test
def test_percent_format_char_errors():
    try:
        unicode("%.1c") % 65
        assert False
    except ValueError:
        pass


@test
def test_percent_format_float_as_integer():
    assert unicode("%d") % 1.9 == unicode("1")
    assert unicode("%i") % 1.9 == unicode("1")
    assert unicode("%u") % 1.9 == unicode("1")

    try:
        unicode("%o") % 1.5
        assert False
    except TypeError:
        pass

    try:
        unicode("%#x") % 15.9
        assert False
    except TypeError:
        pass


@test
def test_percent_format_integer_boundaries():
    minimum = -(1 << 63)
    assert unicode("%d") % minimum == unicode("-9223372036854775808")
    assert unicode("%+024d") % minimum == unicode("-00009223372036854775808")
    assert unicode("%.22d") % minimum == unicode("-0009223372036854775808")
    assert unicode("%x") % minimum == unicode("-8000000000000000")
    assert unicode("%o") % minimum == unicode("-1000000000000000000000")


test_percent_format()
test_percent_format_large_width_and_precision()
