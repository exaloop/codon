@test
def test_percent_malformed_formats():
    try:
        unicode("%") % ()
        assert False
    except ValueError:
        pass

    try:
        unicode("%q") % 1
        assert False
    except ValueError:
        pass

    try:
        unicode("%y") % 1
        assert False
    except ValueError:
        pass

    try:
        unicode("%(") % Dict[unicode, unicode]()
        assert False
    except ValueError:
        pass

    try:
        unicode("%(name") % {unicode("name"): unicode("x")}
        assert False
    except ValueError:
        pass

