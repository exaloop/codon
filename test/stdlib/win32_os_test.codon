import internal.static as static
import os
import os.path as path
import os._win32 as win32


@test
def test_wide_buffers():
    # Pure helpers: instantiate on POSIX as well, without calling Win32 APIs.
    value = "dir-é-🙂"
    pointer = win32._wide(value)
    units = len(value.encode("utf-16-le")) // 2
    assert pointer[units] == u16(0)
    assert win32._decode_wide(pointer, units) == value
    assert win32._wide("")[0] == u16(0)
    try:
        win32._wide("bad\0path")
        assert False
    except ValueError:
        pass


@test
def test_stat_fields():
    assert int(win32._handle_pointer(1234)) == 1234
    assert int(win32._handle_pointer(-1)) == -1
    info = Ptr[u32](13)
    for index in range(13):
        info[index] = u32(0)
    info[0] = u32(0x10)
    for offset in [1, 3, 5]:
        ticks = 116444736000000000 + 123456789
        info[offset] = u32(ticks & 0xFFFFFFFF)
        info[offset + 1] = u32(ticks >> 32)
    info[7] = u32(17)
    info[8] = u32(1)
    info[9] = u32(23)
    info[10] = u32(2)
    info[11] = u32(3)
    info[12] = u32(4)
    fields = win32._stat_fields(info)
    assert type(fields) is Ptr[int]
    owned = List(fields, 14)
    assert owned._ptr == fields
    assert owned == [0o040777, (3 << 32) | 4, 17, 2, 0, 0, (1 << 32) | 23,
                     12, 12, 12, 345678900, 345678900, 345678900, 0]
    result = os.stat_result(fields)
    assert result.st_mode == 0o040777
    assert result.st_dev == 17 and result.st_ino == (3 << 32) | 4
    assert result.st_size == (1 << 32) + 23 and result.st_nlink == 2
    assert result.st_mtime_ns == 12345678900
    assert result.st_mtime == 12.3456789
    assert os.stat_result(win32._stat_fields(info, 0xA000000C)).st_mode == 0o120777
    info[0] = u32(1)
    assert os.stat_result(win32._stat_fields(info)).st_mode == 0o100444
    assert fields[0] == 0o040777


@test
def test_reparse_buffers():
    # Relative symlink to "a": 8-byte header, 12-byte symlink header, WCHAR a.
    raw = (b"\x0c\0\0\xa0\x0e\0\0\0" +
           b"\0\0\x02\0\0\0\0\0\x01\0\0\0a\0")
    target, error = win32._reparse_target_status(raw._ptr, len(raw))
    assert target == "a" and not error
    for count in [0, 7, len(raw) - 1, 16385]:
        target, error = win32._reparse_target_status(raw._ptr, count)
        assert target == "" and error.errno == 22 and error.winerror == 0
        assert error.message
    # An in-bounds header with a name offset outside the returned buffer.
    malformed = raw[:8] + b"\xff\x7f" + raw[10:]
    target, error = win32._reparse_target_status(malformed._ptr, len(malformed))
    assert target == "" and error.errno == 22 and error.winerror == 0
    for malformed in [raw[:4] + b"\0\0" + raw[6:],
                      raw[:8] + b"\x02\0" + raw[10:]]:
        target, error = win32._reparse_target_status(malformed._ptr, len(malformed))
        assert target == "" and error.errno == 22 and error.winerror == 0
    unknown = b"\0\0\0\0" + raw[4:]
    target, status = win32._reparse_target_status(unknown._ptr, len(unknown))
    assert target == "" and status.errno == 22 and status.winerror == 4390
    try:
        status.raise_error("readlink", "link")
        assert False
    except OSError as error:
        assert error.errno == 22 and error.winerror == 4390
        assert error.strerror == "not a symbolic link"
        assert error.filename == "link"


def test_symlink_targets(root: str, directory: str):
    original = os.getcwd()
    symbolic = path.join(root, "target-form-link")
    try:
        os.chdir(root)
        drive, tail = path.splitdrive(directory)
        targets = [path.basename(directory), directory, tail]
        if len(drive) == 2 and drive[1] == ":":
            targets.append(drive + path.basename(directory))
        unc = os.environ.get("CODON_OS_TEST_UNC_DIR", "")
        if unc:
            assert unc.startswith("\\\\") and path.isdir(unc)
            targets.append(unc)
        elif not drive.startswith("\\\\"):
            print("SKIP: UNC symlink target; set CODON_OS_TEST_UNC_DIR to an existing share directory")
        for target in targets:
            assert win32._symlink_is_directory(target, symbolic)
            try:
                os.symlink(target, symbolic)
            except OSError as error:
                assert error.winerror == 1314
                print("SKIP: Windows symlink targets require Developer Mode or privileges")
                return
            try:
                assert path.islink(symbolic) and path.isdir(symbolic)
                assert os.lstat(symbolic).st_mode & 0o170000 == 0o120000
                assert path.samefile(symbolic, target)
                assert path.normcase(path.realpath(symbolic)) == path.normcase(path.realpath(target))
                assert path.normcase(path.realpath(symbolic, strict=True)) == path.normcase(path.realpath(target))
                assert os.readlink(symbolic)
            finally:
                os.rmdir(symbolic)
        for is_directory in [False, True]:
            target = "missing-target"
            assert not win32._symlink_is_directory(target, symbolic)
            os.symlink(target, symbolic, target_is_directory=is_directory)
            try:
                assert path.islink(symbolic) and path.lexists(symbolic)
                assert not path.exists(symbolic)
                assert os.readlink(symbolic) == target
            finally:
                if is_directory:
                    os.rmdir(symbolic)
                else:
                    os.unlink(symbolic)
    finally:
        os.chdir(original)


def test_junction(root: str, directory: str):
    junction = path.join(root, "junction")
    result = os.system('cmd /c mklink /J "' + junction + '" "' + directory + '" >nul')
    assert result == 0, "could not create junction fixture"
    try:
        assert path.isdir(junction) and not path.islink(junction)
        assert os.lstat(junction).st_mode & 0o170000 == 0o040000
        assert path.samefile(junction, directory)
        assert os.readlink(junction)
        assert path.normcase(path.realpath(junction)) == path.normcase(path.realpath(directory))
        assert path.normcase(path.realpath(junction, strict=True)) == path.normcase(path.realpath(directory))
    finally:
        os.rmdir(junction)


def create_file(name: str) -> int:
    from C import _wsopen_s(Ptr[i32], Ptr[u16], i32, i32, i32) -> i32
    fd = i32(-1)
    # _O_RDWR | _O_CREAT | _O_EXCL | _O_BINARY, _SH_DENYNO, read/write mode.
    win32._crt_call("test/create", True, _wsopen_s, __ptr__(fd),
                    win32._wide(name), i32(0x8502), i32(0x40), i32(0x180))
    return int(fd)


@test
def test_windows_filesystem():
    assert os.name == "nt" and os.sep == "\\" and os.pathsep == ";"
    assert path.join("C:\\base", "child") == "C:\\base\\child"
    assert path.normcase("C:/ABC") == "c:\\abc"
    original = os.getcwd()
    root = ""
    # Atomic mkdir claims a private directory. Bound retries; never delete a
    # pre-existing fixture, and never change the actual process temp settings.
    for index in range(100):
        candidate = path.join(original, "build", "codon-win-test-" + str(os.getpid()) + "-" + str(index))
        try:
            os.mkdir(candidate)
            root = candidate
            break
        except OSError:
            pass
    assert root, "could not create Windows test directory under build"
    sub = path.join(root, "dir-é-🙂")
    file = path.join(root, "file-é-🙂")
    moved = path.join(root, "moved")
    hard = path.join(root, "hard")
    symbolic = path.join(root, "symbolic")
    try:
        os.mkdir(sub)
        test_symlink_targets(root, sub)
        test_junction(root, sub)
        os.chdir(sub)
        assert path.normcase(os.getcwd()) == path.normcase(sub)
        assert os.getcwdb().decode("utf-8", "surrogatepass") == os.getcwd()
        assert path.normcase(path.abspath(".")) == path.normcase(sub)
        os.chdir(original)
        fd = create_file(file)
        try:
            assert os.write(fd, b"a\0b\r\nc") == 6
            assert os.fstat(fd).st_size == 6
            assert os.lseek(fd, 0, os.SEEK_SET) == 0
            assert os.read(fd, 0) == b""
            assert os.read(fd, 10) == b"a\0b\r\nc"
            assert os.read(fd, 1) == b""
            os.ftruncate(fd, 2)
            os.fsync(fd)
        finally:
            os.close(fd)
        os.truncate(file, 1)
        assert path.isfile(file) and path.isdir(sub)
        assert path.getsize(file) == 1 and path.getmtime(file) == os.stat(file).st_mtime
        assert path.normcase(path.realpath(file, strict=True)) == path.normcase(file)
        missing = path.join(root, "missing")
        assert not path.exists(missing) and not path.lexists(missing)
        assert path.normcase(path.realpath(missing)) == path.normcase(missing)
        assert sorted(os.listdir(root)) == sorted([path.basename(file), path.basename(sub)])
        descriptor = os.open(file, os.O_RDWR)
        try:
            assert os.fstat(descriptor).st_ino == os.stat(file).st_ino
        finally:
            os.close(descriptor)
        tree = path.join(root, "tree", "nested")
        os.makedirs(tree)
        os.makedirs(tree, exist_ok=True)
        assert os.listdir(tree) == []
        os.removedirs(tree)
        assert not path.exists(path.join(root, "tree"))
        assert os.access(file, os.F_OK)
        os.chmod(file, 0o400)
        assert not os.access(file, os.W_OK)
        os.chmod(file, 0o600)
        assert os.access(file, os.W_OK)
        os.link(file, hard)
        assert path.samefile(file, hard)
        linked = False
        try:
            os.symlink(path.basename(file), symbolic)
            linked = True
        except OSError as error:
            assert error.winerror == 1314
        if linked:
            assert path.islink(symbolic) and path.isfile(symbolic)
            assert path.samefile(symbolic, file)
            assert path.normcase(path.realpath(symbolic)) == path.normcase(path.realpath(file))
        # Use a distinct destination file, not a second name of the same inode.
        other = create_file(moved)
        os.close(other)
        try:
            os.rename(file, moved)  # Unlike POSIX, an existing target is an error.
            assert False
        except OSError as error:
            assert error.filename == file and error.filename2 == moved
            assert error.winerror is not None and error.errno is not None
            assert error.strerror is not None
        os.replace(file, moved)
        os.rename(moved, file)
        try:
            os.remove(sub)
            assert False
        except OSError as error:
            assert error.filename == sub and error.filename2 is None
            assert error.winerror is not None
        try:
            os.chdir(root + "\0suffix")
            assert False
        except ValueError:
            pass
        # A bad descriptor must raise, not invoke UCRT's terminating handler.
        try:
            os.read(-1, 1)
            assert False
        except OSError as error:
            assert error.errno == 9 and error.winerror is None
            assert error.filename is None
        try:
            os.chdir(path.join(root, "missing"))
            assert False
        except OSError as error:
            assert error.errno == 2 and error.winerror is None
            assert error.filename == path.join(root, "missing")
        assert os.getpid() > 0 and os.getppid() >= 0
    finally:
        os.chdir(original)
        for name in [symbolic, file, moved, hard]:
            try:
                os.chmod(name, 0o600)
                os.unlink(name)
            except OSError:
                pass
        try:
            os.rmdir(sub)
        finally:
            os.rmdir(root)


test_wide_buffers()
test_stat_fields()
test_reparse_buffers()
if static.platform() == "win32":
    test_windows_filesystem()
